// در tgWatchdog بعد از tgRmTick_ صدا زده می‌شود. فقط ردیف‌های «در صف» که تاریخشان رسیده.
function tgRmChTick_(force) {
  if (TG_DRY) return 0;
  const hh = Number(Utilities.formatDate(new Date(), TG_TZ, 'H'));
  if (force !== true && (hh < 10 || hh >= 22)) return 0;
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(20000)) return 0;
  var n = 0;
  try {
    const sh = tgRmChSheet_(), rows = sh.getDataRange().getValues(), today = tgRmChToday_();
    for (var i = 1; i < rows.length; i++) {
      const r = rows[i];
      if (String(r[11] || '').trim() !== 'در صف') continue;
      if (!tgRmChDue_(tgRmChDay_(r[3]), today)) continue;
      try { tgRmChPublish_(sh, i + 1, r); n++; }
      catch (e) {
        sh.getRange(i + 1, 12).setValue('خطا: ' + tgSecretMask_(e.message));
        sh.getRange(i + 1, 15).setValue('تلاش ناموفق در ' + Utilities.formatDate(new Date(), TG_TZ, 'yyyy-MM-dd HH:mm'));
      }
    }
  } finally { lock.releaseLock(); }
  return n;
}

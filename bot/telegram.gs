    TG_MEM['fbrow'] = {}; TG_MEM['fbrow'][fb[0][0]] = { row: 2, text: fb[0][4], chat: '9101', name: 'مسئول پذیرش' };
    TG_OUTBOX = [];
    tgOnFb_({ message: { chat: { id: 9500 }, message_id: 4 }, from: {} }, 'd:' + fb[0][0]);
    ok('انجام شد به خود نفر خبر داده می‌شود', TG_OUTBOX.some(function (x) { return x.chat === '9101' && x.text.indexOf('انجام شد') > -1; }));
    ok('متن‌ها خط تیره ندارند', [tgFbStart_.toString(), tgMsgStart_.toString()].every(function (s) { return s.indexOf(' — ') < 0; }));
  } catch (e) { fail++; out.push('❌ خطا: ' + e + ' ' + String(e.stack || '').slice(0, 300)); }
  TG_DRY = wasDry; TG_OUTBOX = wasOut; TG_MEM = wasMem;
  return { pass: pass, fail: fail, text: out.join('\n') };
}


/* ═════════════ v118: برنامهٔ من (داشبورد مراجع) · همه‌چیز با تقویم ═════════════
   معارفه، جلسه‌های درمان (هفتگی هم) و قرار تماشای کاناپه، با زمان UTC.
   مینی‌اپ ساعت را به وقت محلی خود مراجع و تهران نشان می‌دهد. */
var TG_PLAN_WEEKS = 4;

function tgPlanGcal_(title, start, mins, desc, loc) {
  var A = String.fromCharCode(38), end = new Date(start.getTime() + mins * 60000);
  return 'https://calendar.google.com/calendar/render?action=TEMPLATE' +
    A + 'text=' + encodeURIComponent(title) +
    A + 'dates=' + tgRmUtc_(start) + '/' + tgRmUtc_(end) +
    A + 'details=' + encodeURIComponent(desc || '') +
    (loc ? A + 'location=' + encodeURIComponent(loc) : '');
}

function tgPlanEvents_(chat, now) {
  now = now || new Date();
  var out = [], info = {}, from = now.getTime() - 2 * 3600000;
  try { info = tgTherapistInfo_() || {}; } catch (e) {}
  function push(o) {
    if (!o.start || isNaN(o.start.getTime()) || o.start.getTime() < from) return;
    o.gcal = tgPlanGcal_(o.title, o.start, o.len, o.desc, o.link);
    o.iso = o.start.toISOString();
    out.push(o);
  }
  /* معارفه */
  var raw = tgGetVal_('meet', chat);
  if (raw) {
    try {
      var mt = JSON.parse(raw), im = (info[mt.t] || {}).meet || '';
      push({ kind: 'intro', icon: '🤝', title: 'جلسهٔ معارفه با ' + mt.t, who: mt.t, len: 20,
        start: tgSlotUtc_({ dateIso: mt.d, hhmm: mt.h }), link: im, synced: !!mt.ev,
        desc: 'جلسهٔ معارفه، مرکز تجربه زندگی' + (im ? '\nلینک جلسه: ' + im : '') });
    } catch (e) {}
  }
  /* جلسه‌های درمان */
  var rows = [];
  try { rows = tgSessRows_(); } catch (e) {}
  rows.forEach(function (s) {
    if (String(s.chat) !== String(chat)) return;
    if (/لغو|پایان|کنسل/.test(s.status)) return;
    var st = tgSlotUtc_(s), len = s.len || 50, lk = (info[s.name] || {}).meet || '';
    var base = { kind: 'sess', icon: '🩺', title: 'جلسهٔ درمان با ' + s.name, who: s.name, len: len, link: lk,
      synced: !!s.ev, weekly: /بله|هفتگی/.test(s.weekly),
      desc: 'جلسهٔ درمان، مرکز تجربه زندگی' + (lk ? '\nلینک جلسه: ' + lk : '') };
    if (!base.weekly) { push(Object.assign({}, base, { start: st })); return; }
    var t = st.getTime(), W = 7 * 86400000;
    while (t < from) t += W;
    for (var k = 0; k < TG_PLAN_WEEKS; k++) push(Object.assign({}, base, { start: new Date(t + k * W) }));
  });
  /* کاناپه */
  var mem = [];
  try { mem = tgRmMembers_(); } catch (e) {}
  mem.forEach(function (m) {
    if (String(m.chat) !== String(chat) || m.status !== 'فعال') return;
    if (!(m.due instanceof Date)) return;
    var c = {};
    try { c = tgRmCalText_(m.rm || 'kanape'); } catch (e) { return; }
    push({ kind: 'kanape', icon: '🛋', title: c.title, len: 120, start: m.due, link: c.url, synced: false, desc: c.body });
  });
  out.sort(function (a, b) { return a.start - b.start; });
  return out.slice(0, 12);
}

function tgApiPlan_(p) {
  var w = tgApiWho_(p);
  if (!w) return { ok: false, error: 'auth' };
  var ev = tgPlanEvents_(w.chat).map(function (e, i) {
    return { i: i, kind: e.kind, icon: e.icon, title: e.title, who: e.who || '', iso: e.iso, len: e.len,
      link: e.link || '', gcal: e.gcal, synced: !!e.synced, weekly: !!e.weekly };
  });
  var em = '';
  try { em = String(tgGetVal_('em', w.chat) || ''); } catch (e) {}
  return { ok: true, events: ev, email: em ? em.replace(/^(.).*(@.*)$/, '$1•••$2') : '' };
}

function tgPlanIcs_(e, chat) {
  var end = new Date(e.start.getTime() + e.len * 60000);
  var L = ['BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//Tajrobeh//Plan//FA', 'CALSCALE:GREGORIAN', 'METHOD:PUBLISH',
    'BEGIN:VEVENT', 'UID:plan-' + e.kind + '-' + chat + '-' + e.start.getTime() + '@tajrobeh.life',
    'DTSTAMP:' + tgRmUtc_(new Date()), 'DTSTART:' + tgRmUtc_(e.start), 'DTEND:' + tgRmUtc_(end),
    'SUMMARY:' + tgRmIcsEsc_(e.title), 'DESCRIPTION:' + tgRmIcsEsc_(e.desc || '')];
  if (e.link) L.push('LOCATION:' + tgRmIcsEsc_(e.link));
  if (e.weekly) L.push('RRULE:FREQ=WEEKLY');
  L.push('BEGIN:VALARM', 'TRIGGER:-PT30M', 'ACTION:DISPLAY', 'DESCRIPTION:' + tgRmIcsEsc_(e.title), 'END:VALARM', 'END:VEVENT', 'END:VCALENDAR');
  return L.map(tgRmIcsFold_).join('\r\n') + '\r\n';
}

/* فایل تقویم را خود بات در گفت‌وگو می‌فرستد (در وب‌ویوی تلگرام دانلود مستقیم قابل اتکا نیست) */
function tgApiPlanIcs_(p) {
  var w = tgApiWho_(p);
  if (!w) return { ok: false, error: 'auth' };
  var all = tgPlanEvents_(w.chat), e = all[Number(p.i)];
  if (!e) return { ok: false, error: 'gone' };
  var ics = tgPlanIcs_(e, w.chat);
  if (TG_DRY) { TG_OUTBOX.push({ kind: 'doc', chat: String(w.chat), name: 'plan.ics', ics: ics }); return { ok: true }; }
  var token = PropertiesService.getScriptProperties().getProperty('TELEGRAM_TOKEN');
  var res = tgFetchRetry_('https://api.telegram.org/bot' + token + '/sendDocument', {
    method: 'post', muteHttpExceptions: true,
    payload: { chat_id: String(w.chat), document: Utilities.newBlob(ics, 'text/calendar', 'tajrobeh-' + e.kind + '.ics'),
      caption: '📎 این فایل را باز کنید تا «' + tgEsc_(e.title) + '» در تقویم گوشی‌تان بنشیند.', parse_mode: 'HTML' }
  });
  return { ok: res.getResponseCode() === 200 };
}

/* ایمیل برای دعوت تقویم: همان مسیر بات (tgSaveEmail_) که مهمان رویدادها را هم اضافه می‌کند */
function tgApiPlanEmail_(p) {
  var w = tgApiWho_(p);
  if (!w) return { ok: false, error: 'auth' };
  var em = String(p.email || '').trim();
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(em)) return { ok: false, error: 'bad' };
  tgSetFlag_('emask', w.chat, 600);
  tgSaveEmail_(w.chat, em);
  return { ok: tgGetVal_('em', w.chat) === em };
}


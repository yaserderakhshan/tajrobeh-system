  } catch (e2) {}
  return tgSend_(chat, 'انجام شد ✅\nاین روز و ساعت هر هفته برای شما نگه داشته می‌شود. اگر هفته‌ای نتوانستید، به پذیرش بگویید.', tgMenu_());
}

/* v87: نوع تراپی در مچ‌میکینگ شرط قطعی است */
function tgAnnSafeTests() {
  var out = [], pass = 0, fail = 0;
  function ok(n, c) { c ? pass++ : fail++; out.push((c ? '✅ ' : '❌ ') + n); }
  try {
    ok('تگ ساده حفظ می‌شود', tgAnnSafe_('<b>تیتر</b> و <i>مورب</i>') === '<b>تیتر</b> و <i>مورب</i>');
    ok('تگ ناشناخته امن می‌شود', tgAnnSafe_('<script>x</script>').indexOf('&lt;script&gt;') === 0);
    ok('لینک درست می‌ماند', tgAnnSafe_('<a href="https://tajrobeh.life/team/">تیم</a>') === '<a href="https://tajrobeh.life/team/">تیم</a>');
    ok('کوچک‌تر تنها خراب نمی‌کند', tgAnnSafe_('۳ < ۵').indexOf('&lt;') > -1);
    ok('متن ساده دست‌نخورده می‌ماند', tgAnnSafe_('یک خط ساده') === 'یک خط ساده');
  } catch (e) { ok('اجرای تست بدون خطا · ' + e, false); }
  return { pass: pass, fail: fail, text: out.join('\n') };
}

function tgMatchTests() {
  var out = [], pass = 0, fail = 0;
  function ok(n, c) { c ? pass++ : fail++; out.push((c ? '✅ ' : '❌ ') + n); }
  var wasDry = TG_DRY;
  TG_DRY = true;
  function S(n) { return { therapist: n, dateIso: '2026-09-20', hhmm: '10:00' }; }
  function names(l) { return l.map(function (s) { return s.therapist; }).join('، '); }
  try {
    TG_OUTBOX = []; TG_MEM = {};
    var pm = {};
    pm[tgNorm_('دریا نویدی')] = { ind: 1 };
    pm[tgNorm_('زوج‌کار الف')] = { ind: 2, rel: 1 };
    pm[tgNorm_('فردی‌کار ب')] = { ind: 1 };
    TG_MEM['poolmap'] = pm;

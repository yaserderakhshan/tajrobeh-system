/* ---------- آمار رودمپ ---------- */
function tgRmStats_(rm) {
  var o = { total: 0, active: 0, left: 0, new7: 0, act7: 0, seen: 0, plan: 0, reminded: 0, refl: 0, pub: 0, pre: 0, deck: 0, src: {} };
  if (TG_DRY) return o;
  var now = Date.now(), wk = 7 * 86400000;
  var sh = tgRmTab_(TG_RM_T_MEM, TG_RM_MEM_HEAD), last = sh.getLastRow();
  if (last >= 2) {
    var v = sh.getRange(2, 1, last - 1, TG_RM_MEM_HEAD.length).getValues();
    for (var i = 0; i < v.length; i++) {
      if (!String(v[i][2]).trim() || String(v[i][5]) !== rm) continue;
      o.total++;
      var st = String(v[i][13] || 'فعال');
      if (st === 'فعال') o.active++; else o.left++;
      if (v[i][1] instanceof Date && now - v[i][1].getTime() < wk) o.new7++;
      if (v[i][12] instanceof Date && now - v[i][12].getTime() < wk) o.act7++;
      if (String(v[i][8]) === 'دیدم') o.seen++;
      if (String(v[i][8]) === 'می‌بینم') o.plan++;
      if (String(v[i][10]) === 'بله') o.reminded++;
      var s = String(v[i][6] || '-');
      o.src[s] = (o.src[s] || 0) + 1;
    }
  }
  var ev = tgRmTab_(TG_RM_T_EV, TG_RM_EV_HEAD), le = ev.getLastRow();
  if (le >= 2) {
    var e = ev.getRange(2, 1, le - 1, 8).getValues(), pre = {}, dk = {};
    for (var j = 0; j < e.length; j++) {
      if (String(e[j][2]) !== rm) continue;
      var what = String(e[j][5]);
      if (what === 'بازتاب نوشت') o.refl++;
      if (what === 'اجازهٔ انتشار' && /ناشناس|با اسم/.test(String(e[j][7]))) o.pub++;
      if (what === 'ویس پیش از تماشا را شنید') pre[e[j][1]] = 1;
      if (what === 'ورق‌ها را دید') dk[e[j][1]] = 1;
    }
    o.pre = Object.keys(pre).length;
    o.deck = Object.keys(dk).length;
  }
  return o;
}

function tgPaInviteText_(o) {
  return '🏢 <b>در ' + tgEsc_(o['شهر']) + ' فضای حضوری داریم</b>\n\n' +
    'تجربه در ' + tgEsc_(o['شهر']) + ' با ' + tgEsc_(o['نام نمایشی'] || 'یک مرکز درمانی') + ' پارتنر شده است. ' +
    'اگر دوست دارید بعضی جلسه‌هایتان حضوری باشد و بعضی آنلاین، می‌توانید درخواست بدهید.\n\n' +
    'پذیرش، ارجاع و پرداخت مثل همیشه در تجربه می‌ماند. فقط اتاق اضافه می‌شود.';
}

function tgPaInvite(code, send) {
  var o = tgPaByCode_(code);
  if (!o) return 'پارتنر پیدا نشد';
  var city = String(o['شهر'] || '').trim();
  var out = [], seen = {};
  try {
    var all = tgPrAll_();
    for (var i = 0; i < all.length; i++) {
      var v = all[i].v || {};
      if (String(v.roles || '').indexOf('T') < 0) continue;
      if (String(v.city || '').indexOf(city) < 0) continue;
      var ch = String(v.chat || '').trim();
      if (!ch || seen[ch]) continue;
      seen[ch] = 1;
      out.push({ name: String(v.name || ''), chat: ch });
    }
  } catch (e) { return 'خطا: ' + e; }
  if (send) {
    var kb = { inline_keyboard: [[{ text: '🤝 می‌خواهم حضوری هم کار کنم', callback_data: 'pa:jp:' + code }]] };
    for (var j = 0; j < out.length; j++) { try { tgSend_(Number(out[j].chat), tgPaInviteText_(o), kb); } catch (e2) {} }
  }
  return (send ? 'فرستاده شد به ' : 'آماده برای ') + out.length + ' درمانگر: ' + out.map(function (x) { return x.name; }).join('، ');
}


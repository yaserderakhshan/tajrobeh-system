function tgStartLabel_(code) {
  if (!code) return '';
  try { var sl = typeof pbStartLabel_ === 'function' ? pbStartLabel_(code) : ''; if (sl) return sl; } catch (e) {}   /* v167: تب «کدهای start» */
  if (TG_START_MAP[code]) return TG_START_MAP[code];
  if (/^c_/.test(code) && typeof v17013OfLabel_ === 'function') { var ol = v17013OfLabel_(code); if (ol) return ol; }   /* v170.13 */
  if (/^ebi/.test(code) && typeof ebiStartLabel_ === 'function') { var el = ebiStartLabel_(code); if (el) return el; }   /* v170.16 */
  if (code.indexOf('ig_') === 0 && typeof igLabel_ === 'function') { var il = igLabel_(code); if (il) return il; }   /* v168 */
  if (code.indexOf('mag_') === 0) return 'مجله › ' + code.slice(4);
  if (code.indexOf('mg-') === 0) return 'مجله › ' + tgArtName_(code);
  if (typeof v1689StartLabel_ === 'function') { var vl = v1689StartLabel_(code); if (vl) return vl; }   /* v168.9: dsp_ ref_ prt_ */
  if (code.indexOf('rm-') === 0) return 'رودمپ › ' + code.slice(3);
  if (code.indexOf('gt-') === 0) return 'شروع تراپی › ' + code.slice(3);
  return code;
}

/* ---------- ورود خواننده از مقاله‌های مجله ---------- */
/* کد شروع: mg-<شناسهٔ مطلب>-<نوع>[-i]
   t تراپی · d خارج از ایران · a پیشنهاد فرهنگی · k دنبال‌کردن موضوع · s دانشجو
   پسوند i یعنی از خط سبک میان‌متنی آمده، نه بلوک اصلی. */
var TG_ART_TITLES = {
  '104': 'پدر خودشیفته و تأثیر او بر فرزندان',
  '86': 'مادر خودشیفته و تأثیر او بر فرزندان',
  '193': 'یادداشتی بر مرگ',
  '35': 'معرفی پادکست رواق',
  '89': 'دوازده پادکست شنیدنی',
  '118': 'سیگار در روانکاوی'
};
/* v167: عنوان از تب «عنوان مقاله‌ها» هاب محتوا (publish.gs، کش ۱۰ دقیقه)؛ این نقشهٔ کد فقط پشتیبان است */
function tgArtTitle_(id) {
  var t = '';
  try { if (typeof pbArtTitle_ === 'function') t = pbArtTitle_(id); } catch (e) {}
  return t || TG_ART_TITLES[String(id)] || '';
}
var TG_ART_VNAME = { t: 'تراپی', d: 'خارج از ایران', a: 'پیشنهاد فرهنگی', k: 'دنبال‌کردن موضوع', s: 'دانشجو' };

function tgArtParse_(code) {
  var p = String(code || '').split('-');
  if (p[0] !== 'mg' || !p[1]) return null;
  return { id: p[1], v: p[2] || 'k', inline: p[3] === 'i' };
}

function tgArtName_(code) {
  var x = tgArtParse_(code);
  if (!x) return String(code || '');
  return (tgArtTitle_(x.id) || ('مطلب ' + x.id)) + ' › ' +
         (TG_ART_VNAME[x.v] || x.v) + (x.inline ? ' › میان‌متن' : '');
}

/* ---------- ورود از صفحهٔ شروع تراپی: کد gt-<کلید> ---------- */
/* کلیدها با TG_TOPICS هم‌خانواده‌اند. d خارج از ایران، k فقط محتوا. */
var TG_GT_TOPIC = { rel: 'rel', anx: 'anx', dep: 'dep', self: 'self', fam: 'fam', child: 'kid', grief: 'oth' };

function tgGtStart_(chat, arg, name, uname) {
  if (String(arg || '').indexOf('gt-') !== 0) { return false; }
  var k = String(arg).slice(3);
  if (k === 'd') {
    tgSend_(chat, 'از صفحهٔ شروع تراپی آمدید.' + '\n' + '\n' + 'برای فارسی‌زبانان خارج از ایران جلسه به وقت محلی خودتان ست می‌شود و پرداخت ارزی است. جلسهٔ معارفه رایگان است.');
    tgOutside_(chat);
    return true;
  }
  if (k === 'k') {
    tgSend_(chat, 'باشد، فعلاً رزرو نه.' + '\n' + '\n' + 'موضوع‌هایی را که دوست دارید انتخاب کنید تا هر وقت مطلب تازه‌ای منتشر شد خبرتان کنیم. هر وقت هم خواستید معارفه بگیرید، همین‌جا هستیم.');
    tgFeedMenu_(chat, name, uname);
    return true;
  }
  var t = TG_GT_TOPIC[k] || '';
  if (t) {
    var lbl = '';
    for (var i = 0; i < TG_TOPICS.length; i++) { if (TG_TOPICS[i].k === t) { lbl = TG_TOPICS[i].topic; } }
    tgSend_(chat, 'خوش آمدید.' + (lbl ? ' موضوع «' + tgEsc_(lbl) + '» را انتخاب کرده‌اید.' : '') + '\n' + '\n' + 'دو سؤال کوتاه دیگر می‌پرسم و بعد وقت معارفهٔ رایگان را ست می‌کنیم. معارفه حدود بیست دقیقه است و شما را به چیزی متعهد نمی‌کند.');
    tgQuizGender_(chat, t);
    return true;
  }
  tgSend_(chat, 'از صفحهٔ شروع تراپی آمدید.' + '\n' + '\n' + 'چند سؤال کوتاه می‌پرسم تا درمانگر متناسب را پیدا کنیم. جلسهٔ معارفه رایگان است و حدود بیست دقیقه طول می‌کشد و لازم نیست چیزی را از قبل بدانید.');
  tgQuizTopic_(chat);
  return true;
}


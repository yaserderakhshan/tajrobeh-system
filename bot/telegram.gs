/* یک بار اجرا شود: دو تب مجله را می‌سازد و نقش «سردبیر» را به سردبیر فعلی می‌دهد. تکرارش ضرری ندارد. */
function tgMagSetup() {
  var log = [];
  var t = tgMagSheet_(TG_MAG_TOPICS_TAB, TG_MAG_TOPICS_HEAD);
  var w = tgMagSheet_(TG_MAG_TAB, TG_MAG_HEAD);
  try {
    t.getRange(2, 5, 500, 1).setDataValidation(SpreadsheetApp.newDataValidation()
      .requireValueInList(['باز', 'درخواست شده', 'در حال نوشتن', 'منتشر شد', 'بسته'], true).setAllowInvalid(true).build());
    w.getRange(2, 10, 500, 1).setDataValidation(SpreadsheetApp.newDataValidation()
      .requireValueInList([TG_MAG_ST.wait, TG_MAG_ST.write, TG_MAG_ST.done, TG_MAG_ST.pub, TG_MAG_ST.no], true).setAllowInvalid(true).build());
    w.getRange(2, 11, 500, 2).setNumberFormat('yyyy-mm-dd');
    t.setColumnWidth(2, 320); t.setColumnWidth(3, 280);
    w.setColumnWidth(8, 260); w.setColumnWidth(9, 320);
    t.setTabColor('#c83f49');
  } catch (e) { log.push('قالب: ' + e); }
  var sh = tgPeopleSheet_(), v = sh.getRange(2, 1, sh.getLastRow() - 1, 4).getValues();
  for (var i = 0; i < v.length; i++) {
    if (!tgSchChiefUser_() || String(v[i][1]).replace(/^@/, '').toLowerCase() !== tgSchChiefUser_()) continue;
    var roles = String(v[i][3]).split(/[,،;]+/).map(function (x) { return x.trim(); }).filter(Boolean);
    if (roles.indexOf(TG_MAG_EDITOR) < 0) {
      roles.push(TG_MAG_EDITOR);
      tgPersonSet_(i + 2, { 'نقش‌ها': roles }, 'مالک', { why: 'راه‌اندازی مجله' });
      log.push('نقش سردبیر اضافه شد: ' + v[i][0]);
    } else log.push('نقش سردبیر از قبل بود: ' + v[i][0]);
  }
  CacheService.getScriptCache().remove('plist');
  log.push('تب‌ها آماده: ' + TG_MAG_TOPICS_TAB + ' · ' + TG_MAG_TAB);
  log.push('سردبیرهای وصل‌شده: ' + tgMagEditors_().map(function (e) { return e.name; }).join('، '));
  Logger.log(log.join('\n'));
  return log.join('\n');
}


}

/* کد S- برای سطرهای بی‌کد */
function tgSchCodesFill() {
  if (TG_DRY) return 'dry';
  var sh = tgSchSheet_(TG_SCH_T_REQ, TG_SCH_REQ_HEAD);
  if (!sh || sh.getLastRow() < 2) return 'درخواست عضویت خالی است.';
  var col = tgSlCol_('کد لید مدرسه');
  var last = sh.getLastRow();
  var v = sh.getRange(2, 1, last - 1, Math.max(col, 1)).getValues();
  var max = 1000;
  for (var i = 0; i < v.length; i++) {
    var m = String(v[i][col - 1] || '').match(/^S-(\d+)$/);
    if (m && Number(m[1]) > max) max = Number(m[1]);
  }
  var n = 0;
  for (var j = 0; j < v.length; j++) {
    if (!String(v[j][0] || '').trim()) continue;
    if (String(v[j][col - 1] || '').trim()) continue;
    max++;
    sh.getRange(j + 2, col).setValue('S-' + max);
    if (!String(v[j][col] || '').trim()) sh.getRange(j + 2, col + 1).setValue(TG_SCH_STAGES[2]);
    n++;
  }
  return n + ' کد لید مدرسه ساخته شد.';
}


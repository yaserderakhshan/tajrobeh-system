function tgSeen_(update) {
  try {
    let c = null, why = '';
    if (update.channel_post && update.channel_post.chat) { c = update.channel_post.chat; why = 'channel_post'; }
    else if (update.my_chat_member && update.my_chat_member.chat) { c = update.my_chat_member.chat; why = 'my_chat_member'; }
    else if (update.message && update.message.forward_from_chat) { c = update.message.forward_from_chat; why = 'forward'; }
    if (!c) return;
    const line = c.id + ' | ' + (c.type || '') + ' | ' + (c.title || c.username || '') + ' | ' + why;
    const p = PropertiesService.getScriptProperties();
    const old = String(p.getProperty('TG_SEEN_CHATS') || '');
    if (old.indexOf(String(c.id) + ' |') > -1) return;
    p.setProperty('TG_SEEN_CHATS', (line + '\n' + old).slice(0, 4000));
  } catch (e) {}
}


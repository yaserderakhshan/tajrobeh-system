/* نزدیک‌ترین تاریخ آن روز هفته، و چند ساعت تا شروعش مانده */
function tgInpNext_(day, fromH) {
  var map = { 'شنبه': 6, 'یکشنبه': 0, 'دوشنبه': 1, 'سه‌شنبه': 2, 'چهارشنبه': 3, 'پنجشنبه': 4, 'جمعه': 5 };
  var now = TG_DRY ? new Date(TG_MEM['now'] || Date.UTC(2026, 8, 12, 6, 0)) : new Date();

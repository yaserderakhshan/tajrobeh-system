/* ───── قوانین: اول درمانگر، بعد مکان، بعد «همه» ───── */
function tgInpRule_(key, who, pid) {
  var rows = tgInpTab_(TG_INP_RULES, TG_INP_RLHEAD).rows(), best = null, rank = 9;
  rows.forEach(function (r) {
    if (String(r[0]).trim() !== key) return;
    var sc = String(r[1]).trim(), k = 9;
    if (who && sc && tgInpNameKey_(sc) === tgInpNameKey_(who)) k = 0; else if (pid && sc === pid) k = 1; else if (sc === 'همه' || !sc) k = 2;
    if (k < rank) { rank = k; best = String(r[2]).trim(); }
  });
  if (best === null) TG_INP_RULE_SEED.forEach(function (s) { if (s[0] === key) best = s[2]; });
  return best;
}
function tgInpRuleSet_(key, scope, val) {
  var t = tgInpTab_(TG_INP_RULES, TG_INP_RLHEAD), rows = t.rows();
  for (var i = 0; i < rows.length; i++) if (String(rows[i][0]).trim() === key && tgInpNameKey_(rows[i][1]) === tgInpNameKey_(scope)) { t.set(i + 2, 3, val); return; }

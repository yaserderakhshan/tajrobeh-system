/* یک بار (v166.24، خودکار بعد از انتشار): «نام کامل» لیدهای مدرسه و «نام» ثبت‌نام رویداد که متن دکمهٔ منو است پاک می‌شود
   (در «یادداشت مدرسه» یادداشت می‌ماند). خروجی فقط شمارش است. */
function tgSchNameFix() {
  var n = 0, m = 0;
  try {
    var sh = tgSchSheet_(TG_SCH_T_REQ, TG_SCH_REQ_HEAD);
    if (sh && sh.getLastRow() >= 2) {
      var k = sh.getLastRow() - 1, v = sh.getRange(2, 3, k, 1).getValues();
      for (var i = 0; i < k; i++) {
        var nm = String(v[i][0] || '').trim();
        if (nm && tgIsBtnLike_(nm)) { sh.getRange(i + 2, 3).setValue(''); try { tgSlNote_(i + 2, 'نام اشتباه (متن دکمهٔ منو) پاک شد؛ نام را از خود فرد بپرسید.', 'بات'); } catch (e) {} n++; }
      }
    }
  } catch (e1) { tgErr_('tgSchNameFix: ' + e1); }
  try {
    var se = tgSchSS_().getSheetByName(TG_EVR_TAB);
    if (se && se.getLastRow() >= 2) {
      var h = se.getRange(1, 1, 1, se.getLastColumn()).getValues()[0].map(function (x) { return String(x).trim(); }), c = h.indexOf('نام') + 1;
      if (c > 0) {
        var k2 = se.getLastRow() - 1, v2 = se.getRange(2, c, k2, 1).getValues();
        for (var j = 0; j < k2; j++) { var nm2 = String(v2[j][0] || '').trim(); if (nm2 && tgIsBtnLike_(nm2)) { se.getRange(j + 2, c).setValue(''); m++; } }
      }
    }
  } catch (e2) { tgErr_('tgSchNameFix رویداد: ' + e2); }
  if (!TG_DRY) { try { tgSchDropCache_(); } catch (e3) {} }
  return 'نام پاک‌شده: لید ' + n + ' · ثبت‌نام رویداد ' + m;
}

/* v166.24: خلاصهٔ روزانهٔ پیگیری برای مسئولان مدرسه (مسئول مدرسه و مدیر مدرسه) */
function tgCpFollowText_(camp, now) {
  var leads = tgCpRead_(TG_SCH_T_REQ).filter(function (l) { return tgCpS_(l['کد کمپین']) === camp.code; });
  var open = leads.filter(function (l) { return !tgSchClosed_(tgSchStNorm_(l['وضعیت']).st); });
  var noCall = open.filter(function (l) { return !tgCpS_(l['آخرین تماس']); }).length;
  var itv = leads.filter(function (l) { return tgCpS_(l['تاریخ مصاحبه']) || tgSchStageIdx_(tgSchStageNorm_(l['مرحلهٔ قیف']).st) === TG_SCH_SG.itv; }).length;
  var paid = leads.filter(function (l) { return /تأیید شد/.test(tgCpS_(l['وضعیت پرداخت'])); }).length;
  var left = tgCpDaysLeft_(camp, now);
  return '📌 <b>پیگیری ' + tgEsc_(camp.code) + '</b>\n' +
    'تماس‌نگرفته: ' + tgFa_(String(noCall)) + ' از ' + tgFa_(String(open.length)) + ' لید باز\n' +
    'مصاحبه: ' + tgFa_(String(itv)) + ' · پرداخت تأییدشده: ' + tgFa_(String(paid)) + '\n' +
    (left ? (left.n >= 0 ? tgFa_(String(left.n)) + ' روز تا مهلت ثبت‌نام' : 'مهلت ثبت‌نام گذشته') : 'مهلت ثبت‌نام در شیت نیست');
}

function tgCpDigest_(now, log) {
  var h = Number(Utilities.formatDate(now, TG_TZ, 'H'));
  if (h !== 9) return;
  var day = Utilities.formatDate(now, TG_TZ, 'yyyy-MM-dd');
  var k = 'CP_DIGEST';
  if (TG_DRY) { if (TG_MEM[k] === day) return; TG_MEM[k] = day; }
  else { var pr = PropertiesService.getScriptProperties(); if (pr.getProperty(k) === day) return; pr.setProperty(k, day); }
  var cs = tgCpCamps_().filter(function (c) { return c.state !== 'بسته'; });
  if (!cs.length) return;
  tgCpTell_('☀️ <b>کمپین‌های امروز</b>\n\n' + cs.map(function (c) { var f = ''; try { f = '\n\n' + tgCpFollowText_(c, now); } catch (eF) {} return tgCpDashText_(c) + f; }).join('\n\n―――\n\n'),
            { inline_keyboard: [[{ text: TG_CP_BTN, callback_data: 'cp:ol' }]] });
  log.push('گزارش صبح');
}

/* ---------- هل دادن وضعیت به سایت ----------
   سرور سایت (ایران) به googleusercontent نمی‌رسد، پس سایت نمی‌تواند API را بکشد.
   بات هر ۱۵ دقیقه و بعد از هر تغییر، خروجی API همهٔ کمپین‌ها را به وردپرس می‌فرستد.
   رمز در Script Property به نام CP_WP_SECRET و در اسنیپت WPCode 505050. */
var TG_CP_WP_PUSH = 'https://tajrobeh.life/wp-json/tj/v1/camp-push';

function tgCpPush_(why) {
  if (TG_DRY) { TG_OUTBOX.push({ kind: 'cppush', why: why || '' }); return 'dry'; }
  try {
    if (!ssCampHas_()) return 'بدون رمز';   /* v170.16.1: رمز فعلی و تازه در sitesec.gs (ssCampFetch_) */
    TG_CP_MEMO = null;
    var camps = tgCpCamps_().map(function (c) { return tgCpApi_({ code: c.code, nocache: 1 }); });
    var offers = []; try { if (typeof v17013OfPayload_ === 'function') offers = v17013OfPayload_(); } catch (eOf) { tgErr_('v17013OfPayload_', eOf); }   /* v170.13: آفرهای مراجعان */
    /* v166.23 (E-1006، سهمیهٔ حجم): فقط وقتی چیزی برای سایت عوض شده می‌فرستد (بی‌حساب زمان t)، و در تیک دست‌کم هر ۶۰ دقیقه یک بار */
    var P = PropertiesService.getScriptProperties();
    var sig = tgHash_(JSON.stringify(camps.map(function (c) { var x = {}; for (var k in c) if (k !== 't') x[k] = c[k]; return x; })) + JSON.stringify(offers));
    var lastAt = Number(P.getProperty('CP_PUSH_AT') || 0);
    if (sig === P.getProperty('CP_PUSH_H') && (why === 'تیک' ? Date.now() - lastAt < 60 * 60000 : Date.now() - lastAt < 2 * 60000)) return 'بی‌تغییر';
    var r = ssCampFetch_(TG_CP_WP_PUSH, { camps: camps, offers: offers, why: why || '' });
    var out = r.getResponseCode() + ' ' + String(r.getContentText()).slice(0, 120);
    if (r.getResponseCode() === 200) { P.setProperty('CP_PUSH_H', sig); P.setProperty('CP_PUSH_AT', String(Date.now())); }
    if (r.getResponseCode() !== 200) tgErr_('tgCpPush_: ' + out);
    return out;
  } catch (e) { tgErr_('tgCpPush_: ' + e); return 'خطا: ' + e; }
}

/* v166.29.1: کش فهرست همکاران سایت (tj/v1/thers) از سرور ایران به workers.dev نمی‌رسید و بیش از یک روز کهنه ماند.
   مثل کمپین، بات خودش فهرست عمومی (tgApiThPub_، همان که روی سایت عمومی است) را به سایت می‌فرستد: فقط وقتی عوض شده
   یا هر ۶۰ دقیقه یک بار. تا اسنیپت سایت مسیر thers-push را ندارد (۴۰۴)، هر ۶ ساعت یک بار و بی خطا امتحان می‌شود. */
var TG_TH_WP_PUSH = 'https://tajrobeh.life/wp-json/tj/v1/thers-push';
function tgThPush_() {
  if (TG_DRY) { TG_OUTBOX.push({ kind: 'thpush' }); return 'dry'; }
  var P = PropertiesService.getScriptProperties();
  if (!ssCampHas_()) return 'بدون رمز';   /* v170.16.1 */
  var now = Date.now(), lastAt = Number(P.getProperty('TH_PUSH_AT') || 0), miss = Number(P.getProperty('TH_PUSH_404') || 0);
  if (miss && now - miss < 6 * 3600000) return 'بی‌تغییر';
  var pub = tgApiThPub_();
  if (!pub || !pub.list || !pub.list.length) return 'فهرست خالی';
  var sig = tgHash_(JSON.stringify(pub.list));
  if (!tgThPushDue_(sig, P.getProperty('TH_PUSH_H'), now, lastAt)) return 'بی‌تغییر';
  var r = ssCampFetch_(TG_TH_WP_PUSH, { at: pub.at, list: pub.list });
  var code = r.getResponseCode();
  if (code === 200) { P.setProperty('TH_PUSH_H', sig); P.setProperty('TH_PUSH_AT', String(now)); P.deleteProperty('TH_PUSH_404'); return '200'; }
  if (code === 404) { P.setProperty('TH_PUSH_404', String(now)); return '۴۰۴ (اسنیپت سایت هنوز منتشر نشده)'; }
  tgErr_('tgThPush_: ' + code + ' ' + String(r.getContentText()).slice(0, 120));
  return String(code);
}
function tgThPushDue_(sig, lastSig, now, lastAt) { return sig !== lastSig || now - lastAt >= 60 * 60000; }

function tgCpPushNow() { var r = tgCpPush_('دستی'); Logger.log(r); return r; }

/* ---------- API برای سایت ---------- */

function tgCpApi_(p) {
  var q = tgCpS_(p.code || p.course);
  var key = 'cpapi' + q.toLowerCase();
  if (!TG_DRY && !p.nocache) { var hit = CacheService.getScriptCache().get(key); if (hit) { try { return JSON.parse(hit); } catch (e) {} } }
  var camp = tgCpFind_(q);
  if (!camp) return { ok: false, error: 'notfound' };
  var now = tgCpNow_(), tr = tgCpTier_(camp, now), w = tgCpWebinar_(camp, now);
  var fmt = function (d) { return d ? { fa: tgJDate_(d, TG_TZ), day: tgCpDay_(d), iso: Utilities.formatDate(d, 'UTC', "yyyy-MM-dd'T'HH:mm:ss'Z'"),
                                        time: tgFa_(Utilities.formatDate(d, TG_TZ, 'HH:mm')) } : null; };
  var bot = 'https://t.me/tajrobehlife_bot?start=';
  var out = {
    ok: true, code: camp.code, course: camp.course, circle: camp.circle, state: camp.state, stateLine: tgCpStateLine_(camp),
    canApply: tgCpCanApply_(camp), start: fmt(tgCpAt_(camp.start, '', false)), deadline: fmt(tgCpAt_(camp.deadline, '', true)),
    fee: camp.fee, prepay: camp.prepay, monthly: true, perk: TG_CP_PERK,
    tier: { label: tr.label, amount: tr.amount, until: fmt(tr.until), next: tr.next ? { label: tr.next.title, amount: tr.next.amount, from: fmt(tr.next.at) } : null },
    tiers: tgCpTiers_(camp).map(function (t) { return { label: t.title, amount: t.amount, from: fmt(t.at), until: fmt(t.until), now: t.at <= now && now <= t.until, past: t.until < now }; }),
    webinar: w ? { title: w.title, at: fmt(w.at), cal: tgCpCalUrl_(w.title, w.at, TG_CP_WEB_MIN, 'لایو تلگرام · ثبت‌نام و لینک ورود در بات تجربه') } : null,
    links: { card: bot + 'cp_' + camp.code, web: bot + 'web_' + camp.code, apply: bot + 'app_' + camp.code, pre: bot + 'pre_' + camp.code },
    t: now.getTime()
  };
  if (!TG_DRY) { try { CacheService.getScriptCache().put(key, JSON.stringify(out), 120); } catch (e2) {} }
  return out;
}

/* ---------- کال‌بک‌ها ---------- */

function tgOnCp_(cq, rest, chat, name, uname) {
  var p = String(rest || '').split(':'), a = p[0], c = p[1] || '';
  var msgId = cq.message && cq.message.message_id;
  var owner = function () { return tgCpIsOwner_(chat); };
  var camp = function () { return tgCpFind_(c); };
  if (a === 'nop') return null;
  if (a === 'wf') return tgWfStart_(chat, c);
  if (a === 'eft') return tgEftShow_(chat, c, uname);
  if (a === 'wq') return tgWfAnswer_(chat, c, p[2], p[3]);
  if (a === 'wx') return tgWfSave_(chat);
  if (a === 'ci') return tgCpCommInterest_(chat, c);
  if (a === 'who') return owner() ? tgCpWho_(chat, c) : null;
  if (a === 'wo') return owner() ? tgCpWhoOut_(chat, c) : null;
  if (a === 'wr') { if (!owner()) return null; tgCpDrop_(); return tgCpWho_(chat, c); }
  if (a === 'wfr') return owner() ? tgSend_(chat, tgWfReport_(c)) : null;
  if (a === 'c') return tgCommStart_(chat, uname);
  if (a === 'v') { var cv = camp(); return cv ? tgCpShow_(chat, cv) : tgCpList_(chat); }
  if (a === 'w' || a === 'a' || a === 'z') { var cw = camp(); if (!cw) return tgCpList_(chat); return tgCpAsk_(chat, cw, a, uname); }
  if (a === 'p') { var cp0 = camp(); return cp0 ? tgCpPayShow_(chat, cp0) : null; }
  if (a === 'pd') { var cpd = camp(); return cpd ? tgCpPaidAsk_(chat, cpd, p[2] === 'rest' ? 'rest' : 'pre') : null; }
  if (a === 'b') { var cb = camp(); return cb ? tgCpBookList_(chat, cb) : null; }
  if (a === 'k') return tgCpBook_(chat, c);
  if (a === 'in') { var ci = camp(); return ci ? tgCpWebEnter_(chat, ci, cq.from) : null; }
  if (a === 'off') { tgCpOff_(c, chat); return tgSend_(chat, '🔕 باشد، دیگر یادآوری این دوره را نمی‌فرستیم.'); }
  if (a === 'y') return tgCpPayDecide_(chat, c, p[2] === 'ok', msgId);
  if (a === 'r') return tgCpResult_(chat, uname, c, p[2]);
  if (a === 'rq') return tgSend_(chat, 'نتیجهٔ مصاحبهٔ ' + c + ':', tgCpResKb_(c));
  /* مصاحبه‌گر */
  if (a === 'iv') return tgCpIvDesk_(chat, '', uname);
  if (a === 'ia') {
    var who = tgCpIvWho_(chat, uname);
    var cs = tgCpIvCamps_(who ? who.name : '');
    if (!cs.length) return tgSend_(chat, 'الان کمپین بازی برای مصاحبه نیست.');
    if (cs.length === 1) return tgCpIvAddDay_(chat, cs[0].code);
    return tgSend_(chat, 'برای کدام دوره؟', { inline_keyboard: cs.map(function (x) { return [{ text: x.course, callback_data: 'cp:iad:' + x.code }]; }) });
  }
  if (a === 'iad') return tgCpIvAddDay_(chat, c);
  if (a === 'id') return tgCpIvAddHour_(chat, c, p[2]);
  if (a === 'ih') return tgCpIvAdd_(chat, uname, c, p[2], p[3]);
  if (a === 'ix') {
    var s = tgCpSlotRow_(c);
    var wh = tgCpIvWho_(chat, uname);
    if (!s || tgCpS_(s['وضعیت']) !== 'آزاد') return tgSend_(chat, 'فقط وقت آزاد حذف می‌شود.');
    if (!owner() && !(wh && tgNorm_(wh.name) === tgNorm_(tgCpS_(s['مصاحبه‌گر'])))) return tgSend_(chat, 'این وقت مال شما نیست.');
    tgCpSet_(TG_CPI_TAB, s._row, { 'وضعیت': 'لغو' });
    return tgSend_(chat, '🗑 حذف شد.');
  }
  if (a === 'il') {
    if (!tgCpIvWho_(chat, uname)) return tgSend_(chat, 'این بخش برای مصاحبه‌گرهاست.');
    tgSetFlag_('cpl', chat, 1800);
    return tgSend_(chat, 'لینک ثابت جلسهٔ خودتان را بفرستید (گوگل‌میت یا هر اتاق ثابت دیگر). برای همهٔ مصاحبه‌های بعدی همین می‌رود.',
                   { keyboard: [['↩️ بازگشت']], resize_keyboard: true });
  }
  /* مسئولان */
  if (!owner()) return tgSend_(chat, 'این دکمه برای مسئولان مدرسه است.');
  if (a === 'ol') return tgCpOwnerList_(chat);
  var co = camp();

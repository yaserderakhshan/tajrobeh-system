/* ---------- پیگیری کمپین: یک فهرست از همهٔ آدم‌های یک کمپین ---------- */
/* همهٔ ثبت‌نام‌های وبینار + همهٔ درخواست‌های دوره، یکجا، با یوزرنیم تلگرام
   و این‌که هر کس در بات هست یا باید دستی پیگیری شود. */
var TG_RC_HEAD = ['نام', 'شماره', 'یوزرنیم تلگرام', 'chat_id', 'منبع', 'مرحله',
  'کد درخواست', 'وضعیت درخواست', 'وضعیت پرداخت', 'دسترسی', 'مسئول پیگیری', 'یادداشت'];

function tgCpRecon(code) {
  /* v142: تب «پیگیری …» بایگانی شد. همه‌چیز در «درخواست عضویت» است (یک نفر × یک کمپین = یک سطر). این تابع دیگر چیزی نمی‌نویسد. */
  return 'v142: تب پیگیری بایگانی شد؛ فهرست کمپین ' + (code || 'EFT-1') + ' همان تب «لیدهای مدرسه» با فیلتر کد کمپین است.';
}

function tgCpReconOld_(code) {
  code = code || 'EFT-1';
  var ss = tgSchSS_();
  var ev = tgRcRows_(ss.getSheetByName(TG_EVR_TAB));
  var rq = tgRcRows_(ss.getSheetByName(TG_SCH_T_REQ));
  var us = tgRcRows_(tgSS_().getSheetByName('کاربران بات'));

  var umap = {};
  for (var u = 0; u < us.rows.length; u++) {
    var uc = tgRcAt_(us.head, us.rows[u], 'chat_id');
    if (uc) umap[uc] = tgRcAt_(us.head, us.rows[u], 'یوزرنیم');
  }

  var reqByChat = {}, reqByPhone = {}, reqs = [];
  for (var r = 0; r < rq.rows.length; r++) {
    var id = tgRcAt_(rq.head, rq.rows[r], 'شناسهٔ درخواست');
    if (!id) continue;
    var o = {
      id: id,
      name: tgRcAt_(rq.head, rq.rows[r], 'نام کامل'),
      user: tgRcAt_(rq.head, rq.rows[r], 'یوزرنیم تلگرام'),
      chat: tgRcAt_(rq.head, rq.rows[r], 'chat_id'),
      phone: tgRcPhone_(tgRcAt_(rq.head, rq.rows[r], 'شمارهٔ تماس')),
      status: tgRcAt_(rq.head, rq.rows[r], 'وضعیت'),
      stage: tgRcAt_(rq.head, rq.rows[r], 'مرحلهٔ قیف'),
      pay: tgRcAt_(rq.head, rq.rows[r], 'وضعیت پرداخت'),
      own: tgRcAt_(rq.head, rq.rows[r], 'مسئول پیگیری')
    };
    reqs.push(o);
    if (o.chat) reqByChat[o.chat] = o;
    if (o.phone) reqByPhone[o.phone] = o;
  }

  var out = [], seen = {}, usedReq = {};
  for (var e = 0; e < ev.rows.length; e++) {
    var evc = tgRcAt_(ev.head, ev.rows[e], 'کد رویداد');
    if (evc.indexOf(code + '/') !== 0) continue;
    var chat = tgRcAt_(ev.head, ev.rows[e], 'chat_id');
    var phone = tgRcPhone_(tgRcAt_(ev.head, ev.rows[e], 'شماره'));
    var key = chat || ('p' + phone);
    if (!key || seen[key]) continue;
    seen[key] = 1;
    var un = umap[chat] || '';
    var q = reqByChat[chat] || (phone ? reqByPhone[phone] : null);
    if (q) usedReq[q.id] = 1;
    out.push([
      tgRcAt_(ev.head, ev.rows[e], 'نام'),
      tgRcAt_(ev.head, ev.rows[e], 'شماره'),
      un ? ('@' + un) : '',
      chat,
      'بات · وبینار',
      q ? (q.stage || 'درخواست دوره') : 'ثبت‌نام وبینار',
      q ? q.id : '', q ? q.status : '', q ? q.pay : '',
      un ? 'بات' : 'بات (بدون یوزرنیم)',
      q ? q.own : '', ''
    ]);
  }

  for (var k = 0; k < reqs.length; k++) {
    var x = reqs[k];
    if (usedReq[x.id]) continue;
    if (x.chat && seen[x.chat]) continue;
    out.push([x.name, x.phone, x.user ? ('@' + x.user.replace('@', '')) : '', x.chat,
      x.chat ? 'بات · درخواست' : 'فرم سایت',
      x.stage || 'درخواست دوره', x.id, x.status, x.pay,
      x.chat ? (umap[x.chat] ? 'بات' : 'بات (بدون یوزرنیم)') : 'خارج از بات · پیگیری دستی',
      x.own, '']);
  }

  var name = 'پیگیری ' + code;
  var sh = ss.getSheetByName(name);
  if (!sh) sh = ss.insertSheet(name);
  sh.clear();
  sh.getRange(1, 1, 1, TG_RC_HEAD.length).setValues([TG_RC_HEAD]).setFontWeight('bold');
  if (out.length) sh.getRange(2, 1, out.length, TG_RC_HEAD.length).setValues(out);
  sh.setFrozenRows(1);
  var note = 'آخرین به‌روزرسانی: ' + tgJDateFull_(new Date(), TG_TZ) + ' ' +
    Utilities.formatDate(new Date(), TG_TZ, 'HH:mm');
  sh.getRange(1, TG_RC_HEAD.length).setNote(note);
  return out.length;
}

function tgRcPhone_(p) {
  var s = tgLatinDigits_(String(p == null ? '' : p)).replace(/[^0-9]/g, '');   /* v166.24: رقم فارسی هم */
  if (s.indexOf('0098') === 0) s = s.slice(4);
  if (s.indexOf('98') === 0 && s.length > 10) s = s.slice(2);
  if (s.indexOf('0') === 0) s = s.slice(1);
  return s.length >= 10 ? s.slice(-10) : s;
}

function tgRcRows_(sh) {
  if (!sh || sh.getLastRow() < 2) return { head: [], rows: [] };
  var v = sh.getRange(1, 1, sh.getLastRow(), sh.getLastColumn()).getDisplayValues();
  var head = v[0].map(function (x) { return String(x).trim(); });
  return { head: head, rows: v.slice(1) };
}

function tgRcAt_(head, row, name) {
  var i = head.indexOf(name);
  return i > -1 && i < row.length ? String(row[i]).trim() : '';
}

/* v142: آمار از تب اصلی، به ترتیب مراحل قیف */
function tgCpReconStats(code) {
  code = code || 'EFT-1';
  var rows = tgCpRead_(TG_SCH_T_REQ).filter(function (l) { return tgCpS_(l['کد کمپین']) === code; });
  if (!rows.length) return null;
  var st = { all: rows.length, stage: {}, access: {}, status: {} };
  for (var s = 0; s < TG_SCH_STAGES.length; s++) st.stage[TG_SCH_STAGES[s]] = 0;
  for (var i = 0; i < rows.length; i++) {
    var sg = tgSchStageNorm_(rows[i]['مرحلهٔ قیف']).st, ac = tgCpS_(rows[i]['chat_id']) ? 'در بات' : 'خارج از بات · پیگیری دستی';
    var stt = tgSchStNorm_(rows[i]['وضعیت']).st;
    st.stage[sg] = (st.stage[sg] || 0) + 1;
    st.access[ac] = (st.access[ac] || 0) + 1;
    st.status[stt] = (st.status[stt] || 0) + 1;
  }
  return st;
}

/*  مرکز تجرب/*  مرکز تجربه زندگی — بات تلگرام  @tajrobehlife_bot
    نسخهٔ ۴

    تحویل پیام: پولینگ تطبیقی.
    وبهوک مستقیم روی Apps Script کار نمی‌کند؛ گوگل به POST تلگرام «302 Found»
    می‌دهد و تلگرام ریدایرکت را دنبال نمی‌کند، پس پیام‌ها در صف می‌مانند و
    ساعت‌ها بعد دسته‌ای تحویل داده می‌شوند. اگر روزی رلهٔ سرور سایت ساخته شد،
    آدرسش را در Script Property به نام TG_RELAY_URL بگذار و tgUseWebhook را
    یک بار اجرا کن؛ بقیه‌اش خودکار است.

    وابستگی: Script Properties باید TELEGRAM_TOKEN داشته باشد.
    قاعدهٔ حیاتی: در تب Sheet1 هرگز فرمول نریز.
*/


// این تابع اولین تابع فایل است تا در انتخابگر Run پیش‌فرض باشد.
// هر بار هر کاری خواستی، بدنه‌اش را عوض کن: tgRunTests() یا tgBootstrap() یا tgSelfTest()

/* ==================== v101 · صف کارها ====================
   «کارهایی که ما از تیم می‌خواهیم». تا امروز این‌ها در گفت‌وگوهای
   پراکنده می‌ماند و گم می‌شد: «به مسئول مدرسه گفتیم همهٔ استادها به بات
   بپیوندند» جایی ثبت نبود، پس نه مسئول مدرسه یادش می‌ماند نه ما می‌دانستیم
   کجای کار است. حالا هر خواسته یک ردیف است با مسئول، مهلت و وضعیت؛
   در بات به شکل تسک دیده می‌شود و رد پایش در همان هاب تیم می‌ماند.
   ======================================================== */

var TG_TSK_TAB = 'کارها';
var TG_TSK_HEAD = ['کد', 'عنوان', 'شرح', 'تیم', 'مسئول', 'یوزرنیم', 'chat_id',
  'اولویت', 'مهلت', 'وضعیت', 'یادداشت مسئول', 'ایجاد توسط', 'تاریخ ایجاد',
  'آخرین تغییر', 'آخرین یادآوری', 'پیوند', 'رد پا', 'تکرار'];

var TG_TSK_TEAMS = ['پذیرش', 'مدرسه', 'مجله', 'کلینیک', 'مالی', 'فنی'];
var TG_TSK_PRI = ['فوری', 'وقت‌دار', 'عادی'];
var TG_TSK_ST = {
  open: 'باز',
  doing: 'در جریان',
  done: 'انجام شد',
  closed: 'بسته',
  drop: 'منتفی شد'
};
var TG_TSK_BTN = '✅ کارهای من';
var TG_TSK_NEW = '➕ کار تازه';

/* نقشی که هر تیم با آن در بات شناخته می‌شود؛ برای اینکه «کارهای من»
   بدون پرسیدن بفهمد کدام ردیف‌ها مال این آدم است. */
var TG_TSK_TEAM_ROLE = {
  'پذیرش': 'پذیرش',
  'مدرسه': 'مدرسه',
  'مجله': 'سردبیر',
  'کلینیک': 'درمانگر',
  'مالی': 'مالی',
  'فنی': 'ناظر'
};

function tgTskSheet_() {
  var ss = tgSS_();
  var sh = ss.getSheetByName(TG_TSK_TAB);
  if (!sh) sh = ss.insertSheet(TG_TSK_TAB);
  var first = sh.getLastRow() ? String(sh.getRange(1, 1).getValue() || '') : '';
  if (first !== TG_TSK_HEAD[0]) {
    sh.getRange(1, 1, 1, TG_TSK_HEAD.length).setValues([TG_TSK_HEAD]);
    sh.setFrozenRows(1);
    sh.getRange(1, 1, 1, TG_TSK_HEAD.length).setFontWeight('bold');
    try { sh.setRightToLeft(true); } catch (e) {}
  }
  return sh;
}

function tgTskRows_() {
  var sh = tgTskSheet_();
  var n = sh.getLastRow();
  if (n < 2) return [];
  return sh.getRange(2, 1, n - 1, TG_TSK_HEAD.length).getValues();
}

function tgTskCode_() {
  var rows = tgTskRows_();
  var max = 0;
  for (var i = 0; i < rows.length; i++) {
    var m = String(rows[i][0] || '').match(/^K-(\d+)$/);
    if (m) { var k = parseInt(m[1], 10); if (k > max) max = k; }
  }
  return 'K-' + ('00' + (max + 1)).slice(-3);
}

function tgTskRowBy_(code) {
  var rows = tgTskRows_();
  for (var i = 0; i < rows.length; i++) if (String(rows[i][0]) === String(code)) return i + 2;
  return 0;
}

function tgTskGet_(code) {
  var r = tgTskRowBy_(code);
  if (!r) return null;
  var vals = tgTskSheet_().getRange(r, 1, 1, TG_TSK_HEAD.length).getValues()[0];
  var o = { row: r };
  for (var i = 0; i < TG_TSK_HEAD.length; i++) o[i] = vals[i];
  o.code = vals[0]; o.title = vals[1]; o.body = vals[2]; o.team = vals[3];
  o.who = vals[4]; o.uname = vals[5]; o.chat = vals[6]; o.pri = vals[7];
  o.due = vals[8]; o.st = vals[9]; o.note = vals[10]; o.by = vals[11];
  o.made = vals[12]; o.moved = vals[13]; o.ping = vals[14]; o.link = vals[15];
  o.trace = vals[16]; o.rep = vals[17];
  return o;
}

function tgTskSet_(code, col, val) {
  var r = tgTskRowBy_(code);
  if (!r) return false;
  var sh = tgTskSheet_();
  sh.getRange(r, col).setValue(val);
  sh.getRange(r, 14).setValue(tgTskNow_());
  if (col === 10 && typeof opsAdaptTaskSt_ === 'function') opsAdaptTaskSt_(code, val);
  return true;
}

function tgTskNow_() {
  try { return tgJDate_(new Date(), TG_TZ_IR || 'Asia/Tehran'); } catch (e) {}
  return Utilities.formatDate(new Date(), 'Asia/Tehran', 'yyyy-MM-dd HH:mm');
}

/* ساختن یک کار. مقصد می‌تواند با chat_id یا یوزرنیم داده شود. */
function tgTskAdd_(o) {
  var sh = tgTskSheet_();
  var code = tgTskCode_();
  sh.appendRow([
    code,
    String(o.title || '').slice(0, 200),
    String(o.body || '').slice(0, 1500),
    o.team || '',
    o.who || '',
    String(o.uname || '').replace(/^@/, ''),
    o.chat || '',
    o.pri || 'عادی',
    o.due || '',
    TG_TSK_ST.open,
    '',
    o.by || '',
    tgTskNow_(),
    tgTskNow_(),
    '',
    o.link || '',
    o.trace || '',
    o.rep || 'یک‌بار'
  ]);
  if (typeof opsAdaptTask_ === 'function') opsAdaptTask_(code, o);
  return code;
}

/* کارهای باز یک آدم. هم با chat_id می‌گردد هم با یوزرنیم، چون گاهی
   کار را پیش از آنکه طرف به بات بپیوندد ثبت می‌کنیم. */
function tgTskMine_(chat, uname, roles) {
  var rows = tgTskRows_();
  var u = String(uname || '').replace(/^@/, '').toLowerCase();
  var rl = roles || [];
  var out = [];
  for (var i = 0; i < rows.length; i++) {
    var r = rows[i];
    var st = String(r[9] || '');
    if (st === TG_TSK_ST.closed) continue;
    if (st === TG_TSK_ST.drop) continue;
    var mine = false;
    if (String(r[6] || '') === String(chat)) mine = true;
    if (!mine) { if (u) { if (String(r[5] || '').replace(/^@/, '').toLowerCase() === u) mine = true; } }
    if (!mine) {
      /* کار بی‌مسئولِ مشخص، برای هر کسی که آن نقش تیم را دارد دیده می‌شود */
      var noOwner = !String(r[6] || '') && !String(r[5] || '');
      if (noOwner) {
        var need = TG_TSK_TEAM_ROLE[String(r[3] || '')] || '';
        if (need) { if (rl.indexOf(need) > -1) mine = true; }
      }
    }
    if (mine) out.push({ row: i + 2, code: r[0], title: r[1], body: r[2], team: r[3], pri: r[7], due: r[8], st: st, note: r[10] });
  }
  out.sort(function (a, b) {
    var p = TG_TSK_PRI.indexOf(String(a.pri)) - TG_TSK_PRI.indexOf(String(b.pri));
    if (p) return p;
    return String(a.due || 'z') < String(b.due || 'z') ? -1 : 1;
  });
  return out;
}

function tgTskCard_(t) {
  var mark = t.st === TG_TSK_ST.doing ? '🔵' : '⚪️';
  if (t.st === TG_TSK_ST.done) mark = '✅';
  var s = mark + ' <b>' + tgEsc_(String(t.title)) + '</b>\n';
  if (t.body) s += tgEsc_(String(t.body)) + '\n';
  var meta = [];
  if (t.team) meta.push('تیم ' + t.team);
  if (t.pri) { if (String(t.pri) !== 'عادی') meta.push(String(t.pri)); }
  if (t.due) meta.push('مهلت: ' + String(t.due));
  if (meta.length) s += '<i>' + tgEsc_(meta.join(' · ')) + '</i>\n';
  if (t.note) s += '📝 ' + tgEsc_(String(t.note)) + '\n';
  return s + '<code>' + tgEsc_(String(t.code)) + '</code>';
}

function tgTskKb_(t) {
  var rows = [];
  if (String(t.st) !== TG_TSK_ST.doing) rows.push([{ text: '🔵 در جریانم', callback_data: 'tk:go:' + t.code }]);
  rows.push([{ text: '✅ انجام شد', callback_data: 'tk:ok:' + t.code }]);
  rows.push([{ text: '📝 توضیح می‌نویسم', callback_data: 'tk:note:' + t.code }]);
  return { inline_keyboard: rows };
}

/* فهرست کارهای من در بات و مینی‌اپ — یک کد، دو مسیر. */
function tgTskList_(chat, uname, roles) {
  var mine = tgTskMine_(chat, uname, roles);
  if (!mine.length) {
    tgSend_(chat, '✅ کار بازی برای شما ثبت نشده. هر وقت چیزی از شما بخواهیم، همین‌جا می‌آید.');
    return;
  }
  tgSend_(chat, '📋 <b>کارهای شما</b> · ' + tgFa_(mine.length) + ' مورد');
  for (var i = 0; i < mine.length; i++) {
    if (i >= 12) { tgSend_(chat, 'و ' + tgFa_(mine.length - 12) + ' مورد دیگر. وقتی این‌ها بسته شود بقیه می‌آید.'); break; }
    tgSend_(chat, tgTskCard_(mine[i]), tgTskKb_(mine[i]));
  }
}

/* کال‌بک‌های tk: */
function tgTskCb_(chat, data, name) {
  var p = String(data).split(':');
  var act = p[1], code = p[2];
  var t = tgTskGet_(code);
  if (!t) { tgSend_(chat, 'این کار پیدا نشد. شاید بسته شده باشد.'); return true; }
  if (act === 'go') {
    tgTskSet_(code, 10, TG_TSK_ST.doing);
    tgSend_(chat, '🔵 ثبت شد: «' + tgEsc_(String(t.title)) + '» در جریان است. ممنون که خبر دادید.');
    tgTskTell_(t, name + ' کار «' + String(t.title) + '» را شروع کرد.');
    return true;
  }
  if (act === 'ok') {
    tgTskSet_(code, 10, TG_TSK_ST.done);
    tgSend_(chat, '✅ دست شما درد نکند. «' + tgEsc_(String(t.title)) + '» انجام‌شده ثبت شد.');
    tgTskTell_(t, name + ' کار «' + String(t.title) + '» را انجام داد.');
    return true;
  }
  if (act === 'note') {
    tgSetVal_('tsk', chat, JSON.stringify({ step: 'note', code: code }));
    tgSend_(chat, '📝 بنویسید کجای کار هستید یا چه چیزی لازم دارید. همین را برای ما می‌فرستم.');
    return true;
  }
  return false;
}

/* خبر دادن به کسی که کار را خواسته بود */
function tgTskTell_(t, text) {
  var by = String(t.by || '');
  var m = by.match(/(\d{5,})/);
  if (!m) return;
  try { tgSend_(m[1], '📋 ' + tgEsc_(text)); } catch (e) {}
}
/* ==================== v101 · صندوق پیام ====================
   یک نخ گفت‌وگو میان ما و هر آدمِ سامانه (درمانگر، استاد، دانشجو،
   نویسنده، همکار پذیرش). مثل تیکت: باز می‌شود، جواب می‌گیرد، بسته
   می‌شود؛ و همهٔ رفت‌وبرگشت زیر یک کد می‌ماند. هم از بات، هم از
   مینی‌اپ، هم از این طرف هم از آن طرف.
   ============================================================ */

var TG_BOX_TAB = 'صندوق پیام';
var TG_BOX_HEAD = ['کد', 'رشته', 'طرف chat_id', 'نام', 'نقش', 'فرستنده',
  'متن', 'زمان', 'وضعیت رشته', 'مسئول رشته', 'خوانده شد', 'کانال'];

var TG_BOX_FROM_US = 'تیم';
var TG_BOX_FROM_THEM = 'طرف';
var TG_BOX_ST = { open: 'باز', answered: 'پاسخ داده', closed: 'بسته' };
var TG_BOX_BTN = '✉️ پیام‌ها';
var TG_BOX_NEW = '✉️ پیام تازه';

function tgBoxSheet_() {
  var ss = tgSS_();
  var sh = ss.getSheetByName(TG_BOX_TAB);
  if (!sh) sh = ss.insertSheet(TG_BOX_TAB);
  var first = sh.getLastRow() ? String(sh.getRange(1, 1).getValue() || '') : '';
  if (first !== TG_BOX_HEAD[0]) {
    sh.getRange(1, 1, 1, TG_BOX_HEAD.length).setValues([TG_BOX_HEAD]);
    sh.setFrozenRows(1);
    sh.getRange(1, 1, 1, TG_BOX_HEAD.length).setFontWeight('bold');
    try { sh.setRightToLeft(true); } catch (e) {}
  }
  return sh;
}

function tgBoxRows_() {
  var sh = tgBoxSheet_();
  var n = sh.getLastRow();
  if (n < 2) return [];
  return sh.getRange(2, 1, n - 1, TG_BOX_HEAD.length).getValues();
}

function tgBoxCode_(pre, col) {
  var rows = tgBoxRows_();
  var max = 0, re = new RegExp('^' + pre + '-(\\d+)$');
  for (var i = 0; i < rows.length; i++) {
    var m = String(rows[i][col] || '').match(re);
    if (m) { var k = parseInt(m[1], 10); if (k > max) max = k; }
  }
  return pre + '-' + ('00' + (max + 1)).slice(-3);
}

/* افزودن یک پیام به رشته. اگر thread ندهید، رشتهٔ تازه باز می‌شود. */
function tgBoxAdd_(o) {
  var sh = tgBoxSheet_();
  var th = o.thread || tgBoxCode_('TH', 1);
  var code = tgBoxCode_('P', 0);
  sh.appendRow([
    code, th, String(o.chat || ''), o.name || '', o.role || '',
    o.from || TG_BOX_FROM_US,
    String(o.text || '').slice(0, 3000),
    tgTskNow_(),
    o.st || TG_BOX_ST.open,
    o.owner || '',
    '',
    o.via || 'بات'
  ]);
  tgBoxThreadSt_(th, o.st || (o.from === TG_BOX_FROM_THEM ? TG_BOX_ST.open : TG_BOX_ST.answered));
  return { code: code, thread: th };
}

/* وضعیت را روی همهٔ ردیف‌های یک رشته یکسان نگه می‌دارد تا فهرست‌ها دروغ نگویند */
function tgBoxThreadSt_(th, st) {
  var sh = tgBoxSheet_();
  var rows = tgBoxRows_();
  for (var i = 0; i < rows.length; i++) {
    if (String(rows[i][1]) === String(th)) sh.getRange(i + 2, 9).setValue(st);
  }
}

function tgBoxThread_(th) {
  var rows = tgBoxRows_();
  var out = [];
  for (var i = 0; i < rows.length; i++) {
    if (String(rows[i][1]) !== String(th)) continue;
    out.push({ row: i + 2, code: rows[i][0], thread: rows[i][1], chat: rows[i][2], name: rows[i][3],
      role: rows[i][4], from: rows[i][5], text: rows[i][6], at: rows[i][7], st: rows[i][8], owner: rows[i][9] });
  }
  return out;
}

/* رشته‌های یک آدم (نمای خودِ طرف) */
function tgBoxMine_(chat) {
  var rows = tgBoxRows_();
  var seen = {}, out = [];
  for (var i = rows.length - 1; i >= 0; i--) {
    if (String(rows[i][2]) !== String(chat)) continue;
    var th = String(rows[i][1]);
    if (seen[th]) continue;
    seen[th] = 1;
    out.push({ thread: th, last: rows[i][6], from: rows[i][5], at: rows[i][7], st: rows[i][8], name: rows[i][3] });
  }
  return out;
}

/* رشته‌های باز برای تیم (نمای ما) */
function tgBoxQueue_() {
  var rows = tgBoxRows_();
  var seen = {}, out = [];
  for (var i = rows.length - 1; i >= 0; i--) {
    var th = String(rows[i][1]);
    if (seen[th]) continue;
    seen[th] = 1;
    if (String(rows[i][8]) === TG_BOX_ST.closed) continue;
    out.push({ thread: th, chat: rows[i][2], name: rows[i][3], role: rows[i][4],
      from: rows[i][5], last: rows[i][6], at: rows[i][7], st: rows[i][8] });
  }
  out.sort(function (a, b) { return String(a.from) === TG_BOX_FROM_THEM ? -1 : 1; });
  return out;
}

function tgBoxCardText_(t) {
  var who = String(t.from) === TG_BOX_FROM_THEM ? '👤 ' + (t.name || 'ایشان') : '🍓 تجربه';
  var s = who + ' · <i>' + tgEsc_(String(t.at || '')) + '</i>\n' + tgEsc_(String(t.last || t.text || ''));
  return s;
}

/* پیام ما به یک نفر: می‌رود، و او دکمهٔ پاسخ می‌بیند */
function tgBoxSend_(toChat, text, o) {
  var meta = o || {};
  var r = tgBoxAdd_({
    thread: meta.thread || '', chat: toChat, name: meta.name || '', role: meta.role || '',
    from: TG_BOX_FROM_US, text: text, owner: meta.owner || '', via: meta.via || 'بات',
    st: TG_BOX_ST.answered
  });
  try {
    tgSend_(toChat, '✉️ <b>پیامی از مرکز تجربه</b>\n\n' + tgEsc_(text), {
      inline_keyboard: [[{ text: '↩️ پاسخ می‌دهم', callback_data: 'bx:re:' + r.thread }]]
    });
  } catch (e) {}
  return r;
}

/* پاسخ طرف: به مسئول رشته و به مالک خبر می‌دهد */
function tgBoxReply_(chat, th, text, name, role) {
  var r = tgBoxAdd_({
    thread: th, chat: chat, name: name, role: role,
    from: TG_BOX_FROM_THEM, text: text, st: TG_BOX_ST.open
  });
  var list = tgBoxThread_(th);
  var owner = '';
  for (var i = 0; i < list.length; i++) if (list[i].owner) owner = String(list[i].owner);
  var m = owner.match(/(\d{5,})/);
  if (m) {
    try {
      tgSend_(m[1], '📬 <b>پاسخ ' + tgEsc_(name || 'ایشان') + '</b>\n\n' + tgEsc_(text),
        { inline_keyboard: [[{ text: '↩️ جواب می‌دهم', callback_data: 'bx:us:' + th }], [{ text: '✔️ بستن رشته', callback_data: 'bx:close:' + th }]] });
    } catch (e) {}
  }
  return r;
}

function tgBoxCb_(chat, data, name, role) {
  var p = String(data).split(':');
  var act = p[1], th = p[2];
  if (act === 're') {
    tgSetVal_('box', chat, JSON.stringify({ step: 'reply', thread: th }));
    tgSend_(chat, '✍️ پاسخ‌تان را همین‌جا بنویسید. مستقیم به ما می‌رسد.');
    return true;
  }
  if (act === 'us') {
    tgSetVal_('box', chat, JSON.stringify({ step: 'us', thread: th }));
    tgSend_(chat, '✍️ جواب‌تان را بنویسید تا برای ایشان بفرستم.');
    return true;
  }
  if (act === 'close') {
    tgBoxThreadSt_(th, TG_BOX_ST.closed);
    tgSend_(chat, '✔️ رشته بسته شد.');
    return true;
  }
  if (act === 'open') {
    var list = tgBoxThread_(th);
    if (!list.length) { tgSend_(chat, 'این رشته پیدا نشد.'); return true; }
    var s = '🧵 <b>رشتهٔ ' + tgEsc_(th) + '</b>';
    if (list[0].name) s += ' · ' + tgEsc_(String(list[0].name));
    tgSend_(chat, s);
    for (var i = 0; i < list.length; i++) {
      if (i > 14) break;
      tgSend_(chat, tgBoxCardText_({ from: list[i].from, name: list[i].name, at: list[i].at, last: list[i].text }));
    }
    tgSend_(chat, 'چه کنیم؟', { inline_keyboard: [
      [{ text: '↩️ جواب می‌دهم', callback_data: 'bx:us:' + th }],
      [{ text: '✔️ بستن رشته', callback_data: 'bx:close:' + th }]
    ] });
    return true;
  }
  return false;
}

function tgBoxList_(chat, isTeam) {
  var list = isTeam ? tgBoxQueue_() : tgBoxMine_(chat);
  if (!list.length) {
    tgSend_(chat, '📭 صندوق خالی است.');
    return;
  }
  tgSend_(chat, '📬 <b>صندوق پیام</b> · ' + tgFa_(list.length) + ' رشته');
  for (var i = 0; i < list.length; i++) {
    if (i >= 12) { tgSend_(chat, 'و ' + tgFa_(list.length - 12) + ' رشتهٔ دیگر.'); break; }
    var t = list[i];
    var head = isTeam ? ('👤 ' + tgEsc_(String(t.name || t.chat)) + (t.role ? ' · ' + tgEsc_(String(t.role)) : '')) : '🧵 ' + tgEsc_(String(t.thread));
    var tail = String(t.from) === TG_BOX_FROM_THEM ? '🔴 منتظر پاسخ ما' : '⚪️ منتظر پاسخ ایشان';
    if (String(t.st) === TG_BOX_ST.closed) tail = '✔️ بسته';
    tgSend_(chat, head + '\n' + tgEsc_(String(t.last || '').slice(0, 160)) + '\n<i>' + tail + '</i>',
      { inline_keyboard: [[{ text: 'باز کردن رشته', callback_data: 'bx:open:' + t.thread }]] });
  }
}
/* ==================== v101 · داشبوردها ====================
   هر کس وقتی وارد می‌شود باید در یک نگاه بداند «الان چه کاری با من
   است». نه فهرست بلند، نه عدد بی‌معنی: چند خط، هر خط یک کار.
   ========================================================= */

/* شمارندهٔ بی‌خطر: اگر تب نبود یا ستون جابه‌جا شده بود، به‌جای خطا
   خالی برمی‌گرداند و داشبورد «—» نشان می‌دهد. */
function tgDashN_(ss, tab, col, test) {
  try {
    var sh = ss.getSheetByName(tab);
    if (!sh) return null;
    var n = sh.getLastRow();
    if (n < 2) return 0;
    if (!col) return n - 1;
    var vals = sh.getRange(2, col, n - 1, 1).getValues();
    var c = 0;
    for (var i = 0; i < vals.length; i++) if (test(String(vals[i][0] || ''))) c++;
    return c;
  } catch (e) { return null; }
}

function tgDashLine_(label, n, hint) {
  var val = (n === null || n === undefined) ? '—' : tgFa_(n);
  return '· ' + label + ': <b>' + val + '</b>' + (hint ? ' <i>' + hint + '</i>' : '');
}

function tgDashHead_(title, name) {
  return '🏠 <b>' + title + '</b>' + (name ? ' · ' + tgEsc_(String(name)) : '') + '\n';
}

function tgDashTaskLine_(chat, uname, roles) {
  var mine = tgTskMine_(chat, uname, roles);
  var doing = 0;
  for (var i = 0; i < mine.length; i++) if (String(mine[i].st) === TG_TSK_ST.doing) doing++;
  return tgDashLine_('کارهای باز شما', mine.length, doing ? '(' + tgFa_(doing) + ' در جریان)' : '');
}

function tgDashBoxLine_(chat, isTeam) {
  var list = isTeam ? tgBoxQueue_() : tgBoxMine_(chat);
  var wait = 0;
  for (var i = 0; i < list.length; i++) {
    var f = String(list[i].from);
    if (isTeam ? f === TG_BOX_FROM_THEM : f === TG_BOX_FROM_US) wait++;
  }
  return tgDashLine_('پیام‌های منتظر پاسخ', wait, list.length ? 'از ' + tgFa_(list.length) + ' رشته' : '');
}

function tgDashKb_(extra) {
  var rows = [
    [{ text: '✅ کارهای من', callback_data: 'db:task' }, { text: '📬 صندوق پیام', callback_data: 'db:box' }]
  ];
  (extra || []).forEach(function (r) { rows.push(r); });
  rows.push([{ text: '🔄 تازه کن', callback_data: 'db:me' }]);
  return { inline_keyboard: rows };
}

/* ---------- پذیرش ---------- */
function tgDashDesk_(chat, name, uname, roles) {
  var ss = tgSS_();
  var s = tgDashHead_('داشبورد پذیرش', name);
  var nOpen = 0; try { nOpen = tgOpenLeads_().length; } catch (eO) { nOpen = tgDashN_(ss, 'لیدها', 0, null); }
  s += tgDashLine_('لیدهای باز', nOpen) + '\n';
  s += tgDashTaskLine_(chat, uname, roles) + '\n';
  s += tgDashBoxLine_(chat, true) + '\n';
  s += tgDashLine_('پروفایل‌های در انتظار بازبینی', tgDashN_(ss, TG_PQ_TAB, 0, null)) + '\n';
  s += '\n<i>هر عدد یک دکمه در همین منو دارد.</i>';
  tgSend_(chat, s, tgDashKb_([[{ text: '📥 کارتابل پذیرش', callback_data: 'db:desk' }]]));
}

/* ---------- مدرسه ---------- */
function tgDashSch_(chat, name, uname, roles) {
  var ss = tgSchSS_();
  var s = tgDashHead_('داشبورد مدرسه', name);
  s += tgDashLine_('لیدهای مدرسه', tgDashN_(ss, TG_SCH_T_REQ, 0, null)) + '\n';
  s += tgDashLine_('دانش‌آموختگان ثبت‌شده', tgDashN_(ss, 'دانش‌آموختگان', 0, null)) + '\n';
  s += tgDashLine_('اپلای تراپیست', tgDashN_(ss, 'اپلای تراپیست', 0, null)) + '\n';
  var noBot = tgDashN_(ss, 'استادان و سوپروایزرها', 6, function (x) { return !x; });
  s += tgDashLine_('استادانی که هنوز به بات نپیوسته‌اند', noBot) + '\n';
  s += tgDashTaskLine_(chat, uname, roles) + '\n';
  s += tgDashBoxLine_(chat, true) + '\n';
  tgSend_(chat, s, tgDashKb_([[{ text: '🎓 کارهای مدرسه', callback_data: 'db:sch' }]]));
}

/* ---------- مجله ---------- */
function tgDashMag_(chat, name, uname, roles) {
  var ss = tgCSS_();
  var s = tgDashHead_('داشبورد مجله', name);
  var free = tgDashN_(ss, TG_MAG_TOPICS_TAB, 8, function (x) { return x === TG_MAG_TOPIC_OPEN || !x; });
  s += tgDashLine_('موضوع‌های آزاد در استخر', free) + '\n';
  var wait = tgDashN_(ss, TG_MAG_TAB, 8, function (x) { return x === TG_MAG_ST.wait; });
  s += tgDashLine_('منتظر تأیید سردبیر', wait, wait ? '← اول این‌ها' : '') + '\n';
  var writing = tgDashN_(ss, TG_MAG_TAB, 8, function (x) { return x === TG_MAG_ST.write; });
  s += tgDashLine_('در حال نگارش', writing) + '\n';
  var pub = tgDashN_(ss, TG_MAG_TAB, 8, function (x) { return x === TG_MAG_ST.pub; });
  s += tgDashLine_('منتشرشده', pub) + '\n';
  s += tgDashTaskLine_(chat, uname, roles) + '\n';
  s += tgDashBoxLine_(chat, true) + '\n';
  tgSend_(chat, s, tgDashKb_([[{ text: '✍️ کارتابل مجله', callback_data: 'db:mag' }]]));
}

/* ---------- درمانگر: سبک و ساده ---------- */
function tgDashTher_(chat, name, uname, roles) {
  var s = tgDashHead_('داشبورد شما', name);
  var slots = null, sess = null;
  try { slots = tgTherSlotCount_(chat); } catch (e) {}
  try { sess = tgTherSessCount_(chat); } catch (e) {}
  s += tgDashLine_('وقت‌های معارفهٔ باز', slots) + '\n';
  s += tgDashLine_('وقت‌های هفتگی درمان', sess) + '\n';
  s += tgDashTaskLine_(chat, uname, roles) + '\n';
  s += tgDashBoxLine_(chat, false) + '\n';
  s += '\n<i>برای ویرایش وقت‌ها دکمهٔ زیر را بزنید؛ همان فهرست همیشگی است.</i>';
  tgSend_(chat, s, tgDashKb_([
    [{ text: '🗓 وقت‌های من', callback_data: 'db:slots' }],
    [{ text: '🪪 صفحهٔ من در سایت', callback_data: 'db:site' }]
  ]));
}

/* شمارنده‌های درمانگر: اگر ساختار عوض شد، داشبورد نمی‌شکند */
function tgTherSlotCount_(chat) {
  var ss = tgSS_();
  var t = tgWhoTherapist_(chat);
  if (!t) return null;
  var sh = ss.getSheetByName('وقت‌های معارفه') || ss.getSheetByName('اسلات‌ها');
  if (!sh) return null;
  var n = sh.getLastRow();
  if (n < 2) return 0;
  var vals = sh.getRange(2, 1, n - 1, Math.min(6, sh.getLastColumn())).getValues();
  var c = 0, nm = String(t.name || t);
  for (var i = 0; i < vals.length; i++) {
    for (var j = 0; j < vals[i].length; j++) if (String(vals[i][j]) === nm) { c++; break; }
  }
  return c;
}

function tgTherSessCount_(chat) {
  var ss = tgSS_();
  var t = tgWhoTherapist_(chat);
  if (!t) return null;
  var sh = ss.getSheetByName(TG_SESS || 'وقت‌های درمان');
  if (!sh) return null;
  var n = sh.getLastRow();
  if (n < 2) return 0;
  var vals = sh.getRange(2, 1, n - 1, Math.min(6, sh.getLastColumn())).getValues();
  var c = 0, nm = String(t.name || t);
  for (var i = 0; i < vals.length; i++) {
    for (var j = 0; j < vals[i].length; j++) if (String(vals[i][j]) === nm) { c++; break; }
  }
  return c;
}

/* ---------- مالک: نبض کل مجموعه ---------- */
function tgDashOwner_(chat, name, uname, roles) {
  var s = '📊 <b>نبض تجربه</b>\n<i>' + tgEsc_(tgTskNow_()) + '</i>\n\n';
  var ss = tgSS_(), sch = tgSchSS_(), cs = tgCSS_();

  s += '<b>آدم‌ها</b>\n';
  s += tgDashLine_('کاربران بات', tgDashN_(ss, TG_USERS_TAB, 0, null)) + '\n';
  var today = tgTskToday_();
  s += tgDashLine_('فعال امروز', tgDashN_(ss, TG_USERS_TAB, 5, function (x) { return String(x).indexOf(today) === 0; })) + '\n';

  s += '\n<b>کلینیک</b>\n';
  var nOpen2 = 0; try { nOpen2 = tgOpenLeads_().length; } catch (eO2) { nOpen2 = tgDashN_(ss, 'لیدها', 0, null); }
  s += tgDashLine_('لیدهای باز پذیرش', nOpen2) + '\n';
  s += tgDashLine_('پروفایل سایت', tgDashN_(ss, TG_PQ_TAB, 0, null)) + '\n';

  s += '\n<b>مدرسه</b>\n';
  s += tgDashLine_('لیدهای مدرسه', tgDashN_(sch, TG_SCH_T_REQ, 0, null)) + '\n';
  s += tgDashLine_('دانش‌آموختگان', tgDashN_(sch, 'دانش‌آموختگان', 0, null)) + '\n';
  s += tgDashLine_('اپلای تراپیست', tgDashN_(sch, 'اپلای تراپیست', 0, null)) + '\n';

  s += '\n<b>مجله</b>\n';
  s += tgDashLine_('موضوع در استخر', tgDashN_(cs, TG_MAG_TOPICS_TAB, 0, null)) + '\n';
  s += tgDashLine_('منتظر تأیید سردبیر', tgDashN_(cs, TG_MAG_TAB, 8, function (x) { return x === TG_MAG_ST.wait; })) + '\n';
  s += tgDashLine_('منتشرشده', tgDashN_(cs, TG_MAG_TAB, 8, function (x) { return x === TG_MAG_ST.pub; })) + '\n';

  s += '\n<b>کارها و پیام‌ها</b>\n';
  var all = tgTskRows_();
  var open = 0, late = 0;
  for (var i = 0; i < all.length; i++) {
    var st = String(all[i][9] || '');
    if (st === TG_TSK_ST.closed) continue;
    if (st === TG_TSK_ST.drop) continue;
    if (st === TG_TSK_ST.done) continue;
    open++;
    var due = String(all[i][8] || '');
    if (due) { if (due < today) late++; }
  }
  s += tgDashLine_('کار باز در کل تیم', open, late ? '(' + tgFa_(late) + ' از مهلت گذشته)' : '') + '\n';
  s += tgDashBoxLine_(chat, true) + '\n';

  tgSend_(chat, s, tgDashKb_([
    [{ text: '➕ کار تازه', callback_data: 'db:new' }, { text: '✉️ پیام تازه', callback_data: 'db:msg' }],
    [{ text: '📈 آمار روزانه', callback_data: 'db:stat' }]
  ]));
}

function tgTskToday_() {
  return Utilities.formatDate(new Date(), 'Asia/Tehran', 'yyyy-MM-dd');
}

/* آمار روزانه از هاب آمار — سری زمانی، نه عدد لحظه‌ای */
function tgDashStat_(chat) {
  try {
    var sh = tgStatSS_().getSheetByName(TG_STAT_TAB);
    if (!sh) { tgSend_(chat, 'تب آمار روزانه هنوز پر نشده.'); return; }
    var n = sh.getLastRow();
    if (n < 2) { tgSend_(chat, 'هنوز هیچ روزی ثبت نشده. نوشتن شبانه که روشن شود، از فردا پر می‌شود.'); return; }
    var w = Math.min(7, n - 1);
    var head = sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0];
    var rows = sh.getRange(n - w + 1, 1, w, sh.getLastColumn()).getValues();
    var s = '📈 <b>' + tgFa_(w) + ' روز گذشته</b>\n';
    for (var i = rows.length - 1; i >= 0; i--) {
      var bits = [];
      for (var j = 1; j < Math.min(6, head.length); j++) bits.push(String(head[j]) + ' ' + tgFa_(rows[i][j] || 0));
      s += '\n<b>' + tgEsc_(String(rows[i][0])) + '</b> · ' + tgEsc_(bits.join(' · '));
    }
    tgSend_(chat, s);
  } catch (e) {
    tgSend_(chat, 'آمار روزانه خوانده نشد: ' + tgEsc_(String(e)));
  }
}
/* ============ v101 · مسیر دکمه‌ها و گفت‌وگوهای چندمرحله‌ای ============ */

var TG_DASH_BTN = '🏠 داشبورد من';

/* یافتن آدم از روی یوزرنیم یا نام، از تب «کاربران بات» */
function tgV1User_(q) {
  var s = String(q || '').trim().replace(/^@/, '').toLowerCase();
  if (!s) return null;
  try {
    var sh = tgSS_().getSheetByName(TG_USERS_TAB);
    if (!sh) return null;
    var n = sh.getLastRow();
    if (n < 2) return null;
    var vals = sh.getRange(2, 1, n - 1, 3).getValues();
    for (var i = 0; i < vals.length; i++) {
      if (String(vals[i][2] || '').replace(/^@/, '').toLowerCase() === s) return { chat: vals[i][0], name: vals[i][1], uname: vals[i][2] };
    }
    for (var j = 0; j < vals.length; j++) {
      if (String(vals[j][1] || '').trim() === String(q).trim()) return { chat: vals[j][0], name: vals[j][1], uname: vals[j][2] };
    }
  } catch (e) {}
  return null;
}

/* کیست و چه نقشی دارد — یک بار، برای همهٔ مسیرهای این ماژول */
function tgV1Roles_(chat, uname) {
  var list = [];
  try { var r = tgRolesOf_(chat, uname); if (r) list = (r.roles || []).slice(); } catch (e) {}
  try { var my = tgMyRoles_(chat, uname) || []; for (var i = 0; i < my.length; i++) if (list.indexOf(my[i]) < 0) list.push(my[i]); } catch (e2) {}
  return list;
}

function tgV1IsTeam_(roles) {
  var team = ['پذیرش', 'مدرسه', 'سردبیر', 'مالی', 'ناظر', 'سوپروایزر', 'استاد'];
  for (var i = 0; i < team.length; i++) if (roles.indexOf(team[i]) > -1) return true;
  return false;
}

function tgV1IsBoss_(chat, roles) {
  if (roles.indexOf('ناظر') > -1) return true;
  try { if (tgWhoWatch_(chat, '')) return true; } catch (e) {}
  try { if (tgSjIsOwner_(chat)) return true; } catch (e2) {}
  return false;
}

/* داشبورد درست برای همین آدم */
function tgV1Dash_(chat, name, uname) {
  var roles = tgV1Roles_(chat, uname);
  if (tgV1IsBoss_(chat, roles)) { tgDashOwner_(chat, name, uname, roles); return; }
  if (roles.indexOf('مدرسه') > -1) { tgDashSch_(chat, name, uname, roles); return; }
  if (roles.indexOf('سردبیر') > -1) { tgDashMag_(chat, name, uname, roles); return; }
  if (roles.indexOf('پذیرش') > -1) { tgDashDesk_(chat, name, uname, roles); return; }
  if (roles.indexOf('درمانگر') > -1) { tgDashTher_(chat, name, uname, roles); return; }
  var s = tgDashHead_('خانهٔ شما', name);
  s += tgDashTaskLine_(chat, uname, roles) + '\n';
  s += tgDashBoxLine_(chat, false) + '\n';
  tgSend_(chat, s, tgDashKb_([]));
}

/* ---------- ساختن کار تازه ---------- */
/* v166.8: «کار تازه» و «پیام تازه» فقط برای تیم (پیش از این هر مراجعی با تایپ متن دکمه می‌توانست کاربران بات را
   جست‌وجو کند و به نام مرکز پیام بفرستد). همان مجموعه‌ای که صندوق تیمی را می‌بیند، به‌علاوهٔ ناظر و مالک. */
function tgV1CanCreate_(chat, uname) {
  var roles = tgV1Roles_(chat, uname || '');
  return tgV1IsTeam_(roles) || tgV1IsBoss_(chat, roles);
}

function tgV1NewTask_(chat) {
  if (!tgV1CanCreate_(chat, '')) return false;
  tgSetVal_('tsk', chat, JSON.stringify({ step: 'team' }));
  var rows = [];
  for (var i = 0; i < TG_TSK_TEAMS.length; i += 2) {
    var r = [{ text: TG_TSK_TEAMS[i], callback_data: 'tk:team:' + TG_TSK_TEAMS[i] }];
    if (TG_TSK_TEAMS[i + 1]) r.push({ text: TG_TSK_TEAMS[i + 1], callback_data: 'tk:team:' + TG_TSK_TEAMS[i + 1] });
    rows.push(r);
  }
  tgSend_(chat, '➕ <b>کار تازه</b>\nاین کار با کدام تیم است؟', { inline_keyboard: rows });
  return true;
}

function tgV1NewMsg_(chat) {
  if (!tgV1CanCreate_(chat, '')) return false;
  tgSetVal_('box', chat, JSON.stringify({ step: 'who' }));
  tgSend_(chat, '✉️ <b>پیام تازه</b>\nیوزرنیم یا نام دقیق طرف را بنویسید (مثل <code>@' + tgNm_('school_user') + '</code>).');
  return true;
}

/* حالت‌های نیمه‌کاره‌ی کارها */
function tgV1TskState_(chat, name, text) {
  var raw = tgGetVal_('tsk', chat);
  if (!raw) return false;
  var st;
  try { st = JSON.parse(raw); } catch (e) { tgSetVal_('tsk', chat, ''); return false; }
  if (!st || !st.step) return false;

  if (st.step === 'note') {
    var t = tgTskGet_(st.code);
    tgSetVal_('tsk', chat, '');
    if (!t) { tgSend_(chat, 'این کار دیگر نیست.'); return true; }
    tgTskSet_(st.code, 11, String(text).slice(0, 1000));
    if (String(t.st) === TG_TSK_ST.open) tgTskSet_(st.code, 10, TG_TSK_ST.doing);
    tgSend_(chat, '📝 نوشتید و ثبت شد. ممنون.');
    tgTskTell_(t, name + ' دربارهٔ «' + String(t.title) + '» نوشت: ' + String(text).slice(0, 300));
    return true;
  }

  if (st.step === 'who') {
    st.whoRaw = String(text).trim();
    var u = tgV1User_(st.whoRaw);
    st.chat = u ? u.chat : '';
    st.who = u ? u.name : st.whoRaw;
    st.uname = u ? u.uname : String(st.whoRaw).replace(/^@/, '');
    st.step = 'title';
    tgSetVal_('tsk', chat, JSON.stringify(st));
    tgSend_(chat, (u ? '✅ ' + tgEsc_(String(u.name)) + ' پیدا شد.\n' : '🔎 هنوز در بات نیست؛ کار به نامش ثبت می‌شود و هر وقت پیوست می‌بیندش.\n') +
      '\nحالا خودِ کار را بنویسید. خط اول عنوان، خط‌های بعدی توضیح.');
    return true;
  }

  if (st.step === 'title') {
    var lines = String(text).split('\n');
    st.title = lines.shift();
    st.body = lines.join('\n');
    st.step = 'pri';
    tgSetVal_('tsk', chat, JSON.stringify(st));
    tgSend_(chat, 'چقدر عجله دارد؟', { inline_keyboard: [
      [{ text: '🔴 فوری', callback_data: 'tk:pri:فوری' }],
      [{ text: '🟠 تا آخر این هفته', callback_data: 'tk:pri:وقت‌دار' }],
      [{ text: '⚪️ بی‌مهلت', callback_data: 'tk:pri:عادی' }]
    ] });
    return true;
  }
  return false;
}

/* حالت‌های نیمه‌کاره‌ی صندوق پیام */
function tgV1BoxState_(chat, name, uname, text) {
  var raw = tgGetVal_('box', chat);
  if (!raw) return false;
  var st;
  try { st = JSON.parse(raw); } catch (e) { tgSetVal_('box', chat, ''); return false; }
  if (!st || !st.step) return false;

  if (st.step === 'reply') {
    tgSetVal_('box', chat, '');
    var roles = tgV1Roles_(chat, uname);
    tgBoxReply_(chat, st.thread, String(text), name, roles.join(' · '));
    tgSend_(chat, '✅ رسید. جواب‌تان را به ما رساندم.');
    return true;
  }

  if (st.step === 'us') {
    tgSetVal_('box', chat, '');
    var list = tgBoxThread_(st.thread);
    if (!list.length) { tgSend_(chat, 'این رشته پیدا نشد.'); return true; }
    tgBoxSend_(list[0].chat, String(text), { thread: st.thread, name: list[0].name, role: list[0].role, owner: String(chat) });
    tgSend_(chat, '✅ فرستاده شد.');
    return true;
  }

  if (st.step === 'who') {
    var u = tgV1User_(text);
    if (!u) {
      tgSend_(chat, 'کسی با این نشانی در بات پیدا نشد. یوزرنیم را با @ بنویسید، یا نام را دقیق همان‌طور که در بات ثبت شده.');
      return true;
    }
    st.step = 'text'; st.to = u.chat; st.name = u.name; st.role = '';
    tgSetVal_('box', chat, JSON.stringify(st));
    tgSend_(chat, '✅ ' + tgEsc_(String(u.name)) + '.\nحالا متن پیام را بنویسید.');
    return true;
  }

  if (st.step === 'text') {
    tgSetVal_('box', chat, '');
    var r = tgBoxSend_(st.to, String(text), { name: st.name, owner: String(chat) });
    tgSend_(chat, '✅ فرستاده شد. رشته: <code>' + tgEsc_(r.thread) + '</code>\nهر پاسخی بدهد، همین‌جا می‌آید.');
    return true;
  }
  return false;
}

/* ---------- کال‌بک‌های تازه ---------- */
function tgV1Cb_(chat, data, name, uname) {
  var d = String(data || '');

  if (d.indexOf('tk:team:') === 0) {
    var raw = tgGetVal_('tsk', chat);
    var st = {};
    try { st = JSON.parse(raw || '{}'); } catch (e) { st = {}; }
    st.team = d.slice(8); st.step = 'who';
    tgSetVal_('tsk', chat, JSON.stringify(st));
    tgSend_(chat, 'تیم ' + tgEsc_(st.team) + '.\nاین کار با چه کسی است؟ یوزرنیم یا نامش را بنویسید. اگر با کل تیم است، بنویسید <code>تیم</code>.');
    return true;
  }

  if (d.indexOf('tk:pri:') === 0) {
    var raw2 = tgGetVal_('tsk', chat);
    var s2 = {};
    try { s2 = JSON.parse(raw2 || '{}'); } catch (e2) { s2 = {}; }
    if (!s2.title) { tgSend_(chat, 'این گفت‌وگو نیمه‌کاره ماند. دوباره «کار تازه» را بزنید.'); tgSetVal_('tsk', chat, ''); return true; }
    var pri = d.slice(7);
    var due = '';
    if (pri === 'وقت‌دار') due = tgV1Plus_(7);
    if (pri === 'فوری') due = tgV1Plus_(2);
    var team = s2.team || '';
    var whole = String(s2.whoRaw || '') === 'تیم';
    var code = tgTskAdd_({
      title: s2.title, body: s2.body, team: team,
      who: whole ? '' : s2.who, uname: whole ? '' : s2.uname, chat: whole ? '' : s2.chat,
      pri: pri, due: due, by: name + ' (' + chat + ')',
      trace: team === 'مدرسه' ? 'هاب مدرسه' : ''
    });
    tgSetVal_('tsk', chat, '');
    tgSend_(chat, '✅ ثبت شد: <code>' + tgEsc_(code) + '</code>\n' + tgEsc_(String(s2.title)) +
      (due ? '\nمهلت: ' + tgEsc_(due) : ''));
    if (!whole && s2.chat) {
      var t = tgTskGet_(code);
      try { tgSend_(s2.chat, '📋 <b>کار تازه‌ای برای شماست</b>\n\n' + tgTskCard_(t), tgTskKb_(t)); } catch (e3) {}
      tgSend_(chat, '📨 به ایشان هم خبر دادم.');
    }
    return true;
  }

  if (d.indexOf('tk:') === 0) return tgTskCb_(chat, d, name);
  if (d.indexOf('bx:') === 0) return tgBoxCb_(chat, d, name, '');

  if (d.indexOf('db:') === 0) {
    var a = d.slice(3);
    var roles = tgV1Roles_(chat, uname);
    if (a === 'me') { tgV1Dash_(chat, name, uname); return true; }
    if (a === 'task') { tgTskList_(chat, uname, roles); return true; }
    if (a === 'box') { tgBoxList_(chat, tgV1IsTeam_(roles)); return true; }
    if (a === 'new') { tgV1NewTask_(chat); return true; }
    if (a === 'msg') { tgV1NewMsg_(chat); return true; }
    if (a === 'stat') { tgDashStat_(chat); return true; }
    if (a === 'desk') { try { tgPrivate_({ chat: { id: chat }, from: { id: chat }, text: '📥 درخواست‌های تازه' }); } catch (e) {} return true; }
    if (a === 'sch') { try { tgPrivate_({ chat: { id: chat }, from: { id: chat }, text: TG_SL_BTN }); } catch (e) {} return true; }
    if (a === 'mag') { try { tgPrivate_({ chat: { id: chat }, from: { id: chat }, text: TG_MAG_DESK_BTNS[0] }); } catch (e) {} return true; }
    if (a === 'slots') { try { tgPrivate_({ chat: { id: chat }, from: { id: chat }, text: TG_SV_MY }); } catch (e) {} return true; }
    if (a === 'site') { try { tgPrivate_({ chat: { id: chat }, from: { id: chat }, text: TG_PQ_BTN }); } catch (e) {} return true; }
    return true;
  }
  return false;
}

function tgV1Plus_(days) {
  var d = new Date();
  d.setDate(d.getDate() + days);
  return Utilities.formatDate(d, 'Asia/Tehran', 'yyyy-MM-dd');
}

/* ---------- تنها نقطهٔ اتصال به tgPrivate_ ---------- */
function tgV1Route_(chat, name, uname, text) {
  var t = String(text || '');
  if (tgV1TskState_(chat, name, t)) return true;
  if (tgV1BoxState_(chat, name, uname, t)) return true;

  if (t === TG_DASH_BTN) { tgV1Dash_(chat, name, uname); return true; }
  if (t === TG_TSK_BTN) { tgTskList_(chat, uname, tgV1Roles_(chat, uname)); return true; }
  if (t === TG_TSK_NEW) return tgV1NewTask_(chat);   /* برای غیرتیم false: مثل هر متن دیگری ادامه پیدا می‌کند */
  if (t === TG_BOX_BTN) { tgBoxList_(chat, tgV1IsTeam_(tgV1Roles_(chat, uname))); return true; }
  if (t === TG_BOX_NEW) return tgV1NewMsg_(chat);
  if (t === '/dash') { tgV1Dash_(chat, name, uname); return true; }
  if (t === '/tasks') { tgTskList_(chat, uname, tgV1Roles_(chat, uname)); return true; }
  if (t === '/inbox') { tgBoxList_(chat, tgV1IsTeam_(tgV1Roles_(chat, uname))); return true; }
  return false;
}

/* ردیف تازه‌ای که به منوی هر نقش تیمی اضافه می‌شود */
function tgV1MenuRow_(isBoss) {
  if (isBoss) return [[TG_DASH_BTN, TG_TSK_BTN], [TG_BOX_BTN, TG_TSK_NEW]];
  return [[TG_DASH_BTN, TG_TSK_BTN], [TG_BOX_BTN]];
}
/* ============ v101 · اندپوینت‌های مینی‌اپ، برپاسازی و تست ============ */


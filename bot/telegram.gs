/* فرستادن: پیش‌فرض فقط پیش‌نمایش؛ با send=true برای مسئول (از تیم پذیرش) می‌رود و در دفتر ثبت می‌شود */
function tgInpCheckSend(pid, toName, send) {
  pid = pid || 'gandhi'; toName = toName || tgNm_('reception');
  var text = tgInpCheckText_(pid);
  var to = null;
  (TG_DRY ? (TG_MEM['desk'] || []) : tgDeskRows_()).forEach(function (r) { if (!to && r.chat && String(r.name).indexOf(toName) > -1) to = r; });
  if (!send) { Logger.log((to ? 'گیرنده: ' + to.name : '❌ گیرنده پیدا نشد') + '\n\n' + text); return { to: to ? to.name : '', text: text }; }
  if (!to) throw new Error('گیرنده در تیم پذیرش پیدا نشد: ' + toName);
  var row = 0;
  if (TG_DRY) row = 2; else {
    var sh = tgInpLogSheet_(); sh.appendRow([tgInpNow_(), pid, to.name, 'فرستاده شد، منتظر پاسخ', text, '', '']); row = sh.getLastRow();
  }
  tgInpMarkRows_(pid, '', 'در انتظار تأیید');
  tgSetVal_('inpchk', to.chat, pid + '|' + row);
  tgSend_(to.chat, tgEsc_(text), tgInpCheckKb_(pid, row));
  return { to: to.name, row: row };
}
function tgInpChkState_(chat) { var s = String(tgGetVal_('inpchk', chat) || ''); if (!s) return null; var a = s.split('|'); return { pid: a[0], row: Number(a[1]) || 0 }; }
function tgInpChkWatch_(text) { try { (TG_DRY ? (TG_MEM['watch'] || []) : tgWatchIds_()).forEach(function (id) { tgSend_(id, text); }); } catch (e) {} }
/* هر پیام متنی مسئول تا وقتی بررسی باز است، پاسخ همان بررسی است */

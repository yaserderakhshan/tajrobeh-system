function tgAudit() {
  const ss = tgSS_();
  const tabs = ss.getSheets().map(function (s) { return s.getName() + ' (' + s.getLastRow() + '×' + s.getLastColumn() + ')'; });
  const sh = ss.getSheetByName(TG_THER);
  const last = sh.getLastRow();
  const cols = { 'C جنسیت': 3, 'D حالت جلسه': 4, 'E مکتب اصلی': 5, 'M ردهٔ ارجاع': 13, 'B وضعیت همکاری': 2, 'T استخر': 20 };
  const out = ['تب‌ها:\n' + tabs.join('\n')];
  for (var key in cols) {
    const v2 = sh.getRange(4, cols[key], last - 3, 1).getValues();
    const map = {};
    for (var i = 0; i < v2.length; i++) {
      const s = String(v2[i][0]).trim() || '(خالی)';
      map[s] = (map[s] || 0) + 1;
    }
    const arr = Object.keys(map).map(function (k) { return [k, map[k]]; }).sort(function (a, b) { return b[1] - a[1]; });
    out.push('\n--- ' + key + ' (' + arr.length + ' مقدار یکتا) ---\n' +
      arr.slice(0, 25).map(function (x) { return x[1] + '  ' + x[0]; }).join('\n'));
  }
  Logger.log(out.join('\n'));
}


function tgDateAudit() {
  const ss = tgSS_();
  const out = [];
  const sheets = ss.getSheets();
  for (var s = 0; s < sheets.length; s++) {
    const sh = sheets[s];
    const nm = sh.getName();
    const lr = Math.min(sh.getLastRow(), 6);
    const lc = sh.getLastColumn();
    if (lr < 1 || lc < 1) continue;
    const vals = sh.getRange(1, 1, lr, lc).getValues();
    const hits = [];
    for (var r = 0; r < vals.length; r++) {
      for (var c = 0; c < lc; c++) {
        const x = String(vals[r][c]);
        if (/تاریخ|زمان|روز|ساعت/.test(x) && x.length < 30) hits.push('r' + (r + 1) + 'c' + (c + 1) + ':' + x.trim());
      }
    }
    // فرمول‌هایی که به تب‌های دیگر ارجاع می‌دهند
    let refs = 0, sample = '';
    try {
      const f = sh.getRange(1, 1, Math.min(sh.getLastRow(), 60), lc).getFormulas();
      for (var i = 0; i < f.length; i++) for (var j = 0; j < f[i].length; j++) {
        if (f[i][j]) {
          refs++;
          if (!sample && /Sheet1|اسلات|وقت|تاریخ/.test(f[i][j])) sample = f[i][j].slice(0, 90);
        }
      }
    } catch (e) {}
    out.push('■ ' + nm + '  (فرمول در ۶۰ سطر اول: ' + refs + ')\n   ' + hits.slice(0, 12).join(' | ') + (sample ? '\n   نمونه فرمول: ' + sample : ''));
  }
  Logger.log(out.join('\n'));
}


function tgJalDebug() {
  const sh = tgSS_().getSheetByName('لیدها');
  const vals = sh.getRange(2, 1, Math.min(4, sh.getLastRow() - 1), 1).getValues();

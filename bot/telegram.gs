  var sh = tgSchSheet_(TG_SCH_T_REQ, TG_SCH_REQ_HEAD);
  var olds = sh.getProtections(SpreadsheetApp.ProtectionType.RANGE);
  for (var i = 0; i < olds.length; i++) if (/^بات می‌نویسد/.test(olds[i].getDescription() || '')) { try { olds[i].remove(); } catch (e) {} }
  var n = Math.max(sh.getMaxRows() - 1, 1);
  for (var j = 0; j < TG_SCH_PROTECT_COLS.length; j++) {
    var p = sh.getRange(1, TG_SCH_PROTECT_COLS[j], n + 1, 1).protect();
    p.setDescription('بات می‌نویسد: ' + TG_SCH_REQ_HEAD[TG_SCH_PROTECT_COLS[j] - 1]);
    p.setWarningOnly(true);
  }
  return TG_SCH_PROTECT_COLS.length + ' ستون با هشدار';
}

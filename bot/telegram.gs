  // «🪪 نقش دیگری دارم»: نام تنها دیگر نقش نمی‌دهد
  TG_MEM = { desk: [{ chat: '7001', role: 'مسئول پذیرش', user: 'desk_sample', name: 'پذیرش نمونه' }] };
  var pl0 = [];
  try { pl0 = tgPeopleList_(); } catch (e) {}
  var pfree = pl0.filter(function (x) { return !x.chat && String(x.status).trim() !== 'غیرفعال' && tgNorm_(x.name).length >= 5; })[0];

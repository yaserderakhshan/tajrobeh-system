var TG_AL_ST_WAIT = 'نیازمند تأیید';
var TG_AL_ST_OK   = 'دانش‌آموخته';

var T_AL_INTRO = '🎓 <b>باشگاه دانش‌آموختگان مدرسهٔ تجربه</b>\n\n' +
  'چند سؤال کوتاه می‌پرسم و تمام. بعد مسئول مدرسه آن را می‌بیند و تأیید می‌کند.';
var T_AL_WELCOME = '🎉 <b>به باشگاه دانش‌آموختگان تجربه خوش آمدید</b>\n\n' +
  'عضویت شما ثبت و تأیید شد.\n' +
  'حضور در برنامه‌های عمومی مدرسه، نشست‌ها و رویدادهای باز برای دانش‌آموختگان رایگان است. ' +
  'خبر هر برنامه را همین‌جا برایتان می‌فرستیم.';

function tgAlGet_(chat) {
  var raw = tgGetVal_('alw', chat);
  if (!raw) return null;
  try { return JSON.parse(raw); } catch (e) { return null; }
}
function tgAlPut_(chat, d) { tgSetVal_('alw', chat, JSON.stringify(d)); }
function tgAlEnd_(chat) { tgDel_('alw', chat); }

function tgAlStart_(chat, uname) {
  tgAlPut_(chat, { step: 'course', user: uname || '' });
  var cs = tgSchCourses_(), kb = [];
  for (var i = 0; i < cs.length; i++) {
    if (cs[i].code === 'COMM' || cs[i].code === 'ASSOC') continue;
    kb.push([{ text: cs[i].name, callback_data: 'al:c:' + cs[i].code }]);
  }
  kb.push([{ text: '↩️ بی‌خیال', callback_data: 'al:x' }]);
  tgSend_(chat, T_AL_INTRO);
  return tgSend_(chat, 'کدام دوره را گذرانده‌اید؟', { inline_keyboard: kb });
}

function tgAlAskCircle_(chat, d) {
  d.step = 'circle';
  tgAlPut_(chat, d);
  var rs = tgSchCircles_(), kb = [], n = 0;
  for (var i = 0; i < rs.length && n < 14; i++) {
    if (d.ccourse && rs[i].course && rs[i].course !== d.ccourse) continue;
    kb.push([{ text: rs[i].name + ' · ' + rs[i].code, callback_data: 'al:l:' + rs[i].code }]);
    n++;
  }
  kb.push([{ text: 'نمی‌دانم', callback_data: 'al:l:-' }]);
  return tgSend_(chat, 'کدام حلقه؟', { inline_keyboard: kb });
}

var TG_AL_Q = [
  { k: 'year',     t: 'سال پایان دوره را بنویسید، مثل ۱۴۰۳.' },
  { k: 'hours',    t: 'چند ساعت آموزش و سوپرویژن گذرانده‌اید؟ اگر دقیق نمی‌دانید عدد تقریبی بنویسید یا «⏭ رد کردن» را بزنید.' },
  { k: 'city',     t: 'در چه شهری کار می‌کنید؟' },
  { k: 'approach', t: 'رویکردتان را بنویسید.' },
  { k: 'photo',    t: 'اگر دوست دارید عکس پروفایلتان را بفرستید. اگر الان ندارید «⏭ رد کردن» را بزنید.' },
  { k: 'consent',  t: 'اجازه می‌دهید نامتان در فهرست دانش‌آموختگان سایت منتشر شود؟ بنویسید «بله» یا «فعلاً نه».' }
];

function tgAlAsk_(chat, d) {
  var i = d.qi || 0;
  if (i >= TG_AL_Q.length) return tgAlSave_(chat, d);
  d.step = 'q';
  tgAlPut_(chat, d);
  var kb = { keyboard: [[TG_SJ_SKIP], [TG_SJ_BACK]], resize_keyboard: true };
  return tgSend_(chat, TG_AL_Q[i].t, kb);
}

function tgAlSave_(chat, d) {
  var id = TG_DRY ? 'D-001' : tgSchNextId_(TG_SCH_T_ALUM, TG_SCH_ALUM_HEAD, 'D');
  var vals = [id, d.name || '', '', '', d.user || '', String(chat), d.course || '', d.circle || '',
              d.ccode || '', d.year || '', d.hours || '', TG_AL_ST_WAIT, '', '', d.city || '',
              d.approach || '', '', d.photo || '', d.consent || '', 'نساخته', '', '',
              'در انتظار تأیید', '', '', ''];
  if (TG_DRY) {
    (TG_MEM['alum'] = TG_MEM['alum'] || []).push(vals);
    TG_OUTBOX.push({ kind: 'alum', id: id, status: TG_AL_ST_WAIT });
  } else {
    tgSchAlumSheet_().appendRow(vals);
    tgSchDropCache_();
  }
  tgAlEnd_(chat);
  tgSend_(chat, '✅ ثبت شد. وضعیت شما فعلاً «' + TG_AL_ST_WAIT + '» است.\n' +
                'به‌محض تأیید مسئول مدرسه همین‌جا خبرتان می‌کنیم.');
  tgAlNotify_(id, d, chat);
  return true;
}

function tgAlCard_(id, d) {
  return '🎓 <b>درخواست عضویت باشگاه دانش‌آموختگان</b> · ' + tgEsc_(id) + '\n\n' +
    '<b>' + tgEsc_(d.name || '') + '</b>' + (d.user ? ' ' + tgEsc_(d.user) : '') + '\n' +
    (d.course ? 'دوره: ' + tgEsc_(d.course) + (d.circle ? ' · ' + tgEsc_(d.circle) : '') + '\n' : '') +
    (d.year ? 'سال پایان: ' + tgEsc_(d.year) + '\n' : '') +
    (d.hours ? 'ساعت گذرانده: ' + tgEsc_(d.hours) + '\n' : '') +
    (d.city ? 'شهر: ' + tgEsc_(d.city) + '\n' : '') +
    (d.approach ? 'رویکرد: ' + tgEsc_(d.approach) + '\n' : '') +
    (d.consent ? 'اجازهٔ انتشار: ' + tgEsc_(d.consent) + '\n' : '') +
    '\nدر تب «دانش‌آموختگان» هاب مدرسه ثبت شد.';
}

function tgAlKb_(id) {
  return { inline_keyboard: [
    [{ text: '✅ تأیید دانش‌آموختگی', callback_data: 'al:ok:' + id }],
    [{ text: '⏳ ناتمام', callback_data: 'al:half:' + id }, { text: '❌ رد', callback_data: 'al:no:' + id }]
  ] };
}

function tgAlNotify_(id, d, chat) {
  try {
    var own = TG_DRY ? (TG_MEM['schowners'] || []) : tgSchoolOwners_();
    for (var i = 0; i < own.length; i++) tgSend_(own[i].chat, tgAlCard_(id, d), tgAlKb_(id));
    if (!own.length) tgErr_('tgAlNotify_: هیچ مسئول مدرسه‌ای chat_id ندارد');
  } catch (e) { tgErr_('tgAlNotify_: ' + e); }
}

function tgAlRow_(id) {
  if (TG_DRY) return TG_MEM['alumrow'] || null;
  var sh = tgSchAlumSheet_();
  if (!sh || sh.getLastRow() < 2) return null;
  var v = sh.getRange(2, 1, sh.getLastRow() - 1, TG_SCH_ALUM_HEAD.length).getValues();
  for (var i = 0; i < v.length; i++) {
    if (String(v[i][0]).trim() === String(id).trim()) {
      return { sh: sh, row: i + 2, id: String(v[i][0]).trim(), name: String(v[i][1]).trim(),
               chat: String(v[i][5]).trim(), status: String(v[i][11]).trim() };
    }
  }
  return null;
}

function tgAlDecide_(chat, id, what, who) {
  var r = tgAlRow_(id);
  if (!r) return tgSend_(chat, 'این درخواست پیدا نشد.');
  var now = tgJDateFull_(new Date(), TG_TZ);
  var me = who && who.name ? who.name : 'مدرسه';
  if (what === 'ok') {
    if (!TG_DRY) {
      r.sh.getRange(r.row, 12).setValue(TG_AL_ST_OK);
      r.sh.getRange(r.row, 23).setValue('بله');
      r.sh.getRange(r.row, 24).setValue('تأیید ' + me);
      r.sh.getRange(r.row, 25).setValue(now);
      tgSchDropCache_();
    } else {
      TG_OUTBOX.push({ kind: 'alok', id: id, by: me });
    }
    if (r.chat) tgSend_(r.chat, T_AL_WELCOME);
    return tgSend_(chat, '✅ تأیید شد: ' + tgEsc_(r.name));
  }
  if (what === 'half') {
    if (!TG_DRY) { r.sh.getRange(r.row, 12).setValue('ناتمام'); tgSchDropCache_(); }
    return tgSend_(chat, '⏳ «ناتمام» ثبت شد: ' + tgEsc_(r.name));
  }
  if (what === 'no') {
    if (!TG_DRY) { r.sh.getRange(r.row, 12).setValue('در حال تحصیل'); tgSchDropCache_(); }
    return tgSend_(chat, '❌ ثبت شد: ' + tgEsc_(r.name));
  }
  return null;
}

function tgOnAl_(cq, rest) {
  var chat = cq.message.chat.id;
  var uname = cq.from && cq.from.username ? '@' + cq.from.username : '';
  var p = String(rest || '').split(':');
  var act = p[0] || '';
  var arg = p.slice(1).join(':');

  if (act === 'x') { tgAlEnd_(chat); return tgSend_(chat, 'باشد، بی‌خیال شدیم.'); }
  if (act === 'c') {
    var d = tgAlGet_(chat) || {};
    var c = tgSchCourseByCode_(arg);
    d.course = c ? c.name : '';
    d.ccourse = d.course;
    return tgAlAskCircle_(chat, d);
  }
  if (act === 'l') {
    var d2 = tgAlGet_(chat);
    if (!d2) return tgAlStart_(chat, uname);
    if (arg !== '-') {
      var rs = tgSchCircles_();
      for (var i = 0; i < rs.length; i++) if (rs[i].code === arg) { d2.circle = rs[i].name; d2.ccode = rs[i].code; }
    }
    d2.name = d2.name || [cq.from.first_name, cq.from.last_name].filter(String).join(' ');
    d2.user = d2.user || uname;
    d2.qi = 0;
    return tgAlAsk_(chat, d2);
  }
  if (act === 'ok' || act === 'no' || act === 'half') {
    var who = tgSchOwnerOf_(chat, uname);
    if (!who) return tgSend_(chat, 'این دکمه برای مسئول مدرسه است.');
    return tgAlDecide_(chat, arg, act, who);
  }
  return null;
}

/* متن و عکس ویزارد دانش‌آموختگان */
function tgAlStep_(chat, m) {
  var d = tgAlGet_(chat);
  if (!d || d.step !== 'q') return false;
  var i = d.qi || 0;
  var q = TG_AL_Q[i];
  if (!q) { tgAlEnd_(chat); return false; }
  var text = String((m && m.text) || '').trim();

  if (q.k === 'photo' && m && m.photo && m.photo.length) {
    d.photo = 'tg:photo:' + m.photo[m.photo.length - 1].file_id;
    d.qi = i + 1;
    return tgAlAsk_(chat, d) || true;
  }
  if (!text) return false;
  if (text === TG_SJ_BACK || text === 'انصراف') { tgAlEnd_(chat); tgSend_(chat, 'باشد، بی‌خیال شدیم.'); return true; }
  if (text.indexOf('/') === 0) { tgAlEnd_(chat); return false; }
  if (text !== TG_SJ_SKIP) d[q.k] = text;
  d.qi = i + 1;
  tgAlAsk_(chat, d);
  return true;
}


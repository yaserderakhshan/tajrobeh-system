];

var T_PN_INTRO =
  '🏢 <b>پارتنر تجربه</b>\n\n' +
  'خوشحالیم که می‌خواهید مکانتان بخشی از تجربه باشد.\n' +
  'چند پرسش کوتاه می‌پرسم، بعد اتاق‌ها و ساعت‌هایتان را می‌گیرم. ' +
  'وقتی تمام شد، صفحهٔ پارتنر شما در سایت آماده می‌شود و مراجع می‌تواند مستقیم از بات برای مکان شما وقت حضوری بگیرد.\n\n' +
  'هر جا خواستید رد کنید «⏭ رد کردن» را بزنید.';

var T_PN_ROOM =
  '🚪 اتاق‌ها را یکی‌یکی بگیریم.\n\n' +
  'برای هر اتاق یک خط بنویسید، با ویرگول جدا کنید:\n' +
  '<b>نام اتاق، برای چه کسی، روزهای باز، از ساعت، تا ساعت</b>\n\n' +
  'مثال:\n<code>اتاق ۱، بزرگسال، همه روزها، ۹، ۲۱</code>\n\n' +
  '«برای چه کسی» یکی از این‌هاست: بزرگسال، کودک، هر دو.';

function tgPnGet_(chat) {
  try { return JSON.parse(tgGetVal_('pnw', chat) || 'null'); } catch (e) { return null; }
}
function tgPnPut_(chat, d) { tgSetVal_('pnw', chat, JSON.stringify(d)); }
function tgPnEnd_(chat) { tgDel_('pnw', chat); }

function tgInpAllPlaces_() {
  if (TG_DRY) return (TG_MEM['inp'] && TG_MEM['inp'].places) || [];
  var sh = tgSS_().getSheetByName(TG_INP_PLACES), out = [];
  if (!sh || sh.getLastRow() < 2) return out;
  var v = sh.getRange(2, 1, sh.getLastRow() - 1, TG_INP_PHEAD.length).getDisplayValues();
  for (var i = 0; i < v.length; i++) {
    if (!String(v[i][0]).trim()) continue;
    out.push({ row: i + 2, id: String(v[i][0]).trim(), city: String(v[i][1]).trim(),
               name: String(v[i][2]).trim(), kind: String(v[i][3]).trim(),
               owner: String(v[i][4]).trim(), area: String(v[i][5]).trim(),
               status: String(v[i][6]).trim() });
  }
  return out;
}

function tgPnSlug_(city, title) {
  var base = TG_PN_CITY[String(city || '').trim()] || '';
  if (!base) base = String(title || '').replace(/[^a-zA-Z0-9]/g, '').toLowerCase().slice(0, 10);
  if (!base) base = 'p';
  var taken = {};
  try {
    var ps = tgInpAllPlaces_();
    for (var i = 0; i < ps.length; i++) taken[ps[i].id] = 1;
  } catch (e) {}
  if (!taken[base]) return base;
  for (var n = 2; n < 40; n++) if (!taken[base + n]) return base + n;
  return base + String(Date.now()).slice(-4);
}

function tgPnStart_(chat, uname) {
  try { if (typeof ptIntroPdf_ === 'function') ptIntroPdf_(chat, true); } catch (ePdf) {}
  tgPnPut_(chat, { qi: 0, v: {}, rooms: [], stage: 'q', user: uname || '' });
  tgSend_(chat, T_PN_INTRO);
  return tgPnAsk_(chat, tgPnGet_(chat));
}

function tgPnAsk_(chat, d) {
  var i = d.qi || 0;
  if (i >= TG_PN_Q.length) {
    d.stage = 'room';
    tgPnPut_(chat, d);
    return tgSend_(chat, T_PN_ROOM);
  }
  tgPnPut_(chat, d);
  return tgSend_(chat, TG_PN_Q[i].t, { keyboard: [[TG_SJ_SKIP], [TG_SJ_BACK]], resize_keyboard: true });
}

function tgPnRoomParse_(text) {
  var parts = String(text).split(/[،,]/).map(function (x) { return String(x).trim(); }).filter(String);
  if (parts.length < 3) return null;
  var kind = parts[1] || 'بزرگسال';
  if (kind.indexOf('کودک') > -1 && kind.indexOf('بزرگ') > -1) kind = 'هر دو';
  else if (kind.indexOf('کودک') > -1) kind = 'کودک';
  else if (kind.indexOf('هر') > -1) kind = 'هر دو';
  else kind = 'بزرگسال';
  return {
    room: parts[0], kind: kind, days: parts[2] || 'همه روزها',
    from: tgLatinDigits_(parts[3] || '9'), to: tgLatinDigits_(parts[4] || '21')
  };
}

function tgPnRoomKb_() {
  return { inline_keyboard: [
    [{ text: '➕ اتاق دیگر', callback_data: 'pn:more' }],
    [{ text: '✅ همین بود، تمام', callback_data: 'pn:fin' }]
  ] };
}

function tgPnStep_(chat, m) {
  var d = tgPnGet_(chat);
  if (!d) return false;
  var text = String((m && m.text) || '').trim();
  if (!text) return false;
  if (text === TG_SJ_BACK || text === 'انصراف') { tgPnEnd_(chat); tgSend_(chat, 'باشد، بی‌خیال شدیم.'); return true; }
  if (text.indexOf('/') === 0) { tgPnEnd_(chat); return false; }

  if (d.stage === 'room') {
    var rm = tgPnRoomParse_(text);
    if (!rm) {
      tgSend_(chat, 'این خط را نفهمیدم. دست‌کم سه بخش لازم است: نام اتاق، برای چه کسی، روزهای باز.\n' +
                    'مثال: <code>اتاق ۱، بزرگسال، همه روزها، ۹، ۲۱</code>');
      return true;
    }
    d.rooms = d.rooms || [];
    d.rooms.push(rm);
    tgPnPut_(chat, d);
    tgSend_(chat, '✅ ثبت شد: <b>' + tgEsc_(rm.room) + '</b> · ' + tgEsc_(rm.kind) + ' · ' +
                  tgEsc_(rm.days) + ' · ' + tgEsc_(rm.from) + ' تا ' + tgEsc_(rm.to) +
                  '\n\nاتاق دیگری هم دارید؟', tgPnRoomKb_());
    return true;
  }

  var i = d.qi || 0, q = TG_PN_Q[i];
  if (!q) { tgPnEnd_(chat); return false; }
  if (q.k === 'phone' && text !== TG_SJ_SKIP && !tgLooksLikePhone_(text)) {
    tgSend_(chat, 'این شماره درست به نظر نمی‌رسد. یک بار دیگر بنویسید.');
    return true;
  }
  if (text !== TG_SJ_SKIP) d.v[q.k] = text;
  d.qi = i + 1;
  tgPnAsk_(chat, d);
  return true;
}

function tgPnSave_(chat, d) {
  var v = d.v || {};
  var id = tgPnSlug_(v.city, v.title);
  var ord = 50;
  if (TG_DRY) {
    TG_OUTBOX.push({ kind: 'partner', id: id, title: v.title, rooms: (d.rooms || []).length });
    return id;
  }
  try { ord = tgInpAllPlaces_().length + 1; } catch (e) {}
  var ss = tgSS_();
  var ps = ss.getSheetByName(TG_INP_PLACES);
  if (ps) {
    ps.appendRow([id, v.city || '', v.title || '', 'پارتنر', v.owner || '', v.area || '',
                  'بررسی', ord, 'از لینک ساخت پارتنر · ' + tgJDateFull_(new Date(), TG_TZ)]);
  }
  var rs = ss.getSheetByName(TG_INP_ROOMS);
  if (!rs) {
    rs = ss.insertSheet(TG_INP_ROOMS);
    try { rs.setRightToLeft(true); } catch (e2) {}
    rs.getRange(1, 1, 1, TG_INP_RHEAD.length).setValues([TG_INP_RHEAD]).setFontWeight('bold');
    rs.setFrozenRows(1);
  }
  var rooms = d.rooms || [];
  for (var i = 0; i < rooms.length; i++) {
    rs.appendRow([id, rooms[i].room, rooms[i].kind, rooms[i].days, rooms[i].from, rooms[i].to,
                  'بررسی', 'از لینک ساخت پارتنر']);
  }
  var pn = ss.getSheetByName(TG_PN_TAB);
  if (!pn) {
    pn = ss.insertSheet(TG_PN_TAB);
    try { pn.setRightToLeft(true); } catch (e3) {}
    pn.getRange(1, 1, 1, TG_PN_HEAD.length).setValues([TG_PN_HEAD])
      .setFontWeight('bold').setBackground('#f3efec');
    pn.setFrozenRows(1);
  }
  pn.appendRow([id, v.title || '', v.city || '', v.area || '', v.about || '', v.phone || '',
                v.owner || '', String(chat), v.hours || '', 'در انتظار تأیید',
                tgJDateFull_(new Date(), TG_TZ), '', '']);
  try { CacheService.getScriptCache().remove('inpdata'); } catch (e4) {}
  return id;
}

function tgPnFinish_(chat) {
  var d = tgPnGet_(chat);
  if (!d) return tgSend_(chat, 'چیزی برای ثبت پیدا نکردم.');
  if (!(d.v && d.v.title)) return tgSend_(chat, 'اسم مرکز را نگرفتیم. دوباره از اول شروع کنید.');
  var id = tgPnSave_(chat, d);
  tgPnEnd_(chat);
  try {
    var p = tgWhoPerson_(chat, d.user || '');
    if (p) { p.chatNew = String(chat); tgSchGrantRole_(p, 'پارتنر', ''); }
  } catch (e) {}
  var v = d.v, n = (d.rooms || []).length;
  tgSend_(chat,
    '🎉 <b>ثبت شد. ممنون.</b>\n\n' +
    '<b>' + tgEsc_(v.title || '') + '</b> · ' + tgEsc_(v.city || '') + '\n' +
    n + ' اتاق ثبت شد.\n\n' +
    'حالا ناظر تجربه یک نگاه می‌اندازد و تأیید می‌کند. بعد از تأیید:\n' +
    '• صفحهٔ پارتنر شما در سایت منتشر می‌شود\n' +
    '• مکان شما در بات به مراجع‌ها نشان داده می‌شود\n' +
    '• درمانگرهای هم‌شهری‌تان می‌توانند برای حضوری در مکان شما اعلام آمادگی کنند\n\n' +
    'هر وقت اتاق تازه‌ای اضافه شد، همین لینک را دوباره باز کنید.');
  try {
    var ids = TG_DRY ? (TG_MEM['watchids'] || []) : tgWatchIds_();
    var body = '🏢 <b>پارتنر تازه ثبت شد</b> · <code>' + tgEsc_(id) + '</code>\n\n' +
      '<b>' + tgEsc_(v.title || '') + '</b>\n' +
      'شهر: ' + tgEsc_(v.city || '') + '\n' +
      (v.area ? 'نشانی: ' + tgEsc_(v.area) + '\n' : '') +
      'مسئول: ' + tgEsc_(v.owner || '') + (v.phone ? ' · ' + tgEsc_(v.phone) : '') + '\n' +
      'ساعت کاری: ' + tgEsc_(v.hours || '—') + '\n' +
      'اتاق‌ها: ' + n + '\n\n' +
      (v.about ? '<i>' + tgEsc_(String(v.about).slice(0, 300)) + '</i>\n\n' : '') +

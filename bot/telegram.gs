function tgTeaCodes() {
  if (TG_DRY) return 'dry';
  var sh = tgSchSheet_(TG_SCH_T_TEA, TG_SCH_TEA_HEAD);
  if (!sh) return 'تب استادان پیدا نشد.';
  var list = tgTeaRows_(), seen = {}, n = 0;
  for (var i = 0; i < list.length; i++) if (list[i].code) seen[list[i].code] = 1;
  for (var j = 0; j < list.length; j++) {
    if (list[j].code && list[j].link) continue;
    var code = list[j].code || tgTeaNewCode_(seen);
    seen[code] = 1;
    sh.getRange(list[j].row, 27).setValue(code);
    sh.getRange(list[j].row, 25).setValue(tgTeaLink_(code));
    n++;
  }
  tgSchDropCache_();
  return n + ' لینک دعوت ساخته یا کامل شد.';
}

function tgTeaByCode_(code) {
  var c = String(code || '').trim().toLowerCase();
  if (!c) return null;
  if (TG_DRY) return TG_DRY_TEA;
  var list = tgTeaRows_();
  for (var i = 0; i < list.length; i++) if (String(list[i].code).toLowerCase() === c) return list[i];

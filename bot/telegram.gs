const TG_ANN_CATS = ['روال کاری', 'مالی', 'مدرسه و آموزش', 'ارجاع و ظرفیت', 'فنی و بات', 'یادآوری', 'رویداد', 'فوری'];
const TG_ANN_AUD = ['همهٔ درمانگران', 'استادان', 'دانشجویان', 'سوپروایزرها', 'تیم پذیرش', 'همه'];
const TG_ANN_EXTRA = ['مخاطب', 'پیوست PDF', 'جایگزین اطلاعیهٔ', 'کد استناد'];

function tgAnnCode_(n) {
  let s = String(n);
  while (s.length < 3) s = '0' + s;
  return 'TJ-ANN-' + s;
}

function tgAnnUpgrade() {
  const sh = tgAnnSheet_();
  const width = TG_ANN_HEAD.length + TG_ANN_EXTRA.length;
  if (sh.getMaxColumns() < width) sh.insertColumnsAfter(sh.getMaxColumns(), width - sh.getMaxColumns());
  sh.getRange(1, 3).setValue('دسته');
  sh.getRange(1, TG_ANN_HEAD.length + 1, 1, TG_ANN_EXTRA.length).setValues([TG_ANN_EXTRA])
    .setFontWeight('bold').setBackground('#f3efec');
  sh.getRange(2, 3, 300, 1).setDataValidation(
    SpreadsheetApp.newDataValidation().requireValueInList(TG_ANN_CATS, true).build());
  sh.getRange(2, 11, 300, 1).setDataValidation(
    SpreadsheetApp.newDataValidation().requireValueInList(TG_ANN_AUD, true).build());
  sh.setColumnWidth(11, 150); sh.setColumnWidth(12, 220); sh.setColumnWidth(13, 130); sh.setColumnWidth(14, 130);
  const rows = tgAnnRows_();
  for (var i = 0; i < rows.length; i++) {
    if (!String(sh.getRange(rows[i].row, 14).getValue()).trim()) {
      sh.getRange(rows[i].row, 14).setValue(tgAnnCode_(rows[i].num));
    }
    if (!String(sh.getRange(rows[i].row, 11).getValue()).trim()) {
      sh.getRange(rows[i].row, 11).setValue(TG_ANN_AUD[0]);
    }
  }
  return 'ایندکس اطلاعیه‌ها آماده شد: ' + width + ' ستون، ' + rows.length + ' اطلاعیه.';
}

function tgAnnExtra_(row) {
  const sh = tgAnnSheet_();
  const v = sh.getRange(row, 11, 1, 4).getValues()[0];
  return { aud: String(v[0]).trim(), pdf: String(v[1]).trim(), supersedes: String(v[2]).trim(), code: String(v[3]).trim() };
}

function tgAnnIndex() {
  const rows = tgAnnRows_();
  if (!rows.length) return 'هنوز اطلاعیه‌ای ثبت نشده.';
  const out = ['ایندکس اطلاعیه‌ها'];
  for (var i = 0; i < rows.length; i++) {
    const a = rows[i], x = tgAnnExtra_(a.row);
    out.push([x.code || tgAnnCode_(a.num), a.date, a.kind, x.aud, a.title, a.status,
      x.pdf ? 'پیوست دارد' : '', x.supersedes ? 'جایگزین ' + x.supersedes : ''].filter(Boolean).join(' · '));
  }
  return out.join('\n');
}


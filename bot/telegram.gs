  if (unknown.length) qs.push('ساعت ردیف' + (unknown.length > 1 ? '‌های ' : ' ') + unknown.join('، ') + ' که «ساعت در جدول نیست» خورده؟');
  var rooms = (d.rooms || []).filter(function (r) { return r.p === pid; });
  if (rooms.length) qs.push('اتاق‌ها ' + rooms.map(function (r) { return tgFa_(tgInpRoomKey_(r.room)) + (r.kind && r.kind !== 'بزرگسال' ? ' (' + r.kind + ')' : ''); }).join('، ') + ' است؟ اتاق دیگری هم هست؟');
  qs.push('اگر کسی از این فهرست الان مراجع حضوری تازه نمی‌پذیرد، کنار شماره‌اش یک × بگذارید.');
  var where = p ? (p.id === 'gandhi' ? 'گاندی' : p.city) : pid;
  return 'سلام، وقت بخیر 🌱\nبه درخواست یاسر، برنامهٔ حضوری ' + where + ' را در هاب تجربه ثبت کرده‌ایم تا بات به مراجعی که حضوری می‌خواهد درمانگر و روز و ساعت درست را نشان دهد. این چک یک بار برای همیشه است و بعد همین الگو برای پارتنرهای دیگر هم به کار می‌رود.\n\n' +
    'لطفاً فهرست زیر را نگاه کنید و فقط موارد اشتباه را همین‌جا بنویسید (شمارهٔ ردیف و شکل درستش). اگر همه درست است، «همه درست است» را بزنید.\n\n' +
    lines.join('\n') + '\n\nچند سؤال کوتاه هم داریم:\n' + qs.map(function (q, i) { return L[i] + ') ' + q; }).join('\n') + '\n\nممنون از وقتی که می‌گذارید 🙏';

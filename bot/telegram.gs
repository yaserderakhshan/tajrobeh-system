    by[n].push(live[i]);
  }
  var pub = tgThPubMap_();
  var soonMs = Date.now() + 48 * 3600000;
  var cands = order.map(function (n) {
    var t = pub[tgNorm_(n)] || { n: n, d: tgPrDisplay_(n), tr: 2.5 };
    var first = tgSlotUtc_(by[n][0]).getTime();
    var sc2 = tgMatchScore_(t, { topic: tk, want: want, abroad: sc.abroad, style: style, soon: first < soonMs });
    return { t: t, s: sc2.s, why: sc2.why, first: first, slots: by[n].slice(0, 3).map(function (x) { return tgApiSlotOut_(x, sc.zone); }) };
  });
  var softened = false;
  if (want) {

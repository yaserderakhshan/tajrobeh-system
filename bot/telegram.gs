/* آینهٔ مراحل جذب در هاب پذیرش (هر دور tgWatchdog) */
function tgApMirror_() {
  if (TG_DRY) return 0;
  var src = tgSchApSheet_(); if (!src || src.getLastRow() < 2) return 0;
  var W = Math.min(src.getMaxColumns(), TG_SCH_APPLY_HEAD.length);
  var v = src.getRange(2, 1, src.getLastRow() - 1, W).getValues();
  var g = function (r, n) { var k = TG_SCH_APPLY_HEAD.indexOf(n); if (k < 0 || k >= r.length) return ''; var x = r[k]; return x instanceof Date ? Utilities.formatDate(x, TG_TZ, 'yyyy-MM-dd') : String(x == null ? '' : x).trim(); };
  var rows = [];
  for (var i = 0; i < v.length; i++) {
    var id = String(v[i][0] || '').trim(); if (!id) continue;
    var stage = g(v[i], 'مرحله') || TG_AP_STAGES[0], ord = TG_AP_STAGES.indexOf(stage);
    var user = g(v[i], 'یوزرنیم تلگرام').replace(/^@/, ''), chat = g(v[i], 'chat_id');
    var cv = g(v[i], 'لینک رزومه'); if (!cv) { var m = g(v[i], 'رزومه').match(/https?:\/\/\S+/); cv = m ? m[0] : ''; }
    rows.push({ ord: ord < 0 ? 0 : ord, closed: stage === 'بسته' ? 1 : 0, stage: stage, tg: user ? 'https://t.me/' + user : '', cv: cv,
      vals: [id, g(v[i], 'نام کامل'), g(v[i], 'تاریخ'), stage, g(v[i], 'اقدام بعدی'), g(v[i], 'تاریخ اقدام بعدی'), g(v[i], 'مسئول پذیرش'),
             tgApPhone_(g(v[i], 'شمارهٔ تماس')), g(v[i], 'ایمیل'), user ? '@' + user : (chat ? 'فقط در بات' : ''), cv ? 'باز کردن رزومه' : (g(v[i], 'رزومه') ? 'فایل در بات' : ''),
             g(v[i], 'شهر'), g(v[i], 'رویکرد'), g(v[i], 'سال‌های کار'), g(v[i], 'سوپروایزر مصاحبهٔ دوم'), g(v[i], 'زمان مصاحبهٔ دوم'), g(v[i], 'نتیجهٔ نهایی'), g(v[i], 'یادداشت')] });
  }
  rows.sort(function (a, b) { return (a.closed - b.closed) || (a.ord - b.ord); });
  var ss = tgSS_(), sh = ss.getSheetByName(TG_APM_TAB);
  if (!sh) { sh = ss.insertSheet(TG_APM_TAB); sh.setRightToLeft(true); }
  var H = TG_APM_HEAD.length;
  if (sh.getMaxColumns() < H + 2) sh.insertColumnsAfter(sh.getMaxColumns(), H + 2 - sh.getMaxColumns());
  sh.getRange(1, 1, 1, H).setValues([TG_APM_HEAD]).setFontWeight('bold').setBackground('#f3efec');
  sh.setFrozenRows(1);
  sh.getRange(1, H + 2).setValue('مرحله، اقدام بعدی، تاریخ اقدام بعدی، مسئول پذیرش، نتیجهٔ نهایی و یادداشت را همین‌جا عوض کنید؛ به پروندهٔ اصلی در هاب مدرسه برمی‌گردد. بقیهٔ ستون‌ها خودکارند و هر ساعت تازه می‌شوند.');
  var n = sh.getLastRow(); if (n > 1) { var old = sh.getRange(2, 1, n - 1, H); old.clearContent(); old.setBackground(null); }
  if (!rows.length) return 0;
  var rng = sh.getRange(2, 1, rows.length, H);
  rng.setNumberFormat('@').setValues(rows.map(function (r) { return r.vals; }));
  rng.setBackgrounds(rows.map(function (r) { var c = TG_APM_COLORS[r.stage] || null; var a = []; for (var k = 0; k < H; k++) a.push(c); return a; }));
  var rich = function (col, fn) {
    sh.getRange(2, col, rows.length, 1).setRichTextValues(rows.map(function (r) { var t = String(r.vals[col - 1] || ''), u = fn(r); var b = SpreadsheetApp.newRichTextValue().setText(t); if (u && t) b.setLinkUrl(u); return [b.build()]; }));
  };
  try { rich(10, function (r) { return r.tg; }); rich(11, function (r) { return r.cv; }); } catch (eR) {}
  try {
    var more = rows.length + 60;
    if (sh.getMaxRows() < more + 1) sh.insertRowsAfter(sh.getMaxRows(), more + 1 - sh.getMaxRows());
    sh.getRange(2, 4, more, 1).setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(TG_AP_STAGES, true).setAllowInvalid(true).build());
    sh.getRange(2, 17, more, 1).setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(TG_AP_RESULTS, true).setAllowInvalid(true).build());
    var names = []; try { tgDeskRows_().forEach(function (d) { if (d.name && names.indexOf(d.name) < 0) names.push(d.name); }); } catch (eD) {}
    if (names.length) sh.getRange(2, 7, more, 1).setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(names, true).setAllowInvalid(true).build());
    sh.getRange(2, 5, more, 1).setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(['تماس اول', 'تماس دوباره', 'فرستادن به سوپروایزر', 'پیگیری نتیجهٔ مصاحبه', 'آنبوردینگ'], true).setAllowInvalid(true).build());
  } catch (eV) { tgErr_('tgApMirror_ validation: ' + eV); }
  return rows.length;
}
/* v162: ویرایش مسئول پذیرش در تب «جذب تراپیست» به پروندهٔ اصلی (هاب مدرسه) برمی‌گردد */
function tgApmEdited_(e) {
  var sh = e.range.getSheet(), r0 = e.range.getRow(), n = e.range.getNumRows(), c1 = e.range.getColumn(), c2 = c1 + e.range.getNumColumns() - 1;
  if (r0 < 2 || n > 20) return;
  var head = sh.getRange(1, 1, 1, TG_APM_HEAD.length).getValues()[0].map(function (x) { return String(x).trim(); });
  var any = false; for (var c0 = c1; c0 <= c2; c0++) if (TG_APM_EDIT[head[c0 - 1]]) any = true;
  if (!any) return;
  try { var s0 = tgSchApSheet_(); if (s0 && s0.getMaxColumns() < TG_SCH_APPLY_HEAD.length) tgSchHeadFix_(TG_SCH_T_APPLY, TG_SCH_APPLY_HEAD); } catch (eF) {}
  for (var r = r0; r < r0 + n; r++) {

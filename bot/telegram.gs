function tgSeoSetup_() {
  var ss = tgCSS_();
  var out = [];

  /* ۱) ستون‌های سئو کنار ستون‌های موجود */
  var sh = ss.getSheetByName(TG_MAG_TOPICS_TAB);
  if (!sh) return '❌ تب «' + TG_MAG_TOPICS_TAB + '» پیدا نشد';
  var head = sh.getRange(1, 1, 1, Math.max(sh.getLastColumn(), 8)).getValues()[0];
  var base = 8;
  var need = false;
  for (var i = 0; i < TG_SEO_COLS.length; i++) {
    if (String(head[base + i] || '') !== TG_SEO_COLS[i]) need = true;
  }
  if (need) {
    sh.getRange(1, base + 1, 1, TG_SEO_COLS.length).setValues([TG_SEO_COLS]);
    sh.getRange(1, 1, 1, base + TG_SEO_COLS.length).setFontWeight('bold');
    sh.setFrozenRows(1);
    out.push('✅ ' + TG_SEO_COLS.length + ' ستون سئو به «' + TG_MAG_TOPICS_TAB + '» اضافه شد');
  } else {
    out.push('· ستون‌های سئو از قبل بودند');
  }

  /* ۲) پر کردن استخر — فقط موضوع‌هایی که هنوز نیستند */
  var have = {};
  var n = sh.getLastRow();
  if (n > 1) {
    var codes = sh.getRange(2, 1, n - 1, 1).getValues();
    for (var c = 0; c < codes.length; c++) have[String(codes[c][0] || '')] = 1;
  }
  var add = [];
  for (var j = 0; j < TG_SEO_POOL.length; j++) {
    var t = TG_SEO_POOL[j];
    if (have[t[0]]) continue;
    add.push([
      t[0], t[1], t[2], t[3],
      TG_MAG_TOPIC_OPEN, '', '', '',
      t[4], t[5], t[6], t[7], t[8], t[9], t[10], t[11]
    ]);
  }
  if (add.length) {
    sh.getRange(sh.getLastRow() + 1, 1, add.length, 16).setValues(add);
    out.push('✅ ' + add.length + ' موضوع تازه با بریف سئو به استخر اضافه شد');
  } else {
    out.push('· استخر از قبل پر بود');
  }

  /* ۳) تب الزامات سئو */
  var rs = ss.getSheetByName(TG_SEO_TAB);
  if (!rs) rs = ss.insertSheet(TG_SEO_TAB);
  rs.clear();
  rs.getRange(1, 1, 1, 3).setValues([['#', 'قاعده', 'یعنی چه']]);
  rs.getRange(2, 1, TG_SEO_RULES.length, 3).setValues(TG_SEO_RULES);

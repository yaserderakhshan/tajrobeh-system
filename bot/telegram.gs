  if (!sh) {
    sh = ss.insertSheet(TG_BUG_TAB);
    sh.setRightToLeft(true);
    sh.getRange(1, 1, 1, TG_BUG_HEAD.length).setValues([TG_BUG_HEAD])
      .setFontWeight('bold').setBackground('#f3efec');
    sh.setFrozenRows(1);
    sh.setColumnWidth(1, 80); sh.setColumnWidth(3, 120);
    sh.setColumnWidth(6, 430); sh.setColumnWidth(8, 320);

    ok('لینک شیت و اسناد ساختمان برای غیرعضو نمی‌رود', TG_OUTBOX.length === 1 && String(TG_OUTBOX[0].text).indexOf('تأیید عضویت') > -1);
    TG_OUTBOX = []; TG_MEM = { roles: ['مراجع'] };
    ok('پیام همگانی با کال‌بک ساختگی نمی‌رود', tgBcCb_(null, 'go', stranger, 'x', '') === null && TG_OUTBOX.length === 0);
    TG_OUTBOX = [];
    ok('«پیام تازه» برای مراجع نیست', tgV1Route_(stranger, 'x', '', TG_BOX_NEW) === false && TG_OUTBOX.length === 0);
  } catch (e) { ok('بدون خطا: ' + e, false); }
  TG_DRY = keep.dry; TG_MEM = keep.mem; TG_OUTBOX = keep.box; TG_BC_ON = keep.bc;
  return { pass: pass, fail: fail, text: out.filter(function (l) { return l.indexOf('❌') === 0; }).join('\n') };
}

/* مجموعه‌هایی که سطرهای ✓/✗ در log می‌نویسند (گروه، ثبت‌نام خودسرویس). fail شمارندهٔ خود مجموعه است. */
function tgTestTally_(log, fail) {
  var pass = 0, bad = [], seen = 0;
  for (var i = 0; i < log.length; i++) {
    var l = String(log[i]);
    if (/^(✓|✅)/.test(l)) pass++;
    else if (/^(✗|❌)/.test(l)) { seen++; bad.push(l); }
  }
  return { pass: pass, fail: Math.max(Number(fail) || 0, seen), text: bad.join('\n').slice(0, 1500) };
}

/* v166.8: مجموعه‌ای که هیچ چیزی نسنجید (۰ قبول و ۰ مردود) مردود حساب می‌شود؛ پیش از این «سبز» دیده می‌شد. */
function tgTestNorm_(r) {
  var n = tgTestNorm0_(r);
  if (!n.pass && !n.fail) return { pass: 0, fail: 1, text: n.text || 'این مجموعه هیچ چیزی نسنجید (۰ قبول و ۰ مردود)' };
  return n;
}
function tgTestNorm0_(r) {
  if (r && typeof r === 'object' && typeof r.pass === 'number') {
    return { pass: r.pass || 0, fail: r.fail || 0, text: String(r.text || '').slice(0, 1500) };
  }
  var s = String(r === null || r === undefined ? '' : r);
  var lines = s.split('\n');
  var pass = 0, fail = 0, bad = [];
  for (var i = 0; i < lines.length; i++) {
    var l = lines[i];
    if (l.indexOf('❌') > -1 || l.indexOf('✗') > -1 || l.indexOf('BAD ') === 0 || l.indexOf('مردود') === 0) { fail++; bad.push(l); }
    else if (l.indexOf('✅') > -1 || l.indexOf('✓') > -1 || l.indexOf('OK ') === 0) pass++;
  }
  if (!pass && !fail) {
    var mm = s.match(/\((\d+)\s*از\s*(\d+)\)/);
    if (mm) { pass = Number(mm[1]); fail = Number(mm[2]) - Number(mm[1]); if (fail > 0) bad.push(s.slice(-800)); }
  }
  if (!pass && !fail) {
    var m2 = s.match(/(\d+)\s*قبول\s*·\s*(\d+)\s*مردود/);
    if (m2) { pass = Number(m2[1]); fail = Number(m2[2]); if (fail > 0) bad.push(s.slice(-800)); }
  }
  if (!pass && !fail && s.replace(/\s/g, '') === '') bad.push('این مجموعه عدد برنمی‌گرداند و فقط در لاگ می‌نویسد');
  return { pass: pass, fail: fail, text: bad.join('\n').slice(0, 1500) };
}

function tgTestSheet_() {
  var ss = tgSS_();
  var sh = ss.getSheetByName(TG_TEST_TAB);
  if (!sh) {
    sh = ss.insertSheet(TG_TEST_TAB);
    try { sh.setRightToLeft(true); } catch (e) {}
    try { sh.hideSheet(); } catch (e) {}
  }
  if (String(sh.getRange(1, 1).getValue()).trim() !== 'زمان') {
    sh.getRange(1, 1, 1, 7).setValues([['زمان', 'دور', 'مجموعه', 'قبول', 'مردود', 'ثانیه', 'جزئیات مردودها']]);
    try { sh.setFrozenRows(1); } catch (e) {}
  }
  return sh;
}

/* v166.7: شیت شناسهٔ دور («09-30 16:17») را تاریخ می‌کند و مقایسهٔ رشته‌ای شکست می‌خورد (دام بخش ۱۵ اسکیل).
   از این نسخه دور با ' به‌صورت متن نوشته می‌شود؛ این تابع سطرهای قدیمی تاریخ‌شده را هم به همان شکل برمی‌گرداند. */
function tgTestRunKey_(v, tz) {
  if (Object.prototype.toString.call(v) === '[object Date]') return Utilities.formatDate(v, tz || TG_TZ, 'MM-dd HH:mm');
  return String(v === null || v === undefined ? '' : v).replace(/^'/, '').trim();
}

function tgTestSheetTz_(sh) {
  try { return sh.getParent().getSpreadsheetTimeZone() || TG_TZ; } catch (e) { return TG_TZ; }
}

function tgTestCall_(name) {
  var g = (typeof globalThis !== 'undefined') ? globalThis : this;
  var f = g[name];
  if (typeof f !== 'function') return { pass: 0, fail: 1, text: 'تابع ' + name + ' وجود ندارد' };
  /* v166.29.1: هر مجموعه زیر TG_IN_TEST اجرا می‌شود؛ نوشتن واقعی لید، تغییر لید یا پیام واقعی تلگرام در این حالت
     جلویش گرفته می‌شود و مجموعه مردود. (۸ مهر ۱۴۰۵ ساعت ۱۳:۱۲ یک اجرای کامل تست هم‌زمان با سه سطر بی‌نام L-1267 تا L-1269 بود.) */
  TG_IN_TEST = true; TG_TEST_LEAKS = [];
  var r;
  try { r = tgTestNorm_(f()); }
  finally { TG_IN_TEST = false; }
  if (TG_TEST_LEAKS.length) {
    r.fail = (r.fail || 0) + 1;
    r.text = '❌ نشت به دادهٔ واقعی: ' + TG_TEST_LEAKS.slice(0, 5).join('، ') + (r.text ? '\n' + r.text : '');
  }
  TG_TEST_LEAKS = [];
  return r;
}
/* true یعنی «ننویس»: در حال اجرای تست و بیرون از حالت خشک. نام کار برای گزارش مجموعه نگه داشته می‌شود. */
function tgTestLeak_(what) {
  if (!TG_IN_TEST || TG_DRY) return false;
  if (TG_TEST_LEAKS.length < 20) TG_TEST_LEAKS.push(String(what || ''));
  return true;
}

function tgTrigTune() {
  var want = { tgPayTick: 5, tgMeetTick: 15, tgWatchdog: 0 };
  var ts = ScriptApp.getProjectTriggers(), out = [];
  for (var i = 0; i < ts.length; i++) {
    var fn = ts[i].getHandlerFunction();
    if (want[fn] === undefined || !want[fn]) continue;
    if (ts[i].getEventType() !== ScriptApp.EventType.CLOCK) continue;
    ScriptApp.deleteTrigger(ts[i]);
    ScriptApp.newTrigger(fn).timeBased().everyMinutes(want[fn]).create();
    out.push(fn + ' -> هر ' + want[fn] + ' دقیقه');
  }
  var now = ScriptApp.getProjectTriggers().map(function (t) { return t.getHandlerFunction(); });
  Logger.log('تنظیم شد: ' + (out.join(' · ') || 'چیزی عوض نشد') + '\nتریگرهای فعلی: ' + now.join(', '));
  return out.join(' · ');
}

function tgRunReset() {
  var p = PropertiesService.getScriptProperties();
  p.deleteProperty('TG_TEST_AT');
  p.deleteProperty('TG_TEST_RUN');
  p.deleteProperty('TG_TEST_CHAIN');
  p.deleteProperty('TG_TEST_BEAT');
  p.deleteProperty('CI_TEST_KILLED');
  return 'شمارنده صفر شد. حالا tgRun را بزنید.';
}

function tgRun() {
  if (typeof ciScope_ === 'function') ciScope_();   /* v170.16.2: دور محدود انتشار روز */
  var p = PropertiesService.getScriptProperties();
  var at = Number(p.getProperty('TG_TEST_AT') || 0);
  var runId = p.getProperty('TG_TEST_RUN') || '';
  var chain = Number(p.getProperty('TG_TEST_CHAIN') || 0);
  if (!runId || p.getProperty('TG_TEST_AT') === null || at >= TG_SUITES.length) {   /* v166.7: TG_TEST_AT='0' از ci.gs یعنی ادامهٔ همین دور */
    runId = Utilities.formatDate(new Date(), TG_TZ, 'MM-dd HH:mm');
    at = 0; chain = 0;
    p.setProperty('TG_TEST_RUN', runId);
    tgTestCleanup_();
  }

  /* v166.7: نتیجهٔ هر مجموعه بلافاصله نوشته می‌شود و TG_TEST_AT بعد از هر مجموعه جلو می‌رود؛ اگر Apps Script اجرا را
     سر سقف ۶ دقیقه بکشد، فقط همان یک مجموعه گم می‌شود. TG_TEST_BEAT مجموعهٔ در حال اجرا را نگه می‌دارد (ci.gs از آن
     می‌فهمد کدام مجموعه قطع شد). */
  var t0 = Date.now(), done = 0, sh = null;
  try { sh = tgTestSheet_(); } catch (e) { Logger.log('تب تست‌ها باز نشد: ' + e); }
  while (at < TG_SUITES.length && Date.now() - t0 < TG_TEST_BUDGET_MS) {
    var nm = TG_SUITES[at][0], fnName = TG_SUITES[at][1], s0 = Date.now(), r;
    p.setProperty('TG_TEST_BEAT', JSON.stringify({ run: runId, at: at, name: nm, t: s0, t0: t0 }));
    try { r = tgTestCall_(fnName); } catch (e) { r = { pass: 0, fail: 1, text: 'خطا: ' + e }; }
    /* v166.29.1: خطای گذرای سرویس گوگل (نه مردودی واقعی) فقط یک بار همان مجموعه را دوباره اجرا می‌کند */
    if (r.fail && tgTestTransient_(r.text)) {
      var r2; try { r2 = tgTestCall_(fnName); } catch (e2) { r2 = { pass: 0, fail: 1, text: 'خطا: ' + e2 }; }
      r2.text = '↻ تکرار بعد از خطای گذرای گوگل' + (r2.text ? '\n' + r2.text : '');
      r = r2;
    }
    var secs = Math.round((Date.now() - s0) / 100) / 10;
    if (sh) {
      try { sh.appendRow([new Date(), "'" + runId, nm, r.pass, r.fail, secs, r.text]); } catch (e) { Logger.log('نوشتن در تب تست‌ها نشد: ' + e); }
    }
    Logger.log(nm + ': ' + r.pass + ' قبول · ' + r.fail + ' مردود · ' + secs + 'ث' + (r.fail ? '\n' + r.text : ''));
    at++; done++;
    p.setProperty('TG_TEST_AT', String(at));
  }
  if (at < TG_SUITES.length) {
    chain++;
    p.setProperty('TG_TEST_CHAIN', String(chain));
    var msg = 'وقت تمام شد. ' + done + ' مجموعه در این دور، ' + (TG_SUITES.length - at) + ' مانده.';
    if (chain < TG_TEST_MAX_CHAIN) {
      try {
        ScriptApp.newTrigger('tgRun').timeBased().after(60 * 1000).create();
        msg += ' یک دقیقهٔ دیگر خودش ادامه می‌دهد.';
      } catch (e) { msg += ' دوباره Run بزنید (' + e + ')'; }
    } else {
      msg += ' زنجیره به سقف رسید؛ دوباره Run بزنید.';
    }
    Logger.log(msg);
    return msg;
  }

  tgTestCleanup_();
  p.deleteProperty('TG_TEST_AT');
  p.deleteProperty('TG_TEST_CHAIN');
  p.deleteProperty('TG_TEST_BEAT');
  var sum = tgTestSummary_(runId);
  Logger.log(sum);
  return sum;
}

/* خطای گذرای سرویس‌های گوگل در متن مردودی‌های یک مجموعه (۱ مهر ۱۴۰۵: «Service Spreadsheets failed while accessing document» دیپلوی را برگرداند) */
function tgTestTransient_(text) {
  return /Service \w+ failed while accessing|Service invoked too many times|Address unavailable|Service unavailable|We're sorry, a server error occurred|Exception: (Timeout|Internal error)/i.test(String(text || ''));
}

function tgTestCleanup_() {
  try {
    var ts = ScriptApp.getProjectTriggers();
    for (var i = 0; i < ts.length; i++) {
      if (ts[i].getHandlerFunction() === 'tgRun' && ts[i].getEventType() === ScriptApp.EventType.CLOCK) {
        ScriptApp.deleteTrigger(ts[i]);
      }
    }
  } catch (e) {}
}

function tgTestSummary_(runId) {
  try {
    var sh = tgTestSheet_();
    var last = sh.getLastRow();
    if (last < 2) return 'نتیجه‌ای نیست';
    var v = sh.getRange(2, 2, last - 1, 5).getValues(), tz = tgTestSheetTz_(sh);
    var p = 0, f = 0, n = 0, bad = [];
    for (var i = 0; i < v.length; i++) {
      if (tgTestRunKey_(v[i][0], tz) !== String(runId)) continue;
      n++; p += Number(v[i][2] || 0); f += Number(v[i][3] || 0);
      if (Number(v[i][3] || 0) > 0) bad.push(v[i][1] + ' (' + v[i][3] + ')');
    }
    return 'دور ' + runId + ': ' + n + ' مجموعه · ' + p + ' قبول · ' + f + ' مردود'
      + (f ? '\nمردودها: ' + bad.join(' · ') : '\nهمه سبز ✅');
  } catch (e) { return 'خلاصه نشد: ' + e; }
}





/* وبهوک را با فهرست کامل آپدیت‌ها دوباره ست می‌کند.
   بدون channel_post و my_chat_member، تلگرام پیام‌های کانال را اصلاً نمی‌فرستد. */
function tgAllowAll() {
  const p = PropertiesService.getScriptProperties();
  const url = String(p.getProperty('TG_RELAY_URL') || '').trim();
  const sec = String(p.getProperty('TG_HOOK_SECRET') || '').trim();
  if (!url) return 'TG_RELAY_URL خالی است.';
  const body = {
    url: url,
    allowed_updates: ['message', 'edited_message', 'callback_query',
      'channel_post', 'edited_channel_post', 'my_chat_member', 'chat_member'],
    drop_pending_updates: false
  };
  if (sec) body.secret_token = sec;
  const r = tgApi_('setWebhook', body);
  let ok = false, desc = '';
  try { const j = JSON.parse(r.getContentText()); ok = !!j.ok; desc = j.description || ''; } catch (e) { desc = String(e); }
  if (!ok) return 'نشد: ' + desc;
  const r2 = tgApi_('getWebhookInfo', {});
  let a = '';
  try { a = JSON.stringify((JSON.parse(r2.getContentText()).result || {}).allowed_updates); } catch (e2) {}
  return 'وبهوک دوباره ست شد. allowed: ' + a;
}


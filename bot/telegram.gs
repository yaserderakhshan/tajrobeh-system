// کلیک روی گویه‌های چندانتخابی. هر انتخاب با جملهٔ کامل به خود کاربر برمی‌گردد
function tgOnPick_(chat, msgId, prefix, key) {
  const isNeeds = prefix === 'nd:';
  const store = isNeeds ? 'nd' : 'pf';
  const items = isNeeds ? TG_NEEDS : TG_PREFS;

  if (!isNeeds && (key === 'redo' || key === 'redoq')) {
    tgDelFlag_('pfd', chat);
    tgSetVal_('pf', chat, '');
    if (key === 'redo') tgSetFlag_('ts', chat, 3600); else tgDelFlag_('ts', chat);
    return tgSend_(chat, T_Q_PREFS, tgPickKb_(TG_PREFS, 'pf:', []));
  }

  if (key === 'ok' || key === 'none') {
    if (key === 'none') tgSetVal_(store, chat, '');
    const sel = tgSelList_(store, chat);
    const names = items.filter(function (it) { return sel.indexOf(it.k) > -1; }).map(function (it) { return it.label; });
    tgSend_(chat, '✅ انتخاب شما: ' + (names.length ? names.join('، ') : 'هیچ‌کدام'));
    if (isNeeds) {
      if (tgGetVal_('qt', chat) === 'psy') return tgQuizGender_(chat, '');
      return tgQuizPrefs_(chat);
    }
    if (tgFlag_('ts', chat)) { tgDelFlag_('ts', chat); return tgStyleResult_(chat); }
    tgSetFlag_('pfd', chat, 86400);
    return tgQuizGender_(chat, '');
  }
  const sel = tgToggle_(store, chat, key);
  if (msgId) tgApi_('editMessageReplyMarkup', { chat_id: chat, message_id: msgId, reply_markup: tgPickKb_(items, prefix, sel) });
}


  'معارفه هماهنگ شد؟': 20, 'تاریخ معارفه': 21, 'درمانگر معارفه': 22, 'شروع درمان؟': 23
};

function tgStNorm_(s) {
  const raw = String(s || '').trim();
  if (!raw) return { st: '', known: true, changed: false, legacy: '' };
  const k = tgNormSt_(raw);
  for (var i = 0; i < TG_LEAD_ST.length; i++) {
    if (tgNormSt_(TG_LEAD_ST[i]) === k) return { st: TG_LEAD_ST[i], known: true, changed: TG_LEAD_ST[i] !== raw, legacy: TG_LEAD_ST[i] !== raw ? raw : '' };
  }
  for (var m in TG_ST_MAP) {
    if (Object.prototype.hasOwnProperty.call(TG_ST_MAP, m) && tgNormSt_(m) === k) return { st: TG_ST_MAP[m], known: true, changed: true, legacy: raw };
  }
  // ناشناس: از روی واژه‌ها نزدیک‌ترین را حدس می‌زند
  var guess = '';
  if (/نهایی|بست|منصرف|لغو|تکرار|منتفی/.test(k)) guess = TG_ST.CLOSED;
  else if (/شروع|تبدیل/.test(k)) guess = TG_ST.START;
  else if (/برگزار|انجام شد/.test(k)) guess = TG_ST.HELD;
  else if (/معارفه|رزرو|قرار|هماهنگ/.test(k)) guess = TG_ST.BOOKED;
  else if (/ارجاع/.test(k)) guess = TG_ST.REF;
  else if (/پاسخ نداد|بی.?پاسخ|جواب نداد/.test(k)) guess = TG_ST.NOANS;
  else if (/پیگیری|جریان|تماس|منتظر|توقف/.test(k)) guess = TG_ST.FOLLOW;
  else if (/جدید|فوری|تازه/.test(k)) guess = TG_ST.NEW;
  return { st: guess, known: false, changed: true, legacy: raw };
}
function tgStOf_(s) { return tgStNorm_(s).st; }
// «بسته» و «شروع درمان» از کارتابل بیرون‌اند؛ مقدارهای قدیمی بستن هم از راه نگاشت همین‌جا می‌افتند
function tgStClosed_(s) {
  const st = tgStOf_(s);
  if (st === TG_ST.CLOSED || st === TG_ST.START) return true;
  try { return !!(s && tgClosedSet_()[tgNormSt_(s)]); } catch (e) { return false; }
}

// نقشهٔ هدر تب لیدها به اندیس ستون (صفرپایه)، یک بار در هر اجرا
var TG_LEAD_HM_ = null;
function tgLeadHeadMap_(sh) {
  if (TG_LEAD_HM_) return TG_LEAD_HM_;
  const map = {};
  if (TG_DRY) return map;
  try {
    const s = sh || tgSS_().getSheetByName(TG_LEADS);
    const hd = s.getRange(1, 1, 1, s.getLastColumn()).getValues()[0];
    for (var i = 0; i < hd.length; i++) { const h = String(hd[i] || '').trim(); if (h && map[h] === undefined) map[h] = i; }
    for (var f in TG_LEAD_FIXED) if (map[f] === undefined) map[f] = TG_LEAD_FIXED[f] - 1;
  } catch (e) {}
  TG_LEAD_HM_ = map;
  return map;
}
function tgLeadHv_(v, hm, name) {
  const i = hm[name];
  if (i === undefined || i < 0 || i >= v.length) return '';
  return v[i];
}
// تاریخ سلول به yyyy-MM-dd؛ خالی اگر تاریخ نبود
function tgLeadIso_(x) {
  if (!x) return '';
  if (x instanceof Date) { if (isNaN(x.getTime())) return ''; if (x.getFullYear() < 1700) x = tgJ2G_(x.getFullYear(), x.getMonth() + 1, x.getDate()); return Utilities.formatDate(x, TG_TZ, 'yyyy-MM-dd'); }
  const s = tgLatinDigits_(String(x)).trim();
  if (/^\d{4}-\d{2}-\d{2}/.test(s) && Number(s.slice(0, 4)) >= 1990) return s.slice(0, 10);
  const d = tgContactDate_(s, new Date());
  return d ? Utilities.formatDate(d, TG_TZ, 'yyyy-MM-dd') : '';
}
function tgLeadDayAdd_(n) {
  return Utilities.formatDate(new Date(Date.now() + n * 86400000), TG_TZ, 'yyyy-MM-dd');
}
// مرحلهٔ کارتابل: تماس اول نگرفته (first)، موعد اقدام رسیده یا بی‌حرکت (stale)، در جریان (live)
function tgLeadStage_(touched, idleMin, nextIso, today) {
  if (!touched) return 'first';
  if (nextIso) return nextIso <= today ? 'stale' : 'live';
  return idleMin >= TG_SLA_IDLE_DAYS * 1440 ? 'stale' : 'live';
}
// chat_id تلگرام مراجع از ستون یادداشت
function tgLeadChat_(memo) {
  const m = String(memo || '').match(/chat_id:\s*(\d+)/);
  return m ? m[1] : '';
}

const TG_LEAD_EV_TAB   = 'رویدادهای لید';
const TG_LEAD_EV_HEAD  = ['زمان', 'کد لید', 'سطر', 'کی', 'کانال', 'چه شد', 'از', 'به', 'یادداشت', 'نوع لید'];   /* v170.2: نوع لید در انتها */
const TG_LEAD_CODE_HEAD = 'کد لید';
const TG_LEAD_CODE_FIRST = 1001;
const TG_LEAD_CARD_MAX = 4;

// فقط این ستون‌ها از مسیر بات نوشته می‌شوند. هر نام دیگری رد می‌شود
// تا یک اشتباه تایپی ستون تازه‌ای در تب لیدها نسازد.
const TG_LEAD_FIELDS = [
  'وضعیت', 'مسئول', 'آخرین تماس', 'نتیجه', 'یادداشت', 'نوع درخواست', 'موضوع اصلی',
  'تاریخ ارجاع', 'معارفه هماهنگ شد؟', 'تاریخ معارفه', 'درمانگر معارفه', 'شروع درمان؟', 'کد لید',
  'درمانگر پیشنهادی ۱', 'درمانگر پیشنهادی ۲', 'درمانگر پیشنهادی ۳', 'کانال ترجیحی',
  /* v140 */ 'اقدام بعدی', 'تاریخ اقدام بعدی', 'شمار بی‌پاسخ', 'دلیل بستن', 'شماره / شناسه',
  /* v168 */ 'مهلت', 'شمار جابه‌جایی', 'حالت', 'شناسهٔ مکان', 'شهر درخواستی',
  /* v168.9 */ 'کشور محل زندگی', 'از کجا با ما آشنا شدید؟',
  /* v170.2 مدل لید */ 'نوع لید', 'پیشنهاد کاربر', 'پیامد', 'مسئول مرحله', 'مهلت مرحله', 'منبع جزئیات',
  /* v170.2 کامنت‌ها: ترجیحات برای پیشنهاد درمانگر */ 'ترجیحات', 'حالت جلسه', 'ترجیح جنسیت', 'ترجیح سن',
  /* v170.13 */ 'کد کمپین', 'آفر',
  /* v170.18 برگشت مراجع: زمان ورود تازه، منطقه، اعلان */ 'تاریخ', 'زمان', 'تاریخ شمسی', 'داخل یا خارج', 'اعلان بات'
];

// ستون‌هایی که تریگر شیت رویشان حساس است
const TG_LEAD_WATCH = { 9: 'وضعیت', 10: 'مسئول', 11: 'آخرین تماس', 12: 'نتیجه', 20: 'معارفه هماهنگ شد؟', 22: 'درمانگر معارفه' };

var TG_DRY_LEAD = null;   // لید جعلی برای تست خشک

/* ---------- دفتر رویداد ---------- */

function tgLeadEvSheet_() {
  if (TG_DRY) return null;
  const ss = tgSS_();
  var sh = ss.getSheetByName(TG_LEAD_EV_TAB);
  if (!sh) {
    sh = ss.insertSheet(TG_LEAD_EV_TAB);
    sh.getRange(1, 1, 1, TG_LEAD_EV_HEAD.length).setValues([TG_LEAD_EV_HEAD]).setFontWeight('bold');
    sh.setFrozenRows(1);
    sh.setColumnWidth(1, 150);
    try { sh.hideSheet(); } catch (e) {}
  }
  return sh;
}

function tgLeadEv_(o) {
  if (TG_DRY) { TG_OUTBOX.push({ kind: 'leadev', o: o }); return; }
  try {
    const sh = tgLeadEvSheet_();
    if (!sh) return;
    sh.appendRow([
      new Date(),
      o.code || '', o.row || '', o.actor || 'بات', o.channel || 'تلگرام',
      o.what || '',
      o.from === undefined || o.from === null ? '' : String(o.from),
      o.to === undefined || o.to === null ? '' : String(o.to),
      o.note || '', o.type || ''
    ]);
  } catch (e) { try { tgErr_('tgLeadEv_: ' + e); } catch (e2) {} }
}

/* ---------- کد لید ---------- */

function tgLeadCodeCol_() {
  if (TG_DRY) return 37;
  return tgLeadCol_(TG_LEAD_CODE_HEAD);
}

var TG_LEAD_CODE_X = {};
function tgLeadCode_(row) {
  if (TG_DRY) return TG_DRY_LEAD && TG_DRY_LEAD.row === row ? TG_DRY_LEAD.code : 'L-9999';
  if (!row || row < 2) return '';
  if (TG_LEAD_CODE_X[row]) return TG_LEAD_CODE_X[row];   /* v166.26: یک بار در هر اجرا */
  const sh = tgSS_().getSheetByName(TG_LEADS);
  const col = tgLeadCodeCol_();
  var cur = String(sh.getRange(row, col).getValue() || '').trim();
  if (cur) return (TG_LEAD_CODE_X[row] = cur);
  /* v166.10: اگر صدازننده (مثل tgDutyTick یا رزرو) خودش قفل را دارد، دوباره نمی‌گیرد و در پایان رها نمی‌کند؛
     پیش از این releaseLock اینجا قفل بیرونی را هم آزاد می‌کرد. */
  const lock = LockService.getScriptLock();
  const had = TG_LOCK_HELD || TG_DRY || lock.hasLock();   /* v166.24: تست خشک منتظر قفل بات زنده نمی‌ماند */
  if (!had) { try { lock.waitLock(20000); } catch (e) { return ''; } }
  try {
    cur = String(sh.getRange(row, col).getValue() || '').trim();
    if (cur) return cur;
    const last = sh.getLastRow();
    var max = TG_LEAD_CODE_FIRST - 1;
    if (last >= 2) {
      const all = sh.getRange(2, col, last - 1, 1).getValues();
      for (var i = 0; i < all.length; i++) {
        const m = String(all[i][0] || '').trim().match(/^L-(\d+)$/);
        if (m && Number(m[1]) > max) max = Number(m[1]);
      }
    }
    const code = 'L-' + (max + 1);
    sh.getRange(row, col).setValue(code);
    tgLeadMark_(row);
    CacheService.getScriptCache().put('lc' + code, String(row), 21600);
    return code;
  } finally { if (!had) { try { lock.releaseLock(); } catch (e) {} } }
}

function tgLeadByCode_(code) {
  const c = String(code || '').trim();
  if (!c) return -1;
  if (TG_DRY) return TG_DRY_LEAD && TG_DRY_LEAD.code === c ? TG_DRY_LEAD.row : -1;
  const sh = tgSS_().getSheetByName(TG_LEADS);
  const col = tgLeadCodeCol_();
  const cache = CacheService.getScriptCache();
  const hit = cache.get('lc' + c);
  if (hit) {
    const r = Number(hit);
    if (r >= 2 && r <= sh.getLastRow() &&
        String(sh.getRange(r, col).getValue() || '').trim() === c) return r;
    cache.remove('lc' + c);
  }
  const last = sh.getLastRow();
  if (last < 2) return -1;
  const all = sh.getRange(2, col, last - 1, 1).getValues();
  for (var i = all.length - 1; i >= 0; i--) {
    if (String(all[i][0] || '').trim() === c) {
      cache.put('lc' + c, String(i + 2), 21600);
      return i + 2;
    }
  }
  return -1;
}

/* ---------- نشانهٔ «خود بات نوشت» تا تریگر شیت حلقه نزند ---------- */

function tgLeadMark_(row) {
  if (TG_DRY) return;
  try { CacheService.getScriptCache().put('ledit' + row, '1', 90); } catch (e) {}
}
function tgLeadMine_(row) {
  if (TG_DRY) return false;
  try { return !!CacheService.getScriptCache().get('ledit' + row); } catch (e) { return false; }
}

/* ---------- تنها نویسندهٔ تب لیدها ---------- */

function tgLeadSet_(row, changes, actor, channel, why) {
  if (!row || row < 2 || !changes) return '';
  // وضعیت فقط از واژگان واحد نوشته می‌شود؛ مقدار قدیمی یا ناشناس به نزدیک‌ترین برمی‌گردد
  if (changes['وضعیت'] !== undefined && String(changes['وضعیت'] || '').trim()) {
    const nz = tgStNorm_(changes['وضعیت']);
    if (nz.st) changes['وضعیت'] = nz.st;
  }
  /* v168 فاز ۲: نگهبان «اقدام بعدی»؛ لید باز هیچ‌وقت بی اقدام و تاریخ نمی‌ماند، لید بسته اقدام ندارد */
  var v168Auto = {};
  if (TG_DRY && typeof v168NextFix_ === 'function') {
    var cd = v168CurDry_(row);
    if (cd) { var fxd = v168NextFix_(cd, changes); changes = fxd.changes; v168Auto = fxd.auto; }
  }
  if (TG_DRY) {
    TG_OUTBOX.push({ kind: 'leadset', row: row, changes: changes, actor: actor || 'بات', auto: v168Auto });
    if (typeof v168PpReset_ === 'function' && !/^بعداً/.test(String(why || '')) &&
        Object.keys(changes).some(function (x) { return x !== 'اقدام بعدی' && x !== 'تاریخ اقدام بعدی'; })) v168PpReset_(TG_DRY_LEAD ? TG_DRY_LEAD.code : 'L-9999');
    if (TG_DRY_LEAD && TG_DRY_LEAD.row === row) {
      if (changes['وضعیت'] !== undefined) TG_DRY_LEAD.status = changes['وضعیت'];
      if (changes['مسئول'] !== undefined) TG_DRY_LEAD.owner = changes['مسئول'];
      if (changes['نتیجه'] !== undefined) TG_DRY_LEAD.result = changes['نتیجه'];
      if (changes['اقدام بعدی'] !== undefined) TG_DRY_LEAD.next = changes['اقدام بعدی'];
      if (changes['تاریخ اقدام بعدی'] !== undefined) TG_DRY_LEAD.nextDate = changes['تاریخ اقدام بعدی'];
      if (changes['شمار بی‌پاسخ'] !== undefined) TG_DRY_LEAD.noans = Number(changes['شمار بی‌پاسخ']) || 0;
      if (changes['دلیل بستن'] !== undefined) TG_DRY_LEAD.reason = changes['دلیل بستن'];
      if (changes['درمانگر معارفه'] !== undefined) TG_DRY_LEAD.meetTher = changes['درمانگر معارفه'];
      if (changes['تاریخ معارفه'] !== undefined) TG_DRY_LEAD.meetDate = changes['تاریخ معارفه'];
      if (changes['معارفه هماهنگ شد؟'] !== undefined) TG_DRY_LEAD.booked = changes['معارفه هماهنگ شد؟'] === 'بله';
      if (changes['آخرین تماس'] !== undefined) { TG_DRY_LEAD.touched = true; TG_DRY_LEAD.idle = 0; TG_DRY_LEAD.stage = 'live'; }
      if (changes['وضعیت'] !== undefined) TG_DRY_LEAD.closed = tgStClosed_(changes['وضعیت']);
    }
    return TG_DRY_LEAD ? TG_DRY_LEAD.code : 'L-9999';
  }
  if (tgTestLeak_('تغییر لید')) return '';
  const sh = tgSS_().getSheetByName(TG_LEADS);
  if (!sh) return '';
  const code = tgLeadCode_(row);
  const done = [];
  /* v166.26: ردیف یک بار خوانده می‌شود، نه یک بار برای هر ستون */
  var rowNow = null;
  if (typeof v168NextFix_ === 'function') {
    rowNow = sh.getRange(row, 1, 1, sh.getLastColumn()).getValues()[0];
    var fx = v168NextFix_(v168CurFromRow_(rowNow, tgLeadHeadMap_(sh)), changes);
    changes = fx.changes; v168Auto = fx.auto;
  }
  for (var k in changes) {
    if (!Object.prototype.hasOwnProperty.call(changes, k)) continue;
    if (TG_LEAD_FIELDS.indexOf(k) < 0) { try { tgErr_('tgLeadSet_: ستون ناشناخته ' + k); } catch (e) {} continue; }
    const col = tgLeadCol_(k);
    if (!col) continue;
    const cell = sh.getRange(row, col);
    if (!rowNow) rowNow = sh.getRange(row, 1, 1, Math.max(col, sh.getLastColumn())).getValues()[0];
    const before = col <= rowNow.length ? rowNow[col - 1] : cell.getValue();
    const after = changes[k];
    if (String(before).trim() === String(after).trim()) continue;
    if (k === 'شمار بی‌پاسخ') { try { cell.setNumberFormat('0'); } catch (eNf) {} }   /* v170.22.2: صفر با قالب تاریخ «۱۸۹۹» دیده می‌شد */
    cell.setValue(after);
    done.push({ what: k, from: before, to: after });
  }
  if (done.length) {
    tgLeadMark_(row);
    for (var i = 0; i < done.length; i++) {
      tgLeadEv_({
        code: code, row: row, actor: v168Auto[done[i].what] ? 'بات' : (actor || 'بات'), channel: channel || 'تلگرام',
        what: done[i].what, from: done[i].from, to: done[i].to, note: v168Auto[done[i].what] || why || ''
      });
    }
    /* «⏰ بعداً» پشت سر هم: هر کار واقعی دیگر شمار را صفر می‌کند */
    if (typeof v168PpReset_ === 'function' && !/^بعداً/.test(String(why || '')) &&
        done.some(function (x) { return x.what !== 'اقدام بعدی' && x.what !== 'تاریخ اقدام بعدی'; })) { try { v168PpReset_(code); } catch (eP) {} }
  }
  return code;
}

// یادداشت اضافه می‌شود، جایگزین نمی‌شود (ستون یادداشت chat_id را هم نگه می‌دارد)
function tgLeadNote_(row, text, actor) {
  const t = String(text || '').trim();
  if (!row || row < 2 || !t) return '';
  if (TG_DRY) {
    TG_OUTBOX.push({ kind: 'leadnote', row: row, text: t, actor: actor || 'بات' });
    if (TG_DRY_LEAD && TG_DRY_LEAD.row === row) TG_DRY_LEAD.memo = (TG_DRY_LEAD.memo || '') + ' | ' + t;
    const dc = TG_DRY_LEAD ? TG_DRY_LEAD.code : 'L-9999';
    tgLeadEv_({ code: dc, row: row, actor: actor || 'بات', channel: 'تلگرام', what: 'یادداشت', to: t });
    return dc;
  }
  const sh = tgSS_().getSheetByName(TG_LEADS);
  const col = tgLeadCol_('یادداشت');
  const cell = sh.getRange(row, col);
  const cur = String(cell.getValue() || '').trim();
  const stamp = Utilities.formatDate(new Date(), TG_TZ, 'MM-dd HH:mm');
  const line = stamp + ' ' + (actor || 'پذیرش') + ': ' + t;
  cell.setValue(cur ? cur + '\n' + line : line);
  tgLeadMark_(row);
  const code = tgLeadCode_(row);
  tgLeadEv_({ code: code, row: row, actor: actor || 'بات', channel: 'تلگرام', what: 'یادداشت', to: t });
  return code;
}

/* ---------- خواندن یک لید ---------- */

function tgLeadRead_(row) {
  if (TG_DRY) return TG_DRY_LEAD && TG_DRY_LEAD.row === row ? TG_DRY_LEAD : null;
  const sh = tgSS_().getSheetByName(TG_LEADS);
  if (!sh || !row || row < 2 || row > sh.getLastRow()) return null;
  const codeCol = tgLeadCodeCol_();
  const v = sh.getRange(row, 1, 1, sh.getLastColumn()).getValues()[0];
  const hm = tgLeadHeadMap_(sh);
  const now = new Date();
  const today = Utilities.formatDate(now, TG_TZ, 'yyyy-MM-dd');
  const statusRaw = String(v[8] || '').trim();
  const status = tgStOf_(statusRaw) || statusRaw;
  const ld = tgContactDate_(v[10], now);
  const touched = !!ld;
  const idle = touched ? Math.round((now - ld) / 60000) : 0;
  const nextIso = tgLeadIso_(tgLeadHv_(v, hm, 'تاریخ اقدام بعدی'));
  var d = (v[0] instanceof Date) ? new Date(v[0]) : new Date(String(v[0]) + 'T00:00:00');
  const hhmm = tgLatinDigits_(String(v[1] || '').trim());
  if (/^\d{1,2}:\d{2}$/.test(hhmm) && !isNaN(d.getTime())) {
    const p = hhmm.split(':');
    d.setHours(Number(p[0]), Number(p[1]), 0, 0);
  }
  const age = isNaN(d.getTime()) ? 0 : Math.round((now - d) / 60000);
  return {
    row: row,
    code: String(v[codeCol - 1] || '').trim(),
    name: String(v[3] || '').trim(),
    phone: String(v[5] || '').trim(),
    src: String(v[2] || '').trim(),
    channel: String(v[4] || '').trim(),
    region: String(v[6] || '').trim(),
    first: String(v[7] || '').trim(),
    status: status, statusRaw: statusRaw,
    owner: String(v[9] || '').trim(),
    result: String(v[11] || '').trim(),
    memo: String(v[12] || '').trim(),
    chatId: tgLeadChat_(v[12]),
    ref1: String(v[15] || '').trim(), ref2: String(v[16] || '').trim(), ref3: String(v[17] || '').trim(),
    booked: String(v[19] || '').trim() === 'بله',
    meetDate: tgLeadIso_(v[20]) || String(v[20] || '').trim(),
    meetTher: String(v[21] || '').trim(),
    next: String(tgLeadHv_(v, hm, 'اقدام بعدی') || '').trim(),
    nextDate: nextIso,
    noans: Number(tgLatinDigits_(String(tgLeadHv_(v, hm, 'شمار بی‌پاسخ') || '0'))) || 0,
    reason: String(tgLeadHv_(v, hm, 'دلیل بستن') || '').trim(),
    offer: String(tgLeadHv_(v, hm, 'آفر') || '').trim(),   /* v170.13 */
    closed: tgStClosed_(statusRaw),
    touched: touched, idle: idle, age: age,
    stage: tgLeadStage_(touched, idle, nextIso, today)
  };
}

/* ---------- کارت لید ---------- */

// دو خط آخر یادداشت، بی chat_id و یوزرنیم، برای کارت
function tgLeadMemoTail_(memo, n) {
  const parts = String(memo || '').split(/\n|\s·\s|\s\|\s/).map(function (s) { return s.trim(); })
    .filter(function (s) { return s && !/chat_id:/.test(s) && !/^@\w+$/.test(s); });
  return parts.slice(-(n || 2)).map(function (s) { return s.length > 90 ? s.slice(0, 90) + '…' : s; });
}

function tgLeadCardText_(l) {
  const today = Utilities.formatDate(new Date(), TG_TZ, 'yyyy-MM-dd');
  const tag = l.closed ? '✅ ' :
              (l.booked ? '📅 ' :
              (String(l.region || '').indexOf('خارج') > -1 ? '🌍 ' :
              (l.stage === 'first' ? '☎ ' : '↻ ')));
  var t = '<b>' + tag + tgEsc_(l.name || 'بدون نام') + '</b>';
  if (l.code) t += ' · <code>' + tgEsc_(l.code) + '</code>';
  t += '\n' + tgEsc_(l.src || 'منبع نامعلوم');
  if (l.region) t += ' · ' + tgEsc_(l.region);
  if (l.offer) t += '\n🎁 آفر: ' + tgEsc_(l.offer);   /* v170.13 */
  if (l.phone) t += '\n📱 <code>' + tgEsc_(l.phone) + '</code>';
  t += '\n' + (l.stage === 'first'
    ? 'ثبت ' + tgLeadDur_(l.age) + ' پیش، هنوز تماس اول نگرفته'
    : 'آخرین تماس ' + tgLeadDur_(l.idle) + ' پیش');
  t += '\nوضعیت: <b>' + tgEsc_(l.status || 'جدید') + '</b> · ' + (l.owner ? tgEsc_(l.owner) : 'بدون مسئول');
  if (l.result) t += ' · ' + tgEsc_(l.result);
  if (l.closed && l.reason) t += '\nدلیل بستن: ' + tgEsc_(l.reason);
  if (!l.closed && (l.next || l.nextDate)) {
    t += '\n📌 اقدام بعدی: ' + tgEsc_(l.next || 'پیگیری');
    if (l.nextDate) t += ' · ' + (l.nextDate < today ? '⚠️ گذشته، ' : (l.nextDate === today ? 'امروز، ' : '')) + tgEsc_(tgLeadJ_(l.nextDate));
  }
  if (l.noans > 0) t += '\n🔕 بی‌پاسخ: ' + tgFa_(l.noans) + ' بار';
  if (l.meetTher || l.meetDate) t += '\n🗓 معارفه: ' + tgEsc_(l.meetTher || 'درمانگر نامعلوم') + (l.meetDate ? ' · ' + tgEsc_(tgLeadJ_(l.meetDate)) : '');
  const tail = tgLeadMemoTail_(l.memo, 2);
  if (tail.length) t += '\n🗒 ' + tail.map(tgEsc_).join('\n🗒 ');
  if (l.first) t += '\n\n<i>' + tgEsc_(String(l.first).slice(0, 180)) + '</i>';
  return t;
}

// تاریخ میلادی yyyy-MM-dd به شمسی کوتاه برای کارت؛ اگر تاریخ نبود همان متن
function tgLeadJ_(iso) {
  try {
    const s = String(iso || '').trim();
    if (!/^\d{4}-\d{2}-\d{2}/.test(s)) return s;
    return tgJDate_(new Date(s.slice(0, 10) + 'T12:00:00'), TG_TZ) + (s.length > 10 ? s.slice(10) : '');
  } catch (e) { return String(iso || ''); }
}

function tgLeadKb_(l) {
  if (l.closed) {
    return { inline_keyboard: [
      [{ text: '↺ باز کردن دوباره', callback_data: 'ld:open:' + l.code }],
      [{ text: '🔍 لید دیگر', callback_data: 'ld:find:' + l.code }]
    ] };
  }
  const rows = [
    [{ text: '☎ تماس گرفتم', callback_data: 'ld:call:' + l.code },
     { text: '🔕 پاسخ نداد', callback_data: 'ld:noans:' + l.code }],
    [{ text: '📝 یادداشت', callback_data: 'ld:note:' + l.code },
     { text: '👥 واگذاری', callback_data: 'ld:asg:' + l.code }],
    [{ text: l.booked ? '🗓 معارفه (رزرو شده)' : '🗓 معارفه', callback_data: 'ld:meet:' + l.code }],
    [{ text: '📌 اقدام بعدی', callback_data: 'ld:next:' + l.code },
     { text: '⏰ بعداً', callback_data: 'ld:lt:' + l.code },
     { text: '✅ بستن', callback_data: 'ld:close:' + l.code }],
    [{ text: '💊 + روان‌پزشکی', callback_data: 'ld:psy:' + l.code },
     { text: '🔍 لید دیگر', callback_data: 'ld:find:' + l.code }]
  ];
  if (typeof tgWaOpen_ === 'function' && tgWaOpen_(l)) {
    rows.splice(3, 0, [{ text: '✉ پاسخ در واتس‌اپ', callback_data: 'wa:r:' + l.code }]);
  }
  if (l.ref1 || l.ref2 || l.ref3) rows.splice(rows.length - 1, 0, [{ text: '✏️ تغییر پیشنهاد', callback_data: 'ld:sg:' + l.code }]);   /* v168 فاز ۵ */
  try { if (typeof lmOn_ === 'function' && lmOn_()) rows.splice(rows.length - 1, 0, [{ text: '🏁 پیامد', callback_data: 'lm:o:' + l.code }]); } catch (eLm) {}   /* v170.2 مدل لید */
  return { inline_keyboard: rows };
}

function tgLeadCardSend_(chat, row) {
  const l = tgLeadRead_(row);
  if (!l) return null;
  if (!l.code) l.code = tgLeadCode_(row);
  return tgSend_(chat, tgLeadCardText_(l), tgLeadKb_(l));
}

function tgLeadCardEdit_(cq, l) {
  if (TG_DRY) {
    TG_OUTBOX.push({ kind: 'msg', chat: String(cq.message.chat.id), text: tgLeadCardText_(l), markup: tgLeadKb_(l) });
    return;
  }
  tgApi_('editMessageText', {
    chat_id: cq.message.chat.id,
    message_id: cq.message.message_id,
    text: tgLeadCardText_(l),
    parse_mode: 'HTML',
    disable_web_page_preview: true,
    reply_markup: tgLeadKb_(l)
  });
}

// کارت‌های فوری‌ترین لیدها، بعد از خلاصهٔ «کارهای روی زمین»؛ off یعنی از کدام کارت به بعد (صفحه‌بندی)
function tgLeadCards_(chat, b, off) {
  var n = 0;
  try {
    const pick = [];
    const seen = {};
    [].concat(b.first).concat(b.stale).forEach(function (l) { if (!seen[l.row]) { seen[l.row] = 1; pick.push(l); } });
    const from = Number(off || 0);
    for (var i = from; i < pick.length && n < TG_LEAD_CARD_MAX; i++) {
      if (tgLeadCardSend_(chat, pick[i].row)) n++;
    }
    const left = pick.length - (from + n);
    if (left > 0) {
      tgSend_(chat, '… و ' + tgFa_(left) + ' کارت دیگر روی زمین است.', { inline_keyboard: [[
        { text: '▶ ' + tgFa_(Math.min(left, TG_LEAD_CARD_MAX)) + ' کارت بعدی', callback_data: 'ld:more:' + (from + n) }
      ]] });
    }
  } catch (e) { try { tgErr_('tgLeadCards_: ' + e); } catch (e2) {} }
  return n;
}

// صفحهٔ بعدی کارت‌ها از دکمهٔ «کارت بعدی»
function tgDeskMore_(chat, off) {
  const b = tgLeadBuckets_(tgOpenLeads_());
  const n = tgLeadCards_(chat, b, off);
  if (!n) tgSend_(chat, 'کارت دیگری روی زمین نیست 🌿');
}

// جست‌وجوی لید با کد، شماره یا نام؛ تازه‌ترین‌ها اول، تا سه کارت
function tgLeadFind_(q) {
  const s = String(q || '').trim();
  if (!s) return [];
  const mCode = tgLatinDigits_(s).match(/L-?(\d{3,6})/i);
  if (mCode) { const r = tgLeadByCode_('L-' + mCode[1]); return r >= 2 ? [r] : []; }
  const digits = tgLatinDigits_(s).replace(/\D/g, '');
  if (TG_DRY) return TG_DRY_LEAD && (TG_DRY_LEAD.name.indexOf(s) > -1 || (digits && String(TG_DRY_LEAD.phone).indexOf(digits) > -1)) ? [TG_DRY_LEAD.row] : [];
  const sh = tgSS_().getSheetByName(TG_LEADS);
  const last = sh.getLastRow();
  if (last < 2) return [];
  const v = sh.getRange(2, 4, last - 1, 3).getValues(); // نام، کانال، شماره
  const out = [];
  const nq = tgNormSt_(s);
  for (var i = v.length - 1; i >= 0 && out.length < 3; i--) {
    if (digits.length >= 4) {
      const ph = tgLatinDigits_(String(v[i][2] || '')).replace(/\D/g, '');
      if (ph && ph.indexOf(digits) > -1) { out.push(i + 2); continue; }
    } else {
      const nm = tgNormSt_(String(v[i][0] || ''));
      if (nm && nq.length >= 2 && nm.indexOf(nq) > -1) out.push(i + 2);
    }
  }
  return out;
}

function tgLeadFindSend_(chat, q) {
  const rows = tgLeadFind_(q);
  if (!rows.length) { tgSend_(chat, 'لیدی با «' + tgEsc_(String(q).slice(0, 40)) + '» پیدا نشد. کد لید (مثل L-1042)، شماره یا بخشی از نام را بنویسید.'); return 0; }
  for (var i = 0; i < rows.length; i++) tgLeadCardSend_(chat, rows[i]);
  return rows.length;
}

// معارفه‌های رزروشدهٔ یک لید از تب اسلات (کد لید در ستون «لید مرتبط»)
function tgLeadSlots_(code) {
  if (TG_DRY) return TG_MEM['ldbooked'] || [];
  const out = [];
  try {
    const sh = tgSS_().getSheetByName(TG_SLOTS);
    if (!sh || sh.getLastRow() < 4) return out;
    const map = tgMtHeadMap_();
    const lc = sh.getLastColumn();
    const v = sh.getRange(4, 1, sh.getLastRow() - 3, lc).getValues();
    const cEv = map['رویداد تقویم'];
    for (var i = 0; i < v.length; i++) {
      if (String(v[i][5] || '').trim() !== 'رزرو شده') continue;
      if (String(v[i][7] || '').indexOf(code) < 0) continue;
      if (!(v[i][1] instanceof Date)) continue;
      out.push({ row: i + 4, therapist: String(v[i][0] || '').trim(),
                 dateIso: Utilities.formatDate(v[i][1], TG_TZ, 'yyyy-MM-dd'), hhmm: tgHHMM_(v[i][3]),
                 tg: tgMtTgId_(v[i][7]), ev: cEv === undefined ? '' : String(v[i][cEv] || '').trim() });
    }
  } catch (e) { try { tgErr_('tgLeadSlots_: ' + e); } catch (e2) {} }
  return out;
}

// وقت‌های آزاد یک درمانگر برای رزرو از کارت؛ در حالت خشک از TG_MEM
function tgLeadFreeFor_(therName, scope) {
  if (TG_DRY) return (TG_MEM['ldslots'] || []).filter(function (s) { return s.therapist === therName; });
  /* v166.16: وقت گذشته (سطر «آزاد» قدیمی یا ساعت‌های گذشتهٔ امروز) در فهرست ۸تایی کارت جای وقت واقعی را نگیرد */
  var now = Date.now();
  return tgFreeSlots_(scope).filter(function (s) { return s.therapist === therName && tgSlotUtc_(s).getTime() > now; });
}

// به مسئول لید (اگر به بات وصل است) خبر می‌دهد؛ اگر مسئول نداشت، به مسئول پذیرش
function tgLeadOwnerSay_(l, text, withCard) {
  try {
    const team = (TG_DRY ? (TG_MEM['desk'] || []) : tgDeskRows_()).filter(function (p) { return p.chat; });
    var to = null;
    if (l && l.owner) for (var i = 0; i < team.length; i++) if (tgNormSt_(team[i].name) === tgNormSt_(l.owner)) to = team[i];
    if (!to) to = team.length ? team[0] : null;
    if (!to || !to.chat) return false;
    tgSend_(to.chat, text);
    if (withCard && l && l.row) tgLeadCardSend_(to.chat, l.row);
    return true;
  } catch (e) { return false; }
}

/* ---------- کمک‌کارها ---------- */

function tgClosedList_() {
  const out = [], seen = {};
  function push(s) {
    const v = String(s || '').trim();
    if (!v) return;
    const k = tgNormSt_(v);
    if (seen[k]) return;
    seen[k] = 1; out.push(v);
  }
  if (!TG_DRY) {
    try {
      tgClosedSet_();
      String(CacheService.getScriptCache().get('closedset') || '').split('|').filter(String).forEach(push);
    } catch (e) {}
  }
  if (!out.length) TG_LEAD_CLOSED.forEach(push);
  return out;
}

function tgDeskByName_(nm) {
  const n = tgNormSt_(nm);
  if (!n) return null;
  const list = tgDeskRows_();
  for (var i = 0; i < list.length; i++) if (tgNormSt_(list[i].name) === n) return list[i];
  for (var j = 0; j < list.length; j++) {
    const o = tgNormSt_(list[j].name);
    if (o && (o.indexOf(n) > -1 || n.indexOf(o) > -1)) return list[j];
  }
  return null;
}

function tgTherChatByName_(nm) {
  if (TG_DRY) return '';
  try {
    const hit = tgTherFind_(String(nm || ''), true);
    if (!hit || !hit.length) return '';
    const r = hit[0];
    const raw = String(r.chat || r.chatId || '').trim();
    const ids = raw.split(/[,،;\s]+/).filter(String);
    return ids.length ? ids[0] : '';
  } catch (e) { return ''; }
}

/* ---------- مسیر دکمه‌های کارت ---------- */

function tgOnLead_(cq, rest) {
  const chat = cq.message.chat.id;
  const who = tgWhoDesk_(chat, cq.from && cq.from.username);
  if (!who) return tgSend_(chat, 'این دکمه‌ها برای تیم پذیرش است.');
  const me = who.name || 'پذیرش';
  const p = String(rest || '').split(':');
  const act = p[0] || '';
  const code = p[1] || '';
  const arg = p.slice(2).join(':');
  const today = Utilities.formatDate(new Date(), TG_TZ, 'yyyy-MM-dd');

  // این دو به لید خاصی وابسته نیستند
  if (act === 'more') return tgDeskMore_(chat, Number(code) || 0);
  if (act === 'find') {
    tgSetVal_('ldf', chat, '1');
    return tgSend_(chat, '🔍 کد لید (مثل L-1042)، شماره یا بخشی از نام را بنویسید. برای بی‌خیال شدن «انصراف».');
  }

  const row = tgLeadByCode_(code);
  if (row < 2) return tgSend_(chat, 'این لید پیدا نشد. شاید سطرش در شیت جابه‌جا شده باشد.');
  const l0 = tgLeadRead_(row);
  if ((act === 'lt' || act === 'lt2' || act === 'lt3') && typeof v168Later_ === 'function') return v168Later_(cq, chat, me, row, code, act, arg, l0);   /* v168 */
  if ((act === 'rs' || act === 'sw' || act === 'mr') && typeof v168Move_ === 'function') return v168Move_(cq, chat, me, row, code, act, arg, l0);   /* v168 فاز ۴ */
  if (/^sg[234]?$/.test(act) && typeof v168Suggest_ === 'function') return v168Suggest_(cq, chat, me, row, code, act, arg, l0);   /* v168 فاز ۵ */
  if (act === 'cn' && typeof v168CloseNoSug_ === 'function') return v168CloseNoSug_(cq, chat, me, row, code, arg);
  if (act === 'close' && typeof v168CloseMenu_ === 'function' && v168CloseMenu_(chat, code, l0)) return null;
  if (act === 'psy') { if (l0 && !l0.code) l0.code = code; return tgPsyLeadPlus_(chat, l0 || { row: row, code: code }, me); }
  const stNow = l0 ? l0.status : '';
  // وضعیت‌های پیشرفته با تماس عادی عقب نمی‌روند
  const advanced = (stNow === TG_ST.REF || stNow === TG_ST.BOOKED || stNow === TG_ST.HELD);

  function nextMenu(text) {
    return tgSend_(chat, text || '📌 اقدام بعدی کی؟', { inline_keyboard: [
      [{ text: 'فردا', callback_data: 'ld:nx:' + code + ':1' },
       { text: '۳ روز دیگر', callback_data: 'ld:nx:' + code + ':3' },
       { text: 'یک هفته', callback_data: 'ld:nx:' + code + ':7' }],
      [{ text: '۲ روز دیگر', callback_data: 'ld:nx:' + code + ':2' },
       { text: '↩️ کارت', callback_data: 'ld:back:' + code }]
    ] });
  }

  if (act === 'call') {
    return tgSend_(chat, '☎ نتیجهٔ تماس با ' + tgEsc_(l0 ? l0.name : code) + '؟', { inline_keyboard: [
      [{ text: '✅ صحبت شد', callback_data: 'ld:co:' + code + ':ok' },
       { text: '🔕 پاسخ نداد', callback_data: 'ld:co:' + code + ':na' }],
      [{ text: '⏳ گفت بعداً زنگ بزنیم', callback_data: 'ld:co:' + code + ':lt' },
       { text: '❌ شمارهٔ اشتباه', callback_data: 'ld:co:' + code + ':wr' }],
      [{ text: '↩️ بی‌خیال', callback_data: 'ld:back:' + code }]
    ] });
  }

  if (act === 'co') {
    if (arg === 'na') return tgOnLead_(cq, 'noans:' + code);
    const ch = { 'آخرین تماس': today };
    if (!l0 || !l0.owner) ch['مسئول'] = me;
    if (arg === 'ok') { ch['نتیجه'] = 'صحبت شد'; if (!advanced) ch['وضعیت'] = TG_ST.FOLLOW; }
    if (arg === 'lt') { ch['نتیجه'] = 'خواست بعداً تماس بگیریم'; if (!advanced) ch['وضعیت'] = TG_ST.FOLLOW; ch['اقدام بعدی'] = 'تماس دوباره'; }
    if (arg === 'wr') { ch['نتیجه'] = 'شمارهٔ اشتباه'; ch['اقدام بعدی'] = 'شمارهٔ درست را پیدا کن'; ch['تاریخ اقدام بعدی'] = today; }
    tgLeadSet_(row, ch, me, 'تلگرام', 'نتیجهٔ تماس');
    tgLeadCardEdit_(cq, tgLeadRead_(row));
    if (arg === 'wr') return tgSend_(chat, 'ثبت شد. اگر راه دیگری برای رسیدن به مراجع نیست، با «✅ بستن» پرونده را ببندید.');
    return nextMenu(arg === 'ok' ? '✅ ثبت شد. اقدام بعدی کی؟' : '⏳ ثبت شد. دوباره کی زنگ بزنیم؟');
  }

  if (act === 'noans') {
    const n = (l0 ? l0.noans : 0) + 1;
    const ch = { 'آخرین تماس': today, 'نتیجه': 'پاسخ نداد (' + tgFa_(n) + ')', 'شمار بی‌پاسخ': n };
    if (!l0 || !l0.owner) ch['مسئول'] = me;
    if (!advanced) ch['وضعیت'] = TG_ST.NOANS;
    tgLeadSet_(row, ch, me, 'تلگرام', 'بی‌پاسخ');
    tgLeadCardEdit_(cq, tgLeadRead_(row));
    if (n >= TG_NOANS_MAX) {
      return tgSend_(chat, '🔕 ' + tgFa_(n) + ' بار بی‌پاسخ. ببندیم؟', { inline_keyboard: [
        [{ text: '✅ ببند: پاسخ نداد (نهایی)', callback_data: 'ld:cl:' + code + ':' + TG_CLOSE_REASONS.indexOf('پاسخ نداد (نهایی)') }],
        [{ text: '🔁 یک بار دیگر، ۳ روز دیگر', callback_data: 'ld:nx:' + code + ':3' },
         { text: '↩️ کارت', callback_data: 'ld:back:' + code }]
      ] });
    }
    return nextMenu('🔕 ثبت شد. دوباره کی؟');
  }

  if (act === 'nx') {
    const d = Number(arg);
    const ch = d > 0
      ? { 'تاریخ اقدام بعدی': tgLeadDayAdd_(d), 'اقدام بعدی': (l0 && l0.next) ? l0.next : 'تماس دوباره' }
      : { 'تاریخ اقدام بعدی': '', 'اقدام بعدی': '' };
    tgLeadSet_(row, ch, me, 'تلگرام', 'اقدام بعدی');
    return tgLeadCardEdit_(cq, tgLeadRead_(row));
  }

  if (act === 'next') {
    return tgSend_(chat, '📌 اقدام بعدی چیست؟', { inline_keyboard: [
      [{ text: '📞 تماس دوباره', callback_data: 'ld:na:' + code + ':call' },
       { text: '💬 پیام بدهم', callback_data: 'ld:na:' + code + ':msg' }],
      [{ text: '⏳ منتظر جواب مراجع', callback_data: 'ld:na:' + code + ':wait' },
       { text: '✍️ خودم می‌نویسم', callback_data: 'ld:na:' + code + ':txt' }],
      [{ text: '↩️ بی‌خیال', callback_data: 'ld:back:' + code }]
    ] });
  }

  if (act === 'na') {
    if (arg === 'txt') {
      tgSetVal_('ldx', chat, code);
      return tgSend_(chat, '✍️ اقدام بعدی را در یک جمله بنویسید. برای بی‌خیال شدن «انصراف».');
    }
    const label = arg === 'call' ? 'تماس دوباره' : (arg === 'msg' ? 'پیام بدهم' : 'منتظر جواب مراجع');
    tgLeadSet_(row, { 'اقدام بعدی': label }, me, 'تلگرام', 'اقدام بعدی');
    return nextMenu('📌 «' + label + '». کی؟');
  }

  if (act === 'note') {
    tgSetVal_('ldn', chat, code);
    return tgSend_(chat, '📝 یادداشت این لید را بنویسید (متن یا ویس). برای بی‌خیال شدن «انصراف» را بفرستید.');
  }

  if (act === 'asg') {
    const list = tgDeskRows_();
    const rows = [];
    for (var i = 0; i < list.length; i++) {
      rows.push([{ text: list[i].name, callback_data: 'ld:as:' + code + ':' + list[i].name }]);
    }
    rows.push([{ text: '↩️ بی‌خیال', callback_data: 'ld:back:' + code }]);
    return tgSend_(chat, 'این لید به چه کسی برسد؟', { inline_keyboard: rows });
  }

  if (act === 'as') {
    if (!arg) return tgSend_(chat, 'اسم مسئول خوانده نشد.');
    tgLeadSet_(row, { 'مسئول': arg }, me, 'تلگرام', 'واگذاری');
    const t = tgDeskByName_(arg);
    if (t && t.chat && String(t.chat) !== String(chat)) {
      tgSend_(t.chat, '👥 یک لید به شما واگذار شد (' + tgEsc_(me) + ').');
      tgLeadCardSend_(t.chat, row);
    }
    return tgSend_(chat, '✅ واگذار شد به ' + tgEsc_(arg) + '.');
  }

  /* ---- معارفه: ارجاع به درمانگر، رزرو وقت از اسلات‌ها، لغو ---- */
  if (act === 'meet') {
    const rows3 = [
      [{ text: '🤝 ارجاع به درمانگر (کارت ارجاع)', callback_data: 'ld:ref:' + code }],
      [{ text: '📅 رزرو وقت معارفه', callback_data: 'ld:bk:' + code }]
    ];
    if (l0 && (l0.booked || tgLeadSlots_(code).length)) {
      rows3.push([{ text: '🔁 زمان تازه، همین درمانگر', callback_data: 'ld:rs:' + code }, { text: '👥 درمانگر دیگر', callback_data: 'ld:sw:' + code }]);   /* v168 */
      rows3.push([{ text: '❌ لغو معارفهٔ رزروشده', callback_data: 'ld:cx:' + code }]);
    }
    rows3.push([{ text: '↩️ بی‌خیال', callback_data: 'ld:back:' + code }]);
    return tgSend_(chat, '🗓 معارفهٔ ' + tgEsc_(l0 ? l0.name : code) + ':', { inline_keyboard: rows3 });
  }

  if (act === 'ref') {
    if (typeof tgReferStart_ === 'function') return tgReferStart_(chat, code);
    return null;
  }

  if (act === 'bk') {
    const scope = (l0 && String(l0.region || '').indexOf('خارج') > -1) ? 'خارج از ایران' : 'داخل ایران';
    var free = TG_DRY ? (TG_MEM['ldslots'] || []) : tgFreeSlots_(scope);
    const names = [], seenN = {};
    for (var f = 0; f < free.length; f++) if (!seenN[free[f].therapist]) { seenN[free[f].therapist] = 1; names.push(free[f].therapist); }
    const rows4 = [];
    for (var k = 0; k < names.length && rows4.length < 8; k++) {
      const cb = 'ld:bt:' + code + ':' + names[k];
      if (Utilities.newBlob(cb).getBytes().length > 64) continue;
      rows4.push([{ text: names[k], callback_data: cb }]);
    }
    rows4.push([{ text: '✍️ اسم درمانگر دیگری', callback_data: 'ld:btx:' + code }]);
    rows4.push([{ text: '↩️ بی‌خیال', callback_data: 'ld:back:' + code }]);
    return tgSend_(chat, names.length
      ? '📅 با کدام درمانگر؟ (کسانی که این هفته‌ها وقت آزاد ' + tgEsc_(scope) + ' دارند)'
      : '📅 الان هیچ وقت آزادی در اسلات‌ها نیست. اسم درمانگر را بنویسید تا وقت‌هایش را ببینم.', { inline_keyboard: rows4 });
  }

  if (act === 'btx') {
    tgSetVal_('ldb', chat, code);
    return tgSend_(chat, '✍️ اسم درمانگر را بنویسید. برای بی‌خیال شدن «انصراف».');
  }

  if (act === 'bt') {
    return tgLeadBookSlots_(chat, code, arg, l0);
  }

  if (act === 'bs') {
    return tgLeadBook_(cq, me, row, code, Number(arg));
  }

  if (act === 'cx') {
    const bk = tgLeadSlots_(code);
    if (!bk.length) {
      if (l0 && l0.booked) {
        tgLeadSet_(row, { 'معارفه هماهنگ شد؟': 'خیر', 'وضعیت': TG_ST.FOLLOW, 'اقدام بعدی': 'وقت تازهٔ معارفه', 'تاریخ اقدام بعدی': today }, me, 'تلگرام', 'لغو معارفه (بدون اسلات)');
        tgLeadCardEdit_(cq, tgLeadRead_(row));
        return tgSend_(chat, 'اسلاتی برای این لید در تب اسلات نبود؛ فقط علامت معارفه برداشته شد.');
      }
      return tgSend_(chat, 'این لید معارفهٔ رزروشده‌ای ندارد.');
    }
    const rows5 = bk.map(function (s) {
      return [{ text: '❌ ' + s.therapist + ' · ' + tgLeadJ_(s.dateIso) + ' ' + s.hhmm, callback_data: 'ld:cxo:' + code + ':' + s.row }];
    });
    rows5.push([{ text: '↩️ بی‌خیال', callback_data: 'ld:back:' + code }]);
    return tgSend_(chat, 'کدام معارفه لغو شود؟', { inline_keyboard: rows5 });
  }

  if (act === 'cxo') {
    return tgLeadCancel_(cq, me, row, code, Number(arg));
  }

  if (act === 'close') {
    const rows2 = [];
    for (var j = 0; j < TG_CLOSE_REASONS.length; j++) {
      rows2.push([{ text: TG_CLOSE_REASONS[j], callback_data: 'ld:cl:' + code + ':' + j }]);
    }
    rows2.push([{ text: '↩️ بی‌خیال', callback_data: 'ld:back:' + code }]);
    return tgSend_(chat, 'به چه دلیل بسته می‌شود؟', { inline_keyboard: rows2 });
  }

  if (act === 'cl') {
    const idx = Number(arg);
    const label = TG_CLOSE_REASONS[idx];
    if (!label) return tgSend_(chat, 'این دلیل پیدا نشد.');
    if (label === TG_ST.START) {
      tgLeadSet_(row, { 'وضعیت': TG_ST.START, 'شروع درمان؟': 'بله', 'آخرین تماس': today, 'اقدام بعدی': '', 'تاریخ اقدام بعدی': '' }, me, 'تلگرام', 'بستن');
      tgLeadCardEdit_(cq, tgLeadRead_(row));
      return tgSend_(chat, '🌱 لید ' + tgEsc_(code) + ' به «شروع درمان» رسید.');
    }
    tgLeadSet_(row, { 'وضعیت': TG_ST.CLOSED, 'دلیل بستن': label, 'آخرین تماس': today, 'اقدام بعدی': '', 'تاریخ اقدام بعدی': '' }, me, 'تلگرام', 'بستن');
    tgLeadCardEdit_(cq, tgLeadRead_(row));
    if (label === 'دلیل دیگر') { tgSetVal_('ldn', chat, code); return tgSend_(chat, '✅ بسته شد. دلیلش را در یک خط بنویسید تا در یادداشت بماند.'); }
    return tgSend_(chat, '✅ لید ' + tgEsc_(code) + ' بسته شد: ' + tgEsc_(label));
  }

  if (act === 'open') {
    tgLeadSet_(row, { 'وضعیت': TG_ST.FOLLOW, 'دلیل بستن': '', 'اقدام بعدی': 'بازبینی بعد از بازگشایی', 'تاریخ اقدام بعدی': today }, me, 'تلگرام', 'بازگشایی');
    return tgLeadCardEdit_(cq, tgLeadRead_(row));
  }

  if (act === 'back') {
    return tgLeadCardSend_(chat, row);
  }

  return null;
}

/* ---------- رزرو معارفه از کارت (پذیرش برای مراجع) ---------- */

// فهرست وقت‌های آزاد یک درمانگر برای این لید؛ در کش تا دکمهٔ انتخاب کوتاه بماند
function tgLeadBookSlots_(chat, code, therName, l0) {
  const scope = (l0 && String(l0.region || '').indexOf('خارج') > -1) ? 'خارج از ایران' : 'داخل ایران';
  var free = tgLeadFreeFor_(therName, scope);
  if (!free.length && scope === 'داخل ایران') free = tgLeadFreeFor_(therName, 'خارج از ایران');
  if (!free.length) return tgSend_(chat, tgEsc_(therName) + ' الان وقت آزادی در اسلات‌ها ندارد. از درمانگر بخواهید وقت اعلام کند یا در تب اسلات معارفه دستی ثبت کنید.');
  free = free.slice(0, 8);
  tgSetVal_('ldbs', chat, JSON.stringify(free));
  const rows = free.map(function (s, i) {
    const utc = tgSlotUtc_(s);
    return [{ text: tgDay_(Utilities.formatDate(utc, TG_TZ, 'EEE')) + ' ' + tgJDate_(utc, TG_TZ) + ' · ' + tgFa_(s.hhmm), callback_data: 'ld:bs:' + code + ':' + i }];
  });
  rows.push([{ text: '↩️ بی‌خیال', callback_data: 'ld:back:' + code }]);
  return tgSend_(chat, '📅 وقت‌های آزاد ' + tgEsc_(therName) + ' (به وقت تهران):', { inline_keyboard: rows });
}

function tgLeadBook_(cq, me, row, code, idx) {
  const chat = cq.message.chat.id;
  const raw = tgGetVal_('ldbs', chat);
  var list = []; try { list = JSON.parse(raw || '[]'); } catch (e) {}
  const s = list[idx];
  if (!s) return tgSend_(chat, 'این وقت دیگر در دست نیست. دوباره «معارفه» را بزنید.');
  const l = tgLeadRead_(row);
  if (!l) return tgSend_(chat, 'این لید خوانده نشد.');
  const today = Utilities.formatDate(new Date(), TG_TZ, 'yyyy-MM-dd');
  const lock = tgLock_();
  if (lock && !lock.tryLock(10000)) return tgSend_(chat, 'شیت مشغول است، چند لحظه بعد دوباره بزنید.');
  try { if (lock) TG_LOCK_HELD = true;   /* v166.13: tgLeadCode_ و tgAppendLead_ قفل را رها نکنند */
    if (!TG_DRY && (tgTakenSet_()[s.therapist + '|' + s.dateIso + '|' + s.hhmm] || !tgSlotBookable_(s, true))) {
      tgDel_('ldbs', chat);
      return tgSend_(chat, 'این وقت همین الان گرفته شد. دوباره «معارفه» را بزنید.');
    }
    const note = 'رزرو از کارت لید توسط ' + me + ' ' + Utilities.formatDate(new Date(), TG_TZ, 'yyyy-MM-dd HH:mm');
    const slotRow = tgWriteSlot_(s, l.chatId || '', l.name || 'بدون نام', note, row);
    const ch = {
      'وضعیت': TG_ST.BOOKED, 'معارفه هماهنگ شد؟': 'بله', 'تاریخ معارفه': s.dateIso, 'درمانگر معارفه': s.therapist,
      'آخرین تماس': today, 'اقدام بعدی': 'یادآوری معارفه', 'تاریخ اقدام بعدی': s.dateIso
    };
    if (!l.ref1) ch['درمانگر پیشنهادی ۱'] = s.therapist;
    if (!l.owner) ch['مسئول'] = me;
    tgLeadSet_(row, ch, me, 'تلگرام', 'رزرو معارفه از کارت · ' + s.therapist + ' ' + s.dateIso + ' ' + s.hhmm);
    tgDel_('ldbs', chat);

    var notified = false;
    if (!TG_DRY) try { notified = tgNotifyTherapist_(s, l.name || 'بدون نام', l.phone, l.region || ''); } catch (eN) {}
    if (!notified && slotRow) tgFlagSlotRow_(slotRow, 'درمانگر به بات وصل نیست، پذیرش هماهنگی و لینک را انجام بدهد');

    // مراجع اگر در بات است، همان لحظه خبر و امکان لغو می‌گیرد
    if (l.chatId) {
      try {
        const info = (TG_DRY ? {} : (tgTherapistInfo_()[s.therapist] || {}));
        const utc = tgSlotUtc_(s);
        var msg = '🗓 وقت معارفهٔ شما ثبت شد ✅\n\n👤 درمانگر: <b>' + tgEsc_(s.therapist) + '</b>\n' +
          '🗓 ' + tgDay_(Utilities.formatDate(utc, TG_TZ, 'EEE')) + ' ' + tgJDateFull_(utc, TG_TZ) + '\n' +
          '🕐 ساعت ' + tgFa_(s.hhmm) + ' به وقت تهران، حدود ' + TG_MEET_MIN + ' دقیقه، آنلاین\n' +
          (info.meet ? '\n🔗 لینک جلسه:\n' + tgEsc_(info.meet) + '\n' : '\nلینک جلسه را پیش از موعد برایتان می‌فرستیم.\n') +
          '\nاگر نتوانستید بیایید، همین‌جا لغو کنید تا وقت آزاد شود.';
        tgSetVal_('meet', l.chatId, JSON.stringify({ t: s.therapist, d: s.dateIso, h: s.hhmm, row: slotRow, ev: '' }));
        tgSend_(l.chatId, msg, { inline_keyboard: [[{ text: '❌ لغو این وقت', callback_data: 'cancelmeet' }]] });
      } catch (eC) {}
    }

    // رویداد تقویم مثل خودرزرو
    if (!TG_DRY) {
      try {
        const info2 = tgTherapistInfo_()[s.therapist] || {};
        const utc2 = tgSlotUtc_(s);
        var calEv = tgCalMake_({
          title: TG_CAL_MEET_T + ' · ' + s.therapist, start: utc2,
          end: new Date(utc2.getTime() + TG_MEET_MIN * 60000),
          guests: [info2.email || ''], location: info2.meet || '',
          desc: ['مراجع: ' + (l.name || 'نامشخص'), 'درمانگر: ' + s.therapist, 'رزرو از کارت لید: ' + me, code].filter(String).join('\n')
        });
        if (calEv && calEv.id) {
          tgSlotSet_(slotRow, 'رویداد تقویم', calEv.id);
          if (l.chatId) tgSetVal_('meet', l.chatId, JSON.stringify({ t: s.therapist, d: s.dateIso, h: s.hhmm, row: slotRow, ev: calEv.id }));
        }
      } catch (eCal) { tgErr_('leadBookCal: ' + eCal); }
    }

    tgLeadCardEdit_(cq, tgLeadRead_(row));
    var moved = false;
    try { if (typeof v168AfterBook_ === 'function') moved = v168AfterBook_(chat, me, row, code, slotRow, s); } catch (eMv) { tgErr_('v168AfterBook_', eMv); }   /* v168 */
    return tgSend_(chat, (moved ? '🔁 جابه‌جا شد. ' : '') + '✅ معارفه رزرو شد: ' + tgEsc_(s.therapist) + ' · ' + tgEsc_(tgLeadJ_(s.dateIso)) + ' ساعت ' + tgFa_(s.hhmm) +
      (notified ? '\nبه درمانگر خبر رفت.' : '\n⚠️ درمانگر به بات وصل نیست؛ خودتان خبر بدهید.') +
      (l.chatId ? '\nبه مراجع هم در بات خبر رفت.' : '\nمراجع در بات نیست؛ زمان و لینک را خودتان به او بدهید.'));
  } catch (err) {
    tgErr_('tgLeadBook_: ' + err);
    return tgSend_(chat, 'در ثبت این وقت مشکلی پیش آمد: ' + tgEsc_(String(err).slice(0, 120)));
  } finally { TG_LOCK_HELD = false;
    if (lock) try { lock.releaseLock(); } catch (e2) {}
  }
}

function tgLeadCancel_(cq, me, row, code, slotRow) {
  const chat = cq.message.chat.id;
  const bk = tgLeadSlots_(code);
  var s = null;
  for (var i = 0; i < bk.length; i++) if (bk[i].row === slotRow) s = bk[i];
  if (!s) return tgSend_(chat, 'این اسلات دیگر رزروشده نیست.');
  const today = Utilities.formatDate(new Date(), TG_TZ, 'yyyy-MM-dd');
  if (!TG_DRY) {
    try {
      const sh = tgSS_().getSheetByName(TG_SLOTS);
      sh.getRange(slotRow, 6).setValue('آزاد');
      tgSlotsBust_();   /* v166.7 */
      const cur = String(sh.getRange(slotRow, 10).getValue() || '');
      sh.getRange(slotRow, 10).setValue(cur + ' · لغو توسط پذیرش (' + me + ') ' + Utilities.formatDate(new Date(), TG_TZ, 'yyyy-MM-dd HH:mm'));
      if (s.ev) try { tgCalDrop_(s.ev); } catch (eEv) {}
    } catch (e) { tgErr_('tgLeadCancel_: ' + e); }
  } else {
    TG_OUTBOX.push({ kind: 'slotfree', row: slotRow });
  }
  const l = tgLeadRead_(row);
  const ch = { 'اقدام بعدی': 'وقت تازهٔ معارفه', 'تاریخ اقدام بعدی': today };
  const others = bk.filter(function (x) { return x.row !== slotRow; });
  if (!others.length) { ch['معارفه هماهنگ شد؟'] = 'خیر'; ch['وضعیت'] = TG_ST.FOLLOW; }
  tgLeadSet_(row, ch, me, 'تلگرام', 'لغو معارفه از کارت · ' + s.therapist + ' ' + s.dateIso + ' ' + s.hhmm);
  if (!TG_DRY) try { tgNotifyTherapistCancel_({ t: s.therapist, d: s.dateIso, h: s.hhmm }); } catch (eT) {}
  const cid = s.tg || (l ? l.chatId : '');
  if (cid) {
    try {
      tgDel_('meet', cid);
      tgSend_(cid, '❌ وقت معارفهٔ ' + tgEsc_(tgLeadJ_(s.dateIso)) + ' ساعت ' + tgFa_(s.hhmm) + ' با ' + tgEsc_(s.therapist) + ' لغو شد. پذیرش برای وقت تازه با شما هماهنگ می‌کند.');
    } catch (eC) {}
  }
  tgLeadCardEdit_(cq, tgLeadRead_(row));
  return tgSend_(chat, '✅ معارفه لغو شد و وقت آزاد شد.' + (cid ? ' به مراجع خبر رفت.' : ''));
}

// متن آزاد وقتی یکی از حالت‌های کارت لید در انتظار است: یادداشت (ldn)، اقدام بعدی (ldx)، جست‌وجو (ldf)، اسم درمانگر برای رزرو (ldb)
function tgLeadText_(chat, name, uname, text) {
  const flags = ['ldn', 'ldx', 'ldf', 'ldb', 'ldsv'];   /* v168: ldsv «خدمتی که نداریم» */
  var k = '', code = '';
  for (var i = 0; i < flags.length; i++) { const v = tgGetVal_(flags[i], chat); if (v) { k = flags[i]; code = v; break; } }
  if (!k) return false;
  const t = String(text || '').trim();
  if (!t) return false;
  if (t === 'انصراف' || t === '↩️ بازگشت' || t.indexOf('/') === 0 || tgIsBtnLike_(t)) {
    tgDel_(k, chat);
    return false;
  }
  tgDel_(k, chat);
  if (k === 'ldf') { tgLeadFindSend_(chat, t); return true; }
  if (k === 'ldsv' && typeof v168ServiceText_ === 'function') { const w0 = tgWhoDesk_(chat, uname); return v168ServiceText_(chat, code, t, (w0 && w0.name) || 'پذیرش'); }
  const row = tgLeadByCode_(code);
  if (row < 2) { tgSend_(chat, 'این لید پیدا نشد.'); return true; }
  const who = tgWhoDesk_(chat, uname);
  const me = who && who.name ? who.name : 'پذیرش';
  if (k === 'ldn') {
    tgLeadNote_(row, t, me);
    tgSend_(chat, '✅ یادداشت روی ' + tgEsc_(code) + ' ثبت شد.');
    tgLeadCardSend_(chat, row);
    return true;
  }
  if (k === 'ldx') {
    tgLeadSet_(row, { 'اقدام بعدی': t.slice(0, 120) }, me, 'تلگرام', 'اقدام بعدی');
    tgSend_(chat, '📌 ثبت شد. کی؟', { inline_keyboard: [
      [{ text: 'فردا', callback_data: 'ld:nx:' + code + ':1' },
       { text: '۳ روز دیگر', callback_data: 'ld:nx:' + code + ':3' },
       { text: 'یک هفته', callback_data: 'ld:nx:' + code + ':7' }],
      [{ text: '۲ روز دیگر', callback_data: 'ld:nx:' + code + ':2' },
       { text: '↩️ کارت', callback_data: 'ld:back:' + code }]
    ] });
    return true;
  }
  if (k === 'ldb') {
    const hit = tgTherFind_(t, false) || [];
    if (!hit.length) { tgSetVal_('ldb', chat, code); tgSend_(chat, 'کسی با این اسم در تب درمانگران پیدا نشد. کامل‌تر بنویسید یا «انصراف».'); return true; }
    if (hit.length === 1) { tgLeadBookSlots_(chat, code, hit[0].name, tgLeadRead_(row)); return true; }
    const rows = [];
    for (var j = 0; j < hit.length && j < 6; j++) {
      const cb = 'ld:bt:' + code + ':' + hit[j].name;
      if (Utilities.newBlob(cb).getBytes().length <= 64) rows.push([{ text: hit[j].name, callback_data: cb }]);
    }
    rows.push([{ text: '↩️ بی‌خیال', callback_data: 'ld:back:' + code }]);
    tgSend_(chat, 'کدامشان؟', { inline_keyboard: rows });
    return true;
  }
  return false;
}

// ویس پذیرش وقتی یادداشت لید در انتظار است: متنش گرفته می‌شود و مثل یادداشت متنی ثبت می‌شود
function tgLeadVoice_(chat, m, name, uname) {
  if (!m || !m.voice || !tgGetVal_('ldn', chat)) return false;
  var txt = '';
  try {
    const f = tgTgFile_(m.voice.file_id);
    const tr = f && f.blob ? tgRmTranscribe_(f.blob.setName('note.ogg')) : null;
    txt = (tr && tr.text) ? String(tr.text).trim() : '';
  } catch (e) { txt = ''; }
  return tgLeadText_(chat, name, uname, '🎙 ' + (txt || '(ویس، متن گرفته نشد)'));
}

/* ---------- تریگر شیت: شیت به بات ---------- */

function tgOnEdit_(e) {
  var rs0 = Date.now(); try {   /* v166.18: سنجش زمان اجرا (بدنه بی‌تغییر) */
  try {
    if (TG_DRY || !e || !e.range) return;
    const sh = e.range.getSheet();
    if (sh && typeof TG_APM_TAB !== 'undefined' && sh.getName() === TG_APM_TAB) { tgApmEdited_(e); return; }   /* v162 */
    if (!sh || sh.getName() !== TG_LEADS) return;
    const row = e.range.getRow();
    const nRows = e.range.getNumRows();
    if (row < 2 || nRows > 20) return;
    const c1 = e.range.getColumn();
    const c2 = c1 + e.range.getNumColumns() - 1;
    var any = false;
    for (var c = c1; c <= c2; c++) if (TG_LEAD_WATCH[c]) { any = true; break; }
    if (!any) return;
    const single = (nRows === 1 && c1 === c2);
    const actor = (e.user && String(e.user)) || 'شیت';
    /* v166.27 (گزارش ۳.۵): نوشتن خود اسکریپت هیچ‌وقت onEdit را صدا نمی‌زند، پس هر ویرایشی که این‌جا می‌رسد کار آدم است.
       پیش از این تا ۹۰ ثانیه بعد از نوشتن بات روی یک سطر، ویرایش دستی همان سطر (مثل عوض کردن مسئول) نادیده گرفته می‌شد. */
    for (var r = row; r < row + nRows; r++) {
      tgLeadEdited_(r, c1, c2, actor, single ? e.oldValue : undefined);
    }
  } catch (err) {
    try { tgErr_('tgOnEdit_: ' + err); } catch (e2) {}
  }
  } finally { tgRunStat_('tgOnEdit_', rs0); }
}

function tgLeadEdited_(row, c1, c2, actor, oldValue) {
  const l = tgLeadRead_(row);
  if (!l || (!l.name && !l.phone)) return;
  const code = l.code || tgLeadCode_(row);
  const sh = tgSS_().getSheetByName(TG_LEADS);

  for (var c = c1; c <= c2; c++) {
    const field = TG_LEAD_WATCH[c];
    if (!field) continue;
    const now = sh.getRange(row, c).getValue();
    tgLeadEv_({
      code: code, row: row, actor: actor, channel: 'شیت',
      what: field, from: oldValue === undefined ? '' : oldValue, to: now
    });

    if (field === 'مسئول' && String(now).trim()) {
      const t = tgDeskByName_(String(now).trim());
      if (t && t.chat) {
        tgSend_(t.chat, '👥 لید ' + tgEsc_(code) + ' در شیت به شما واگذار شد.');
        tgLeadCardSend_(t.chat, row);
      }
    }

    if (field === 'وضعیت') {
      const st = String(now).trim();
      if (st) {
        const nz = tgStNorm_(st);
        var fixed = nz.st || (l.touched ? TG_ST.FOLLOW : TG_ST.NEW);
        if (nz.changed) {
          // نوشتهٔ شیت به واژگان واحد برمی‌گردد؛ مقدار قدیمی در دفتر رویداد و (اگر بستن بود) در «دلیل بستن» می‌ماند
          const chFix = { 'وضعیت': fixed };
          if (fixed === TG_ST.CLOSED && !l.reason) chFix['دلیل بستن'] = st;
          tgLeadSet_(row, chFix, 'بات', 'شیت', 'یکسان‌سازی وضعیت از «' + st + '»');
          tgLeadOwnerSay_(l, (nz.known ? 'ℹ️' : '⚠️') + ' وضعیت لید ' + tgEsc_(code) + ' در شیت «' + tgEsc_(st) + '» نوشته شد که در فهرست نیست؛ به «' + tgEsc_(fixed) + '» برگرداندم.' +
            (nz.known ? '' : '\nاگر منظور چیز دیگری بود، از فهرست ستون وضعیت انتخاب کنید.') +
            '\nوضعیت‌ها: ' + TG_LEAD_ST.join(' ← '));
        }
        if (tgStClosed_(fixed)) {
          const o = tgDeskByName_(l.owner);
          if (o && o.chat) tgSend_(o.chat, '✅ لید ' + tgEsc_(code) + ' ' + (fixed === TG_ST.START ? 'به «شروع درمان» رسید' : 'بسته شد') + (nz.changed ? ' (' + tgEsc_(st) + ')' : '') + '\nاز پیگیری‌های بات بیرون رفت.');
        }
      }
    }

    if (field === 'معارفه هماهنگ شد؟' && String(now).trim() === 'بله') {
      if (l.status !== TG_ST.BOOKED && !l.closed) tgLeadSet_(row, { 'وضعیت': TG_ST.BOOKED }, 'بات', 'شیت', 'معارفه هماهنگ شد؟ = بله');
      const thName = String(sh.getRange(row, 22).getValue() || '').trim();
      const thChat = thName ? tgTherChatByName_(thName) : '';
      if (thChat) {
        tgSend_(thChat, '🗓 یک معارفهٔ تازه برای شما هماهنگ شد.\nمراجع: ' + tgEsc_(l.name || 'بدون نام') +
                        (l.phone ? '\nشماره: ' + tgEsc_(l.phone) : '') +
                        '\nهماهنگی از راه پذیرش هم مثل قبل باز است.');
      }
    }
  }
}


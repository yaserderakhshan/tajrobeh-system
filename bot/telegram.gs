   پذیرش تأییدش نکرده روی سایت دیده نمی‌شود. هیچ اطلاعات شخصی ذخیره نمی‌شود. */

var TG_CV_TAB  = 'رأی شهر';
var TG_CV_HEAD = ['شهر', 'تعداد', 'منبع', 'وضعیت', 'آخرین رأی'];
var TG_CV_SHOW = 'نمایش';
var TG_CV_WAIT = 'بررسی';
var TG_CV_MAXROWS = 400;
var TG_CV_MAXLEN  = 24;

var TG_CV_SEED = [
  'اصفهان', 'مشهد', 'شیراز', 'تبریز', 'رشت', 'اهواز', 'کرمان', 'یزد',
  'قم', 'ساری', 'بندرعباس', 'همدان', 'ارومیه', 'کرمانشاه',
  'آلمان', 'کانادا', 'هلند', 'سوئد', 'انگلستان', 'آمریکا', 'استرالیا', 'ترکیه'
];

function tgCvTab_() { return tgInpTab_(TG_CV_TAB, TG_CV_HEAD); }

function tgCvNorm_(s) {
  return String(s || '')
    .replace(/[\u200c\u200f\u200e]/g, ' ')
    .replace(/[ي]/g, 'ی').replace(/[ك]/g, 'ک')
    .replace(/[^\u0600-\u06FF\u0020a-zA-Z]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim()
    .slice(0, TG_CV_MAXLEN);
}

function tgCvRows_() {
  var rows = [];
  try { rows = tgCvTab_().rows() || []; } catch (e) { return []; }
  var out = [];
  for (var i = 0; i < rows.length; i++) {
    var name = String(rows[i][0] || '').trim();
    if (!name) continue;
    out.push({
      row: i + 2, name: name,
      n: Number(String(rows[i][1] || '0').replace(/[^0-9]/g, '')) || 0,
      src: String(rows[i][2] || '').trim(),
      st: String(rows[i][3] || '').trim() || TG_CV_SHOW
    });
  }
  return out;
}

function tgCvSeed() {
  var t = tgCvTab_(), have = {};
  tgCvRows_().forEach(function (o) { have[tgCvNorm_(o.name)] = 1; });
  var n = 0;
  for (var i = 0; i < TG_CV_SEED.length; i++) {
    var k = tgCvNorm_(TG_CV_SEED[i]);
    if (have[k]) continue;
    t.append([TG_CV_SEED[i], 0, 'فهرست', TG_CV_SHOW, '']);
    have[k] = 1; n++;
  }
  return 'شهرهای پایه ثبت شد: ' + n;
}

function tgCvList_() {
  var rows = tgCvRows_().filter(function (o) { return o.st === TG_CV_SHOW; });
  rows.sort(function (a, b) { return b.n - a.n || (a.name < b.name ? -1 : 1); });
  var live = [];
  try {
    var plc = tgInpTab_(TG_INP_PLACES, TG_INP_PHEAD).rows() || [];
    for (var i = 0; i < plc.length; i++) {
      var city = String(plc[i][1] || '').trim();
      var st = String(plc[i][6] || '').trim();
      if (city && st === 'فعال' && live.indexOf(city) < 0) live.push(city);
    }
  } catch (e) { }
  var out = [];
  for (var j = 0; j < rows.length; j++) {
    if (live.indexOf(rows[j].name) > -1) continue;
    out.push({ city: rows[j].name, n: rows[j].n });
    if (out.length >= 24) break;
  }
  return { ok: true, live: live, votes: out, total: out.reduce(function (s, o) { return s + o.n; }, 0) };
}

/* v170.9 (امنیت): رأی شهر بی ورود است (صفحهٔ سایت)؛ سقف کل ۳۰ رأی در دقیقه تا پر کردن شیت و سهمیه ممکن نباشد */
function tgCvRate_() {
  var k = 'cvr:' + Math.floor(Date.now() / 60000), n = 0;
  if (TG_DRY) { n = (TG_MEM[k] || 0) + 1; TG_MEM[k] = n; return n <= 30; }
  try { var c = CacheService.getScriptCache(); n = Number(c.get(k) || 0) + 1; c.put(k, String(n), 120); } catch (e) { return true; }
  return n <= 30;
}
function tgCvVote_(city) {
  var when = '';
  try { if (typeof tgJDateFull_ === 'function') when = tgJDateFull_(new Date()); } catch (eW) { when = ''; }
  var name = tgCvNorm_(city);
  if (name.length < 2) return { ok: false, error: 'bad' };
  var rows = tgCvRows_(), t = tgCvTab_();
  var key = tgCvNorm_(name);
  for (var i = 0; i < rows.length; i++) {
    if (tgCvNorm_(rows[i].name) !== key) continue;
    var next = rows[i].n + 1;
    try {
      t.set(rows[i].row, 2, next);
      t.set(rows[i].row, 5, when);
    } catch (e) { return { ok: false, error: 'write' }; }
    return { ok: true, city: rows[i].name, n: next, isNew: false, shown: rows[i].st === TG_CV_SHOW };
  }
  if (rows.length >= TG_CV_MAXROWS) return { ok: false, error: 'full' };
  try {
    t.append([name, 1, 'کاربر', TG_CV_WAIT, when]);
  } catch (e2) { return { ok: false, error: 'write' }; }
  return { ok: true, city: name, n: 1, isNew: true, shown: false };
}



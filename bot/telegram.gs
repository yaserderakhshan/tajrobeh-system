  TG_DRY = true; TG_OUTBOX = []; TG_MEM = {};
  try {
    TG_DRY_THER = { name: 'درمانگر آزمایشی', row: 5 };
    var l = tgPqApiList_(800);
    ok('فهرست: درمانگر پرسش‌ها را می‌گیرد', l.ok && l.qs.length > 10 && l.qs.some(function (q) { return q.k === 'method'; }));
    ok('فهرست: سؤال دانشگاه برای درمانگر نیست', l.qs.every(function (q) { return q.k !== 'uni'; }));
    ok('فهرست: نام سوپروایزر تا «بله» پنهان است', l.qs.every(function (q) { return q.k !== 'supervisor'; }));
    ok('ذخیره: گزینهٔ نامعتبر رد می‌شود', tgPqApiSave_(800, { k: 'supervision', v: 'شاید' }).ok === false);

/* ═══════════════ پیام درمانگر به پذیرش ═══════════════ */

const TG_TK_TAB = 'پیام‌های درمانگران';
const TG_TK_HEAD = ['شمارهٔ پیگیری', 'تاریخ شمسی', 'ساعت', 'درمانگر', 'chat_id', 'موضوع', 'متن',
  'مسئول', 'وضعیت', 'پاسخ', 'تاریخ پاسخ', 'دقیقه تا پاسخ', 'اعلان بات', 'زمان ثبت'];

const TG_TK_TOPICS = [
  ['🔴 فوری — جلسهٔ امروز یا بحران', tgNm_('reception'), true, 'فوری'],
  ['🗓 وقت و برنامه', tgNm_('reception'), false, 'وقت و برنامه'],
  ['👤 دربارهٔ یک مراجع', tgNm_('desk3'), false, 'یک مراجع'],
  ['💳 مالی و تسویه', tgNm_('reception'), false, 'مالی'],
  ['🔗 لینک جلسه و مشکل فنی', tgNm_('reception'), false, 'مشکل فنی'],
  ['🌴 مرخصی و در دسترس نبودن', tgNm_('reception'), false, 'مرخصی'],
  ['💊 روان‌پزشکی و دارو', tgNm_('psy'), false, 'روان‌پزشکی و دارو'],
  ['🐞 اشکالی در بات دیدم', 'محصول', false, 'اشکالی در بات'],
  ['💡 پیشنهادی برای بهتر شدن دارم', 'محصول', false, 'پیشنهادی برای بهتر'],
  ['✳️ موضوع دیگر', tgNm_('reception'), false, 'موضوع دیگر']
];

const T_TK_PICK = 'موضوعش کدام است؟\nانتخاب موضوع فقط برای این است که پیامتان دست همان کسی برسد که کارش را انجام می‌دهد و بین بقیهٔ پیام‌ها گم نشود.';
const T_TK_WRITE = 'بفرمایید. هرچه دربارهٔ «{t}» لازم است بنویسید؛ یک پیام کافی است.';
const T_TK_SHORT = 'ببخشید، کمی بیشتر بنویسید تا بدانیم دقیقاً دربارهٔ چیست.';

function tgTkKb_() {
  const rows = [[{ text: TG_TK_TOPICS[0][0] }]];
  for (var i = 1; i < TG_TK_TOPICS.length; i += 2) {
    const r = [{ text: TG_TK_TOPICS[i][0] }];
    if (TG_TK_TOPICS[i + 1]) r.push({ text: TG_TK_TOPICS[i + 1][0] });
    rows.push(r);
  }
  rows.push([{ text: '↩️ بازگشت' }]);
  return { keyboard: rows, resize_keyboard: true };
}

function tgTkSheet_() {
  const ss = tgSS_();
  let sh = ss.getSheetByName(TG_TK_TAB);
  if (!sh) {
    sh = ss.insertSheet(TG_TK_TAB);
    sh.setRightToLeft(true);
    sh.getRange(1, 1, 1, TG_TK_HEAD.length).setValues([TG_TK_HEAD])
      .setFontWeight('bold').setBackground('#f3efec');
    sh.setFrozenRows(1);
    sh.setColumnWidth(1, 95); sh.setColumnWidth(6, 210);
    sh.setColumnWidth(7, 380); sh.setColumnWidth(10, 380);
    sh.hideColumns(5); sh.hideColumns(13);
  }
  return sh;
}

function tgTkRows_() {
  const sh = tgTkSheet_();
  const last = sh.getLastRow();
  if (last < 2) return [];
  const v = sh.getRange(2, 1, last - 1, TG_TK_HEAD.length).getValues();
  const out = [];
  for (var i = 0; i < v.length; i++) {
    const id = String(v[i][0]).trim();
    if (!id) continue;
    out.push({
      row: i + 2, id: id,
      num: Number(tgLatinDigits_(id).replace(/[^0-9]/g, '')) || 0,
      ther: String(v[i][3]).trim(), chat: String(v[i][4]).trim(),
      topic: String(v[i][5]).trim(), body: String(v[i][6]).trim(),
      owner: String(v[i][7]).trim(), status: String(v[i][8]).trim() || 'باز',
      answer: String(v[i][9]).trim(), flag: String(v[i][12]).trim(), at: v[i][13]
    });
  }
  return out;
}

function tgTkNext_() {
  const r = tgTkRows_();
  let mx = 1000;
  for (var i = 0; i < r.length; i++) if (r[i].num > mx) mx = r[i].num;
  return mx + 1;
}

function tgTkTopic_(text) {
  const t = String(text).trim();
  for (var i = 0; i < TG_TK_TOPICS.length; i++) {
    if (t === TG_TK_TOPICS[i][0] || t.indexOf(TG_TK_TOPICS[i][3]) > -1) return i;
  }
  return -1;
}

function tgTkCreate_(chat, who, ix, body) {
  const t = TG_TK_TOPICS[ix];
  const now = new Date();
  const id = 'P-' + tgTkNext_();
  const tk = { id: id, topic: t[0], owner: t[1], urgent: t[2], body: body, ther: who.name, chat: String(chat) };
  if (TG_DRY) return tk;
  tgTkSheet_().appendRow([id, tgJDateFull_(now, TG_TZ), Utilities.formatDate(now, TG_TZ, 'HH:mm'),
    who.name, String(chat), t[0], body, t[1], 'باز', '', '', '', '', now]);
  return tk;
}

function tgTkNotify_(tk) {
  const team = tgDeskRows_().filter(function (p) { return p.chat; });
  if (!team.length) return;
  const now = new Date();
  let to = team[0];
  for (var i = 0; i < team.length; i++) if (team[i].name === tk.owner) to = team[i];
  const msg = ['✉️ <b>پیام تازه از درمانگر</b>',
    '<b>' + tgEsc_(tk.ther) + '</b> · ' + tgEsc_(tk.topic),
    tgEsc_(tk.body),
    'برای پاسخ بنویسید: <code>پاسخ ' + tk.id + '</code>'].join('\n\n');
  if (tk.urgent) {
    for (var k = 0; k < team.length; k++) tgSend_(team[k].chat, '🔴 ' + msg);
    return;
  }
  if (!tgDeskOnDuty_(to, now)) return;
  tgSend_(to.chat, msg);
}

function tgTkAck_(tk) {
  const rows = ['✅ ثبت شد.',
    'شمارهٔ پیگیری: <code>' + tk.id + '</code>',
    'موضوع: ' + tgEsc_(tk.topic)];
  rows.push(tk.urgent
    ? 'همین حالا به پذیرش رسید.'
    : 'در ساعت کاری پیگیری می‌شود و پاسخ همین‌جا برایتان می‌آید.');
  return rows.join('\n');
}

function tgTkMine_(chat) {
  const rows = tgTkRows_().filter(function (t) { return t.chat === String(chat); });
  if (!rows.length) return tgSend_(chat, 'هنوز پیامی برای پذیرش نفرستاده‌اید.', tgTherMenu_());
  const last = rows.slice(-5).reverse();
  const out = ['🧾 <b>پیگیری‌های شما</b>'];
  for (var i = 0; i < last.length; i++) {
    const t = last[i];
    let s = '<code>' + t.id + '</code> · ' + tgEsc_(t.topic) + '\n' + tgEsc_(t.status);
    if (t.answer) s += '\n' + tgEsc_(t.answer);
    out.push(s);
  }
  return tgSend_(chat, out.join('\n\n'), tgTherMenu_());
}

function tgTherTk_(chat, who, text) {
  const st = tgGetVal_('tk', chat) || '';
  if (st === 'topic') {
    if (text.indexOf('بازگشت') > -1) { tgDel_('tk', chat); tgSend_(chat, T_THER_MENU, tgTherMenu_()); return true; }
    const ix = tgTkTopic_(text);
    if (ix < 0) {
      if (tgIsBtnLike_(text)) { tgDel_('tk', chat); return false; }
      tgSend_(chat, T_TK_PICK, tgTkKb_()); return true;
    }
    tgSetVal_('tk', chat, 'w' + ix);
    tgSend_(chat, T_TK_WRITE.replace('{t}', TG_TK_TOPICS[ix][0]), { remove_keyboard: true });
    return true;
  }
  if (st.indexOf('w') === 0 && st.length > 1) {
    if (text.indexOf('بازگشت') > -1) { tgDel_('tk', chat); tgSend_(chat, T_THER_MENU, tgTherMenu_()); return true; }
    if (tgIsBtnLike_(text)) { tgDel_('tk', chat); return false; }
    if (String(text).trim().length < 4) { tgSend_(chat, T_TK_SHORT); return true; }
    tgDel_('tk', chat);
    const ix3 = Number(st.slice(1));
    if (TG_TK_TOPICS[ix3][1] === 'محصول') {
      const bg = tgBugCreate_(chat, who, TG_TK_TOPICS[ix3][0], String(text).trim());
      tgSend_(chat, ['ثبت شد، ممنون که وقت گذاشتید.',
        'شمارهٔ پیگیری: <code>' + bg.id + '</code>',
        'می‌خوانیمش. اگر درست شد یا تصمیمی گرفتیم، همین‌جا خبرتان می‌کنیم.'].join('\n'), tgTherMenu_());
      return true;
    }
    const tk = tgTkCreate_(chat, who, ix3, String(text).trim());
    tgTkNotify_(tk);
    tgSend_(chat, tgTkAck_(tk), tgTherMenu_());
    return true;
  }
  if (text.indexOf('پیام به پذیرش') > -1) {
    tgSetVal_('tk', chat, 'topic');
    tgSend_(chat, T_TK_PICK, tgTkKb_());
    return true;
  }
  for (var q = 0; q < TG_TK_TOPICS.length; q++) {
    if (String(text).trim() === TG_TK_TOPICS[q][0]) {
      tgSetVal_('tk', chat, 'w' + q);
      tgSend_(chat, T_TK_WRITE.replace('{t}', TG_TK_TOPICS[q][0]), { remove_keyboard: true });
      return true;
    }
  }
  if (text.indexOf('پیگیری‌های من') > -1 || text.indexOf('پیگیری های من') > -1) { tgTkMine_(chat); return true; }
  if (text.indexOf('اطلاعیه') > -1) { tgAnnShow_(chat); return true; }
  return false;
}

function tgTkOpen_(chat, who) {
  const all = tgTkRows_().filter(function (t) { return t.status.indexOf('باز') > -1; });
  if (!all.length) { tgSend_(chat, '✉️ پیام باز از درمانگرها نداریم.', tgDeskMenu_()); return; }
  const mine = all.filter(function (t) { return t.owner === who.name; });
  const list = mine.length ? mine : all;
  const out = ['✉️ <b>پیام‌های باز درمانگران</b> · ' + tgFa_(list.length)];
  for (var i = 0; i < list.length && i < 10; i++) {
    const t = list[i];
    out.push('<code>' + t.id + '</code> · <b>' + tgEsc_(t.ther) + '</b>\n' + tgEsc_(t.topic)
      + '\n' + tgEsc_(t.body.length > 200 ? t.body.slice(0, 200) + '…' : t.body));
  }
  out.push('برای پاسخ بنویسید: <code>پاسخ ' + list[0].id + '</code>');
  tgSend_(chat, out.join('\n\n'), tgDeskMenu_());
}

function tgTkReply_(chat, id, answer) {
  const rows = tgTkRows_();
  let tk = null;
  for (var i = 0; i < rows.length; i++) if (rows[i].id.toUpperCase() === String(id).toUpperCase()) tk = rows[i];
  if (!tk) { tgSend_(chat, 'شماره‌ای با ' + tgEsc_(id) + ' پیدا نشد.', tgDeskMenu_()); return; }
  const now = new Date();
  if (!TG_DRY) {
    const sh = tgTkSheet_();
    sh.getRange(tk.row, 9).setValue('پاسخ داده شد');
    sh.getRange(tk.row, 10).setValue(answer);
    sh.getRange(tk.row, 11).setValue(tgJDateFull_(now, TG_TZ));
    if (tk.at instanceof Date) sh.getRange(tk.row, 12).setValue(Math.round((now - tk.at) / 60000));
  }
  if (tk.chat) tgSend_(tk.chat, ['💬 <b>پاسخ پذیرش</b> · <code>' + tk.id + '</code>',
    tgEsc_(tk.topic), tgEsc_(answer)].join('\n\n'), tgTherMenu_());
  tgSend_(chat, '✅ پاسخ ' + tk.id + ' فرستاده شد.', tgDeskMenu_());
}

function tgDeskTk_(chat, who, text) {
  const st = tgGetVal_('tkr', chat) || '';
  if (st) {
    if (text.indexOf('بازگشت') > -1) { tgDel_('tkr', chat); tgSend_(chat, T_DESK_MENU, tgDeskMenu_()); return true; }
    if (tgIsBtnLike_(text)) { tgDel_('tkr', chat); return false; }
    tgDel_('tkr', chat);
    tgTkReply_(chat, st, String(text).trim());
    return true;
  }
  const m = String(text).match(/پاسخ\s*[Pp]-?\s*(\d+)/);
  if (m) {
    const id = 'P-' + m[1];
    tgSetVal_('tkr', chat, id);
    tgSend_(chat, 'پاسخ <code>' + id + '</code> را بنویسید. همان‌طور که می‌نویسید برای درمانگر می‌رود.');
    return true;
  }
  if (text.indexOf('پیام‌های درمانگران') > -1 || text.indexOf('پیام های درمانگران') > -1) {
    tgTkOpen_(chat, who);
    return true;
  }
  return false;
}

function tgTkSla_() {
  const team = tgDeskRows_().filter(function (p) { return p.chat; });
  if (!team.length) return;
  const sh = tgTkSheet_();
  const rows = tgTkRows_().filter(function (t) { return t.status.indexOf('باز') > -1; });
  const now = new Date();
  const boss = team[0];
  for (var i = 0; i < rows.length; i++) {
    const t = rows[i];
    if (!(t.at instanceof Date)) continue;
    const age = Math.round((now - t.at) / 60000);
    let stage = 0;
    if (t.flag.indexOf('۲') > -1 || t.flag.indexOf('2') > -1) stage = 2;
    else if (t.flag.indexOf('۱') > -1 || t.flag.indexOf('1') > -1) stage = 1;
    if (stage >= 2) continue;
    const want = age >= TG_SLA_SECOND ? 2 : (age >= TG_SLA_FIRST ? 1 : 0);
    if (!want || want <= stage) continue;
    let to = boss;
    for (var k = 0; k < team.length; k++) if (team[k].name === t.owner) to = team[k];
    if (!tgDeskOnDuty_(to, now)) continue;
    const head = want === 2 ? '⏰ هنوز بی‌پاسخ مانده' : '🔔 یادآوری';
    tgNotify_(to.chat, TG_NK.task, [head + ' · <code>' + t.id + '</code>',
      '<b>' + tgEsc_(t.ther) + '</b> · ' + tgEsc_(t.topic), tgEsc_(t.body),
      'برای پاسخ بنویسید: <code>پاسخ ' + t.id + '</code>'].join('\n\n'), { ref: t.id });
    if (want === 2) {
      try { tgTaskFor_({ title: 'پاسخ به پیام درمانگر ' + t.id, body: tgEsc_(t.ther) + ' · ' + tgEsc_(t.topic), team: 'پذیرش', who: to.name, chat: to.chat, dueDays: 0, link: t.id, by: 'SLA' }); } catch (eT2) { tgErr_('tgTkSla_ task', eT2); }
      if (boss.chat && boss.chat !== to.chat) tgNotify_(boss.chat, TG_NK.task, '⏰ <code>' + t.id + '</code> از ' + tgEsc_(t.ther) + ' هنوز بی‌پاسخ مانده.', { ref: t.id });
    }
    sh.getRange(t.row, 13).setValue(tgFa_(String(want)));
  }
}


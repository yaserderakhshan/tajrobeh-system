function tgEvUser_(chat) {
  if (!chat) return '';
  var b = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, 'tj-ev:' + String(chat)), h = '';
  for (var i = 0; i < 5; i++) { var x = (b[i] < 0 ? b[i] + 256 : b[i]).toString(16); h += (x.length < 2 ? '0' : '') + x; }
  return h;
}
function tgEv_(surface, name, detail, chat) {
  if (TG_DRY) { TG_OUTBOX.push({ kind: 'ev', s: surface, e: String(name), d: String(detail == null ? '' : detail) }); return; }
  try {
    var now = new Date();
    var key = 'evb' + Utilities.formatDate(now, 'UTC', 'yyyyMMddHHmm');
    var c = CacheService.getScriptCache();
    var cur = c.get(key), arr = cur ? JSON.parse(cur) : [];
    if (arr.length >= 400) return;
    arr.push([now.getTime(), String(surface).slice(0, 6), String(name).slice(0, 40), String(detail == null ? '' : detail).slice(0, 60), tgEvUser_(chat)]);
    c.put(key, JSON.stringify(arr), 10800);

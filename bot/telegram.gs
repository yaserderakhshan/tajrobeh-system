              callback_data: 'pr:sh:' + r.row + ':' + tgPrH_(v.id) }];
  });
  return tgSend_(chat, '🪪 <b>صف بازبینی پروفایل</b> · ' + tgFa_(q.length) + ' نفر\nروی هر اسم بزن تا کارت سایتش را ببینی.', { inline_keyboard: rows });
}

/* خبر به ناظر: یک بار برای هر پاسخ تازه */
function tgPrNotify_(id, note) {
  var rec = tgPqRec_(id, false);
  if (!rec) return;
  var v = rec.v, st = String(tgPrStamp_(v));
  v.roles = tgPrRoles_(v);
  if (!tgPrNeeds_(v) || String(v.notified || '') === st) return;
  var ids = TG_DRY ? (TG_MEM['watch'] || []) : tgWatchIds_();
  var kb = { inline_keyboard: [[{ text: '🔎 بازبینی', callback_data: 'pr:sh:' + rec.row + ':' + tgPrH_(id) }]] };
  var text = note || ('🪪 <b>پروفایل تازه</b> · ' + tgEsc_(v.name) + ' · ' + tgFa_(v.pct || tgPqPct_(v, v.roles || 'T')) + '٪\nپاسخ تازه داده و منتظر بازبینی توست.');
  for (var i = 0; i < ids.length; i++) tgSend_(ids[i], text, kb);
  tgPqPut_(id, { notified: st });
}

/* ساعتی: کسی که وسط کار رها کرده هم بعد از نیم ساعت به صف خبر داده می‌شود */
function tgPrTick_() {
  var q = tgPrQueue_(), now = Date.now(), fresh = [];
  for (var i = 0; i < q.length; i++) {
    var v = q[i].v, st = tgPrStamp_(v);
    if (String(v.notified || '') === String(st)) continue;
    if (st > 1 && now - st < 30 * 60 * 1000) continue;
    fresh.push(q[i]);
  }
  if (!fresh.length) return 0;
  var ids = TG_DRY ? (TG_MEM['watch'] || []) : tgWatchIds_();
  var rows = fresh.slice(0, 12).map(function (r) { return [{ text: '🔎 ' + tgPrCut_(r.v.name, 28), callback_data: 'pr:sh:' + r.row + ':' + tgPrH_(r.v.id) }]; });
  for (var j = 0; j < ids.length; j++)
    tgSend_(ids[j], '🪪 ' + tgFa_(fresh.length) + ' پروفایل تازه منتظر بازبینی است.', { inline_keyboard: rows });
  fresh.forEach(function (r) { tgPqPut_(r.v.id, { notified: String(tgPrStamp_(r.v)) }); });
  return fresh.length;
}

/* ───── عکس و قاب ───── */
function tgPrCrop_(v) {
  var c = String(v.crop || '').split(',').map(Number);
  return c.length === 3 && c.every(function (x) { return x > 0 && x <= 1.2; }) ? { x: c[0], y: c[1], z: c[2] } : null;
}

/* ============ v100 · عکس‌های HEIC ============
   آیفون عکس‌ها را HEIC می‌فرستد. اگر کسی عکس را به‌شکل «فایل» بفرستد،
   تلگرام آن را تبدیل نمی‌کند و ایمج‌مجیکِ سایت با خطای
   «not an image ... IsHEIFSuccess» رد می‌کند. اینجا پیش از فرستادن،
   شکل واقعی فایل از روی بایت‌های اولش خوانده می‌شود و اگر JPEG/PNG/WebP
   نبود، از راه تامنیل گوگل‌درایو به JPEG تبدیل می‌شود. */

var TG_IMG_ERR = '';

function tgImgKind_(bytes) {
  if (!bytes) return '';
  if (bytes.length < 16) return '';
  function s(o, n) {
    var r = '';
    for (var i = 0; i < n; i++) r += String.fromCharCode(bytes[o + i] & 255);
    return r;
  }
  if ((bytes[0] & 255) === 0xFF) { if ((bytes[1] & 255) === 0xD8) return 'jpeg'; }
  if (s(1, 3) === 'PNG') return 'png';
  if (s(0, 4) === 'RIFF') { if (s(8, 4) === 'WEBP') return 'webp'; }
  if (s(0, 3) === 'GIF') return 'gif';
  if (s(4, 4) === 'ftyp') {
    var br = s(8, 4);
    if (br.indexOf('hei') === 0) return 'heic';
    if (br.indexOf('hev') === 0) return 'heic';
    if (br.indexOf('mif') === 0) return 'heic';
    if (br.indexOf('msf') === 0) return 'heic';
    if (br.indexOf('avi') === 0) return 'avif';
    return 'video';
  }
  return '';
}

/* HEIC/AVIF را با تامنیل درایو به JPEG می‌کند. اگر نشد، همان بلاب اول
   را برمی‌گرداند تا رفتار از این بدتر نشود، و دلیل را در TG_IMG_ERR
   می‌گذارد تا پیام آدمیزادی به مسئول داده شود. */
function tgImgJpeg_(x) {
  TG_IMG_ERR = '';
  if (!x) return x;
  /* tgTgFile_ یک پوشه برمی‌گرداند: {blob:…}. هم پوشه را می‌پذیریم هم خود بلاب. */
  var wrap = null, blob = x;
  if (!x.getBytes) {
    if (!x.blob) return x;
    wrap = x; blob = x.blob;
  }
  var kind = '';
  try { kind = tgImgKind_(blob.getBytes()); } catch (e0) { return x; }
  if (kind === 'jpeg') return x;
  if (kind === 'png') return x;
  if (kind === 'webp') return x;
  if (kind === 'gif') return x;
  if (kind === 'video') { TG_IMG_ERR = 'video'; return x; }

  var f = null;
  try {
    f = DriveApp.createFile(blob.setName('tj-conv-' + Date.now()));
    var tok = ScriptApp.getOAuthToken();
    for (var a = 0; a < 4; a++) {
      Utilities.sleep(a === 0 ? 1200 : 1800);
      var res = UrlFetchApp.fetch(
        'https://drive.google.com/thumbnail?id=' + f.getId() + '&sz=w1400',
        { muteHttpExceptions: true, followRedirects: true, headers: { Authorization: 'Bearer ' + tok } }
      );
      if (res.getResponseCode() !== 200) continue;
      var out = res.getBlob();
      if (tgImgKind_(out.getBytes()) !== 'jpeg') continue;
      out.setName('photo.jpg');
      out.setContentType('image/jpeg');
      if (wrap) { wrap.blob = out; return wrap; }
      return out;
    }
    TG_IMG_ERR = kind ? kind : 'unknown';
  } catch (e) {
    TG_IMG_ERR = kind ? kind : 'unknown';
    tgErr_('tgImgJpeg_: ' + e);
  } finally {
    try { if (f) f.setTrashed(true); } catch (e2) {}
  }
  return x;
}

/* متن راهنمای آدمیزادی برای وقتی عکس تبدیل نشد */
function tgImgErrText_() {
  if (!TG_IMG_ERR) return '';
  if (TG_IMG_ERR === 'video') return 'فایلی که فرستاده شده عکس نیست. لطفاً یک عکس بفرستید.';
  return 'عکس ایشان از نوع HEIC است (عکس‌های آیفون) و سایت آن را نمی‌پذیرد.\n' +
    'راه ساده: از ایشان بخواهید همان عکس را این بار به‌جای «فایل»، به‌شکل عکس بفرستند؛ تلگرام خودش JPG می‌کند.\n' +
    'یا در آیفون: تنظیمات ← دوربین ← فرمت‌ها ← «سازگارترین».';
}

function tgPrPhotoB64_(fid) {
  if (TG_DRY) return 'AAAA';
  return Utilities.base64Encode(tgImgJpeg_(tgTgFile_(fid)).blob.getBytes());
}

function tgPrSendPhoto_(chat, b64, caption, kb, msgId) {
  if (TG_DRY) { TG_OUTBOX.push({ kind: 'msg', chat: String(chat), text: '[photo] ' + caption, markup: kb, edit: msgId || 0 }); return 0; }
  var token = PropertiesService.getScriptProperties().getProperty('TELEGRAM_TOKEN');
  var api = 'https://api.telegram.org/bot' + token + '/';
  var blob = Utilities.newBlob(Utilities.base64Decode(b64), 'image/jpeg', 'card.jpg');
  if (msgId) {
    var res = UrlFetchApp.fetch(api + 'editMessageMedia', { method: 'post', muteHttpExceptions: true, payload: {
      chat_id: String(chat), message_id: String(msgId), reply_markup: JSON.stringify(kb), p: blob,
      media: JSON.stringify({ type: 'photo', media: 'attach://p', caption: caption, parse_mode: 'HTML' }) } });
    if (res.getResponseCode() === 200) return msgId;
  }
  var r2 = UrlFetchApp.fetch(api + 'sendPhoto', { method: 'post', muteHttpExceptions: true, payload: {
    chat_id: String(chat), photo: blob, caption: caption, parse_mode: 'HTML', reply_markup: JSON.stringify(kb) } });
  try { return JSON.parse(r2.getContentText()).result.message_id; } catch (e) { return 0; }
}

function tgPrPhotoKb_(row, h) {
  var s = ':' + row + ':' + h;
  return { inline_keyboard: [
    [{ text: '⬆️ قاب بالا', callback_data: 'pr:cu' + s }, { text: '⬇️ قاب پایین', callback_data: 'pr:cd' + s }],
    [{ text: '➡️ قاب راست', callback_data: 'pr:cr' + s }, { text: '⬅️ قاب چپ', callback_data: 'pr:cl' + s }],
    [{ text: '🔍 نزدیک‌تر', callback_data: 'pr:zi' + s }, { text: '🔭 دورتر', callback_data: 'pr:zo' + s }],
    [{ text: '✅ همین خوب است', callback_data: 'pr:sh' + s }]
  ] };
}

function tgPrPhoto_(chat, r, msgId, move) {
  var p = tgPrPlan_(r);
  if (!p.fid) return tgSend_(chat, 'عکسی از این نفر در بات نیست.');
  var c = tgPrCrop_(r.v) || null;
  if (move && c) {
    if (move === 'cu') c.y -= 0.04; if (move === 'cd') c.y += 0.04;
    if (move === 'cl') c.x -= 0.04; if (move === 'cr') c.x += 0.04;
    if (move === 'zi') c.z -= 0.08; if (move === 'zo') c.z += 0.08;
    c.x = Math.max(0, Math.min(1, c.x)); c.y = Math.max(0, Math.min(1, c.y)); c.z = Math.max(0.3, Math.min(1, c.z));
  }
  var res;
  try { res = tgDir_('preview', { kind: p.kind, photo: tgPrPhotoB64_(p.fid), crop: c || {} }); }
  catch (e) { return tgSend_(chat, 'پیش‌نمایش عکس نشد: ' + tgEsc_(String(e.message || e))); }
  var used = c || res.crop;
  if (used) tgPqPut_(r.v.id, { crop: [used.x, used.y, used.z].map(function (x) { return Math.round(x * 1000) / 1000; }).join(',') });
  return tgPrSendPhoto_(chat, res.jpg || 'AAAA', '🖼 قاب عکس کارت · ' + tgEsc_(p.name) + '\nبا دکمه‌ها جابه‌جا کن؛ همین قاب روی سایت می‌رود.',
                        tgPrPhotoKb_(r.row, p.h), msgId);
}

/* ───── انتشار ───── */
function tgPrWho_(chat) {
  try { var p = tgWhoPerson_(chat, ''); if (p && p.name) return p.name.split(' ')[0]; } catch (e) {}
  return 'ناظر';
}

/* v170.23.2: نشانگر خطای اسنیپت 504064 ← متن روشن برای ناظر */
function tgPrErrText_(e) {
  var x = String(e || '');
  if (/marker missing|anchor not found/.test(x)) return 'نشانگر دایرکتوری در این برگه نیست (برگه بازطراحی شده و نشانگر نمانده)';
  if (/no team page/.test(x)) return 'صفحهٔ تیم این نفر هنوز ساخته نشده؛ کارت بی‌لینک گذاشته نشد';
  if (/no photo/.test(x)) return 'برای کارت تازه عکس نیست';
  if (/no sp/.test(x)) return 'برای کارت تازه خط رویکرد نیست';
  if (/save verify failed/.test(x)) return 'برگه همان لحظه عوض شده بود؛ ذخیره برگشت خورد';
  return x;
}
/* opts: {quiet: پیام به خود عضو نه، keepPage: صفحهٔ شخصی موجود دوباره فرستاده نشود (بازنشر جامانده‌ها)} */
function tgPrPublish_(chat, r, opts) {
  opts = opts || {};
  var p = tgPrPlan_(r), v = r.v;
  if (p.blocked) return tgSend_(chat, '⛔ برای ' + tgEsc_(v.name) + ' تصمیم تیم «روی سایت نمی‌رود» است. چیزی منتشر نشد.');
  if (!p.canPublish) {
    if (p.siteErr && !opts.dry) splNote_(r, opts, 'شکست', '', 'سایت جواب نداد: ' + p.siteErr);   /* v170.23.3: نتیجه در هاب و صف تلاش دوباره */
    if (opts.quiet) return { ok: false, errs: [], pageErr: p.siteErr || 'چیزی برای انتشار نیست', name: p.name };
    return tgSend_(chat, 'چیزی برای انتشار نیست' + (p.siteErr ? ': ' + tgEsc_(p.siteErr) : '') + '.');
  }
  var b64 = '';
  if (p.fid) {
    try { b64 = tgPrPhotoB64_(p.fid); } catch (e) {
      if (!opts.dry) splNote_(r, opts, 'شکست', '', 'عکس از تلگرام گرفته نشد: ' + String(e.message || e));
      if (opts.quiet) return { ok: false, errs: [], pageErr: 'عکس از تلگرام گرفته نشد', name: p.name };
      return tgSend_(chat, 'عکس از تلگرام گرفته نشد: ' + tgEsc_(String(e.message || e)));
    }
  }
  var res = { pages: [], errors: [] };
  /* v170.23.2: اول صفحهٔ شخصی (کارت تازهٔ صفحهٔ اصلی لینک /team/ لازم دارد)، بعد کارت */
  var page = '', pageErr = '', put = {}, hadPage = String(v.page || '').trim();
  if (p.pageOk && !opts.dry && !(opts.keepPage && hadPage)) {
    try { var pg = tgPrPage_(p, b64); page = pg.url; put = pg.put; } catch (e) { pageErr = String(e.message || e); }
  } else if ((opts.keepPage || opts.dry) && hadPage) page = hadPage;
  if (p.card) {
    var f = { sp: p.sp, city: p.isT ? p.city : '' };
    if (v.site_name) f.name = v.site_name;
    if (v.site_tags || p.create) f.tags = p.tags;
    if (p.create) f.school = p.school ? 1 : 0;
    var data = { names: [v.name, p.name].concat(v.site_name ? [v.site_name] : []), display: p.name, kind: p.kind, f: f,
                 create: p.create, slug: 'm' + p.h, crop: tgPrCrop_(v) || {}, supc_photo: p.isES ? 1 : 0, supc_sp: (p.isES && !p.isT && v.site_sp) ? 1 : 0 };
    if (b64) data.photo = b64;
    if (page || hadPage) data.team = page || hadPage;
    if (opts.dry) data.dry = 1;
    try { res = tgDir_('publish', data); } catch (e) {
      if (!opts.dry) splNote_(r, opts, 'شکست', page ? 'صفحهٔ تیم' : '', 'سایت: ' + String(e.message || e));
      if (opts.quiet) return { ok: false, errs: [], pageErr: String(e.message || e), name: p.name };
      return tgSend_(chat, '❌ انتشار نشد: ' + tgEsc_(String(e.message || e)));
    }
  }
  if (opts.dry) return res;
  var pages = res.pages || [], errs = res.errors || [];
  var labels = { photo: 'عکس', sp: 'رویکرد', city: 'شهر', name: 'نام', tags: 'تگ‌ها', 'new': 'کارت تازه' };
  var lines = pages.filter(function (x) { return x.saved; }).map(function (x) {
    var d = [];
    (x.changes || []).forEach(function (c) { (c.done || []).forEach(function (k) { if (d.indexOf(labels[k] || k) < 0) d.push(labels[k] || k); }); });
    return '• <a href="' + tgEsc_(x.url) + '">' + tgEsc_(x.title) + '</a>: ' + d.join('، ');
  });
  var ok = (lines.length > 0 || !!page) && !errs.length && !pageErr;
  var onsite = pages.filter(function (x) { return x.saved; }).map(function (x) { return x.title; }).join('، ');
  tgPqPut_(v.id, Object.assign({ review: tgPqNow_() + ' · ' + tgPrWho_(chat), rstamp: String(Date.now()), notified: String(tgPrStamp_(v)),
                   status: ok ? 'روی سایت' : 'منتشر نشد', onsite: onsite || String(v.onsite || ''), basis: String(v.basis || '').trim() || tgPrBasis_() }, put));
  if (lines.length && p.isT && !TG_DRY) {
    try {
      var sh = tgSS_().getSheetByName(TG_THER), tr = tgTherRow_(v.name);
      if (tr) sh.getRange(tr, tgTherCol_('عکس در سایت')).setValue('هست');
    } catch (e) { tgErr_('AK: ' + e); }
  }
  /* v170.23.2: هر برگه‌ای که ماند، با نامش و دلیل روشن؛ بقیه که نشستند همان بالا */
  var pgName = function (id) { return Number(id) === TG_PR_HOME ? 'صفحهٔ اصلی' : (Number(id) === 294 ? 'صفحهٔ مدرسه' : 'برگهٔ ' + id); };
  var errLines = errs.map(function (e) { return '• 🏚 ' + pgName(e.page) + ' ماند: ' + tgEsc_(tgPrErrText_(e.error)); });
  var msg = (ok ? '✅ <b>روی سایت نشست</b> · ' : '⚠️ <b>انتشار کامل نشد</b> · ') + tgEsc_(p.name) + '\n' +
            (lines.length ? lines.join('\n') : (p.card ? 'کارت‌ها همان بود که هست.' : 'کارت سایت ندارد.')) +
            (page ? '\n🌐 صفحهٔ شخصی: <a href="' + tgEsc_(page) + '">' + tgEsc_(tgPrUrl_(page)) + '</a>' : '') +
            (pageErr ? '\n\nصفحهٔ شخصی ساخته نشد: ' + tgEsc_(pageErr) : '') +
            (errLines.length ? '\n\n' + errLines.join('\n') : '');
  var nkb = [[{ text: '⏭ پروفایل بعدی', callback_data: 'pr:nx:' + r.row + ':' + p.h }]];
  if (errs.length || pageErr) nkb.unshift([{ text: '🔁 دوباره امتحان کن', callback_data: 'pr:rt:' + r.row + ':' + p.h }]);
  /* v170.23.3: نتیجه در هاب (موفق، نیمه، شکست) با برگه‌ها و دلیل؛ نیمه و شکست به صف تلاش دوباره */
  var savedT = pages.filter(function (x) { return x.saved; }).map(function (x) { return pgName(x.page); }).concat(page ? ['صفحهٔ تیم'] : []);
  var why = errs.map(function (e) { return pgName(e.page) + ': ' + tgPrErrText_(e.error); }).concat(pageErr ? ['صفحهٔ تیم: ' + pageErr] : []).join(' · ');
  splNote_(r, opts, ok ? 'موفق' : (savedT.length ? 'نیمه' : 'شکست'), savedT.join('، '), why);
  if (opts.quiet) return { res: res, ok: ok, errs: errs, page: page, pageErr: pageErr, name: p.name };
  if (page) nkb.unshift([{ text: '🌐 دیدن صفحهٔ ' + tgPrCut_(p.name, 24), url: page }]);
  tgSend_(chat, msg, { inline_keyboard: nkb });
  if (ok && v.chat) {
    try {

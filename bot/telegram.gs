var AL_INP_FA = 'آ ا ب پ ت ث ج چ ح خ د ذ ر ز ژ س ش ص ض ط ظ ع غ ف ق ک گ ل م ن و ه ی'.split(' ');
function tgInpFaKey_(w) { return String(w || '').replace(/^دکتر\s+/, '').split('').map(function (c) { var i = AL_INP_FA.indexOf(c); return String.fromCharCode(200 + (i > -1 ? i : 60)); }).join(''); }

/* متن پیام بررسی از روی خود هاب ساخته می‌شود؛ پس هرچه تأیید شود همان است که بات نشان می‌دهد */
function tgInpCheckText_(pid, d) {
  d = d || tgInpData_();
  var p = null; d.places.forEach(function (x) { if (x.id === pid) p = x; });
  var hrs = d.hours.filter(function (h) { return h.p === pid && h.day; });
  var by = {}, order = [];
  hrs.slice().sort(function (a, b) { return (TG_INP_DAYS.indexOf(a.day) - TG_INP_DAYS.indexOf(b.day)) || ((tgInpH_(a.from) || 99) - (tgInpH_(b.from) || 99)); })
    .forEach(function (h) { if (!by[h.who]) { by[h.who] = []; order.push(h.who); } by[h.who].push(h); });
  order.sort(function (a, b) { var x = tgInpFaKey_(a), y = tgInpFaKey_(b); return x < y ? -1 : x > y ? 1 : 0; });
  var unknown = [];

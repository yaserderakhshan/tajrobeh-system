    else sh.appendRow([String(chat), name, uname, keys.join(','), 'فعال', new Date(), '']);
  }
  return { ok: true, on: true, mine: keys };
}
/* tgApiMe_ به انتهای فایل منتقل شد (v97) و حالا نقش‌ها و اتصال‌ها را هم برمی‌گرداند */

function tgApiBook_(p) {
  const user = tgVerifyInitData_(p.initData);
  if (!user || !user.id) return { ok: false, error: 'auth' };
  const chat  = user.id;
  const scope = (String(p.scope || 'ir') === 'ir') ? 'داخل ایران' : 'خارج از ایران';
  const zone  = tgZoneOf_(String(p.zone || (scope === 'داخل ایران' ? 'ir' : 'de')));
  const s = { therapist: String(p.therapist || ''), dateIso: String(p.dateIso || ''), hhmm: String(p.hhmm || ''), weekly: true };
  if (!s.therapist || !s.dateIso || !s.hhmm) return { ok: false, error: 'bad' };

  const lock = TG_DRY ? null : LockService.getScriptLock();   /* v166.24: تست خشک منتظر قفل بات زنده نمی‌ماند */
  if (lock && !lock.tryLock(10000)) return { ok: false, error: 'busy' };
  try { if (lock) TG_LOCK_HELD = true;   /* v166.13: tgLeadCode_ و tgAppendLead_ قفل را رها نکنند */
    if ((TG_DRY && tgTakenSet_()[s.therapist + '|' + s.dateIso + '|' + s.hhmm]) || !tgSlotBookable_(s)) return { ok: false, error: 'taken' };
    tgSetVal_('tz', chat, zone.key);
    const name = [user.first_name, user.last_name].filter(String).join(' ').trim() || 'بدون نام';

    let lead = tgLeadInfo_(chat);
    if (!lead || lead.name === 'نامشخص') {
      tgAppendLead_({
        source: 'Telegram mini app', name: name, channel: 'تلگرام',
        phone: p.phone ? String(p.phone) : (user.username ? '@' + user.username : String(chat)),
        region: scope,
        firstText: 'رزرو معارفه از مینی‌اپ' + (p.topic ? ' · موضوع: ' + p.topic : ''),
        status: 'جدید', kind: p.kind || '', topic: p.topic || '',
        note: 'chat_id: ' + chat + (user.username ? ' · @' + user.username : '')
      });
      lead = { name: name, phone: '' };
    }

    const stamp = Utilities.formatDate(new Date(), TG_TZ, 'yyyy-MM-dd HH:mm');
    const leadRow0 = tgWriteBooking_(chat, s, lead.name);
    const row = tgWriteSlot_(s, chat, lead.name, 'خودرزرو از مینی‌اپ ' + stamp, leadRow0);
    tgSetVal_('meet', chat, JSON.stringify({ t: s.therapist, d: s.dateIso, h: s.hhmm, row: row }));

    if (!tgNotifyTherapist_(s, lead.name, lead.phone, zone.label || '')) {
      tgFlagSlotRow_(row, 'درمانگر به بات وصل نیست، پذیرش لینک و هماهنگی را انجام بدهد');
      try { tgDeskSay_('🗓 ' + tgEsc_(s.therapist) + ' به بات وصل نیست. معارفهٔ ' + tgEsc_(s.dateIso) + ' ساعت ' + tgEsc_(s.hhmm) + ' را پذیرش با درمانگر هماهنگ کند.'); } catch (eD) {}   /* v166.27 */
    }

    const info = tgTherapistInfo_()[s.therapist] || {};
    const utc = tgSlotUtc_(s);
    tgSend_(chat,
      'رزرو شد ✅\n\n👤 درمانگر شما: <b>' + tgEsc_(s.therapist) + '</b>\n' +
      (tgAbout_(info) ? tgEsc_(tgAbout_(info)) + '\n' : '') +
      '\n🗓 ' + tgDay_(Utilities.formatDate(utc, zone.tz, 'EEE')) + ' ' +
      tgDateFor_(utc, zone, true) + '\n' +
      '🕐 ساعت ' + tgFa_(Utilities.formatDate(utc, zone.tz, 'HH:mm')) + ' به وقت شما\n' +
      '⏱ حدود ' + TG_MEET_MIN + ' دقیقه، آنلاین\n\n' +
      (info.meet ? '🔗 لینک جلسه:\n' + tgEsc_(info.meet) : 'لینک جلسه را پیش از موعد پذیرش برایتان می‌فرستد.'),
      { inline_keyboard: [[{ text: '❌ لغو این وقت', callback_data: 'cancelmeet' }]] });

    return { ok: true, therapist: s.therapist, about: tgAbout_(info), meet: info.meet || '',
             dateIso: s.dateIso, hhmm: s.hhmm,
             day: tgDay_(Utilities.formatDate(utc, zone.tz, 'EEE')),
             date: tgDateFor_(utc, zone),
             time: Utilities.formatDate(utc, zone.tz, 'HH:mm') };
  } finally { TG_LOCK_HELD = false;
    if (lock) lock.releaseLock();
  }
}

const TG_JMONTHS = ['فروردین','اردیبهشت','خرداد','تیر','مرداد','شهریور','مهر','آبان','آذر','دی','بهمن','اسفند'];

// تبدیل میلادی به شمسی. اپس‌اسکریپت تقویم شمسی ندارد و بدون این، تاریخ‌ها انگلیسی نشان داده می‌شوند.
function tgJalali_(d, tz) {
  const gy = Number(Utilities.formatDate(d, tz, 'yyyy'));
  const gm = Number(Utilities.formatDate(d, tz, 'MM'));
  const gd = Number(Utilities.formatDate(d, tz, 'dd'));
  const gdm = [0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334];
  const gy2 = gy - 1600, gm2 = gm - 1, gd2 = gd - 1;
  let days = 365 * gy2 + Math.floor((gy2 + 3) / 4) - Math.floor((gy2 + 99) / 100) + Math.floor((gy2 + 399) / 400);
  days += gdm[gm2] + gd2;
  if (gm2 > 1 && ((gy % 4 === 0 && gy % 100 !== 0) || gy % 400 === 0)) days++;
  let jdn = days - 79;
  const np = Math.floor(jdn / 12053);
  jdn = jdn % 12053;
  let jy = 979 + 33 * np + 4 * Math.floor(jdn / 1461);
  jdn %= 1461;
  if (jdn >= 366) { jy += Math.floor((jdn - 1) / 365); jdn = (jdn - 1) % 365; }
  const jdm = [31, 31, 31, 31, 31, 31, 30, 30, 30, 30, 30, 29];
  let i = 0;
  for (i = 0; i < 11 && jdn >= jdm[i]; i++) jdn -= jdm[i];
  return { y: jy, m: i + 1, d: jdn + 1 };
}

/* ماه‌های میلادی به فارسی — برای مراجعی که ایران نیست */
const TG_GMONTHS = ['ژانویه', 'فوریه', 'مارس', 'آوریل', 'مه', 'ژوئن',
                    'ژوئیه', 'اوت', 'سپتامبر', 'اکتبر', 'نوامبر', 'دسامبر'];

function tgGDate_(d, tz, full) {
  const day = Utilities.formatDate(d, tz, 'd');
  const mon = Number(Utilities.formatDate(d, tz, 'M'));
  const out = tgFa_(day) + ' ' + TG_GMONTHS[mon - 1];
  return full ? out + ' ' + tgFa_(Utilities.formatDate(d, tz, 'yyyy')) : out;
}

/* تاریخ برای مراجع: همیشه شمسی. اگر ایران نیست، میلادی هم در پرانتز.
   درمانگر و پذیرش و هاب همیشه شمسی می‌بینند.                        */
function tgDateFor_(d, z, full) {
  const tz = (z && z.tz) || TG_TZ;
  const j = full ? tgJDateFull_(d, tz) : tgJDate_(d, tz);
  if (tz === TG_TZ) return j;
  return j + ' (' + tgGDate_(d, tz, full) + ')';
}

function tgJDate_(d, tz) {
  const j = tgJalali_(d, tz);
  return tgFa_(j.d) + ' ' + TG_JMONTHS[j.m - 1];
}

function tgJDateFull_(d, tz) {
  const j = tgJalali_(d, tz);
  return tgFa_(j.d) + ' ' + TG_JMONTHS[j.m - 1] + ' ' + tgFa_(j.y);
}

// معرفی پیش‌نویس هیچ‌وقت به مراجع نشان داده نمی‌شود
function tgAbout_(t) {
  const a = ((t || {}).about || '').trim();
  if (!a) return '';
  if (a.indexOf('پیش‌نویس') > -1 || a.indexOf('پیش نویس') > -1 || a.indexOf('lorem') > -1) return '';
  return a;
}


// سطرهای بی‌نام و بی‌شماره را از Sheet1 پاک می‌کند (پینگ و فراخوانی اشتباه)
function tgCleanBlankLeads() {
  const sh = tgSS_().getSheetByName(TG_LEADS);
  const last = sh.getLastRow();
  if (last < 2) return;
  const v = sh.getRange(2, 1, last - 1, 13).getValues();
  const kill = [];
  for (var i = 0; i < v.length; i++) {
    const name = String(v[i][3] || '').trim();
    const phone = String(v[i][5] || '').trim();
    const text = String(v[i][7] || '').trim();
    if (!name && !phone && !text) kill.push(i + 2);
  }
  for (var k = kill.length - 1; k >= 0; k--) sh.deleteRow(kill[k]);
  Logger.log(kill.length ? ('پاک شد: سطرهای ' + kill.join('، ')) : 'سطر خالی‌ای نبود.');
}

/* ---------- تست رفتار در گروه (بعد از خاموش‌کردن privacy) ---------- */

function tgGroupTests() {
  const keep = TG_DRY;
  TG_DRY = true; TG_OUTBOX = []; TG_MEM = {};

  // باید ساکت بماند
  const quiet = [
    'الهی بمیرم برات چقدر خسته‌ای',
    'بمیرم چه غم‌انگیز',
    'کسی وقت داره فردا بریم کوه؟',
    'جلسه ساعت چند شروع میشه؟',
    'قیمت دلار امروز چنده؟',
    'سلام بچه‌ها صبح بخیر',
    'کسی فیلم خوب سراغ داره؟',
    'بچه‌ام امروز مریض شد چیکار کنم؟',
    'آنلاین هستید؟'
  ];
  // ممکن است پاسخ بدهد (سؤال روشن تراپی)
  const maybe = [
    'هزینهٔ تراپی چقدره؟',
    'معارفه یعنی چی؟',
    'چطور تراپیست انتخاب کنم؟'
  ];

  let fail = 0, log = [];
  let n = 0;
  function fire(txt) {
    n++;
    TG_OUTBOX = [];
    tgHandle({
      update_id: 900000000 + n,
      message: {
        message_id: n,
        chat: { id: -1000000000 - n, type: 'supergroup' },
        from: { id: 555, first_name: 'کاربر', is_bot: false },
        text: txt
      }
    });
    return TG_OUTBOX.length;
  }

  for (var i = 0; i < quiet.length; i++) {
    const c = fire(quiet[i]);
    if (c > 0) { fail++; log.push('✗ نباید جواب می‌داد: ' + quiet[i]); }
    else log.push('✓ ساکت ماند: ' + quiet[i]);
  }
  for (var j = 0; j < maybe.length; j++) {
    const c = fire(maybe[j]);
    log.push((c > 0 ? '💬 پاسخ داد: ' : '· ساکت: ') + maybe[j]);
  }

  // بحران واقعی باید پاسخ بگیرد
  const cr = fire('فکر خودکشی دارم چیکار کنم؟');
  if (!cr) { fail++; log.push('✗ بحران واقعی بی‌پاسخ ماند'); }
  else log.push('✓ بحران واقعی پاسخ گرفت');

  // بات دیگر باید نادیده گرفته شود
  TG_OUTBOX = [];
  tgHandle({ update_id: 999111222, message: { message_id: 1, chat: { id: -1234, type: 'supergroup' },
    from: { id: 7, first_name: 'Bot', is_bot: true }, text: 'هزینهٔ تراپی چقدره؟' } });
  if (TG_OUTBOX.length) { fail++; log.push('✗ به بات دیگر جواب داد'); }
  else log.push('✓ بات دیگر نادیده گرفته شد');

  TG_DRY = keep;
  Logger.log(log.join('\n') + '\n\n' + (fail ? '❌ ' + fail + ' مورد ایراد دارد' : '✅ رفتار گروه درست است'));
  return tgTestTally_(log, fail);
}


function tgHeaders() {
  const sh = tgSS_().getSheetByName(TG_THER);
  const w = sh.getLastColumn(), last = sh.getLastRow();
  const h = sh.getRange(3, 1, 1, w).getValues()[0];
  const out = [];
  for (var i = 0; i < w; i++) {
    const letter = (i < 26 ? String.fromCharCode(65 + i) : 'A' + String.fromCharCode(65 + i - 26));
    let filled = 0;
    if (last > 3) {
      const col = sh.getRange(4, i + 1, last - 3, 1).getValues();
      for (var j = 0; j < col.length; j++) if (String(col[j][0]).trim()) filled++;
    }
    out.push(letter + ' | ' + String(h[i]).trim() + ' | پرشده: ' + filled);
  }
  Logger.log('ردیف‌ها: ' + (last - 3) + '\n' + out.join('\n'));
}



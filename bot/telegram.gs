    for (var i = 0; i < ids.length; i++) {
      tgSend_(ids[i], body, { inline_keyboard: [
        [{ text: '✅ تأیید و فعال کن', callback_data: 'pn:ok:' + id }],
        [{ text: '⛔ فعلاً نه', callback_data: 'pn:no:' + id }]
      ] });
    }
  } catch (e5) { tgErr_('tgPnFinish_: ' + e5); }
  return true;
}

function tgPnSetStatus_(id, status) {
  if (TG_DRY) { TG_OUTBOX.push({ kind: 'pnstatus', id: id, status: status }); return null; }
  var ss = tgSS_(), out = null;
  var ps = ss.getSheetByName(TG_INP_PLACES);
  if (ps && ps.getLastRow() > 1) {
    var v = ps.getRange(2, 1, ps.getLastRow() - 1, TG_INP_PHEAD.length).getDisplayValues();
    for (var i = 0; i < v.length; i++) {
      if (String(v[i][0]).trim() !== String(id)) continue;
      ps.getRange(i + 2, 7).setValue(status);
      out = { name: String(v[i][2]).trim(), city: String(v[i][1]).trim() };
      break;
    }
  }
  var rs = ss.getSheetByName(TG_INP_ROOMS);
  if (rs && rs.getLastRow() > 1) {
    var rv = rs.getRange(2, 1, rs.getLastRow() - 1, TG_INP_RHEAD.length).getDisplayValues();
    for (var j = 0; j < rv.length; j++) {
      if (String(rv[j][0]).trim() === String(id)) rs.getRange(j + 2, 7).setValue(status);
    }
  }
  var pn = ss.getSheetByName(TG_PN_TAB);
  if (pn && pn.getLastRow() > 1) {
    var pv = pn.getRange(2, 1, pn.getLastRow() - 1, TG_PN_HEAD.length).getDisplayValues();
    for (var k = 0; k < pv.length; k++) {
      if (String(pv[k][0]).trim() !== String(id)) continue;
      pn.getRange(k + 2, 10).setValue(status === 'فعال' ? 'آمادهٔ انتشار' : 'در انتظار تأیید');
      if (out) out.chat = String(pv[k][7]).trim();
      break;
    }
  }
  try { CacheService.getScriptCache().remove('inpdata'); } catch (e) {}
  return out;
}

function tgOnPn_(cq, rest) {
  var chat = cq.message.chat.id;
  var uname = cq.from && cq.from.username ? '@' + cq.from.username : '';
  var p = String(rest || '').split(':');
  var act = p[0] || '', id = p.slice(1).join(':');

  if (act === 'more') {
    var d = tgPnGet_(chat);
    if (!d) return tgSend_(chat, 'این گفت‌وگو بسته شده. لینک ساخت پارتنر را دوباره باز کنید.');
    d.stage = 'room'; tgPnPut_(chat, d);
    return tgSend_(chat, 'اتاق بعدی را در یک خط بنویسید.');
  }
  if (act === 'fin') return tgPnFinish_(chat);

  var w = tgApWho_(chat, uname);
  if (!w.watch && !w.own) return tgSend_(chat, 'تأیید پارتنر با ناظر است.');

  if (act === 'ok') {
    var r = tgPnSetStatus_(id, 'فعال');
    if (r && r.chat) {
      tgSend_(r.chat, '🎉 مکان شما تأیید شد و از همین حالا در تجربه فعال است.\n' +
                      'صفحهٔ پارتنر شما در نوبت انتشار سایت است و مراجع‌ها می‌توانند برای مکان شما وقت حضوری بگیرند.');
    }
    return tgSend_(chat, '✅ پارتنر <code>' + tgEsc_(id) + '</code> فعال شد. اتاق‌هایش هم فعال شدند.');
  }
  if (act === 'no') {
    tgPnSetStatus_(id, 'بررسی');
    return tgSend_(chat, 'باشد، در حالت «بررسی» ماند.');
  }
  return null;
}


/* ═══════════ بازبینی پروفایل‌ها در خود بات و انتشار روی سایت (v57) ═══════════
   هر پاسخ پرسش‌نامهٔ پروفایل (بخش v54) زمان می‌خورد (stamp). هر سطری که stamp آن از آخرین بازبینی
   (rstamp) تازه‌تر باشد در صف بازبینی ناظر (یاسر) می‌نشیند. ناظر در همین بات کارت سایت را می‌بیند،
   نام و خط رویکرد و شهر و تگ‌ها را اصلاح می‌کند، قاب عکس را جابه‌جا می‌کند و با یک دکمه روی سایت
   منتشر می‌کند. انتشار با اسنیپت WPCode 504064 («Tajrobeh — دایرکتوری اعضا از بات») و امضای HMAC
   انجام می‌شود؛ کلید در Script Property «TG_DIR_KEY» است و هیچ‌جا نمایش داده نمی‌شود.
   فایل‌های پرسش‌نامه (عکس، رزومه، ویس) همان لحظه در درایو هم بایگانی می‌شوند:
   پوشهٔ «پروفایل اعضا · فایل‌ها» ← یک پوشه برای هر نفر؛ لینک‌ها در ستون drive. */

var TG_DIR_URL   = 'https://tajrobeh.life/wp-json/tj/v1/dir';
var TG_DIR_PAIR  = 'https://tajrobeh.life/wp-json/tj/v1/dir/pair';
var TG_PQ_DRIVE  = cfg_('TG_PQ_DRIVE', '');
var TG_PR_BTN    = '🪪 بازبینی پروفایل‌ها';
var TG_PR_HOME   = 503465;
var TG_PR_TAGS   = [['lacan', 'لکانی'], ['object', 'روابط ابژه'], ['classic', 'کلاسیک و تحلیلی'], ['modern', 'مدرن'],
                    ['cbt', 'CBT'], ['schema', 'طرحواره'], ['eft', 'EFT'], ['mbt', 'ذهنی‌سازی'], ['child', 'کودک و نوجوان'],
                    ['psy', 'روانپزشک'], ['writer', 'نویسندهٔ مجله'], ['school', 'مدرسه'], ['abroad', 'خارج از ایران']];
var TG_PR_ROLEFA = { T: 'درمانگر', E: 'استاد', S: 'سوپروایزر', D: 'دانشجو' };

/* ───── درایو ───── */
function tgTgFile_(fid) {
  if (TG_DRY) return { blob: null, path: 'photos/x.jpg', b64: 'AAAA' };
  var res = tgApi_('getFile', { file_id: fid });
  var j = JSON.parse(res.getContentText());
  if (!j.ok) throw new Error('getFile: ' + (j.description || ''));
  var token = PropertiesService.getScriptProperties().getProperty('TELEGRAM_TOKEN');
  var blob = tgFetchRetry_('https://api.telegram.org/file/bot' + token + '/' + j.result.file_path).getBlob();
  return { blob: blob, path: String(j.result.file_path || '') };
}

function tgPqFolder_(name) {
  var root = DriveApp.getFolderById(TG_PQ_DRIVE);
  var it = root.getFoldersByName(name);
  return it.hasNext() ? it.next() : root.createFolder(name);
}

/* فایل یک پاسخ را در درایو می‌گذارد و لینکش را در ستون drive می‌نویسد. لینک را برمی‌گرداند. */
function tgPqArchive_(id, name, key) {
  if (TG_DRY) return '';
  var rec = tgPqRec_(id, false);
  if (!rec) return '';
  var val = String(rec.v[key] || '');
  var m = val.match(/^tg:(photo|voice|doc):([^\s·]+)(?:\s·\s(.+))?$/);
  if (!m) return '';
  var have = String(rec.v.drive || '').split('\n');
  for (var i = 0; i < have.length; i++) if (have[i].indexOf(key + ': ') === 0 && have[i].indexOf('#' + m[2].slice(-10)) > -1) return have[i].split(': ')[1];
  var f = tgTgFile_(m[2]);
  var ext = (f.path.match(/\.[A-Za-z0-9]{2,5}$/) || [m[1] === 'photo' ? '.jpg' : m[1] === 'voice' ? '.ogg' : ''])[0];
  var label = { photo: 'عکس', resume: 'رزومه', voice: 'ویس' }[key] || key;
  var day = Utilities.formatDate(new Date(), TG_TZ, 'yyyy-MM-dd');
  var fname = name + ' · ' + label + ' · ' + day + (m[1] === 'doc' && m[3] ? ' · ' + m[3] : ext);
  var file = tgPqFolder_(name).createFile(f.blob.setName(fname));
  var url = file.getUrl() + '#' + m[2].slice(-10);
  var lines = have.filter(function (l) { return l && l.indexOf(key + ': ') !== 0; });
  lines.push(key + ': ' + url);
  tgPqPut_(id, { drive: lines.join('\n') });
  return url;
}

function tgPqArchiveSafe_(id, name, key) {
  try { tgPqArchive_(id, name, key); } catch (e) { tgErr_('tgPqArchive_ ' + name + ' ' + key + ': ' + e); }
}

/* یک بار بعد از دادن دسترسی درایو: همهٔ فایل‌های قبلی را بایگانی می‌کند */
function tgPqArchiveAll() {
  var all = tgPrAll_(), n = 0, err = 0;
  for (var i = 0; i < all.length; i++) {
    var v = all[i].v;
    ['photo', 'resume', 'voice'].forEach(function (k) {
      if (String(v[k] || '').indexOf('tg:') !== 0) return;
      try { if (tgPqArchive_(v.id, v.name, k)) n++; } catch (e) { err++; tgErr_(v.name + ' ' + k + ': ' + e); }
    });
  }
  var rep = 'بایگانی درایو: ' + n + ' فایل' + (err ? ' · خطا: ' + err : '');
  Logger.log(rep);
  return rep;
}

/* فقط برای اینکه ادیتور اسکوپ درایو را بخواهد و یاسر یک بار تأیید کند */
function tgDirAuth() {
  var f = DriveApp.getFolderById(TG_PQ_DRIVE);
  Logger.log('درایو وصل است: ' + f.getName());
  return f.getName();
}

/* ───── سایت ───── */
function tgDirSign_(ts, body, key) {
  return Utilities.computeHmacSha256Signature(ts + '.' + body, key)
    .map(function (b) { return ('0' + (b & 255).toString(16)).slice(-2); }).join('');
}

function tgDirAscii_(s) {
  return s.replace(/[\u007f-\uffff]/g, function (c) { return '\\u' + ('0000' + c.charCodeAt(0).toString(16)).slice(-4); });
}

function tgDir_(op, data) {
  data = data || {};
  data.op = op;
  if (TG_DRY) {
    TG_OUTBOX.push({ kind: 'dir', op: op, data: JSON.parse(JSON.stringify(data)) });
    var st = (TG_MEM['dirres'] || {})[op];
    return st ? JSON.parse(JSON.stringify(st)) : { ok: true, hits: [], pages: [], errors: [], media: {} };
  }
  var key = PropertiesService.getScriptProperties().getProperty('TG_DIR_KEY');
  if (!key) throw new Error('سایت هنوز با بات جفت نشده است');
  var body = tgDirAscii_(JSON.stringify(data));
  var ts = String(Math.floor(Date.now() / 1000));
  var res = UrlFetchApp.fetch(TG_DIR_URL + '?ts=' + ts + '&sig=' + tgDirSign_(ts, body, key), {
    method: 'post', contentType: 'application/json', payload: body, muteHttpExceptions: true, followRedirects: false
  });
  var code = res.getResponseCode(), txt = res.getContentText(), j = null;
  try { j = JSON.parse(txt); } catch (e) {}
  if (code !== 200 || !j) throw new Error('سایت ' + code + ': ' + ((j && j.message) || txt.slice(0, 160)));
  return j;
}

/* یک بار: اول در پیشخوان وردپرس پنجرهٔ جفت‌شدن باز شود (POST /tj/v1/dir/pair-open، پاسخ یک «code» دارد)، بعد tgDirPair('<code>').
   v170.9 (امنیت): بی کد یک‌بارمصرف مدیر، وردپرس کلید را نمی‌پذیرد (پیش از این هر کس در پنجرهٔ ده‌دقیقه‌ای زودتر می‌فرستاد، جفت می‌شد). */
function tgDirPair(code) {
  if (!code) { Logger.log('کد جفت‌شدن را از پاسخ pair-open بدهید: tgDirPair(\'<code>\')'); return false; }
  var props = PropertiesService.getScriptProperties();
  var key = (Utilities.getUuid() + Utilities.getUuid() + Utilities.getUuid()).replace(/-/g, '');
  var res = UrlFetchApp.fetch(TG_DIR_PAIR, { method: 'post', contentType: 'application/json',
    payload: JSON.stringify({ key: key, code: String(code) }), muteHttpExceptions: true });
  if (res.getResponseCode() !== 200) { Logger.log('جفت نشد: ' + res.getResponseCode() + ' ' + res.getContentText().slice(0, 200)); return false; }
  props.setProperty('TG_DIR_KEY', key);
  var ping = tgDir_('ping', {});
  Logger.log('جفت شد ✅ · ' + JSON.stringify(ping));
  return true;
}

/* ───── دادهٔ صف ───── */
function tgPrAll_() {
  if (TG_DRY) {
    var m = TG_MEM['pqrows'] || {};
    return Object.keys(m).map(function (id, i) { m[id].roles = tgPrRoles_(m[id]); return { row: i + 3, v: m[id] }; });
  }
  var sh = tgPqSheet_(), lc = sh.getLastColumn(), last = sh.getLastRow();
  if (last < 3) return [];
  var keys = sh.getRange(2, 1, 1, lc).getValues()[0].map(String);
  var vals = sh.getRange(3, 1, last - 2, lc).getValues();
  return vals.map(function (r, i) {
    var o = {};
    for (var j = 0; j < lc; j++) if (keys[j]) o[keys[j]] = r[j] === '' ? '' : String(r[j]);
    o.roles = tgPrRoles_(o);
    return { row: i + 3, v: o };
  });
}

/* دعوت‌شده‌ها سطرشان پیش از ورود ساخته شده و ستون نقش خالی مانده؛ نقش از شناسه یا تب افراد درمی‌آید */
function tgPrRoles_(v) {
  var r = String(v.roles || '').trim();
  if (r) return r;
  if (String(v.id || '').indexOf('ther:') === 0) return 'T';
  try {
    var list = TG_DRY ? (TG_MEM['people'] || []) : tgPeopleList_();
    for (var i = 0; i < list.length; i++) {
      if (tgNorm_(list[i].name) !== tgNorm_(v.name)) continue;
      var ro = list[i].roles || [], o = '';
      if (ro.indexOf('درمانگر') > -1) o += 'T';
      if (ro.indexOf('استاد') > -1) o += 'E';
      if (ro.indexOf('سوپروایزر') > -1) o += 'S';
      if (ro.indexOf('دانشجو') > -1) o += 'D';
      return o;
    }
  } catch (e) {}
  return '';
}

function tgPrRow_(row) {
  var all = tgPrAll_();
  for (var i = 0; i < all.length; i++) if (all[i].row === Number(row)) return all[i];
  return null;
}

function tgPrH_(id) {
  var h = 5381, s = String(id);
  for (var i = 0; i < s.length; i++) h = ((h * 33) ^ s.charCodeAt(i)) >>> 0;
  return h.toString(36).slice(-4);
}

function tgPrStamp_(v) { return Number(v.stamp || 0) || (String(v.review || '').trim() ? 0 : 1); }

function tgPrNeeds_(v) {
  if (!/[TES]/.test(String(v.roles || ''))) return false;
  var has = ['photo', 'title', 'city', 'headline', 'method', 'trainings', 'resume'].some(function (k) { return String(v[k] || '').trim(); });
  return has && tgPrStamp_(v) > Number(v.rstamp || 0);
}

function tgPrQueue_() { return tgPrAll_().filter(function (r) { return tgPrNeeds_(r.v); }); }

function tgPrOk_(chat) {
  var ids = TG_DRY ? (TG_MEM['watch'] || []) : tgWatchIds_();
  return ids.indexOf(String(chat)) > -1;
}

/* ───── پیشنهاد کارت ───── */
function tgPrDisplay_(n) {
  return String(n || '').trim().replace(/\s+/g, ' ')
    .replace(/ (زاده|نژاد|پور|فر|زادگان|منش|نیا|راد)(?= |$)/g, '\u200c$1');
}

/* رویکرد به تعبیر خود درمانگر ملاک است (یاسر: «تخصص و رویکردشون رو باید با خودشون چک کنی و همونو ملاک بذاریم») */
/* آدرس انگلیسی صفحه از نامی که خودش به لاتین نوشته (آوانویسی خودکار فارسی بی‌حرکت است: «غزاله» ← ghzalh) */
function tgPrLatinSlug_(s) {
  var x = String(s || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
  return /^[a-z0-9]+(-[a-z0-9]+)+$/.test(x) && x.length >= 5 && x.length <= 60 ? x : '';
}

function tgPrOwnSp_(a) {
  var p = String(a || '').split(/\s*[،,]\s*/).map(function (x) { return x.trim(); }).filter(String);
  if (!p.length) return '';
  return p.length === 1 ? p[0] : p.slice(0, -1).join('، ') + ' و ' + p[p.length - 1];
}

function tgPrSp_(school) {
  var s = String(school || '').trim();
  if (!s) return '';
  var p = s.split(/\s*[—–-]\s*/);
  if (p.length > 1 && /تحلیلی|روانکاوی/.test(p[0])) {
    var b = p.slice(1).join(' و ');
    if (b === 'کلاسیک') b = 'کلاسیک فرویدی';
    return 'روانکاوی ' + b;
  }
  if (s === 'تحلیلی') return 'روان‌درمانی تحلیلی';
  return p.join(' · ');
}

function tgPrAbroad_(c) {
  c = String(c || '');
  return /[A-Za-z]/.test(c) || /آمریکا|امریکا|کانادا|آلمان|انگلیس|بریتانیا|لندن|فرانسه|پاریس|هلند|سوئد|نروژ|دانمارک|فنلاند|اتریش|سوئیس|ایتالیا|اسپانیا|ترکیه|استانبول|دبی|امارات|استرالیا|نیوزیلند|ژاپن|تورنتو|ونکوور|برلین|هامبورگ|مونیخ|آمستردام|استکهلم|کپنهاگ|وین|میلان|قطر|عمان|ارمنستان|گرجستان|قبرس|مالزی|کره/.test(c);
}

function tgPrTags_(txt, ages, city) {
  var t = String(txt || ''), out = [];
  var add = function (x) { if (out.indexOf(x) < 0) out.push(x); };
  if (/لکان/.test(t)) add('lacan');
  if (/ابژه/.test(t)) add('object');
  if (/کلاسیک|فروید|تحلیلی|روانکاو/.test(t)) add('classic');
  if (/مدرن|معاصر/.test(t)) add('modern');
  if (/CBT|شناختی|رفتاری/i.test(t)) add('cbt');
  if (/طرحواره/.test(t)) add('schema');
  if (/EFT|هیجان/i.test(t)) add('eft');
  if (/MBT|ذهنی.?سازی/i.test(t)) add('mbt');
  if (/روان.?پزشک/.test(t)) add('psy');
  if (/کودک|نوجوان/.test(String(ages || '') + ' ' + t)) add('child');
  if (tgPrAbroad_(city)) add('abroad');
  return out.join(' ');
}

/* اطلاعات درمانگر از تب درمانگران (مکتب، رویکرد خام، عکس فرم قدیم، مدرسه) */
function tgPrTher_(name) {
  if (TG_DRY) return (TG_MEM['therinfo'] || {})[name] || null;
  var row = tgTherRow_(name);
  if (!row) return null;
  var sh = tgSS_().getSheetByName(TG_THER), lc = sh.getLastColumn();
  var head = sh.getRange(3, 1, 1, lc).getValues()[0].map(function (x) { return String(x).trim(); });
  var val = sh.getRange(row, 1, 1, lc).getValues()[0];
  var g = function (h) { var i = head.indexOf(h); return i > -1 ? String(val[i] || '').trim() : ''; };
  return { row: row, school: g('مکتب اصلی'), raw: g('رویکرد اعلام‌شده (خام)'), photo: g('عکس پروفایل'),
           onsite: g('عکس در سایت'), alum: g('مدرسهٔ تجربه'), ages: g('ردهٔ سنی') };
}

/* همه‌چیزِ لازم برای کارت بازبینی و انتشار */
function tgPrPlan_(r) {
  var v = r.v, roles = String(v.roles || '');
  var isT = roles.indexOf('T') > -1, isES = /[ES]/.test(roles);
  var ther = String(v.id || '').indexOf('ther:') === 0 ? tgPrTher_(v.name) : null;
  var names = [v.name];
  if (v.site_name) names.push(v.site_name);
  var hits = [];
  var siteErr = '';
  try { hits = tgDir_('find', { names: names }).hits || []; } catch (e) { siteErr = String(e.message || e); }
  /* v170.23.2: صفحهٔ اصلی از بازطراحی نوار a.p3 دارد (اسنیپت 504064 v1.1، نوع «p3»)؛ کارت p3 همان کارت صفحهٔ اصلی است */
  var home = hits.filter(function (h) { return (h.kind === 'thc' || h.kind === 'p3') && Number(h.page) === TG_PR_HOME; })[0] || null;
  var anyThc = hits.filter(function (h) { return h.kind === 'thc' || h.kind === 'p3'; })[0] || null;
  var sup = hits.filter(function (h) { return h.kind === 'supc'; })[0] || null;
  var cur = (home || anyThc || sup || {}).f || {};
  var alum = !!(ther && /^حلقه/.test(ther.alum) && ther.alum.indexOf('احتمالی') < 0);
  var fid = String(v.photo || '').replace(/^tg:photo:/, '').split(' ')[0] || (ther && ther.photo) || '';
  var p = {
    row: r.row, id: v.id, h: tgPrH_(v.id), v: v, isT: isT, isES: isES, hits: hits, siteErr: siteErr,
    create: isT && !home,
    kind: isT ? 'thc' : 'supc',
    name: v.site_name || cur.name || tgPrDisplay_(v.name),
    sp: v.site_sp || tgPrOwnSp_(v.approach) || cur.sp || tgPrSp_(ther && ther.school) || '',
    city: v.site_city || v.city || cur.city || '',
    tags: '', school: alum,
    fid: (v.site_photo === 'فعلی' || String(v.site_photo || '').indexOf('ندارد') === 0) ? '' : fid,
    keepPhoto: v.site_photo === 'فعلی',
    photoOff: String(v.site_photo || '').indexOf('ندارد') === 0,
    hasCurPhoto: !!cur.photo,
    /* v170.23.6: اطلاعات سبک با پشتوانهٔ قرارداد همکاری؛ فقط تصمیم تیم («روی سایت نمی‌رود») جلویش را می‌گیرد */
    blocked: /نمی‌رود/.test(String(v.status || '')),
    pageOk: true,
    extraOk: String(v.consent || '').indexOf('بله') === 0   /* رزومهٔ کامل و ویس: اجازهٔ جدا */
  };
  p.tags = v.site_tags || (p.create ? tgPrTags_([p.sp, ther && ther.school, ther && ther.raw].join(' '), v.ages, p.city) : (cur.tags || ''));
  try { p.tags = tgPrInpTag_(v.name, p.tags); } catch (eTg) {}
  if (p.create && alum && (' ' + p.tags + ' ').indexOf(' school ') < 0) p.tags = (p.tags + ' school').trim();
  p.cur = cur;
  p.ther = ther;
  p.hubAges = ther ? String(ther.ages || '') : '';
  p.ages = tgPrAges_(v.ages, p.hubAges);
  /* کارت تازه بی‌عکس یا بی‌رویکرد ساخته نمی‌شود، ولی صفحهٔ شخصی به کارت وابسته نیست (قبلاً همین، انتشار صفحه را هم می‌بست) */
  p.card = p.create ? !!(p.fid && p.sp) : hits.length > 0;
  p.canPublish = !p.blocked && !siteErr && (p.card || p.pageOk);
  return p;
}

/* ───── متن و دکمه‌ها ───── */
function tgPrCut_(s, n) { s = String(s || '').replace(/\s+/g, ' ').trim(); return s.length > n ? s.slice(0, n) + '…' : s; }

/* v170.23.6 (تصمیم یاسر): همهٔ کارت‌های تأیید یک شکل دارند: بالای کارت فقط تغییرها («قبلی ← جدید» یا «تازه»)، بعد هشدارهای
   اعتبارسنجی (تا اصلاح نشده تأیید قفل است)، بعد جزئیات. سه دکمه: «✅ تأیید و انتشار»، «✏️ اصلاح»، «⏭ بعدی». */
var TG_OK_URL_RX = /https?:\/\/|www\.|meet\.google|zoom\.us|t\.me\/|@\w{3,}|[\w.+-]+@[\w-]+\.\w+/i;
var TG_OK_PHONE_RX = /(?:\+|00)?9?8?\s*0?9[\d۰-۹٠-٩\s-]{8,}|[\d۰-۹٠-٩]{8,}/;
function tgOkBad_(s) { s = String(s || ''); return TG_OK_URL_RX.test(s) ? 'لینک یا ایمیل دارد' : TG_OK_PHONE_RX.test(s) ? 'شماره دارد' : ''; }
/* اعتبارسنجی پیش از نمایش: block یعنی تأیید قفل است */
function tgPrValid_(p) {
  var v = p.v, block = [], warn = [];
  var chk = function (label, val) { var b = tgOkBad_(val); if (b) block.push('«' + label + '» ' + b + ': ' + tgPrCut_(val, 50)); };
  chk('نام', p.name); chk('خط رویکرد', p.sp); chk('شهر', p.city);
  chk('عنوان', String(v.pub_title || v.title || '')); chk('یک جمله', String(v.pub_headline || v.headline || '')); chk('مدرک', String(v.degree || ''));
  if (p.create && !p.fid && !p.hasCurPhoto) block.push('عکس ندارد؛ کارت تازه بی‌عکس ساخته نمی‌شود');
  else if (!p.fid && !p.hasCurPhoto && !p.keepPhoto) warn.push('عکس ندارد');
  if (p.create && !p.sp) block.push('خط رویکرد ندارد');
  if (/[A-Za-z0-9]/.test(p.name)) warn.push('در نام حرف لاتین یا عدد هست');
  if (p.siteErr) block.push('سایت جواب نداد: ' + tgPrCut_(p.siteErr, 60));
  return { block: block, warn: warn };
}
function tgPrBasis_() { var ver = String(cfg_('TG_CONTRACT_VER', '') || '').trim(); return 'قرارداد همکاری' + (ver ? ' · نسخهٔ ' + ver : ''); }
function tgPrText_(p) {
  var v = p.v;
  var roles = String(v.roles || '').split('').map(function (c) { return TG_PR_ROLEFA[c]; }).filter(Boolean).join('، ');
  var L = ['🪪 <b>تأیید پروفایل</b> · ' + tgEsc_(p.name) + (p.create ? ' · <b>تازه</b>' : ''),
           tgEsc_(roles) + ' · تکمیل ' + tgFa_(v.pct || tgPqPct_(v, v.roles || 'T')) + '٪' + (v.updated ? ' · آخرین پاسخ ' + tgEsc_(v.updated) : '')];
  if (p.blocked) L.push('⛔ تصمیم تیم: روی سایت نمی‌رود.');
  /* ۱) فقط تغییرها */
  var ch = [];
  var diff = function (label, now, was) {
    now = String(now || ''); was = String(was || '');
    if (p.create) { if (now) ch.push(label + ': ' + tgEsc_(now)); return; }
    if (now && was && now !== was) ch.push(label + ': ' + tgEsc_(was) + ' ← ' + tgEsc_(now));
    else if (now && !was) ch.push(label + ': تازه ← ' + tgEsc_(now));
  };
  diff('نام', p.name, p.cur.name);
  diff('خط رویکرد', p.sp, p.cur.sp);
  if (p.isT) diff('شهر', p.city, p.cur.city);
  if (p.create || v.site_tags) diff('تگ‌ها', p.tags, p.cur.tags);
  if (p.fid && !p.keepPhoto) ch.push('عکس: ' + (p.hasCurPhoto ? 'عکس فعلی ← عکس تازه از بات' : 'تازه'));
  var t1 = String(v.pub_title || v.title || '').trim(); if (t1 && (p.create || !v.page)) ch.push('عنوان: ' + tgEsc_(tgPrCut_(t1, 80)));
  if (!v.page && p.pageOk && !p.blocked) ch.push('صفحهٔ شخصی: تازه ساخته می‌شود');
  if (p.extraOk && String(v.pub_resume || '').trim() && !String(v.page || '').trim()) ch.push('رزومهٔ کامل: تازه');
  var vm = /^tg:voice:([^\s·]+)/.exec(String(v.voice || ''));
  if (p.extraOk && vm && vm[1] !== String(v.page_voice || '')) ch.push('ویس معرفی: ' + (v.page_voice ? 'ویس قبلی ← ویس تازه' : 'تازه'));
  L.push('');
  L.push('<b>تغییرها</b>');
  L = L.concat(ch.length ? ch.map(function (x) { return '• ' + x; }) : ['• چیزی در سایت عوض نمی‌شود؛ تأیید فقط بازبینی را ثبت می‌کند.']);
  /* ۲) اعتبارسنجی */
  var val = tgPrValid_(p);
  if (val.block.length) { L.push(''); L.push('🔒 <b>تا اصلاح نشود تأیید قفل است</b>'); val.block.forEach(function (x) { L.push('⛔ ' + tgEsc_(x)); }); }
  if (val.warn.length) val.warn.forEach(function (x) { L.push('⚠️ ' + tgEsc_(x)); });
  /* ۳) جزئیات */
  L.push('');
  L.push('<b>کارت سایت</b> ' + (p.siteErr ? '(سایت جواب نداد)' : p.create ? '(کارت تازه در صفحهٔ اصلی' + (p.school ? ' و مدرسه' : '') + ')' :
         p.hits.length ? '(' + p.hits.map(function (h) { return (h.kind === 'supc' ? 'کارت استاد' : 'کارت') + ' ' + tgEsc_(h.title || h.page); }).join('، ') + ')' : '(کارتی در سایت ندارد)'));
  if (v.page) L.push('صفحهٔ شخصی: <a href="' + tgEsc_(v.page) + '">' + tgEsc_(tgPrUrl_(v.page)) + '</a>');
  L.push('پشتوانهٔ انتشار: ' + tgEsc_(String(v.basis || '').trim() || tgPrBasis_()) + ' · رزومهٔ کامل و ویس: ' + (p.extraOk ? 'اجازه دارد' : 'اجازهٔ جدا ندارد'));
  var lsl = tgPrLatinSlug_(v.latin);
  if (!v.page && !v.site_slug && !lsl) L.push('👈 نام لاتین ندارد و آدرس خودکار بی‌حرکت می‌شود؛ از «✏️ اصلاح» آدرس بده.');
  var I = [];
  var add = function (label, k, n) { if (String(v[k] || '').trim()) I.push(label + ': ' + tgEsc_(tgPrCut_(v[k], n || 160))); };
  add('عنوان', 'title'); add('مدرک', 'degree'); add('کد نظام', 'license', 40); add('از سال', 'since', 10);
  add('رویکرد', 'approach'); add('شکل جلسه', 'mode', 40); add('زبان', 'langs'); add('با', 'ages'); add('یک جمله', 'headline', 220); add('روش درمان', 'method', 300);
  add('جلسهٔ اول', 'first', 200); add('آموزش‌ها', 'trainings', 200); add('سوپرویژن', 'supervision', 60); add('درس‌ها', 'teach', 160); add('مقاله‌ها', 'articles', 160); add('لینک‌ها', 'links', 120);
  if (I.length) { L.push(''); L.push('<b>برای صفحهٔ داخلی</b>'); L = L.concat(I); }
  var t = L.join('\n');
  return t.length > 4000 ? t.slice(0, 3990) + '…' : t;
}

var T_PR_PHOTOASK =
  'صفحهٔ شما در سایت تجربه منتشر است و فعلاً جای عکس خالی مانده.\n\n' +
  'اگر عکسی همین‌جا بفرستید، روی کارت و صفحه‌تان می‌نشیند. برای اینکه کارت‌ها کنار هم یک‌دست دربیایند معمولاً این‌ها جواب می‌دهد:\n' +
  '• نور از روبه‌رو، ترجیحاً نور روز\n' +
  '• پس‌زمینهٔ ساده\n' +
  '• کادر از بالای سینه تا بالای سر\n' +
  '• بدون فیلتر و بدون نوشته روی عکس\n\n' +
  'هر وقت دستتان رسید. عجله‌ای نیست.';


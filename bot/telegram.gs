  if (!opts.force && pol.cap && !(typeof v17013CapFree_ === 'function' && v17013CapFree_(chat)) && tgCapCount_(chat, kind) >= pol.cap) {   /* v170.13: پذیرش بی سقف */ TG_OUT_KIND = kind; TG_OUT_REF = opts.ref || ''; tgOutLog_(chat, '[سقف] ' + text, false); TG_OUT_KIND = ''; TG_OUT_REF = ''; return 'سقف'; }

function tgPqQ_(k) { for (var i = 0; i < TG_PQ.length; i++) if (TG_PQ[i].k === k) return TG_PQ[i]; return null; }

/* کدام نقش‌ها؟ از تب درمانگران و تب افراد، با هم */
function tgPqWho_(chat) {
  var out = { w: '', name: '', ther: null, person: null };
  try { out.ther = tgWhoTherapist_(chat); } catch (e) {}
  try { out.person = tgWhoPerson_(chat, ''); } catch (e) {}
  if (out.ther) { out.w += 'T'; out.name = out.ther.name; }
  var r = (out.person && out.person.roles) || [];
  if (r.indexOf('درمانگر') > -1 && out.w.indexOf('T') < 0) out.w += 'T';
  if (r.indexOf('استاد') > -1) out.w += 'E';
  if (r.indexOf('سوپروایزر') > -1) out.w += 'S';
  if (r.indexOf('دانشجو') > -1) out.w += 'D';
  if (!out.name && out.person) out.name = out.person.name;
  return out;
}

function tgPqList_(w) {
  return TG_PQ.filter(function (q) {
    for (var i = 0; i < w.length; i++) if (q.w.indexOf(w[i]) > -1) return true;
    return false;
  });
}

function tgPqId_(who) { return (who.ther ? 'ther:' : 'ppl:') + tgNorm_(who.name); }

/* ───── تب «پروفایل سایت» ───── */
function tgPqKeys_() { return TG_PQ_FIX.concat(TG_PQ.map(function (q) { return q.k; })); }

function tgPqSheet_() {
  if (TG_DRY) return null;
  var ss = tgSS_(), sh = ss.getSheetByName(TG_PQ_TAB);
  var keys = tgPqKeys_(), labels = TG_PQ_FIXL.concat(TG_PQ.map(function (q) { return q.l; }));
  if (!sh) {
    sh = ss.insertSheet(TG_PQ_TAB);
    sh.setRightToLeft(true);
    sh.getRange(1, 1, 1, labels.length).setValues([labels]).setFontWeight('bold').setBackground('#f3efec');
    sh.getRange(2, 1, 1, keys.length).setValues([keys]).setFontColor('#9a9a9a').setFontSize(8);
    sh.setFrozenRows(2);
    sh.setFrozenColumns(2);
    return sh;
  }
  // کلید تازه‌ای در پرسش‌نامه آمده؟ ته جدول اضافه شود
  var have = sh.getRange(2, 1, 1, Math.max(1, sh.getLastColumn())).getValues()[0].map(String);
  for (var i = 0; i < keys.length; i++) {
    if (have.indexOf(keys[i]) > -1) continue;
    var c = sh.getLastColumn() + 1;
    sh.getRange(1, c).setValue(labels[i]).setFontWeight('bold').setBackground('#f3efec');
    sh.getRange(2, c).setValue(keys[i]).setFontColor('#9a9a9a').setFontSize(8);
    have.push(keys[i]);
  }
  return sh;
}

/* سطر یک نفر: { row, v:{key:value} } — اگر نبود و make باشد ساخته می‌شود */
function tgPqRec_(id, make, base) {
  if (TG_DRY) {
    TG_MEM['pqrows'] = TG_MEM['pqrows'] || {};
    if (!TG_MEM['pqrows'][id] && make) TG_MEM['pqrows'][id] = Object.assign({ id: id }, base || {});
    return TG_MEM['pqrows'][id] ? { row: 0, v: TG_MEM['pqrows'][id] } : null;
  }
  var sh = tgPqSheet_();
  var lc = sh.getLastColumn(), last = sh.getLastRow();
  var keys = sh.getRange(2, 1, 1, lc).getValues()[0].map(String);
  if (last >= 3) {
    var ids = sh.getRange(3, 1, last - 2, 1).getValues();
    for (var i = 0; i < ids.length; i++) {
      if (String(ids[i][0]) !== id) continue;
      var vals = sh.getRange(i + 3, 1, 1, lc).getValues()[0], o = {};
      for (var j = 0; j < lc; j++) if (keys[j]) o[keys[j]] = vals[j] === '' ? '' : String(vals[j]);
      return { row: i + 3, v: o };
    }
  }
  if (!make) return null;
  var rowv = keys.map(function (k) { return k === 'id' ? id : (base && base[k] != null ? base[k] : ''); });
  sh.appendRow(rowv);
  var o2 = {}; for (var z = 0; z < keys.length; z++) o2[keys[z]] = String(rowv[z]);
  return { row: sh.getLastRow(), v: o2 };
}

function tgPqPut_(id, obj) {
  if (TG_DRY) { TG_MEM['pqrows'] = TG_MEM['pqrows'] || {}; TG_MEM['pqrows'][id] = Object.assign(TG_MEM['pqrows'][id] || { id: id }, obj); return; }
  var rec = tgPqRec_(id, true);
  var sh = tgPqSheet_();
  var keys = sh.getRange(2, 1, 1, sh.getLastColumn()).getValues()[0].map(String);
  for (var k in obj) {
    var c = keys.indexOf(k);
    if (c > -1) sh.getRange(rec.row, c + 1).setValue(obj[k]);
  }
}

/* ───── وضعیت گفت‌وگو ───── */
function tgPqGet_(chat) { try { return JSON.parse(tgGetVal_('pq', chat) || 'null'); } catch (e) { return null; } }
function tgPqSet_(chat, st) { tgSetVal_('pq', chat, JSON.stringify(st)); }

var TG_PQ_URLQ = ['links', 'articles', 'resume'];   /* v170.23.6: فقط این پرسش‌ها لینک می‌پذیرند */
function tgPqAnswered_(v, q) { return !!(v && String(v[q.k] || '').trim()); }

/* ورود: دکمه، /page، /start page، دکمهٔ دعوت */
function tgPqEntry_(chat, only) {
  var who = tgPqWho_(chat);
  var w = who.w;
  var roles = null;
  if (only === 'D') w = 'D';
  else if (only === 'K') {            /* v83: پرسش‌نامهٔ کار، فقط برای درمانگر */
    if (w.indexOf('T') < 0) { tgSend_(chat, T_PQ_NOID); return; }
    roles = w; w = 'K';
  }
  else if (only === 'W') w = w.replace('D', '') || w;
  if (!w) { tgSend_(chat, T_PQ_NOID); return; }
  var id = tgPqId_(who);
  var rec = tgPqRec_(id, true, { name: who.name, roles: roles || w, chat: String(chat), src: who.ther ? 'درمانگران' : 'افراد',
                                  status: 'در حال تکمیل', started: tgPqNow_() });
  var v = rec.v;
  if (!String(v.roles || '').trim()) { tgPqPut_(id, { roles: roles || w, src: who.ther ? 'درمانگران' : 'افراد' }); v.roles = roles || w; }
  var list = tgPqList_(w);
  var skipped = String(v.skipped || '').split(',');
  var todo = [];
  for (var i = 0; i < list.length; i++) {
    var q = list[i];
    if (tgPqAnswered_(v, q) || skipped.indexOf(q.k) > -1) continue;
    if (q.k === 'photo' && who.ther && tgPqHasPhoto_(who.ther.name)) continue;
    todo.push(q.k);
  }
  var st = { id: id, w: w, name: who.name, todo: todo, i: 0, pick: [], n: list.length, ther: !!who.ther };
  if (!todo.length) {
    tgPqSet_(chat, st);
    return tgSend_(chat, '✅ همهٔ پرسش‌ها را جواب داده‌اید یا رد کرده‌اید. اگر بخواهید از اول مرورشان کنید:',
      { inline_keyboard: [[{ text: '✏️ از اول', callback_data: 'pq:re' }], [{ text: '🌐 سایت تجربه', url: TG_PQ_SITE }]] });
  }
  tgPqSet_(chat, st);
  tgSend_(chat, w === 'D' ? T_PQ_INTRO_D : (w === 'K' ? T_PQ_INTRO_K : T_PQ_INTRO_T));
  return tgPqAsk_(chat, st);
}

/* فقط سؤال اجازهٔ انتشار را دوباره می‌پرسد (برای کسی که «فعلاً فقط برای تیم» زده و نظرش عوض شده) */
function tgPqConsent_(chat) {
  var who = tgPqWho_(chat);
  var w = who.w.replace('D', '') || who.w;
  if (!w) { tgSend_(chat, T_PQ_NOID); return; }
  var id = tgPqId_(who);
  tgPqRec_(id, true, { name: who.name, roles: w, chat: String(chat), src: who.ther ? 'درمانگران' : 'افراد', status: 'در حال تکمیل', started: tgPqNow_() });
  var st = { id: id, w: w, name: who.name, todo: ['consent'], i: 0, pick: [], n: 1, ther: !!who.ther };
  return tgPqAsk_(chat, st);
}

function tgPqHasPhoto_(name) {
  if (TG_DRY) return !!(TG_DRY_THER && TG_DRY_THER.photo);
  try {
    var p = tgTherProfile_(name);
    if (p && p.photo) return true;
    var sh = tgSS_().getSheetByName(TG_THER), row = tgTherRow_(name);
    return !!(row && String(sh.getRange(row, tgTherCol_('عکس در سایت')).getValue()).trim() === 'هست');
  } catch (e) { return false; }
}

function tgPqNow_() { try { return tgJDateFull_(new Date(), TG_TZ); } catch (e) { return String(new Date()); } }

function tgPqKb_(q, st) {
  var rows = [];
  if (q.t === 'choice') {
    for (var i = 0; i < q.o.length; i++) rows.push([{ text: q.o[i], callback_data: 'pq:o:' + i }]);
  } else if (q.t === 'multi') {
    var btn = function (j) { return { text: (st.pick.indexOf(q.o[j]) > -1 ? '✓ ' : '') + q.o[j], callback_data: 'pq:m:' + j }; };
    if (q.g) {
      /* هر خانواده یک سرتیتر (دکمهٔ بی‌اثر) و زیرش گزینه‌ها، دوتا در هر ردیف */
      q.g.forEach(function (gr) {
        rows.push([{ text: '▾ ' + gr[0], callback_data: 'pq:nop' }]);
        for (var a = 0; a < gr[1].length; a += 2) rows.push(gr[1].slice(a, a + 2).map(btn));
      });
    } else {
      var r = [];
      for (var j = 0; j < q.o.length; j++) {
        r.push(btn(j));
        if (r.length === 3) { rows.push(r); r = []; }
      }
      if (r.length) rows.push(r);
    }
    st.pick.forEach(function (c) { if (q.o.indexOf(c) < 0) rows.push([{ text: '✓ ' + c, callback_data: 'pq:mx:' + st.pick.indexOf(c) }]); });
    rows.push([{ text: '✅ همین‌ها', callback_data: 'pq:md' }]);
  }
  var tail = [];
  if (!q.req) tail.push({ text: '⏭ رد شدن', callback_data: 'pq:sk' });
  tail.push({ text: '⏸ بعداً', callback_data: 'pq:lt' });
  rows.push(tail);
  return { inline_keyboard: rows };
}

function tgPqCur_(st) {
  while (st.i < st.todo.length) {
    var q = tgPqQ_(st.todo[st.i]);
    if (q && q.when) {
      var rec = tgPqRec_(st.id, false);
      var dep = rec ? String(rec.v[q.when] || '') : '';
      if (dep.indexOf('بله') !== 0) { st.i++; continue; }
    }
    return q;
  }
  return null;
}

function tgPqAsk_(chat, st) {
  var q = tgPqCur_(st);
  tgPqSet_(chat, st);
  if (!q) return tgPqFinish_(chat, st);
  var head = '<b>' + tgFa_(st.i + 1) + ' از ' + tgFa_(st.todo.length) + '</b> · ' + tgEsc_(q.l);
  return tgSend_(chat, head + '\n\n' + tgEsc_(q.a), tgPqKb_(q, st));
}

/* پاسخ را ذخیره می‌کند و اثرهای جانبی‌اش را هم (عکس در تب درمانگران، دانشگاه در تب افراد) */
function tgPqSave_(chat, st, q, val) {
  /* v77: برچسب دکمهٔ منو هیچ‌وقت جوابِ یک فیلد متنی نیست */
  var _tt = String((q && q.t) || '');
  if (['photo', 'voice', 'file', 'choice', 'multi', 'year'].indexOf(_tt) < 0 && tgIsBtnLike_(val)) {
    tgErr_('tgPqSave_: برچسب دکمه به‌جای جواب رد شد · ' + (q && q.k));
    return;
  }
  tgPqPut_(st.id, (function () { var o = {}; o[q.k] = val; o.updated = tgPqNow_(); o.stamp = String(Date.now()); o.chat = String(chat); return o; })());
  if (TG_DRY) return;
  try {
    if (q.k === 'photo' && st.ther) {
      var sh = tgSS_().getSheetByName(TG_THER), row = tgTherRow_(st.name);
      if (row) sh.getRange(row, tgTherCol_('عکس پروفایل')).setValue(String(val).replace(/^tg:photo:/, ''));
      CacheService.getScriptCache().remove('trows');
    }
    /* v83: هر پرسشی که col دارد، جوابش در همان ستون تب درمانگران هم می‌نشیند */
    if (q.col && st.ther) {
      var shC = tgSS_().getSheetByName(TG_THER), rowC = tgTherRow_(st.name), colC = tgTherCol_(q.col);
      if (rowC && colC) shC.getRange(rowC, colC).setValue(val);
      CacheService.getScriptCache().remove('trows');
    }
    var p = (q.k === 'uni' || q.k === 'supaccept') ? tgWhoPerson_(chat, '') : null;
    if (p && q.k === 'uni') { tgPersonSet_(p.row, { 'دانشگاه': val }, 'خود فرد', { why: 'پروفایل' }); CacheService.getScriptCache().remove('plist'); }
    if (p && q.k === 'supaccept') { tgPersonSet_(p.row, { 'سوپرویژن می‌پذیرد؟': val.indexOf('ندارم') > -1 ? 'خیر' : 'بله' }, 'خود فرد', { why: 'پروفایل' }); CacheService.getScriptCache().remove('plist'); }
  } catch (e) { tgErr_('tgPqSave_: ' + e); }
}

function tgPqNext_(chat, st) { st.i++; st.pick = []; return tgPqAsk_(chat, st); }

function tgPqIsExit_(text) {
  var t = String(text || '').trim();
  if (!t) return false;
  if (t === TG_PQ_BTN || t === TG_PQ_UBTN) return false;
  return tgIsBtnLike_(t);
}

/* پیام معمولی وسط پرسش‌نامه. true یعنی مصرف شد. */
function tgPqStep_(chat, m) {
  var st = tgPqGet_(chat);
  if (!st) return false;
  var q = tgPqCur_(st);
  if (!q) { tgDel_('pq', chat); return false; }
  var text = String((m && (m.text || m.caption)) || '').trim();
  if (m && m.text && tgPqIsExit_(text) && !(q.o && q.o.indexOf(text) > -1)) { tgDel_('pq', chat); return false; }
  /* v170.23.6: ریشهٔ «لینک گوگل‌میت در عنوان»: حالت پرسش‌نامه تا ۶ ساعت باز می‌ماند و پرسش متنی هر متنی را می‌پذیرفت؛ لینکی که
     درمانگر برای پیام دیگری (مثل لینک جلسه) فرستاد، جواب «عنوان» ثبت شد. لینک برای پرسش غیرلینکی جواب نیست: حالت بسته و پیام به مسیر خودش. */
  if (text && TG_PQ_URLQ.indexOf(q.k) < 0 && ['photo', 'voice', 'file', 'email', 'money', 'year'].indexOf(q.t) < 0 && TG_OK_URL_RX.test(text)) { tgDel_('pq', chat); return false; }

  if (q.t === 'photo') {
    var ph = m && m.photo && m.photo.length ? m.photo[m.photo.length - 1].file_id :
             (m && m.document && /^image\//.test(m.document.mime_type || '') ? m.document.file_id : '');
    if (!ph) { tgSend_(chat, 'اینجا یک عکس لازم است. اگر الان ندارید، «رد شدن» را بزنید.', tgPqKb_(q, st)); return true; }
    var big = m && m.photo && m.photo.length ? m.photo[m.photo.length - 1] : null;
    if (big && big.width && Math.min(big.width, big.height || big.width) < TG_PQ_MINPX && !st.small) {
      st.small = 1; tgPqSet_(chat, st);
      tgSend_(chat, T_PQ_SMALL, tgPqKb_(q, st)); return true;
    }
    tgPqSave_(chat, st, q, 'tg:photo:' + ph);
    tgSend_(chat, 'عکس رسید ✅');
    tgPqNext_(chat, st); tgPqArchiveSafe_(st.id, st.name, q.k); return true;
  }
  if (q.t === 'voice') {
    var vo = m && (m.voice || m.audio);
    if (!vo) { tgSend_(chat, 'اینجا یک ویس لازم است. اگر نمی‌خواهید، «رد شدن» را بزنید.', tgPqKb_(q, st)); return true; }
    tgPqSave_(chat, st, q, 'tg:voice:' + vo.file_id + ' · ' + (vo.duration || 0) + 's');
    tgSend_(chat, 'ویس رسید ✅');
    tgPqNext_(chat, st); tgPqArchiveSafe_(st.id, st.name, q.k); return true;
  }
  if (q.t === 'file') {
    if (m && m.document) {
      tgPqSave_(chat, st, q, 'tg:doc:' + m.document.file_id + ' · ' + (m.document.file_name || 'file'));
      tgSend_(chat, 'فایل رسید ✅');
      tgPqNext_(chat, st); tgPqArchiveSafe_(st.id, st.name, q.k); return true;
    }
    if (/https?:\/\//i.test(text)) { tgPqSave_(chat, st, q, text); tgPqNext_(chat, st); return true; }
    tgSend_(chat, 'فایل رزومه را بفرستید یا لینکش را بنویسید.', tgPqKb_(q, st)); return true;
  }
  if (q.t === 'multi' && q.x && text && !/^\//.test(text)) {
    text.split(/\s*[،,\n]\s*/).map(function (a) { return a.trim().slice(0, 60); }).filter(function (a) { return a.length > 1; }).forEach(function (a) {
      if (st.pick.indexOf(a) < 0) st.pick.push(a);
    });
    tgPqSet_(chat, st);
    tgSend_(chat, 'تا الان: ' + (st.pick.length ? st.pick.join('، ') : 'هیچ') + '\nاگر کامل است «✅ همین‌ها» را بزنید.', tgPqKb_(q, st)); return true;
  }
  if (q.t === 'choice' || q.t === 'multi') {
    if (q.t === 'choice' && q.o.indexOf(text) > -1) { tgPqSave_(chat, st, q, text); tgPqNext_(chat, st); return true; }
    tgSend_(chat, 'یکی از دکمه‌های زیر را بزنید.', tgPqKb_(q, st)); return true;
  }
  if (!text) { tgSend_(chat, 'اینجا جواب نوشتنی لازم است.', tgPqKb_(q, st)); return true; }
  if (q.t === 'year') {
    var y = Number(tgLatinDigits_(text).replace(/\D/g, ''));
    if (y >= 1960 && y <= 2030) y = y - 621;
    if (!(y >= 1340 && y <= 1410)) { tgSend_(chat, 'فقط سال را بنویسید، مثلاً ۱۳۹۸.', tgPqKb_(q, st)); return true; }
    tgPqSave_(chat, st, q, String(y)); tgPqNext_(chat, st); return true;
  }
  if (q.t === 'email') {
    var em = String(tgLatinDigits_(text)).trim().replace(/\s+/g, '');
    if (!/^[^@\s]+@[^@\s.]+\.[^@\s]{2,}$/.test(em)) { tgSend_(chat, 'آدرس ایمیل را کامل بنویسید، مثلاً name@gmail.com', tgPqKb_(q, st)); return true; }
    tgPqSave_(chat, st, q, em); tgPqNext_(chat, st); return true;
  }
  if (q.t === 'money') {
    var mn = Number(String(tgLatinDigits_(text)).replace(/[^0-9]/g, ''));
    if (!(mn >= (q.lo || 0) && mn <= (q.hi || 1e12))) { tgSend_(chat, q.bad || 'فقط عدد را بنویسید.', tgPqKb_(q, st)); return true; }
    tgPqSave_(chat, st, q, String(mn)); tgPqNext_(chat, st); return true;
  }
  var min = q.min || (q.t === 'long' ? 20 : 2);
  if (text.length < min) { tgSend_(chat, 'کمی کامل‌تر بنویسید.', tgPqKb_(q, st)); return true; }
  tgPqSave_(chat, st, q, text.slice(0, 3000));
  tgPqNext_(chat, st);
  return true;
}

/* کال‌بک‌های pq: */
function tgPqCb_(chat, arg) {
  if (arg === 'nop') return;   /* سرتیتر گروه در کیبورد */
  if (arg === 'go') return tgPqEntry_(chat, 'W');
  if (arg === 'gu') return tgPqEntry_(chat, 'D');
  if (arg === 'cs') return tgPqConsent_(chat);
  if (arg === 'mo' || arg === 'mk') return tgPqModeAns_(chat, arg === 'mo');
  if (arg === 'iy' || arg === 'in') return tgInpOfferAns_(chat, arg === 'iy');
  var st = tgPqGet_(chat);
  if (arg === 're') {
    if (!st) return tgPqEntry_(chat);
    st.todo = tgPqList_(st.w).map(function (q) { return q.k; }); st.i = 0; st.pick = [];
    tgPqPut_(st.id, { skipped: '' });
    return tgPqAsk_(chat, st);
  }
  if (!st) return tgSend_(chat, 'این پرسش منقضی شده. «' + TG_PQ_BTN + '» را دوباره بزنید.');
  var q = tgPqCur_(st);
  if (!q) return tgPqFinish_(chat, st);
  if (arg === 'lt') {
    tgDel_('pq', chat);
    try { tgPrNotify_(st.id); } catch (e) { tgErr_('prNotify: ' + e); }
    return tgSend_(chat, T_PQ_LATER, st.ther ? tgTherMenu_() : null);
  }
  if (arg === 'sk') {
    if (q.req) return tgPqAsk_(chat, st);
    var rec0 = tgPqRec_(st.id, false), sk = rec0 ? String(rec0.v.skipped || '') : '';
    if ((',' + sk + ',').indexOf(',' + q.k + ',') < 0) tgPqPut_(st.id, { skipped: sk ? sk + ',' + q.k : q.k });
    return tgPqNext_(chat, st);
  }
  if (arg.indexOf('o:') === 0 && q.t === 'choice') {
    var o = q.o[Number(arg.slice(2))];
    if (!o) return tgPqAsk_(chat, st);
    tgPqSave_(chat, st, q, o);
    return tgPqNext_(chat, st);
  }
  if (arg.indexOf('m:') === 0 && q.t === 'multi') {
    var x = q.o[Number(arg.slice(2))];
    if (x) { var at = st.pick.indexOf(x); if (at > -1) st.pick.splice(at, 1); else st.pick.push(x); }
    tgPqSet_(chat, st);
    return tgSend_(chat, 'تا الان: ' + (st.pick.length ? st.pick.join('، ') : 'هیچ') , tgPqKb_(q, st));
  }
  if (arg.indexOf('mx:') === 0 && q.t === 'multi') {
    var ix = Number(arg.slice(3));
    if (st.pick[ix] != null && q.o.indexOf(st.pick[ix]) < 0) st.pick.splice(ix, 1);
    tgPqSet_(chat, st);
    return tgSend_(chat, 'تا الان: ' + (st.pick.length ? st.pick.join('، ') : 'هیچ'), tgPqKb_(q, st));
  }
  if (arg === 'md' && q.t === 'multi') {
    if (!st.pick.length) return tgSend_(chat, 'دست‌کم یکی را بزنید، یا «رد شدن».', tgPqKb_(q, st));
    tgPqSave_(chat, st, q, st.pick.join('، '));
    /* فقط «حضوری»؟ شاید متوجه نشده؛ تقریباً همه آنلاین هم می‌بینند */
    if (q.k === 'mode' && st.pick.join('') === 'حضوری') {
      tgPqPut_(st.id, { modechk: 'پرسیده شد · ' + tgPqNow_() });
      tgPqSet_(chat, st);
      return tgSend_(chat, T_PQ_MODECHK, TG_PQ_MODEKB);
    }
    return tgPqNext_(chat, st);
  }
  return tgPqAsk_(chat, st);
}

function tgPqPct_(v, w) {
  var list = tgPqList_(w).filter(function (q) { return !q.when || String(v[q.when] || '').indexOf('بله') === 0; });
  var n = 0;
  for (var i = 0; i < list.length; i++) if (tgPqAnswered_(v, list[i])) n++;
  return list.length ? Math.round(n * 100 / list.length) : 0;
}

/* v83: خبر کوتاه به پذیرش و ناظر */
function tgDeskSay_(text) {
  var sent = false;
  try {
    (TG_DRY ? (TG_MEM['desk'] || []) : tgDeskRows_()).forEach(function (r) { if (!sent && r.chat) { tgNotify_(r.chat, TG_NK.task, text, { ref: 'پذیرش' }); sent = true; } });
  } catch (e) {}
  try { tgPayWatch_(text); } catch (e) {}
  return sent;
}

function tgPqFinish_(chat, st) {
  tgDel_('pq', chat);
  var rec = tgPqRec_(st.id, true);
  var v = rec ? rec.v : {};
  if (st.w === 'K') {
    var fa3 = function (n) { return tgFa_(String(n || '').replace(/\B(?=(\d{3})+(?!\d))/g, '٬')); };
    tgPqPut_(st.id, { updated: tgPqNow_() });
    var L2 = ['ثبت شد، ممنون. 🌱', ''];
    if (v.rate) L2.push('نرخ جلسه: ' + fa3(v.rate) + ' تومان');
    if (v.slen) L2.push('طول جلسه: ' + tgEsc_(String(v.slen)));
    if (String(v.suppl || '').indexOf('بله') === 0 && v.suprate)
      L2.push('نرخ حمایتی: ' + fa3(v.suprate) + ' تومان' + (v.supcap ? ' · ' + tgEsc_(String(v.supcap)) : ''));
    var sessN = 0;
    try { sessN = tgMyWeekly_(st.name, TG_KIND_SESS).length; } catch (e) {}
    if (!sessN) L2.push('', 'یک قدم مانده: وقت‌های درمانتان را با «🩺 اعلام وقت درمان» اعلام کنید تا مراجع بتواند جلسهٔ اول را از همان‌جا رزرو کند.');
    L2.push('', 'هر وقت نرخ یا ساعت‌هایتان عوض شد، از همین «' + TG_PQK_BTN + '» به‌روزش کنید.');
    tgSend_(chat, L2.join('\n'), tgTherMenu_());
    try {
      tgDeskSay_('💼 <b>نرخ و ظرفیت</b> · ' + tgEsc_(st.name) +
        (v.rate ? '\nنرخ جلسه: ' + fa3(v.rate) + ' تومان' : '') +
        (String(v.suppl || '').indexOf('بله') === 0 ? '\nنرخ حمایتی: ' + fa3(v.suprate) + ' تومان · ' + tgEsc_(String(v.supcap || '')) : '') +
        '\nدر تب «' + TG_THER + '» قابل ویرایش است.');
    } catch (e) { tgErr_('deskSay: ' + e); }
    return;
  }
  var pct = tgPqPct_(v, st.w);
  tgPqPut_(st.id, { pct: pct, status: pct >= 60 ? 'منتظر بازبینی' : 'نیمه‌کاره', updated: tgPqNow_() });
  if (st.w === 'D') return tgSend_(chat, T_PQ_DONE_D, tgSchoolMenu_('دانشجو'));
  var miss = tgPqList_(st.w).filter(function (q) {
    return !tgPqAnswered_(v, q) && (!q.when || String(v[q.when] || '').indexOf('بله') === 0);
  }).map(function (q) { return q.l; });
  var L = [T_PQ_DONE_T, '', 'پروفایل شما: <b>' + tgFa_(pct) + '٪</b> کامل'];
  if (miss.length) L.push('هنوز خالی: ' + tgEsc_(miss.slice(0, 6).join('، ')) + (miss.length > 6 ? ' و …' : ''));
  tgSend_(chat, L.join('\n'), { inline_keyboard: [[{ text: '🌐 سایت تجربه', url: TG_PQ_SITE }]] });
  var note = '🪪 <b>پروفایل سایت</b> · ' + tgEsc_(st.name) + ' · ' + tgFa_(pct) + '٪\nدر تب «' + TG_PQ_TAB + '» منتظر بازبینی است.';
  try { tgPrNotify_(st.id, note + '\nهمین‌جا بازبینی و منتشرش کن.'); } catch (e) { tgErr_('prNotify: ' + e); }
  if (st.w.indexOf('T') < 0) { try { if (!TG_DRY) tgSchoolNotify_(note); } catch (e) {} }
  if (String(v.mode || '') === 'حضوری' && !String(v.modechk || '')) {
    tgPqPut_(st.id, { modechk: 'پرسیده شد · ' + tgPqNow_() });
    tgSend_(chat, T_PQ_MODECHK, TG_PQ_MODEKB);
  }
  try { tgInpOffer_(chat, st.id, v); } catch (e) { tgErr_('inpOffer: ' + e); }   /* TG_INP_OFFER فعلاً خاموش است */
}

/* بعد از اتصال دانشجو یا انتخاب حلقه: فقط اگر هنوز دانشگاهش را نگفته */
function tgPqUniOffer_(chat) {
  var who = tgPqWho_(chat);
  if (!who.name) return;
  var rec = tgPqRec_(tgPqId_(who), false);
  if (rec && String(rec.v.uni || '').trim()) return;
  tgSend_(chat, T_PQ_INTRO_D, { inline_keyboard: [[{ text: '🏛 جواب می‌دهم', callback_data: 'pq:gu' }]] });
}

/* ───── دعوت: یک بار برای هر نفر وصل‌شده. tgPqInvite(false) فقط گزارش می‌دهد. ───── */
function tgPqInvite(send) {
  var out = { ther: [], edu: [], stud: [], skip: 0 };
  var done = {};
  var rows = tgTherapistRows_();
  for (var i = 0; i < rows.length; i++) {
    var r = rows[i];
    if (!r.chat || String(r.status || '').indexOf('پایان') > -1) continue;
    out.ther.push({ name: r.name, chat: String(r.chat).split(/[,،;\s]+/)[0], id: 'ther:' + tgNorm_(r.name) });
    done[tgNorm_(r.name)] = 1;
  }
  var ppl = tgPeopleRows_();
  for (var j = 0; j < ppl.length; j++) {
    var p = ppl[j];
    if (!p.chat || p.status === 'غیرفعال') continue;
    var c0 = String(p.chat).split(/[,،;\s]+/)[0];
    var isEdu = p.roles.indexOf('استاد') > -1 || p.roles.indexOf('سوپروایزر') > -1 || p.roles.indexOf('درمانگر') > -1;
    if (isEdu && !done[tgNorm_(p.name)]) out.edu.push({ name: p.name, chat: c0, id: 'ppl:' + tgNorm_(p.name) });
    else if (p.roles.indexOf('دانشجو') > -1) out.stud.push({ name: p.name, chat: c0, id: 'ppl:' + tgNorm_(p.name), stud: 1 });
  }
  var all = out.ther.concat(out.edu, out.stud), sent = 0;
  if (send) {
    for (var k = 0; k < all.length; k++) {
      var a = all[k];
      var rec = tgPqRec_(a.id, false);
      if (rec && String(rec.v.invited || '').trim()) { out.skip++; continue; }
      try {
        var okd;
        if (a.stud) {
          var rs = tgSend_(a.chat, T_PQ_INTRO_D + '\n\nهر وقت آماده بودید دکمهٔ زیر را بزنید.',
                  { inline_keyboard: [[{ text: '🏛 جواب می‌دهم', callback_data: 'pq:gu' }]] });
          okd = !!(rs && rs.getResponseCode() === 200);
        } else {
          okd = tgPqGuide_(a.chat, 'سلام ' + tgEsc_(a.name) + '،\n\n' + T_PQ_INVITE);
        }
        if (!okd) { out.fail = (out.fail || []).concat(a.name); tgPqPut_(a.id, { name: a.name, chat: a.chat, status: 'پیام نرسید (chat not found)' }); continue; }
        tgPqPut_(a.id, { name: a.name, chat: a.chat, invited: tgPqNow_(), status: 'دعوت شد' });
        sent++;
        Utilities.sleep(250);
      } catch (e) { tgErr_('invite ' + a.name + ': ' + e); }
    }
  }
  var rep = 'درمانگر وصل: ' + out.ther.length + ' · استاد و سوپروایزر وصل: ' + out.edu.length + ' · دانشجوی وصل: ' + out.stud.length +
            (send ? ' · فرستاده شد: ' + sent + ' · قبلاً دعوت‌شده: ' + out.skip + (out.fail ? ' · نرسید: ' + out.fail.join('، ') : '') : ' (فقط گزارش)') +
            '\n' + all.map(function (x) { return x.name; }).join('، ');
  Logger.log(rep);
  return rep;
}

var T_PQ_INVITE = 'صفحه‌های تازهٔ درمانگرها و استادهای تجربه در حال ساخت است و می‌خواهیم صفحهٔ شما کامل و درست منتشر شود.\n\n' +
  'در این تصویر می‌بینید چه چیزهایی روی صفحه می‌آید: عکس، یک جملهٔ معرفی، توضیح روش درمان، آموزش‌هایی که خودتان می‌بینید، ' +

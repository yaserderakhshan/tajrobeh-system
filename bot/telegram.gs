/* ═══════════ پرسش‌نامهٔ پروفایل در مینی‌اپ (v58) ═══════════
   همان پرسش‌ها و همان تب «پروفایل سایت»؛ مینی‌اپ فقط راه دوم پرکردن است (قاعدهٔ «هر فیچر، هم بات هم مینی‌اپ»).
   عکس و رزومه‌ای که از مینی‌اپ می‌آید اول به گفت‌وگوی خود عضو با بات فرستاده می‌شود تا file_id تلگرام بگیرد؛
   پس بقیهٔ مسیر (درایو، بازبینی، انتشار) عیناً مثل پاسخی است که در بات داده شده. */

function tgPqApiWho_(chat) {
  var who = tgPqWho_(chat);
  var w = who.w.replace('D', '') || who.w;
  if (!w) return null;
  var id = tgPqId_(who);
  var rec = tgPqRec_(id, true, { name: who.name, roles: w, chat: String(chat), src: who.ther ? 'درمانگران' : 'افراد',
                                  status: 'در حال تکمیل', started: tgPqNow_() });
  if (!String(rec.v.roles || '').trim()) { tgPqPut_(id, { roles: w }); rec.v.roles = w; }
  return { who: who, w: w, id: id, rec: rec, st: { id: id, w: w, name: who.name, ther: !!who.ther, todo: [], i: 0, pick: [] } };
}

function tgPqApiList_(chat) {
  var x = tgPqApiWho_(chat);
  if (!x) return { ok: false, error: 'noid' };
  var v = x.rec.v, skipped = String(v.skipped || '').split(',');
  var qs = tgPqList_(x.w).filter(function (q) { return !q.when || String(v[q.when] || '').indexOf('بله') === 0; }).map(function (q) {
    var raw = String(v[q.k] || '').trim();
    var file = q.t === 'photo' || q.t === 'voice' || (q.t === 'file' && raw.indexOf('tg:') === 0);
    return { k: q.k, l: q.l, t: q.t, a: q.a, o: q.o || [], g: q.g || null, x: !!q.x, req: !!q.req, min: q.min || 0,
             has: !!raw, val: file ? (raw ? 'رسید' : '') : raw, skip: skipped.indexOf(q.k) > -1 };
  });
  var onsite = x.who.ther ? tgPqHasPhoto_(x.who.name) : false;
  return { ok: true, name: x.who.name, pct: tgPqPct_(v, x.w), status: String(v.status || ''), qs: qs, page: String(v.page || ''),
           photoOnSite: onsite, guide: TG_PQ_GUIDE, site: TG_PQ_SITE };
}

/* فایل را به گفت‌وگوی خود عضو می‌فرستد و file_id برمی‌گرداند */
function tgPqUpload_(chat, kind, b64, name, mime) {
  if (TG_DRY) return 'FID-' + kind;
  var token = PropertiesService.getScriptProperties().getProperty('TELEGRAM_TOKEN');
  var blob = Utilities.newBlob(Utilities.base64Decode(b64), mime || (kind === 'photo' ? 'image/jpeg' : 'application/octet-stream'), name || (kind === 'photo' ? 'photo.jpg' : 'file'));
  var method = kind === 'photo' ? 'sendPhoto' : 'sendDocument';
  var payload = { chat_id: String(chat), caption: kind === 'photo' ? 'عکس پروفایل شما از مینی‌اپ رسید ✅' : 'رزومهٔ شما از مینی‌اپ رسید ✅' };
  payload[kind === 'photo' ? 'photo' : 'document'] = blob;
  var res = tgFetchRetry_('https://api.telegram.org/bot' + token + '/' + method, { method: 'post', payload: payload, muteHttpExceptions: true });
  var j = JSON.parse(res.getContentText());
  if (!j.ok) throw new Error(j.description || 'upload');
  if (kind === 'photo') { var ph = j.result.photo; return ph[ph.length - 1].file_id; }
  return j.result.document.file_id;
}

function tgPqApiSave_(chat, p) {
  var x = tgPqApiWho_(chat);
  if (!x) return { ok: false, error: 'noid' };
  var q = tgPqQ_(String(p.k || ''));
  if (!q || tgPqList_(x.w).indexOf(q) < 0) return { ok: false, error: 'key' };
  if (p.skip) {
    if (q.req) return { ok: false, error: 'req', msg: 'این یکی لازم است.' };
    var sk = String(x.rec.v.skipped || '');
    if ((',' + sk + ',').indexOf(',' + q.k + ',') < 0) tgPqPut_(x.id, { skipped: sk ? sk + ',' + q.k : q.k });
    return { ok: true };
  }
  var val = String(p.v == null ? '' : p.v).trim(), bad = '';
  if (['text', 'long'].indexOf(q.t) > -1 && TG_PQ_URLQ.indexOf(q.k) < 0 && tgOkBad_(val)) bad = 'اینجا لینک، ایمیل یا شماره جا ندارد.';   /* v170.23.6 */
  else if (q.t === 'choice') { if (q.o.indexOf(val) < 0) bad = 'یکی از گزینه‌ها را بزنید.'; }
  else if (q.t === 'multi') {
    var picks = val.split(/\s*[،,]\s*/).filter(String);
    if (!picks.length || picks.some(function (a) { return q.o.indexOf(a) < 0 && !(q.x && a.length > 1 && a.length <= 60); })) bad = 'دست‌کم یکی را بزنید.';
    else val = picks.join('، ');
  } else if (q.t === 'year') {
    var y = Number(tgLatinDigits_(val).replace(/\D/g, ''));
    if (y >= 1960 && y <= 2030) y = y - 621;
    if (!(y >= 1340 && y <= 1410)) bad = 'فقط سال را بنویسید، مثلاً ۱۳۹۸.'; else val = String(y);
  } else if (q.t === 'email') {
    var em = String(tgLatinDigits_(val)).trim().replace(/\s+/g, '');
    if (!/^[^@\s]+@[^@\s.]+\.[^@\s]{2,}$/.test(em)) bad = 'آدرس ایمیل را کامل بنویسید.'; else val = em;
  } else if (q.t === 'money') {
    var mn = Number(String(tgLatinDigits_(val)).replace(/[^0-9]/g, ''));
    if (!(mn >= (q.lo || 0) && mn <= (q.hi || 1e12))) bad = q.bad || 'فقط عدد را بنویسید.'; else val = String(mn);
  } else if (q.t === 'photo') {
    if (!p.b64) bad = 'عکس را انتخاب کنید.';
    else if (String(p.b64).length > 11000000) bad = 'عکس خیلی بزرگ است.';
    else val = 'tg:photo:' + tgPqUpload_(chat, 'photo', p.b64, 'photo.jpg', 'image/jpeg');
  } else if (q.t === 'file') {
    if (p.b64) {
      if (String(p.b64).length > 14000000) bad = 'فایل خیلی بزرگ است (حداکثر ۱۰ مگابایت).';
      else val = 'tg:doc:' + tgPqUpload_(chat, 'doc', p.b64, String(p.name || 'resume').slice(0, 80), p.mime) + ' · ' + String(p.name || 'resume').slice(0, 80);
    } else if (!/^https?:\/\//i.test(val)) bad = 'فایل را انتخاب کنید یا لینکش را بنویسید.';
  } else if (q.t === 'voice') {
    bad = 'ویس را در گفت‌وگوی بات بفرستید.';
  } else {
    var min = q.min || (q.t === 'long' ? 20 : 2);
    if (val.length < min) bad = 'کمی کامل‌تر بنویسید.'; else val = val.slice(0, 3000);
  }
  if (bad) return { ok: false, error: 'bad', msg: bad };
  tgPqSave_(chat, x.st, q, val);
  if (/^tg:/.test(val)) tgPqArchiveSafe_(x.id, x.who.name, q.k);
  var rec = tgPqRec_(x.id, false);
  return { ok: true, pct: tgPqPct_(rec ? rec.v : {}, x.w) };
}

function tgPqApiDone_(chat) {
  var x = tgPqApiWho_(chat);
  if (!x) return { ok: false, error: 'noid' };
  tgPqFinish_(chat, x.st);
  var rec = tgPqRec_(x.id, false);
  return { ok: true, pct: tgPqPct_(rec ? rec.v : {}, x.w), done: T_PQ_DONE_T.replace(/<[^>]+>/g, '') };
}

function tgApiPq_(p) {
  var user = tgVerifyInitData_(p.initData);
  if (!user || !user.id) return { ok: false, error: 'auth' };
  var chat = user.id, api = String(p.api);
  if (api === 'pq') return tgPqApiList_(chat);
  if (api === 'pqsave') return tgPqApiSave_(chat, p);
  if (api === 'pqdone') return tgPqApiDone_(chat);
  return { ok: false, error: 'unknown' };
}

function tgPqApiTests() {
  var out = [], pass = 0, fail = 0;

  tgPqPut_(v.id, { site_photo: 'ندارد', review: tgPqNow_() + ' · ' + tgPrWho_(chat), rstamp: String(Date.now()) });
  var n = 0;
  ((res && res.pages) || []).forEach(function (p) { n += ((p.changes || []).length); });
  var s = '🚫 عکس ' + tgEsc_(nm) + ' برداشته شد (' + tgFa_(n) + ' کارت) و صفحهٔ شخصی‌اش بی‌عکس شد.\nپیام راهنمای عکس برایش برود؟';
  return tgSend_(chat, s, { inline_keyboard: [
    [{ text: '📩 بله، بفرست', callback_data: 'pr:pm:' + r.row + ':' + tgPrH_(v.id) }],
    [{ text: '🙏 فعلاً نه', callback_data: 'pr:nx:' + r.row + ':' + tgPrH_(v.id) }]
  ] });
}

function tgPrPhotoMsg_(chat, r) {
  var v = r.v;

/* ---------- شیت ---------- */

function tgSchSS_() { return SpreadsheetApp.openById(TG_SCHOOL_SHEET_ID); }

function tgSchSheet_(tab, head) {
  if (TG_DRY) return null;
  var ss = tgSchSS_(), sh = ss.getSheetByName(tab);
  if (!sh) {
    sh = ss.insertSheet(tab);
    sh.setRightToLeft(true);
    sh.getRange(1, 1, 1, head.length).setValues([head]).setFontWeight('bold').setBackground('#f9f2f2');
    sh.setFrozenRows(1);
  } else if (head && head.length && sh.getMaxColumns() < head.length) {
    /* v142: ستون تازه‌ای به انتهای سرستون اضافه شده (مثل «وبینار»)؛ تا ساخته نشود خواندن با عرض کامل خطا می‌دهد */
    try {
      var have = sh.getMaxColumns();
      sh.insertColumnsAfter(have, head.length - have);
      sh.getRange(1, have + 1, 1, head.length - have).setValues([head.slice(have)]).setFontWeight('bold').setBackground('#f9f2f2');
    } catch (eCol) { tgErr_('tgSchSheet_ ستون تازه: ' + eCol); }
  }
  return sh;
}

function tgSchRows_(tab, head, width) {
  if (TG_DRY) return TG_MEM['sch' + tab] || [];
  var sh = tgSchSheet_(tab, head);
  if (!sh || sh.getLastRow() < 2) return [];
  return sh.getRange(2, 1, sh.getLastRow() - 1, width || head.length).getValues();
}

/* دوره‌ها و حلقه‌ها با کش پنج‌دقیقه‌ای */
function tgSchCourses_() {
  var hit = tgCacheGet_('schc');
  if (hit) { try { return JSON.parse(hit); } catch (e) {} }
  var out = [];
  try {
    var v = tgSchRows_(TG_SCH_T_COURSE, ['کد دوره'], 8);
    for (var i = 0; i < v.length; i++) {
      var code = String(v[i][0] || '').trim();
      if (!code) continue;
      out.push({ code: code, name: String(v[i][1] || '').trim(), page: String(v[i][2] || '').trim(),
                 status: String(v[i][3] || '').trim(), key: String(v[i][7] || '').trim() });
    }
    if (!TG_DRY) CacheService.getScriptCache().put('schc', JSON.stringify(out), 300);
  } catch (e) { tgErr_('tgSchCourses_: ' + e); }
  return out;
}

function tgSchCircles_() {
  var hit = tgCacheGet_('schr');
  if (hit) { try { return JSON.parse(hit); } catch (e) {} }
  var out = [];
  try {
    var v = tgSchRows_(TG_SCH_T_CIRCLE, ['کد حلقه'], 10);
    for (var i = 0; i < v.length; i++) {
      var code = String(v[i][0] || '').trim();
      if (!code) continue;
      out.push({ code: code, course: String(v[i][1] || '').trim(), name: String(v[i][2] || '').trim(),
                 status: String(v[i][3] || '').trim(), cal: String(v[i][6] || '').trim() });
    }
    if (!TG_DRY) CacheService.getScriptCache().put('schr', JSON.stringify(out), 300);
  } catch (e) { tgErr_('tgSchCircles_: ' + e); }
  return out;
}

function tgSchDropCache_() {
  if (TG_DRY) return;
  var c = CacheService.getScriptCache();
  c.remove('schc'); c.remove('schr'); c.remove('plist'); c.remove('wlist'); c.remove('trows');
}

function tgSchCourseByCode_(code) {
  var l = tgSchCourses_();
  for (var i = 0; i < l.length; i++) if (l[i].code === code) return l[i];
  return null;
}

function tgSchNextId_(tab, head, prefix) {
  var v = tgSchRows_(tab, head, 1), max = 0;
  for (var i = 0; i < v.length; i++) {
    var m = String(v[i][0] || '').match(new RegExp('^' + prefix + '-(\\d+)$'));
    if (m && Number(m[1]) > max) max = Number(m[1]);
  }
  return prefix + '-' + (max + 1 < 100 ? ('00' + (max + 1)).slice(-3) : String(max + 1));
}

/* ---------- عضویت: نوشتن ---------- */

function tgSchAddMember_(o) {
  if (TG_DRY) { (TG_MEM['schmem'] = TG_MEM['schmem'] || []).push(o); return 'م-000'; }
  var sh = tgSchSheet_(TG_SCH_T_MEM, TG_SCH_MEM_HEAD);
  var id = tgSchNextId_(TG_SCH_T_MEM, TG_SCH_MEM_HEAD, 'م');
  sh.appendRow([id, o.name || '', o.user || '', String(o.chat || ''), o.course || '', o.circle || '',
                o.ccode || '', o.role || 'دانشجو', o.status || 'فعال', tgJDateFull_(new Date(), TG_TZ),
                o.phone || '', o.uni || '', o.src || 'بات', o.note || '']);
  return id;
}

function tgSchHasMember_(chat, course, circle) {
  var v = tgSchRows_(TG_SCH_T_MEM, TG_SCH_MEM_HEAD, 14);
  for (var i = 0; i < v.length; i++) {
    if (String(v[i][3]).trim() !== String(chat)) continue;
    if (course && String(v[i][4]).trim() !== course) continue;
    if (circle && String(v[i][5]).trim() !== circle) continue;
    return true;
  }
  return false;
}

function tgSchAddTeacher_(o) {
  if (TG_DRY) { (TG_MEM['schtea'] = TG_MEM['schtea'] || []).push(o); return; }
  var sh = tgSchSheet_(TG_SCH_T_TEA, TG_SCH_TEA_HEAD);
  sh.appendRow([o.name || '', o.user || '', String(o.chat || ''), o.role || 'استاد', o.course || '',
                '', '', 'فعال', o.phone || '', o.note || '']);
}

/* نقش مدرسه را به سطر «افراد» اضافه می‌کند، بدون دست‌زدن به بقیهٔ نقش‌ها */
function tgSchGrantRole_(p, role, circleLabel) {
  if (TG_DRY || !p) return;
  try {
    var cur = tgPeopleSheet_().getRange(p.row, 5, 1, 2).getValues()[0];
    var ch = { addRole: role };
    if (p.chatNew) ch.addChat = String(p.chatNew);
    if (String(cur[1] || '').trim() !== 'فعال') ch['وضعیت'] = 'فعال';
    if (circleLabel && !String(cur[0] || '').trim()) ch['حلقه یا دوره'] = circleLabel;
    tgPersonSet_(p.row, ch, 'بات', { why: 'مدرسه: ' + role });
    tgSchDropCache_();
  } catch (e) { tgErr_('tgSchGrantRole_: ' + e); }
}

function tgSchNewPerson_(o) {
  if (TG_DRY) return null;
  try {
    var made = tgPersonAdd_({ name: o.name, user: o.user, chat: o.chat, roles: o.role || 'دانشجو', circle: o.circle,
                              phone: o.phone, note: o.note, uni: o.uni }, 'بات', { why: 'مدرسه' });
    tgSchDropCache_();
    return made.row;
  } catch (e) { tgErr_('tgSchNewPerson_: ' + e); return null; }
}

/* ---------- ویزارد عضویت ---------- */

function tgSjGet_(chat) {
  var raw = tgGetVal_('sjd', chat);
  if (!raw) return null;
  try { return JSON.parse(raw); } catch (e) { return null; }
}
function tgSjPut_(chat, d) { tgSetVal_('sjd', chat, JSON.stringify(d)); }
function tgSjEnd_(chat) { tgDel_('sjd', chat); }

function tgSjStart_(chat, uname) {
  tgSjPut_(chat, { step: 'role', user: uname || '' });
  return tgSend_(chat, T_SJ_ROLE, { inline_keyboard: [
    [{ text: '🎓 دانشجو', callback_data: 'sj:r:دانشجو' }],
    [{ text: '📚 استاد', callback_data: 'sj:r:استاد' }],
    [{ text: '🧑‍🏫 سوپروایزر', callback_data: 'sj:r:سوپروایزر' }],
    [{ text: TG_COMM_BTN, callback_data: 'sj:comm' }]
  ] });
}

function tgSjAskCourse_(chat, d) {
  var cs = tgSchCourses_(), kb = [];
  for (var i = 0; i < cs.length; i++) {
    if (cs[i].code === 'COMM' || cs[i].code === 'ASSOC') continue;
    var tag = cs[i].status === 'فعال' ? '' : ' (' + cs[i].status + ')';
    kb.push([{ text: cs[i].name + tag, callback_data: 'sj:c:' + cs[i].code }]);
  }
  kb.push([{ text: 'هنوز نمی‌دانم', callback_data: 'sj:c:?' }]);
  d.step = 'course'; tgSjPut_(chat, d);
  return tgSend_(chat, T_SJ_COURSE, { inline_keyboard: kb });
}

function tgSjAskCircle_(chat, d) {
  var rs = tgSchCircles_(), kb = [], row = [];
  for (var i = 0; i < rs.length; i++) {
    if (rs[i].course !== d.course) continue;
    if (rs[i].status !== 'فعال') continue;
    row.push({ text: rs[i].name, callback_data: 'sj:l:' + rs[i].code });
    if (row.length === 3) { kb.push(row); row = []; }
  }
  if (row.length) kb.push(row);
  kb.push([{ text: 'هنوز نمی‌دانم', callback_data: 'sj:l:?' }]);
  if (kb.length === 1) { d.circle = ''; d.ccode = ''; return tgSjAskName_(chat, d); }
  d.step = 'circle'; tgSjPut_(chat, d);
  return tgSend_(chat, T_SJ_CIRCLE, { inline_keyboard: kb });
}

function tgSjAskName_(chat, d) {
  d.step = 'name'; tgSjPut_(chat, d);
  return tgSend_(chat, T_SJ_NAME, { keyboard: [[TG_SJ_BACK]], resize_keyboard: true });
}

function tgSjAskPhone_(chat, d) {
  d.step = 'phone'; tgSjPut_(chat, d);
  return tgSend_(chat, T_SJ_PHONE, {
    keyboard: [[{ text: '📱 فرستادن شماره', request_contact: true }], [TG_SJ_BACK]], resize_keyboard: true });
}

function tgSjAskMail_(chat, d) {
  d.step = 'mail'; tgSjPut_(chat, d);
  return tgSend_(chat, T_SJ_MAIL, { keyboard: [[TG_SJ_SKIP], [TG_SJ_BACK]], resize_keyboard: true });
}

function tgSjAskUni_(chat, d) {
  d.step = 'uni'; tgSjPut_(chat, d);
  return tgSend_(chat, T_SJ_UNI, { keyboard: [[TG_SJ_SKIP], [TG_SJ_BACK]], resize_keyboard: true });
}

function tgSjAskNote_(chat, d) {
  d.step = 'note'; tgSjPut_(chat, d);
  return tgSend_(chat, T_SJ_NOTE, { keyboard: [[TG_SJ_SKIP], [TG_SJ_BACK]], resize_keyboard: true });
}

/* ---------- ثبت نهایی ---------- */

function tgSjReqOpen_(chat) {
  var v = tgSchRows_(TG_SCH_T_REQ, TG_SCH_REQ_HEAD, 16);
  for (var i = 0; i < v.length; i++) {
    if (String(v[i][4]).trim() === String(chat) && String(v[i][12]).trim() === TG_SJ_ST.wait) return String(v[i][0]).trim();
  }
  return '';
}

function tgSjFinish_(chat, d) {
  tgSjEnd_(chat);
  var role = d.role || 'دانشجو';
  var course = d.course || '';
  var circle = d.circle || '';

  /* اول فهرست تجربه: اگر هست، همین‌جا وصلش می‌کنیم و منتظر تأیید نمی‌ماند */
  var p = tgSjMatch_(d.name, chat);
  if (p) {
    p.chatNew = chat;
    tgSchGrantRole_(p, role, circle);
    if (role === 'دانشجو') {
      if (!tgSchHasMember_(chat, course, circle)) {
        tgSchAddMember_({ name: p.name, user: d.user, chat: chat, course: course, circle: circle,
                          ccode: d.ccode || '', role: 'دانشجو', status: 'فعال', phone: d.phone,
                          uni: d.uni, src: 'بات · خوداظهاری', note: d.note });
      }
    } else {
      tgSchAddTeacher_({ name: p.name, user: d.user, chat: chat, role: role, course: course,
                         phone: d.phone, note: d.note });
    }
    tgDel_('role', chat);
    tgSchoolNotify_('🎓 <b>' + tgEsc_(p.name) + '</b> از فهرست تجربه پیدا شد و خودش را به‌عنوان «' +
                    tgEsc_(role) + '» وصل کرد.' + (course ? '\nدوره: ' + tgEsc_(course) : '') +
                    (circle ? ' · ' + tgEsc_(circle) : '') + '\nدر هاب مدرسه ثبت شد.');
    tgSend_(chat, T_SJ_FOUND + '\n\nنقش شما: ' + tgEsc_(role) +
            (course ? '\nدوره: ' + tgEsc_(course) : '') + (circle ? '\nحلقه: ' + tgEsc_(circle) : ''),
            typeof tgSchoolMenu_ === 'function' ? tgSchoolMenu_(role === 'دانشجو' ? 'دانشجو' : role) : tgMenu_());
    return true;
  }

  /* نیست: درخواست ثبت می‌شود و می‌رود روی میز مسئول مدرسه */
  var dup = tgSjReqOpen_(chat);
  if (dup) { tgSend_(chat, T_SJ_DUP, tgMenu_()); return true; }
  var id = tgSjSaveReq_(chat, d);
  tgSend_(chat, T_SJ_SENT, tgMenu_());
  tgSjNotifyOwners_(id, d, chat);
  return true;
}

function tgSjMatch_(name, chat) {
  var q = tgNorm_(name || '');
  if (!q || q.length < 5) return null;
  var list = tgPeopleList_(), exact = [], part = [];
  var w = q.split(' ').filter(function (x) { return x.length > 2; });
  for (var i = 0; i < list.length; i++) {
    var nm = tgNorm_(list[i].name);
    if (!nm) continue;
    if (nm === q) { exact.push(list[i]); continue; }
    if (w.length > 1) {
      var all = true;
      for (var k = 0; k < w.length; k++) if (nm.indexOf(w[k]) < 0) { all = false; break; }
      if (all) part.push(list[i]);
    }
  }
  var hits = exact.length ? exact : part;
  if (hits.length !== 1) return null;
  var p = hits[0];
  if (String(p.status).trim() === 'غیرفعال') return null;
  if (p.chat && !tgChatIn_(p.chat, chat)) return null;
  return p;
}

function tgSjSaveReq_(chat, d) {
  if (TG_DRY) { (TG_MEM['schreq'] = TG_MEM['schreq'] || []).push(d); return 'د-000'; }
  var sh = tgSchSheet_(TG_SCH_T_REQ, TG_SCH_REQ_HEAD);
  var id = tgSchNextId_(TG_SCH_T_REQ, TG_SCH_REQ_HEAD, 'د');
  sh.appendRow([id, tgJDateFull_(new Date(), TG_TZ), d.name || '', d.user || '', String(chat),
                d.role || 'دانشجو', d.course || '', d.circle || '', tgSchPhoneStore_(d.phone || ''), d.mail || '',
                d.uni || '', d.note || '', TG_SCH_ST_OPEN, '', '', '']);
  try { tgSlSet_(sh.getLastRow(), { 'مرحلهٔ قیف': TG_SCH_STAGES[TG_SCH_SG.lead], 'منبع': 'بات', 'کد کمپین': tgSchCampFromSrc_('', d.course) }, 'بات'); } catch (eS) {}
  return id;
}

function tgSjReqRow_(id) {
  if (TG_DRY) return null;
  var sh = tgSchSheet_(TG_SCH_T_REQ, TG_SCH_REQ_HEAD);
  if (!sh || sh.getLastRow() < 2) return null;
  var v = sh.getRange(2, 1, sh.getLastRow() - 1, 16).getValues();
  for (var i = 0; i < v.length; i++) {
    if (String(v[i][0]).trim() === String(id)) {
      return { sh: sh, row: i + 2, id: String(v[i][0]).trim(), date: v[i][1], name: String(v[i][2] || ''),
               user: String(v[i][3] || ''), chat: String(v[i][4] || ''), role: String(v[i][5] || ''),
               course: String(v[i][6] || ''), circle: String(v[i][7] || ''), phone: String(v[i][8] || ''),
               mail: String(v[i][9] || ''), uni: String(v[i][10] || ''), note: String(v[i][11] || ''),
               status: String(v[i][12] || '').trim() };
    }
  }
  return null;
}

function tgSjCard_(r) {
  return '🎓 <b>درخواست عضویت مدرسه</b> · ' + tgEsc_(r.id) + '\n\n' +
    '<b>' + tgEsc_(r.name) + '</b>' + (r.user ? ' ' + tgEsc_(r.user) : '') + '\n' +
    'نقش درخواستی: ' + tgEsc_(r.role) + '\n' +
    (r.course ? 'دوره: ' + tgEsc_(r.course) + (r.circle ? ' · ' + tgEsc_(r.circle) : '') + '\n' : '') +
    (r.phone ? 'شماره: ' + tgEsc_(r.phone) + '\n' : '') +
    (r.mail ? 'ایمیل: ' + tgEsc_(r.mail) + '\n' : '') +
    (r.uni ? 'رشته و دانشگاه: ' + tgEsc_(r.uni) + '\n' : '') +
    (r.note ? '\nتوضیح خودش:\n' + tgEsc_(r.note) + '\n' : '') +
    '\nدر تب «لیدهای مدرسه» هاب مدرسه ثبت شد.';
}

function tgSjKb_(id) {
  return { inline_keyboard: [
    [{ text: '✅ تأیید عضویت', callback_data: 'sj:ok:' + id }],
    [{ text: '❓ سؤال دارم', callback_data: 'sj:q:' + id }, { text: '❌ رد', callback_data: 'sj:no:' + id }]
  ] };
}

function tgSjNotifyOwners_(id, d, chat) {
  var r = tgSjReqRow_(id) || { id: id, name: d.name, user: d.user, role: d.role, course: d.course,
                               circle: d.circle, phone: d.phone, mail: d.mail, uni: d.uni, note: d.note };
  try {
    var own = tgSchoolOwners_();
    for (var i = 0; i < own.length; i++) tgSend_(own[i].chat, tgSjCard_(r), tgSjKb_(id));
    if (!own.length) tgErr_('tgSjNotifyOwners_: هیچ مسئول مدرسه‌ای chat_id ندارد');
    if (typeof opsAdaptSchool_ === 'function') opsAdaptSchool_(id, own.length ? tgMagFirst_(own[0].chat) : '');
  } catch (e) { tgErr_('tgSjNotifyOwners_: ' + e); }
}

function tgSjIsOwner_(chat) {
  try {
    var own = tgSchoolOwners_();
    for (var i = 0; i < own.length; i++) if (tgChatIn_(own[i].chat, chat)) return own[i];
  } catch (e) {}
  return null;
}

/* ---------- تصمیم مسئول مدرسه ---------- */

function tgSjDecide_(chat, id, what, who) {
  var r = tgSjReqRow_(id);
  if (!r) return tgSend_(chat, T_SJ_GONE);
  if (r.status !== TG_SJ_ST.wait && r.status !== TG_SCH_ST_OPEN && r.status !== TG_SJ_ST.more && what !== 'q') return tgSend_(chat, T_SJ_GONE);
  var now = tgJDateFull_(new Date(), TG_TZ);
  if ((what === 'ok' || what === 'no') && typeof opsAdaptDone_ === 'function') opsAdaptDone_(id, what === 'no');

  if (what === 'ok') {
    var p = tgSjMatch_(r.name, r.chat);
    if (p) { p.chatNew = r.chat; tgSchGrantRole_(p, r.role, r.circle); }
    else {
      tgSchNewPerson_({ name: r.name, user: r.user, chat: r.chat, role: r.role, circle: r.circle,
                        phone: r.phone, uni: r.uni, note: 'از درخواست ' + r.id + ' در بات' });
    }
    if (r.role === 'دانشجو') {
      if (!tgSchHasMember_(r.chat, r.course, r.circle)) {
        tgSchAddMember_({ name: r.name, user: r.user, chat: r.chat, course: r.course, circle: r.circle,
                          role: 'دانشجو', status: 'فعال', phone: r.phone, uni: r.uni,
                          src: 'درخواست ' + r.id, note: r.note });
      }
    } else {
      tgSchAddTeacher_({ name: r.name, user: r.user, chat: r.chat, role: r.role, course: r.course,
                         phone: r.phone, note: 'از درخواست ' + r.id });
    }
    r.sh.getRange(r.row, 14, 1, 2).setValues([[who ? who.name : String(chat), now]]);
    tgSlSet_(r.row, { 'وضعیت': TG_SCH_ST_DONE, 'مرحلهٔ قیف': TG_SCH_STAGES[TG_SCH_SG.done] }, who ? who.name : 'مدرسه');
    tgSchDropCache_();
    if (r.chat) { tgDel_('role', r.chat); tgSend_(r.chat, T_SJ_OKMSG); }
    return tgSend_(chat, '✅ تأیید شد و در هاب مدرسه ثبت شد: ' + tgEsc_(r.name));
  }

  if (what === 'no') {
    r.sh.getRange(r.row, 14, 1, 2).setValues([[who ? who.name : String(chat), now]]);
    tgSlSet_(r.row, { 'وضعیت': 'عدم پذیرش' }, who ? who.name : 'مدرسه');
    if (r.chat) tgSend_(r.chat, T_SJ_NOMSG);
    return tgSend_(chat, '❌ رد شد: ' + tgEsc_(r.name));
  }

  if (what === 'q') {
    tgSlNote_(r.row, 'سؤال از متقاضی', who ? who.name : 'مدرسه');
    tgSetVal_('sjq', chat, id);
    return tgSend_(chat, 'سؤالتان را بنویسید تا برای ' + tgEsc_(r.name) + ' بفرستم.',
                   { keyboard: [[TG_SJ_BACK]], resize_keyboard: true });
  }
  return null;
}

function tgSjQueue_(chat) {
  /* v142: صف عضویت فقط درخواست‌های حلقه‌دارِ بی‌کمپین؛ لیدهای کمپین از «کارهای مدرسه» پیگیری می‌شوند */
  var v = tgSchRows_(TG_SCH_T_REQ, TG_SCH_REQ_HEAD, 26), n = 0;
  for (var i = 0; i < v.length; i++) {
    var stt = String(v[i][12]).trim();
    if (stt !== TG_SJ_ST.wait && stt !== TG_SJ_ST.more && stt !== TG_SCH_ST_OPEN) continue;
    if (String(v[i][25] || '').trim()) continue;
    if (!String(v[i][7] || '').trim() && String(v[i][5] || '').trim() === 'دانشجو') continue;
    var r = tgSjReqRow_(String(v[i][0]).trim());
    if (r) { tgSend_(chat, tgSjCard_(r), tgSjKb_(r.id)); n++; }
    if (n >= 10) break;
  }
  if (!n) tgSend_(chat, T_SJ_EMPTY);
  return true;
}

/* ---------- کامیونیتی ---------- */

function tgCommHas_(chat) {
  var v = tgSchRows_(TG_SCH_T_COMM, TG_SCH_COMM_HEAD, 11);
  for (var i = 0; i < v.length; i++) if (String(v[i][3]).trim() === String(chat)) return true;
  return false;
}

function tgCommStart_(chat, uname) {
  if (tgCommHas_(chat)) return tgSend_(chat, T_COMM_DUP, tgMenu_());
  tgSjPut_(chat, { step: 'cname', user: uname || '', kind: 'comm' });
  return tgSend_(chat, T_COMM_INTRO + '\n\n' + T_SJ_NAME, { keyboard: [[TG_SJ_BACK]], resize_keyboard: true });
}

function tgCommSave_(chat, d) {
  tgSjEnd_(chat);
  if (!TG_DRY) {
    tgSchSheet_(TG_SCH_T_COMM, TG_SCH_COMM_HEAD).appendRow([
      tgJDateFull_(new Date(), TG_TZ), d.name || '', d.user || '', String(chat), d.mail || '',
      d.phone || '', d.uni || '', '', 'بات', 'فعال', '']);
  }
  try { tgSchoolNotify_('💌 عضو تازهٔ کامیونیتی: <b>' + tgEsc_(d.name || '') + '</b>' +
                        (d.uni ? ' · ' + tgEsc_(d.uni) : '')); } catch (e) {}
  return tgSend_(chat, T_COMM_OK, tgMenu_());
}

/* ---------- مسیریاب متن ---------- */

function tgSjText_(chat, name, uname, text) {
  var s = String(text || '').trim();

  if (s === TG_SJ_BTN || s === '/join' || s.indexOf('عضویت در مدرسه') > -1) { tgSjStart_(chat, uname); return true; }
  if (s === TG_COMM_BTN || s === '/community' || s.indexOf('عضویت در کامیونیتی') > -1) { tgCommStart_(chat, uname); return true; }
  if (s === TG_SJ_DESK || s === '/schreq') {
    if (!tgSjIsOwner_(chat)) return false;
    return tgSjQueue_(chat);
  }

  /* مسئول مدرسه سؤالش را می‌نویسد */
  var qid = tgGetVal_('sjq', chat);
  if (qid) {
    if (s === TG_SJ_BACK || s === 'بازگشت' || s === 'انصراف') { tgDel_('sjq', chat); tgSend_(chat, 'باشد.'); return true; }
    var r = tgSjReqRow_(qid);
    tgDel_('sjq', chat);
    if (r && r.chat) {
      tgSend_(r.chat, T_SJ_MOREQ + '\n\n' + tgEsc_(s) + '\n\nجوابتان را همین‌جا بنویسید.');
      tgSetVal_('sja', r.chat, qid);
      r.sh.getRange(r.row, 16).setValue(String(r.sh.getRange(r.row, 16).getValue() || '') + '\nسؤال: ' + s);
      tgSend_(chat, 'فرستاده شد.');
    } else { tgSend_(chat, T_SJ_GONE); }
    return true;
  }

  /* متقاضی جواب سؤال را می‌دهد */
  var aid = tgGetVal_('sja', chat);
  if (aid && s && s.indexOf('/') !== 0) {
    var r2 = tgSjReqRow_(aid);
    tgDel_('sja', chat);
    if (r2) {
      r2.sh.getRange(r2.row, 16).setValue(String(r2.sh.getRange(r2.row, 16).getValue() || '') + '\nجواب: ' + s);
      r2.sh.getRange(r2.row, 13).setValue(TG_SJ_ST.wait);
      var own = tgSchoolOwners_();
      for (var i = 0; i < own.length; i++) {
        tgSend_(own[i].chat, '💬 جواب ' + tgEsc_(r2.name) + ' برای ' + tgEsc_(r2.id) + ':\n\n' + tgEsc_(s), tgSjKb_(r2.id));
      }
      tgSend_(chat, 'رسید. به مدرسه رساندیم.');
    }
    return true;
  }

  var d = tgSjGet_(chat);
  if (!d) return false;
  if (s === TG_SJ_BACK || s === 'بازگشت' || s === 'انصراف' || tgCmd_(s) === '/start') {
    tgSjEnd_(chat); tgSend_(chat, 'باشد، برگشتیم.', tgMenu_()); return true;
  }

  /* v166.24: دکمهٔ منو وسط نام یا شماره، گفت‌وگو را می‌بندد و همان دکمه کار خودش را می‌کند */
  if ((d.step === 'name' || d.step === 'cname' || d.step === 'phone') && tgIsBtnLike_(s) && s !== TG_SJ_SKIP) { tgSjEnd_(chat); return false; }
  if (d.step === 'name' || d.step === 'cname') {
    if (tgNorm_(s).length < 5) { tgSend_(chat, T_SJ_SHORT); return true; }
    d.name = s;
    if (d.step === 'cname') { d.step = 'cuni'; tgSjPut_(chat, d);
      tgSend_(chat, T_COMM_UNI, { keyboard: [[TG_SJ_SKIP], [TG_SJ_BACK]], resize_keyboard: true }); return true; }
    tgSjAskPhone_(chat, d); return true;
  }
  if (d.step === 'cuni') {
    d.uni = (s === TG_SJ_SKIP) ? '' : s;
    tgCommSave_(chat, d); return true;
  }
  if (d.step === 'phone') {
    if (!tgLooksLikePhone_(s)) { tgSend_(chat, T_SJ_BADPH); return true; }
    d.phone = s; tgSjAskMail_(chat, d); return true;
  }
  if (d.step === 'mail') { d.mail = (s === TG_SJ_SKIP) ? '' : s; tgSjAskUni_(chat, d); return true; }
  if (d.step === 'uni')  { d.uni  = (s === TG_SJ_SKIP) ? '' : s; tgSjAskNote_(chat, d); return true; }
  if (d.step === 'note') { d.note = (s === TG_SJ_SKIP) ? '' : s; return tgSjFinish_(chat, d); }
  return false;
}

function tgSjContact_(chat, contact) {
  var d = tgSjGet_(chat);
  if (!d || d.step !== 'phone') return false;
  d.phone = String(contact.phone_number || '');
  tgSjAskMail_(chat, d);
  return true;
}

/* ---------- مسیریاب دکمه ---------- */

function tgSjCb_(cq, arg) {
  var chat = cq.message.chat.id;
  var uname = cq.from.username ? '@' + cq.from.username : '';
  if (arg === 'new') return tgSjStart_(chat, uname);
  if (arg === 'comm') return tgCommStart_(chat, uname);

  if (arg.indexOf('r:') === 0) {
    var d = tgSjGet_(chat) || { user: uname };
    d.role = arg.slice(2); d.user = d.user || uname;
    return tgSjAskCourse_(chat, d);
  }
  if (arg.indexOf('c:') === 0) {
    var d2 = tgSjGet_(chat); if (!d2) return tgSjStart_(chat, uname);
    var code = arg.slice(2);
    if (code === '?') { d2.course = ''; d2.ccode = ''; return tgSjAskName_(chat, d2); }
    var c = tgSchCourseByCode_(code);
    d2.course = c ? c.name : '';
    if (d2.role !== 'دانشجو') return tgSjAskName_(chat, d2);
    return tgSjAskCircle_(chat, d2);
  }
  if (arg.indexOf('l:') === 0) {
    var d3 = tgSjGet_(chat); if (!d3) return tgSjStart_(chat, uname);
    var cc = arg.slice(2);
    if (cc === '?') { d3.circle = ''; d3.ccode = ''; }
    else {
      var rs = tgSchCircles_();
      for (var i = 0; i < rs.length; i++) if (rs[i].code === cc) { d3.circle = rs[i].name; d3.ccode = rs[i].code; }
    }
    return tgSjAskName_(chat, d3);
  }
  if (arg.indexOf('ok:') === 0 || arg.indexOf('no:') === 0 || arg.indexOf('q:') === 0) {
    var who = tgSjIsOwner_(chat);
    if (!who) return tgSend_(chat, T_SJ_NOTOWN);
    var p = arg.split(':');
    return tgSjDecide_(chat, p.slice(1).join(':'), p[0], who);
  }
  return null;
}

/* ---------- تست ---------- */

function tgSchool2Tests() {
  var out = [], pass = 0, fail = 0;
  function ok(n, c) { c ? pass++ : fail++; out.push((c ? '✅ ' : '❌ ') + n); }
  ok('هاب مدرسه باز می‌شود', !!tgSchSS_());
  var cs = tgSchCourses_();
  ok('دوره‌ها خوانده شد', cs.length >= 4);
  ok('تجربهٔ بالینی هست', cs.some(function (c) { return c.code === 'CLIN'; }));
  var rs = tgSchCircles_();
  ok('حلقه‌ها خوانده شد', rs.length >= 10);
  ok('حلقهٔ فعال داریم', rs.some(function (r) { return r.status === 'فعال'; }));
  ok('تب عضویت دانشجو هست', !!tgSchSS_().getSheetByName(TG_SCH_T_MEM));
  ok('تب درخواست عضویت هست', !!tgSchSS_().getSheetByName(TG_SCH_T_REQ));
  /* v170.14: بی نام واقعی؛ دست‌کم یک نفر دو عضویت جدا دارد (ادغام نمی‌شود) */
  ok('یک نفر دو عضویت جدا دارد', (function () { var c = {}; return tgSchRows_(TG_SCH_T_MEM, TG_SCH_MEM_HEAD, 14).some(function (r) {
       var k = String(r[1]).trim(); if (!k) return false; c[k] = (c[k] || 0) + 1; return c[k] >= 2; }); })());
  ok('مسئول مدرسه chat_id دارد', tgSchoolOwners_().length > 0);
  ok('متن‌ها خط تیره ندارند', [T_SJ_ROLE, T_SJ_SENT, T_SJ_OKMSG, T_COMM_INTRO, T_COMM_OK].every(function (t) {
     return t.indexOf('—') < 0; }));
  ok('هر نقش درخواستی در TG_ROLES هست', TG_SCH_ROLES.every(function (r) { return TG_ROLES.indexOf(r) > -1; }));
  Logger.log(out.join('\n'));
  Logger.log('نتیجه: ' + pass + ' قبول · ' + fail + ' مردود');
  return { pass: pass, fail: fail };
}


/* ---------- فرم‌های مدرسه در سایت: آینه در هاب مدرسه ---------- */
/* لید همچنان در «لیدها» هاب تجربه می‌نشیند؛ اینجا فقط نسخهٔ مدرسه ثبت می‌شود. */
function tgSchFormKind_(o) {
  var s = ((o.form || '') + ' ' + (o.src || '') + ' ' + (o.page || ''));
  if (s.indexOf('کامیونیتی') > -1 || s.indexOf('community') > -1) return 'comm';
  if (s.indexOf('انجمن') > -1 || s.indexOf('association') > -1) return '';
  if (s.indexOf('مدرسه') > -1 || s.indexOf('school') > -1 || s.indexOf('ثبت‌نام دوره') > -1) return 'join';
  if (tgSchSrcIs_(o.src) || tgSchSrcIs_(o.form)) return 'join';
  return '';
}

/* v141: منبع یک لید مال مدرسه است؟ فقط از روی منبع و نام فرم، نه متن مراجع (تا «دوره» در متن تراپی مدرسه حساب نشود) */
function tgSchSrcIs_(src) {
  var s = String(src || '').trim();
  if (!s) return false;
  if (s.indexOf('›') > -1) return tgSection_(s, '') === 'مدرسه';
  if (/انجمن|association|سازمانی/.test(s)) return false;
  return /مدرسه|school|ثبت‌نام دور|پیش‌ثبت‌نام|کامیونیتی|community|\bEFT\b|وبینار|سوپرویژن/i.test(s);
}

/* v141: همان شماره یا ایمیل در «درخواست عضویت» هست؟ شمارهٔ سطر یا ۰ */
function tgSchReqRowBy_(phone, email) {
  if (TG_DRY) return TG_MEM['schreqrow'] || 0;
  var sh = tgSchSheet_(TG_SCH_T_REQ, TG_SCH_REQ_HEAD);
  if (!sh || sh.getLastRow() < 2) return 0;
  var want = tgRcPhone_(phone), em = String(email || '').trim().toLowerCase();
  if (!want && !em) return 0;
  var v = sh.getRange(2, 1, sh.getLastRow() - 1, 10).getValues();
  for (var i = v.length - 1; i >= 0; i--) {
    if (want && want.length >= 10 && tgRcPhone_(v[i][8]) === want) return i + 2;
    if (em && String(v[i][9] || '').trim().toLowerCase() === em) return i + 2;
  }
  return 0;
}

/* v141: فرم دوباره از سایت برای کسی که در «درخواست عضویت» هست:
   یادداشت، تکمیل ایمیل اگر خالی بود، بازگشایی اگر بسته بود، خبر به مسئول مدرسه. سطر تازه ساخته نمی‌شود. */
function tgSchFormAgain_(row, o) {
  var cur = tgSlRead_(row) || {};
  var ch = {};
  if (!TG_DRY) {
    var sh = tgSchSheet_(TG_SCH_T_REQ, TG_SCH_REQ_HEAD);
    var v = sh.getRange(row, 1, 1, 16).getValues()[0];
    if (!String(v[9] || '').trim() && o.email) ch['ایمیل'] = o.email;
    if (!String(v[11] || '').trim() && o.msg) ch['توضیح متقاضی'] = o.msg;
  }
  var reopened = false;
  if (cur.closed) { ch['وضعیت'] = TG_SCH_ST_OPEN; reopened = true; }
  var campG = tgSchCampFromSrc_(o.src, o.form);
  if (campG && !cur.camp) ch['کد کمپین'] = campG;
  tgSlSet_(row, ch, 'سایت');
  tgSlNote_(row, 'فرم دوباره از سایت' + (o.msg ? ': ' + String(o.msg).slice(0, 400) : '') + (o.src ? ' · ' + o.src : ''), 'سایت');
  var text = '🔁 <b>فرم دوباره از سایت</b>\n<b>' + tgEsc_(o.name || cur.name || '') + '</b>' +
             (cur.code ? ' · ' + tgEsc_(cur.code) : '') + (cur.id ? ' · ' + tgEsc_(cur.id) : '') + '\n' +
             (o.msg ? tgEsc_(String(o.msg).slice(0, 600)) + '\n' : '') +
             'این نفر از قبل در «لیدهای مدرسه» هاب مدرسه بود؛ یادداشت اضافه شد' + (reopened ? ' و پرونده دوباره باز شد' : '') + '.';
  var own = tgSchoolOwners_();
  for (var i = 0; i < own.length; i++) tgSend_(own[i].chat, text);
  return cur.code || 'again';
}

/* v141: لیدهای مدرسه که هنوز در «لیدها»ی هاب پذیرش مانده‌اند. tgSchLeadsPreview فقط می‌شمارد؛ tgSchLeadsMigrate با اجازهٔ یاسر جابه‌جا می‌کند. */
var TG_SCH_MOVED_TAB = 'منتقل شد ← لیدهای مدرسه';

function tgSchLeadsPlan_() {
  var sh = tgSS_().getSheetByName(TG_LEADS);
  var last = sh.getLastRow(), w = sh.getLastColumn();
  var out = { rows: [], head: sh.getRange(1, 1, 1, w).getValues()[0], width: w, exists: 0, missing: 0 };
  if (last < 2) return out;
  var v = sh.getRange(2, 1, last - 1, w).getValues();
  var codeCol = tgLeadCodeCol_();
  for (var i = 0; i < v.length; i++) {
    var src = String(v[i][2] || '');
    if (!tgSchSrcIs_(src)) continue;
    var name = String(v[i][3] || '').trim(), phone = String(v[i][5] || '').trim();
    if (!name && !phone) continue;
    var hay = String(v[i][7] || '') + ' ' + String(v[i][12] || '');
    var em = (hay.match(/[\w.+-]+@[\w-]+\.[\w.]+/) || [''])[0];
    var kind = src.indexOf('کامیونیتی') > -1 ? 'comm' : 'join';
    var r = { row: i + 2, vals: v[i], name: name, phone: phone, email: em, kind: kind, src: src,
              msg: String(v[i][7] || ''), status: String(v[i][8] || ''), code: String(v[i][codeCol - 1] || ''), date: v[i][0] };
    r.have = !!tgSchReqRowBy_(phone, em);
    if (!r.have && kind === 'comm') {
      r.have = tgSchFormDup_(TG_SCH_T_COMM, TG_SCH_COMM_HEAD, 11, 5, phone) || tgSchFormDup_(TG_SCH_T_COMM, TG_SCH_COMM_HEAD, 11, 4, em);
    }
    if (r.have) out.exists++; else out.missing++;
    out.rows.push(r);
  }
  return out;
}

/* v141: فیلتر پایهٔ تب لیدها (مسئول ≠ مدیر مدرسه/مسئول مدرسه/مالی) حذف سطرهای پنهان را بی‌صدا رد می‌کند؛
   قبل از حذف برداشته و بعد عیناً برگردانده می‌شود */
function tgLeadsFilterOff_(sh) {
  var f = sh.getFilter();
  if (!f) return null;
  var keep = { range: f.getRange().getA1Notation(), crit: [] };
  var nCols = f.getRange().getLastColumn();
  for (var c = 1; c <= nCols; c++) { var cr = f.getColumnFilterCriteria(c); if (cr) keep.crit.push([c, cr.copy()]); }
  f.remove();
  return keep;
}

function tgLeadsFilterOn_(sh, keep) {
  if (!keep) return;
  try {
    var f = sh.getRange(keep.range).createFilter();
    for (var i = 0; i < keep.crit.length; i++) f.setColumnFilterCriteria(keep.crit[i][0], keep.crit[i][1].build());
  } catch (e) { tgErr_('tgLeadsFilterOn_: ' + e); }
}

/* v141: سطرهای مدرسه که بایگانی شده‌اند ولی هنوز در «لیدها» مانده‌اند (اجرای اول پشت فیلتر گیر کرد) */
function tgSchLeadsFinish() {
  var ss = tgSS_(), sh = ss.getSheetByName(TG_LEADS), arc = ss.getSheetByName(TG_SCH_MOVED_TAB);
  if (!arc || arc.getLastRow() < 2) return 'بایگانی خالی است.';
  var codeCol = tgLeadCodeCol_(), done = {};
  arc.getRange(2, codeCol, arc.getLastRow() - 1, 1).getValues().forEach(function (r) { var c = String(r[0] || '').trim(); if (c) done[c] = 1; });
  var last = sh.getLastRow();
  if (last < 2) return 'لیدها خالی است.';
  var v = sh.getRange(2, 1, last - 1, codeCol).getValues(), del = [];
  for (var i = 0; i < v.length; i++) {
    var c = String(v[i][codeCol - 1] || '').trim();
    if (c && done[c] && tgSchSrcIs_(String(v[i][2] || ''))) del.push(i + 2);
  }
  var keep = tgLeadsFilterOff_(sh);
  for (var k = del.length - 1; k >= 0; k--) sh.deleteRow(del[k]);
  tgLeadsFilterOn_(sh, keep);
  var msg = del.length + ' سطر بایگانی‌شده از «لیدها» حذف شد' + (keep ? '؛ فیلتر برگشت.' : '.');
  Logger.log(msg);
  return msg;
}

function tgSchLeadsPreview() {
  var p = tgSchLeadsPlan_();
  var lines = ['لیدهای مدرسه در «لیدها»: ' + p.rows.length, 'از قبل در هاب مدرسه: ' + p.exists, 'باید در هاب مدرسه ساخته شود: ' + p.missing, ''];
  for (var i = 0; i < p.rows.length; i++) {
    var r = p.rows[i];
    if (!r.have) lines.push('سطر ' + r.row + ' · ' + r.code + ' · ' + r.name + ' · ' + r.kind + ' · ' + r.status);
  }
  Logger.log(lines.join('\n'));
  return lines.join('\n');
}

function tgSchLeadsMigrate() {
  var ss = tgSS_(), sh = ss.getSheetByName(TG_LEADS);
  var p = tgSchLeadsPlan_();
  if (!p.rows.length) return 'چیزی برای انتقال نیست.';
  var arc = ss.getSheetByName(TG_SCH_MOVED_TAB);
  if (!arc) {
    arc = ss.insertSheet(TG_SCH_MOVED_TAB);
    arc.setRightToLeft(true);
    arc.getRange(1, 1, 1, p.width + 1).setValues([p.head.concat(['انتقال'])]).setFontWeight('bold');
    arc.setFrozenRows(1);
  }
  var reqSh = tgSchSheet_(TG_SCH_T_REQ, TG_SCH_REQ_HEAD), commSh = tgSchSheet_(TG_SCH_T_COMM, TG_SCH_COMM_HEAD);
  var made = 0, stamp = tgJDateFull_(new Date(), TG_TZ), ev = [], arcRows = [];
  for (var i = 0; i < p.rows.length; i++) {
    var r = p.rows[i], where = 'از قبل در هاب مدرسه بود';
    if (!r.have) {
      var jd = r.date instanceof Date ? tgJDateFull_(r.date, TG_TZ) : String(r.date || '');
      var note = 'انتقال از هاب پذیرش · ' + r.code + ' · ' + r.src;
      if (r.kind === 'comm') {
        commSh.appendRow([jd, r.name, '', '', r.email, r.phone ? "'" + r.phone : '', '', '', 'فرم سایت', 'فعال', note]);
        where = 'کامیونیتی';
      } else {
        var id = tgSchNextId_(TG_SCH_T_REQ, TG_SCH_REQ_HEAD, 'د');
        var closed = tgStClosed_(r.status);
        reqSh.appendRow([id, jd, r.name, '', '', 'دانشجو', '', '', r.phone ? "'" + r.phone : '', r.email, '', r.msg,
                         closed ? 'بسته' : TG_SJ_ST.wait, '', '', note]);
        tgSlSet_(reqSh.getLastRow(), { 'مرحلهٔ قیف': TG_SCH_STAGES[2], 'منبع': 'سایت' }, 'مهاجرت');
        where = 'درخواست عضویت ' + id;
      }
      made++;
    }
    arcRows.push(r.vals.concat([stamp + ' · ' + where]));
    ev.push([new Date(), r.code, r.row, 'بات', 'مهاجرت', 'انتقال به هاب مدرسه', r.status, where, 'v141']);
  }
  arc.getRange(arc.getLastRow() + 1, 1, arcRows.length, p.width + 1).setValues(arcRows);
  var es = tgLeadEvSheet_();
  if (es && ev.length) es.getRange(es.getLastRow() + 1, 1, ev.length, ev[0].length).setValues(ev);
  var keepF = tgLeadsFilterOff_(sh);
  for (var k = p.rows.length - 1; k >= 0; k--) sh.deleteRow(p.rows[k].row);
  tgLeadsFilterOn_(sh, keepF);
  try { arc.hideSheet(); } catch (e) {}
  tgSchDropCache_();
  var msg = 'انتقال انجام شد: ' + p.rows.length + ' سطر از «لیدها» برداشته و در «' + TG_SCH_MOVED_TAB + '» بایگانی شد؛ ' +
            made + ' سطر تازه در هاب مدرسه ساخته شد، بقیه از قبل آنجا بودند.';
  Logger.log(msg);
  return msg;
}

function tgSchFormDup_(tab, head, width, col, val) {
  if (!val) return false;
  var key = tgLatinDigits_(String(val)).replace(/\D/g, '').slice(-10) || String(val).trim().toLowerCase();
  var v = tgSchRows_(tab, head, width);
  for (var i = 0; i < v.length; i++) {
    var cur = String(v[i][col] || '').trim();
    if (!cur) continue;
    var k2 = tgLatinDigits_(cur).replace(/\D/g, '').slice(-10) || cur.toLowerCase();
    if (k2 && k2 === key) return true;
  }
  return false;
}

function tgSchFromForm_(o) {
  if (TG_DRY) return '';
  var kind = tgSchFormKind_(o);
  if (!kind) return '';

  if (kind === 'comm') {
    if (tgSchFormDup_(TG_SCH_T_COMM, TG_SCH_COMM_HEAD, 11, 5, o.phone)) return 'dup';
    if (tgSchFormDup_(TG_SCH_T_COMM, TG_SCH_COMM_HEAD, 11, 4, o.email)) return 'dup';
    tgSchSheet_(TG_SCH_T_COMM, TG_SCH_COMM_HEAD).appendRow([
      tgJDateFull_(new Date(), TG_TZ), o.name || '', '', '', o.email || '', o.phone || '',
      o.msg || '', '', 'فرم سایت', 'فعال', o.src || '']);
    try { tgSchoolNotify_('💌 عضو تازهٔ کامیونیتی از فرم سایت: <b>' + tgEsc_(o.name || '') + '</b>'); } catch (e) {}
    return 'comm';
  }

  var again = tgSchReqRowBy_(o.phone, o.email);
  if (again) {
    try { return tgSchFormAgain_(again, o); } catch (eA) { tgErr_('tgSchFormAgain_: ' + eA); return 'dup'; }
  }
  /* v142: فرم سایت هم از همان تابع واحد سطر می‌سازد؛ کمپین از منبع حدس زده می‌شود */
  var campF = tgSchCampFromSrc_(o.src, o.form);
  var isApply = /ثبت‌نام دور|فرم ثبت‌نام/.test(String(o.src || '') + ' ' + String(o.form || ''));
  var made = tgSchLeadEnsure_({ name: o.name || '', phone: o.phone || '', email: o.email || '', camp: campF,
    stage: isApply ? TG_SCH_STAGES[TG_SCH_SG.apply] : TG_SCH_STAGES[TG_SCH_SG.lead], note: o.msg || '',
    memo: 'از فرم سایت · ' + (o.src || ''), src: 'سایت', actor: 'سایت', channel: 'سایت' });
  var id = made.id;
  try {
    var own = tgSchoolOwners_();
    for (var i = 0; i < own.length; i++) {
      tgSend_(own[i].chat, '🎓 <b>لید تازهٔ مدرسه از سایت</b> · ' + tgEsc_(id) + (made.code ? ' · ' + tgEsc_(made.code) : '') +
        '\n<b>' + tgEsc_(o.name || '') + '</b>' + (campF ? ' · ' + tgEsc_(campF) : '') +
        (o.msg ? '\n' + tgEsc_(String(o.msg).slice(0, 500)) : ''));
      tgSlCardSend_(own[i].chat, made.row);
    }
  } catch (e2) { tgErr_('tgSchFromForm_: ' + e2); }
  return id;
}



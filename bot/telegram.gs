function tgKbFrom_(list) {
  const rows = [];
  for (var i = 0; i < list.length; i += 2) {
    const r = [{ text: list[i][0] }];
    if (list[i + 1]) r.push({ text: list[i + 1][0] });
    rows.push(r);
  }
  rows.push([{ text: '↩️ بازگشت' }]);
  return { keyboard: rows, resize_keyboard: true };
}

function tgTopicIn_(list, text) {
  const t = String(text).trim();
  for (var i = 0; i < list.length; i++) {
    if (t === list[i][0] || t.indexOf(list[i][3]) > -1) return i;
  }
  return -1;
}


function tgHubOrderApply_(ss, order, hide, colors, hideRest, firstName) {
  var log = [], keep = {};
  order.forEach(function (n) { keep[n] = 1; });
  ss.getSheets().forEach(function (sh) {
    var n = sh.getName();
    if (keep[n]) return;
    var mustHide = hideRest || (hide && hide.indexOf(n) > -1);
    if (mustHide && !sh.isSheetHidden()) { try { sh.hideSheet(); log.push('مخفی: ' + n); } catch (e) {} }
  });
  var pos = 0;
  for (var i = 0; i < order.length; i++) {
    var sh = ss.getSheetByName(order[i]);
    if (!sh) { log.push('پیدا نشد: ' + order[i]); continue; }
    if (sh.isSheetHidden()) { sh.showSheet(); log.push('نمایان: ' + order[i]); }
    pos++;
    ss.setActiveSheet(sh);
    ss.moveActiveSheet(pos);
    try { if (colors && colors[order[i]]) sh.setTabColor(colors[order[i]]); } catch (e2) {}
  }
  var first = ss.getSheetByName(firstName || order[0]);
  if (first) ss.setActiveSheet(first);
  return log;
}

function tgHubOrder() {
  var order = TG_HUB_ORDER.filter(function (n) { return TG_HUB_HIDE.indexOf(n) < 0; });
  var log = tgHubOrderApply_(tgSS_(), order, TG_HUB_HIDE, TG_HUB_COLOR, true, 'کارتابل پیگیری');
  Logger.log((log.join('\n') || 'چیزی عوض نشد') + '\n' + order.length + ' تب کاری دیده می‌شود، بقیه مخفی');
  return log;
}


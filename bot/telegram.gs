  out.push('TG_LONGPOLL=' + TG_LONGPOLL + ' ثانیه · TG_BURST_MS=' + TG_BURST_MS + ' میلی‌ثانیه');
  Logger.log(out.join('\n'));
}


// رلهٔ تازه را تست می‌کند و اگر سالم بود وبهوک را روی آن می‌برد
/* v170.23: نشانی رله (که نام حساب را دارد) در کد نیست؛ از کلید TG_RELAY_BASE تنظیمات خصوصی */
var TG_RELAY_BASE = cfg_('TG_RELAY_BASE', '');
function tgSwitchRelay() {
  const props = PropertiesService.getScriptProperties();
  const secret = props.getProperty('TG_HOOK_SECRET') || '';
  const base = String(TG_RELAY_BASE || '').replace(/\/+$/, '');
  if (!base) { Logger.log('⛔ کلید TG_RELAY_BASE در «تنظیمات خصوصی بات» خالی است.'); return; }
  const url = base + (secret ? '?t=' + secret : '');
  const out = [];

  let ok = 0, sum = 0, worst = 0;
  for (var i = 0; i < 6; i++) {
    const t0 = Date.now();
    try {
      const r = UrlFetchApp.fetch(url, {
        method: 'post', contentType: 'application/json',
        payload: JSON.stringify({ ping: 1 }), muteHttpExceptions: true, followRedirects: true
      });
      const ms = Date.now() - t0;
      sum += ms; if (ms > worst) worst = ms;
      if (r.getResponseCode() === 200) ok++;
      out.push((r.getResponseCode() === 200 ? '✅ ' : '❌ ') + r.getResponseCode() + ' · ' + ms + 'ms');
    } catch (e) { out.push('❌ ' + String(e).slice(0, 60)); }
    Utilities.sleep(300);
  }
  out.push('میانگین ' + Math.round(sum / Math.max(ok, 1)) + 'ms · بدترین ' + worst + 'ms');

  if (ok < 5) { Logger.log(out.join('\n') + '\n\n⛔ رله سالم نیست، وبهوک عوض نشد.'); return; }

  props.setProperty('TG_RELAY_URL', url);
  try { tgUseWebhook(); } catch (e) { out.push('خطای tgUseWebhook: ' + e); }
  Utilities.sleep(2000);
  try {
    const info = tgApi_('getWebhookInfo', {});
    out.push('');
    out.push('وبهوک: ' + JSON.stringify(info).replace(secret, '***').slice(0, 400));
  } catch (e) { out.push('getWebhookInfo: ' + e); }
  Logger.log(out.join('\n'));
}


function tgRelayTidy() {
  const props = PropertiesService.getScriptProperties();
  if (!TG_RELAY_BASE) { Logger.log('⛔ کلید TG_RELAY_BASE در «تنظیمات خصوصی بات» خالی است.'); return; }
  props.setProperty('TG_RELAY_URL', String(TG_RELAY_BASE).replace(/\/+$/, ''));
  tgUseWebhook();
  Utilities.sleep(2000);
  const info = tgApi_('getWebhookInfo', {});
  const r = (info && info.result) || {};
  const secret = props.getProperty('TG_HOOK_SECRET') || '';
  const out = [];
  out.push('آدرس: ' + String(r.url || '').replace(secret, '***'));
  out.push('در صف: ' + (r.pending_update_count || 0));
  out.push('آخرین خطا: ' + (r.last_error_message || 'ندارد'));
  const all = ScriptApp.getProjectTriggers();
  const names = [];
  for (var i = 0; i < all.length; i++) names.push(all[i].getHandlerFunction());
  out.push('تریگرها: ' + names.join(' · '));
  Logger.log(out.join('\n'));
}



  'از این پس برنامهٔ جلسه‌هایتان، صفحهٔ شخصی‌تان در سایت و پیام‌های مدرسه از همین‌جا در دسترس شماست.';

var T_TEA_KNOWN = 'این حساب پیش از این به سطر شما وصل شده بود. همه‌چیز سر جایش است.';
var T_TEA_TAKEN = 'این لینک پیش از این با حساب دیگری استفاده شده است. لطفاً به مسئول مدرسه بگویید تا لینک تازه بفرستد.';

function tgTeaConnect_(chat, code, uname) {
  var t = tgTeaByCode_(code);
  if (!t) return false;
  if (t.chat && String(t.chat) !== String(chat)) { tgSend_(chat, T_TEA_TAKEN); return true; }
  var known = String(t.chat) === String(chat);
  if (!TG_DRY) {
    try {
      var sh = tgSchSheet_(TG_SCH_T_TEA, TG_SCH_TEA_HEAD);
      sh.getRange(t.row, 3).setValue(String(chat));
      if (uname && !t.user) sh.getRange(t.row, 2).setValue(uname);
      sh.getRange(t.row, 8).setValue('وصل شد');
      tgSchDropCache_();
    } catch (e) { tgErr_('tgTeaConnect_: ' + e); }
  } else {
    TG_MEM['teaconnect'] = { row: t.row, chat: String(chat) };
  }
  try {
    var p = tgWhoPerson_(chat, uname);
    if (p) tgSchGrantRole_(p, t.role && t.role.indexOf('سوپروایزر') > -1 ? 'سوپروایزر' : 'استاد', '');
  } catch (e2) {}
  var head = known ? T_TEA_KNOWN : (T_TEA_HELLO + '\n\n<b>' + tgEsc_(t.name) + '</b>' +
             (t.title ? '\n' + tgEsc_(t.title) : ''));
  tgSend_(chat, head, tgTeaMenu_(t));
  return true;
}

function tgTeaMenu_(t) {
  var rows = [[TG_TEA_CAL], [TG_TEA_PAGE], ['🏫 برنامه‌های عمومی', '🎟 رویدادها']];
  if (t && String(t.role).indexOf('سوپروایزر') > -1) rows.splice(1, 0, [TG_SV_MY]);
  rows.push(['💬 پیام به مدرسه']);
  return { keyboard: rows, resize_keyboard: true };
}

function tgTeaWho_(chat, uname) {
  var u = String(uname || '').replace(/^@/, '').toLowerCase();
  var list = tgTeaRows_();
  for (var i = 0; i < list.length; i++) {
    if (list[i].chat && String(list[i].chat) === String(chat)) return list[i];
    if (u && list[i].user && list[i].user === u) return list[i];
  }
  return null;
}

/* ==================================================================
   ۵) تقویم و صفحهٔ استاد
   ================================================================== */

function tgTeaCalIds_(name) {
  var out = [];
  var v = tgSchRows_(TG_SCH_T_CIRCLE, ['کد حلقه'], 10);
  var n = String(name || '').trim();
  for (var i = 0; i < v.length; i++) {
    var teach = String(v[i][8] || '').trim();
    if (!n || !teach) continue;
    if (teach.indexOf(n) < 0 && n.indexOf(teach) < 0) continue;
    var id = String(v[i][6] || '').trim();
    if (!id) continue;
    if (id.indexOf('@') < 0) id += '@group.calendar.google.com';
    if (out.indexOf(id) < 0) out.push(id);
  }
  return out;
}

function tgTeaCal_(chat, t) {
if (!t) return tgSend_(chat, 'سطر شما در فهرست استادان پیدا نشد. لطفاً به مسئول مدرسه بگویید.');
var parts = [], mine = '';
try { mine = tgClsTeaText_(t, 21); } catch (e0) { tgErr_('tgClsTeaText_: ' + e0); }
if (mine) parts.push(mine);
else {
var ids = tgTeaCalIds_(t.name);
for (var i = 0; i < ids.length; i++) {
var txt = '';
try { txt = tgCalText_(ids[i], 21); } catch (e) {}
if (txt) parts.push(txt);
}
}
if (!parts.length) {
tgSend_(chat, '📅 برای شما جلسهٔ ثبت‌شده‌ای در سه هفتهٔ پیش رو نیست.\n' +
'اگر فکر می‌کنید اشتباهی هست، لطفاً به مسئول مدرسه بگویید تا بررسی کنیم.',
tgTeaMenu_(t));
return true;
}
tgSend_(chat, '📅 <b>تقویم جلسه‌های شما</b>\n\n' + parts.join('\n'), tgTeaMenu_(t));
if (mine) tgSend_(chat, 'همهٔ این جلسه‌ها در تقویم گوشی‌تان هم بنشیند؟',
{ inline_keyboard: [[{ text: '📎 افزودن به تقویم گوشی', callback_data: 'cls:i' }]] });
return true;
}

function tgTeaPage_(chat, t) {
  if (!t) return tgSend_(chat, 'سطر شما در فهرست استادان پیدا نشد.');
  var kb = { inline_keyboard: [] };
  if (t.page) kb.inline_keyboard.push([{ text: '🌐 دیدن صفحهٔ من', url: t.page }]);
  kb.inline_keyboard.push([{ text: '🪪 تکمیل اطلاعات', callback_data: 'pq:go' }]);
  var t1 = t.page
    ? '🪪 <b>صفحهٔ شما در سایت</b>\n\n' + tgEsc_(t.page) +
      '\n\nهر وقت خواستید می‌توانید اطلاعات صفحه را کامل‌تر کنید. تیم تجربه هم برای بهتر شدن صفحه‌ها وقت می‌گذارد.'
    : '🪪 <b>صفحهٔ شما در سایت</b>\n\n' +
      'صفحهٔ شخصی شما هنوز ساخته نشده است. اگر اطلاعاتتان را کامل کنید، همکاران ما صفحه را آماده می‌کنند و ' +
      'لینکش را همین‌جا برایتان می‌فرستیم.';
  return tgSend_(chat, t1, kb);
}

/* ==================================================================
   ۴) اسلات سوپرویژن: خصوصی و گروهی
   ================================================================== */

function tgSvRows_() {
  if (TG_DRY) return TG_MEM['svslots'] || [];
  var v = tgSchRows_(TG_SCH_T_SLOT, TG_SCH_SLOT_HEAD, TG_SCH_SLOT_HEAD.length);
  var out = [];
  for (var i = 0; i < v.length; i++) {
    var c = String(v[i][0] || '').trim();
    if (!c) continue;
    out.push({
      row: i + 2, code: c, sup: String(v[i][1] || '').trim(), chat: String(v[i][2] || '').trim(),
      type: String(v[i][3] || '').trim(), day: String(v[i][4] || '').trim(),
      time: String(v[i][5] || '').trim(), min: Number(v[i][6] || 0) || 0,
      cap: Number(v[i][7] || 0) || 0, taken: Number(v[i][8] || 0) || 0,
      status: String(v[i][9] || '').trim(), approach: String(v[i][10] || '').trim()
    });
  }
  return out;
}

function tgSvByCode_(code) {
  var l = tgSvRows_();
  for (var i = 0; i < l.length; i++) if (l[i].code === String(code).trim()) return l[i];
  return null;
}

function tgSvLabel_(s) {
  var t = (s.type === 'گروهی' ? '👥 گروهی' : '👤 خصوصی') + ' · ' + s.day + ' ساعت ' + s.time;
  if (s.type === 'گروهی') {
    t += ' · ' + s.min + ' دقیقه · ظرفیت ' + s.cap + ' نفر';
    t += ' · ' + Math.max(0, s.cap - s.taken) + ' جای خالی';
  }
  return t;
}

function tgSvFreeList_() {
  var l = tgSvRows_(), out = [];
  for (var i = 0; i < l.length; i++) {
    var s = l[i];
    if (s.status === 'حذف شده' || s.status === 'بسته') continue;
    if (s.type === TG_AP_IV) continue;
    if (s.type === 'گروهی') { if (s.cap - s.taken <= 0) continue; }
    else if (s.taken > 0) continue;
    out.push(s);
  }
  return out;
}

function tgSvMy_(chat, uname) {
  var t = tgTeaWho_(chat, uname);
  var nm = t ? t.name : '';
  var l = tgSvRows_(), mine = [];
  for (var i = 0; i < l.length; i++) {
    if (String(l[i].chat) === String(chat) || (nm && l[i].sup === nm)) {
      if (l[i].status !== 'حذف شده') mine.push(l[i]);
    }
  }
  var kb = [[{ text: '➕ وقت تازه', callback_data: 'sv:add' }]];
  var body = '';
  if (!mine.length) {
    body = '🗓 <b>وقت‌های سوپرویژن شما</b>\n\nهنوز وقتی اعلام نکرده‌اید.';
  } else {
    var lines = [];
    for (var j = 0; j < mine.length; j++) {
      lines.push('• ' + tgEsc_(mine[j].code) + ' · ' + tgEsc_(tgSvLabel_(mine[j])));
      var r = [];
      if (mine[j].type === 'گروهی') r.push({ text: '👥 ظرفیت ' + mine[j].code, callback_data: 'sv:cap:' + mine[j].code });
      r.push({ text: '🗑 حذف ' + mine[j].code, callback_data: 'sv:del:' + mine[j].code });
      kb.push(r);
    }
    body = '🗓 <b>وقت‌های سوپرویژن شما</b>\n\n' + lines.join('\n');
  }
  tgSend_(chat, body, { inline_keyboard: kb });
  return true;
}

function tgSvGet_(chat) {
  var raw = tgGetVal_('sfl', chat);
  if (!raw) return null;
  try { return JSON.parse(raw); } catch (e) { return null; }
}
function tgSvPut_(chat, d) { tgSetVal_('sfl', chat, JSON.stringify(d)); }
function tgSvEnd_(chat) { tgDel_('sfl', chat); }

function tgSvAdd_(chat) {
  tgSvPut_(chat, { step: 'type' });
  return tgSend_(chat, 'وقت تازه از چه نوعی است؟', { inline_keyboard: [
    [{ text: '👤 خصوصی (یک‌نفره)', callback_data: 'sv:t:خصوصی' }],
    [{ text: '👥 گروهی', callback_data: 'sv:t:گروهی' }],
    [{ text: '↩️ بی‌خیال', callback_data: 'sv:x' }]
  ] });
}

function tgSvAskDay_(chat, d) {
  tgSvPut_(chat, d);
  var rows = [];
  for (var i = 0; i < TG_SV_DAYS.length; i += 2) {
    var r = [{ text: TG_SV_DAYS[i], callback_data: 'sv:d:' + i }];
    if (TG_SV_DAYS[i + 1]) r.push({ text: TG_SV_DAYS[i + 1], callback_data: 'sv:d:' + (i + 1) });
    rows.push(r);
  }
  rows.push([{ text: '↩️ بی‌خیال', callback_data: 'sv:x' }]);
  return tgSend_(chat, 'کدام روز هفته؟', { inline_keyboard: rows });
}

function tgSvAskTime_(chat, d) {
  d.step = 'time';
  tgSvPut_(chat, d);
  return tgSend_(chat, 'ساعت را بنویسید، مثل ۱۷:۳۰ یا 17.30');
}

function tgSvAskMin_(chat, d) {
  d.step = 'min';
  tgSvPut_(chat, d);
  var r = [];
  for (var i = 0; i < TG_SV_MINS.length; i++) r.push({ text: TG_SV_MINS[i] + ' دقیقه', callback_data: 'sv:m:' + TG_SV_MINS[i] });
  return tgSend_(chat, 'طول هر جلسه چقدر است؟', { inline_keyboard: [r, [{ text: '↩️ بی‌خیال', callback_data: 'sv:x' }]] });
}

function tgSvAskCap_(chat, d) {
  d.step = 'cap';
  tgSvPut_(chat, d);
  var r = [];
  for (var i = 0; i < TG_SV_CAPS.length; i++) r.push({ text: TG_SV_CAPS[i] + ' نفر', callback_data: 'sv:c:' + TG_SV_CAPS[i] });
  return tgSend_(chat, 'ظرفیت این گروه چند نفر است؟ هر وقت خواستید می‌توانید بعداً عوضش کنید.',
                 { inline_keyboard: [r.slice(0, 3), r.slice(3), [{ text: '↩️ بی‌خیال', callback_data: 'sv:x' }]] });
}

function tgSvSave_(chat, d, uname) {
  var t = tgTeaWho_(chat, uname);
  var nm = t ? t.name : '';
  if (!nm) {
    var p = tgWhoPerson_(chat, uname);
    nm = p ? p.name : String(chat);
  }
  var code = TG_DRY ? 'SL-001' : tgSchNextId_(TG_SCH_T_SLOT, TG_SCH_SLOT_HEAD, 'SL');
  var rowVals = [code, nm, String(chat), d.type, d.day, d.time,
                 d.type === 'گروهی' ? (d.min || 90) : (d.min || 50),
                 d.type === 'گروهی' ? (d.cap || 3) : 1, 0, 'باز',
                 t ? t.approach : '', tgJDateFull_(new Date(), TG_TZ), ''];
  if (TG_DRY) {
    (TG_MEM['svslots'] = TG_MEM['svslots'] || []).push({
      row: TG_MEM['svslots'] ? TG_MEM['svslots'].length + 2 : 2, code: code, sup: nm, chat: String(chat),
      type: d.type, day: d.day, time: d.time, min: rowVals[6], cap: rowVals[7], taken: 0,
      status: 'باز', approach: ''
    });
    TG_OUTBOX.push({ kind: 'svslot', code: code, type: d.type, day: d.day, time: d.time, min: rowVals[6], cap: rowVals[7] });
  } else {
    tgSchSlotSheet_().appendRow(rowVals);
    tgSchDropCache_();
  }
  tgSvEnd_(chat);
  tgSend_(chat, '✅ ثبت شد.\n' + tgEsc_(code) + ' · ' +
          tgEsc_(tgSvLabel_({ type: d.type, day: d.day, time: d.time, min: rowVals[6], cap: rowVals[7], taken: 0 })));
  return true;
}

function tgSvCapAsk_(chat, code) {
  var s = tgSvByCode_(code);
  if (!s) return tgSend_(chat, 'این وقت پیدا نشد.');
  var r = [];
  for (var i = 0; i < TG_SV_CAPS.length; i++) {
    if (TG_SV_CAPS[i] < s.taken) continue;
    r.push({ text: TG_SV_CAPS[i] + ' نفر', callback_data: 'sv:cs:' + code + ':' + TG_SV_CAPS[i] });
  }
  return tgSend_(chat, 'ظرفیت تازهٔ ' + tgEsc_(code) + ' چند نفر باشد؟ الان ' + s.taken + ' نفر ثبت‌نام کرده‌اند.',
                 { inline_keyboard: [r.slice(0, 3), r.slice(3), [{ text: '↩️ بی‌خیال', callback_data: 'sv:my' }]] });
}

function tgSvCapSet_(chat, code, cap) {
  var s = tgSvByCode_(code);
  if (!s) return tgSend_(chat, 'این وقت پیدا نشد.');
  var n = Number(cap) || 0;
  if (n < s.taken) return tgSend_(chat, 'ظرفیت نمی‌تواند از تعداد ثبت‌نام‌شده‌ها کمتر باشد.');
  if (TG_DRY) { s.cap = n; TG_OUTBOX.push({ kind: 'svcap', code: code, cap: n }); }
  else { tgSchSlotSheet_().getRange(s.row, 8).setValue(n); tgSchDropCache_(); }
  return tgSend_(chat, '✅ ظرفیت ' + tgEsc_(code) + ' شد ' + n + ' نفر.');
}

function tgSvDel_(chat, code) {
  var s = tgSvByCode_(code);
  if (!s) return tgSend_(chat, 'این وقت پیدا نشد.');
  if (TG_DRY) { s.status = 'حذف شده'; TG_OUTBOX.push({ kind: 'svdel', code: code }); }
  else { tgSchSlotSheet_().getRange(s.row, 10).setValue('حذف شده'); tgSchDropCache_(); }
  return tgSend_(chat, '🗑 ' + tgEsc_(code) + ' حذف شد.');
}

function tgSvFree_(chat) {
  var l = tgSvFreeList_();
  if (!l.length) return tgSend_(chat, 'الان وقت خالی سوپرویژن نداریم. به‌محض باز شدن وقت تازه همین‌جا خبرتان می‌کنیم.');
  var rows = [];
  for (var i = 0; i < l.length && i < 12; i++) {
    rows.push([{ text: l[i].sup + ' · ' + tgSvLabel_(l[i]), callback_data: 'sv:bk:' + l[i].code }]);
  }
  return tgSend_(chat, '🔎 <b>وقت‌های خالی سوپرویژن</b>\n\nهر کدام را که می‌خواهید بزنید تا رزرو شود.',
                 { inline_keyboard: rows });
}

function tgSvBook_(chat, code, name, uname) {
  var s = tgSvByCode_(code);
  if (!s) return tgSend_(chat, 'این وقت پیدا نشد.');
  if (s.status === 'حذف شده' || s.status === 'بسته') return tgSend_(chat, 'این وقت دیگر باز نیست.');
  var left = s.type === 'گروهی' ? (s.cap - s.taken) : (s.taken > 0 ? 0 : 1);
  if (left <= 0) return tgSend_(chat, 'این گروه پر شد. وقت‌های دیگر را ببینید.');
  var bcode = TG_DRY ? 'SB-001' : tgSchNextId_(TG_SCH_T_GRP, TG_SCH_GRP_HEAD, 'SB');
  var vals = [bcode, s.code, s.sup, s.type, s.day, s.time, name || '', uname || '', String(chat),
              tgJDateFull_(new Date(), TG_TZ), 'رزرو شد', ''];
  if (TG_DRY) {
    (TG_MEM['svbook'] = TG_MEM['svbook'] || []).push(vals);
    s.taken = s.taken + 1;
    TG_OUTBOX.push({ kind: 'svbook', slot: s.code, book: bcode, taken: s.taken });
  } else {
    tgSchGrpSheet_().appendRow(vals);
    tgSchSlotSheet_().getRange(s.row, 9).setValue(s.taken + 1);
    tgSchDropCache_();
  }
  if (s.chat) {
    tgSend_(s.chat, '👤 یک نفر برای وقت ' + tgEsc_(s.code) + ' ثبت‌نام کرد.\n' +
                    tgEsc_(tgSvLabel_({ type: s.type, day: s.day, time: s.time, min: s.min, cap: s.cap, taken: s.taken })));
  }
  return tgSend_(chat, '✅ رزرو شد.\n' + tgEsc_(s.sup) + ' · ' + tgEsc_(s.day) + ' ساعت ' + tgEsc_(s.time) +
                       '\nهماهنگی نهایی را مدرسه با شما پیگیری می‌کند.');
}

function tgOnSv_(cq, rest) {
  var chat = cq.message.chat.id;
  var uname = cq.from && cq.from.username ? '@' + cq.from.username : '';
  var name = [cq.from.first_name, cq.from.last_name].filter(String).join(' ');
  var p = String(rest || '').split(':');
  var act = p[0] || '';
  var a1 = p[1] || '';
  var a2 = p.slice(2).join(':');

  /* فقط سوپروایزر و مسئول مدرسه وقت می‌سازند؛ حذف و ظرفیت فقط روی وقت خودشان (نقص امنیتی v137) */
  if (act !== 'bk' && act !== 'free' && act !== 'x') {
    var te0 = null, own0 = null;
    try { te0 = tgTeaWho_(chat, uname); } catch (e0) {}
    try { own0 = tgSchOwnerOf_(chat, uname); } catch (e1) {}
    if (!te0 && !own0) return tgSend_(chat, 'ساخت و تغییر وقت سوپرویژن فقط برای سوپروایزرها و مسئول مدرسه است.');
    if ((act === 'del' || act === 'cs' || act === 'cap') && !own0) {
      var s0 = tgSvByCode_(a1);
      if (!s0 || String(s0.chat) !== String(chat)) return tgSend_(chat, 'این وقت مال شما نیست.');
    }
  }

  if (act === 'add') return tgSvAdd_(chat);
  if (act === 'x') { tgSvEnd_(chat); return tgSend_(chat, 'باشد، بی‌خیال شدیم.'); }
  if (act === 'my') return tgSvMy_(chat, uname);
  if (act === 'free') return tgSvFree_(chat);

  if (act === 't') {
    var d = tgSvGet_(chat) || {};
    d.type = a1; d.step = 'day';
    return tgSvAskDay_(chat, d);
  }
  if (act === 'd') {
    var d2 = tgSvGet_(chat);
    if (!d2) return tgSvAdd_(chat);
    d2.day = TG_SV_DAYS[Number(a1)] || TG_SV_DAYS[0];
    return tgSvAskTime_(chat, d2);
  }
  if (act === 'm') {
    var d3 = tgSvGet_(chat);
    if (!d3) return tgSvAdd_(chat);
    d3.min = Number(a1) || 90;
    return tgSvAskCap_(chat, d3);
  }
  if (act === 'c') {
    var d4 = tgSvGet_(chat);
    if (!d4) return tgSvAdd_(chat);
    d4.cap = Number(a1) || 3;
    return tgSvSave_(chat, d4, uname);
  }
  if (act === 'cap') return tgSvCapAsk_(chat, a1);
  if (act === 'cs') return tgSvCapSet_(chat, a1, a2);
  if (act === 'del') return tgSvDel_(chat, a1);
  if (act === 'bk') return tgSvBook_(chat, a1, name, uname);
  return null;
}

/* ساعت تایپ‌شده در ویزارد وقت سوپرویژن */
function tgSvTimeText_(chat, uname, text) {
  var d = tgSvGet_(chat);
  if (!d || d.step !== 'time') return false;
  var t = String(text || '').trim();
  if (!t) return false;
  if (t === 'انصراف' || t === '↩️ بازگشت' || t.indexOf('/') === 0 || tgIsBtnLike_(t)) {
    tgSvEnd_(chat);
    return false;
  }
  var hhmm = '';
  if (typeof tgScTime_ === 'function') { try { hhmm = tgScTime_(t); } catch (e) {} }
  if (!hhmm) {
    var m = tgDigits_(t).match(/^(\d{1,2})\s*[:.،,]\s*(\d{1,2})$/);
    if (m && Number(m[1]) < 24 && Number(m[2]) < 60) {
      hhmm = ('0' + m[1]).slice(-2) + ':' + ('0' + m[2]).slice(-2);
    }
  }
  if (!hhmm) { tgSend_(chat, 'ساعت را این‌طور بنویسید: ۱۷:۳۰ یا 17.30'); return true; }
  d.time = hhmm;
  if (d.type === 'گروهی') { tgSvAskMin_(chat, d); return true; }
  d.min = 50;
  tgSvSave_(chat, d, uname);
  return true;
}

/* رقم فارسی و عربی به لاتین */
function tgDigits_(s) {
  var fa = '۰۱۲۳۴۵۶۷۸۹', ar = '٠١٢٣٤٥٦٧٨٩';
  return String(s || '').replace(/[۰-۹٠-٩]/g, function (c) {
    var i = fa.indexOf(c);
    if (i > -1) return String(i);
    return String(ar.indexOf(c));
  });
}


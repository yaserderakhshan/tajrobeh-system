var TG_DRY = false;
var TG_IN_TEST = false, TG_TEST_LEAKS = [];   /* v166.29.1: نگهبان نشت تست به دادهٔ واقعی (tgTestCall_) */
var TG_OUTBOX = [];
var TG_MEM = {};

/* ---------- ورودی اصلی ---------- */

function tgHandle(update) {
  const t0 = Date.now();
  try {
    const id = update.update_id;
    if (id && !TG_DRY) {
      const c = CacheService.getScriptCache();
      if (c.get('u' + id)) return;
      c.put('u' + id, '1', 3600);
    }
    /* v166.23: پاسخ دکمه پیش از هر خواندن شیت (خطای query is too old، E-1002، E-1005، E-1010، E-1012) */
    if (update.callback_query && update.callback_query.id && !update.callback_query._ans) {
      update.callback_query._ans = 1;
      try { tgApi_('answerCallbackQuery', { callback_query_id: update.callback_query.id }); } catch (eAq) {}
    }
    TG_CUR = '';
    if (!TG_DRY) TG_OUT_BUF = [];   /* v162: دفتر خروجی آخر کار یک‌جا نوشته می‌شود */
    tgSeen_(update);
    const pc = update.callback_query
      ? (update.callback_query.message && update.callback_query.message.chat ? update.callback_query.message.chat.id : 0)
      : (((update.message || update.edited_message || {}).chat || {}).id || 0);
    var vkOnly_ = false;
    if (pc) {
      TG_CUR = String(pc);
      tgCachePrime_(pc);
      try { vkOnly_ = (typeof vkSkipUser_ === 'function') && vkSkipUser_(pc, update); } catch (eVk) {}
      try {
        var uf = (update.callback_query && update.callback_query.from) ||
                 (update.message && update.message.from) ||
                 (update.edited_message && update.edited_message.from) || {};
        if (!vkOnly_) tgUserTouch_(pc, [uf.first_name, uf.last_name].filter(String).join(' '),
                     uf.username || '', update.callback_query ? 'دکمه' : 'پیام');
      } catch (eUt) {}
    }
    if (update.callback_query) return tgOnCallback_(update.callback_query);

    const m = update.message || update.edited_message;
    if (!m || !m.chat) return;

    const type = m.chat.type;
    if (type === 'group' || type === 'supergroup') return tgGroup_(m);
    if (type !== 'private') return;
    return tgPrivate_(m);
  } catch (err) {
    tgErr_('tgHandle: ' + err);
  } finally {
    try { tgOutFlush_(); } catch (eOf) {}
    if (!TG_DRY) console.log('tgHandle ' + (Date.now() - t0) + 'ms');
    if (!TG_DRY && !vkOnly_) { try { tgEvBot_(update); } catch (eEv) {} }
    if (!TG_DRY && !vkOnly_) { try { tgAppNudge_(update); } catch (eNd) {} }
  }
}

/* ---------- گفت‌وگوی خصوصی ---------- */

function tgPrivate_(m) {
  const chat  = m.chat.id;
  const name  = [m.from.first_name, m.from.last_name].filter(String).join(' ').trim() || 'بدون نام';
  const uname = m.from.username ? '@' + m.from.username : '';
  // هاب ساختمان ونک (building.gs): جدا از بقیهٔ بات، پیش از هر مسیریابی
  if (typeof vkRoute_ === 'function' && vkRoute_(m, chat, name, uname)) return;
  if (typeof tnkRoute_ === 'function' && tnkRoute_(m, chat, name, uname)) return;
  // تجربه پارتنرز v137 (partners.gs): دکمهٔ میز، لینک‌های دعوت، ویزاردها و متن آزاد میز پارتنر
  if (typeof ptRoute_ === 'function' && ptRoute_(m, chat, name, uname)) return;
  /* v170.16: کمپین C-004 (ebi.gs): کدهای ebi، نام و شماره، نوشتن مورد فهرست و ویس، پیش از tgOnPhone_ و کلیدواژه‌ها */
  if (typeof ebiRoute_ === 'function' && ebiRoute_(m, chat, name, uname)) return;
  if (m.text && /^\/start(@\w+)?\s+psy(dr)?-/.test(m.text) && typeof tgPsyJoin_ === 'function' && tgPsyJoin_(chat, uname, name, m.text.replace(/^\/start(@\w+)?\s+/, '').trim())) return;
  if (m.text && /^\/start(@\w+)?\s+(psybook|off|voice|psycard)$/.test(m.text)) { var sp0 = m.text.replace(/^\/start(@\w+)?\s+/, '').trim(); if (sp0 === 'psybook') tgPsyBookStart_(chat); else if (sp0 === 'off') tgOffStart_(chat); else if (sp0 === 'voice') tgEnVolunteerStart_(chat); else tgPsyCardStart_(chat); return; }   /* v159: کدهای شروع مینی‌اپ */
  if (m.text && /^\/start(@\w+)?\s+evp-/.test(m.text) && tgEvPresenterJoin_(chat, uname, name, m.text.replace(/^\/start(@\w+)?\s+/, '').trim())) return;
  if (m.text && /^\/start(@\w+)?\s+evc-/.test(m.text) && tgEvContribJoin_(chat, uname, name, m.text.replace(/^\/start(@\w+)?\s+/, '').trim())) return;
  if (m.text && /^\/start(@\w+)?\s+ev-/.test(m.text)) { var ev0 = tgEvBy_(m.text.replace(/^\/start(@\w+)?\s+ev-/, '').trim()); if (ev0 && tgEvPick_(chat, ev0.title)) return; }
  if (m.text && /^\/start(@\w+)?\s+cp2-/.test(m.text) && tgCoupleJoin_(chat, uname, name, m.text.replace(/^\/start(@\w+)?\s+/, '').trim())) return;
  if (tgGetVal_('enin', chat) && tgEnInput_(chat, m)) return;

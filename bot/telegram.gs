  if (!sh) {
    sh = ss.insertSheet(TG_ANN_TAB);
    sh.setRightToLeft(true);
    sh.getRange(1, 1, 1, TG_ANN_HEAD.length).setValues([TG_ANN_HEAD])
      .setFontWeight('bold').setBackground('#f3efec');
    sh.setFrozenRows(1);
    sh.setColumnWidth(1, 70); sh.setColumnWidth(3, 110);
    sh.setColumnWidth(4, 230); sh.setColumnWidth(5, 430); sh.setColumnWidth(7, 100);
    sh.getRange(2, 7, 200, 1).setDataValidation(
      SpreadsheetApp.newDataValidation().requireValueInList(['پیش‌نویس', 'آمادهٔ انتشار', 'منتشر شد'], true).build());
    sh.getRange(2, 3, 200, 1).setDataValidation(
      SpreadsheetApp.newDataValidation().requireValueInList(TG_ANN_KINDS, true).build());
  }
  return sh;
}

function tgAnnRows_() {
  const sh = tgAnnSheet_();
  const last = sh.getLastRow();
  if (last < 2) return [];
  const wide = Math.min(TG_ANN_HEAD.length + TG_ANN_EXTRA.length, sh.getLastColumn());
  const v = sh.getRange(2, 1, last - 1, wide).getValues();
  const out = [];
  for (var i = 0; i < v.length; i++) {
    const num = Number(tgLatinDigits_(String(v[i][0])).replace(/[^0-9]/g, ''));
    if (!num) continue;
    out.push({
      row: i + 2, num: num,
      date: String(v[i][1]).trim(), kind: String(v[i][2]).trim(),
      title: String(v[i][3]).trim(), body: String(v[i][4]).trim(),
      image: String(v[i][5]).trim(), status: String(v[i][6]).trim(),
      link: String(v[i][8]).trim(),
      aud: String(v[i][10] || '').trim(), pdf: String(v[i][11] || '').trim(),
      replaces: String(v[i][12] || '').trim(), code: String(v[i][13] || '').trim()
    });
  }
  out.sort(function (a, b) { return a.num - b.num; });
  return out;
}

function tgAnnNo_(n) {
  let s = String(n);
  while (s.length < 3) s = '0' + s;
  return tgFa_(s);
}

function tgAnnNext_() {
  const r = tgAnnRows_();
  return r.length ? r[r.length - 1].num + 1 : 1;
}

/* v89: متن اطلاعیه می‌تواند تگ‌های سادهٔ تلگرام داشته باشد. بقیه‌اش امن می‌شود،
   وگرنه تگ خام وسط پاراگراف به کانال می‌رود. */
function tgAnnSafe_(s) {
  var t = tgEsc_(String(s == null ? '' : s));
  t = t.replace(/&lt;(\/?)(b|i|u|s|code)&gt;/g, '<$1$2>');
  t = t.replace(/&lt;a href="([^"<>]+)"&gt;/g, '<a href="$1">');
  t = t.replace(/&lt;\/a&gt;/g, '</a>');
  return t;
}

function tgAnnText_(a) {
  let head = '📣 <b>اطلاعیهٔ ' + tgAnnNo_(a.num) + '</b>';
  if (a.kind) head += ' · ' + tgEsc_(a.kind);
  if (a.date) head += '\n<i>' + tgEsc_(a.date) + '</i>';
  const parts = [head];
  if (a.title) parts.push('<b>' + tgEsc_(a.title) + '</b>');
  if (a.body) parts.push(tgAnnSafe_(a.body));
  parts.push('<i>' + tgAnnCode_(a.num) + '</i>');
  return parts.join('\n\n');
}

function tgChannel_() {
  if (TG_DRY) return '@test_channel';
  return String(PropertiesService.getScriptProperties().getProperty('TG_CHANNEL') || '').trim();
}

/* v88: انتشار زمان‌بندی‌شدهٔ اطلاعیه، تا چیزی بیرون از ساعت کاری به کانال نرود.
   tgAnnSchedule(3, '2026-09-13 10:00')  ·  tgAnnUnschedule()  برای لغو */
function tgAnnDue(e) {
  if (ciPaused_(e, 'tgAnnDue', 'defer')) return;
  var rs0 = Date.now(); try {   /* v166.18: سنجش زمان اجرا (بدنه بی‌تغییر) */
  var p = PropertiesService.getScriptProperties();
  var num = Number(p.getProperty('TG_ANN_DUE') || 0);
  if (num) {
    try { Logger.log(tgAnnPublish(num)); } catch (e) { tgErr_('tgAnnDue: ' + e); }
    p.deleteProperty('TG_ANN_DUE');
  }
  try { ScriptApp.getProjectTriggers().forEach(function (t) { if (t.getHandlerFunction() === 'tgAnnDue') ScriptApp.deleteTrigger(t); }); } catch (e2) {}
  } finally { tgRunStat_('tgAnnDue', rs0); }
}

function tgAnnSchedule(num, when) {
  var at = Utilities.parseDate(when, TG_TZ, 'yyyy-MM-dd HH:mm');
  if (!at || isNaN(at.getTime())) return 'زمان را به شکل yyyy-MM-dd HH:mm بنویسید.';
  PropertiesService.getScriptProperties().setProperty('TG_ANN_DUE', String(num));
  ScriptApp.getProjectTriggers().forEach(function (t) { if (t.getHandlerFunction() === 'tgAnnDue') ScriptApp.deleteTrigger(t); });
  ScriptApp.newTrigger('tgAnnDue').timeBased().at(at).create();
  return 'اطلاعیهٔ ' + tgAnnNo_(num) + ' برای ' + when + ' به وقت تهران زمان‌بندی شد.';
}

function tgAnnUnschedule() {
  PropertiesService.getScriptProperties().deleteProperty('TG_ANN_DUE');
  var n = 0;
  ScriptApp.getProjectTriggers().forEach(function (t) { if (t.getHandlerFunction() === 'tgAnnDue') { ScriptApp.deleteTrigger(t); n++; } });
  return 'زمان‌بندی انتشار لغو شد · ' + tgFa_(n) + ' تریگر برداشته شد.';
}

function tgAnnPublish(num) {
  const ch = tgChannel_();
  if (!ch) return 'اول در Script Properties مقدار TG_CHANNEL را بگذارید، مثلاً @tajrobeh_therapists';
  const rows = tgAnnRows_();
  let a = null;
  for (var i = 0; i < rows.length; i++) {
    if (num) { if (rows[i].num === Number(num)) a = rows[i]; }
    else if (rows[i].status.indexOf('آماده') > -1) { a = rows[i]; break; }
  }
  if (!a) return 'اطلاعیه‌ای برای انتشار پیدا نشد. وضعیت یک سطر را «آمادهٔ انتشار» کنید.';
  if (a.status.indexOf('منتشر') > -1) return 'اطلاعیهٔ ' + tgAnnNo_(a.num) + ' قبلاً منتشر شده.';
  const text = tgAnnText_(a);
  const res = a.image
    ? tgApi_('sendPhoto', { chat_id: ch, photo: a.image, caption: text, parse_mode: 'HTML' })
    : tgApi_('sendMessage', { chat_id: ch, text: text, parse_mode: 'HTML', disable_web_page_preview: true });
  let mid = 0, ok = false, err = '';
  try {
    const j = JSON.parse(res.getContentText());
    ok = !!j.ok; mid = j.ok ? j.result.message_id : 0; err = j.description || '';
  } catch (e) { err = String(e); }
  if (!ok) return 'تلگرام قبول نکرد: ' + err + ' — مطمئن شوید بات ادمین کانال است و اجازهٔ ارسال پیام دارد.';
  const sh = tgAnnSheet_();
  sh.getRange(a.row, 7).setValue('منتشر شد');
  sh.getRange(a.row, 8).setValue(tgJDateFull_(new Date(), TG_TZ));
  if (mid) {
    let link = '';
    if (ch.indexOf('@') === 0) link = 'https://t.me/' + ch.slice(1) + '/' + mid;
    else if (ch.indexOf('-100') === 0) link = 'https://t.me/c/' + ch.slice(4) + '/' + mid;
    if (link) sh.getRange(a.row, 9).setValue(link);
  }
  try {
    const ex = tgAnnExtra_(a.row);
    if (ex.pdf && mid) {
      tgApi_('sendDocument', { chat_id: ch, document: ex.pdf, reply_to_message_id: mid,
        caption: 'پیوست اطلاعیهٔ ' + tgAnnNo_(a.num) });
    }
  } catch (ePdf) {}
  if (a.kind.indexOf('فوری') > -1 && mid) {
    try { tgApi_('pinChatMessage', { chat_id: ch, message_id: mid, disable_notification: true }); } catch (e2) {}
  }
  return 'اطلاعیهٔ ' + tgAnnNo_(a.num) + ' منتشر شد.';
}


function tgAnnSeed001() {
  const sh = tgAnnSheet_();
  if (tgAnnRows_().length) return 'تب اطلاعیه‌ها از قبل سطر دارد؛ دست نزدم.';
  sh.appendRow([1, tgJDateFull_(new Date(), TG_TZ), 'تغییر روال', 'وقت‌هایتان دست خودتان',

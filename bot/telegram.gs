function tgApSvIs_(chat, uname, supName) {
  var sup = tgApSupBy_(supName);
  if (!sup) return null;
  var ids = String(sup.chat || '').split(/[,،;\s]+/).filter(String);
  for (var i = 0; i < ids.length; i++) if (ids[i] === String(chat)) return sup;
  var u = String(uname || '').replace(/^@/, '').toLowerCase();
  if (u && sup.user && sup.user === u) return sup;
  return null;
}

function tgApSvClaim_(chat, uname, supName) {
  var sup = tgApSupBy_(supName);
  if (!sup) return null;
  var already = tgApSvIs_(chat, uname, supName);
  if (already) return already;
  if (sup.chat) return null;
  if (!TG_DRY) {
    try {
      var sh = tgSchSheet_(TG_SCH_T_TEA, TG_SCH_TEA_HEAD);
      sh.getRange(sup.row, 3).setValue(String(chat));
      if (uname && !sup.user) sh.getRange(sup.row, 2).setValue(String(uname).replace(/^@/, ''));
      sh.getRange(sup.row, 8).setValue('وصل شد');
      tgSchDropCache_();
    } catch (e) { tgErr_('tgApSvClaim_: ' + e); }
    try {
      var p = tgWhoPerson_(chat, uname);
      if (p) { p.chatNew = String(chat); tgSchGrantRole_(p, 'سوپروایزر', ''); }
    } catch (e2) {}
  }
  sup.chat = String(chat);
  return sup;
}

function tgApSvOpen_(chat, payload, uname) {
  var raw = String(payload || '');
  var ix = raw.lastIndexOf('-');
  var id = ix > 0 ? raw.slice(0, ix) : raw;
  var tok = ix > 0 ? raw.slice(ix + 1) : '';
  var r = tgApRow_(id);
  if (!r) { tgSend_(chat, 'این پروندهٔ مصاحبه پیدا نشد. شاید لینک قدیمی است.'); return true; }
  var w = tgApWho_(chat, uname);
  if (!w.watch && tok !== tgApTok_(id, r.sup)) {
    tgSend_(chat, 'این لینک معتبر نیست. از ناظر لینک تازه بگیرید.');
    return true;
  }
  var who = w.watch ? { name: 'ناظر' } : tgApSvClaim_(chat, uname, r.sup);
  if (!who) {
    tgSend_(chat, 'این لینک برای سوپروایزری است که مصاحبه به او سپرده شده.\n' +
                  'اگر شما همان هستید، به یاسر بگویید یوزرنیم تلگرامتان در تب «استادان و سوپروایزرها» ثبت شود.');
    return true;
  }
  tgSend_(chat, '👋 سلام ' + tgEsc_(who.name || '') + '.\n' +
                'یک مصاحبهٔ جذب تراپیست با شماست. ممنون که وقت می‌گذارید.');
  tgApSvCard_(chat, r);
  return true;
}


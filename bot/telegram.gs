// کد لید را برای همهٔ سطرهای بی‌کد پر می‌کند (بی‌ضرر، قابل تکرار)
function tgLeadCodesFill() {
  const sh = tgSS_().getSheetByName(TG_LEADS);
  const col = tgLeadCodeCol_();
  const last = sh.getLastRow();
  if (last < 2) { Logger.log('سطری نیست.'); return; }
  const names = sh.getRange(2, 4, last - 1, 1).getValues();
  const phones = sh.getRange(2, 6, last - 1, 1).getValues();
  const cur = sh.getRange(2, col, last - 1, 1).getValues();
  var max = TG_LEAD_CODE_FIRST - 1;
  for (var i = 0; i < cur.length; i++) {
    const m = String(cur[i][0] || '').trim().match(/^L-(\d+)$/);
    if (m && Number(m[1]) > max) max = Number(m[1]);
  }
  var n = 0;
  for (var j = 0; j < cur.length; j++) {
    if (String(cur[j][0] || '').trim()) continue;
    if (!String(names[j][0] || '').trim() && !String(phones[j][0] || '').trim()) continue;
    max++; cur[j][0] = 'L-' + max; n++;
  }
  sh.getRange(2, col, last - 1, 1).setValues(cur);
  Logger.log('کد لید برای ' + n + ' سطر نوشته شد. آخرین کد: L-' + max);
}

/* ---------- مهاجرت یک‌باره به واژگان واحد (v140) ----------
   tgLeadStPreview(): فقط می‌شمارد و می‌نویسد چه می‌شود (بی‌خطر).
   tgLeadStMigrate(): با اجازهٔ یاسر: ستون وضعیت را بازنویسی می‌کند، مقدار قدیمی بستن را در «دلیل بستن» می‌گذارد،
   برای هر تغییر یک رویداد می‌نویسد، هدرهای ستون‌های ثابت را ترمیم می‌کند و فهرست کشویی روی ستون وضعیت می‌گذارد. */
function tgLeadStPlan_() {
  const sh = tgSS_().getSheetByName(TG_LEADS);
  const last = sh.getLastRow();
  const codeCol = tgLeadCodeCol_();
  const reasonCol = tgLeadCol_('دلیل بستن');
  const out = { rows: [], counts: {}, unknown: [], last: last, reasonCol: reasonCol, codeCol: codeCol };
  if (last < 2) return out;
  const st = sh.getRange(2, 9, last - 1, 1).getValues();
  const rs = sh.getRange(2, reasonCol, last - 1, 1).getValues();
  const cd = sh.getRange(2, codeCol, last - 1, 1).getValues();
  const nm = sh.getRange(2, 4, last - 1, 3).getValues();
  for (var i = 0; i < st.length; i++) {
    const raw = String(st[i][0] || '').trim();
    if (!raw) continue;
    if (!String(nm[i][0] || '').trim() && !String(nm[i][2] || '').trim()) continue;
    const nz = tgStNorm_(raw);
    if (!nz.changed) continue;
    const to = nz.st || (String(sh.getRange(i + 2, 11).getValue() || '').trim() ? TG_ST.FOLLOW : TG_ST.NEW);
    const key = raw + ' → ' + to;
    out.counts[key] = (out.counts[key] || 0) + 1;
    if (!nz.known) out.unknown.push('سطر ' + (i + 2) + ': «' + raw + '» → ' + to);
    out.rows.push({ row: i + 2, from: raw, to: to, code: String(cd[i][0] || '').trim(),
                    reason: (to === TG_ST.CLOSED && !String(rs[i][0] || '').trim()) ? raw : '' });
  }
  return out;
}

function tgLeadStPreview() {
  const p = tgLeadStPlan_();
  const lines = ['سطرها: ' + (p.last - 1), 'تغییر لازم: ' + p.rows.length, ''];
  for (var k in p.counts) lines.push(p.counts[k] + ' × ' + k);
  if (p.unknown.length) lines.push('', 'ناشناس (حدسی):', p.unknown.join('\n'));
  const head = tgSS_().getSheetByName(TG_LEADS).getRange(1, 1, 1, 23).getValues()[0];
  for (var f in TG_LEAD_FIXED) if (String(head[TG_LEAD_FIXED[f] - 1] || '').trim() !== f) lines.push('', 'هدر ستون ' + TG_LEAD_FIXED[f] + ' الان «' + head[TG_LEAD_FIXED[f] - 1] + '» است و «' + f + '» می‌شود');
  Logger.log(lines.join('\n'));
  return lines.join('\n');
}

function tgLeadStMigrate() {
  const sh = tgSS_().getSheetByName(TG_LEADS);
  const p = tgLeadStPlan_();
  const stamp = new Date();
  var fixedHead = 0;
  const head = sh.getRange(1, 1, 1, 23).getValues()[0];
  for (var f in TG_LEAD_FIXED) {
    if (String(head[TG_LEAD_FIXED[f] - 1] || '').trim() !== f) { sh.getRange(1, TG_LEAD_FIXED[f]).setValue(f).setFontWeight('bold'); fixedHead++; }
  }
  TG_LEAD_HM_ = null;
  if (p.rows.length) {
    const st = sh.getRange(2, 9, p.last - 1, 1).getValues();
    const rs = sh.getRange(2, p.reasonCol, p.last - 1, 1).getValues();
    const ev = [];
    for (var i = 0; i < p.rows.length; i++) {
      const r = p.rows[i];
      st[r.row - 2][0] = r.to;
      if (r.reason) rs[r.row - 2][0] = r.reason;
      ev.push([stamp, r.code, r.row, 'بات', 'مهاجرت', 'وضعیت', r.from, r.to, 'یکسان‌سازی واژگان v140']);
    }
    sh.getRange(2, 9, p.last - 1, 1).setValues(st);
    sh.getRange(2, p.reasonCol, p.last - 1, 1).setValues(rs);
    const es = tgLeadEvSheet_();
    if (es) es.getRange(es.getLastRow() + 1, 1, ev.length, ev[0].length).setValues(ev);
  }
  // فهرست کشویی روی ستون وضعیت؛ مقدار خارج از فهرست رد نمی‌شود (هشدار می‌گیرد) تا کار تیم نایستد، بات خودش برمی‌گرداند
  const rule = SpreadsheetApp.newDataValidation().requireValueInList(TG_LEAD_ST, true).setAllowInvalid(true)
    .setHelpText('وضعیت‌ها: ' + TG_LEAD_ST.join(' ← ')).build();
  sh.getRange(2, 9, Math.max(sh.getMaxRows() - 1, 1), 1).setDataValidation(rule);
  try { CacheService.getScriptCache().remove('closedset'); } catch (e) {}
  const msg = 'مهاجرت انجام شد: ' + p.rows.length + ' سطر بازنویسی شد، ' + fixedHead + ' هدر ترمیم شد، فهرست کشویی روی ستون وضعیت نشست.';
  Logger.log(msg);
  return msg;
}


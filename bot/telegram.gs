/* ---------- API مینی‌اپ ---------- */
function tgApiRoute_(p) {
  const api = String(p.api || '');
  let out = { ok: false, error: 'unknown' };
  try {
    if (api === 'ping') out = { ok: true, t: Date.now() };
    else if (api === 'camp') out = tgCpApi_(p);
    else if (api === 'config') out = {
      ok: true,
      topics: TG_TOPICS.map(function (x) { return { k: x.k, label: x.label }; }),
      genders: TG_GENDERS.map(function (x) { return { k: x.k, label: x.label }; }),
      zones: [TG_ZONE_IR].concat(TG_ZONES).map(function (z) { return { key: z.key, label: z.label }; }),
      mode: tgDayMode_(), meetMin: TG_MEET_MIN
    };
    else if (api === 'slots') out = tgApiSlotsCached_(p);   /* v166.7: کش ده‌دقیقه‌ای */
    else if (api === 'book') out = tgApiGuard_(p, 'مراجع') || tgApiBook2_(p);
    else if (api === 'me') out = tgApiMe_(p);
    else if (api === 'cap') out = tgApiCap_(p);
    else if (api === 'boot') out = tgApiBoot_(p);
    else if (api === 'dash.me') out = tgApiDash_(p);
    else if (api === 'task.my') out = tgApiTaskMy_(p);
    else if (api === 'task.act') out = tgApiC_(p, '', ['tk:', 'db:']);
    else if (api === 'task.say') out = tgApiT_(p, '', p.text);
    else if (api === 'task.new') out = tgApiGuard_(p, 'ناظر') || tgApiTaskNew_(p);
    else if (api === 'box.list') out = tgApiBoxList_(p);

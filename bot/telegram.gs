function tgUseWebhook() {
  const props = PropertiesService.getScriptProperties();
  const relay = props.getProperty('TG_RELAY_URL');
  if (!relay) {
    Logger.log('TG_RELAY_URL خالی است. وبهوک مستقیم روی Apps Script کار نمی‌کند (302). پولینگ روشن می‌ماند.');
    return;
  }
  let secret = props.getProperty('TG_HOOK_SECRET');
  if (!secret) { secret = Utilities.getUuid().replace(/-/g, ''); props.setProperty('TG_HOOK_SECRET', secret); }
  ScriptApp.getProjectTriggers().forEach(function (t) {
    if (t.getHandlerFunction() === 'tgPoll') ScriptApp.deleteTrigger(t);
  });
  const url = relay + (relay.indexOf('?') > -1 ? '&' : '?') + 't=' + secret;
  props.setProperty('TG_HOOK_SET_AT', String(Math.floor(Date.now() / 1000)));
  Logger.log('setWebhook → ' + tgApi_('setWebhook', {
    url: url, max_connections: 40, drop_pending_updates: false,
    allowed_updates: ['message', 'edited_message', 'callback_query']
  }).getContentText());
  Utilities.sleep(1500);
  Logger.log('getWebhookInfo → ' + tgApi_('getWebhookInfo', {}).getContentText().replace(/([?&]t=)[^"&]+/g, '$1***'));   /* v170.9: رمز در لاگ نیاید */
}

function tgPoll() {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(2000)) return;
  try {
    const props = PropertiesService.getScriptProperties();
    let offset = Number(props.getProperty('TG_OFFSET') || 0);
    const started = Date.now();
    let round = 0, idle = 0;

    while (Date.now() - started < TG_BURST_MS) {
      const res = tgApi_('getUpdates', {
        offset: offset, limit: 20, timeout: (round === 0 ? 0 : TG_LONGPOLL)
      });
      let data; try { data = JSON.parse(res.getContentText()); } catch (e) { break; }
      if (!data.ok) break;
      const list = data.result || [];
      if (!list.length) {
        if (round === 0) break;
        idle++;
        if (idle >= 2) break;
      } else {
        idle = 0;
        for (var i = 0; i < list.length; i++) {
          tgHandle(list[i]);
          if (list[i].update_id >= offset) offset = list[i].update_id + 1;
        }
        props.setProperty('TG_OFFSET', String(offset));
      }
      round++;
    }
    props.setProperty('TG_OFFSET', String(offset));
  } catch (e) {
    tgErr_('tgPoll: ' + e);
  } finally {
    lock.releaseLock();
  }
}


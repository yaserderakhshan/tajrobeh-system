/* ═══════════ حضوری: مکان‌ها و ساعت‌های حضوری (v67، v68: اتاق‌ها، ظرفیت و بررسی) ═══════════
   دو تب در هاب: «مکان‌های حضوری» (هر ردیف یک مکان: کلینیک خود تجربه یا پارتنر) و «ساعت‌های حضوری» (هر ردیف حضور یک درمانگر در یک مکان).
   ساختار از برنامهٔ اتاق‌های کلینیک گاندی آمده ولی ردیفی است تا هر پارتنر فقط ردیف‌های خودش را پر کند و بات راحت بخواند.
   مسیر مراجع: «حضوری» ← مکان ← روز ← درمانگر و ساعت ← شماره. معارفه همچنان آنلاین و رایگان است؛ درمان حضوری.
   پذیرش ساعت دقیق را هماهنگ می‌کند؛ بات اتاق رزرو نمی‌کند. */
var TG_INP_PLACES = 'مکان‌های حضوری';
var TG_INP_HOURS  = 'ساعت‌های حضوری';
var TG_INP_PHEAD  = ['شناسه', 'شهر', 'نام مکان', 'نوع', 'مسئول', 'محله', 'وضعیت', 'ترتیب', 'یادداشت'];
var TG_INP_HHEAD  = ['مکان (شناسه)', 'درمانگر', 'روز', 'از ساعت', 'تا ساعت', 'اتاق', 'مراجع تازه می‌پذیرد؟', 'یادداشت', 'بررسی', 'تاریخ بررسی', 'تأیید درمانگر'];
/* v68: ظرفیت با اشغال فرق دارد. تب «اتاق‌های حضوری» ظرفیت هر اتاق است (روز و ساعت باز)، ساعت‌های درمانگرها اشغال،
   و تب «ظرفیت حضوری» هر ساعت از روی این دو ساخته می‌شود: درصد اشغال، بازه‌های خالی، تداخل‌ها و پیشنهاد پرکردن.
   تب «بررسی حضوری» دفتر چک برنامه با مسئول هر مکان است: چه فرستاده شد، چه جوابی آمد، چه اعمال شد. */
var TG_INP_ROOMS  = 'اتاق‌های حضوری';
var TG_INP_RHEAD  = ['مکان (شناسه)', 'اتاق', 'برای', 'روزهای باز', 'از ساعت', 'تا ساعت', 'وضعیت', 'یادداشت'];
var TG_INP_CAP    = 'ظرفیت حضوری';
var TG_INP_LOG    = 'بررسی حضوری';
var TG_INP_LHEAD  = ['زمان', 'مکان', 'گیرنده', 'وضعیت', 'فهرست فرستاده‌شده', 'پاسخ', 'یادداشت'];
var TG_INP_CHK    = ['در انتظار تأیید', 'تأیید شد', 'اصلاح شد', 'ساعت نامشخص'];
var TG_INP_PARTS  = [['صبح', 9, 13], ['ظهر', 13, 17], ['عصر و شب', 17, 22]];
var TG_INP_STATUS = ['فعال', 'به‌زودی', 'بررسی', 'غیرفعال'];
var TG_INP_DAYS   = ['شنبه', 'یکشنبه', 'دوشنبه', 'سه‌شنبه', 'چهارشنبه', 'پنجشنبه', 'جمعه'];
/* پیشنهاد حضوری به درمانگرها: منطقش آماده است ولی به خواست یاسر فعلاً برای درمانگرها فرستاده نمی‌شود */
var TG_INP_OFFER  = false;

var T_INP_WHERE = '🏢 <b>جلسهٔ حضوری، کجا؟</b>\n\nالان در این شهرها جلسهٔ حضوری داریم. جلسهٔ معارفه، مثل همیشه، آنلاین و رایگان است و بعد از آن جلسه‌ها حضوری برگزار می‌شود.';
var T_INP_OTHER = 'فعلاً در شهر شما فضای حضوری نداریم، ولی جلسهٔ آنلاین با همان درمانگرها ممکن است. درخواستتان را با «حضوری در شهر دیگر» ثبت می‌کنیم و اگر آنجا حضوری راه افتاد، پذیرش خبرتان می‌کند.';
var T_INP_NOHRS = 'در {p} جلسهٔ حضوری داریم. پذیرش درمانگر و ساعت مناسب را با شما هماهنگ می‌کند.';

function tgInpDay_(s) {
  var k = String(s || '').replace(/[\s‌]+/g, '');
  for (var i = 0; i < TG_INP_DAYS.length; i++) if (TG_INP_DAYS[i].replace(/‌/g, '') === k) return TG_INP_DAYS[i];
  return String(s || '').trim();
}

/* دادهٔ دو تب، ده دقیقه در کش */
function tgInpData_() {
  if (TG_DRY) return TG_MEM['inp'] || { places: [], hours: [] };
  var c = CacheService.getScriptCache(), hit = c.get('inpdata');
  if (hit) { try { return JSON.parse(hit); } catch (e) {} }
  var ss = tgSS_(), d = { places: [], hours: [], rooms: [] };
  var ps = ss.getSheetByName(TG_INP_PLACES), hs = ss.getSheetByName(TG_INP_HOURS), rs = ss.getSheetByName(TG_INP_ROOMS);
  if (rs && rs.getLastRow() > 1) rs.getRange(2, 1, rs.getLastRow() - 1, TG_INP_RHEAD.length).getDisplayValues().forEach(function (r) {
    if (String(r[0]).trim() && String(r[1]).trim()) d.rooms.push({ p: String(r[0]).trim(), room: String(r[1]).trim(), kind: String(r[2]).trim(),
      days: String(r[3]).trim(), from: String(r[4]).trim(), to: String(r[5]).trim(), status: String(r[6]).trim() });
  });
  if (ps && ps.getLastRow() > 1) ps.getRange(2, 1, ps.getLastRow() - 1, TG_INP_PHEAD.length).getDisplayValues().forEach(function (r) {
    if (String(r[0]).trim()) d.places.push({ id: String(r[0]).trim(), city: String(r[1]).trim(), name: String(r[2]).trim(), kind: String(r[3]).trim(),
      area: String(r[5]).trim(), status: String(r[6]).trim(), ord: Number(tgLatinDigits_(r[7])) || 99 });
  });
  var hIx = { r: -1, f: -1 };
  if (hs && hs.getLastRow() > 1) { try { var hh0 = hs.getRange(1, 1, 1, hs.getLastColumn()).getDisplayValues()[0].map(function (x) { return String(x).trim(); }); hIx.r = hh0.indexOf('تکرار'); hIx.f = hh0.indexOf('از تاریخ'); } catch (eHx) {} }
  var hW = Math.max(TG_INP_HHEAD.length, hIx.r + 1, hIx.f + 1);
  if (hs && hs.getLastRow() > 1) hs.getRange(2, 1, hs.getLastRow() - 1, hW).getDisplayValues().forEach(function (r) {
    if (String(r[0]).trim() && String(r[1]).trim()) d.hours.push({ p: String(r[0]).trim(), who: String(r[1]).trim(), day: tgInpDay_(r[2]),
      from: String(r[3]).trim(), to: String(r[4]).trim(), room: String(r[5]).trim(), open: String(r[6]).trim(), chk: String(r[8] || '').trim(), me: String(r[10] || '').trim(),
      rc: hIx.r > -1 ? String(r[hIx.r] || '').trim() : '', rf: hIx.f > -1 ? String(r[hIx.f] || '').trim() : '' });
  });
  try { c.put('inpdata', JSON.stringify(d), 600); } catch (e) {}
  return d;
}
function tgInpPlaces_() {
  return tgInpData_().places.filter(function (p) { return p.status === 'فعال'; }).sort(function (a, b) { return a.ord - b.ord; });
}
function tgInpPlace_(id) { var ps = tgInpPlaces_(); for (var i = 0; i < ps.length; i++) if (ps[i].id === id) return ps[i]; return null; }
function tgInpLabel_(p) { return p.city + (p.area ? ' · ' + p.area : ''); }
/* ساعت‌هایی که مراجع تازه می‌پذیرند، به ترتیب روز هفته */
function tgInpHours_(pid) {
  /* v168 فاز ۶: فقط ساعتی که «بررسی»اش تأیید شده (عرضهٔ واقعی) */
  return tgInpData_().hours.filter(function (h) { return h.p === pid && !/^(ندارد|خیر|پر|نه)/.test(h.open) && !(h.day && !h.from) && (typeof v168HourOk_ !== 'function' || v168HourOk_(h)); })
    .sort(function (a, b) { return (TG_INP_DAYS.indexOf(a.day) + 1 || 9) - (TG_INP_DAYS.indexOf(b.day) + 1 || 9); });
}
function tgInpSlot_(h, withDay) {
  var t = h.from ? tgFa_(h.from) + (h.to ? ' تا ' + tgFa_(h.to) : '') : 'با هماهنگی';
  return (withDay && h.day ? h.day + ' ' : '') + t;
}
/* برای ستون «حالت جلسه» لید: جزئیات انتخاب حضوری */
function tgInpWant_(chat) {
  if (tgGetVal_('qm', chat) === 'on') return '';
  var d = tgGetVal_('qp', chat);
  return d ? ' · ' + d : '';
}

/* md: از سؤال شکل جلسه */
function tgInpMode_(chat, key) {
  tgSetVal_('qp', chat, '');
  if (key === 'on') return tgQuizFinish_(chat, key);
  var ps = tgInpPlaces_();
  if (!ps.length) return tgQuizFinish_(chat, key);
  var rows = ps.map(function (p) { return [{ text: '📍 ' + tgInpLabel_(p), callback_data: 'ip:' + p.id }]; });
  rows.push([{ text: '🏙 شهر دیگری', callback_data: 'ip:-' }, { text: '💻 آنلاین، همین بهتر', callback_data: 'md:on' }]);
  return tgSend_(chat, T_INP_WHERE, { inline_keyboard: rows });
}

/* ip: مکان انتخاب شد */
function tgInpPick_(chat, pid) {
  var cityAsk = pid === '-' && typeof v168CfgText_ === 'function' ? v168CfgText_('city_prompt') : '';
  if (cityAsk) { tgSetVal_('qp', chat, 'شهر دیگر'); tgSetVal_('qpid', chat, ''); tgSetVal_('qcity', chat, '?'); return tgSend_(chat, cityAsk); }   /* v168: نام شهر، با متن تیم */
  if (pid === '-') { tgSetVal_('qp', chat, 'شهر دیگر'); tgInpDemand_('مراجع', '-', '', '', String(chat), 'حضوری در شهری که مکان نداریم'); tgSend_(chat, T_INP_OTHER); return tgQuizFinish_(chat, 'city'); }
  var p = tgInpPlace_(pid);
  if (!p) return tgInpMode_(chat, 'teh');
  tgSetVal_('qpid', chat, p.id);   /* v168 */
  tgSetVal_('qp', chat, tgInpLabel_(p));
  tgSetVal_('qpk', chat, p.city === 'تهران' ? 'teh' : 'city');
  var hs = tgInpHours_(p.id);
  if (!hs.length) { if (typeof v168NoSupply_ === 'function') v168NoSupply_(chat, p); tgSend_(chat, T_INP_NOHRS.replace('{p}', tgInpLabel_(p))); return tgQuizFinish_(chat, tgGetVal_('qpk', chat)); }
  var days = TG_INP_DAYS.filter(function (d) { return hs.some(function (h) { return h.day === d; }); });
  if (hs.length <= 6 || days.length < 2) return tgInpList_(chat, p, hs, '');
  var kb = [], r = [];
  days.forEach(function (d) { r.push({ text: d, callback_data: 'iy:' + p.id + ':' + TG_INP_DAYS.indexOf(d) }); if (r.length === 3) { kb.push(r); r = []; } });
  if (r.length) kb.push(r);
  kb.push([{ text: 'هر روزی، فرقی ندارد', callback_data: 'iy:' + p.id + ':*' }]);
  return tgSend_(chat, '📍 <b>' + tgEsc_(tgInpLabel_(p)) + '</b>\n\nکدام روز برایتان بهتر است؟', { inline_keyboard: kb });
}

/* iy: روز انتخاب شد */
function tgInpDayPick_(chat, arg) {
  var at = arg.lastIndexOf(':'), pid = arg.slice(0, at), di = arg.slice(at + 1);
  var p = tgInpPlace_(pid);
  if (!p) return tgInpMode_(chat, 'teh');
  var day = di === '*' ? '' : TG_INP_DAYS[Number(di)] || '';
  var hs = tgInpHours_(p.id).filter(function (h) { return !day || h.day === day; });
  return tgInpList_(chat, p, hs, day);
}

/* فهرست درمانگرها و ساعت‌هایشان؛ هر درمانگر یک دکمه */
function tgInpList_(chat, p, hs, day) {
  var by = {}, order = [];
  hs.forEach(function (h) { if (!by[h.who]) { by[h.who] = []; order.push(h.who); } by[h.who].push(h); });
  var opts = [], lines = [], kb = [];
  order.forEach(function (w, i) {
    var slots = by[w].map(function (h) { return tgInpSlot_(h, !day); }).filter(function (s, j, a) { return a.indexOf(s) === j; }).join(' · ');
    opts.push(w + (day ? ' · ' + day : '') + ' · ' + slots);
    lines.push('▫️ <b>' + tgEsc_(w) + '</b>\n    ' + tgEsc_(slots));
    kb.push([{ text: w, callback_data: 'it:' + i }]);
  });
  kb.push([{ text: 'هر کدام، پذیرش هماهنگ کند', callback_data: 'it:*' }]);
  if (day) kb.push([{ text: '↩ روز دیگر', callback_data: 'ip:' + p.id }]);
  tgSetVal_('qpl', chat, JSON.stringify(opts));
  var head = '📍 <b>' + tgEsc_(tgInpLabel_(p)) + (day ? '، ' + day : '') + '</b>\n\n';
  if (!lines.length) tgInpDemand_('مراجع', p.id, day, '', String(chat), 'در این روز درمانگر حضوری نبود');
  return tgSend_(chat, head + (lines.length ? lines.join('\n') : 'این روز کسی نیست؛ «روز دیگر» یا «هر کدام» را بزنید.') +
    '\n\nکسی را که دوست دارید بزنید. ساعت دقیق را پذیرش با شما و درمانگر هماهنگ می‌کند.', { inline_keyboard: kb });
}

/* it: درمانگر انتخاب شد ← شماره */
function tgInpWho_(chat, n) {
  var opts = []; try { opts = JSON.parse(tgGetVal_('qpl', chat) || '[]'); } catch (e) {}
  var base = String(tgGetVal_('qp', chat) || '').split(' · ').slice(0, 2).join(' · ');
  var pick = n === '*' ? 'هر درمانگری' : (opts[Number(n)] || 'هر درمانگری');
  tgSetVal_('qp', chat, base + ' · ' + pick);
  if (n !== '*' && opts[Number(n)]) tgSend_(chat, '✅ ' + tgEsc_(pick.split(' · ')[0]) + '، حضوری در ' + tgEsc_(base) + '. معارفه اول آنلاین است.');
  return tgQuizFinish_(chat, tgGetVal_('qpk', chat) || 'teh');
}

/* ───── درمانگرها: شهرشان فضای حضوری دارد؟ (فعلاً خاموش: TG_INP_OFFER) ───── */
var T_INP_OFFER = '🏢 یک خبر کوچک: در {c} فضای حضوری تجربه داریم. اگر دوست دارید آنجا هم مراجع حضوری ببینید، بزنید تا پذیرش برای برنامهٔ اتاق با شما هماهنگ کند. هیچ تعهدی نمی‌آورد.';
function tgInpOfferFor_(v) {
  if (!v) return null;
  var cities = String(v.city || '').split(/\s*[،,]\s*/).map(function (x) { return x.trim(); }).filter(String);
  var k = function (s) { return String(s || '').replace(/دکتر|[\s‌]/g, ''); };   /* «روشن فر» و «روشن‌فرد» یکی است */
  var name = k(v.name), hrs = tgInpData_().hours;
  var ps = tgInpPlaces_();
  for (var i = 0; i < ps.length; i++) {
    if (cities.indexOf(ps[i].city) < 0) continue;
    var already = hrs.some(function (h) { var w = k(h.who); return h.p === ps[i].id && w && name && (w.indexOf(name) > -1 || name.indexOf(w) > -1); });
    if (!already) return ps[i];
  }
  return null;
}
function tgInpOffer_(chat, id, v) {
  if (!TG_INP_OFFER || !v || String(v.inpoffer || '') || String(id).indexOf('ther:') !== 0) return false;
  var p = tgInpOfferFor_(v);
  if (!p) return false;
  tgPqPut_(id, { inpoffer: 'پرسیده شد · ' + tgPqNow_() });
  tgSend_(chat, T_INP_OFFER.replace('{c}', tgEsc_(tgInpLabel_(p))), { inline_keyboard: [[{ text: '🏢 بله، علاقه دارم', callback_data: 'pq:iy' }, { text: 'فعلاً نه', callback_data: 'pq:in' }]] });
  return true;
}
function tgInpOfferAns_(chat, yes) {
  var who = tgPqWho_(chat);
  if (!who.name) return tgSend_(chat, T_PQ_NOID);
  var id = tgPqId_(who), rec = tgPqRec_(id, false), p = rec ? tgInpOfferFor_(rec.v) : null;
  tgPqPut_(id, { inpoffer: (yes ? 'علاقه دارد' : 'فعلاً نه') + (p ? ' · ' + tgInpLabel_(p) : '') + ' · ' + tgPqNow_() });
  if (yes) { try { tgPrNotify_(id, '🏢 <b>حضوری</b> · ' + tgEsc_(who.name) + ' دوست دارد در ' + tgEsc_(p ? tgInpLabel_(p) : 'شهرش') + ' حضوری هم ببیند. برای اتاق هماهنگ کنید.'); } catch (e) {} }
  return tgSend_(chat, yes ? '✅ ممنون. پذیرش برای برنامهٔ اتاق با شما هماهنگ می‌کند.' : 'باشد، هر وقت خواستید به پذیرش بگویید.');
}
/* پیش‌نمایش: اگر پیشنهاد روشن شود، به چه کسانی می‌رسد؟ چیزی فرستاده نمی‌شود مگر send */
function tgInpOfferPreview(send) {
  var out = [];
  tgPrAll_().forEach(function (r) {
    var v = r.v, to = String(v.chat || '').split(/[,،;\s]+/)[0];
    if (String(v.id || '').indexOf('ther:') !== 0 || String(v.inpoffer || '')) return;
    var p = tgInpOfferFor_(v);
    if (!p) return;
    if (!send || !to) { out.push('… ' + v.name + ' ← ' + tgInpLabel_(p)); return; }
    var was = TG_INP_OFFER; TG_INP_OFFER = true;
    try { tgInpOffer_(to, v.id, v); out.push('✅ ' + v.name); } catch (e) { out.push('❌ ' + v.name + ': ' + (e.message || e)); }
    TG_INP_OFFER = was;
  });
  Logger.log(out.join('\n') || 'کسی نبود.');
  return out;
}

/* ───── ساخت دو تب در هاب (یک‌بار؛ اگر تب هست دست نمی‌زند) ───── */
function tgInpSetup() {
  var ss = tgSS_(), log = [];
  var ps = ss.getSheetByName(TG_INP_PLACES);
  if (!ps) {
    ps = ss.insertSheet(TG_INP_PLACES); ps.setRightToLeft(true);
    ps.getRange(1, 1, 1, TG_INP_PHEAD.length).setValues([TG_INP_PHEAD]).setFontWeight('bold').setBackground('#f3efec');
    var seedP = tgInpSeedPlaces_();
    ps.getRange(2, 1, seedP.length, TG_INP_PHEAD.length).setValues(seedP);
    ps.getRange(2, 7, 200, 1).setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(TG_INP_STATUS, true).build());
    ps.setFrozenRows(1); ps.setColumnWidth(3, 190); ps.setColumnWidth(9, 260);
    log.push('✅ ' + TG_INP_PLACES + ': ' + seedP.length + ' مکان');
  } else log.push('— ' + TG_INP_PLACES + ' از قبل هست');
  var hs = ss.getSheetByName(TG_INP_HOURS);
  if (!hs) {
    hs = ss.insertSheet(TG_INP_HOURS); hs.setRightToLeft(true);
    hs.getRange(1, 1, 1, TG_INP_HHEAD.length).setValues([TG_INP_HHEAD]).setFontWeight('bold').setBackground('#f3efec');
    var seedH = tgInpSeedHours_();
    hs.getRange(2, 1, seedH.length, TG_INP_HHEAD.length).setNumberFormat('@').setValues(seedH);
    hs.getRange(2, 3, 500, 1).setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(TG_INP_DAYS, true).build());
    hs.getRange(2, 7, 500, 1).setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(['دارد', 'ندارد'], true).build());
    hs.getRange(2, 4, 500, 2).setNumberFormat('@');
    hs.setFrozenRows(1); hs.setColumnWidth(2, 160); hs.setColumnWidth(8, 240);
    log.push('✅ ' + TG_INP_HOURS + ': ' + seedH.length + ' ردیف');
  } else log.push('— ' + TG_INP_HOURS + ' از قبل هست');
  CacheService.getScriptCache().remove('inpdata');
  Logger.log(log.join('\n'));
  return log;
}
/* v170.14: دادهٔ اولیهٔ مکان‌ها و ساعت‌های حضوری نام درمانگران را دارد و در کد نیست؛ کلید اختیاری TG_INP_SEED ({places, hours}).
   تب‌ها از قبل ساخته شده‌اند و این دو فقط برای هاب تازه به کار می‌آیند. */
function tgInpSeedPlaces_() { return (cfg_('TG_INP_SEED', {}) || {}).places || []; }
function tgInpSeedHours_() { return (cfg_('TG_INP_SEED', {}) || {}).hours || []; }

/* ═══════════ v68: ظرفیت، اشغال و بررسی برنامه با مسئول مکان ═══════════ */
/* «۹»، «۹:۳۰»، «۱۸:۳۰» ← ساعت اعشاری */
function tgInpH_(s) {
  var m = String(tgLatinDigits_(s || '')).match(/(\d{1,2})(?:[:.](\d{1,2}))?/);
  return m ? Number(m[1]) + (m[2] ? Number(m[2]) / 60 : 0) : null;
}
function tgInpHs_(h) { var x = Math.floor(h), m = Math.round((h - x) * 60); return tgFa_(x) + (m ? ':' + tgFa_(m < 10 ? '0' + m : m) : ''); }
/* «۶ (کودک)» و «6» یک اتاق است */
function tgInpRoomKey_(s) { var m = String(tgLatinDigits_(s || '')).match(/\d+/); return m ? m[0] : String(s || '').trim(); }
function tgInpNameKey_(s) { return String(s || '').replace(/دکتر|[\s‌]/g, ''); }
/* «همه» یا «شنبه، یکشنبه» یا «شنبه تا چهارشنبه» */
function tgInpDaysOf_(s) {
  s = String(s || '').trim();
  if (!s || /همه|هر روز/.test(s)) return TG_INP_DAYS.slice();
  var mm = s.match(/^(\S+)\s+تا\s+(\S+)$/);
  if (mm) { var a = TG_INP_DAYS.indexOf(tgInpDay_(mm[1])), b = TG_INP_DAYS.indexOf(tgInpDay_(mm[2])); if (a > -1 && b >= a) return TG_INP_DAYS.slice(a, b + 1); }
  return s.split(/\s*[،,]\s*/).map(tgInpDay_).filter(function (d) { return TG_INP_DAYS.indexOf(d) > -1; });
}
function tgInpMerge_(iv) {
  iv = iv.slice().sort(function (a, b) { return a[0] - b[0]; });
  var out = [];
  iv.forEach(function (x) { if (out.length && x[0] <= out[out.length - 1][1]) out[out.length - 1][1] = Math.max(out[out.length - 1][1], x[1]); else out.push([x[0], x[1]]); });
  return out;
}

/* محاسبهٔ ظرفیت یک مکان: هر اتاق در هر روز باز، ساعت ظرفیت، ساعت پر، بازه‌های خالی و تداخل‌ها */
function tgInpCap_(pid, d) {
  d = d || tgInpData_();
  var rooms = (d.rooms || []).filter(function (r) { return r.p === pid && r.status !== 'غیرفعال'; });
  var hrs = d.hours.filter(function (h) { return h.p === pid && h.day; });
  var cells = [], clash = [], tot = { cap: 0, used: 0 }, parts = TG_INP_PARTS.map(function () { return { cap: 0, used: 0 }; });
  rooms.forEach(function (r) {
    var a = tgInpH_(r.from), b = tgInpH_(r.to);
    if (a == null || b == null || b <= a) return;
    tgInpDaysOf_(r.days).forEach(function (day) {
      var mine = hrs.filter(function (h) { return h.day === day && tgInpRoomKey_(h.room) === tgInpRoomKey_(r.room) && tgInpH_(h.from) != null && tgInpH_(h.to) != null; });
      var iv = mine.map(function (h) { return [Math.max(a, tgInpH_(h.from)), Math.min(b, tgInpH_(h.to))]; }).filter(function (x) { return x[1] > x[0]; });
      for (var i = 0; i < mine.length; i++) for (var j = i + 1; j < mine.length; j++) {
        var x = mine[i], y = mine[j];
        if (tgInpH_(x.from) < tgInpH_(y.to) && tgInpH_(y.from) < tgInpH_(x.to))
          clash.push(day + '، اتاق ' + tgFa_(tgInpRoomKey_(r.room)) + ': ' + x.who + ' (' + tgInpHs_(tgInpH_(x.from)) + ' تا ' + tgInpHs_(tgInpH_(x.to)) + ') و ' + y.who + ' (' + tgInpHs_(tgInpH_(y.from)) + ' تا ' + tgInpHs_(tgInpH_(y.to)) + ')');
      }
      var busy = tgInpMerge_(iv), used = 0, free = [], cur = a;
      busy.forEach(function (x) { used += x[1] - x[0]; if (x[0] > cur) free.push([cur, x[0]]); cur = Math.max(cur, x[1]); });
      if (cur < b) free.push([cur, b]);
      tot.cap += b - a; tot.used += used;
      TG_INP_PARTS.forEach(function (pt, k) {
        var pa = Math.max(a, pt[1]), pb = Math.min(b, pt[2]);
        if (pb <= pa) return;
        parts[k].cap += pb - pa;
        busy.forEach(function (x) { var u = Math.min(pb, x[1]) - Math.max(pa, x[0]); if (u > 0) parts[k].used += u; });
      });
      cells.push({ day: day, room: tgInpRoomKey_(r.room), kind: r.kind, cap: b - a, used: used, free: free });
    });
  });
  /* یک درمانگر، یک ساعت، دو اتاق */
  for (var i = 0; i < hrs.length; i++) for (var j = i + 1; j < hrs.length; j++) {
    var x = hrs[i], y = hrs[j];
    if (x.day !== y.day || tgInpNameKey_(x.who) !== tgInpNameKey_(y.who) || tgInpRoomKey_(x.room) === tgInpRoomKey_(y.room)) continue;
    if (tgInpH_(x.from) == null || tgInpH_(y.from) == null) continue;
    if (tgInpH_(x.from) < tgInpH_(y.to) && tgInpH_(y.from) < tgInpH_(x.to))
      clash.push(x.day + '، ' + x.who + ' هم در اتاق ' + tgFa_(tgInpRoomKey_(x.room)) + ' (' + tgInpHs_(tgInpH_(x.from)) + ' تا ' + tgInpHs_(tgInpH_(x.to)) + ') است و هم در اتاق ' + tgFa_(tgInpRoomKey_(y.room)) + ' (' + tgInpHs_(tgInpH_(y.from)) + ' تا ' + tgInpHs_(tgInpH_(y.to)) + ')');
  }
  return { cells: cells, clash: clash, tot: tot, parts: parts };
}
function tgInpPct_(u, c) { return c ? Math.round(u / c * 100) : 0; }

/* پیشنهاد پرکردن یک بازهٔ خالی: اول کسانی که همان روز در همین مکان‌اند و کنار این بازه تمام می‌شوند یا شروع می‌کنند، بعد کسانی که روزهای دیگر اینجا هستند */
function tgInpFillFor_(pid, day, fr, d, kind) {
  d = d || tgInpData_();
  var kidsRooms = (d.rooms || []).filter(function (r) { return r.p === pid && r.kind === 'کودک'; }).map(function (r) { return tgInpRoomKey_(r.room); });
  var kids = kind === 'کودک';
  var hrs = d.hours.filter(function (h) { return h.p === pid && h.day && tgInpH_(h.from) != null && (kidsRooms.indexOf(tgInpRoomKey_(h.room)) > -1) === kids; });
  var load = {}; hrs.forEach(function (h) { load[h.who] = (load[h.who] || 0) + (tgInpH_(h.to) - tgInpH_(h.from)); });
  var near = [], other = [];
  hrs.forEach(function (h) {
    if (h.day === day && (Math.abs(tgInpH_(h.to) - fr[0]) < 0.01 || Math.abs(tgInpH_(h.from) - fr[1]) < 0.01) && near.indexOf(h.who) < 0) near.push(h.who);
  });
  Object.keys(load).sort(function (a, b) { return load[b] - load[a]; }).forEach(function (w) {
    if (near.indexOf(w) > -1) return;
    var busySame = d.hours.some(function (z) { return z.p === pid && z.day === day && tgInpNameKey_(z.who) === tgInpNameKey_(w); });
    if (!busySame) other.push(w);
  });
  return near.slice(0, 2).concat(other).slice(0, 3).join('، ');
}

/* تب «ظرفیت حضوری»: فقط خواندنی؛ هر ساعت و بعد از هر تغییر بررسی دوباره ساخته می‌شود */
function tgInpCapRows_(d) {
  d = d || tgInpData_();
  var out = [['مکان', 'روز', 'اتاق', 'برای', 'ساعت ظرفیت', 'ساعت پر', 'اشغال', 'بازه‌های خالی', 'پیشنهاد پرکردن']];
  var head = [], clashes = [];
  var places = d.places.filter(function (p) { return (d.rooms || []).some(function (r) { return r.p === p.id; }); });
  places.forEach(function (p) {
    var c = tgInpCap_(p.id, d), label = p.city + (p.area ? ' · ' + p.area : '');
    head.push([label, 'کل هفته', '', '', tgFa_(Math.round(c.tot.cap)), tgFa_(Math.round(c.tot.used * 10) / 10).replace('.', '٫'), tgFa_(tgInpPct_(c.tot.used, c.tot.cap)) + '٪',
               TG_INP_PARTS.map(function (pt, k) { return pt[0] + ' ' + tgFa_(tgInpPct_(c.parts[k].used, c.parts[k].cap)) + '٪'; }).join('، '), '']);
    c.cells.forEach(function (x) {
      var fr = x.free.filter(function (f) { return f[1] - f[0] >= 1; });
      out.push([label, x.day, tgFa_(x.room), x.kind, tgFa_(x.cap), tgFa_(Math.round(x.used * 10) / 10).replace('.', '٫'), tgFa_(tgInpPct_(x.used, x.cap)) + '٪',
                fr.map(function (f) { return tgInpHs_(f[0]) + ' تا ' + tgInpHs_(f[1]); }).join('، ') || 'پر',
                fr.length ? tgInpFillFor_(p.id, x.day, fr.slice().sort(function (a, b) { return (b[1] - b[0]) - (a[1] - a[0]); })[0], d, x.kind) : '']);
    });
    c.clash.forEach(function (t) { clashes.push([label, '⚠️ تداخل', '', '', '', '', '', t, '']); });
  });
  return head.concat(clashes).concat(out.length > 1 ? [[]] : []).concat(out);
}
function tgInpCapRefresh_(force) {
  if (TG_DRY) return tgInpCapRows_();
  CacheService.getScriptCache().remove('inpdata');
  var rows = tgInpCapRows_(), sig = Utilities.base64Encode(Utilities.computeDigest(Utilities.DigestAlgorithm.MD5, JSON.stringify(rows)));
  var pr = PropertiesService.getScriptProperties();

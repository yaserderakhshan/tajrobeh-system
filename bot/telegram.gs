  sh.getRange(3, 1).setValue('این تب فقط فرمول است؛ چیزی ننویسید. نتیجهٔ تماس را در «' + TG_SCH_T_REQ + '» بنویسید تا اینجا خودش عوض شود.').setFontColor('#8a8d95');
  var head = ['اقدام بعدی', 'نام', 'شماره', 'کمپین', 'مرحلهٔ قیف', 'وضعیت', 'مسئول پیگیری', 'آخرین تماس', 'نتیجهٔ آخرین تماس', 'کد لید', 'یادداشت مدرسه'];
  sh.getRange(5, 1, 1, head.length).setValues([head]).setFontWeight('bold').setBackground('#f9f2f2');

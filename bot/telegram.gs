function tgCbFix_(markup) {
  var rows = markup && markup.inline_keyboard;
  if (!rows || !rows.length) return markup;
  for (var i = 0; i < rows.length; i++) for (var j = 0; j < (rows[i] || []).length; j++) {
    var b = rows[i][j];
    if (b && 'callback_data' in b && tgCbBytes_(b.callback_data) > 64) b.callback_data = tgCbShort_(b.callback_data);
  }

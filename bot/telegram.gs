  if ((data.indexOf('smn:') === 0 || data.indexOf('scl:') === 0) && typeof scOnCb_ === 'function') return scOnCb_(cq, data, chat, uname);   /* v166.25: منتورینگ، جلسهٔ بالینی */
  if (data.indexOf('mg:') === 0 && typeof tgMigCb_ === 'function') return tgMigCb_(cq, data.slice(3), chat, name, uname);   /* v166.28: تست مهاجرت */
  if ((data.indexOf('pb:') === 0 || data.indexOf('pbd:') === 0) && typeof pbOnCb_ === 'function') return pbOnCb_(chat, data);   /* v167: میز سردبیر و پیام هفتگی */
  if (data.indexOf('tc:') === 0) return tgTherCardShow_(chat, Number(data.slice(3)));
  if (data.indexOf('tq:') === 0) return tgOnTq_(cq, data.slice(3), chat, name, uname);   /* v166.21: درخواست اتصال حساب */
  if (data.indexOf('f:') === 0) return tgFaqAnswer_(chat, Number(data.slice(2)));
  if (data.indexOf('rm:') === 0 && typeof tgOnRm_ === 'function') return tgOnRm_(cq, data.slice(3), chat, name, uname);

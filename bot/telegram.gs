  try {
    var l = tgSvRows_();
    for (var i = 0; i < l.length; i++) {
      if (l[i].code !== String(code)) continue;
      var sh = tgSchSheet_(TG_SCH_T_SLOT, TG_SCH_SLOT_HEAD);
      sh.getRange(l[i].row, 9).setValue(1);
      sh.getRange(l[i].row, 10).setValue('بسته');
      tgSchDropCache_();
      return true;
    }
  } catch (e) { tgErr_('tgApIvTake_: ' + e); }
  return false;
}

var TG_AP_IV_HOURS = ['09:00', '10:00', '11:00', '12:00', '14:00', '15:00',
                      '16:00', '17:00', '18:00', '19:00', '20:00'];

function tgApIvSet_(r, code, label, byName) {
  tgApSet_(r, 15, code || '');
  tgApSet_(r, 16, label);
  tgApSet_(r, 12, TG_AP_STAGES[3]);
  if (r.chat) {
    try {
      tgSend_(r.chat, '🗓 زمان مصاحبهٔ شما با سوپروایزر تعیین شد:\n<b>' + tgEsc_(label) + '</b>\n\n' +
        'اگر این زمان برایتان جور نیست همین‌جا بنویسید تا جابه‌جا کنیم.');
    } catch (e) {}
  }
  try {
    var ids = tgApOwners_();
    for (var i = 0; i < ids.length; i++) {
      tgSend_(ids[i], '🗓 ' + tgEsc_(byName || r.sup || '') + ' وقت مصاحبهٔ ' + tgEsc_(r.name || '') +
                      ' را گذاشت: <b>' + tgEsc_(label) + '</b>');
    }
  } catch (e2) {}
}

/* ---------- مسیر دکمه‌های سوپروایزر مصاحبه ---------- */

function tgOnSi_(cq, rest) {
  var chat = cq.message.chat.id;
  var uname = cq.from && cq.from.username ? '@' + cq.from.username : '';
  var p = String(rest || '').split(':');
  var act = p[0] || '', id = p[1] || '', arg = p.slice(2).join(':');
  var r = tgApRow_(id);
  if (!r) return tgSend_(chat, 'این پرونده پیدا نشد.');
  var w = tgApWho_(chat, uname);
  var mine = tgApSvIs_(chat, uname, r.sup);
  if (!mine && !w.ok) return tgSend_(chat, 'این دکمه‌ها برای سوپروایزر این مصاحبه است.');
  var me = mine ? mine.name : w.me;

  if (act === 'f') return tgSend_(chat, tgApCard_(r));

  if (act === 't') {
    var free = tgApIvSlots_(r.sup);
    var rows = [];
    for (var i = 0; i < free.length && i < 8; i++) {
      rows.push([{ text: '🗓 ' + free[i].day + ' ساعت ' + free[i].time,
                   callback_data: 'si:s:' + id + ':' + free[i].code }]);
    }
    rows.push([{ text: '➕ وقت تازه اعلام می‌کنم', callback_data: 'si:a:' + id }]);
    rows.push([{ text: '✍️ زمان را خودم می‌نویسم', callback_data: 'si:w:' + id }]);
    return tgSend_(chat, free.length ? 'کدام وقت برای مصاحبه؟' :
      'هنوز وقت مصاحبه‌ای اعلام نکرده‌اید. یکی اضافه کنید یا زمان را دستی بنویسید.',
      { inline_keyboard: rows });
  }

  if (act === 's') {
    var s = null, all = tgApIvSlots_(r.sup);
    for (var j = 0; j < all.length; j++) if (all[j].code === arg) s = all[j];
    if (!s) return tgSend_(chat, 'این وقت دیگر باز نیست. یکی دیگر را انتخاب کنید.');
    tgApIvTake_(s.code);
    tgApIvSet_(r, s.code, s.day + ' ساعت ' + s.time, me);
    return tgSend_(chat, '✅ وقت مصاحبه ثبت شد: ' + tgEsc_(s.day) + ' ساعت ' + tgEsc_(s.time) +
                         '\nبه متقاضی و به ناظر خبر دادیم.');
  }

  if (act === 'a') {
    var rd = [];
    for (var k = 0; k < TG_SV_DAYS.length; k++) {
      rd.push([{ text: TG_SV_DAYS[k], callback_data: 'si:ad:' + id + ':' + k }]);
    }
    return tgSend_(chat, 'کدام روز برای مصاحبه وقت دارید؟', { inline_keyboard: rd });
  }

  if (act === 'ad') {
    var di = Number(arg) || 0, rh = [], line = [];
    for (var h = 0; h < TG_AP_IV_HOURS.length; h++) {
      line.push({ text: TG_AP_IV_HOURS[h], callback_data: 'si:ah:' + id + ':' + di + ':' + TG_AP_IV_HOURS[h] });
      if (line.length === 3) { rh.push(line); line = []; }
    }
    if (line.length) rh.push(line);
    return tgSend_(chat, TG_SV_DAYS[di] + ' — چه ساعتی؟', { inline_keyboard: rh });
  }

  if (act === 'ah') {
    var pp = String(arg).split(':');
    var day = TG_SV_DAYS[Number(pp[0]) || 0];
    var time = pp.slice(1).join(':');
    var code = tgApIvAdd_(r.sup, chat, day, time);
    tgApIvSet_(r, code, day + ' ساعت ' + time, me);
    tgApIvTake_(code);
    return tgSend_(chat, '✅ وقت مصاحبه ثبت شد: ' + tgEsc_(day) + ' ساعت ' + tgEsc_(time) +
                         '\nبه متقاضی و به ناظر خبر دادیم.');
  }

  if (act === 'w') {
    tgSetVal_('siw', chat, id);
    return tgSend_(chat, 'زمان مصاحبه را در یک پیام بنویسید. مثلاً: «سه‌شنبه ۲ مهر، ساعت ۱۷».');
  }

  if (act === 'r') {
    var rows3 = [];
    for (var q = 0; q < TG_AP_RESULTS.length; q++) {
      rows3.push([{ text: TG_AP_RESULTS[q], callback_data: 'si:rs:' + id + ':' + q }]);
    }
    return tgSend_(chat, 'نتیجهٔ مصاحبه چیست؟', { inline_keyboard: rows3 });
  }

  if (act === 'rs') {
    var label = TG_AP_RESULTS[Number(arg)];
    if (!label) return tgSend_(chat, 'این نتیجه پیدا نشد.');
    tgApSet_(r, 17, label);
    tgApSet_(r, 12, TG_AP_STAGES[4]);
    tgApSet_(r, 21, 'نتیجه را ' + me + ' ثبت کرد');
    tgApBackToWatch_(r, label, me);
    return tgSend_(chat, '📋 ممنون. نتیجه ثبت شد: <b>' + tgEsc_(label) + '</b>\n' +
                         'از این‌جا به بعد با ناظر است. اگر نکتهٔ دیگری هست همین‌جا بنویسید.');
  }
  return null;
}

function tgApBackToWatch_(r, label, by) {
  try {
    var r2 = tgApRow_(r.id) || r;
    var ids = tgApOwners_();
    var body = '📋 <b>نتیجهٔ مصاحبهٔ ' + tgEsc_(r.name || '') + '</b> · ' + tgEsc_(r.id) + '\n\n' +
      'سوپروایزر: ' + tgEsc_(by || r.sup || '') + '\n' +
      'نتیجه: <b>' + tgEsc_(label) + '</b>\n' +
      (r.approach ? 'رویکرد: ' + tgEsc_(r.approach) + '\n' : '') +
      (r.city ? 'شهر: ' + tgEsc_(r.city) + '\n' : '') +
      '\nاگر تأیید می‌کنید، دکمهٔ تأیید را بزنید تا نقش درمانگر، ردیف درمانگران، پروفایل سایت و آنبوردینگ خودکار انجام شود.';
    for (var i = 0; i < ids.length; i++) tgSend_(ids[i], body, tgApKb_(r2));
  } catch (e) { tgErr_('tgApBackToWatch_: ' + e); }
}

function tgApSvTimeText_(chat, m) {
  var id = tgGetVal_('siw', chat);
  if (!id) return false;
  var text = String((m && m.text) || '').trim();
  if (!text) return false;
  if (text.indexOf('/') === 0) { tgDel_('siw', chat); return false; }
  tgDel_('siw', chat);
  var r = tgApRow_(id);
  if (!r) { tgSend_(chat, 'این پرونده پیدا نشد.'); return true; }
  tgApIvSet_(r, '', text, '');
  tgSend_(chat, '✅ زمان مصاحبه ثبت شد: <b>' + tgEsc_(text) + '</b>\nبه متقاضی و ناظر خبر دادیم.');
  return true;
}

/* ---------- مسیر دکمه‌های اپلای (بازنویسی v106) ---------- */

function tgOnAp_(cq, rest) {
  var chat = cq.message.chat.id;
  var uname = cq.from && cq.from.username ? '@' + cq.from.username : '';
  var p = String(rest || '').split(':');
  var act = p[0] || '', id = p[1] || '', arg = p.slice(2).join(':');
  var w = tgApWho_(chat, uname);
  if (!w.watch && !w.lead) return tgSend_(chat, 'تصمیم دربارهٔ اپلای تراپیست با مسئول پذیرش و ناظر است.');
  var me = w.me;
  var r = tgApRow_(id);
  if (!r) return tgSend_(chat, 'این پرونده پیدا نشد.');

  if (act === 'cv') { tgApSendResume_(chat, r); return null; }
  if (act === 'card') return tgSend_(chat, tgApCard_(r), tgApKb_(r));
  if (act === 'nx') return tgSend_(chat, '📌 اقدام بعدی برای ' + tgEsc_(r.name || '') + ' کی باشد؟', tgApNextKb_(r.id));
  if (act === 'nxd') return tgApNextSet_(chat, r, arg, me);
  if (act === 'full') return tgSend_(chat, tgApFullText_(r));
  if (act === 'msg') {
    if (!r.chat) return tgSend_(chat, 'متقاضی این پرونده در بات نیست.');
    tgSetVal_('apmsg', chat, id);
    return tgSend_(chat, 'پیامتان به ' + tgEsc_(r.name || '') + ' را بنویسید. برای انصراف «انصراف» بفرستید.');
  }

  if (act === 'i1') {
    tgApSet_(r, 12, TG_AP_STAGES[1]);
    tgApSet_(r, 13, 'انجام شد · ' + me);
    tgApSet_(r, 20, me);
    return tgSend_(chat, '✅ تماس اول ثبت شد. حالا سوپروایزر مصاحبه را انتخاب کنید.');
  }

  if (act === 'sup') {
    var sups = tgApSupList_(r.approach);
    var rows = [];
    for (var i = 0; i < sups.length && i < 8; i++) {
      rows.push([{ text: (sups[i].exact ? '🎯 ' : '• ') + sups[i].name +
                         (sups[i].approach ? ' · ' + String(sups[i].approach).slice(0, 26) : ''),
                   callback_data: 'ap:sp:' + id + ':' + sups[i].name }]);
    }
    if (!rows.length) {
      return tgSend_(chat, 'سوپروایزری پیدا نشد. در تب «استادان و سوپروایزرها» هاب مدرسه، ستون ' +
                           '«سوپرویژن می‌پذیرد؟» را «بله» کنید و نقش را «سوپروایزر» بگذارید.');
    }
    return tgSend_(chat, 'رویکرد متقاضی: <b>' + tgEsc_(r.approach || 'نامشخص') + '</b>\n' +
                         '🎯 یعنی رویکردش می‌خورد.\n\nمصاحبه با کدام سوپروایزر؟',
                   { inline_keyboard: rows });
  }

  if (act === 'sp') {
    tgApSet_(r, 14, arg);
    tgApSet_(r, 12, TG_AP_STAGES[2]);
    r.sup = arg;
    return tgApHandoff_(chat, r, arg);
  }

  if (act === 'lnk') {
    if (!r.sup) return tgSend_(chat, 'اول سوپروایزر را انتخاب کنید.');
    return tgApHandoff_(chat, r, r.sup);
  }

  if (act === 'res') {
    var rows3 = [];
    for (var k = 0; k < TG_AP_RESULTS.length; k++) {
      rows3.push([{ text: TG_AP_RESULTS[k], callback_data: 'ap:rs:' + id + ':' + k }]);
    }
    return tgSend_(chat, 'نتیجهٔ مصاحبه چیست؟', { inline_keyboard: rows3 });
  }

  if (act === 'rs') {
    var label = TG_AP_RESULTS[Number(arg)];
    if (!label) return tgSend_(chat, 'این نتیجه پیدا نشد.');
    tgApSet_(r, 17, label);
    tgApSet_(r, 12, TG_AP_STAGES[4]);
    var r2 = tgApRow_(id) || r;
    return tgSend_(chat, '📋 نتیجه ثبت شد: ' + tgEsc_(label) + '\n' +
                         'حالا با دکمهٔ «تأیید و شروع آنبوردینگ» همه‌چیز خودکار انجام می‌شود.',
                   tgApKb_(r2));
  }

  if (act === 'ok') {
    if (!w.watch && !w.lead) return tgSend_(chat, 'تأیید شروع همکاری با مسئول پذیرش یا ناظر است.');
    if (!r.result) return tgSend_(chat, 'اول نتیجهٔ مصاحبه را ثبت کنید.');
    if (String(r.ok || '').indexOf('تأیید') === 0) return tgSend_(chat, 'این پرونده قبلاً تأیید شده است.');
    tgApSet_(r, 18, 'تأیید ' + me);
    tgApSet_(r, 19, tgJDateFull_(new Date(), TG_TZ));
    tgApSet_(r, 12, TG_AP_STAGES[5]);
    var log = tgApOnboard_(r);
    try {
      var deskAll = TG_DRY ? (TG_MEM['desk'] || []) : tgDeskRows_();
      for (var q = 0; q < deskAll.length; q++) {
        if (String(deskAll[q].role || '').indexOf('مسئول پذیرش') > -1 && deskAll[q].chat) {
          tgSend_(deskAll[q].chat, '✅ شروع همکاری ' + tgEsc_(r.name || '') + ' تأیید شد و آنبوردینگش شروع شد.');
        }
      }
    } catch (e2) {}
    return tgSend_(chat, '✅ شروع همکاری ثبت شد.\n\n' + log);
  }

  if (act === 'no') {
    tgApSet_(r, 12, TG_AP_STAGES[6]);
    return tgSend_(chat, '⛔ این پرونده بسته شد.');
  }
  return null;
}

/* ---------- تأیید → نقش، ردیف درمانگران، پروفایل سایت، آنبوردینگ ---------- */

function tgApPerson_(name, chat, approach) {
  if (TG_DRY) return TG_MEM['person'] || null;
  var n = tgNorm_(name);
  var list = tgPeopleRows_();
  for (var i = 0; i < list.length; i++) if (tgNorm_(list[i].name) === n) return list[i];
  tgPersonAdd_({ name: name, chat: chat, roles: 'درمانگر', note: 'از اپلای تراپیست', approach: approach || '' }, 'بات', { why: 'اپلای تراپیست' });
  try { CacheService.getScriptCache().remove('plist'); CacheService.getScriptCache().remove('wlist'); } catch (e) {}
  var l2 = tgPeopleRows_();
  for (var j = 0; j < l2.length; j++) if (tgNorm_(l2[j].name) === n) return l2[j];
  return null;
}

function tgApTherRow_(r) {
  if (TG_DRY) { TG_OUTBOX.push({ kind: 'thernew', name: r.name }); return true; }
  var sh = tgSS_().getSheetByName(TG_THER);
  if (!sh) return false;
  var lc = Math.max(sh.getLastColumn(), 1);
  var hd = sh.getRange(3, 1, 1, lc).getValues()[0].map(function (h) { return String(h).trim(); });
  var last = sh.getLastRow(), n = tgNorm_(r.name);
  if (last >= 4) {
    var col = sh.getRange(4, 1, last - 3, 1).getValues();
    for (var i = 0; i < col.length; i++) if (tgNorm_(String(col[i][0])) === n) return false;
  }
  var row = [];
  for (var z = 0; z < lc; z++) row.push('');
  var put = function (h, v) { var c = hd.indexOf(h); if (c > -1) row[c] = v; };
  put('نام درمانگر', r.name);
  put('وضعیت همکاری', 'فعال');
  put('مکتب اصلی', r.approach || '');
  put('رویکرد اعلام‌شده (خام)', r.approach || '');
  put('شهر', r.city || '');
  put('chat_id تلگرام (خودکار)', String(r.chat || ''));
  put('وضعیت اتصال', r.chat ? 'وصل شد' : 'در انتظار اتصال');
  put('یادداشت', 'از اپلای تراپیست ' + r.id);
  sh.appendRow(row);
  try { CacheService.getScriptCache().remove('trows'); } catch (e2) {}
  return true;
}

function tgApPqRow_(r) {
  var id = 'ther:' + tgNorm_(r.name);
  var base = {
    name: r.name || '', chat: String(r.chat || ''), roles: 'درمانگر',
    src: 'اپلای تراپیست ' + r.id, status: 'در انتظار تکمیل',
    city: r.city || '', approach: r.approach || '', site_photo: 'ندارد',
    since: r.years || ''
  };
  tgPqRec_(id, true, base);
  return id;
}

function tgApOnboard_(r) {
  var log = [];
  var name = String(r.name || '').trim();
  var chat = String(r.chat || '').trim();
  if (!name) return 'نام متقاضی خالی است، پس آنبوردینگ انجام نشد.';
  try {
    var p = tgApPerson_(name, chat, r.approach);
    if (p) { p.chatNew = chat; tgSchGrantRole_(p, 'درمانگر', ''); log.push('نقش «درمانگر» در تب افراد ثبت شد'); }
    else log.push('ردیف افراد ساخته نشد');
  } catch (e) { log.push('نقش ثبت نشد: ' + e); }
  try {
    log.push(tgApTherRow_(r) ? 'ردیف تب «درمانگران» ساخته شد' : 'ردیف «درمانگران» از قبل بود');
  } catch (e2) { log.push('ردیف درمانگران نشد: ' + e2); }
  try { tgApPqRow_(r); log.push('رکورد «پروفایل سایت» باز شد (بدون عکس، در انتظار تکمیل)'); }
  catch (e3) { log.push('پروفایل سایت نشد: ' + e3); }
  if (chat) {
    try { tgObStart_(chat, name, r); log.push('آنبوردینگ برایشان شروع شد'); }
    catch (e4) { log.push('آنبوردینگ شروع نشد: ' + e4); }
  } else {
    log.push('chat_id ندارد؛ آنبوردینگ به‌محض ورودشان به بات شروع می‌شود');
  }
  return '• ' + log.join('\n• ');
}

/* ---------- آنبوردینگ درمانگر ---------- */

var TG_OB_LAST = 6;

function tgObGet_(chat) {
  try { return JSON.parse(tgGetVal_('obw', chat) || 'null'); } catch (e) { return null; }
}

function tgObBar_(i) {
  var s = '';
  for (var k = 0; k <= TG_OB_LAST; k++) s += (k <= i ? '●' : '○');
  return s + '  ' + (i + 1) + ' از ' + (TG_OB_LAST + 1);
}

function tgObSheet_() {
  if (TG_DRY) return null;
  var ss = tgSS_(), sh = ss.getSheetByName(TG_OB_TAB);
  if (!sh) {
    sh = ss.insertSheet(TG_OB_TAB);
    try { sh.setRightToLeft(true); } catch (e) {}
    sh.getRange(1, 1, 1, TG_OB_HEAD.length).setValues([TG_OB_HEAD])
      .setFontWeight('bold').setBackground('#f3efec');
    sh.setFrozenRows(1);
    try { sh.hideSheet(); } catch (e2) {}
  }
  return sh;
}

function tgObLog_(name, chat, step, ap) {
  if (TG_DRY) { TG_OUTBOX.push({ kind: 'oblog', chat: String(chat), step: step }); return; }
  try {
    var sh = tgObSheet_(), last = sh.getLastRow(), row = 0;
    if (last >= 2) {
      var v = sh.getRange(2, 2, last - 1, 1).getValues();
      for (var i = 0; i < v.length; i++) if (String(v[i][0]).trim() === String(chat)) { row = i + 2; break; }
    }
    var now = tgJDateFull_(new Date(), TG_TZ);
    if (!row) {
      sh.appendRow([name || '', String(chat), now, step, now, step >= TG_OB_LAST ? 'بله' : '', ap || '', '']);
    } else {
      sh.getRange(row, 4).setValue(step);
      sh.getRange(row, 5).setValue(now);
      if (step >= TG_OB_LAST) sh.getRange(row, 6).setValue('بله');
    }
  } catch (e) { tgErr_('tgObLog_: ' + e); }
}

function tgObStart_(chat, name, r) {
  var d = { i: 0, name: name || '', ap: (r && r.id) || '', city: (r && r.city) || '',
            approach: (r && r.approach) || '' };
  if (!d.name) {
    try { var t = tgWhoTherapist_(chat); if (t) d.name = t.name; } catch (e) {}
  }
  tgSetVal_('obw', chat, JSON.stringify(d));
  tgObLog_(d.name, chat, 0, d.ap);
  return tgObSend_(chat, 0);
}

function tgObMagTopics_(approach) {
  var out = [];
  try {
    var all = tgMagTopics_().filter(function (t) { return t.status === TG_MAG_TOPIC_OPEN; });
    var a = String(tgNorm_(approach || '')).toLowerCase();
    var fam = '';
    try { fam = tgApproachFamily_(tgApproachNorm_(approach)) || ''; } catch (e) {}
    var hit = [], rest = [];
    for (var i = 0; i < all.length; i++) {
      var blob = String(tgNorm_((all[i].title || '') + ' ' + (all[i].cat || '') + ' ' + (all[i].angle || ''))).toLowerCase();
      var ok = false;
      if (a && a.length > 2 && blob.indexOf(a) > -1) ok = true;
      if (!ok && fam && blob.indexOf(String(tgNorm_(fam)).toLowerCase()) > -1) ok = true;
      (ok ? hit : rest).push(all[i]);
    }
    out = hit.concat(rest).slice(0, 4);
  } catch (e2) { out = []; }
  return out;
}

function tgObPlaces_(city) {
  var out = [];
  try {
    var ps = tgInpPlaces_();
    var c = String(tgNorm_(city || '')).trim();
    for (var i = 0; i < ps.length; i++) {
      if (c && String(tgNorm_(ps[i].city || '')).trim() === c) out.push(ps[i]);
    }
    if (!out.length) out = ps.slice(0, 5);
  } catch (e) { out = []; }
  return out;
}

function tgObNext_(i, label) {
  return { inline_keyboard: [[{ text: label || 'ادامه ▸', callback_data: 'ob:n:' + (i + 1) }]] };
}

function tgObSend_(chat, i) {
  var d = tgObGet_(chat) || { i: 0, name: '', city: '', approach: '' };
  d.i = i;
  tgSetVal_('obw', chat, JSON.stringify(d));
  tgObLog_(d.name, chat, i, d.ap);
  var bar = tgObBar_(i);

  if (i === 0) {
    return tgSend_(chat, bar + '\n\n🎉 <b>' + tgEsc_(d.name || 'همکار تازه') + ' عزیز، به تجربه خوش آمدی.</b>\n\n' +
      'مصاحبه‌ات را خواندیم و تأیید شد. از این لحظه یکی از ما هستی.\n\n' +
      'تجربه یک مرکز درمان ساده نیست؛ جایی است که درمان، آموزش و نوشتن کنار هم ایستاده‌اند. ' +
      'چند دقیقه وقت بگذار تا خانه‌ات را نشانت بدهم. کوتاه است، قول می‌دهم.',
      tgObNext_(i, 'بریم ▸'));
  }

  if (i === 1) {
    return tgSend_(chat, bar + '\n\n🏛 <b>اکوسیستم تجربه</b>\n\n' +
      '🩺 <b>کلینیک</b> — مراجع از سایت و بات می‌آید، ما مچش می‌کنیم، معارفه می‌گذاریم و بعد درمان شروع می‌شود.\n\n' +
      '🎓 <b>مدرسهٔ تجربه</b> — دوره‌ها، حلقه‌های تجربهٔ بالینی و سوپرویژن. هم می‌توانی شاگرد باشی هم روزی استاد.\n\n' +
      '📖 <b>مجلهٔ تجربه</b> — جایی که حرف‌های ما بیرون می‌رود. نوشتن اینجا اسم تو را می‌سازد.\n\n' +
      '🏢 <b>پارتنرها</b> — مکان‌های حضوری ما در شهرهای مختلف، برای مراجعی که آنلاین نمی‌خواهد.\n\n' +
      'هر چهار تا به هم وصل‌اند. تو الان در هر چهار تا جا داری.',
      tgObNext_(i));
  }

  if (i === 2) {
    return tgSend_(chat, bar + '\n\n🤖 <b>این بات برای تو چه می‌کند</b>\n\n' +
      'این فقط یک پیام‌رسان نیست. کار واقعی اینجا می‌افتد:\n\n' +
      '• <b>مچ‌میکینگ</b> — مراجع را بر اساس نیاز، سبک درمان و ترجیحش به تو می‌رساند، نه شانسی.\n' +
      '• <b>وقت</b> — وقت معارفه و وقت درمانت را خودت اینجا اعلام می‌کنی. مراجع مستقیم رزرو می‌کند.\n' +
      '• <b>پیگیری</b> — بعد از هر معارفه از تو می‌پرسیم چه شد، و همان جواب به مچ بعدی کمک می‌کند.\n' +
      '• <b>مالی</b> — صورت‌حساب و تسویه‌ات همین‌جاست.\n\n' +
      'هرچه پروفایلت کامل‌تر باشد، مچ‌میکینگ دقیق‌تر کار می‌کند. که می‌رسیم به گام بعد.',
      tgObNext_(i));
  }

  if (i === 3) {
    return tgSend_(chat, bar + '\n\n👤 <b>پروفایلت</b>\n\n' +
      'مراجع قبل از اینکه تو را ببیند، صفحه‌ات را می‌خواند. یک جملهٔ معرفی خوب و توضیح روش کارت، ' +
      'بیشتر از هر تبلیغی کار می‌کند.\n\n' +
      'پروفایلت الان باز شده ولی خالی است. بات قدم‌به‌قدم می‌پرسد، تو فقط جواب بده. ' +
      'می‌توانی وسط کار رها کنی و بعد ادامه بدهی.\n\n' +
      '📸 عکس هم می‌خواهیم، ولی عجله نیست. هر وقت عکس رسمی و باکیفیت داشتی بفرست؛ ' +
      'تا آن وقت صفحه‌ات بدون عکس منتشر می‌ماند و هیچ ایرادی ندارد.',
      { inline_keyboard: [
        [{ text: '👤 همین حالا پروفایلم را کامل کنم', callback_data: 'ob:p' }],
        [{ text: 'ادامه ▸', callback_data: 'ob:n:' + (i + 1) }]
      ] });
  }

  if (i === 4) {
    var tops = tgObMagTopics_(d.approach);
    var kb = [];
    for (var t = 0; t < tops.length; t++) {
      kb.push([{ text: '📝 ' + String(tops[t].title).slice(0, 55), callback_data: 'mz:t:' + tops[t].code }]);
    }
    kb.push([{ text: '📖 صفحهٔ مجله', callback_data: 'ob:m' }]);
    kb.push([{ text: 'ادامه ▸', callback_data: 'ob:n:' + (i + 1) }]);
    return tgSend_(chat, bar + '\n\n📖 <b>مجلهٔ تجربه</b>\n\n' +
      'یک چیز را از داده‌هایمان می‌دانیم: مراجع درمانگری را که نوشته‌ای از او خوانده، بیشتر انتخاب می‌کند. ' +
      'نوشتن در مجله هم هویت حرفه‌ایِ دیجیتالت را می‌سازد و هم اسمت را در گوگل بالا می‌آورد.\n\n' +
      (tops.length
        ? 'با توجه به رویکردت' + (d.approach ? ' (' + tgEsc_(d.approach) + ')' : '') +
          '، این موضوع‌ها از استخر محتوا به تو می‌خورد:'
        : 'هر وقت آماده بودی از صفحهٔ مجله موضوع بردار.') + '\n\n' +
      'اجباری نیست. فقط بدان که هست و در دسترس توست.',
      { inline_keyboard: kb });
  }

  if (i === 5) {
    var pl = tgObPlaces_(d.city);
    var body = bar + '\n\n🏢 <b>حضوری و پارتنرها</b>\n\n' +
      'بعضی مراجع‌ها حضوری می‌خواهند. ما در چند شهر مکان داریم و اتاق‌هایشان در بات رزرو می‌شود.\n\n';
    if (pl.length) {
      body += (d.city ? 'نزدیک‌ترین‌ها به ' + tgEsc_(d.city) + ':\n' : 'مکان‌های فعال ما:\n');
      for (var q = 0; q < pl.length && q < 5; q++) {
        body += '• ' + tgEsc_(pl[q].name || '') + ' · ' + tgEsc_(pl[q].city || '') + '\n';
      }
      body += '\n';
    }
    body += 'اگر شهرت با یکی از این‌ها یکی است و دوست داری حضوری هم ببینی، از منوی درمانگر دکمهٔ ' +
            '«' + TG_INP_BTN + '» را بزن و ساعت‌های خالی‌ات را اعلام کن. همین.';
    return tgSend_(chat, body, tgObNext_(i));
  }

  tgSend_(chat, bar + '\n\n✨ <b>تمام شد. خوش آمدی.</b>\n\n' +
    'از این‌جا به بعد منوی درمانگر پایین صفحه در اختیار توست. سه کار اول که پیشنهاد می‌کنم:\n\n' +
    '۱. پروفایلت را کامل کن.\n' +
    '۲. اولین وقت معارفه‌ات را اعلام کن.\n' +
    '۳. یک موضوع از مجله بردار، حتی اگر ماه بعد بنویسی.\n\n' +
    'هر جا گیر کردی، «✉️ پیام به پذیرش» را بزن. ما همین‌جاییم.\n\n' +
    '<i>هر وقت خواستی این راهنما را دوباره ببینی، /onboard را بفرست.</i>');
  tgDel_('obw', chat);
  tgObLog_(d.name, chat, TG_OB_LAST, d.ap);
  try { return tgSend_(chat, 'منوی درمانگر آماده است 👇', tgTherMenu_()); } catch (e) { return true; }
}

function tgOnOb_(cq, rest) {
  var chat = cq.message.chat.id;
  var p = String(rest || '').split(':');
  var act = p[0] || '';
  if (act === 'n') return tgObSend_(chat, Number(p[1]) || 0);
  if (act === 'p') { try { return tgPqEntry_(chat, 'W'); } catch (e) { return tgSend_(chat, 'پروفایل باز نشد.'); } }
  if (act === 'm') { try { return tgMagStart_(chat); } catch (e2) { return tgSend_(chat, 'مجله باز نشد.'); } }
  return null;
}


  if (a === 'o') return tgSend_(chat, tgCpDashText_(co), tgCpDashKb_(co));
  if (a === 's') return tgSend_(chat, 'وضعیت تازهٔ ' + co.code + '؟ الان: ' + co.state, { inline_keyboard: TG_CP_STATES.map(function (s, i) {
    return [{ text: (s === co.state ? '● ' : '') + s, callback_data: 'cp:ss:' + co.code + ':' + i }]; }) });
  if (a === 'ss') return tgCpSetState_(chat, co, TG_CP_STATES[Number(p[2])], name);
  if (a === 't') return tgCpTimeline_(chat, co);
  if (a === 'e') return tgCpEvCard_(chat, co.code, p[2]);
  if (a === 'ef') {
    tgSetVal_('cpv', chat, JSON.stringify({ code: co.code, id: p[2], f: p[3] }));
    return tgSend_(chat, TG_CP_FIELD_ASK[p[3]] || 'مقدار تازه را بنویسید.', { keyboard: [['↩️ بازگشت']], resize_keyboard: true });
  }
  if (a === 'ea') return tgSend_(chat, 'مخاطب ' + p[2] + '؟', { inline_keyboard: TG_CP_AUDS.map(function (x, i) {
    return [{ text: x, callback_data: 'cp:eas:' + co.code + ':' + p[2] + ':' + i }]; }) });
  if (a === 'eas' || a === 'ess') {
    var e1 = tgCpEvFind_(co.code, p[2]);
    if (!e1) return tgSend_(chat, 'این رویداد پیدا نشد.');
    var ch = a === 'eas' ? { 'مخاطب': TG_CP_AUDS[Number(p[3])] } : { 'وضعیت': TG_CP_EV_ST[Number(p[3])] };
    tgCpSet_(TG_CPT_TAB, e1.row, ch);
    tgCpPush_('خط زمانی');
    return tgCpEvCard_(chat, co.code, p[2]);
  }
  if (a === 'es') return tgSend_(chat, 'وضعیت ' + p[2] + '؟', { inline_keyboard: TG_CP_EV_ST.map(function (x, i) {
    return [{ text: x, callback_data: 'cp:ess:' + co.code + ':' + p[2] + ':' + i }]; }) });
  if (a === 'ex') {
    var e2 = tgCpEvFind_(co.code, p[2]);
    if (!e2) return tgSend_(chat, 'این رویداد پیدا نشد.');
    if (e2.done) return tgSend_(chat, 'این رویداد قبلاً اجرا شده: ' + e2.done);
    var n = tgCpRun_(co, e2, name);
    return tgSend_(chat, '📤 اجرا شد برای ' + tgFa_(n) + ' نفر.');
  }
  if (a === 'n') return tgSend_(chat, 'نوع رویداد تازه؟', { inline_keyboard: TG_CP_EV_TYPES.map(function (x, i) {
    return [{ text: x, callback_data: 'cp:nt:' + co.code + ':' + i }]; }) });
  if (a === 'nt') {
    tgSetVal_('cpv', chat, JSON.stringify({ code: co.code, mode: 'new', type: TG_CP_EV_TYPES[Number(p[2])], step: 'title' }));
    return tgSend_(chat, 'عنوان رویداد؟ کوتاه و روشن.', { keyboard: [['↩️ بازگشت']], resize_keyboard: true });
  }
  if (a === 'pp') return tgCpPending_(chat, co.code);
  if (a === 'lk') return tgCpLinks_(chat, co);
  return null;
}

/* ---------- حالت‌دارها و دکمه‌ها، پیش از هر مسیریابی در tgPrivate_ ---------- */

function tgCpMaybe_(chat, m, name, uname) {
  var text = tgCpS_(m.text);
  if ((m.photo || m.document) && tgGetVal_('cpp', chat)) return tgCpPaidIn_(chat, m);
  if (!text) return false;
  var cmd = text.split(/[\s@]/)[0];
  if (tgGetVal_('cpv', chat) && tgCpValText_(chat, text)) return true;
  if (tgGetVal_('cpp', chat) && tgCpPaidIn_(chat, m)) return true;
  if (tgGetVal_('cpn', chat) && tgCpNameText_(chat, text)) return true;
  if (tgGetVal_('cpl', chat)) {
    if (text === '↩️ بازگشت' || cmd.indexOf('/') === 0) { tgDel_('cpl', chat); return false; }
    var who = tgCpIvWho_(chat, uname);
    if (!/^https?:\/\//.test(text)) { tgSend_(chat, 'لینک باید با https شروع شود.'); return true; }
    tgDel_('cpl', chat);
    if (who) tgCpIvLink_(who.name, text);
    tgSend_(chat, '✅ لینک جلسه ثبت شد.', { remove_keyboard: true });
    return tgCpIvDesk_(chat, '', uname), true;
  }
  if (text === TG_CP_BTN || cmd === '/camps') { tgCpOwnerList_(chat); return true; }
  if (text === TG_CP_STU_BTN || cmd === '/courses') { tgCpList_(chat); return true; }
  if (text === TG_CP_IV_BTN || cmd === '/interviews' || text === '🎤 مصاحبه‌گر') { tgCpIvDesk_(chat, '', uname); return true; }
  return false;
}

/* ---------- برپاسازی: تریگر پنج‌دقیقه‌ای و ستون‌های هاب ---------- */

function tgCpSetup() {
  var log = [];
  var has = ScriptApp.getProjectTriggers().some(function (t) { return t.getHandlerFunction() === 'tgCpTick' || t.getHandlerFunction() === 'tgTick5'; });   /* v168.10 */
  if (!has) { ScriptApp.newTrigger('tgCpTick').timeBased().everyMinutes(5).create(); log.push('تریگر tgCpTick ساخته شد'); }
  else log.push('تریگر tgCpTick از قبل بود');
  try { log.push(tgSchHeadFix_(TG_SCH_T_REQ, TG_SCH_REQ_HEAD)); } catch (e) { log.push('هدر درخواست عضویت: ' + e); }
  Logger.log(log.join('\n'));
  return log.join('\n');
}


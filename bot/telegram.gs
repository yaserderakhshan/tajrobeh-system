function tgApi_(method, body) {
  if (body && body.reply_markup) {
    if (typeof body.reply_markup === 'string') {
      var rmk = null; try { rmk = JSON.parse(body.reply_markup); } catch (e) {}
      if (rmk && rmk.inline_keyboard) { var before = body.reply_markup; tgCbFix_(rmk); var after = JSON.stringify(rmk); if (after !== before) body.reply_markup = after; }
      tgBtnCheck_(method, rmk);
    } else { tgCbFix_(body.reply_markup); tgBtnCheck_(method, body.reply_markup); }
  }
  if (TG_API_CHAT) {
    if (method === 'answerCallbackQuery') { if (TG_DRY) TG_OUTBOX.push({ kind: 'api', method: method }); return null; }
    if (body && String(body.chat_id) === String(TG_API_CHAT)) {
      TG_API_OUT.push({ text: String(body.text || body.caption || ''), kb: body.reply_markup || null, edit: String(method).indexOf('edit') === 0 });
      if (TG_DRY) TG_OUTBOX.push({ kind: 'api', method: method });
      return null;
    }
  }
  if (TG_DRY) { TG_OUTBOX.push({ kind: 'api', method: method }); return null; }
  if (tgTestLeak_('تلگرام ' + method)) return null;
  const token = PropertiesService.getScriptProperties().getProperty('TELEGRAM_TOKEN');
  const url = 'https://api.telegram.org/bot' + token + '/' + method;
  var res = tgFetchRetry_(url, { method: 'post', contentType: 'application/json', payload: JSON.stringify(body), muteHttpExceptions: true });
  var code = res.getResponseCode(), txt = code === 200 ? '' : String(res.getContentText() || '');
  /* v166.23: HTML نادرست (E-1007) ← همان پیام بی قالب؛ فقط اگر آن هم نرفت خطا ثبت می‌شود */
  if (code === 400 && body && body.parse_mode && /can't parse entities/i.test(txt)) {
    var b2 = JSON.parse(JSON.stringify(body));
    delete b2.parse_mode;
    ['text', 'caption'].forEach(function (k) { if (typeof b2[k] === 'string') b2[k] = tgPlain_(b2[k]); });
    res = tgFetchRetry_(url, { method: 'post', contentType: 'application/json', payload: JSON.stringify(b2), muteHttpExceptions: true });
    code = res.getResponseCode(); txt = code === 200 ? '' : String(res.getContentText() || '');
  }
  /* پاسخ دیرِ دکمه هیچ اثری برای کاربر ندارد؛ خطا نیست */
  if (code === 400 && method === 'answerCallbackQuery' && /query is too old|query ID is invalid/i.test(txt)) return res;
  if (code !== 200) tgErr_('tgApi_ ' + method, txt, body && body.chat_id ? 'chat ' + body.chat_id : '');
  return res;
}

/* v166.23: خطای شبکهٔ UrlFetch (مثل Address unavailable) تا سه بار با فاصلهٔ کوتاه تکرار می‌شود؛ ۵xx هم یک بار دیگر */
/* v166.23 (E-1001): چند chat_id با ویرگول در یک خانه را شیت عدد می‌خواند (۵۹۶۳۵۵۵۵,۳۶۸… ← 5.96E+16)
   و هر دو شناسه از دست می‌رود. خانهٔ chat_id همیشه متن نوشته می‌شود. */
function tgChatCellSet_(rg, val) {
  try { rg.setNumberFormat('@'); } catch (e) {}
  rg.setValue(String(val == null ? '' : val));
}
/* شناسه‌های یک خانه: متن، جداشده با , ، ; یا فاصله؛ عدد بزرگ‌تر از دقت شیت (ادغام‌شده) کنار گذاشته می‌شود */
function tgChatIds_(v) {
  if (typeof v === 'number') return (Number.isSafeInteger(v) && Math.abs(v) < 1e15) ? [String(v)] : [];
  return String(v == null ? '' : v).split(/[,،;\s]+/).map(function (x) { return x.trim(); }).filter(function (x) { return /^-?\d{4,15}$/.test(x); });
}

function tgFetchRetry_(url, opts) {
  var last;
  for (var i = 0; i < 3; i++) {
    try {
      var r = UrlFetchApp.fetch(url, opts);
      if (r.getResponseCode() >= 500 && i < 2) { last = r; Utilities.sleep(400 * (i + 1)); continue; }
      return r;
    } catch (e) {
      last = e;
      if (i < 2) Utilities.sleep(500 * (i + 1));
    }
  }
  if (last && typeof last.getResponseCode === 'function') return last;
  throw last;
}


  if (data.indexOf('iy:') === 0) return tgInpDayPick_(chat, data.slice(3));
  if (data.indexOf('it:') === 0) return tgInpWho_(chat, data.slice(3));
  if (data.indexOf('ic:') === 0) return tgInpChkCb_(chat, data.slice(3));
  if (data.indexOf('iq:') === 0) return tgInpQCb_(chat, data.slice(3));
  if (data.indexOf('iv:') === 0) return tgInpVCb_(chat, data.slice(3));
  if (data.indexOf('py:') === 0) return tgPayCb_(chat, data.slice(3));
  if (data.indexOf('fu:') === 0) return tgOnFollow_(chat, data.slice(3));
  if (data.indexOf('ct:') === 0) return tgOnFeed_(chat, cq.message.message_id, data.slice(3), name, uname);
  if (data.indexOf('fd:') === 0) return tgOnFeed_(chat, cq.message.message_id, data.slice(3), name, uname);

  const who = tgWhoTherapist_(chat);
  if (who) {
    if (data.indexOf('p:') === 0) return tgAskWeekday_(chat, data.slice(2));
    if (data.indexOf('d:') === 0) return tgAskHour_(chat, data.slice(2));
    if (data.indexOf('h:') === 0) return tgAskCount_(chat, data.slice(2));
    if (data.indexOf('n:') === 0) return tgAddSlot_(chat, who, Number(data.slice(2)));
    if (data.indexOf('c:') === 0) return tgCancelSlot_(chat, who, Number(data.slice(2)));
    /* درمانگر هم می‌تواند مثل مراجع وقت معارفه بگیرد: دکمه‌های z: و b: و s: نباید بی‌صدا گم شوند */
  }

  if (data.indexOf('z:') === 0) return tgOnZone_(chat, data.slice(2));
  if (data.indexOf('b:') === 0) return tgOnBand_(chat, data.slice(2));
  if (data.indexOf('s:') === 0) return tgOnBook_(chat, name, Number(data.slice(2)));
  if (data === 'cancelmeet')    return tgCancelMeeting_(chat);
  if (data === 'ig:style' && typeof tgStyleStart_ === 'function') return tgStyleStart_(chat);   /* v168: «تست» اینستاگرام */
}

/* ---------- منطقه و بازه ---------- */

function tgAskZone_(chat) {
  const rows = TG_ZONES.map(function (z) { return [{ text: z.label, callback_data: 'z:' + z.key }]; });
  rows.push([{ text: '🇮🇷 داخل ایران هستم', callback_data: 'z:ir' }]);
  tgSend_(chat, T_ASK_ZONE, { inline_keyboard: rows });
}

function tgZoneOf_(key) {
  if (key === 'ir') return TG_ZONE_IR;
  for (var i = 0; i < TG_ZONES.length; i++) if (TG_ZONES[i].key === key) return TG_ZONES[i];
  return TG_ZONES[0];
}

function tgScopeOf_(chat) {
  return (tgGetVal_('tz', chat) === 'ir') ? 'داخل ایران' : 'خارج از ایران';
}

function tgOnZone_(chat, key) {
  tgSetVal_('tz', chat, key);
  tgSend_(chat, T_ASK_BAND, {
    inline_keyboard: TG_BANDS.map(function (b) { return [{ text: b.label, callback_data: 'b:' + b.key }]; })
  });
}

function tgBandOf_(key) {
  for (var i = 0; i < TG_BANDS.length; i++) if (TG_BANDS[i].key === key) return TG_BANDS[i];
  return TG_BANDS[3];
}

function tgOnBand_(chat, key) {
  tgSetVal_('bd', chat, key);
  const zk = tgGetVal_('tz', chat) || 'de';
  tgOfferSlots_(chat, tgZoneOf_(zk), tgBandOf_(key), tgScopeOf_(chat),
                zk === 'ir' ? T_SLOTS_HEAD_IR : T_SLOTS_HEAD);
}

/* ---------- پیشنهاد و رزرو وقت ---------- */

function tgOfferSlots_(chat, z, band, scope, intro) {
  const now = new Date();
  const free0 = tgFreeSlots_(scope);   /* v170.2: شمار برای هشدار درخواست متوقف */
  const stkNone = function (n) { try { if (typeof stkOnNoSlot_ === 'function') stkOnNoSlot_(chat, { scope: String(scope || ''), zone: (z && (z.label || z.key)) || '', band: (band && band.label) || '', total: free0.length, usable: n }); } catch (eS) {} };
  const usable = free0.filter(function (s) {
    const utc = tgSlotUtc_(s);
    if (utc.getTime() - now.getTime() < TG_MIN_LEAD_MS) return false;
    return tgSaneHour_(utc, z);
  });
  if (!usable.length) { stkNone(0); return tgAskAvail_(chat); }

  const info = tgTherapistInfo_();
  const want = tgGenderWant_(chat);

  // درمانگری که همکاری‌اش تمام شده هیچ‌وقت پیشنهاد نمی‌شود
  const active = usable.filter(function (x) {
    const t = info[x.therapist];
    return !(t && t.status && t.status.indexOf('پایان') > -1);
  });

  const fits = function (x) {
    const t = info[x.therapist];
    if (!want || !t || !t.gender) return true;
    if (want === 'زن')  return t.gender.indexOf('زن') > -1 || t.gender.indexOf('خانم') > -1;
    if (want === 'مرد') return t.gender.indexOf('مرد') > -1 || t.gender.indexOf('آقا') > -1;
    return true;
  };

  let pool = active.filter(fits);
  let softened = false;
  if (!pool.length) { pool = active; softened = !!want; }
  // از صفحهٔ شخصی درمانگر آمده (start=tm-…): اگر خودش وقت آزاد دارد، فقط وقت‌های خودش
  const wantT = tgGetVal_('wantther', chat);
  let wantMiss = false;
  if (wantT) {
    const mine = active.filter(function (x) { return tgNorm_(x.therapist) === tgNorm_(wantT); });
    if (mine.length) { pool = mine; softened = false; } else wantMiss = true;
  }

  // اول ردهٔ ارجاع (نرخ واقعی معارفه)، بعد نزدیک‌ترین وقت
  pool.sort(function (a, b) {
    const ta = (info[a.therapist] || {}).tier || 2.5;
    const tb = (info[b.therapist] || {}).tier || 2.5;
    if (ta !== tb) return ta - tb;
    return (a.dateIso + a.hhmm) < (b.dateIso + b.hhmm) ? -1 : 1;
  });

  let list = tgPick_(pool, z, band, chat);
  let head = intro || T_SLOTS_HEAD;
  /* v87: بازهٔ بازتر هم باید همان فیلتر نوع تراپی را داشته باشد، پس chat حتماً پاس داده می‌شود */
  if (!list.length) { list = tgPick_(pool, z, tgBandOf_('x'), chat); head = T_SLOTS_WIDER; }
  if (!list.length) {
    const hardName = TG_POOL_HARD[TG_TOPIC_POOL[String(tgGetVal_('qt', chat) || '')] || ''] || '';
    stkNone(pool.length);
    if (hardName) {
      tgSetFlag_('await', chat, 21600);
      return tgSend_(chat,
        'الان وقت آزادی برای ' + hardName + ' نداریم.\n\n' +
        'همکاران پذیرش خودشان برایتان هماهنگ می‌کنند. اگر بنویسید کدام روزها و ساعت‌ها راحت‌ترید، همان را به آن‌ها می‌دهیم.',
        { remove_keyboard: true });
    }
    return tgAskAvail_(chat);
  }
  if (softened) head += '\n\n(با ترجیح جنسیتی شما در این بازه وقتی آزاد نبود، این‌ها نزدیک‌ترین گزینه‌هاست.)';
  if (wantMiss) head = 'الان وقت آزاد معارفه با ' + tgEsc_(wantT) + ' نداریم. این‌ها نزدیک‌ترین وقت‌های همکاران تجربه است؛ اگر فقط با ایشان می‌خواهید، به پذیرش بگویید تا هماهنگ کند.\n\n' + head;

  let body = head + '\n';
  const btns = [];
  for (var i = 0; i < list.length; i++) {
    const s = list[i];
    const about = tgAbout_(info[s.therapist]);
    body += '\n<b>' + tgEsc_(s.therapist) + '</b>\n🗓 ' + tgEsc_(tgSlotLabel_(s, z)) +
            (about ? '\n' + tgEsc_(about) : '') + '\n';
    btns.push([{ text: s.therapist + ' · ' + tgSlotShort_(s, z), callback_data: 's:' + i },
               { text: 'ℹ️ دربارهٔ او', callback_data: 'tc:' + i }]);
  }
  tgSetVal_('off', chat, JSON.stringify(list));
  try { tgOfferBump_(list.map(function (x) { return x.therapist; })); } catch (e) {}
  tgSend_(chat, body + T_SLOTS_TAIL, { inline_keyboard: btns });
}

function tgPick_(slots, z, band, chat) {
  slots = tgPoolFilter_(slots, chat);
  slots = tgCapFilter_(slots);
  const seen = {}, out = [];
  for (var i = 0; i < slots.length; i++) {
    const s = slots[i];
    const h = Number(Utilities.formatDate(tgSlotUtc_(s), z.tz, 'H'));
    if (h < band.from || h >= band.to) continue;
    if (seen[s.therapist]) continue;
    if (Object.keys(seen).length >= TG_POOL_MAX) break;
    seen[s.therapist] = true;
    out.push(s);
    if (out.length >= TG_MAXSLOT) break;
  }
  return out;
}

function tgAskAvail_(chat) {
  tgSetFlag_('await', chat, 21600);
  tgSend_(chat, T_SLOT_NONE, { remove_keyboard: true });
}

// دکمهٔ باز کردن مینی‌اپ، هر جا که فهرست وقت‌ها به درد می‌خورد
function tgAppBtn_(label) {
  return { inline_keyboard: [[{ text: label || '🍓 باز کردن اپ تجربه', web_app: { url: TG_APP_URL } }]] };
}

function tgSaneHour_(utc, z) {
  const h = Number(Utilities.formatDate(utc, z.tz, 'H'));
  return h >= TG_LOCAL_MIN && h <= TG_LOCAL_MAX;
}

/* v166.16: وقتی که از فهرست کش‌شده (تا ۶ ساعت، یا ۱۰ دقیقه در مینی‌اپ) انتخاب شده، زیر قفل دوباره با شیت سنجیده می‌شود:
   هنوز در قاعدهٔ هفتگی یا سطر آزاد هست، درمانگر در مرخصی یا «پایان» نیست، و از حداقل فاصلهٔ رزرو (پذیرش: از اکنون) نگذشته.
   پیش از این فقط «گرفته نشده» سنجیده می‌شد و وقت گذشته، وقت مرخصی یا درخواست ساختگی مینی‌اپ هم رزرو می‌شد. */
function tgSlotBookable_(s, desk) {
  if (TG_DRY) return true;
  try {
    var now = Date.now(), utc = tgSlotUtc_(s);
    if (utc.getTime() - now < (desk ? 0 : TG_MIN_LEAD_MS)) return false;
    var th = tgTherapistInfo_()[s.therapist];
    if (th && th.status && th.status.indexOf('پایان') > -1) return false;
    var hit = tgFreeSlots_('').some(function (x) { return x.therapist === s.therapist && x.dateIso === s.dateIso && x.hhmm === s.hhmm; });
    return hit;
  } catch (e) { tgErr_('tgSlotBookable_', e); return true; }   /* خطای خواندن نباید رزرو درست را ببندد */
}

function tgOnBook_(chat, name, idx) {
  const raw = tgGetVal_('off', chat);
  if (!raw) return tgSend_(chat, T_SLOT_OLD);
  let list; try { list = JSON.parse(raw); } catch (e) { return; }
  const s = list[idx];
  if (!s) return tgSend_(chat, T_SLOT_OLD);
  const z = tgZoneOf_(tgGetVal_('tz', chat) || 'de');

  const lock = tgLock_();
  if (lock && !lock.tryLock(10000)) return tgSend_(chat, T_SLOT_BUSY);
  try { if (lock) TG_LOCK_HELD = true;   /* v166.13: tgLeadCode_ و tgAppendLead_ قفل را رها نکنند */
    if ((TG_DRY && tgTakenSet_()[s.therapist + '|' + s.dateIso + '|' + s.hhmm]) || !tgSlotBookable_(s)) {
      tgSend_(chat, T_SLOT_TAKEN);
      return tgOfferSlots_(chat, z, tgBandOf_(tgGetVal_('bd', chat) || 'x'), tgScopeOf_(chat));
    }

    const leadRow0 = tgWriteBooking_(chat, s, name);
    const lead  = tgLeadInfo_(chat);
    const stamp = Utilities.formatDate(new Date(), TG_TZ, 'yyyy-MM-dd HH:mm');
    const note  = (s.weekly ? 'از وقت هفتگی · ' : '') + 'خودرزرو از بات ' + stamp;
    const info  = (tgTherapistInfo_()[s.therapist] || {});
    const bookedRow = tgWriteSlot_(s, chat, lead.name, note, leadRow0);
    tgSetVal_('meet', chat, JSON.stringify({ t: s.therapist, d: s.dateIso, h: s.hhmm, row: bookedRow, ev: '' }));

    const notified = tgNotifyTherapist_(s, lead.name, lead.phone, z.label || '');
    if (!notified) {
      tgFlagSlotRow_(bookedRow, 'درمانگر به بات وصل نیست، پذیرش لینک و هماهنگی را انجام بدهد');
      /* v166.27 (گزارش ۲.۷): پذیرش هم خبر می‌گیرد، نه فقط یادداشت روی سطر */
      try { tgDeskSay_('🗓 ' + tgEsc_(s.therapist) + ' به بات وصل نیست. معارفهٔ ' + tgEsc_(s.dateIso) + ' ساعت ' + tgEsc_(s.hhmm) + ' را پذیرش با درمانگر هماهنگ کند.'); } catch (eD) {}
    }

    const utc = tgSlotUtc_(s);
    let msg =
      'رزرو شد ✅\n\n' +
      '👤 درمانگر شما: <b>' + tgEsc_(s.therapist) + '</b>\n' +
      (tgAbout_(info) ? tgEsc_(tgAbout_(info)) + '\n' : '') +
      '\n🗓 ' + tgDay_(Utilities.formatDate(utc, z.tz, 'EEE')) + ' ' +
      tgDateFor_(utc, z, true) + '\n' +
      '🕐 ساعت ' + tgFa_(Utilities.formatDate(utc, z.tz, 'HH:mm')) + ' به وقت شما' +
      (z.key === 'ir' ? '' : ' (' + tgFa_(Utilities.formatDate(utc, TG_TZ, 'HH:mm')) + ' به وقت تهران)') + '\n' +
      '⏱ حدود ' + TG_MEET_MIN + ' دقیقه، آنلاین\n\n';

    if (info.meet) {
      msg += '🔗 لینک جلسه:\n' + tgEsc_(info.meet) + '\n\nهمین لینک را سر وقت باز کنید. چند دقیقه زودتر وارد شوید.\n';
    } else {
      msg += 'لینک جلسه را پیش از موعد همکاران پذیرش برایتان می‌فرستند.\n';
    }
    msg += '\nاین جلسه هیچ تعهدی برای شما ایجاد نمی‌کند. اگر نتوانستید بیایید، همین‌جا لغو کنید تا وقت آزاد شود.';

    var haveEmail = tgGetVal_('em', chat);
    var kb0 = [];
    if (!haveEmail) kb0.push([{ text: '📧 ایمیلم را می‌دهم', callback_data: 'em:ask' }]);
    kb0.push([{ text: '❌ لغو این وقت', callback_data: 'cancelmeet' }]);
    kb0.push([{ text: '🔐 ثبت‌نام در پلتفرم تجربه', url: TG_LINK_SIGNUP }]);
    tgSend_(chat, msg, { inline_keyboard: kb0 });
    tgDel_('off', chat);

    /* v84: رویداد تقویم بعد از پیام تأیید ساخته می‌شود تا سرعت پاسخ نیفتد */
    try {
      var calEv = tgCalMake_({
        title: TG_CAL_MEET_T + ' · ' + s.therapist,
        start: utc,
        end: new Date(utc.getTime() + TG_MEET_MIN * 60000),
        guests: [info.email || '', haveEmail || ''],
        location: info.meet || '',
        desc: ['مراجع: ' + (lead.name || 'نامشخص'), 'درمانگر: ' + s.therapist,
               info.meet ? 'لینک جلسه: ' + info.meet : '',
               'این رویداد را بات تجربه ساخته است.'].filter(String).join('\n')
      });
      if (calEv && calEv.id) {
        tgSetVal_('meet', chat, JSON.stringify({ t: s.therapist, d: s.dateIso, h: s.hhmm, row: bookedRow, ev: calEv.id }));
        tgSlotSet_(bookedRow, 'رویداد تقویم', calEv.id);
      }
    } catch (eCal) { tgErr_('meetCal: ' + eCal); }
  } catch (err) {
    tgErr_('tgOnBook_: ' + err);
    try { if (typeof stkOnBookErr_ === 'function') stkOnBookErr_(chat, err, s); } catch (eS) {}   /* v170.2: هشدار درخواست متوقف */
    tgSend_(chat, 'در ثبت این وقت مشکلی پیش آمد. پذیرش پیگیری می‌کند.', tgMenu_());
  } finally { TG_LOCK_HELD = false;
    if (lock) lock.releaseLock();
  }
}

/* v166.15: وقت معارفهٔ مراجع. پیش از این فقط در کش ۶ ساعته بود و بیشتر وقت‌ها (تا ۳ هفته جلوتر) بعد از ۶ ساعت
   «وقتی ندارید» جواب می‌گرفت. حالا کش فقط میان‌بر است: سطرش در «اسلات معارفه» باید هنوز «رزرو شده» و با tg:همین‌چت باشد؛
   وگرنه نزدیک‌ترین وقت آینده از خود شیت خوانده می‌شود. */
function tgMeetGet_(chat) {
  var raw = tgGetVal_('meet', chat), mt = null;
  try { mt = raw ? JSON.parse(raw) : null; } catch (e) { mt = null; }
  if (TG_DRY) return mt;
  var c = String(chat);
  try {
    var sh = tgSS_().getSheetByName(TG_SLOTS);
    if (!sh || sh.getLastRow() < 4) return null;
    if (mt && mt.row >= 4 && mt.row <= sh.getLastRow()) {
      var one = sh.getRange(mt.row, 1, 1, 8).getValues()[0];
      if (String(one[5] || '').trim() === 'رزرو شده' && tgMtTgId_(one[7]) === c) return mt;
    }
    var map = tgMtHeadMap_(), cEv = map['رویداد تقویم'];
    var v = sh.getRange(4, 1, sh.getLastRow() - 3, sh.getLastColumn()).getValues();
    var nowIso = Utilities.formatDate(new Date(), TG_TZ, 'yyyy-MM-dd HH:mm'), best = null;
    for (var i = 0; i < v.length; i++) {
      if (String(v[i][5] || '').trim() !== 'رزرو شده') continue;
      if (tgMtTgId_(v[i][7]) !== c) continue;
      if (!(v[i][1] instanceof Date)) continue;
      var d = Utilities.formatDate(v[i][1], TG_TZ, 'yyyy-MM-dd'), h = tgHHMM_(v[i][3]);
      if (!h || d + ' ' + h < nowIso) continue;
      if (!best || d + ' ' + h < best.d + ' ' + best.h) best = { t: String(v[i][0] || '').trim(), d: d, h: h, row: i + 4, ev: cEv === undefined ? '' : String(v[i][cEv] || '').trim() };
    }
    if (best) tgSetVal_('meet', chat, JSON.stringify(best)); else if (raw) tgDel_('meet', chat);
    return best;
  } catch (e) { tgErr_('tgMeetGet_', e, 'chat:' + chat); return mt; }
}

function tgMyMeeting_(chat) {
  const mt = tgMeetGet_(chat);
  if (!mt) return tgSend_(chat, T_NO_MEET, tgMenu_());
  const info = tgTherapistInfo_()[mt.t] || {};
  const msg = 'وقت معارفهٔ شما:\n\n👤 ' + tgEsc_(mt.t) + '\n🗓 ' + mt.d + '\n🕐 ' + mt.h + ' به وقت تهران\n' +
              (info.meet ? '🔗 ' + tgEsc_(info.meet) : 'لینک جلسه را پذیرش می‌فرستد.');
  tgSend_(chat, msg, { inline_keyboard: [
    [{ text: '🩺 رزرو جلسهٔ درمان', callback_data: 'ss:go' }],
    [{ text: '❌ لغو این وقت', callback_data: 'cancelmeet' }]
  ] });
}

function tgCancelMeeting_(chat) {
  const mt = tgMeetGet_(chat);   /* v166.15: از شیت، و فقط سطری که هنوز مال همین مراجع است آزاد می‌شود */
  if (!mt) return tgSend_(chat, T_NO_MEET, tgMenu_());
  tgFreeSlotRow_(mt.row);
  try { if (mt.ev) tgCalDrop_(mt.ev); } catch (e) {}
  tgClearBooking_(chat);
  tgDel_('meet', chat);
  tgNotifyTherapistCancel_(mt);
  tgSend_(chat, T_CANCELLED, tgMenu_());
}

function tgSaveAvail_(chat, text) {
  tgDelFlag_('await', chat);
  tgSend_(chat, T_AVAIL_SAVED, tgMenu_());
  if (TG_DRY) return;
  const row = tgFindLead_(chat);
  if (row < 0) return;
  tgLeadNote_(row, 'زمان‌های مناسب کاربر: ' + text.slice(0, 300), 'مراجع');
  const la = tgLeadRead_(row);
  if (la && (!la.status || la.status === TG_ST.NEW)) tgLeadSet_(row, { 'وضعیت': TG_ST.FOLLOW, 'اقدام بعدی': 'تماس در زمان مناسب مراجع', 'تاریخ اقدام بعدی': Utilities.formatDate(new Date(), TG_TZ, 'yyyy-MM-dd') }, 'مراجع', 'بات', 'زمان مناسب');
  try { if (typeof lmOnSuggest_ === 'function') lmOnSuggest_(chat, text, 'آنلاین'); } catch (eLm) {}   /* v170.2: ستون «پیشنهاد کاربر» و کارت برای مسئول پذیرش */
}

/* ---------- اسلات‌ها ---------- */

/* ستون «نوع» در تب وقت‌های هفتگی؛ اگر نبود ساخته می‌شود */
function tgWeeklyKindCol_(sh) {
  const lc = Math.max(sh.getLastColumn(), 7);
  const hd = sh.getRange(3, 1, 1, lc).getValues()[0];
  for (var i = 0; i < lc; i++) if (String(hd[i]).trim() === 'نوع') return i + 1;
  sh.getRange(3, lc + 1).setValue('نوع').setFontWeight('bold');
  return lc + 1;
}

/* طول جلسهٔ درمان همان چیزی است که خود درمانگر اعلام کرده */
function tgTherSlen_(name) {
  try {
    const rows = tgTherapistRows_(), key = tgNorm_(name);
    for (var i = 0; i < rows.length; i++) {
      if (tgNorm_(rows[i].name) !== key) continue;
      const n = Number(String(tgLatinDigits_(rows[i].slen || '')).replace(/[^0-9]/g, ''));
      if (n >= 30 && n <= 90) return n;
    }
  } catch (e) {}
  return TG_SESS_MIN_DEF;
}

function tgWeeklyRules_(scope, kind) {
  const want = kind || TG_KIND_MEET;
  if (TG_DRY && TG_MEM['weekrules']) {
    return TG_MEM['weekrules'].filter(function (r) {
      if ((r.kind || TG_KIND_MEET) !== want) return false;
      if (scope && r.pool !== scope && r.pool !== 'هر دو') return false;
      return true;
    });
  }
  const out = [], seen = {};
  /* v166.26: تب «وقت‌های هفتگی» در هر اجرا یک بار (سرستون و داده با هم)؛ نوشتن روی این تب tgWeeklyBust_ را صدا می‌زند */
  if (!TG_WK_X) {
    const sh0 = tgSS_().getSheetByName(TG_WEEKLY);
    if (!sh0 || sh0.getLastRow() < 4) return out;
    const lc0 = Math.max(sh0.getLastColumn(), 7);
    TG_WK_X = sh0.getRange(3, 1, sh0.getLastRow() - 2, lc0).getValues();
  }
  const lc = TG_WK_X[0].length;
  const hd = TG_WK_X[0].map(function (h) { return String(h).trim(); });
  const cK = hd.indexOf('نوع');
  const cRc = hd.indexOf('تکرار'), cFr = hd.indexOf('از تاریخ');   /* v162 */
  const v = TG_WK_X.slice(1);
  for (var i = 0; i < v.length; i++) {
    const name = String(v[i][0]).trim();
    if (!name) continue;
    if (String(v[i][4]).trim() !== 'بله') continue;
    const knd = (cK > -1 ? String(v[i][cK]).trim() : '') || TG_KIND_MEET;
    if (knd !== want) continue;
    const pool = String(v[i][3]).trim();
    if (scope && pool !== scope && pool !== 'هر دو') continue;
    const hhmm = tgHHMM_(v[i][2]);
    if (!hhmm) continue;
    let iso = 0;
    for (var k = 0; k < TG_DAYS.length; k++) if (TG_DAYS[k].fa === String(v[i][1]).trim()) iso = TG_DAYS[k].iso;
    if (!iso) continue;
    const key = name + '|' + iso + '|' + hhmm;
    if (seen[key]) continue;
    seen[key] = true;
    out.push({ name: name, iso: iso, hhmm: hhmm, pool: pool, row: i + 4, kind: knd,
               recur: cRc > -1 ? String(v[i][cRc] || '').trim() : '', from: cFr > -1 ? tgIsoOf_(v[i][cFr]) : '' });
  }
  return out;
}

var TG_WK_X = null;
function tgWeeklyBust_() { TG_WK_X = null; }

function tgHHMM_(cell) {
  if (cell instanceof Date) return Utilities.formatDate(cell, TG_TZ, 'HH:mm');
  const s = tgLatinDigits_(cell).trim();
  const m = s.match(/^(\d{1,2}):(\d{2})/);
  if (!m) return '';
  return ('0' + m[1]).slice(-2) + ':' + m[2];
}

/* v166.26: تب «اسلات معارفه» در هر پیشنهاد وقت یک بار خوانده می‌شود، نه دو بار */
function tgSlotsRead_() {
  const sh = tgSS_().getSheetByName(TG_SLOTS);
  if (!sh || sh.getLastRow() < 4) return [];
  return sh.getRange(4, 1, sh.getLastRow() - 3, 7).getValues();
}
function tgTakenSet_(vals) {
  const set = {};
  const v = vals || tgSlotsRead_();
  if (!v.length) return set;
  for (var i = 0; i < v.length; i++) {
    if (!String(v[i][0]).trim()) continue;
    if (String(v[i][5]).trim() === 'آزاد') continue;
    if (!(v[i][1] instanceof Date)) continue;
    set[String(v[i][0]).trim() + '|' + Utilities.formatDate(v[i][1], TG_TZ, 'yyyy-MM-dd') + '|' + tgHHMM_(v[i][3])] = true;
  }
  return set;
}

function tgFreeSlots_(scope) {
  const rules = tgWeeklyRules_(scope);
  const sv = tgSlotsRead_();
  const taken = tgTakenSet_(sv);
  const offHas = tgOffChecker_();
  const out = [];
  const now = new Date();
  for (var d = 0; d < TG_WEEKS_AHEAD * 7; d++) {
    const day = new Date(now.getTime() + d * 86400000);
    const iso = Utilities.formatDate(day, TG_TZ, 'yyyy-MM-dd');
    const wd  = Number(Utilities.formatDate(day, TG_TZ, 'u'));
    for (var r = 0; r < rules.length; r++) {
      if (rules[r].iso !== wd) continue;
      if (!tgRecurOk_(rules[r].recur, rules[r].from, iso)) continue;
      if (taken[rules[r].name + '|' + iso + '|' + rules[r].hhmm]) continue;
      if (offHas(rules[r].name, iso)) continue;
      out.push({ therapist: rules[r].name, dateIso: iso, hhmm: rules[r].hhmm, weekly: true });
    }
  }
  if (sv.length) {
    const v = sv;
    for (var i = 0; i < v.length; i++) {
      if (!String(v[i][0]).trim()) continue;
      if (String(v[i][5]).trim() !== 'آزاد') continue;
      const pool = String(v[i][6]).trim();
      if (scope && pool !== scope && pool !== 'هر دو') continue;
      if (!(v[i][1] instanceof Date)) continue;
      const hhmm = tgHHMM_(v[i][3]);
      if (!hhmm) continue;
      out.push({ therapist: String(v[i][0]).trim(),
                 dateIso: Utilities.formatDate(v[i][1], TG_TZ, 'yyyy-MM-dd'),
                 hhmm: hhmm, weekly: false, row: i + 4 });
    }
  }
  out.sort(function (a, b) { return (a.dateIso + a.hhmm) < (b.dateIso + b.hhmm) ? -1 : 1; });
  return out;
}

function tgSlotUtc_(s) {
  const parts = s.hhmm.split(':');
  return new Date(s.dateIso + 'T' + ('0' + parts[0]).slice(-2) + ':' + parts[1] + ':00+03:30');
}

function tgSlotLabel_(s, z) {
  const utc = tgSlotUtc_(s);
  return tgDay_(Utilities.formatDate(utc, z.tz, 'EEE')) + ' ' + tgDateFor_(utc, z) + '، ساعت ' +
         tgFa_(Utilities.formatDate(utc, z.tz, 'HH:mm')) + ' به وقت شما';
}

function tgSlotShort_(s, z) {
  const utc = tgSlotUtc_(s);
  return tgDay_(Utilities.formatDate(utc, z.tz, 'EEE')) + ' ' + Utilities.formatDate(utc, z.tz, 'HH:mm');
}

function tgDay_(e) {
  const m = { Sat: 'شنبه', Sun: 'یکشنبه', Mon: 'دوشنبه', Tue: 'سه‌شنبه',
              Wed: 'چهارشنبه', Thu: 'پنج‌شنبه', Fri: 'جمعه' };
  return m[e] || e;
}

function tgWriteSlot_(s, chat, clientName, note, leadRow) {
  if (TG_DRY) { TG_OUTBOX.push({ kind: 'slot', s: s, note: note }); return 0; }
  const sh = tgSS_().getSheetByName(TG_SLOTS);
  const stamp = Utilities.formatDate(new Date(), TG_TZ, 'yyyy-MM-dd');
  var code = '';
  try {
    var lr = Number(leadRow || 0);
    if (!(lr >= 2)) lr = tgFindLead_(chat);
    if (lr >= 2) code = String(tgLeadCode_(lr) || '');
  } catch (e) {}
  const tag = clientName + (code ? ' · ' + code : '') + (chat ? ' · tg:' + chat : '');
  if (s.weekly || !s.row) {
    const row = tgNextRow_(sh);
    sh.getRange(row, 1, 1, 10).setValues([[
      s.therapist, s.dateIso, tgBandLabel_(s.hhmm), s.hhmm, 'آنلاین', 'رزرو شده',
      tgScopeOf_(chat), tag, stamp, note
    ]]);
    tgSlotsBust_();   /* v166.7 */
    if (typeof v168SlotFresh_ === 'function') v168SlotFresh_(row);   /* v168: حالت معارفه از نو */
    return row;
  }
  sh.getRange(s.row, 6).setValue('رزرو شده');
  sh.getRange(s.row, 8).setValue(tag);
  const prev = String(sh.getRange(s.row, 10).getValue() || '');
  sh.getRange(s.row, 10).setValue((prev ? prev + ' · ' : '') + note);
  tgSlotsBust_();   /* v166.7 */
  if (typeof v168SlotFresh_ === 'function') v168SlotFresh_(s.row);   /* v168: حالت معارفه از نو */
  return s.row;
}

function tgFlagSlotRow_(row, text) {
  if (TG_DRY || !row) return;
  const sh = tgSS_().getSheetByName(TG_SLOTS);
  const cur = String(sh.getRange(row, 10).getValue() || '');
  sh.getRange(row, 10).setValue(cur + ' · ⚠ ' + text);
}

function tgFreeSlotRow_(row) {
  if (TG_DRY || !row) return;
  const sh = tgSS_().getSheetByName(TG_SLOTS);
  sh.getRange(row, 6).setValue('آزاد');
  tgSlotsBust_();   /* v166.7 */
  const cur = String(sh.getRange(row, 10).getValue() || '');
  sh.getRange(row, 10).setValue(cur + ' · لغو توسط مراجع ' +
    Utilities.formatDate(new Date(), TG_TZ, 'yyyy-MM-dd HH:mm'));
}

function tgBandLabel_(hhmm) {
  const h = Number(hhmm.split(':')[0]);
  if (h < 12) return 'صبح ۹–۱۲';
  if (h < 15) return 'ظهر ۱۲–۱۵';
  if (h < 18) return 'عصر ۱۵–۱۸';
  return 'شب ۱۸–۲۲';
}

function tgNextRow_(sh) {
  const last = sh.getLastRow();
  if (last < 4) return 4;
  const col = sh.getRange(4, 1, last - 3, 1).getValues();
  for (var i = 0; i < col.length; i++) if (!String(col[i][0]).trim()) return i + 4;
  return last + 1;
}

/* ---------- لید ---------- */

function tgLeadInfo_(chat) {
  const r = tgFindLead_(chat);
  if (r < 0) return { name: 'نامشخص', phone: '' };
  const v = tgSS_().getSheetByName(TG_LEADS).getRange(r, 1, 1, 13).getValues()[0];
  return { name: String(v[3] || 'نامشخص'), phone: String(v[5] || '') };
}

/* v166.13: «chat_id: 123» نباید با «chat_id: 1234» یکی شود، و سطر کش‌شده بعد از حذف یا مرتب‌سازی تب دوباره سنجیده می‌شود */
function tgChatIdIn_(note, chat) {
  var s = String(note || ''), k = 'chat_id: ' + String(chat), i = s.indexOf(k);
  while (i > -1) { var nx = s.charAt(i + k.length); if (!/[0-9]/.test(nx)) return true; i = s.indexOf(k, i + 1); }
  return false;
}
function tgFindLead_(chat) {
  if (TG_DRY) return -1;
  const c = CacheService.getScriptCache();
  const sh = tgSS_().getSheetByName(TG_LEADS);
  const last = sh.getLastRow();
  const hit = c.get('lr' + chat);
  if (hit) {
    const hr = Number(hit);
    if (hr >= 2 && hr <= last && tgChatIdIn_(sh.getRange(hr, 13).getValue(), chat)) return hr;
    c.remove('lr' + chat);
  }
  if (last < 2) return -1;
  const notes = sh.getRange(2, 13, last - 1, 1).getValues();
  for (var i = notes.length - 1; i >= 0; i--) {
    if (tgChatIdIn_(notes[i][0], chat)) {
      c.put('lr' + chat, String(i + 2), 21600);
      return i + 2;
    }
  }
  return -1;
}

function tgWriteBooking_(chat, s, who) {
  if (TG_DRY) { TG_OUTBOX.push({ kind: 'booking', chat: chat, s: s }); return -1; }
  var target = tgFindLead_(chat);
  if (target < 0) {
    tgAppendLead_({
      source: 'Telegram bot',
      name: String(who || '').trim() || 'نامشخص',
      channel: 'تلگرام',
      phone: String(chat),
      status: 'معارفه هماهنگ شد',
      firstText: 'وقت معارفه را خودش از بات گرفت',
      note: 'chat_id: ' + chat
    });
    CacheService.getScriptCache().remove('lr' + chat);
    target = tgFindLead_(chat);
    if (target < 0) return -1;
    try { tgLeadCode_(target); } catch (e) {}
  }
  const lb = tgLeadRead_(target) || {};
  const chB = {
    'تاریخ ارجاع': Utilities.formatDate(new Date(), TG_TZ, 'yyyy-MM-dd'),
    'معارفه هماهنگ شد؟': 'بله', 'تاریخ معارفه': s.dateIso, 'درمانگر معارفه': s.therapist,
    'وضعیت': TG_ST.BOOKED, 'اقدام بعدی': 'یادآوری معارفه', 'تاریخ اقدام بعدی': s.dateIso
  };
  if (!lb.ref1) chB['درمانگر پیشنهادی ۱'] = s.therapist;
  /* مسئول انسانی قبلی پاک نمی‌شود؛ فقط لید بی‌مسئول برچسب خودرزرو می‌گیرد */
  if (!lb.owner) chB['مسئول'] = 'بات — خودرزرو';
  tgLeadSet_(target, chB, 'مراجع', 'بات', 'خودرزرو معارفه · ' + s.therapist + ' ' + s.dateIso + ' ' + s.hhmm);
  if (lb.owner && lb.owner !== 'بات — خودرزرو') tgLeadOwnerSay_(lb, '📅 مراجع ' + tgEsc_(lb.name || '') + ' (' + tgEsc_(lb.code || '') + ') خودش وقت معارفه گرفت: ' + tgEsc_(s.therapist) + ' · ' + tgEsc_(tgLeadJ_(s.dateIso)) + ' ' + tgFa_(s.hhmm));
  return target;
}

function tgClearBooking_(chat) {
  if (TG_DRY) return;
  const target = tgFindLead_(chat);
  if (target < 0) return;
  const today = Utilities.formatDate(new Date(), TG_TZ, 'yyyy-MM-dd');
  const lc = tgLeadRead_(target);
  const chC = { 'معارفه هماهنگ شد؟': 'خیر', 'اقدام بعدی': 'وقت تازهٔ معارفه', 'تاریخ اقدام بعدی': today };
  if (lc && !lc.closed) chC['وضعیت'] = TG_ST.FOLLOW;
  tgLeadSet_(target, chC, 'مراجع', 'بات', 'لغو معارفه توسط مراجع');
  tgLeadNote_(target, 'معارفه را خود مراجع لغو کرد', 'بات');
  if (lc) tgLeadOwnerSay_(lc, '❌ مراجع ' + tgEsc_(lc.name || '') + ' (' + tgEsc_(lc.code || '') + ') معارفه‌اش را لغو کرد. وقت تازه لازم دارد.', true);
}

/* v166.12: true/false برمی‌گرداند. اگر نوشتن شکست خورد، لید در TG_LEAD_RETRY می‌ماند و tgLeadRetry_ (از tgDutyTick) دوباره می‌نویسد. */
function tgAppendLead_(o, isRetry) {
  if (!isRetry && typeof igLeadPrefill_ === 'function') o = igLeadPrefill_(o);   /* v168: منبع اینستاگرام و فیلدهای پیش‌پر */
  if (!isRetry && typeof ebiLeadPrefill_ === 'function') o = ebiLeadPrefill_(o);   /* v170.16: منبع «کمپین › C-004 › <نوع>» */
  if (!isRetry && typeof v168NewLeadNext_ === 'function') o = v168NewLeadNext_(o);   /* v168 فاز ۲: لید تازه همان لحظه تکلیف دارد */
  if (TG_DRY) { TG_OUTBOX.push({ kind: 'lead', o: o }); return true; }
  if (tgTestLeak_('لید تازه')) return false;
  try {
    const sh = tgSS_().getSheetByName(TG_LEADS);
    if (!sh) { tgErr_('تب ' + TG_LEADS + ' پیدا نشد'); if (!isRetry) tgLeadRetryPush_(o); return false; }
    const now = o.when ? new Date(o.when) : new Date();
    /* v170.20: تنها نویسندهٔ سطر تازهٔ «لیدها» (بات، فرم سایت، واتس‌اپ، مدل لید). ستون شناخته‌شده‌ای که هنوز نیست ساخته می‌شود؛
       شماره همیشه متن نوشته می‌شود تا صفر اول نیفتد؛ کد لید همان لحظه زیر همان قفل. خروجی: شمارهٔ سطر. */
    var ph = String(o.phone == null ? '' : o.phone);
    if (/^[0-9+]/.test(ph)) ph = "'" + ph;
    if (o.extra) {
      var miss = Object.keys(o.extra).filter(function (k) { return TG_LEAD_FIELDS.indexOf(k) > -1 && o.extra[k] !== '' && o.extra[k] != null; });
      var have = tgScaleCols_(sh), made = false;
      miss.forEach(function (k) { if (!have[k]) { tgLeadCol_(k); made = true; } });
      if (made) { TG_SCALE_COLS_ = null; try { CacheService.getScriptCache().remove('scols'); } catch (eC) {} }
    }
    var row = 0;
    /* v166.13: نوشتن سطر و ستون‌های اسکیل زیر یک قفل؛ پیش از این getLastRow() جدا گرفته می‌شد و اگر فرم سایت یا
       واتس‌اپ همان لحظه سطری می‌افزود، پاسخ‌های بالینی این مراجع روی سطر آدم دیگری می‌نشست. */
    tgLeadRowLock_(function () {
      sh.appendRow(tgCellRow_([
        Utilities.formatDate(now, TG_TZ, 'yyyy-MM-dd'),
        Utilities.formatDate(now, TG_TZ, 'H:mm'),
        o.source || 'Telegram bot',
        o.name || '', o.channel || 'تلگرام', ph, o.region || '',
        o.firstText || '', o.status || 'جدید', o.owner || '', '', '', o.note || '',
        o.kind || '', o.topic || ''
      ]));
      row = sh.getLastRow();
      if (o.extra) tgWriteExtras_(sh, row, o.extra);
      try { if (typeof lmOnAppend_ === 'function') lmOnAppend_(sh, row, o); } catch (eLm) {}   /* v170.2: نوع لید و مهلت ۲۴ ساعت */
      try { tgLeadCode_(row); } catch (eCode) { tgErr_('tgAppendLead_ کد لید', eCode); }
    });
    const mm = String(o.note || '').match(/chat_id: (\d+)/);
    if (mm) CacheService.getScriptCache().remove('lr' + mm[1]);
    return row || true;
  } catch (e) {
    tgErr_('tgAppendLead_: ' + e);
    if (!isRetry) tgLeadRetryPush_(o);
    return false;
  }
}
/* قفل اسکریپت برای «سطر تازه + نوشتن روی همان سطر». اگر صدازننده قفل را دارد (TG_LOCK_HELD) دوباره نمی‌گیرد و رها نمی‌کند.
   اگر قفل در ۲۰ ثانیه نیامد، بی قفل می‌نویسد (گم کردن لید بدتر از احتمال کم جابه‌جایی است) و خطا ثبت می‌شود. */
function tgLeadRowLock_(fn) {
  if (TG_LOCK_HELD || TG_DRY) return fn();   /* v166.24: تست خشک قفل اسکریپت را نمی‌گیرد؛ وگرنه پشت قفل بات زنده تا ۲۰ ثانیه می‌ماند */
  var lock = LockService.getScriptLock(), got = false;
  try { lock.waitLock(20000); got = true; } catch (e) { tgErr_('tgLeadRowLock_', 'قفل نیامد؛ بی قفل نوشته شد'); }
  if (got) TG_LOCK_HELD = true;
  try { return fn(); } finally { if (got) { TG_LOCK_HELD = false; try { lock.releaseLock(); } catch (e2) {} } }
}
/* صف تکرار لیدهایی که نوشتنشان شکست خورد (حداکثر ۵۰). در Script Properties، مثل بقیهٔ حالت‌های داخلی بات. */
function tgLeadRetryPush_(o) {
  try {
    var P = PropertiesService.getScriptProperties(), q = [];
    try { q = JSON.parse(P.getProperty('TG_LEAD_RETRY') || '[]'); } catch (e) { q = []; }
    q.push({ o: o, t: Date.now(), n: 0 });
    P.setProperty('TG_LEAD_RETRY', JSON.stringify(q.slice(-50)));
  } catch (e2) { tgErr_('tgLeadRetryPush_', e2); }
}
function tgLeadRetry_() {
  if (TG_DRY) return 0;
  var P = PropertiesService.getScriptProperties(), q = [];
  try { q = JSON.parse(P.getProperty('TG_LEAD_RETRY') || '[]'); } catch (e) { q = []; }
  if (!q.length) return 0;
  var left = [], done = 0;
  for (var i = 0; i < q.length; i++) {
    var ph = q[i].o && q[i].o.phone;
    if (ph && tgLeadByPhone_(ph) >= 2) { done++; continue; }   /* در این فاصله از راه دیگری ثبت شد */
    if (tgAppendLead_(q[i].o, true)) { done++; continue; }
    q[i].n = (q[i].n || 0) + 1;
    left.push(q[i]);
  }
  if (left.length) P.setProperty('TG_LEAD_RETRY', JSON.stringify(left)); else P.deleteProperty('TG_LEAD_RETRY');
  if (left.length && left.some(function (x) { return x.n >= 12; })) tgErr_('tgLeadRetry_', 'لید بعد از ۱۲ بار تلاش هنوز نوشته نشده: ' + left.length);
  return done;
}

/* ---------- ستون‌های اسکیل، شمارهٔ تکراری، یادداشت، پیگیری خودکار ---------- */

var TG_SCALE_COLS_ = null;
// نقشهٔ هدر به شمارهٔ ستون در تب لیدها. هدرهای اسکیل اگر نبودند به انتهای سطر ۱ اضافه می‌شوند
function tgScaleCols_(sh) {
  if (TG_SCALE_COLS_) return TG_SCALE_COLS_;
  const cc = TG_DRY ? null : CacheService.getScriptCache();
  if (cc) { const hit = tgCacheGet_('scols'); if (hit) { try { TG_SCALE_COLS_ = JSON.parse(hit); return TG_SCALE_COLS_; } catch (e) {} } }
  const lastCol = sh.getLastColumn();
  const head = sh.getRange(1, 1, 1, lastCol).getValues()[0].map(function (h) { return String(h).trim(); });
  const map = {};
  head.forEach(function (h, i) { if (h) map[h] = i + 1; });
  var next = lastCol + 1;
  TG_SCALE_HEADS.forEach(function (h) {
    if (map[h]) return;
    sh.getRange(1, next).setValue(h);
    map[h] = next;
    next++;
  });
  TG_SCALE_COLS_ = map;
  if (cc) cc.put('scols', JSON.stringify(map), 3600);
  return map;
}

// یک خواندن و یک نوشتن روی بازهٔ پیوسته، به‌جای یک setValue برای هر ستون
function tgWriteExtras_(sh, row, extra) {
  if (TG_DRY || !row || row < 2) return;
  const cols = tgScaleCols_(sh);
  var lo = 0, hi = 0, k;
  for (k in extra) {
    if (!cols[k]) continue;
    if (extra[k] === '' || extra[k] === null || extra[k] === undefined) continue;
    if (!lo || cols[k] < lo) lo = cols[k];
    if (cols[k] > hi) hi = cols[k];
  }
  if (!lo) return;
  const rng = sh.getRange(row, lo, 1, hi - lo + 1);
  const cur = rng.getValues()[0];
  for (k in extra) {
    if (!cols[k]) continue;
    if (extra[k] === '' || extra[k] === null || extra[k] === undefined) continue;
    cur[cols[k] - lo] = extra[k];
  }
  rng.setValues([cur]);
}

// یک بار دستی اجرا کن تا ستون‌ها ساخته شوند. بدون فرمول، فقط هدر
function tgScaleColumns() {
  const sh = tgSS_().getSheetByName(TG_LEADS);
  const cols = tgScaleCols_(sh);
  Logger.log(TG_SCALE_HEADS.map(function (h) { return h + ': ستون ' + cols[h]; }).join('\n'));
}

// سطر لید با همین شماره (ده رقم آخر). از پایین می‌گردد تا تازه‌ترین سطر برگردد
function tgLeadByPhone_(p, email) {
  if (TG_DRY) return TG_DRY_LEADROW || (email && TG_MEM['leadbyemail'] && TG_MEM['leadbyemail'][String(email).toLowerCase()]) || -1;
  const sh = tgSS_().getSheetByName(TG_LEADS);
  const last = sh.getLastRow();
  if (last < 2) return -1;
  const tail = phoneKey_(p);   /* v170.19 */
  if (tail) {
    const ph = sh.getRange(2, 6, last - 1, 1).getValues();
    for (var i = ph.length - 1; i >= 0; i--) if (phoneKey_(ph[i][0]) === tail) return i + 2;
  }
  /* v170.18: با شماره پیدا نشد (مثلاً شمارهٔ خارجی بی‌کد کشور)، با ایمیل در یادداشت یا ستون «ایمیل» */
  const em = String(email || '').trim().toLowerCase();
  if (em.indexOf('@') < 1) return -1;
  const hm = tgLeadHeadMap_(sh), ec = hm['ایمیل'] || 0;
  const notes = sh.getRange(2, 13, last - 1, 1).getValues(), emails = ec ? sh.getRange(2, ec, last - 1, 1).getValues() : null;
  for (var j = notes.length - 1; j >= 0; j--) {
    if (String(notes[j][0]).toLowerCase().indexOf(em) > -1) return j + 2;
    if (emails && String(emails[j][0]).trim().toLowerCase() === em) return j + 2;
  }
  return -1;
}

// شمارهٔ تکراری: سطر تازه ساخته نمی‌شود؛ همان پرونده به‌روز می‌شود. پروندهٔ بسته با رویداد باز می‌شود و مسئولش خبر می‌گیرد
function tgUpdateLead_(row, extra, q, chat, uname, phone) {
  if (TG_DRY) { TG_OUTBOX.push({ kind: 'lead-update', row: row, extra: extra }); return; }

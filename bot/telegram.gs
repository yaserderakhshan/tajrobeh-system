function tgOnPz_(cq, rest) {
  var chat = cq.message.chat.id;
  var uname = cq.from && cq.from.username ? '@' + cq.from.username : '';
  var p = String(rest || '').split(':');
  if (p[0] === 'x') { tgPzEnd_(chat); return tgSend_(chat, 'باشد، بی‌خیال شدیم.'); }
  if (p[0] === 'c') {
    var d = tgPzGet_(chat) || { user: uname };

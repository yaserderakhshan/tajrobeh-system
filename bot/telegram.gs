  var cond = isOpen + ',' + hasCamp + ',(' + stage + '<>"' + TG_SCH_STAGES[TG_SCH_SG.done] + '")';
  var key = 'ARRAYFORMULA(' + stIdx + ')';
  sh.getRange(6, 2).setFormula('=IFERROR(SORT(FILTER(' + data + ',' + cond + '),FILTER(' + key + ',' + cond + '),FALSE),"")');
  /* نقشهٔ مرحله ← اقدام (ستون‌های N و O، مخفی) */

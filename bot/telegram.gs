  if (m.text && tgWkText_(chat, m.text)) return;
  if (tgGetVal_('evin', chat) && tgEvInput_(chat, m)) return;
  if (m.text && tgGetVal_('evc', chat) && tgEvContribText_(chat, name, uname, m.text)) return;
  if (m.text && tgEvText_(chat, m.text)) return;
  /* v162: بازخورد رویداد، تعریف رویداد، ثبت ساعت حضوری از پذیرش */
  if (m.text && /^\/start(@\w+)?\s+evf-/.test(m.text) && tgEvfJoin_(chat, m.text.replace(/^\/start(@\w+)?\s+/, '').trim())) return;
  if (tgGetVal_('evf', chat) && tgEvfInput_(chat, m, name)) return;
  if (m.text && tgEvnText_(chat, name, m.text)) return;
  if (m.text && tgGetVal_('inpd', chat) && tgInpDeskText_(chat, m.text)) return;
  if (typeof tgBcRoute_ === 'function' && tgBcRoute_(m, chat, name, uname)) return;
  /* v166: موتور صدا (voice.gs): مچ‌میکینگ صوتی، اصلاح متن صدا */
  if (typeof vxRoute_ === 'function' && vxRoute_(chat, m, name, uname)) return;
  /* v163: مشارکت در مجله (mag_contrib.gs): start=co-/rv-/mymag، دکمهٔ «مطالب من در مجله» و ورودی‌های حالت‌دار (متن، ویس، فایل) */
  if (typeof dqRoute_ === 'function' && dqRoute_(chat, m)) return;   /* v170: صف ارسال مدیریت (dq.gs) */
  if (typeof rvRoute_ === 'function' && rvRoute_(chat, m)) return;   /* v169: روند بازبینی علمی (review.gs) */
  if (typeof opsRoute_ === 'function' && opsRoute_(chat, m)) return;   /* v169.2: رسیدم و رفتم، فهرست گاندی، هاب من (ops.gs) */
  if (typeof mcRoute_ === 'function' && mcRoute_(chat, m)) return;
  /* v165: حساب نویسندهٔ وردپرس، خودسرویس (author.gs) */
  if (typeof tgAuRoute_ === 'function' && tgAuRoute_(chat, m)) return;
  /* v170.23.6.1: مهاجرت مراجعان به نسخهٔ ۲ (migrate.gs): start=v2mig، شمارهٔ مراجع، «مراجعان من»، پاسخ همکار نسخهٔ ۲ */
  if (typeof migRoute_ === 'function' && migRoute_(chat, m)) return;
  if (m.text && typeof migOwnerCmd_ === 'function' && migOwnerCmd_(chat, String(m.text).trim())) return;

  if (m.contact && m.contact.phone_number) {
    // v164: وسط اتصال درمانگر، شماره یعنی تأیید هویت (نه لید تازه، دام ۱۲)
    if (tgGetVal_('tsg', chat)) return tgTherSignPhone_(chat, m, name, uname);
    // وسط ویزارد اپلای تراپیست، اشتراک شماره یعنی جواب پرسش شماره، نه لید تازهٔ پذیرش
    if (tgGetVal_('apw', chat)) { m.text = m.contact.phone_number; if (tgApStep_(chat, m)) return; }
    // v122: وسط ثبت‌نام کمپین، شماره مال همان مسیر است (دام ۱۲)
    if (typeof tgCpContact_ === 'function' && tgCpContact_(chat, m.contact)) return;
    // وسط اتصال مدرسه، شماره یعنی «با شماره‌ام پیدا کن»، نه لید تازه
    if (tgGetVal_('esign', chat) && typeof tgEduByPhone_ === 'function') return tgEduByPhone_(chat, m.contact, m.from.id);
    if (typeof tgSjContact_ === 'function' && tgSjContact_(chat, m.contact)) return;
    return tgOnPhone_(chat, name, uname, m.contact.phone_number);
  }
  if (m.document && tgGetVal_('mzu', chat) && typeof tgMagDeliver_ === 'function' && tgMagDeliver_(chat, m)) return;
  // رودمپ‌ها: حالت‌دار (بازتاب همراه، ویس راهبر) پیش از هر مسیریابی
  if (typeof tgRmMaybe_ === 'function' && tgRmMaybe_(chat, m, name, uname)) return;
  // کمپین ثبت‌نام (v122): نام و شماره، رسید پرداخت، ویرایش خط زمانی، میز مصاحبه‌گر
  if (typeof tgCpMaybe_ === 'function' && tgCpMaybe_(chat, m, name, uname)) return;
  // پیام‌ها و «برای نسخهٔ بعد» (v117): دکمه، حالت نوشتن و ویس
  if (typeof tgMsgMaybe_ === 'function' && tgMsgMaybe_(chat, m, name, uname)) return;
  // استاد کلاس (v116): نام استادی که در فهرست نبود
  if (m.text && typeof tgClsMaybe_ === 'function' && tgClsMaybe_(chat, m.text, name)) return;
  // بازبینی پروفایل (v57): دکمهٔ صف، /review و جوابِ ویرایش ناظر
  if (typeof ktbMaybe_ === 'function' && ktbMaybe_(chat, m)) return;   /* v170.23.5: کارتابل «منتظر تأیید من» */
  if (typeof tgPrMaybe_ === 'function' && tgPrMaybe_(chat, m)) return;
  // پروفایل سایت (v54): حالت‌دار است و عکس و ویس و فایل هم می‌گیرد، پس پیش از هر مسیریابی
  if (tgGetVal_('pq', chat) && typeof tgPqStep_ === 'function' && tgPqStep_(chat, m)) return;
  // مدرسه v95: ویزاردهای دانش‌آموختگان و اپلای تراپیست، چون عکس و فایل هم می‌گیرند
  if (typeof tgSchMedia_ === 'function' && tgSchMedia_(chat, m)) return;

  if ((m.photo || m.document) && tgGetVal_('psyrc', chat) && typeof tgPsyReceipt_ === 'function' && tgPsyReceipt_(chat, m)) return;
  if (m.text && typeof tgPsyText_ === 'function' && tgPsyText_(chat, m.text)) return;
  if (m.photo && tgGetVal_('pro', chat)) {
    const th0 = tgWhoTherapist_(chat);
    if (th0 && tgProStep_(chat, '', m) === true) return;
  }
  if ((m.photo || m.document) && tgGetVal_('schof', chat) && typeof v17013ScholarFile_ === 'function' && v17013ScholarFile_(chat, m)) return;   /* v170.13: نمونه‌کار بورسیه */
  if (m.photo || m.document) {
    const u0 = m.from && m.from.username;
    if (tgWhoWatch_(chat, u0) || tgWhoDesk_(chat, u0)) { if (tgFileIds_(chat, m)) return; }
  }

  // ویس پذیرش وقتی یادداشت لید در انتظار است (v140)
  if (m.voice && typeof tgLeadVoice_ === 'function' && tgLeadVoice_(chat, m, name, uname)) return;
  /* v166: هر ویسی که مسیر دیگری نگرفت: متن می‌شود، به خود فرستنده برمی‌گردد و با «همین را بفرست» مثل پیام متنی ادامه پیدا می‌کند */
  if ((m.voice || m.audio) && typeof vxUniversal_ === 'function' && vxUniversal_(chat, m, name, uname)) return;

  const text = (m.text || '').trim();
  if (!text) return;
  /* v71: پرداخت تتر (لینک پرداخت، ساخت فاکتور، کد تراکنش) پیش از هر مسیریابی */
  if (text.indexOf('/start pay_') === 0 && tgPayOpen_(chat, text.slice(11).trim()) !== false) return;
  if ((text === TG_PAY_BTN || text === '/pay') && tgPayCanCreate_(chat)) return tgPayNew_(chat);
  if (tgGetVal_('payn', chat) && tgPayNewText_(chat, text) === true) return;
  if (tgGetVal_('paytx', chat) && tgPayTxText_(chat, text) === true) return;

  /* v166.28: پاسخ متنی سؤال آخر تست مهاجرت */
  if (typeof tgMigText_ === 'function' && tgGetVal_('mig', chat) && tgMigText_(chat, text)) return;
  // مجله: لینک اختصاصی هر موضوع — پیش از مسیریابی مدرسه و نقش
  if (text.indexOf('/start') === 0 && typeof tgMagPick_ === 'function') {
    var mzArg = text.replace(/^\/start(@\w+)?/, '').trim();
    var mzM   = mzArg.match(/^mzw[_-]([MSms])-?(\d{2,3})$/);
    if (mzM) { tgMagClear_(chat); return tgMagPick_(chat, mzM[1].toUpperCase() + '-' + mzM[2]); }
  }

  // رودمپ‌ها: کد شروع rm-<slug>[-منبع]، پیش از مدرسه
  if (text.indexOf('/start') === 0 && typeof tgRmStart_ === 'function') {
    var rmArg = text.replace(/^\/start(@\w+)?/, '').trim();
    if (/^rm[-_]/i.test(rmArg) && tgRmStart_(chat, rmArg, name, uname)) return;
  }
  /* v168: ورود از اینستاگرام ig_<پیج>_<کلمه> (social_ig.gs)، الگوی کلی، پیش از مدرسه و پیش از «کد ناشناخته» */
  if (text.indexOf('/start') === 0 && typeof tgIgStart_ === 'function') {
    var igArg = text.replace(/^\/start(@\w+)?/, '').trim();
    if (igArg.indexOf('ig_') === 0 && tgIgStart_(chat, igArg, name, uname)) return;
  }
  /* v170.13: آفر کمپین c_<کد> و پیگیری بورسیه sf_17_<ورودی>، پیش از مدرسه */
  if (text.indexOf('/start') === 0) {
    var v13Arg = text.replace(/^\/start(@\w+)?/, '').trim();
    if (/^c_/i.test(v13Arg) && typeof v17013OfStart_ === 'function' && v17013OfStart_(chat, v13Arg)) return;
    if (/^sf_17_/.test(v13Arg) && typeof v17013ScholarStart_ === 'function' && v17013ScholarStart_(chat, v13Arg)) return;
  }
  /* v168 فاز ۶: نام شهر برای «حضوری در شهر دیگر» */
  if (tgGetVal_('qcity', chat) === '?' && typeof v168CityText_ === 'function' && v168CityText_(chat, text)) return;
  /* v168.9: کشور محل زندگی (متن آزاد) */
  if (tgGetVal_('lctry', chat) === '?' && typeof v1689CtryText_ === 'function' && v1689CtryText_(chat, text)) return;
  // مدرسه: کد شروع و ثبت‌نام خودسرویس، پیش از هر مسیریابی نقشی
  if (text.indexOf('/start') === 0 && typeof tgSchoolStart_ === 'function') {
    const sArg = text.replace(/^\/start(@\w+)?/, '').trim();
    if (sArg && sArg !== 'ther' && sArg !== 'therapist' && sArg !== 'group' &&
        sArg !== 'style' && sArg !== 'test' && sArg !== 'content' && sArg !== 'feed' &&
        tgSchoolStart_(chat, sArg, uname)) return;
  }
  if (tgGetVal_('esign', chat)) {
    if (text.indexOf('تغییر نقش') > -1 || tgCmd_(text) === '/role' || text === '↩️ بازگشت' ||
        text.indexOf('/') === 0 || tgIsBtnLike_(text)) {
      tgDel_('esign', chat);          // از حالت انتظار اسم بیرون می‌آید و پیام به مسیر عادی می‌رود
    } else if (typeof tgEduSignupName_ === 'function') {
      return tgEduSignupName_(chat, text);
    }
  }
  // «نقشم را نمی‌بینم»: وصل‌کردن حساب از روی نام، پیش از هر مسیریابی نقشی
  if (typeof tgRoleClaim_ === 'function') {
    if (text.indexOf('نقش دیگری دارم') > -1) { return tgRoleClaim_(chat); }
    if (tgGetVal_('rclaim', chat)) {
      var back = (tgIsBtnLike_(text) || tgCmd_(text) === '/start');
      if (back) { tgDel_('rclaim', chat); }
      else { return tgRoleClaimName_(chat, text, name, uname); }
    }
  }
  // کارت لید: یادداشت آزاد تیم پذیرش، پیش از مسیریابی نقش (دام ۹)
  if (typeof tgLeadText_ === 'function' && tgLeadText_(chat, name, uname, text)) return;
  // مدرسه v95: کارت لید مدرسه، سوپرویژن و پیش‌ثبت‌نام، پیش از مسیریابی نقش (دام ۹)
  if (typeof tgSchText_ === 'function' && tgSchText_(chat, name, uname, text)) return;
  if (typeof tgReferPick_ === 'function' && tgReferPick_(chat, uname, text)) return;
  if (typeof tgWaAnswer_ === 'function' && tgWaAnswer_(chat, uname, text)) return;
  // نویسندگی مجله: دکمه، دستور و حالت‌های انتظار متن آزاد، پیش از مسیریابی نقش (دام ۹)
  if (tgV1Route_(chat, name, uname, text)) return;
  if (typeof tgMagText_ === 'function' && tgMagText_(chat, name, uname, text)) return;
  // مدرسه: عضویت خودسرویس، کامیونیتی و میز تأیید مسئول مدرسه، پیش از مسیریابی نقش
  if (typeof tgSjText_ === 'function' && tgSjText_(chat, name, uname, text)) return;

  const uname0 = m.from && m.from.username;
  if (text && tgGetVal_('inpchk', chat) && tgInpChkText_(chat, text) === true) return;   /* v68: پاسخ بررسی برنامهٔ حضوری */
  const roles = tgMyRoles_(chat, uname0);
  TG_MULTI = roles.length > 1;
  let asClient = false;

  if (roles.length < 2) {
    if (text.indexOf('تغییر نقش') > -1 || tgCmd_(text) === '/role') {
      tgDel_('role', chat);
      return tgRolePick_(chat, roles);

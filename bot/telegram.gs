/* ============================================================
   سیاست ظرفیت و لایهٔ نظارت و ارزیابی
   ------------------------------------------------------------
   دو چیز جدا:
   ۱) سیاست: چند وقت هفتگی و چند رزرو برای هر درمانگر مجاز است.
   ۲) نظارت: هر هفته یک سطر عدد، در سه جبهه (درخواست، پیگیری، درمانگر).
   هر دو از تب «سیاست‌ها» تغذیه می‌شوند تا با آمدن پلتفرم ورژن ۲
   فقط منبع همان تب عوض شود، نه کد.
   ============================================================ */

const TG_POL_TAB  = 'سیاست‌ها';
const TG_MON_TAB  = 'نظارت';

const TG_CAP_BASE  = 9;    // سقف پیش‌فرض وقت هفتگی اعلام‌شده
const TG_CAP_MIN   = 2;
const TG_CAP_MAX   = 24;
const TG_BOOK_BASE = 5;    // سقف پیش‌فرض معارفهٔ رزروشده در هفته
const TG_BOOK_MIN  = 1;
const TG_BOOK_MAX  = 20;

const TG_C_CAP  = 28;   // AB سقف وقت هفتگی این درمانگر
const TG_C_BOOK = 29;   // AC سقف رزرو هفتگی این درمانگر

const TG_POL_SEED = [
  ['کلید', 'مقدار', 'توضیح'],
  ['سقف وقت هفتگی', TG_CAP_BASE,  'حداکثر وقت هفتگی که هر درمانگر می‌تواند اعلام کند. ستون AB تب درمانگران برای هر نفر جدا این را می‌شکند.'],
  ['سقف رزرو هفتگی', TG_BOOK_BASE, 'حداکثر معارفهٔ رزروشده برای هر درمانگر در هفته. اگر با این سقف هیچ وقتی برای مراجع نماند، سقف نادیده گرفته می‌شود. ستون AC برای هر نفر جدا.'],
  ['پوشش هدف',       2,            'عرضه چند برابر تقاضا باشد تا مراجع همیشه انتخاب داشته باشد. مبنای سقف پیشنهادی در گزارش هفتگی.'],
  ['مهلت تماس اول (ساعت)', 4,      'بیش از این، لید در گزارش «دیرکرد» شمرده می‌شود.']
];

function tgPolSheet_() {
  const ss = tgSS_();
  let sh = ss.getSheetByName(TG_POL_TAB);
  if (!sh) {
    sh = ss.insertSheet(TG_POL_TAB);
    sh.getRange(1, 1, TG_POL_SEED.length, 3).setValues(TG_POL_SEED);
    sh.setFrozenRows(1);
    sh.setColumnWidth(1, 190);
    sh.setColumnWidth(2, 90);
    sh.setColumnWidth(3, 620);
    sh.getRange(1, 1, 1, 3).setFontWeight('bold');
    sh.getRange(1, 1, sh.getMaxRows(), 3).setHorizontalAlignment('right');
  }
  return sh;
}

/* یک عدد از تب سیاست‌ها. اگر نبود، پیش‌فرض. */
var TG_POL_X = null;   /* v166.26: سیاست‌ها یک بار در هر اجرا؛ tgPolSet پاکش می‌کند */
function tgPol_(key, def) {
  if (TG_DRY) return TG_MEM['pol:' + key] !== undefined ? TG_MEM['pol:' + key] : def;
  try {
    if (!TG_POL_X) {
      const sh = tgPolSheet_();
      const last = sh.getLastRow();
      TG_POL_X = last < 2 ? [] : sh.getRange(2, 1, last - 1, 2).getValues();
    }
    const v = TG_POL_X;
    for (var i = 0; i < v.length; i++) {
      if (String(v[i][0]).trim() === key) {
        const n = Number(tgLatinDigits_(String(v[i][1]).trim()));
        return isNaN(n) ? def : n;
      }
    }
  } catch (e) { tgErr_('tgPol_: ' + e); }
  return def;
}

function tgClamp_(n, lo, hi) { return Math.max(lo, Math.min(hi, n)); }

/* سقف وقت هفتگی این درمانگر: فردی، بعد عمومی، بعد پیش‌فرض. */
function tgCapFor_(name) {
  const gen = tgClamp_(tgPol_('سقف وقت هفتگی', TG_CAP_BASE), TG_CAP_MIN, TG_CAP_MAX);
  const own = tgTherNum_(name, TG_C_CAP);
  return own ? tgClamp_(own, TG_CAP_MIN, TG_CAP_MAX) : gen;
}

/* سقف رزرو هفتگی این درمانگر. */
function tgBookCapFor_(name) {
  const gen = tgClamp_(tgPol_('سقف رزرو هفتگی', TG_BOOK_BASE), TG_BOOK_MIN, TG_BOOK_MAX);
  const own = tgTherNum_(name, TG_C_BOOK);
  return own ? tgClamp_(own, TG_BOOK_MIN, TG_BOOK_MAX) : gen;
}

/* یک عدد از یک ستون تب درمانگران، برای این اسم. صفر یعنی خالی. */
function tgTherNum_(name, col) {
  if (TG_DRY) return Number(TG_MEM['thernum:' + name + ':' + col] || 0);
  try {
    const rows = tgTherapistRows_();
    const key = tgNorm_(name);
    for (var i = 0; i < rows.length; i++) {
      if (tgNorm_(rows[i].name) !== key) continue;
      const sh = tgSS_().getSheetByName(TG_THER);
      if (sh.getMaxColumns() < col) return 0;
      const n = Number(tgLatinDigits_(String(sh.getRange(rows[i].row, col).getValue()).trim()));
      return isNaN(n) ? 0 : n;
    }
  } catch (e) { tgErr_('tgTherNum_: ' + e); }
  return 0;
}

/* ---------- شمارش رزرو هفتگی ---------- */

/* شنبهٔ ابتدای هفته، back هفته قبل، ساعت صفر تهران. */
function tgWeekStart_(back) {
  const now = new Date();
  const u = Number(Utilities.formatDate(now, TG_TZ, 'u'));   // ۱ دوشنبه … ۷ یکشنبه
  const since = (u + 1) % 7;                                  // فاصله تا شنبه
  const iso = Utilities.formatDate(new Date(now.getTime() - (since + (back || 0) * 7) * 86400000), TG_TZ, 'yyyy-MM-dd');
  return new Date(iso + 'T00:00:00+03:30');
}

/* چند معارفهٔ رزروشده در این هفته روی این درمانگر نشسته است. */
var TG_BOOKED_X = null;
function tgBookedThisWeek_(name) {
  if (TG_DRY) return Number(TG_MEM['booked:' + tgNorm_(name)] || 0);
  try {
    /* v166.26: شمار همهٔ درمانگرها یک بار در هر اجرا (پیش از این برای هر درمانگر یک بار کل تب خوانده می‌شد) */
    if (!TG_BOOKED_X) {
      TG_BOOKED_X = {};
      const v = tgSlotsRead_();
      const a = tgWeekStart_(0).getTime();
      const b = a + 7 * 86400000;
      for (var i = 0; i < v.length; i++) {
        if (String(v[i][5]).trim() === 'آزاد') continue;
        if (!(v[i][1] instanceof Date)) continue;
        const t = v[i][1].getTime();
        if (t >= a && t < b) { const k0 = tgNorm_(String(v[i][0])); TG_BOOKED_X[k0] = (TG_BOOKED_X[k0] || 0) + 1; }
      }
    }
    return TG_BOOKED_X[tgNorm_(name)] || 0;
  } catch (e) { tgErr_('tgBookedThisWeek_: ' + e); return 0; }
}

/* درمانگرانی که این هفته به سقف رزرو رسیده‌اند از فهرست کنار می‌روند.
   شیر اطمینان: اگر با این کار هیچ وقتی نماند، فیلتر اعمال نمی‌شود.
   هیچ مراجعی نباید به خاطر سیاست داخلی ما بی‌وقت بماند. */
function tgCapFilter_(slots) {
  if (!slots || !slots.length) return slots;
  const cache = {};
  const kept = [];
  for (var i = 0; i < slots.length; i++) {
    const n = slots[i].therapist;
    if (cache[n] === undefined) cache[n] = tgBookedThisWeek_(n) < tgBookCapFor_(n);
    if (cache[n]) kept.push(slots[i]);
  }
  return kept.length ? kept : slots;
}

/* ---------- نظارت ---------- */

const TG_MON_HEAD = [
  'دوره', 'از', 'تا',
  'لید کل', 'از سایت', 'از بات', 'سایر',
  'معارفهٔ رزروشده', 'نرخ رزرو ٪',
  'لید باز', 'دیرکرد تماس اول', 'میانگین ساعت تا تماس اول',
  'درمانگر با وقت فعال', 'اسلات آزاد', 'اسلات رزروشده', 'ضریب اشغال ٪',
  'ضریب پوشش', 'تیکت تازه', 'میانگین دقیقه تا پاسخ تیکت',
  'سقف پیشنهادی', 'یادداشت'
];

function tgMonSheet_() {
  const ss = tgSS_();
  let sh = ss.getSheetByName(TG_MON_TAB);
  if (!sh) {
    sh = ss.insertSheet(TG_MON_TAB);
    sh.getRange(1, 1, 1, TG_MON_HEAD.length).setValues([TG_MON_HEAD]).setFontWeight('bold');
    sh.setFrozenRows(1);
    sh.setFrozenColumns(1);
    sh.setColumnWidth(1, 150);
    sh.getRange(1, 1, sh.getMaxRows(), TG_MON_HEAD.length).setHorizontalAlignment('center');
  }
  return sh;
}

/* منبع لید را به سه دستهٔ خوانا می‌برد. */
function tgLeadSrc_(src, channel) {
  const s = String(src || '').trim();
  const c = String(channel || '').trim();
  if (s.indexOf('سایت') === 0) return 'سایت';
  if (/Telegram|تلگرام|بات/i.test(s) || c === 'تلگرام') return 'بات';
  return 'سایر';
}

/* تاریخ ستون A را با ساعت ستون B به یک Date تبدیل می‌کند. */
function tgAsDate_(when, hhmm) {
  let d = null;
  if (when instanceof Date) d = new Date(when.getTime());
  else if (String(when).trim()) d = new Date(String(when).trim() + 'T00:00:00+03:30');
  if (!d || isNaN(d.getTime())) return null;
  const h = tgLatinDigits_(String(hhmm || '').trim());
  if (/^\d{1,2}:\d{2}$/.test(h)) { const p = h.split(':'); d.setHours(Number(p[0]), Number(p[1]), 0, 0); }
  return d;
}

/* عددهای یک هفته. back=۰ هفتهٔ جاری، back=۱ هفتهٔ گذشته. */
function tgMonWeek_(back) {
  const a = tgWeekStart_(back);
  const b = new Date(a.getTime() + 7 * 86400000);
  const m = {
    from: a, to: new Date(b.getTime() - 1),
    total: 0, site: 0, bot: 0, other: 0,
    booked: 0, open: 0, late: 0, firstSum: 0, firstN: 0,
    ther: 0, free: 0, taken: 0, tkNew: 0, tkSum: 0, tkN: 0
  };
  const lateH = tgPol_('مهلت تماس اول (ساعت)', 4);

  // جبههٔ یک و دو: حجم درخواست و پیگیری
  const sh = tgSS_().getSheetByName(TG_LEADS);
  if (sh && sh.getLastRow() > 1) {
    const v = sh.getRange(2, 1, sh.getLastRow() - 1, Math.max(21, sh.getLastColumn())).getValues();
    for (var i = 0; i < v.length; i++) {
      const d = tgAsDate_(v[i][0], v[i][1]);
      if (!d || d < a || d >= b) continue;
      if (!String(v[i][3] || '').trim() && !String(v[i][5] || '').trim()) continue;
      m.total++;
      const k = tgLeadSrc_(v[i][2], v[i][4]);
      if (k === 'سایت') m.site++; else if (k === 'بات') m.bot++; else m.other++;
      if (String(v[i][19] || '').trim() === 'بله') m.booked++;
      const st = tgStOf_(v[i][8]);
      if (!st || st === 'جدید') m.open++;
      const k1 = v[i][10];
      if (k1 instanceof Date) {
        const h = (k1.getTime() - d.getTime()) / 3600000;
        if (h >= 0) { m.firstSum += h; m.firstN++; if (h > lateH) m.late++; }
      } else if ((new Date().getTime() - d.getTime()) / 3600000 > lateH && (!st || st === 'جدید')) {
        m.late++;
      }
    }
  }

  // جبههٔ سه: عرضهٔ درمانگران
  // ظرفیت واقعی از «وقت‌های هفتگی» می‌آید، نه از تب اسلات که فقط رزروها و وقت‌های موردی را دارد.
  // برای هفته‌های گذشته، قاعده‌های امروز مبنا هستند؛ پس عدد عرضه تقریبی است.
  const takenKeys = {};
  const ss = tgSS_().getSheetByName(TG_SLOTS);
  if (ss && ss.getLastRow() > 3) {
    const v = ss.getRange(4, 1, ss.getLastRow() - 3, 6).getValues();
    for (var j = 0; j < v.length; j++) {
      if (!(v[j][1] instanceof Date)) continue;
      const tt = v[j][1].getTime();
      if (tt < a.getTime() || tt >= b.getTime()) continue;
      if (String(v[j][5]).trim() === 'آزاد') { m.free++; continue; }
      m.taken++;
      takenKeys[tgNorm_(String(v[j][0])) + '|' +
                Utilities.formatDate(v[j][1], TG_TZ, 'yyyy-MM-dd') + '|' + tgHHMM_(v[j][3])] = true;
    }
  }
  const names = {};
  const rules = tgWeeklyRules_(null);
  for (var d = 0; d < 7; d++) {
    const day = new Date(a.getTime() + d * 86400000);
    const iso = Utilities.formatDate(day, TG_TZ, 'yyyy-MM-dd');
    const wd  = Number(Utilities.formatDate(day, TG_TZ, 'u'));
    for (var r2 = 0; r2 < rules.length; r2++) {
      if (rules[r2].iso !== wd) continue;
      if (!tgRecurOk_(rules[r2].recur, rules[r2].from, iso)) continue;
      const nk = tgNorm_(rules[r2].name);
      names[nk] = true;
      if (takenKeys[nk + '|' + iso + '|' + rules[r2].hhmm]) continue;
      m.free++;
    }
  }
  m.ther = Object.keys(names).length;

  // تیکت درمانگران: ستون ۱۲ دقیقه تا پاسخ، ستون ۱۴ زمان ثبت
  try {
    const tk = tgSS_().getSheetByName(TG_TK_TAB);
    if (tk && tk.getLastRow() > 1) {
      const v = tk.getRange(2, 1, tk.getLastRow() - 1, TG_TK_HEAD.length).getValues();
      for (var r = 0; r < v.length; r++) {
        if (!String(v[r][0]).trim()) continue;
        const d = v[r][13] instanceof Date ? v[r][13] : null;
        if (!d || d < a || d >= b) continue;
        m.tkNew++;
        const mm = Number(tgLatinDigits_(String(v[r][11] || '').trim()));
        if (mm > 0) { m.tkSum += mm; m.tkN++; }
      }
    }
  } catch (e) {}

  m.rate  = m.total ? Math.round(m.booked * 100 / m.total) : 0;
  m.occ   = (m.free + m.taken) ? Math.round(m.taken * 100 / (m.free + m.taken)) : 0;
  m.cover = m.total ? Math.round((m.free + m.taken) * 10 / m.total) / 10 : 0;
  m.first = m.firstN ? Math.round(m.firstSum * 10 / m.firstN) / 10 : 0;
  m.tkAvg = m.tkN ? Math.round(m.tkSum / m.tkN) : 0;

  const advice = tgCapAdvice_(m);
  m.cap = advice.cap;
  m.why = advice.why;
  return m;
}

/* سقف پیشنهادی: عرضه باید چند برابر تقاضا باشد تا مراجع انتخاب داشته باشد.
   این عدد فقط پیشنهاد است. سقف واقعی تا وقتی کسی تب سیاست‌ها را عوض نکند تغییر نمی‌کند. */
function tgCapAdvice_(m) {
  const now  = tgClamp_(tgPol_('سقف وقت هفتگی', TG_CAP_BASE), TG_CAP_MIN, TG_CAP_MAX);
  const goal = tgPol_('پوشش هدف', 2);
  if (!m.total) return { cap: now, why: 'این هفته لیدی ثبت نشده؛ سقف دست نخورد.' };
  const supply = m.free + m.taken;
  const need   = m.total * goal;
  if (!m.ther) return { cap: now, why: 'هیچ درمانگری وقت فعال ندارد؛ مسئله سقف نیست، مسئله نبودن عرضه است.' };
  if (supply >= need) return { cap: now, why: 'عرضه به هدف رسیده؛ سقف را نگه دار.' };
  const per = Math.ceil(need / m.ther);
  const cap = tgClamp_(Math.max(now, per), TG_CAP_MIN, TG_CAP_MAX);
  if (cap === now) return { cap: now, why: 'کمبود عرضه از سقف نمی‌آید؛ از تعداد درمانگر فعال می‌آید.' };
  return { cap: cap, why: 'برای رسیدن به پوشش هدف، سهم هر درمانگر ' + tgFa_(per) + ' وقت می‌شود.' };
}

/* یک سطر برای هفتهٔ گذشته می‌نویسد. اگر سطر همان دوره هست، به‌روزش می‌کند. */
function tgMonSnap(back) {
  const b = back === undefined ? 1 : back;
  const m = tgMonWeek_(b);
  const sh = tgMonSheet_();
  const label = tgJDate_(m.from, TG_TZ) + ' تا ' + tgJDate_(m.to, TG_TZ);
  const row = [
    label,
    Utilities.formatDate(m.from, TG_TZ, 'yyyy-MM-dd'),
    Utilities.formatDate(m.to,   TG_TZ, 'yyyy-MM-dd'),
    m.total, m.site, m.bot, m.other,
    m.booked, m.rate,
    m.open, m.late, m.first,
    m.ther, m.free, m.taken, m.occ,
    m.cover, m.tkNew, m.tkAvg,
    m.cap, m.why
  ];
  let at = 0;
  const last = sh.getLastRow();
  if (last > 1) {
    const col = sh.getRange(2, 1, last - 1, 1).getValues();
    for (var i = 0; i < col.length; i++) if (String(col[i][0]).trim() === label) { at = i + 2; break; }
  }
  if (at) sh.getRange(at, 1, 1, row.length).setValues([row]);
  else sh.appendRow(row);
  return tgMonReport_(m);
}

/* گزارش خوانا در سه جبهه. */
function tgMonReport_(m) {
  const L = [];
  L.push('📊 نظارت هفتگی · ' + tgJDate_(m.from, TG_TZ) + ' تا ' + tgJDate_(m.to, TG_TZ));
  L.push('');
  L.push('<b>۱) حجم درخواست</b>');
  L.push('کل ' + tgFa_(m.total) + '  ·  سایت ' + tgFa_(m.site) + '  ·  بات ' + tgFa_(m.bot) + '  ·  سایر ' + tgFa_(m.other));
  L.push('');
  L.push('<b>۲) پیگیری لید</b>');
  L.push('معارفهٔ رزروشده ' + tgFa_(m.booked) + ' از ' + tgFa_(m.total) + '  (' + tgFa_(m.rate) + '٪)');
  L.push('هنوز باز ' + tgFa_(m.open) + '  ·  دیرکرد تماس اول ' + tgFa_(m.late));
  L.push('میانگین تا تماس اول ' + (m.firstN ? tgFa_(m.first) + ' ساعت' : 'هنوز عددی نداریم'));
  L.push('');
  L.push('<b>۳) درمانگران</b>');
  L.push('درمانگر با وقت فعال ' + tgFa_(m.ther));
  L.push('اسلات: ' + tgFa_(m.taken) + ' رزرو از ' + tgFa_(m.free + m.taken) + '  (اشغال ' + tgFa_(m.occ) + '٪)');
  L.push('پوشش ' + tgFa_(m.cover) + ' برابر تقاضا');
  if (m.tkNew) L.push('تیکت تازه ' + tgFa_(m.tkNew) + (m.tkN ? '  ·  میانگین پاسخ ' + tgFa_(m.tkAvg) + ' دقیقه' : ''));
  L.push('');
  L.push('سقف وقت هفتگی الان ' + tgFa_(tgClamp_(tgPol_('سقف وقت هفتگی', TG_CAP_BASE), TG_CAP_MIN, TG_CAP_MAX)) +
         '، پیشنهاد ' + tgFa_(m.cap));
  L.push(m.why);
  return L.join('\n');
}

/* هفتهٔ جاری تا همین لحظه، برای دکمهٔ بات. */
function tgMonNow() { return tgMonReport_(tgMonWeek_(0)); }

/* تریگر هفتگی: اسنپ‌شات هفتهٔ گذشته و ارسال به تیم پذیرش. */
function tgMonWeekly(e) {
  if (ciPaused_(e, 'tgMonWeekly', 'defer')) return;
  var rs0 = Date.now(); try {   /* v166.18: سنجش زمان اجرا (بدنه بی‌تغییر) */
  const txt = tgMonSnap(1);
  try {
    const rows = tgDeskRows_();
    for (var i = 0; i < rows.length; i++) {
      const ids = String(rows[i].chat || '').split(/[,،;\s]+/).filter(String);
      for (var j = 0; j < ids.length; j++) tgSend_(ids[j], txt, tgDeskMenu_());
    }
  } catch (e) { tgErr_('tgMonWeekly: ' + e); }
  return txt;
  } finally { tgRunStat_('tgMonWeekly', rs0); }
}

/* راه‌اندازی یک‌باره: تب سیاست‌ها، تب نظارت، ستون‌های سقف در تب درمانگران. */
function tgMonSetup() {
  tgPolSheet_();
  tgMonSheet_();
  const sh = tgSS_().getSheetByName(TG_THER);
  if (sh) {
    if (sh.getMaxColumns() < TG_C_BOOK) sh.insertColumnsAfter(sh.getMaxColumns(), TG_C_BOOK - sh.getMaxColumns());
    if (!String(sh.getRange(3, TG_C_CAP).getValue()).trim())  sh.getRange(3, TG_C_CAP).setValue('سقف وقت هفتگی');
    if (!String(sh.getRange(3, TG_C_BOOK).getValue()).trim()) sh.getRange(3, TG_C_BOOK).setValue('سقف رزرو هفتگی');
  }
  return 'تب «' + TG_POL_TAB + '» و «' + TG_MON_TAB + '» آماده‌اند و ستون‌های سقف در تب درمانگران ساخته شد.';
}

/* تریگر هفتگی نظارت: شنبه ساعت ۱۰ صبح. */
function tgMonTrigger() {
  const all = ScriptApp.getProjectTriggers();
  for (var i = 0; i < all.length; i++) {
    if (all[i].getHandlerFunction() === 'tgMonWeekly') ScriptApp.deleteTrigger(all[i]);
  }
  /* v169.1: تریگر جدا نه؛ شنبه از ساعت ۱۰ از tgWatchdog، یک بار در هفته (v1691Weekly_) */
  return 'از v169.1 نظارت هفتگی شنبه ساعت ۱۰ از tgWatchdog می‌رود و تریگر جدا ندارد.';
}

/* ---------- تست سیاست و نظارت ---------- */

function tgMonTests() {
  const out = [];
  function ok(name, cond) { out.push((cond ? '✅ ' : '❌ ') + name); }

  const wasDry = TG_DRY;
  TG_DRY = true;

  TG_MEM['pol:سقف وقت هفتگی'] = 9;
  TG_MEM['pol:سقف رزرو هفتگی'] = 5;
  TG_MEM['pol:پوشش هدف'] = 2;
  ok('سقف عمومی خوانده می‌شود', tgCapFor_('کسی') === 9);
  TG_MEM['thernum:کسی:' + TG_C_CAP] = 14;
  ok('سقف فردی سقف عمومی را می‌شکند', tgCapFor_('کسی') === 14);
  TG_MEM['thernum:کسی:' + TG_C_CAP] = 99;
  ok('سقف فردی از حد مطلق بالاتر نمی‌رود', tgCapFor_('کسی') === TG_CAP_MAX);
  TG_MEM['thernum:کسی:' + TG_C_CAP] = 0;

  ok('منبع سایت', tgLeadSrc_('سایت › پذیرش › فرم ۷', '') === 'سایت');
  ok('منبع بات', tgLeadSrc_('Telegram bot', 'تلگرام') === 'بات');
  ok('منبع سایر', tgLeadSrc_('واتس‌اپ', 'واتس‌اپ') === 'سایر');

  const ws = tgWeekStart_(0);
  ok('هفته از شنبه شروع می‌شود', Utilities.formatDate(ws, TG_TZ, 'u') === '6');
  ok('هفتهٔ قبل هفت روز عقب‌تر است',
     Math.round((ws.getTime() - tgWeekStart_(1).getTime()) / 86400000) === 7);

  TG_MEM['booked:' + tgNorm_('پرکار')] = 5;
  TG_MEM['booked:' + tgNorm_('خلوت')] = 0;
  const kept = tgCapFilter_([{ therapist: 'پرکار' }, { therapist: 'خلوت' }]);
  ok('درمانگر پر از فهرست کنار می‌رود', kept.length === 1 && kept[0].therapist === 'خلوت');
  ok('شیر اطمینان: اگر چیزی نماند سقف نادیده گرفته می‌شود',
     tgCapFilter_([{ therapist: 'پرکار' }]).length === 1);

  ok('بدون لید سقف دست نمی‌خورد', tgCapAdvice_({ total: 0, free: 0, taken: 0, ther: 3 }).cap === 9);
  ok('عرضهٔ کافی سقف را بالا نمی‌برد', tgCapAdvice_({ total: 10, free: 30, taken: 5, ther: 4 }).cap === 9);
  ok('کمبود عرضه سقف بالاتر پیشنهاد می‌دهد', tgCapAdvice_({ total: 20, free: 5, taken: 5, ther: 2 }).cap > 9);
  const a4 = tgCapAdvice_({ total: 10, free: 0, taken: 0, ther: 0 });
  ok('نبود درمانگر با سقف حل نمی‌شود', a4.cap === 9 && a4.why.indexOf('عرضه') > -1);

  ok('تاریخ با ساعت ترکیب می‌شود', tgAsDate_('2026-09-05', '14:30').getHours() === 14);
  ok('تاریخ بی‌معنا رد می‌شود', tgAsDate_('', '') === null);

  const rep = tgMonReport_({
    from: new Date(), to: new Date(), total: 10, site: 6, bot: 4, other: 0,
    booked: 3, rate: 30, open: 4, late: 1, first: 2.5, firstN: 3,
    ther: 5, free: 12, taken: 3, occ: 20, cover: 1.5, tkNew: 0, tkN: 0, tkAvg: 0,
    cap: 9, why: 'تست'
  });
  ok('گزارش هر سه جبهه را دارد',
     rep.indexOf('حجم درخواست') > -1 && rep.indexOf('پیگیری لید') > -1 && rep.indexOf('درمانگران') > -1);
  ok('گزارش خط تیرهٔ وسط جمله ندارد', rep.indexOf(' — ') === -1);

  TG_DRY = wasDry;
  return out.join('\n') + '\n(' + out.filter(function (s) { return s.indexOf('✅') === 0; }).length + ' از ' + out.length + ')';
}


/* ============================================================
   نقش ناظر و گزارش روزانه
   ------------------------------------------------------------
   ناظر کسی است که فقط و فقط یک پیام در روز می‌گیرد:
   جمع‌بندی ۲۴ ساعت گذشته و فهرست کارهایی که باید خودش وارد شود.
   عمداً در هیچ مسیر اعلان دیگری نیست: نه SLA، نه دایجست،
   نه اعلان تیکت، نه گزارش هفتگی. اسپم ممنوع.
   ============================================================ */

const TG_ROLE_WATCH = 'ناظر';
const TG_DAY_TAB    = 'نظارت روزانه';

const TG_DAY_HEAD = [
  'روز', 'تاریخ', 'لید کل', 'سایت', 'بات', 'سایر',
  'پذیرش', 'مدرسه', 'روان‌پزشکی', 'سازمانی',
  'بدون مسئول', 'بدون تماس اول', 'میانگین ساعت تا تماس',
  'معارفهٔ رزروشده', 'اسلات آزاد ۷ روز', 'اسلات رزرو ۷ روز', 'درمانگر فعال',
  'تیکت تازه', 'تیکت باز', 'باگ تازه',
  'موارد مداخله', 'خلاصه'
];

/* آیا این گفت‌وگو ناظر است؟ اگر یوزرنیم خورد، chat_id را همان‌جا می‌نویسد. */
function tgWatchList_() {
  if (TG_DRY) return [];
  const c = CacheService.getScriptCache();
  const hit = tgCacheGet_('wlist');
  if (hit) { try { return JSON.parse(hit); } catch (e) {} }
  const out = [];
  try {
    const list = tgPeopleRows_();
    for (var i = 0; i < list.length; i++) {
      if (list[i].roles.indexOf(TG_ROLE_WATCH) < 0) continue;
      out.push({ row: list[i].row, name: list[i].name, user: list[i].user,
                 chat: list[i].chat, status: list[i].status,
                 scope: list[i].scope });
    }
    c.put('wlist', JSON.stringify(out), 1800);
  } catch (e) { tgErr_('tgWatchList_: ' + e); }
  return out;
}

/* آیا این گفت‌وگو ناظر است؟ اگر یوزرنیم خورد، chat_id را همان‌جا می‌نویسد.
   فهرست ناظرها پنج دقیقه کش می‌شود تا این چک به ازای هر پیام یک خواندن شیت نشود. */
function tgWhoWatch_(chat, username) {
  if (TG_DRY) return TG_MEM['watch'] || null;
  try {
    const u = String(username || '').replace(/^@/, '').toLowerCase();
    const list = tgWatchList_();
    const m = tgIdMatch_(list, chat, u, tgChatIn_);   /* v170.9 (امنیت) */
    if (m) {
      if (m.bind) {
        try {
          tgPersonSet_(m.row.row, { addChat: String(chat) }, 'بات', { why: 'اتصال ناظر' });
          m.row.chat = String(chat);
          CacheService.getScriptCache().remove('wlist');
        } catch (e) {}
      }
      return m.row;
    }
  } catch (e) { tgErr_('tgWhoWatch_: ' + e); }
  return null;
}

/* گیرنده‌های گزارش روزانه، هر کدام با دامنهٔ خودش */
/* دامنهٔ گزارش یک نفر را ست می‌کند. مثال:
     tgScopeSet('مسئول روان‌پزشکی', 'به‌جز مدرسه')
     tgScopeSet('یاسر', 'همه')                                            */
function tgScopeSet(name, scope) {
  const sh = tgPeopleSheet_();
  const list = tgPeopleRows_();
  const q = tgNorm_(name);
  const hit = [];
  for (var i = 0; i < list.length; i++) {
    const n = tgNorm_(list[i].name);
    if (n === q || n.indexOf(q) > -1) hit.push(list[i]);
  }
  if (!hit.length) return 'کسی با این نام در تب افراد نیست: ' + name;
  if (hit.length > 1) return 'چند نفر با این نام هست: ' + hit.map(function (x) { return x.name; }).join('، ');
  tgPersonSet_(hit[0].row, { 'دامنهٔ گزارش': String(scope || '') }, 'مالک', { why: 'دامنهٔ گزارش' });
  try { CacheService.getScriptCache().remove('wlist'); } catch (e) {}
  return hit[0].name + ' → دامنهٔ گزارش: ' + (scope || 'همه');
}

function tgWatchTargets_() {
  const out = [];
  try {
    const list = tgPeopleRows_();
    const seen = {};
    for (var i = 0; i < list.length; i++) {
      if (String(list[i].status).trim() === 'غیرفعال') continue;
      const isWatch = list[i].roles.indexOf(TG_ROLE_WATCH) > -1;
      const scope = String(list[i].scope || '').trim();
      // ناظر بدون دامنه یعنی همه؛ بقیه فقط اگر دامنه‌شان صریح نوشته شده باشد
      if (!isWatch && !scope) continue;
      const ids = String(list[i].chat || '').split(/[,،;\s]+/).filter(String);
      const mine = [];
      for (var j = 0; j < ids.length; j++) if (!seen[ids[j]]) { seen[ids[j]] = 1; mine.push(ids[j]); }
      if (mine.length) out.push({ ids: mine, scope: scope, name: list[i].name });
    }
  } catch (e) { tgErr_('tgWatchTargets_: ' + e); }
  return out;
}

/* مالک مجموعه. هر مسیری که «ناظر» را لازم دارد باید حتماً این chat_id را هم داشته باشد، حتی اگر سطر ناظر در تب افراد خالی باشد */
var TG_OWNER_CHAT = String(cfg_('TG_OWNER_CHAT', ''));

function tgWatchIds_() {
  const out = [];
  try {
    const list = tgPeopleList_();
    for (var i = 0; i < list.length; i++) {
      if (list[i].roles.indexOf(TG_ROLE_WATCH) < 0) continue;
      if (String(list[i].status).trim() === 'غیرفعال') continue;
      const ids = String(list[i].chat || '').split(/[,،;\s]+/).filter(String);
      for (var j = 0; j < ids.length; j++) if (out.indexOf(ids[j]) < 0) out.push(ids[j]);
    }
  } catch (e) { tgErr_('tgWatchIds_: ' + e); }
  if (out.indexOf(TG_OWNER_CHAT) < 0) out.push(TG_OWNER_CHAT);
  return out;
}

const T_WATCH_MENU = 'گزارش کامل هر شب یک بار خودش می‌آید. اینجا هر وقت خواستی می‌توانی زودتر ببینی.';

function tgWatchMenu_() {
  return {
    keyboard: (typeof KTB_BTN !== 'undefined' ? [[KTB_BTN]] : []).concat([['📊 گزارش امروز', TG_STAT_BTN], ['📈 این هفته'], ['🩺 سلامت سیستم'], [TG_PR_BTN, TG_APQ_BTN], [TG_EVN_BTN], [TG_DASH_BTN, TG_TSK_BTN], [TG_BOX_BTN, TG_TSK_NEW]]).concat(typeof DQ_BTN !== 'undefined' ? [[DQ_BTN]] : []).concat(tgRoleRow_()),
    resize_keyboard: true
  };
}

function tgWatchRoute_(chat, who, text) {
  const t = String(text || '');
  if (t.indexOf('آمار') > -1) return tgSend_(chat, tgStatText_(), tgWatchMenu_());
  if (t.indexOf('هفته') > -1) return tgSend_(chat, tgMonNow(), tgWatchMenu_());
  if (t.indexOf('سلامت') > -1) return tgSend_(chat, tgHealth_(), tgWatchMenu_());
  if (t.indexOf('گزارش') > -1 || t.indexOf('/start') === 0 || !t) {
    return tgSend_(chat, tgDayReport_(tgDayView_(tgDayWin_(), tgScope_(who && who.scope))), tgWatchMenu_());
  }
  return tgSend_(chat, T_WATCH_MENU, tgWatchMenu_());
}

/* ---------- پنجرهٔ ۲۴ ساعت ---------- */

/* ───── دامنهٔ گزارش ─────
   هر ناظر فقط بخش‌هایی را می‌بیند که کارش با آن‌هاست.
   ستون «دامنهٔ گزارش» در تب افراد:
     خالی یا «همه»      → همه‌چیز
     «به‌جز مدرسه»       → همه‌چیز جز مدرسه
     «روان‌پزشکی، پذیرش» → فقط همین دو بخش                                */

const TG_SECTIONS = ['پذیرش', 'مدرسه', 'روان‌پزشکی', 'سازمانی'];

function tgDayBy_(d, sec) {
  if (!d.by[sec]) d.by[sec] = { total: 0, site: 0, bot: 0, other: 0, booked: 0,
    noCall: 0, noOwner: 0, callSum: 0, callN: 0, week: 0, weekSite: 0, weekBooked: 0,
    worstH: 0, worst: '' };
  return d.by[sec];
}

function tgScope_(s) {
  const raw = String(s || '').trim();
  const sc = { all: true, only: [], not: [], raw: raw };
  if (!raw || raw === 'همه') return sc;
  const parts = raw.split(/[,،;]+/).map(function (x) { return x.trim(); }).filter(Boolean);
  for (var i = 0; i < parts.length; i++) {
    var p = parts[i];
    if (p.indexOf('به‌جز') === 0 || p.indexOf('بجز') === 0 || p.charAt(0) === '-') {
      p = p.replace(/^به‌جز/, '').replace(/^بجز/, '').replace(/^-/, '').trim();
      if (p) sc.not.push(p);
    } else if (p !== 'همه') sc.only.push(p);
  }
  if (sc.only.length) sc.all = false;
  return sc;
}

function tgInScope_(sc, sec) {
  const s = String(sec || '').trim();
  for (var i = 0; i < sc.not.length; i++) if (sc.not[i] === s) return false;
  if (sc.all) return true;
  for (var j = 0; j < sc.only.length; j++) if (sc.only[j] === s) return true;
  return false;
}

function tgScopeFull_(sc) { return sc.all && !sc.not.length; }

function tgSecList_(d) {
  const out = TG_SECTIONS.slice();
  const keys = Object.keys((d && d.by) || {});
  for (var i = 0; i < keys.length; i++) if (out.indexOf(keys[i]) < 0) out.push(keys[i]);
  return out;
}

/* دامنه‌ای که هر بخشی جز مدرسه را ببیند، کار درمان را می‌بیند */
function tgScopeCare_(sc, d) {
  const list = tgSecList_(d);
  for (var i = 0; i < list.length; i++) if (list[i] !== 'مدرسه' && tgInScope_(sc, list[i])) return true;
  return false;
}

/* نمای گزارش برای یک دامنه — همان شکل d، فقط با عددهای همان بخش‌ها */
function tgDayView_(d, sc) {
  if (tgScopeFull_(sc)) return d;
  const v = {};
  for (var k in d) v[k] = d[k];
  const list = tgSecList_(d);
  const keep = [];
  for (var i = 0; i < list.length; i++) if (tgInScope_(sc, list[i])) keep.push(list[i]);

  const sum = ['total', 'site', 'bot', 'other', 'booked', 'noCall', 'noOwner',
               'callSum', 'callN', 'week', 'weekSite', 'weekBooked'];
  for (var z = 0; z < sum.length; z++) v[sum[z]] = 0;
  v.sec = {}; v.worst = ''; v.worstH = 0; v.by = {};

  for (var j = 0; j < keep.length; j++) {
    const B = d.by[keep[j]];
    if (!B) continue;
    v.by[keep[j]] = B;
    for (var z2 = 0; z2 < sum.length; z2++) v[sum[z2]] += B[sum[z2]] || 0;
    if (d.sec[keep[j]]) v.sec[keep[j]] = d.sec[keep[j]];
    if ((B.worstH || 0) > v.worstH) { v.worstH = B.worstH; v.worst = B.worst; }
  }

  v.care = tgScopeCare_(sc, d);
  if (!v.care) {
    v.free7 = 0; v.taken7 = 0; v.ther = 0;
    v.tkNew = 0; v.tkOpen = 0; v.tkLate = 0; v.tkSum = 0; v.tkN = 0;
  }
  if (!tgInScope_(sc, 'مدرسه')) v.school = 0;
  // مالی و سلامت سامانه فقط در گزارش کامل می‌آید
  v.money = 0; v.errs = 0; v.pending = 0; v.hookErr = '';
  v.bugNew = 0; v.bugOpen = 0;

  v.call = v.callN ? Math.round(v.callSum * 10 / v.callN) / 10 : 0;
  v.tkAvg = v.tkN ? Math.round(v.tkSum / v.tkN) : 0;
  v.rate7 = v.week ? Math.round(v.weekBooked * 100 / v.week) : 0;
  v.cover = v.week ? Math.round((v.free7 + v.taken7) * 10 / v.week) / 10 : 0;
  v.scope = sc;
  return v;
}

function tgDayWin_() {
  const now = new Date();
  const a = new Date(now.getTime() - 86400000);
  const d = {
    from: a, to: now,
    total: 0, site: 0, bot: 0, other: 0,
    sec: {}, noOwner: 0, noCall: 0, callSum: 0, callN: 0,
    booked: 0, free7: 0, taken7: 0, ther: 0,
    tkNew: 0, tkOpen: 0, tkLate: 0, tkSum: 0, tkN: 0,
    bugNew: 0, bugOpen: 0, school: 0, money: 0, care: true, by: {},
    errs: 0, week: 0, weekSite: 0, weekBooked: 0,
    worst: '', worstH: 0, pending: 0, hookErr: ''
  };
  const lateH = tgPol_('مهلت تماس اول (ساعت)', 4);
  const w7 = new Date(now.getTime() - 7 * 86400000);

  // لیدها
  try {
    const sh = tgSS_().getSheetByName(TG_LEADS);
    if (sh && sh.getLastRow() > 1) {
      const v = sh.getRange(2, 1, sh.getLastRow() - 1, Math.max(21, sh.getLastColumn())).getValues();
      let worstH = 0;
      for (var i = 0; i < v.length; i++) {
        const t = tgAsDate_(v[i][0], v[i][1]);
        if (!t) continue;
        if (!String(v[i][3] || '').trim() && !String(v[i][5] || '').trim()) continue;
        const st = tgStOf_(v[i][8]);
        const open = !st || st === 'جدید';
        const sc = tgSection_(v[i][2], v[i][12]);
        const B = tgDayBy_(d, sc);

        if (t >= w7) {
          d.week++; B.week++;
          if (tgLeadSrc_(v[i][2], v[i][4]) === 'سایت') { d.weekSite++; B.weekSite++; }
          if (String(v[i][19] || '').trim() === 'بله') { d.weekBooked++; B.weekBooked++; }
        }

        // معطل‌ماندهٔ باز، بدون توجه به اینکه کی آمده
        if (open) {
          const k1 = v[i][10];
          if (!(k1 instanceof Date)) {
            const h = (now.getTime() - t.getTime()) / 3600000;
            if (h > lateH) {
              d.noCall++; B.noCall++;
              if (h > worstH) { worstH = h; d.worst = tgJDate_(t, TG_TZ) + ' ساعت ' + tgCellTime_(v[i][1]); }
              if (h > B.worstH) { B.worstH = Math.round(h); B.worst = tgJDate_(t, TG_TZ) + ' ساعت ' + tgCellTime_(v[i][1]); }
            }
          }
          if (!String(v[i][9] || '').trim()) { d.noOwner++; B.noOwner++; }
        }

        if (t < d.from) continue;
        d.total++; B.total++;
        const k = tgLeadSrc_(v[i][2], v[i][4]);
        if (k === 'سایت') { d.site++; B.site++; } else if (k === 'بات') { d.bot++; B.bot++; } else { d.other++; B.other++; }
        d.sec[sc] = (d.sec[sc] || 0) + 1;
        if (String(v[i][19] || '').trim() === 'بله') { d.booked++; B.booked++; }
        const kk = v[i][10];
        if (kk instanceof Date) {
          const hh = (kk.getTime() - t.getTime()) / 3600000;
          if (hh >= 0) { d.callSum += hh; d.callN++; B.callSum += hh; B.callN++; }
        }
      }
      d.worstH = Math.round(worstH);
    }
  } catch (e) { tgErr_('tgDay_ leads: ' + e); }

  // عرضهٔ هفت روز آینده
  try {
    const free = tgFreeSlots_(null);
    const lim = new Date(now.getTime() + 7 * 86400000);
    const names = {};
    for (var f = 0; f < free.length; f++) {
      const u = tgSlotUtc_(free[f]);
      if (u > lim) continue;
      d.free7++;
      names[tgNorm_(free[f].therapist)] = true;
    }
    d.ther = Object.keys(names).length;
    const sl = tgSS_().getSheetByName(TG_SLOTS);
    if (sl && sl.getLastRow() > 3) {
      const v = sl.getRange(4, 1, sl.getLastRow() - 3, 6).getValues();
      for (var s = 0; s < v.length; s++) {
        if (!(v[s][1] instanceof Date)) continue;
        const tt = v[s][1].getTime();
        if (tt < now.getTime() || tt > lim.getTime()) continue;
        if (String(v[s][5]).trim() !== 'آزاد') d.taken7++;
      }
    }
  } catch (e) { tgErr_('tgDay_ slots: ' + e); }

  // تیکت درمانگران
  try {
    const tk = tgSS_().getSheetByName(TG_TK_TAB);
    if (tk && tk.getLastRow() > 1) {
      const v = tk.getRange(2, 1, tk.getLastRow() - 1, TG_TK_HEAD.length).getValues();
      for (var r = 0; r < v.length; r++) {
        if (!String(v[r][0]).trim()) continue;
        const at = v[r][13] instanceof Date ? v[r][13] : null;
        const status = String(v[r][8] || '').trim() || 'باز';
        const topic = String(v[r][5] || '').trim();
        if (at && at >= d.from) {
          d.tkNew++;
          if (topic.indexOf('مدرسه') > -1) d.school++;
          if (topic.indexOf('مالی') > -1 || topic.indexOf('پرداخت') > -1 || topic.indexOf('تسویه') > -1) d.money++;
        }
        if (status === 'باز') {
          d.tkOpen++;
          if (at && (now.getTime() - at.getTime()) / 3600000 > 24) d.tkLate++;
        }
        const mm = Number(tgLatinDigits_(String(v[r][11] || '').trim()));
        if (mm > 0 && at && at >= d.from) { d.tkSum += mm; d.tkN++; }
      }
    }
  } catch (e) { tgErr_('tgDay_ tickets: ' + e); }

  // باگ و پیشنهاد
  try {
    const bg = tgSS_().getSheetByName(TG_BUG_TAB);
    if (bg && bg.getLastRow() > 1) {
      const v = bg.getRange(2, 1, bg.getLastRow() - 1, TG_BUG_HEAD.length).getValues();
      for (var b = 0; b < v.length; b++) {
        if (!String(v[b][0]).trim()) continue;
        const at = v[b][10] instanceof Date ? v[b][10] : null;
        if (at && at >= d.from) d.bugNew++;
        const st = String(v[b][6] || '').trim() || 'تازه';
        if (st === 'تازه' || st === 'در بررسی') d.bugOpen++;
      }
    }
  } catch (e) { tgErr_('tgDay_ bugs: ' + e); }

  // خطاها
  try {
    const er = tgSS_().getSheetByName('Errors');
    if (er && er.getLastRow() > 1) {
      const v = er.getRange(2, 1, er.getLastRow() - 1, 1).getValues();
      for (var q = 0; q < v.length; q++) {
        const at = v[q][0] instanceof Date ? v[q][0] : null;
        if (at && at >= d.from) d.errs++;
      }
    }
  } catch (e) {}

  // سلامت مسیر پیام
  try {
    const info = tgApi_('getWebhookInfo', {});
    if (info && info.result) {
      d.pending = Number(info.result.pending_update_count || 0);
      d.hookErr = String(info.result.last_error_message || '');
    }
  } catch (e) {}

  d.call = d.callN ? Math.round(d.callSum * 10 / d.callN) / 10 : 0;
  d.tkAvg = d.tkN ? Math.round(d.tkSum / d.tkN) : 0;
  d.rate7 = d.week ? Math.round(d.weekBooked * 100 / d.week) : 0;
  d.cover = d.week ? Math.round((d.free7 + d.taken7) * 10 / d.week) / 10 : 0;
  return d;
}

/* ---------- کارهایی که باید خودش وارد شود ---------- */

function tgActions_(d) {
  const a = [];
  if (d.pending > 20 || d.hookErr) {
    a.push('🔴 مسیر پیام تلگرام سالم نیست (' + tgFa_(d.pending) + ' آپدیت در صف). طاها را خبر کن.');
  }
  if (d.errs > 0) {
    a.push('🔴 ' + tgFa_(d.errs) + ' خطای تازه در تب Errors ثبت شده. یعنی یک مسیر ورودی می‌شکند.');
  }
  if (d.noCall > 0) {
    a.push('🟠 ' + tgFa_(d.noCall) + ' لید باز بدون تماس اول' +
           (d.worst ? '، قدیمی‌ترینش ' + tgFa_(d.worstH) + ' ساعت معطل (' + d.worst + ')' : '') +
           '. این حرف با تیم پذیرش است.');
  }
  if (d.noOwner > 0) {
    a.push('🟠 ' + tgFa_(d.noOwner) + ' لید باز بدون مسئول مانده. واگذاری خودکار جا مانده، دستی واگذار کن.');
  }
  if (!d.total) {
    a.push('🟠 در ۲۴ ساعت گذشته هیچ لیدی ثبت نشد. اگر روز عادی بوده، کانال ورودی را چک کن.');
  } else if (!d.site && d.weekSite > 0) {
    a.push('🟠 امروز هیچ لیدی از سایت نیامد در حالی که این هفته ' + tgFa_(d.weekSite) +
           ' تا آمده بود. احتمال خرابی فرم یا اسنیپت وردپرس.');
  }
  if (d.care !== false && d.ther > 0 && d.ther <= 3) {
    a.push('🟠 عرضه روی ' + tgFa_(d.ther) + ' درمانگر بند است. اگر یکی‌شان برود، مسیر معارفه می‌خوابد.');
  }
  if (d.care !== false && d.week && d.cover < 1.5) {
    a.push('🟠 وقت آزاد فقط ' + tgFa_(d.cover) + ' برابر تقاضاست. باید با درمانگرها حرف بزنی، نه اینکه سقف را بالا ببری.');
  }
  if (d.week >= 10 && d.rate7 < 10) {
    a.push('🟠 نرخ رزرو معارفه در ۷ روز گذشته ' + tgFa_(d.rate7) + '٪ است. مسیر تبدیل مشکل دارد.');
  }
  if (d.care !== false && d.tkLate > 0) {
    a.push('🟠 ' + tgFa_(d.tkLate) + ' پیام درمانگر بیش از ۲۴ ساعت بی‌جواب مانده.');
  }
  if (d.bugNew > 0) {
    a.push('🟡 ' + tgFa_(d.bugNew) + ' باگ یا پیشنهاد تازه ثبت شده.');
  }
  return a;
}

/* ---------- متن گزارش ---------- */

/* نام دامنه برای سربرگ گزارش */
function tgScopeName_(d) {
  const sc = d.scope;
  if (!sc || tgScopeFull_(sc)) return 'همه';
  if (sc.only.length) return sc.only.join('، ');
  return 'همه‌چیز جز ' + sc.not.join('، ');
}

/* یک خط برای هر بخش: لید امروز، معارفه، لید باز بی‌تماس */
function tgDaySecRows_(d) {
  const list = tgSecList_(d);
  const out = [];
  for (var i = 0; i < list.length; i++) {
    const s = list[i];
    if (d.scope && !tgInScope_(d.scope, s)) continue;
    const B = (d.by && d.by[s]) || null;
    if (!B) continue;
    if (!B.total && !B.noCall && !B.noOwner) continue;
    const bits = [tgFa_(B.total) + ' لید'];
    if (B.booked) bits.push(tgFa_(B.booked) + ' معارفه');
    if (B.noCall) bits.push(tgFa_(B.noCall) + ' باز بی‌تماس');
    if (B.noOwner) bits.push(tgFa_(B.noOwner) + ' بدون مسئول');
    if (B.callN) bits.push('تماس اول ' + tgFa_(Math.round(B.callSum * 10 / B.callN) / 10) + ' ساعت');
    out.push('• <b>' + s + '</b>  ' + bits.join('  ·  '));
  }
  return out;
}

function tgDayReport_(d) {
  const L = [];
  const acts = tgActions_(d);
  L.push('🌙 <b>گزارش ۲۴ ساعت گذشته</b>');
  L.push(tgJDateFull_(d.from, TG_TZ) + ' تا ' + tgJDateFull_(d.to, TG_TZ));
  if (d.scope && !tgScopeFull_(d.scope)) L.push('<i>دامنهٔ این گزارش: ' + tgScopeName_(d) + '</i>');
  L.push('');

  L.push('<b>لیدها</b>');
  L.push('کل ' + tgFa_(d.total) + '  ·  سایت ' + tgFa_(d.site) + '  ·  بات ' + tgFa_(d.bot) +
         (d.other ? '  ·  سایر ' + tgFa_(d.other) : ''));
  const rows = tgDaySecRows_(d);
  if (rows.length) {
    L.push('');
    L.push('<b>به تفکیک بخش</b>');
    for (var s0 = 0; s0 < rows.length; s0++) L.push(rows[s0]);
  }
  L.push('۷ روز گذشته ' + tgFa_(d.week) + ' لید، ' + tgFa_(d.weekBooked) + ' معارفه (' + tgFa_(d.rate7) + '٪)');
  L.push('');

  L.push('<b>پاسخ‌دهی</b>');
  L.push(d.callN ? 'میانگین تا تماس اول ' + tgFa_(d.call) + ' ساعت (روی ' + tgFa_(d.callN) + ' لید)'
                 : 'برای لیدهای امروز هنوز تماسی ثبت نشده');
  L.push('لید باز بدون تماس ' + tgFa_(d.noCall) + '  ·  بدون مسئول ' + tgFa_(d.noOwner));
  L.push('');

  L.push('<b>معارفه</b>');
  L.push('معارفهٔ امروز ' + tgFa_(d.booked));
  if (d.care !== false) {
    L.push('۷ روز آینده: ' + tgFa_(d.free7) + ' وقت آزاد، ' + tgFa_(d.taken7) + ' رزرو، از ' + tgFa_(d.ther) + ' درمانگر');
    L.push('پوشش ' + tgFa_(d.cover) + ' برابر تقاضای هفتگی');
  }
  L.push('');

  const showMsg = d.care !== false || d.school || d.money;
  if (showMsg) {
  L.push('<b>پیام‌ها</b>');
  if (d.care !== false) L.push('تیکت تازه ' + tgFa_(d.tkNew) + '  ·  باز ' + tgFa_(d.tkOpen) +
         (d.tkN ? '  ·  میانگین پاسخ ' + tgFa_(d.tkAvg) + ' دقیقه' : ''));
  if (d.school || d.money) {
    L.push('مدرسه ' + tgFa_(d.school) + '  ·  مالی ' + tgFa_(d.money));
  }
  if (d.bugNew || d.bugOpen) L.push('باگ و پیشنهاد: ' + tgFa_(d.bugNew) + ' تازه، ' + tgFa_(d.bugOpen) + ' باز');
  L.push('');
  }

  L.push('<b>کاری که با توست</b>');
  if (!acts.length) L.push('چیزی نیست که لازم باشد امروز وارد شوی.');
  else for (var i = 0; i < acts.length; i++) L.push(acts[i]);

  return L.join('\n');
}

/* سلامت سیستم، برای وقتی که خودش بپرسد. */
function tgHealth_() {
  const L = ['🩺 <b>سلامت سیستم</b>'];
  try {
    const info = tgApi_('getWebhookInfo', {});
    const r = (info && info.result) || {};
    L.push('آپدیت در صف: ' + tgFa_(Number(r.pending_update_count || 0)));
    L.push('آخرین خطای وبهوک: ' + (r.last_error_message ? tgEsc_(String(r.last_error_message)) : 'ندارد'));
  } catch (e) { L.push('خواندن وضعیت وبهوک ممکن نشد.'); }
  try {
    const ss = tgSS_();
    const need = [TG_LEADS, TG_SLOTS, TG_WEEKLY, TG_THER, TG_TK_TAB, TG_MON_TAB, TG_DAY_TAB, TG_POL_TAB];
    const miss = need.filter(function (n) { return !ss.getSheetByName(n); });
    L.push('تب‌ها: ' + (miss.length ? 'نداریم ' + miss.join('، ') : 'همه سر جایشان'));
  } catch (e) {}
  L.push('سقف وقت هفتگی ' + tgFa_(tgClamp_(tgPol_('سقف وقت هفتگی', TG_CAP_BASE), TG_CAP_MIN, TG_CAP_MAX)) +
         '  ·  سقف رزرو ' + tgFa_(tgClamp_(tgPol_('سقف رزرو هفتگی', TG_BOOK_BASE), TG_BOOK_MIN, TG_BOOK_MAX)));
  return L.join('\n');
}

/* ---------- تب زندهٔ روزانه ---------- */

function tgDaySheet_() {
  const ss = tgSS_();
  let sh = ss.getSheetByName(TG_DAY_TAB);
  if (!sh) {
    sh = ss.insertSheet(TG_DAY_TAB);
    sh.getRange(1, 1, 1, TG_DAY_HEAD.length).setValues([TG_DAY_HEAD]).setFontWeight('bold');
    sh.setFrozenRows(1);
    sh.setColumnWidth(1, 130);
    sh.setColumnWidth(TG_DAY_HEAD.length, 360);
    sh.getRange(1, 1, sh.getMaxRows(), TG_DAY_HEAD.length - 1).setHorizontalAlignment('center');
  }
  return sh;
}

function tgDayWrite_(d) {
  const sh = tgDaySheet_();
  const label = tgJDate_(d.to, TG_TZ);
  const acts = tgActions_(d);
  const row = [
    label, Utilities.formatDate(d.to, TG_TZ, 'yyyy-MM-dd'),
    d.total, d.site, d.bot, d.other,
    d.sec['پذیرش'] || 0, d.sec['مدرسه'] || 0, d.sec['روان‌پزشکی'] || 0, d.sec['سازمانی'] || 0,
    d.noOwner, d.noCall, d.call,
    d.booked, d.free7, d.taken7, d.ther,
    d.tkNew, d.tkOpen, d.bugNew,
    acts.length,
    acts.length ? acts.join('\n') : 'چیزی برای مداخله نبود'
  ];
  let at = 0;
  const last = sh.getLastRow();
  if (last > 1) {
    const col = sh.getRange(2, 1, last - 1, 1).getValues();
    for (var i = 0; i < col.length; i++) if (String(col[i][0]).trim() === label) { at = i + 2; break; }
  }
  if (at) sh.getRange(at, 1, 1, row.length).setValues([row]);
  else sh.appendRow(row);
  return sh;
}

/* نمودار روند لید به تفکیک منبع. هر بار بازهٔ تازه را می‌گیرد. */
function tgDayChart() {
  const sh = tgDaySheet_();
  const last = Math.max(2, sh.getLastRow());
  const olds = sh.getCharts();
  for (var i = 0; i < olds.length; i++) sh.removeChart(olds[i]);
  const chart = sh.newChart()
    .setChartType(Charts.ChartType.LINE)
    .addRange(sh.getRange(1, 1, last, 1))
    .addRange(sh.getRange(1, 3, last, 3))
    .setNumHeaders(1)
    .setPosition(2, TG_DAY_HEAD.length + 2, 0, 0)
    .setOption('title', 'روند لید روزانه')
    .setOption('width', 640)
    .setOption('height', 320)
    .setOption('legend', { position: 'bottom' })
    .build();
  sh.insertChart(chart);
  return 'نمودار روند لید ساخته شد.';
}

/* ---------- یک بار در روز ---------- */

function tgDaily(e) {
  if (ciPaused_(e, 'tgDaily', 'defer')) return;
  var rs0 = Date.now(); try {   /* v166.18: سنجش زمان اجرا (بدنه بی‌تغییر) */
  const d = tgDayWin_();
  const txt = tgDayReport_(d);
  try { tgDayWrite_(d); } catch (e) { tgErr_('tgDayWrite_: ' + e); }
  try { tgDayChart(); } catch (e) { tgErr_('tgDayChart: ' + e); }
  try { tgTqRemind_(); } catch (e) { tgErr_('tgTqRemind_: ' + e); }   /* v166.21: درخواست اتصال بی‌جواب */
  try { if (typeof scDaily_ === 'function') scDaily_(new Date()); } catch (e) { tgErr_('scDaily_: ' + e); }   /* v166.25: یادآوری جلسهٔ بالینی، اتصال دانشجو */
  try { if (typeof opsNightly_ === 'function') opsNightly_(); } catch (e) { tgErr_('opsNightly_: ' + e); }   /* v169.2: پایان روز حضور، گزارش گاندی، کارکرد هفتگی */
  try { tgFillJalali_(false); } catch (e) { tgErr_('tgFillJalali_: ' + e); }
  const targets = tgWatchTargets_();
  const cache = {};
  var sent = 0;
  for (var i = 0; i < targets.length; i++) {
    const key = targets[i].scope || 'همه';
    if (cache[key] === undefined) cache[key] = tgDayReport_(tgDayView_(d, tgScope_(key)));
    for (var j = 0; j < targets[i].ids.length; j++) { tgSend_(targets[i].ids[j], cache[key]); sent++; }
  }
  return sent ? txt : 'هیچ ناظری با chat_id ثبت نشده؛ گزارش فقط در تب نوشته شد.\n\n' + txt;
  } finally { tgRunStat_('tgDaily', rs0); }
}

/* تریگر: هر شب ساعت ۲۱ به وقت تهران، فقط همین یکی. */
function tgDailyTrigger() {
  const all = ScriptApp.getProjectTriggers();
  for (var i = 0; i < all.length; i++) {
    if (all[i].getHandlerFunction() === 'tgDaily') ScriptApp.deleteTrigger(all[i]);
  }
  ScriptApp.newTrigger('tgDaily').timeBased().atHour(21).nearMinute(0).everyDays(1).create();
  return 'گزارش روزانه هر شب ساعت ۲۱ فرستاده می‌شود، یک بار و نه بیشتر.';
}

/* ثبت ناظر. یک بار اجرا می‌شود. */
function tgAddWatcher(user, name) {
  const u = String(user || '').replace(/^@/, '').toLowerCase();
  if (!u) return 'یوزرنیم ناظر را بدهید: tgAddWatcher(\'یوزرنیم\', \'نام\')';
  const n = String(name || u);
  tgPeopleSheet_();
  const sh = tgPeopleSheet_();
  const rows = tgPeopleRows_();
  for (var i = 0; i < rows.length; i++) {
    if (rows[i].user !== u) continue;
    tgPersonSet_(rows[i].row, { addRole: TG_ROLE_WATCH }, 'مالک', { why: 'ناظر' });
    return n + ' از قبل در تب افراد بود؛ نقش ناظر به او اضافه شد.';
  }
  tgPersonAdd_({ name: n, user: '@' + u, roles: TG_ROLE_WATCH, note: 'فقط گزارش روزانه می‌گیرد، هیچ اعلان دیگری نه.' }, 'مالک', { why: 'ناظر' });
  return n + ' با نقش ناظر ثبت شد. کافی است در بات Start را بزند تا chat_id خودش پر شود.';
}

/* ---------- تست گزارش روزانه ---------- */

function tgDayTests() {
  const out = [];
  function ok(name, cond) { out.push((cond ? '✅ ' : '❌ ') + name); }
  const wasDry = TG_DRY;
  TG_DRY = true;
  TG_MEM['pol:سقف وقت هفتگی'] = 20;
  TG_MEM['pol:سقف رزرو هفتگی'] = 12;

  const base = {
    from: new Date(), to: new Date(), total: 5, site: 3, bot: 2, other: 0,
    sec: { 'پذیرش': 4, 'مدرسه': 1 }, noOwner: 0, noCall: 0, call: 2, callN: 2,
    booked: 1, free7: 30, taken7: 2, ther: 6, week: 12, weekSite: 8, weekBooked: 3,
    rate7: 25, cover: 2.7, tkNew: 1, tkOpen: 2, tkLate: 0, tkN: 1, tkAvg: 40,
    bugNew: 0, bugOpen: 0, school: 1, money: 0, errs: 0, pending: 0, hookErr: '', worst: '', worstH: 0
  };
  function copy(o) { const c = {}; for (var k in o) c[k] = o[k]; c.sec = o.sec; return c; }

  ok('روز سالم هیچ مداخله‌ای نمی‌خواهد', tgActions_(base).length === 0);

  const late = copy(base); late.noCall = 4; late.worst = 'دیروز'; late.worstH = 30;
  const aLate = tgActions_(late);
  ok('لید معطل به پذیرش وصل می‌شود', aLate.length === 1 && aLate[0].indexOf('پذیرش') > -1);

  const noSite = copy(base); noSite.site = 0; noSite.total = 2;
  ok('صفر لید سایت با سابقهٔ سایت هشدار می‌دهد',
     tgActions_(noSite).filter(function (x) { return x.indexOf('وردپرس') > -1; }).length === 1);

  const dead = copy(base); dead.total = 0;
  ok('روز بی‌لید هشدار می‌دهد',
     tgActions_(dead).filter(function (x) { return x.indexOf('هیچ لیدی') > -1; }).length === 1);

  const thin = copy(base); thin.ther = 2; thin.cover = 0.8;
  const aThin = tgActions_(thin);
  ok('کمبود عرضه به گفت‌وگو با درمانگر وصل می‌شود',
     aThin.filter(function (x) { return x.indexOf('درمانگرها حرف بزنی') > -1; }).length === 1);
  ok('کمبود عرضه سقف را مقصر نمی‌کند',
     aThin.filter(function (x) { return x.indexOf('سقف را بالا ببری') > -1; }).length === 1);

  const broke = copy(base); broke.pending = 40; broke.errs = 3;
  ok('خرابی مسیر پیام و خطا هر دو می‌آیند', tgActions_(broke).length === 2);

  const noOwner = copy(base); noOwner.noOwner = 2;
  ok('لید بی‌مسئول هشدار دارد',
     tgActions_(noOwner).filter(function (x) { return x.indexOf('بدون مسئول') > -1; }).length === 1);

  const rep = tgDayReport_(base);
  ok('گزارش عددهای لید را دارد', rep.indexOf('کل ۵') > -1 && rep.indexOf('سایت ۳') > -1);
  ok('گزارش تفکیک بخش دارد', rep.indexOf('مدرسه') > -1);
  ok('گزارش هفت روز گذشته را هم می‌آورد', rep.indexOf('۷ روز گذشته') > -1);
  ok('گزارش بخش کاری که با توست دارد', rep.indexOf('کاری که با توست') > -1);
  ok('گزارش خط تیرهٔ وسط جمله ندارد', rep.indexOf(' — ') === -1);
  ok('گزارش یک پیام است و نه چند تا', rep.split('🌙').length === 2);
  ok('گزارش زیر حد پیام تلگرام است', rep.length < 4000);

  ok('منوی ناظر دست‌کم سه ردیف دکمه دارد', tgWatchMenu_().keyboard.length >= 3);
  TG_MEM['watch'] = { name: 'یاسر', roles: [TG_ROLE_WATCH] };
  ok('ناظر شناخته می‌شود', !!tgWhoWatch_(1, 'fake_owner'));
  TG_MEM['watch'] = null;
  ok('غیرناظر ناظر نمی‌شود', !tgWhoWatch_(2, 'someoneelse'));

  TG_DRY = wasDry;
  return out.join('\n') + '\n(' + out.filter(function (s) { return s.indexOf('✅') === 0; }).length + ' از ' + out.length + ')';
}

/* یک عدد سیاست را می‌نویسد. اگر کلید نبود، اضافه‌اش می‌کند. */
function tgPolSet(key, value) {
  TG_POL_X = null;
  const sh = tgPolSheet_();
  const last = sh.getLastRow();
  if (last > 1) {
    const v = sh.getRange(2, 1, last - 1, 1).getValues();
    for (var i = 0; i < v.length; i++) {
      if (String(v[i][0]).trim() === key) {
        sh.getRange(i + 2, 2).setValue(value);
        return key + ' شد ' + value;
      }
    }
  }
  sh.appendRow([key, value, '']);
  return key + ' اضافه شد با مقدار ' + value;
}


/* ============================================================
   اطلاعیه‌ها برای درمانگران: در بات، در هاب، و از راه API
   ------------------------------------------------------------
   یک منبع، سه نمایش. متن اطلاعیه فقط در تب «اطلاعیه‌ها» نوشته
   می‌شود؛ کانال و بات و پلتفرم ورژن ۲ همان را می‌خوانند.
   ============================================================ */

const TG_ANN_PAGE = 8;   // چند اطلاعیه در فهرست بات

/* فهرست کوتاه، برای هر نقشی. */
function tgAnnList_(n) {
  const rows = tgAnnRows_().filter(function (a) { return a.status.indexOf('منتشر') > -1; });
  if (!rows.length) return { text: 'هنوز اطلاعیه‌ای منتشر نشده.', rows: [] };
  const last = rows.slice(-(n || TG_ANN_PAGE)).reverse();
  const out = ['📣 <b>اطلاعیه‌ها</b>', ''];
  for (var i = 0; i < last.length; i++) {
    const a = last[i];
    let s = '<b>' + tgAnnNo_(a.num) + '</b>  ' + tgEsc_(a.title || 'بدون عنوان');
    const meta = [];
    if (a.kind) meta.push(tgEsc_(a.kind));
    if (a.date) meta.push(tgEsc_(a.date));
    if (meta.length) s += '\n<i>' + meta.join('  ·  ') + '</i>';
    out.push(s);
  }
  out.push('');
  out.push('شمارهٔ هرکدام را بزنید تا کاملش را ببینید.');
  return { text: out.join('\n'), rows: last };
}

/* کیبورد شماره‌ها، سه‌تایی در هر ردیف. */
function tgAnnKb_(rows) {
  const kb = [];
  let line = [];
  for (var i = 0; i < rows.length; i++) {
    line.push({ text: tgAnnNo_(rows[i].num), callback_data: 'ann:' + rows[i].num });
    if (line.length === 3) { kb.push(line); line = []; }
  }
  if (line.length) kb.push(line);
  return { inline_keyboard: kb };
}

/* یک اطلاعیه، کامل. اگر کارت داشته باشد با عکس می‌رود.
   ستون «لینک تصویر» هم URL عمومی را قبول می‌کند و هم file_id تلگرام را. */
function tgAnnOpen_(chat, num) {
  const rows = tgAnnRows_();
  let a = null;
  for (var i = 0; i < rows.length; i++) if (rows[i].num === Number(num)) a = rows[i];
  if (!a) return tgSend_(chat, 'اطلاعیهٔ ' + tgAnnNo_(num) + ' پیدا نشد.');

  const parts = [tgAnnText_(a)];
  if (a.link) parts.push('<a href="' + a.link + '">دیدن در کانال</a>');
  const txt = parts.join('\n\n');

  if (a.image) {
    const r = tgApi_('sendPhoto', { chat_id: chat, photo: a.image, caption: txt, parse_mode: 'HTML' });
    if (r && r.ok) { if (a.pdf) tgAnnDoc_(chat, a); return; }
  }
  tgSend_(chat, txt);
  if (a.pdf) tgAnnDoc_(chat, a);
}

function tgAnnDoc_(chat, a) {
  tgApi_('sendDocument', {
    chat_id: chat, document: a.pdf,
    caption: 'پیوست اطلاعیهٔ ' + tgAnnNo_(a.num), parse_mode: 'HTML'
  });
}

/* دکمهٔ «📣 اطلاعیه‌ها» در هر منویی. */
function tgAnnShow_(chat, menu) {
  const r = tgAnnList_(TG_ANN_PAGE);
  if (!r.rows.length) return tgSend_(chat, r.text, menu || null);
  tgSend_(chat, r.text, tgAnnKb_(r.rows));
}

/* ---------- گرفتن file_id از فوروارد ---------- */

/* وقتی کسی یک پست کانال را برای بات فوروارد می‌کند، شناسهٔ فایل‌هایش را
   برمی‌گرداند. همین شناسه در ستون «لینک تصویر» یا «پیوست PDF» می‌نشیند و
   بات دفعهٔ بعد بدون هیچ URL عمومی همان فایل را می‌فرستد. */
function tgFileIds_(chat, m) {
  const ids = [];
  if (m.photo && m.photo.length) ids.push(['تصویر', m.photo[m.photo.length - 1].file_id]);
  if (m.document && m.document.file_id) ids.push([m.document.file_name || 'فایل', m.document.file_id]);
  if (!ids.length) return false;
  const L = ['🔖 <b>شناسهٔ فایل</b>', ''];
  for (var i = 0; i < ids.length; i++) {
    L.push(tgEsc_(ids[i][0]) + ':');
    L.push('<code>' + tgEsc_(ids[i][1]) + '</code>');
    L.push('');
  }
  L.push('این شناسه را در ستون «لینک تصویر» یا «پیوست PDF» تب اطلاعیه‌ها بگذارید.');
  tgSend_(chat, L.join('\n'));
  return true;
}

/* ---------- مرتب کردن تب اطلاعیه‌ها در هاب ---------- */

function tgAnnFormat() {
  const sh = tgAnnSheet_();
  const head = TG_ANN_HEAD.concat(TG_ANN_EXTRA);
  const w = [70, 130, 120, 300, 420, 200, 110, 120, 220, 90, 140, 200, 110, 120];
  for (var c = 0; c < w.length; c++) sh.setColumnWidth(c + 1, w[c]);
  sh.setFrozenRows(1);
  sh.setFrozenColumns(1);

  const last = Math.max(sh.getLastRow(), 2);
  sh.getRange(1, 1, last, head.length)
    .setVerticalAlignment('top').setHorizontalAlignment('right').setFontFamily('Vazirmatn');
  sh.getRange(1, 1, 1, head.length).setFontWeight('bold').setBackground('#faeced')
    .setHorizontalAlignment('center');
  sh.getRange(2, 1, last - 1, 1).setHorizontalAlignment('center');
  sh.getRange(2, 4, last - 1, 1).setFontWeight('bold');
  sh.getRange(2, 5, last - 1, 1).setWrap(true).setFontColor('#6b6b6b');

  const st = sh.getRange(2, 7, Math.max(1, last - 1), 1);
  sh.setConditionalFormatRules([
    SpreadsheetApp.newConditionalFormatRule()
      .whenTextContains('منتشر').setBackground('#e8f5e9').setRanges([st]).build(),
    SpreadsheetApp.newConditionalFormatRule()
      .whenTextContains('آماده').setBackground('#fff8e1').setRanges([st]).build(),
    SpreadsheetApp.newConditionalFormatRule()
      .whenTextContains('پیش‌نویس').setBackground('#eceff1').setRanges([st]).build()
  ]);

  for (var r = 2; r <= last; r++) sh.setRowHeight(r, 96);
  return 'تب «' + TG_ANN_TAB + '» مرتب شد: ' + tgFa_(last - 1) + ' سطر.';
}

/* ---------- API برای پلتفرم ورژن ۲ ---------- */

/* ?api=ann  فهرست اطلاعیه‌های منتشرشده به صورت JSON.
   ورژن ۲ همین را می‌خواند تا لازم نباشد متن جای دیگری کپی شود.
   ?aud=دانشجویان  فقط اطلاعیه‌های همان مخاطب و اطلاعیه‌های «همه». */
function tgApiAnn_(p) {
  const only = String(p.aud || '').trim();
  /* v170.9 (امنیت): بی initData امضاشدهٔ کسی که نقشی در تجربه دارد، فقط اطلاعیه‌های همگانی (مخاطب خالی یا «همه») */
  var who = null; try { who = tgVerifyInitData_(p.initData); } catch (eW) {}
  var team = false; try { team = !!(who && who.id && tgRolesOf_(who.id, '').roles.length); } catch (eR) {}
  const rows = tgAnnRows_().filter(function (a) { return a.status.indexOf('منتشر') > -1 && (team || !a.aud || a.aud.indexOf('همه') > -1); });
  const out = [];
  for (var i = rows.length - 1; i >= 0; i--) {
    const a = rows[i];
    if (only && a.aud && a.aud.indexOf(only) < 0 && a.aud.indexOf('همه') < 0) continue;
    out.push({
      num: a.num, code: a.code || tgAnnCode_(a.num),
      date: a.date, kind: a.kind, audience: a.aud,
      title: a.title, body: a.body,
      image: a.image, pdf: a.pdf,
      link: a.link, replaces: a.replaces || ''
    });
  }
  return { ok: true, count: out.length, items: out };
}


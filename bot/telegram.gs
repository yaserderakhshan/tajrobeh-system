}
/* دستهٔ رویداد یک آپدیت تلگرام؛ متن آزاد فقط «text» ثبت می‌شود */
function tgEvBotOf_(u) {
  if (!u) return null;
  if (u.callback_query) {
    var d = String(u.callback_query.data || '');
    var parts = d.split(':');
    return { e: 'btn:' + parts[0].slice(0, 12), d: (parts[1] || '').slice(0, 20), c: (u.callback_query.from || {}).id };
  }
  var m = u.message;
  if (!m || !m.chat || m.chat.type !== 'private') return null;
  var t = String(m.text || '').trim(), c = m.chat.id;
  if (t.indexOf('/start') === 0) return { e: 'start', d: (t.split(/\s+/)[1] || '').slice(0, 40), c: c };
  if (t.indexOf('/') === 0) return { e: 'cmd', d: t.split(/[\s@]/)[0].slice(0, 20), c: c };
  if (m.contact) return { e: 'contact', d: '', c: c };
  if (m.voice || m.audio) return { e: 'voice', d: '', c: c };
  if (m.photo || m.document) return { e: 'file', d: '', c: c };
  if (!t) return null;
  var btn = false;
  try { btn = tgIsBtnLike_(t); } catch (e) {}
  return btn ? { e: 'menu', d: t.slice(0, 30), c: c } : { e: 'text', d: '', c: c };
}
function tgEvBot_(u) {
  var x = tgEvBotOf_(u);
  if (x) tgEv_('bot', x.e, x.d, x.c);
}

  if (TG_DRY) return TG_MEM['mythera'] || '';
  try {
    var r = tgFindLead_(chat);
    if (r < 0) return '';
    return String(tgSS_().getSheetByName(TG_LEADS).getRange(r, 22).getValue() || '').trim();
  } catch (e) { return ''; }
}

function tgSessStart_(chat) {
  var name = tgMyTherapist_(chat);
  if (!name) return tgSend_(chat, 'برای رزرو جلسهٔ درمان، اول باید درمانگرتان مشخص باشد.\nاز «🍓 شروع درمان» یک وقت معارفه بگیرید.', tgMenu_());
  var free = tgSessFree_(name);
  if (!free.length) return tgSend_(chat, 'الان وقت آزادی از ' + tgEsc_(name) + ' برای جلسهٔ درمان ثبت نیست.\nبه پذیرش بگویید تا هماهنگ کند.', tgMenu_());
  var z = tgZoneOf_(tgGetVal_('tz', chat) || 'ir');

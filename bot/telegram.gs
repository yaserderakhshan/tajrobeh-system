function tgReferStart_(chat, code) {
  tgSetVal_('ldr', chat, code);
  return tgSend_(chat, '👥 اسم درمانگر را بنویسید تا کارت ارجاع برایش برود.\nبرای بی‌خیال شدن «انصراف» را بفرستید.');
}

// اسم درمانگر را می‌گیرد؛ یک نفر یعنی ارسال، چند نفر یعنی فهرست انتخاب
function tgReferPick_(chat, uname, text) {
  const code = tgGetVal_('ldr', chat);
  if (!code) return false;
  const t = String(text || '').trim();
  if (!t) return false;
  if (t === 'انصراف' || t === '↩️ بازگشت' || t.indexOf('/') === 0 || tgIsBtnLike_(t)) {
    tgDel_('ldr', chat);
    return false;
  }
  const hit = tgTherFind_(t, false) || [];
  if (!hit.length) {
    tgSend_(chat, 'کسی با این اسم در تب درمانگران پیدا نشد. اسم را کامل‌تر بنویسید یا «انصراف».');
    return true;
  }
  if (hit.length === 1) {
    tgDel_('ldr', chat);
    tgReferSend_(chat, code, hit[0].name, uname);
    return true;
  }
  const rows = [];
  for (var i = 0; i < hit.length && i < TG_REF_MAX; i++) {
    rows.push([{ text: hit[i].name, callback_data: 'rf:p:' + code + ':' + hit[i].name }]);
  }
  rows.push([{ text: '↩️ بی‌خیال', callback_data: 'rf:x:' + code }]);
  tgSend_(chat, 'کدامشان؟', { inline_keyboard: rows });
  return true;
}

function tgReferSend_(chat, code, therName, uname, force) {
  const row = tgLeadByCode_(code);
  if (row < 2) return tgSend_(chat, 'این لید پیدا نشد.');
  const l = tgLeadRead_(row);
  if (!l) return tgSend_(chat, 'این لید خوانده نشد.');
  if (!force) { var kk = tgLeadKind_(row), gd = tgReferGuard_(therName, kk[0], kk[1]); if (gd) return tgReferWarn_(chat, code, therName, gd); }
  const who = tgWhoDesk_(chat, uname);
  const me = (who && who.name) ? who.name : 'پذیرش';
  const today = Utilities.formatDate(new Date(), TG_TZ, 'yyyy-MM-dd');

  const chR = { 'تاریخ ارجاع': today };
  if (!l.ref1 || tgNormSt_(l.ref1) === tgNormSt_(therName)) chR['درمانگر پیشنهادی ۱'] = therName;
  else if (!l.ref2 || tgNormSt_(l.ref2) === tgNormSt_(therName)) chR['درمانگر پیشنهادی ۲'] = therName;
  else chR['درمانگر پیشنهادی ۳'] = therName;
  if (!l.closed && l.status !== TG_ST.BOOKED && l.status !== TG_ST.HELD) chR['وضعیت'] = TG_ST.REF;
  tgLeadSet_(row, chR, me, 'تلگرام', 'ارجاع به ' + therName);

  const th = tgTherChatByName_(therName);
  if (!th) {
    tgSend_(chat, '📝 ارجاع در شیت ثبت شد، ولی این درمانگر هنوز به بات وصل نیست. هماهنگی دستی لازم است.');
    return null;
  }
  var t = '🗓 <b>یک مراجع تازه برای معارفه</b>\n\n';
  t += tgEsc_(l.name || 'بدون نام');
  if (l.region) t += ' · ' + tgEsc_(l.region);
  if (l.first) t += '\n\n<i>' + tgEsc_(String(l.first).slice(0, 220)) + '</i>';
  t += '\n\nظرفیتش را دارید؟';
  tgSend_(th, t, { inline_keyboard: [[
    { text: '✅ می‌توانم', callback_data: 'rf:ok:' + code },
    { text: '🙏 الان نه', callback_data: 'rf:no:' + code }
  ]] });
  return tgSend_(chat, '✅ کارت ارجاع برای ' + tgEsc_(therName) + ' رفت. جوابش که آمد خبر می‌دهم.');
}

function tgOnRefer_(cq, rest) {
  const chat = cq.message.chat.id;
  const p = String(rest || '').split(':');
  const act = p[0] || '';
  const code = p[1] || '';
  const arg = p.slice(2).join(':');
  const row = tgLeadByCode_(code);
  if (row < 2) return tgSend_(chat, 'این لید پیدا نشد.');

  if (act === 'x') { tgDel_('ldr', chat); return tgSend_(chat, 'باشد، ارجاع انجام نشد.'); }

  if (act === 'f') { tgDel_('ldr', chat); return tgReferSend_(chat, code, arg, cq.from && cq.from.username, true); }

  if (act === 'p') {
    tgDel_('ldr', chat);
    return tgReferSend_(chat, code, arg, cq.from && cq.from.username);
  }

  // از این‌جا به بعد جواب خود درمانگر است
  const l = tgLeadRead_(row);
  const owner = l ? tgDeskByName_(l.owner) : null;
  const me = (typeof tgTherByChat_ === 'function') ? (tgTherByChat_(chat) || null) : null;
  const myName = (me && me.name) ? me.name : 'درمانگر';

  if (act === 'ok') {
    tgLeadSet_(row, { 'درمانگر معارفه': myName }, myName, 'تلگرام', 'پذیرفتن ارجاع');
    tgLeadEv_({ code: code, row: row, actor: myName, channel: 'تلگرام', what: 'پاسخ ارجاع', to: 'می‌توانم' });
    if (owner && owner.chat) tgSend_(owner.chat, '✅ ارجاع ' + tgEsc_(code) + ' پذیرفته شد: ' + tgEsc_(myName) + '\nوقت معارفه را هماهنگ کنید.');
    return tgSend_(chat, 'ممنون. پذیرش وقت را هماهنگ می‌کند و خبرش به شما می‌رسد.');
  }

  if (act === 'no') {
    tgLeadEv_({ code: code, row: row, actor: myName, channel: 'تلگرام', what: 'پاسخ ارجاع', to: 'الان نه' });
    if (owner && owner.chat) tgSend_(owner.chat, '🙏 ارجاع ' + tgEsc_(code) + ' را ' + tgEsc_(myName) + ' نپذیرفت. لید باز مانده و می‌شود به کس دیگری داد.');
    return tgSend_(chat, 'ممنون که خبر دادید. به پذیرش گفتم.');
  }

  return null;
}

function tgReferTests() {
  var out = [], pass = 0, fail = 0;
  function ok(n, c) { c ? pass++ : fail++; out.push((c ? '✅ ' : '❌ ') + n); }
  const wasDry = TG_DRY, wasLead = TG_DRY_LEAD, wasOut = TG_OUTBOX;
  TG_DRY = true;
  try {
    TG_DRY_LEAD = {
      row: 7, code: 'L-1042', name: 'آزمایشی', phone: '09120000000',
      src: 'سایت', channel: 'سایت', region: 'خارج از ایران',
      first: 'دنبال زوج‌درمانی هستم', status: 'جدید', owner: 'پذیرشی', result: '', memo: '',
      booked: false, closed: false, touched: false, idle: 0, age: 60, stage: 'first'
    };
    TG_OUTBOX = [];
    tgReferStart_(55, 'L-1042');
    ok('شروع ارجاع فلگ می‌گذارد و می‌پرسد', tgGetVal_('ldr', 55) === 'L-1042' && TG_OUTBOX.length === 1);
    ok('متن پرسش اسم درمانگر را می‌خواهد', TG_OUTBOX[0].text.indexOf('اسم درمانگر') > -1);

    TG_OUTBOX = [];
    var r = tgReferPick_(55, '@desk_lead', 'انصراف');
    ok('انصراف حالت ارجاع را می‌بندد', r === false && !tgGetVal_('ldr', 55));

    TG_OUTBOX = [];
    tgSetVal_('ldr', 55, 'L-1042');
    var r2 = tgReferPick_(55, '@desk_lead', '/start');
    ok('دستور اسلش حالت ارجاع را می‌شکند', r2 === false && !tgGetVal_('ldr', 55));

    TG_OUTBOX = [];
    var r3 = tgReferPick_(55, '@desk_lead', 'هرچی');
    ok('بدون فلگ، متن آزاد بلعیده نمی‌شود', r3 === false);

    ok('ستون‌های ارجاع در فهرست مجاز نوشتن هستند',
       TG_LEAD_FIELDS.indexOf('درمانگر پیشنهادی ۱') > -1 &&
       TG_LEAD_FIELDS.indexOf('درمانگر معارفه') > -1 &&
       TG_LEAD_FIELDS.indexOf('تاریخ ارجاع') > -1);
    ok('ldr در کلیدهای کش هر پیام هست', TG_MEMO_KEYS.indexOf('ldr') > -1);
    ok('کد ارجاع زیر ۶۴ بایت است (بایت، نه نویسه)', tgCbBytes_('rf:ok:L-1042') <= 64 && tgCbBytes_(tgCbShort_('rf:p:L-1042:پذیرشی زرین‌مهر')) <= 64);
  } catch (e) {
    fail++; out.push('❌ استثنا: ' + e);
  }
  TG_DRY = wasDry; TG_DRY_LEAD = wasLead; TG_OUTBOX = wasOut;
  return { pass: pass, fail: fail, text: out.join('\n') };
}

/* ============================================================
   چرخهٔ واتس‌اپ (v95): پیام ورودی واتس‌اپ وارد همان چرخهٔ لید
   می‌شود و پذیرش از داخل تلگرام جواب می‌دهد.
   توکن و شناسهٔ شماره فقط در Script Properties می‌نشینند.
   ============================================================ */

const TG_WA_CH   = 'واتس‌اپ';
const TG_WA_HELLO =
  'سلام. پیام شما به مرکز تجربه زندگی رسید.\n' +
  'همکاران پذیرش در ساعت کاری، ۹:۳۰ تا ۱۷:۳۰ به وقت تهران، همین‌جا جواب می‌دهند.\n\n' +
  'اگر ترجیح می‌دهید در تلگرام ادامه بدهید:\nhttps://t.me/tajrobehlife_bot';

/* ---------- تنظیمات و ارسال ---------- */

function tgWaCfg_() {
  const c = CacheService.getScriptCache();
  var v = c.get('wacfg');
  if (v === null) {
    const p = PropertiesService.getScriptProperties();
    v = JSON.stringify({
      t: p.getProperty('WHATSAPP_TOKEN') || '',
      id: p.getProperty('WHATSAPP_PHONE_ID') || ''
    });
    c.put('wacfg', v, 21600);
  }
  try { return JSON.parse(v); } catch (e) { return { t: '', id: '' }; }
}

function tgWaReady_() {
  const c = tgWaCfg_();
  return !!(c.t && c.id);
}

function tgWaDigits_(p) { return phoneDigits_(p); }   /* v170.19 */

// خروجی: شناسهٔ پیام در صورت موفقیت، رشتهٔ خالی در صورت شکست
function tgWaSend_(to, text) {
  const num = tgWaDigits_(to);
  const body = String(text || '').slice(0, 4000);
  if (!num || !body) return '';
  if (TG_DRY) { TG_OUTBOX.push({ kind: 'wa', to: num, text: body }); return 'dry'; }
  const cfg = tgWaCfg_();
  if (!cfg.t || !cfg.id) { try { tgErr_('واتس‌اپ: توکن یا شناسهٔ شماره تنظیم نشده'); } catch (e) {} return ''; }
  try {
    const r = UrlFetchApp.fetch('https://graph.facebook.com/v21.0/' + cfg.id + '/messages', {
      method: 'post',
      contentType: 'application/json',
      headers: { Authorization: 'Bearer ' + cfg.t },
      muteHttpExceptions: true,
      payload: JSON.stringify({
        messaging_product: 'whatsapp',
        to: num,
        type: 'text',
        text: { preview_url: false, body: body }
      })
    });
    const code = r.getResponseCode();
    const txt = r.getContentText();
    if (code >= 300) { try { tgErr_('واتس‌اپ ' + code + ': ' + txt.slice(0, 300)); } catch (e) {} return ''; }
    try { return JSON.parse(txt).messages[0].id || 'ok'; } catch (e) { return 'ok'; }
  } catch (e) {
    try { tgErr_('tgWaSend_: ' + e); } catch (e2) {}
    return '';
  }
}

/* ---------- ورودی ---------- */

// متا هر پیام را چند بار می‌فرستد تا ۲۰۰ بگیرد
function tgWaSeen_(mid) {
  if (TG_DRY || !mid) return false;
  const c = CacheService.getScriptCache();
  const k = 'wam' + String(mid).slice(-40);
  if (c.get(k)) return true;
  c.put(k, '1', 21600);
  return false;
}

function tgWaOn_(body) {
  const entries = (body && body.entry) || [];
  for (var i = 0; i < entries.length; i++) {
    const changes = entries[i].changes || [];
    for (var j = 0; j < changes.length; j++) {
      const v = changes[j].value || {};
      const msgs = v.messages || [];
      if (!msgs.length) continue;
      const contacts = v.contacts || [];
      const nm = (contacts[0] && contacts[0].profile && contacts[0].profile.name) || '';
      const ours = (v.metadata && v.metadata.display_phone_number) || '';
      for (var k = 0; k < msgs.length; k++) {
        try { tgWaMsg_(msgs[k], nm, ours); }
        catch (e) { try { tgErr_('tgWaMsg_: ' + e); } catch (e2) {} }
      }
    }
  }
}

function tgWaMsg_(m, nm, ours) {
  const mid = m.id || '';
  if (tgWaSeen_(mid)) return;
  const from = tgWaDigits_(m.from);
  if (!from) return;
  const text = extractText_(m);
  const when = m.timestamp ? new Date(Number(m.timestamp) * 1000) : new Date();

  // بایگانی خام، جدا از چرخهٔ لید
  if (!TG_DRY) {
    try { appendRow_(TAB_INBOX, [fmtDate_(when), fmtTime_(when), ours, nm, from, m.type || '', text, mid]); }
    catch (e) { try { tgErr_('بایگانی واتس‌اپ: ' + e); } catch (e2) {} }
  }

  var row = tgLeadByPhone_(from);
  var fresh = false;
  if (row < 2) { row = tgWaNewLead_(from, nm, text, when, ours); fresh = true; }
  if (!row || row < 2) return;

  const code = tgLeadCode_(row);
  tgLeadEv_({ code: code, row: row, actor: nm || from, channel: TG_WA_CH, what: 'پیام واتس‌اپ', to: String(text).slice(0, 120) });
  if (!fresh) {
    /* v170.18: پیام واتس‌اپ پس از ۶ ساعت سکوت یعنی برگشت مراجع (tgLeadReturn_)؛ پیام‌های پشت‌سرهم یک گفت‌وگو لید را ریست نمی‌کنند */
    var rk = 'warc' + code, cc = TG_DRY ? null : CacheService.getScriptCache();
    if (TG_DRY ? !TG_MEM[rk] : !cc.get(rk)) { tgLeadReturn_(row, { via: 'واتس‌اپ', msg: text, phone: '+' + from }); if (TG_DRY) TG_MEM[rk] = 1; else cc.put(rk, '1', 21600); }
    else tgLeadNote_(row, 'واتس‌اپ: ' + String(text).slice(0, 200), nm || from);
  }

  const head = (fresh ? '🟢 <b>مراجع تازه در واتس‌اپ</b>' : '💬 <b>پیام تازه در واتس‌اپ</b>') +
               '\n\n' + tgEsc_(String(text).slice(0, 400));
  tgWaTell_(row, head);

  if (fresh) tgWaSend_(from, TG_WA_HELLO);
}

function tgWaNewLead_(from, nm, text, when, ours) {
  if (TG_DRY) { TG_OUTBOX.push({ kind: 'walead', from: from, name: nm, text: text }); return TG_DRY_LEAD ? TG_DRY_LEAD.row : 7; }
  const lock = LockService.getScriptLock();
  try { lock.waitLock(20000); } catch (e) { return -1; }
  TG_LOCK_HELD = true;   /* v166.13: tgLeadCode_ قفل را رها نکند */
  try {
    /* v170.20: از همان نویسندهٔ واحد (tgAppendLead_)، تا قلاب‌های نوع لید، مهلت و اقدام بعدی اجرا شوند */
    var row = tgAppendLead_({ when: when, source: 'WhatsApp ' + ours, name: nm, channel: 'WhatsApp', phone: '+' + from, region: tgRegion_(from),
      firstText: text, status: 'جدید', extra: { 'کانال ترجیحی': TG_WA_CH } });
    return typeof row === 'number' ? row : -1;
  } finally {
    TG_LOCK_HELD = false;
    try { lock.releaseLock(); } catch (e) {}
  }
}

// خبر به مسئول لید، و اگر مسئولی نبود به پذیرش
function tgWaTell_(row, text) {
  const chats = [];
  try {
    const l = tgLeadRead_(row);
    const owner = l ? tgDeskByName_(l.owner) : null;
    if (owner && owner.chat) chats.push(owner.chat);
  } catch (e) {}
  if (!chats.length) {
    try {
      const rows = TG_DRY ? (TG_MEM['desk'] || []) : tgDeskRows_();
      rows.forEach(function (r) { if (r.chat && chats.length < 2) chats.push(r.chat); });
    } catch (e) {}
  }
  for (var i = 0; i < chats.length; i++) {
    tgSend_(chats[i], text);
    tgLeadCardSend_(chats[i], row);
  }
  return chats.length;
}

/* ---------- پاسخ پذیرش از داخل تلگرام ---------- */

function tgWaOpen_(l) {
  if (!l || !l.phone) return false;
  if (!TG_DRY && !tgWaReady_()) return false;
  const s = String((l.channel || '') + ' ' + (l.src || ''));
  return s.indexOf('واتس') > -1 || s.toLowerCase().indexOf('whatsapp') > -1;
}

function tgOnWa_(cq, rest) {
  const chat = cq.message.chat.id;
  const p = String(rest || '').split(':');
  if (p[0] === 'x') { tgDel_('war', chat); return tgSend_(chat, 'باشد، پاسخی نرفت.'); }
  if (p[0] !== 'r') return null;
  /* v166.8: پاسخ واتس‌اپ از طرف مرکز فقط برای تیم پذیرش (پیش از این هر کسی با کال‌بک ساختگی wa:r:<کد لید> می‌توانست) */
  if (!tgWhoDesk_(chat, (cq.from && cq.from.username) || '')) return null;
  const code = p[1] || '';
  if (tgLeadByCode_(code) < 2) return tgSend_(chat, 'این لید پیدا نشد.');
  tgSetVal_('war', chat, code);
  return tgSend_(chat, '✉ متن پاسخ واتس‌اپ را بنویسید.\nبرای بی‌خیال شدن «انصراف» را بفرستید.');
}

function tgWaAnswer_(chat, uname, text) {
  const code = tgGetVal_('war', chat);
  if (!code) return false;
  const t = String(text || '').trim();
  if (!t) return false;
  if (t === 'انصراف' || t === '↩️ بازگشت' || t.indexOf('/') === 0 || tgIsBtnLike_(t)) {
    tgDel_('war', chat);
    return false;
  }
  tgDel_('war', chat);
  const row = tgLeadByCode_(code);
  if (row < 2) { tgSend_(chat, 'این لید پیدا نشد.'); return true; }
  const l = tgLeadRead_(row);
  const to = tgWaDigits_(l && l.phone);
  if (!to) { tgSend_(chat, 'شمارهٔ این لید خوانده نشد.'); return true; }
  const who = tgWhoDesk_(chat, uname);
  const me = (who && who.name) ? who.name : 'پذیرش';
  const id = tgWaSend_(to, t);
  if (!id) {
    tgSend_(chat, '❌ پیام نرفت.\nیا توکن واتس‌اپ تنظیم نیست، یا پنجرهٔ ۲۴ ساعتهٔ متا بسته شده. در حالت دوم مراجع باید اول خودش پیام بدهد.');
    return true;
  }
  tgLeadEv_({ code: code, row: row, actor: me, channel: TG_WA_CH, what: 'پاسخ واتس‌اپ', to: t.slice(0, 120) });
  tgLeadSet_(row, { 'آخرین تماس': Utilities.formatDate(new Date(), TG_TZ, 'yyyy-MM-dd') }, me, TG_WA_CH, 'پاسخ واتس‌اپ');
  tgSend_(chat, '✅ پاسخ در واتس‌اپ فرستاده شد.');
  tgLeadCardSend_(chat, row);
  return true;
}

/* ---------- تست خشک ---------- */

function tgWaTests() {
  var out = [], pass = 0, fail = 0;
  function ok(n, c) { c ? pass++ : fail++; out.push((c ? '✅ ' : '❌ ') + n); }
  const wasDry = TG_DRY, wasLead = TG_DRY_LEAD, wasOut = TG_OUTBOX, wasRow = TG_DRY_LEADROW;
  TG_DRY = true;
  try {
    TG_DRY_LEAD = {
      row: 7, code: 'L-1042', name: 'آزمایشی', phone: '09120000000',
      src: 'WhatsApp +90 535 513 69 50', channel: 'WhatsApp', region: 'خارج از ایران',
      first: 'سلام', status: 'جدید', owner: 'پذیرشی', result: '', memo: '',
      booked: false, closed: false, touched: false, idle: 0, age: 30, stage: 'first'
    };

    ok('شمارهٔ فارسی به رقم لاتین تبدیل می‌شود', tgWaDigits_('۰۹۱۲۰۰۰۰۰۰۰') === '09120000000');
    ok('علامت و فاصله از شماره پاک می‌شود', tgWaDigits_('+90 535 513 69 50') === '905355136950');

    TG_OUTBOX = [];
    var id = tgWaSend_('905355136950', 'سلام');
    ok('ارسال خشک در صندوق می‌نشیند', id === 'dry' && TG_OUTBOX.length === 1 && TG_OUTBOX[0].kind === 'wa');
    ok('شمارهٔ خالی ارسال نمی‌شود', tgWaSend_('', 'x') === '');
    ok('متن خالی ارسال نمی‌شود', tgWaSend_('905355136950', '') === '');

    ok('لید واتس‌اپی دکمهٔ پاسخ می‌گیرد', tgWaOpen_(TG_DRY_LEAD) === true);
    ok('لید سایتی دکمهٔ پاسخ نمی‌گیرد', tgWaOpen_({ phone: '0912', channel: 'سایت', src: 'فرم سایت' }) === false);
    ok('لید بدون شماره دکمهٔ پاسخ نمی‌گیرد', tgWaOpen_({ phone: '', channel: 'WhatsApp', src: 'WhatsApp' }) === false);


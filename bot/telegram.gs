  var order = ['چهارشنبه', 'پنجشنبه', 'یکشنبه', 'دوشنبه', 'سه‌شنبه', 'جمعه', 'شنبه'];
  for (var i = 0; i < order.length; i++) if (s.indexOf(order[i].replace(/‌/g, '')) > -1) return order[i];

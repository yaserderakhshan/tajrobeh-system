    ok('فهرست: حالا نام سوپروایزر هست', tgPqApiList_(800).qs.some(function (q) { return q.k === 'supervisor'; }));
    ok('ذخیره: متن کوتاه رد می‌شود', tgPqApiSave_(800, { k: 'method', v: 'کوتاه' }).ok === false);
    ok('ذخیره: سال میلادی به شمسی', tgPqApiSave_(800, { k: 'since', v: '2019' }).ok === true && TG_MEM['pqrows']['ther:' + tgNorm_('درمانگر آزمایشی')].since === '1398');
    ok('ذخیره: چندگزینه‌ای', tgPqApiSave_(800, { k: 'langs', v: 'فارسی، انگلیسی' }).ok === true);
    ok('ذخیره: متن آزاد فقط در چندگزینه‌ای بازِ رویکرد', tgPqApiSave_(800, { k: 'approach', v: 'روابط ابژه، روان‌درمانی بین‌فردی' }).ok === true && tgPqApiSave_(800, { k: 'langs', v: 'فارسی، ژاپنی' }).ok === false);
    ok('ذخیره: عکس از مینی‌اپ file_id می‌گیرد', tgPqApiSave_(800, { k: 'photo', b64: 'AAAA' }).ok === true && TG_MEM['pqrows']['ther:' + tgNorm_('درمانگر آزمایشی')].photo === 'tg:photo:FID-photo');
    ok('ذخیره: ویس فقط در بات', tgPqApiSave_(800, { k: 'voice', v: 'x' }).ok === false);
    ok('ردشدن: اجازه لازم است', tgPqApiSave_(800, { k: 'consent', skip: 1 }).ok === false);
    ok('ردشدن: لینک‌ها', tgPqApiSave_(800, { k: 'links', skip: 1 }).ok === true && TG_MEM['pqrows']['ther:' + tgNorm_('درمانگر آزمایشی')].skipped.indexOf('links') > -1);
    ok('کلید ناشناس', tgPqApiSave_(800, { k: 'uni', v: 'تهران' }).ok === false);
    ok('زمان پاسخ ثبت می‌شود', Number(TG_MEM['pqrows']['ther:' + tgNorm_('درمانگر آزمایشی')].stamp) > 0);
    var d = tgPqApiDone_(800);
    ok('پایان: درصد و متن', d.ok && d.pct > 0 && d.done.indexOf('<') < 0);
    TG_DRY_THER = null; TG_MEM['person'] = null;
    ok('ناشناس: noid', tgPqApiList_(801).error === 'noid');
  } catch (e) { fail++; out.push('❌ استثنا: ' + e + ' ' + (e.stack || '')); }
  TG_DRY = wasDry; TG_DRY_THER = wasTher; TG_OUTBOX = []; TG_MEM = {};
  Logger.log('پروفایل در مینی‌اپ: ' + pass + ' قبول · ' + fail + ' مردود\n' + out.filter(function (x) { return x.indexOf('❌') === 0; }).join('\n'));
  return { pass: pass, fail: fail, text: out.join('\n') };

/* v166.22: هر رمز و توکن پیش از ثبت در «خطاها» یا لاگ پوشانده می‌شود. خطای شبکهٔ UrlFetch (مثل Address unavailable)
   آدرس کامل https://api.telegram.org/bot<رمز>/… را در متن خطا می‌آورد. */
function tgSecretMask_(s) {
  return String(s == null ? '' : s)
    .replace(/bot\d{5,}:[A-Za-z0-9_-]{20,}/g, 'bot<رمز>')
    .replace(/\b\d{6,12}:AA[A-Za-z0-9_-]{20,}/g, '<رمز>')
    .replace(/([?&#](?:key|api_key|apikey|token|access_token|secret|sig|signature|password|pass)=)[^&#\s'"]+/gi, '$1<رمز>')
    .replace(/(Bearer\s+)[A-Za-z0-9._~+\/-]{16,}=*/gi, '$1<رمز>')
    .replace(/\bAIza[0-9A-Za-z_-]{30,}/g, '<رمز>')
    .replace(/\bya29\.[0-9A-Za-z_-]{20,}/g, '<رمز>')
    .replace(/\b(?:sk|gsk|pk)-[A-Za-z0-9_-]{20,}/g, '<رمز>')
    .replace(/\btjk_[A-Za-z0-9]{16,}/g, '<رمز>')   /* v167: کلید درگاه API */
    .replace(/("(?:key|token|secret|api_key)"\s*:\s*")[^"]{8,}"/gi, '$1<رمز>"');
}
function tgErr_(where, err, ref) {
  var w = String(where || ''), msg;
  if (err === undefined) { var p = w.indexOf(': '); if (p > 0) { msg = w.slice(p + 2); w = w.slice(0, p); } else { msg = w; w = ''; } }
  else msg = (err && err.stack) ? String(err.message || err) : String(err);
  w = tgSecretMask_(w); msg = tgSecretMask_(msg); if (ref) ref = tgSecretMask_(ref);
  try { console.error((w ? w + ': ' : '') + msg + (ref ? ' [' + ref + ']' : '')); } catch (e0) {}
  if (TG_DRY) { (TG_MEM['errs'] = TG_MEM['errs'] || []).push({ where: w, msg: msg, ref: ref || '' }); return 'E-dry'; }
  try {
    var day = Utilities.formatDate(new Date(), TG_TZ, 'yyyy-MM-dd');
    var key = 'err:' + day + ':' + tgHash_(w + '|' + String(msg).slice(0, 120));
    var c = CacheService.getScriptCache(), hit = c.get(key);
    var sh = tgErrSheet_(); if (!sh) return '';
    if (hit) {
      var row = Number(hit);
      var cur = Number(sh.getRange(row, 6).getValue() || 1);
      sh.getRange(row, 6).setValue(cur + 1);
      return String(sh.getRange(row, 1).getValue() || '');
    }
    var last = sh.getLastRow(), seq = 1000;
    if (last >= 2) { var m = String(sh.getRange(last, 1).getValue() || '').match(/E-(\d+)/); if (m) seq = Number(m[1]); }
    var id = 'E-' + (seq + 1);
    sh.appendRow([id, new Date(), w, ref || '', String(msg).slice(0, TG_ERR_MAX), 1, 'تازه']);
    c.put(key, String(sh.getLastRow()), 21600);
    return id;
  } catch (e) { return ''; }
}
function tgHash_(s) {
  var h = 0; s = String(s || '');
  for (var i = 0; i < s.length; i++) { h = ((h << 5) - h + s.charCodeAt(i)) | 0; }
  return (h >>> 0).toString(36);
}
/* یک بار (v166.22، با تأیید یاسر از مسیر ci: 'once'): رمزهای سطرهای قبلی تب «خطاها» (هاب پیام) و «Errors» (هاب تجربه)
   پوشانده می‌شود. فقط خانه‌هایی که عوض می‌شوند نوشته می‌شوند. خروجی فقط شمارش است. */
function tgErrScrub() {
  var n = 0, cells = 0;
  function scrub(sh) {
    if (!sh || sh.getLastRow() < 2) return;
    var rg = sh.getRange(2, 1, sh.getLastRow() - 1, sh.getLastColumn()), v = rg.getValues();
    for (var i = 0; i < v.length; i++) {
      var hit = false;
      for (var j = 0; j < v[i].length; j++) {
        if (typeof v[i][j] !== 'string') continue;
        var m = tgSecretMask_(v[i][j]);
        if (m !== v[i][j]) { sh.getRange(i + 2, j + 1).setValue(m); cells++; hit = true; }
      }
      if (hit) n++;
    }
  }
  scrub(tgErrSheet_());
  try { scrub(SpreadsheetApp.openById(SHEET_ID).getSheetByName('Errors')); } catch (e) {}
  return 'سطرهای پاک‌شده: ' + n + ' · خانه: ' + cells;
}
/* یک بار (v166.23، خودکار بعد از انتشار): خانه‌های chat_id که شیت عدد کرده (چند شناسهٔ ادغام‌شده) پیدا می‌شوند.
   فهرست جاها (تب، سطر، نام) فقط در تلگرام به یاسر می‌رود تا دستی درست شود؛ خروجی ci فقط شمارش است.
   خانه‌های سالم متن می‌شوند تا دوباره عدد نشوند. */
function tgChatCellAudit() {
  var found = [], fixed = 0;
  function scan(sh, col, nameCol, label) {
    if (!sh || sh.getLastRow() < 2) return;
    var n = sh.getLastRow() - 1, rg = sh.getRange(2, col, n, 1), v = rg.getValues(), nm = sh.getRange(2, nameCol, n, 1).getValues();
    for (var i = 0; i < n; i++) {
      var x = v[i][0];
      if (typeof x === 'number' && !(Number.isSafeInteger(x) && Math.abs(x) < 1e15)) found.push(label + ' · سطر ' + (i + 2) + ' · ' + String(nm[i][0] || ''));
      else if (typeof x === 'number' && x) { tgChatCellSet_(sh.getRange(i + 2, col), String(x)); fixed++; }
    }

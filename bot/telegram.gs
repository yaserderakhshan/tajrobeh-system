function tgSchHubUx() {
  if (TG_DRY) return 'dry';
  var ss = tgSchSS_(), map = tgSchHubUxMap_(), log = [];
  var codes = ss.getSheetByName(TG_SCH_CODES_TAB);
  if (!codes) { tgSchCodesRebuild(); codes = ss.getSheetByName(TG_SCH_CODES_TAB); }
  /* فهرست‌های این تب‌ها هم در «کدهای مدرسه» می‌نشینند، از ستون ۲۰ به بعد، تا فهرست کشویی همه یک منبع داشته باشد */
  var colAt = 20;
  try { codes.getRange(1, colAt, codes.getMaxRows(), Math.max(codes.getMaxColumns() - colAt + 1, 1)).clear(); } catch (e0) {}
  for (var t = 0; t < map.length; t++) {
    var m = map[t], sh = ss.getSheetByName(m.tab);
    if (!sh || sh.getLastRow() < 1) { log.push(m.tab + ': نیست'); continue; }
    var head = sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0].map(function (x) { return String(x || '').trim(); });
    var n = Math.max(sh.getMaxRows() - 1, 1), done = 0;
    sh.setRightToLeft(true); sh.setFrozenRows(1);
    for (var h in m.lists) {
      var col = head.indexOf(h) + 1, list = (m.lists[h] || []).filter(String);
      if (!col || !list.length) continue;
      codes.getRange(1, colAt).setValue(m.tab + ' · ' + h).setFontWeight('bold').setBackground('#f9f2f2');
      codes.getRange(2, colAt, list.length, 1).setValues(list.map(function (x) { return [x]; }));
      var rule = SpreadsheetApp.newDataValidation().requireValueInRange(codes.getRange(2, colAt, list.length, 1), true).setAllowInvalid(true)
        .setHelpText(list[0] === TG_SCH_TODAY ? '«امروز» را انتخاب کنید تا تاریخ شمسی امروز بنشیند' : 'از فهرست انتخاب کنید').build();
      sh.getRange(2, col, n, 1).setDataValidation(rule);
      colAt++; done++;
    }
    for (var k = 0; k < (m.hide || []).length; k++) { var hc = head.indexOf(m.hide[k]) + 1; if (hc) { try { sh.hideColumns(hc); } catch (eH) {} } }
    var rules = [], all = sh.getRange(2, 1, n, Math.max(head.length, 1));
    for (var c = 0; c < (m.colors || []).length; c++) {
      rules.push(SpreadsheetApp.newConditionalFormatRule().whenFormulaSatisfied('=' + m.colors[c][0].replace(/\{r\}/g, '2')).setBackground(m.colors[c][1]).setRanges([all]).build());
    }
    if (rules.length) sh.setConditionalFormatRules(rules);
    log.push(m.tab + ': ' + done + ' فهرست، ' + rules.length + ' رنگ');
  }
  return log.join(' · ');
}


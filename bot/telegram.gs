function tgTherRoute_(chat, who, text, m) {
  const cmd = tgCmd_(text);

  // اگر وسط فرم پروفایل است، همان‌جا ادامه بدهد
  if (tgProStep_(chat, text, m) === true) return;
  if (typeof tgScSetText_ === 'function' && tgScSetText_(chat, who, text)) return;
  if (typeof tgScHourText_ === 'function' && tgScHourText_(chat, who, text)) return;
  if (String(text || '').indexOf('طول جلسه و استراحت') > -1 && typeof tgScSetStart_ === 'function') return tgScSetStart_(chat, who);
  if (tgInpReqText_(chat, who, text) === true) return;   /* v70: ساعت حضوری */
  if (text === TG_INP_BTN || cmd === '/inperson') return tgInpMine_(chat, who);
  if (text === TG_PQ_BTN || cmd === '/page') return tgPqEntry_(chat, 'W');
  if (text === TG_PQK_BTN || cmd === '/work') return tgPqEntry_(chat, 'K');
  if (text.indexOf('پروفایل من') > -1 || cmd === '/profile') return tgProStart_(chat, who);
  if (text.indexOf('هفتهٔ من') > -1 || text.indexOf('هفته من') > -1) return tgSend_(chat, tgTherWeekText_(who.name), tgTherMenu_());

  if (tgFlag_('meetask', chat)) {
    tgDelFlag_('meetask', chat);
    return tgSaveMeetLink_(chat, who, text);
  }
  if (cmd === '/start' || text === 'شروع') return tgTherStart_(chat, who);
  if (tgFinSch_(chat, who.name, text, tgTherMenu_) === true) return;
  if (tgTherTk_(chat, who, text) === true) return;
  if (cmd === '/help' || text.indexOf('راهنما') > -1) return tgSend_(chat, T_HELP_THER, tgTherMenu_());
  if (text.indexOf('اعلام وقت درمان') > -1 || cmd === '/session') return tgAskPoolFirst_(chat, who, TG_KIND_SESS);
  if (cmd === '/slots' || text.indexOf('اعلام وقت') > -1) return tgAskPoolFirst_(chat, who, TG_KIND_MEET);
  if (text.indexOf('وقت‌های من') > -1 || text.indexOf('وقت های من') > -1) return tgMySlots_(chat, who);
  if (text.indexOf('لینک جلسه') > -1 || cmd === '/meet') {
    tgSetFlag_('meetask', chat, 1800);
    return tgSend_(chat, T_THER_ASK_MEET + (who.meet ? '\n\nلینک فعلی شما:\n' + tgEsc_(who.meet) : ''));
  }
  tgSend_(chat, T_THER_MENU, tgTherMenu_());
}

function tgSaveMeetLink_(chat, who, text) {
  const url = String(text).trim();
  if (!/^https:\/\/\S+\.\S+/.test(url)) return tgSend_(chat, T_THER_MEET_BAD, tgTherMenu_());
  if (!TG_DRY) {
    tgSS_().getSheetByName(TG_THER).getRange(who.row, TG_C_MEET).setValue(url);
    CacheService.getScriptCache().remove('trows');
  }
  tgPoolIn_(who);
  tgSend_(chat, T_THER_MEET_OK + '\n\n' + tgEsc_(url), tgTherMenu_());
}

function tgAskPoolFirst_(chat, who, kind) {
  const knd = kind || TG_KIND_MEET;
  tgSetVal_('sk', chat, knd);
  const mine = tgMyWeekly_(who.name, knd);
  const cap = tgCapFor_(who.name);
  if (mine.length >= cap) return tgSend_(chat, T_THER_MAX.replace('{n}', tgFa_(cap)), tgTherMenu_());
  const what = knd === TG_KIND_SESS ? 'وقت‌های درمان' : 'وقت‌های معارفه';
  const head = (knd === TG_KIND_SESS
      ? '🩺 <b>وقت درمان</b>\nاین وقت‌ها برای جلسهٔ درمان است، نه معارفه. طول هر جلسه ' + tgFa_(tgTherSlen_(who.name)) + ' دقیقه در نظر گرفته می‌شود.\n\n'
      : '') +
    (mine.length
      ? what + ' فعلی شما:\n' + mine.map(function (r) {
          return '🟢 هر ' + r.day + ' ساعت ' + r.hhmm + ' · ' + tgPoolLabel_(r.pool);
        }).join('\n') + '\n\n' + T_THER_ASK_POOL
      : T_THER_ASK_POOL);
  tgSend_(chat, head, { inline_keyboard: [
    [{ text: '🤝 هر دو (داخل و خارج ایران)', callback_data: 'p:هر دو' }],
    [{ text: '🇮🇷 فقط مراجع داخل ایران',    callback_data: 'p:داخل ایران' }],
    [{ text: '🌍 فقط مراجع خارج از ایران',   callback_data: 'p:خارج از ایران' }]
  ]});
}


/* عبارت خوانا برای استخر یک وقت هفتگی. هرگز توکن خام «هر دو» را به درمانگر نشان نده. */
function tgPoolLabel_(pool) {
  const p = String(pool || '').trim();
  if (p.indexOf('هر دو') > -1) return 'برای مراجع داخل ایران و خارج از ایران';
  if (p.indexOf('خارج') > -1) return 'فقط برای مراجع خارج از ایران';
  if (p.indexOf('داخل') > -1) return 'فقط برای مراجع داخل ایران';
  return p;
}

function tgPoolLine_(pool) {
  return '👥 ' + tgPoolLabel_(pool);
}

function tgPoolTests() {
  const log = [];
  function chk(l, g, w) { log.push((g === w ? 'OK  ' : 'BAD ') + l + (g === w ? '' : ' -> ' + g)); }
  chk('هر دو خوانا', tgPoolLabel_('هر دو'), 'برای مراجع داخل ایران و خارج از ایران');
  chk('خارج خوانا', tgPoolLabel_('خارج از ایران'), 'فقط برای مراجع خارج از ایران');
  chk('داخل خوانا', tgPoolLabel_('داخل ایران'), 'فقط برای مراجع داخل ایران');
  chk('توکن خام نمی‌ماند', tgPoolLabel_('هر دو') === 'هر دو', false);
  chk('مالک سازمانی', tgOwnerFor_('سازمانی'), tgNm_('chief'));
  return log.join('\n');
}

function tgAskWeekday_(chat, pool) {
  tgSetVal_('sp', chat, pool);
  tgSend_(chat, '✅ انتخاب شما: ' + tgPoolLabel_(pool));
  const btns = TG_DAYS.map(function (d) { return { text: d.fa, callback_data: 'd:' + d.fa }; });
  const grid = [];
  for (var i = 0; i < btns.length; i += 3) grid.push(btns.slice(i, i + 3));
  tgSend_(chat, T_THER_ASK_DAY, { inline_keyboard: grid });
}

function tgAskHour_(chat, day) {
  tgSetVal_('sd', chat, day);
  tgSetVal_('sfh', chat, '1');
  const pool = tgGetVal_('sp', chat) || 'داخل ایران';
  const hrs = [], grid = [];
  for (var h = 8; h <= 21; h++) {
    const hh = ('0' + h).slice(-2) + ':00';
    hrs.push({ text: hh, callback_data: 'h:' + hh });
  }
  for (var j = 0; j < hrs.length; j += 4) grid.push(hrs.slice(j, j + 4));
  tgSend_(chat, (pool !== 'داخل ایران' ? T_THER_ASK_HOUR_OUT : T_THER_ASK_HOUR) +
    '\n\nساعت دلخواه هم می‌شود. همین‌جا بنویسید، مثل ۱۰:۱۵', { inline_keyboard: grid });
}

function tgAskCount_(chat, hhmm) {
  tgDel_('sfh', chat);
  tgSetVal_('sh', chat, hhmm);
  const knd = tgGetVal_('sk', chat) || TG_KIND_MEET;
  const who0 = tgWhoTherapist_(chat);
  const nm = who0 ? who0.name : '';
  const len = tgScLen_(nm, knd);
  const gap = tgScGap_(nm);
  const step = len + gap;
  const end = function (n) { return tgScAddMin_(hhmm, (n - 1) * step + len); };
  const rows = [], cells = [];
  for (var i = 1; i <= TG_CHAIN_MAX; i++) cells.push({ text: tgFa_(i), callback_data: 'n:' + i });
  for (var j = 0; j < cells.length; j += 3) rows.push(cells.slice(j, j + 3));
  tgSend_(chat, 'از ساعت ' + hhmm + ' چند جلسهٔ ' + tgFa_(len) + ' دقیقه‌ای پشت سر هم آزادید؟\n\n' +
    (knd === TG_KIND_SESS ? 'این وقت‌ها برای جلسهٔ درمان است.\n' : 'هر معارفه ' + tgFa_(len) + ' دقیقه است.\n') +
    (gap ? 'بین دو جلسه ' + tgFa_(gap) + ' دقیقه استراحت می‌گذارم.\n' : '') +
    '\n۱ تا یعنی تا ' + end(1) + ' · ۳ تا تا ' + end(3) + ' · ' + tgFa_(TG_CHAIN_MAX) + ' تا تا ' + end(TG_CHAIN_MAX),
    { inline_keyboard: rows });
}

function tgWriteWeekly_(name, day, hhmm, pool, kind) {
  const knd = kind || TG_KIND_MEET;
  const sh = tgSS_().getSheetByName(TG_WEEKLY);
  const cK = tgWeeklyKindCol_(sh);
  const last = sh.getLastRow();
  if (last >= 4) {
    const v = sh.getRange(4, 1, last - 3, Math.max(cK, 5)).getValues();
    for (var k = 0; k < v.length; k++) {
      if (String(v[k][0]).trim() !== name) continue;
      if (String(v[k][1]).trim() !== day) continue;
      if (tgHHMM_(v[k][2]) !== hhmm) continue;
      if (((String(v[k][cK - 1] || '').trim()) || TG_KIND_MEET) !== knd) continue;
      sh.getRange(k + 4, 4).setValue(pool);
      sh.getRange(k + 4, 5).setValue('بله');
      sh.getRange(k + 4, cK).setValue(knd);
      tgWeeklyBust_();
      return;
    }
  }
  const row = tgNextRow_(sh);
  sh.getRange(row, 1, 1, 7).setValues([[
    name, day, hhmm, pool, 'بله',
    Utilities.formatDate(new Date(), TG_TZ, 'yyyy-MM-dd'), 'خوداعلامی از بات'
  ]]);
  sh.getRange(row, cK).setValue(knd);
  tgWeeklyBust_();
}

function tgAddSlot_(chat, who, count) {
  const day = tgGetVal_('sd', chat), pool = tgGetVal_('sp', chat), start = tgGetVal_('sh', chat);
  const knd = tgGetVal_('sk', chat) || TG_KIND_MEET;
  if (!day || !pool || !start) return tgAskPoolFirst_(chat, who, knd);
  tgDel_('sd', chat); tgDel_('sp', chat); tgDel_('sh', chat); tgDel_('sk', chat);

  const len = tgScLen_(who.name, knd);
  const step = tgScStep_(who.name, knd);
  const n = Math.max(1, Math.min(TG_CHAIN_MAX, Number(count) || 1));
  const base = Number(start.split(':')[0]) * 60 + Number(start.split(':')[1]);
  const wanted = [];
  for (var i = 0; i < n; i++) {
    const t = base + i * step;
    wanted.push(('0' + Math.floor(t / 60)).slice(-2) + ':' + ('0' + (t % 60)).slice(-2));
  }

  const mine = tgMyWeekly_(who.name, knd);
  const cap = knd === TG_KIND_SESS ? Math.max(TG_SESS_CAP, tgCapFor_(who.name)) : tgCapFor_(who.name);
  const have = {};
  const busy = [];
  try {
    const all0 = tgMyWeekly_(who.name, TG_KIND_MEET).concat(tgMyWeekly_(who.name, TG_KIND_SESS));
    for (var b0 = 0; b0 < all0.length; b0++) {
      if (String(all0[b0].day).trim() !== String(day).trim()) continue;
      const bs = tgScMin_(all0[b0].hhmm);
      busy.push([bs, bs + tgScStep_(who.name, all0[b0].kind || TG_KIND_MEET)]);
    }
  } catch (e0) {}
  var clash = 0;
  for (var k = 0; k < mine.length; k++) have[mine[k].day + '|' + mine[k].hhmm] = true;

  let added = 0, dup = 0, full = false;
  const lock = tgLock_();
  if (lock && !lock.tryLock(10000)) return tgSend_(chat, 'یک لحظه دوباره امتحان کنید.', tgTherMenu_());
  try { if (lock) TG_LOCK_HELD = true;   /* v166.13: tgLeadCode_ و tgAppendLead_ قفل را رها نکنند */
    for (var j = 0; j < wanted.length; j++) {
      if (have[day + '|' + wanted[j]]) { dup++; continue; }
      const ns = tgScMin_(wanted[j]), ne = ns + step;
      var hit = false;
      for (var q = 0; q < busy.length; q++) if (ns < busy[q][1] && busy[q][0] < ne) { hit = true; break; }
      if (hit) { clash++; continue; }
      if (mine.length + added >= cap) { full = true; break; }
      busy.push([ns, ne]);
      if (!TG_DRY) tgWriteWeekly_(who.name, day, wanted[j], pool, knd);
      added++;
    }
    const after = tgMyWeekly_(who.name, knd);
    let msg = added
      ? 'ثبت شد ✅  هر ' + day + '، ' + tgFa_(added) + ' جلسهٔ ' + tgFa_(len) + ' دقیقه‌ای از ساعت ' + start + '\n' + tgPoolLine_(pool)
      : 'چیز تازه‌ای اضافه نشد.';
    if (dup) msg += '\n' + tgFa_(dup) + ' وقت از قبل ثبت بود.';
    if (clash) msg += '\n' + tgFa_(clash) + ' وقت با وقت دیگری از خودتان تداخل داشت و ثبت نشد.';
    if (full) msg += '\n\n' + T_THER_MAX;
    msg += '\n\n' + (knd === TG_KIND_SESS ? 'وقت‌های درمان شما الان:' : 'وقت‌های معارفهٔ شما الان:') + '\n' +
           after.map(function (r) { return '🟢 هر ' + r.day + ' ساعت ' + r.hhmm + ' · ' + tgPoolLabel_(r.pool); }).join('\n');
    if (!who.meet) msg += '\n\n⚠️ هنوز لینک جلسهٔ آنلاین ثبت نکرده‌اید. تا ثبت نکنید مراجع لینک را از بات نمی‌گیرد. با «🔗 لینک جلسهٔ من» ثبتش کنید.';
    tgSend_(chat, msg, tgTherMenu_());
    if (added) { try { tgRecurOffer_(chat, who.name, day, wanted, knd); } catch (eRo) {} }
    if (pool !== 'داخل ایران') tgCoverageHint_(chat, who);
  } catch (err) {
    tgErr_('tgAddSlot_: ' + err);
    tgSend_(chat, 'ثبت نشد. لطفاً به پذیرش خبر بدهید.', tgTherMenu_());
  } finally { TG_LOCK_HELD = false;
    if (lock) lock.releaseLock();
  }
}

function tgMyWeekly_(name, kind) {
  const rules = tgWeeklyRules_('', kind);
  const out = [];
  for (var i = 0; i < rules.length; i++) {
    if (rules[i].name !== name) continue;
    let day = '';
    for (var k = 0; k < TG_DAYS.length; k++) if (TG_DAYS[k].iso === rules[i].iso) day = TG_DAYS[k].fa;
    out.push({ day: day, hhmm: rules[i].hhmm, pool: rules[i].pool, row: rules[i].row, kind: rules[i].kind, recur: rules[i].recur || '' });
  }
  return out;
}

function tgMySlots_(chat, who) {
  const meet = tgMyWeekly_(who.name, TG_KIND_MEET);
  const sess = tgMyWeekly_(who.name, TG_KIND_SESS);
  const mine = meet.concat(sess);
  if (!mine.length) return tgSend_(chat, T_THER_EMPTY, tgTherMenu_());
  const line = function (r) { var rl = tgRecurLabel_(r.recur); return '🟢 ' + (rl ? rl + '، ' : 'هر ') + r.day + ' ساعت ' + r.hhmm + ' · ' + tgPoolLabel_(r.pool); };
  const btns  = mine.map(function (r) {
    return [{ text: '✕ برداشتن ' + (r.kind === TG_KIND_SESS ? 'درمان ' : 'معارفه ') + r.day + ' ' + r.hhmm, callback_data: 'c:' + r.row }];
  });
  let head = '';
  if (meet.length) head += '<b>معارفه</b>\n' + meet.map(line).join('\n') + '\n\n';
  if (sess.length) head += '<b>درمان</b> · ' + tgFa_(tgTherSlen_(who.name)) + ' دقیقه\n' + sess.map(line).join('\n');
  head = head.replace(/\n+$/, '');
  head += who.meet ? '\n\n🔗 لینک جلسهٔ شما:\n' + tgEsc_(who.meet) : '\n\n⚠️ ' + T_THER_MEET_NONE;
  tgSend_(chat, head, { inline_keyboard: btns });
}

function tgCancelSlot_(chat, who, row) {
  const lock = tgLock_();
  if (lock && !lock.tryLock(10000)) return;
  try { if (lock) TG_LOCK_HELD = true;   /* v166.13: tgLeadCode_ و tgAppendLead_ قفل را رها نکنند */
    if (!TG_DRY) {
      const sh = tgSS_().getSheetByName(TG_WEEKLY);
      const v = sh.getRange(row, 1, 1, 5).getValues()[0];
      if (String(v[0]).trim() !== who.name) return;
      sh.getRange(row, 5).setValue('خیر'); tgWeeklyBust_();
      sh.getRange(row, 7).setValue('برداشته شد توسط خود درمانگر از بات ' +
        Utilities.formatDate(new Date(), TG_TZ, 'yyyy-MM-dd HH:mm'));
    }
    tgSend_(chat, T_THER_REMOVED, tgTherMenu_());
  } finally { TG_LOCK_HELD = false; if (lock) lock.releaseLock(); }
}

function tgCoverageHint_(chat, who) {
  const mine = tgMyWeekly_(who.name);
  let evening = false, any = 0;
  for (var i = 0; i < mine.length; i++) {
    if (mine[i].pool === 'داخل ایران') continue;
    any++;
    if (Number(mine[i].hhmm.split(':')[0]) >= 18) evening = true;
  }
  if (any && !evening) tgSend_(chat, T_COVERAGE_HINT, tgTherMenu_());
}

function tgLinkTherapist_(chat, token) {
  const rows = tgTherapistRows_();
  for (var i = 0; i < rows.length; i++) {
    if (rows[i].code !== token) continue;
    if (rows[i].chat && rows[i].chat !== String(chat)) return tgSend_(chat, T_THER_TAKEN);
    if (!TG_DRY) {
      tgSS_().getSheetByName(TG_THER).getRange(rows[i].row, TG_C_CHAT).setValue(String(chat));
      CacheService.getScriptCache().remove('trows');
    }
    tgSend_(chat, T_THER_LINKED);
    tgSend_(chat, T_THER_MENU, tgTherMenu_());
    return;
  }
  tgWelcome_(chat);
}

function tgNotifyTherapist_(s, clientName, clientPhone, zoneLabel) {
  const info = tgTherapistInfo_()[s.therapist];
  if (!info || !info.chat) return false;
  const msg =
    '🗓 <b>یک جلسهٔ معارفه برای شما رزرو شد</b>\n\n' +
    'تاریخ: ' + tgDay_(Utilities.formatDate(tgSlotUtc_(s), TG_TZ, 'EEE')) + ' ' +
    tgJDateFull_(tgSlotUtc_(s), TG_TZ) + '\n' +
    'ساعت: ' + s.hhmm + ' به وقت تهران، حدود ' + TG_MEET_MIN + ' دقیقه\n' +
    'مراجع: ' + tgEsc_(clientName) + '\n' +
    'تماس: ' + tgEsc_(clientPhone || 'در شیت پذیرش') + '\n' +
    (zoneLabel ? 'محل مراجع: ' + tgEsc_(zoneLabel) + '\n' : '') +
    (info.meet
      ? '\nلینک جلسه‌ای که ثبت کرده‌اید به مراجع داده شد:\n' + tgEsc_(info.meet)
      : '\n⚠️ شما لینک جلسه ثبت نکرده‌اید، پس مراجع لینکی نگرفت. با «🔗 لینک جلسهٔ من» ثبتش کنید.') +
    '\n\nاگر نمی‌توانید، همین حالا به پذیرش خبر بدهید.';
  tgSend_(info.chat, msg, tgTherMenu_());
  return true;
}

function tgNotifyTherapistCancel_(mt) {
  const info = tgTherapistInfo_()[mt.t];
  if (!info || !info.chat) return;
  tgSend_(info.chat, '❌ جلسهٔ معارفهٔ ' + mt.d + ' ساعت ' + mt.h + ' توسط مراجع لغو شد. آن وقت دوباره آزاد است.');
}

function tgTherapistLinks() {
  tgWriteBotName_();
  const rows = tgTherapistRows_();
  const out = [];
  for (var i = 0; i < rows.length; i++) {
    if (!rows[i].pool) continue;
    out.push((rows[i].chat ? '✅ وصل  ' : '⬜ نشده ') + rows[i].name +
             '  [' + rows[i].pool + ']' + (rows[i].meet ? '  لینک دارد' : '  بدون لینک'));
  }
  Logger.log(out.length ? out.join('\n') : 'هنوز کسی در ستون «استخر خودرزرو» علامت نخورده.');
}

/* ---------- ابزارها ---------- */

var TG_SS_CACHE_ = null;
function tgSS_() {
  if (!TG_SS_CACHE_) TG_SS_CACHE_ = SpreadsheetApp.openById(TG_SHEET_ID);
  return TG_SS_CACHE_;
}

/* هاب محتوا: از ۲۱ شهریور ۱۴۰۵ تب‌های مجله و محتوا از هاب تجربه جدا شدند.
   هاب تجربه برای عملیات پذیرش و درمانگران می‌ماند. نام تب‌ها عوض نشده، فقط فایلشان. */
var TG_CONTENT_SHEET_ID = cfg_('TG_CONTENT_SHEET_ID', '');
var TG_CSS_CACHE_ = null;
function tgCSS_() {
  if (!TG_CSS_CACHE_) TG_CSS_CACHE_ = SpreadsheetApp.openById(TG_CONTENT_SHEET_ID);
  return TG_CSS_CACHE_;
}

function tgLock_() { return TG_DRY ? null : LockService.getScriptLock(); }

function tgEsc_(s) {
  return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

function tgCmd_(text) {
  const m = String(text).match(/^\/([a-zA-Z_]+)(@\w+)?/);
  return m ? '/' + m[1].toLowerCase() : '';
}

// یادداشت درون‌اجرایی کش: هر رفت‌وبرگشت CacheService حدود ۵۰ تا ۱۰۰ میلی‌ثانیه است؛
// tgCachePrime_ همهٔ کلیدهای رایج این چت را با یک getAll می‌گیرد و بقیهٔ خواندن‌ها از حافظه می‌آید
var TG_CMEMO = null;
const TG_MEMO_KEYS = ['sign', 'await', 'ft', 'seen', 'qt', 'qg', 'nd', 'pf', 'qa', 'qm', 'tz', 'bd', 'helped', 'ts', 'pfd', 'ct', 'mzw', 'mzt', 'mzu', 'mzl', 'mzn', 'esign', 'pq', 'pr', 'em', 'emask', 'ldn', 'ldr', 'war', 'sfh', 'scg', 'sln', 'sli', 'sfl', 'alw', 'apw', 'pzw', 'rmw', 'rmv', 'cpv', 'cpp', 'cpn', 'cpl', 'apmsg', 'apreply', 'ldx', 'ldf', 'ldb', 'ldbs', 'vxc', 'vxe', 'vxu', 'mig', 'qcity', 'qpid'];
const TG_MEMO_LISTS = ['wlist', 'drows', 'trows', 'faq', 'scols'];
function tgCachePrime_(chat) {
  if (TG_DRY || TG_CMEMO) return;
  try {
    const keys = TG_MEMO_KEYS.map(function (k) { return k + chat; }).concat(TG_MEMO_LISTS);
    const got = CacheService.getScriptCache().getAll(keys) || {};
    const memo = {};
    for (var i = 0; i < keys.length; i++) memo[keys[i]] = got[keys[i]] || '';
    TG_CMEMO = memo;
  } catch (e) { TG_CMEMO = null; }
}
function tgCacheGet_(key) {
  if (TG_CMEMO && Object.prototype.hasOwnProperty.call(TG_CMEMO, key)) return TG_CMEMO[key] || null;
  const v = CacheService.getScriptCache().get(key);
  if (TG_CMEMO) TG_CMEMO[key] = v || '';
  return v;
}
function tgSetVal_(k, chat, v) {
  if (TG_DRY) { TG_MEM[k + chat] = String(v); return; }
  CacheService.getScriptCache().put(k + chat, String(v), 21600);
  if (TG_CMEMO) TG_CMEMO[k + chat] = String(v);
}
function tgGetVal_(k, chat) {
  if (TG_DRY) return TG_MEM[k + chat] || '';
  return tgCacheGet_(k + chat) || '';
}
function tgDel_(k, chat) {
  if (TG_DRY) { delete TG_MEM[k + chat]; return; }
  CacheService.getScriptCache().remove(k + chat);
  if (TG_CMEMO) TG_CMEMO[k + chat] = '';
}
function tgSetFlag_(k, chat, sec) {
  if (TG_DRY) { TG_MEM[k + chat] = '1'; return; }
  CacheService.getScriptCache().put(k + chat, '1', sec);
  if (TG_CMEMO) TG_CMEMO[k + chat] = '1';
}
function tgFlag_(k, chat)    { return !!tgGetVal_(k, chat); }

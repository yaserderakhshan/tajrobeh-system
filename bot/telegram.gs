/* ---------- جدول با نام سرستون ---------- */

function tgCpSh_(tab) { return TG_DRY ? null : tgSchSS_().getSheetByName(tab); }

function tgCpRead_(tab) {
  if (TG_DRY) {
    var arr = TG_MEM['cp:' + tab] || [];
    return arr.map(function (o, i) { var c = { _row: i + 2 }; for (var k in o) c[k] = o[k]; return c; });
  }
  TG_CP_MEMO = TG_CP_MEMO || {};
  if (TG_CP_MEMO[tab]) return TG_CP_MEMO[tab];
  var sh = tgCpSh_(tab);
  if (!sh || sh.getLastRow() < 2) return (TG_CP_MEMO[tab] = []);
  var v = sh.getRange(1, 1, sh.getLastRow(), sh.getLastColumn()).getValues();
  var head = v[0].map(function (h) { return String(h || '').trim(); }), out = [];
  for (var i = 1; i < v.length; i++) {
    var o = { _row: i + 1 }, any = false;
    for (var j = 0; j < head.length; j++) {
      if (!head[j]) continue;
      o[head[j]] = v[i][j];
      if (String(v[i][j] || '').trim()) any = true;
    }
    if (any) out.push(o);
  }
  return (TG_CP_MEMO[tab] = out);
}

function tgCpHead_(tab) {
  var sh = tgCpSh_(tab);
  if (!sh) return [];
  return sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0].map(function (h) { return String(h || '').trim(); });
}

function tgCpDrop_() { TG_CP_MEMO = null; }

function tgCpSet_(tab, row, changes) {
  if (!row || row < 2) return;
  if (TG_DRY) {
    TG_OUTBOX.push({ kind: 'cpset', tab: tab, row: row, changes: changes });
    var arr = TG_MEM['cp:' + tab] || [];
    var o = arr[row - 2];
    if (o) for (var k in changes) o[k] = changes[k];
    return;
  }
  var sh = tgCpSh_(tab), head = tgCpHead_(tab);
  for (var key in changes) {
    if (!Object.prototype.hasOwnProperty.call(changes, key)) continue;
    var col = head.indexOf(key) + 1;
    if (!col) { tgErr_('tgCpSet_ ستون ناشناس «' + key + '» در ' + tab); continue; }
    sh.getRange(row, col).setValue(changes[key]);
  }
  tgCpDrop_();
}

function tgCpAdd_(tab, obj) {
  if (TG_DRY) {
    var arr = (TG_MEM['cp:' + tab] = TG_MEM['cp:' + tab] || []);
    arr.push(obj);
    TG_OUTBOX.push({ kind: 'cpadd', tab: tab, obj: obj });
    return arr.length + 1;
  }
  var sh = tgCpSh_(tab), head = tgCpHead_(tab);
  sh.appendRow(head.map(function (h) { return obj[h] === undefined ? '' : obj[h]; }));
  tgCpDrop_();
  if (tab === TG_CPP_TAB && obj['وضعیت'] === TG_CP_PAY.wait && typeof opsAdaptPay_ === 'function') opsAdaptPay_(obj['کد پرداخت']);
  return sh.getLastRow();
}

function tgCpNext_(tab, col, prefix, pad) {
  var rows = tgCpRead_(tab), max = 0;
  for (var i = 0; i < rows.length; i++) {
    var m = String(rows[i][col] || '').match(new RegExp('^' + prefix + '-(\\d+)$'));
    if (m && Number(m[1]) > max) max = Number(m[1]);
  }
  var n = String(max + 1);
  while (n.length < (pad || 3)) n = '0' + n;
  return prefix + '-' + n;
}

/* ---------- تاریخ و پول ---------- */

function tgCpS_(v) { return String(v === null || v === undefined ? '' : v).trim(); }

function tgCpNow_() { return (TG_DRY && TG_MEM['cp:now']) ? new Date(TG_MEM['cp:now']) : new Date(); }

function tgCpSheetTz_() {
  if (TG_DRY) return TG_TZ;
  try { return tgSchSS_().getSpreadsheetTimeZone() || TG_TZ; } catch (e) { return TG_TZ; }
}

/* «۵ مهر ۱۴۰۵»، «1405/07/05»، یا Date (اگر شیت آن را تاریخ کرد) ← {y,m,d} شمسی */
function tgCpJ_(v) {
  if (v instanceof Date && !isNaN(v.getTime())) {
    var tz = tgCpSheetTz_();
    var y = Number(Utilities.formatDate(v, tz, 'yyyy'));
    if (y < 1700) return { y: y, m: Number(Utilities.formatDate(v, tz, 'M')), d: Number(Utilities.formatDate(v, tz, 'd')) };
    return tgJalali_(v, TG_TZ);
  }
  var s = tgLatinDigits_(tgCpS_(v)).replace(/ي/g, 'ی').replace(/ك/g, 'ک');
  if (!s) return null;
  var a = s.match(/(\d{4})\s*[\/\-.]\s*(\d{1,2})\s*[\/\-.]\s*(\d{1,2})/);
  if (a) return { y: Number(a[1]), m: Number(a[2]), d: Number(a[3]) };
  var b = s.match(/(\d{1,2})\s*([^\d\s]+)\s*(\d{4})?/);
  if (!b) return null;
  var mi = -1;
  for (var i = 0; i < TG_JMONTHS.length; i++) if (b[2].indexOf(TG_JMONTHS[i]) === 0) mi = i;
  if (mi < 0) return null;
  var yy = b[3] ? Number(b[3]) : tgJalali_(tgCpNow_(), TG_TZ).y;
  return { y: yy, m: mi + 1, d: Number(b[1]) };
}

function tgCpHM_(v) {
  if (v instanceof Date && !isNaN(v.getTime())) return Utilities.formatDate(v, tgCpSheetTz_(), 'HH:mm');
  var s = tgLatinDigits_(tgCpS_(v));
  var m = s.match(/(\d{1,2})\s*[:٫.]\s*(\d{2})/) || s.match(/^(\d{1,2})$/);
  if (!m) return '';
  var h = Number(m[1]), mi = m[2] ? Number(m[2]) : 0;
  if (h > 23 || mi > 59) return '';
  return (h < 10 ? '0' : '') + h + ':' + (mi < 10 ? '0' : '') + mi;
}

/* تاریخ شمسی + ساعت تهران ← Date */
function tgCpAt_(dateV, timeV, endOfDay) {
  var j = tgCpJ_(dateV);
  if (!j || !j.y || !j.m || !j.d) return null;
  var g = tgJ2G_(j.y, j.m, j.d);
  var hm = tgCpHM_(timeV) || (endOfDay ? '23:59' : '00:00');
  var p = function (n) { return (n < 10 ? '0' : '') + n; };
  var s = g.getFullYear() + '-' + p(g.getMonth() + 1) + '-' + p(g.getDate()) + ' ' + hm;
  return Utilities.parseDate(s, TG_TZ, 'yyyy-MM-dd HH:mm');
}

function tgCpJText_(j) { return j ? tgFa_(j.d) + ' ' + TG_JMONTHS[j.m - 1] + ' ' + tgFa_(j.y) : ''; }

var TG_CP_WDAYS = { 1: 'دوشنبه', 2: 'سه‌شنبه', 3: 'چهارشنبه', 4: 'پنج‌شنبه', 5: 'جمعه', 6: 'شنبه', 7: 'یکشنبه' };
function tgCpDay_(d) { return TG_CP_WDAYS[Number(Utilities.formatDate(d, TG_TZ, 'u'))] || ''; }

/* «یکشنبه ۵ مهر، ساعت ۲۰:۰۰» */
function tgCpWhen_(d, withTime) {
  if (!d) return '';
  return tgCpDay_(d) + ' ' + tgJDate_(d, TG_TZ) + (withTime ? '، ساعت ' + tgFa_(Utilities.formatDate(d, TG_TZ, 'HH:mm')) : '');
}

function tgCpNum_(v) {
  var n = Number(tgLatinDigits_(tgCpS_(v)).replace(/[^\d]/g, ''));
  return isNaN(n) ? 0 : n;
}

function tgCpMoney_(n) {
  var s = String(Math.round(Number(n) || 0)).replace(/\B(?=(\d{3})+(?!\d))/g, '٬');
  return tgFa_(s) + ' تومان';
}

/* ---------- کمپین، خط زمانی، پله و وبینار ---------- */

function tgCpCamp_(o) {
  return {
    row: o._row, code: tgCpS_(o['کد کمپین']), course: tgCpS_(o['دوره']), ccode: tgCpS_(o['کد دوره']),
    circle: tgCpS_(o['حلقه']), state: tgCpS_(o['وضعیت']), start: o['تاریخ شروع دوره'],
    deadline: o['آخرین روز ثبت‌نام'], fee: tgCpNum_(o['شهریهٔ ماهانه (تومان)'] !== undefined ? o['شهریهٔ ماهانه (تومان)'] : o['شهریهٔ کامل (تومان)']),
    prepay: tgCpNum_(o['پیش‌پرداخت (تومان)']), payurl: tgCpS_(o['لینک پرداخت']),
    cap: tgCpNum_(o['ظرفیت']), target: tgCpNum_(o['هدف ثبت‌نام']), owner: tgCpS_(o['مسئول کمپین']),
    follow: tgCpS_(o['مسئول پیگیری']), ivers: tgCpS_(o['مصاحبه‌گرها']), group: tgCpS_(o['گروه تلگرام وبینار']),
    rec: tgCpS_(o['ضبط وبینار']), page: tgCpS_(o['صفحهٔ سایت']), key: tgCpS_(o['کلید بات']).toLowerCase()
  };
}

function tgCpCamps_() {
  return tgCpRead_(TG_CP_TAB).filter(function (o) { return /^[A-Za-z]{2,}[\w]*-\d+$/.test(tgCpS_(o['کد کمپین'])); })
                             .map(tgCpCamp_);
}

/* با کد کمپین، کلید بات یا کد دوره؛ اگر چند تا بود، آن که بسته نیست و تازه‌تر است */
function tgCpFind_(q) {
  var s = tgCpS_(q).toLowerCase();
  if (!s) return null;
  var all = tgCpCamps_(), hit = null;
  for (var i = 0; i < all.length; i++) if (all[i].code.toLowerCase() === s) return all[i];
  for (var j = 0; j < all.length; j++) {
    var c = all[j];
    if (c.key !== s && c.ccode.toLowerCase() !== s && ('sch_' + c.key) !== s) continue;
    if (!hit || (hit.state === 'بسته' && c.state !== 'بسته') || (hit.state === c.state && c.row > hit.row)) hit = c;
  }
  return hit;
}

function tgCpEv_(o) {
  var e = {
    row: o._row, id: tgCpS_(o['کد']), camp: tgCpS_(o['کد کمپین']), type: tgCpS_(o['نوع']), title: tgCpS_(o['عنوان']),
    from: o['از تاریخ'], time: o['ساعت'], to: o['تا تاریخ'], owner: tgCpS_(o['مسئول']),
    aud: tgCpS_(o['مخاطب']), msg: tgCpS_(o['پیام بات']), status: tgCpS_(o['وضعیت']), done: tgCpS_(o['اجرا شد']),
    note: tgCpS_(o['یادداشت']), amount: tgCpNum_(o['مبلغ (تومان)'])
  };
  e.at = tgCpAt_(e.from, e.time, false);
  e.until = tgCpAt_(tgCpS_(e.to) ? e.to : e.from, '', true);
  if (e.at && e.until && e.until < e.at) e.until = e.at;
  return e;
}

function tgCpEvents_(code) {
  return tgCpRead_(TG_CPT_TAB).filter(function (o) { return tgCpS_(o['کد کمپین']) === code && tgCpS_(o['کد']); })
    .map(tgCpEv_).sort(function (a, b) { return (a.at ? a.at.getTime() : 9e15) - (b.at ? b.at.getTime() : 9e15); });
}

function tgCpTiers_(camp) {
  return tgCpEvents_(camp.code).filter(function (e) { return e.type === 'پلهٔ قیمت' && e.status !== 'لغو' && e.amount > 0 && e.at; });
}

/* پلهٔ فعلی: {label, amount, until, next} */
function tgCpTier_(camp, now) {
  now = now || tgCpNow_();
  var t = tgCpTiers_(camp), cur = null, next = null;
  for (var i = 0; i < t.length; i++) {
    if (t[i].at <= now && now <= t[i].until) cur = t[i];
    else if (t[i].at > now && !next) next = t[i];
  }
  if (!cur) return { label: 'شهریهٔ پایه', amount: camp.fee, until: null, next: next, id: '' };
  return { label: cur.title, amount: cur.amount, until: cur.until, next: next, id: cur.id };
}

/* نزدیک‌ترین وبینار که تمام نشده (تا سه ساعت پس از شروع) */
function tgCpWebinar_(camp, now) {
  now = now || tgCpNow_();
  var ev = tgCpEvents_(camp.code).filter(function (e) { return e.type === 'وبینار' && e.status !== 'لغو' && e.at; });
  for (var i = 0; i < ev.length; i++) if (ev[i].at.getTime() + 3 * 3600000 > now.getTime()) return ev[i];
  return null;
}

function tgCpLastWebinar_(camp) {
  var ev = tgCpEvents_(camp.code).filter(function (e) { return e.type === 'وبینار' && e.status !== 'لغو' && e.at; });
  return ev.length ? ev[ev.length - 1] : null;
}

function tgCpCanApply_(camp) { return TG_CP_OPEN_STATES.indexOf(camp.state) > -1; }

function tgCpStateLine_(camp) {
  var s = camp.state;
  if (s === 'ثبت‌نام باز') return 'ثبت‌نام باز است · پذیرش با مصاحبه';
  if (s === 'آخرین فرصت') return 'روزهای آخر ثبت‌نام است · پذیرش با مصاحبه';
  if (s === 'وبینار') return 'ثبت‌نام وبینار رایگان باز است. ثبت‌نام دوره به‌زودی باز می‌شود.';
  if (s === 'بسته') return 'ثبت‌نام این حلقه بسته شد. پیش‌ثبت‌نام حلقهٔ بعد باز است.';
  return 'ثبت‌نام این حلقه هنوز باز نشده. با پیش‌ثبت‌نام اول از همه خبردار می‌شوید.';
}

function tgCpCalUrl_(title, at, mins, details) {
  if (!at) return '';
  var end = new Date(at.getTime() + (mins || 60) * 60000);
  var f = function (d) { return Utilities.formatDate(d, 'UTC', "yyyyMMdd'T'HHmmss'Z'"); };
  return 'https://calendar.google.com/calendar/render?action=TEMPLATE&text=' + encodeURIComponent(title) +
         '&dates=' + f(at) + '/' + f(end) + '&details=' + encodeURIComponent(details || '') + '&ctz=Asia/Tehran';
}

function tgCpPageUrl_(camp) {
  if (!camp.page) return '';
  return camp.page.indexOf('http') === 0 ? camp.page : 'https://tajrobeh.life' + camp.page;
}

/* ---------- آدم‌ها ---------- */

function tgCpIsOwner_(chat) {
  if (TG_DRY) return (TG_MEM['cpowners'] || []).indexOf(String(chat)) > -1;
  if (String(chat) === TG_CP_YASER) return true;
  try { if (tgSjIsOwner_(chat)) return true; } catch (e) {}
  try { var c = tgSchChief_(); if (c && tgChatIn_(c.chat, chat)) return true; } catch (e2) {}
  return false;
}

/* مسئولان مدرسه (مسئول مدرسه و مدیر مدرسه)، هر کدام یک chat */
function tgCpOwners_() {
  if (TG_DRY) return (TG_MEM['cpowners'] || []).filter(function (c) { return c !== TG_CP_YASER; });
  var out = [];
  try {
    tgSchoolOwners_().forEach(function (p) { var c = String(p.chat).split(/[,،;\s]+/)[0]; if (c && out.indexOf(c) < 0) out.push(c); });
    var ch = tgSchChief_(); if (ch) { var c2 = String(ch.chat).split(/[,،;\s]+/)[0]; if (c2 && out.indexOf(c2) < 0) out.push(c2); }
  } catch (e) {}
  return out;
}

function tgCpTell_(msg, kb) { tgCpOwners_().forEach(function (c) { tgSend_(c, msg, kb); }); }

/* مصاحبه‌گر: کسی در «افراد» که نقش مصاحبه‌گر دارد */
function tgCpIvWho_(chat, uname) {
  if (TG_DRY) return TG_MEM['cpiv:' + chat] || null;
  var p = null;
  try { p = tgWhoPerson_(chat, uname); } catch (e) {}
  if (p && p.roles.indexOf(TG_CP_ROLE) > -1) return { name: p.name, chat: String(chat) };
  return null;
}

function tgCpIvChat_(name) {
  var n = tgNorm_(name);
  if (!n) return '';
  if (TG_DRY) return (TG_MEM['cpivchat'] || {})[name] || '';
  var list = tgPeopleList_();
  for (var i = 0; i < list.length; i++) {
    if (tgNorm_(list[i].name) === n && list[i].chat) return String(list[i].chat).split(/[,،;\s]+/)[0];
  }
  return '';
}

function tgCpIvLink_(name, set) {
  var key = 'CP_IVLINK';
  if (TG_DRY) { var m0 = TG_MEM[key] || {}; if (set !== undefined) { m0[name] = set; TG_MEM[key] = m0; } return m0[name] || ''; }
  var pr = PropertiesService.getScriptProperties(), m = {};
  try { m = JSON.parse(pr.getProperty(key) || '{}'); } catch (e) {}
  if (set !== undefined) { m[name] = set; pr.setProperty(key, JSON.stringify(m)); }
  return m[name] || '';
}

/* ---------- لید، پرداخت، مصاحبه، ثبت‌نام وبینار ---------- */

function tgCpLead_(chat, code) {
  var rows = tgCpRead_(TG_SCH_T_REQ), hit = null;
  for (var i = 0; i < rows.length; i++) {
    if (tgCpS_(rows[i]['chat_id']) !== String(chat)) continue;
    if (tgCpS_(rows[i]['کد کمپین']) !== code) continue;
    hit = rows[i];
  }
  return hit;
}

function tgCpLeadById_(id) {
  var rows = tgCpRead_(TG_SCH_T_REQ);
  for (var i = 0; i < rows.length; i++) if (tgCpS_(rows[i]['شناسهٔ درخواست']) === id) return rows[i];
  return null;
}

function tgCpPays_(leadId) {
  return tgCpRead_(TG_CPP_TAB).filter(function (p) { return tgCpS_(p['کد درخواست']) === leadId; });
}

function tgCpPayOf_(leadId, kind) {
  var ps = tgCpPays_(leadId), best = null;
  for (var i = 0; i < ps.length; i++) {
    if (tgCpS_(ps[i]['نوع']) !== TG_CP_KIND[kind]) continue;
    var st = tgCpS_(ps[i]['وضعیت']);
    if (st === TG_CP_PAY.ok) return ps[i];
    if (st === TG_CP_PAY.wait) best = ps[i];
    else if (!best) best = ps[i];
  }
  return best;
}

function tgCpSlots_(code) {
  return tgCpRead_(TG_CPI_TAB).filter(function (s) { return tgCpS_(s['کد کمپین']) === code && tgCpS_(s['کد']); })
    .map(function (s) {
      s.at = tgCpAt_(s['تاریخ'], s['ساعت'], false);
      return s;
    });
}

function tgCpSlotOfLead_(leadId) {
  var all = tgCpRead_(TG_CPI_TAB), hit = null;
  for (var i = 0; i < all.length; i++) {
    if (tgCpS_(all[i]['کد درخواست']) !== leadId) continue;
    if (tgCpS_(all[i]['وضعیت']) === 'لغو') continue;
    hit = all[i];
    hit.at = tgCpAt_(hit['تاریخ'], hit['ساعت'], false);
  }
  return hit;
}

function tgCpWebRegs_(code) {
  return tgCpRead_(TG_EVR_TAB).filter(function (r) { return tgCpS_(r['کد رویداد']).indexOf(code + '/') === 0; });
}

function tgCpWebReg_(code, chat) {
  var r = tgCpWebRegs_(code);
  for (var i = 0; i < r.length; i++) if (tgCpS_(r[i]['chat_id']) === String(chat)) return r[i];
  return null;
}

/* مرحلهٔ متقاضی در مسیر */
function tgCpStep_(camp, lead) {
  if (!lead) return 'none';
  var st = tgSchStNorm_(lead['وضعیت']).st;
  if (st === TG_SCH_ST_PRE) return 'prereg';
  if (st === TG_SCH_ST_DONE) return 'done';
  if (st === TG_SCH_ST_COND) return 'cond';
  if (tgSchClosed_(st)) return 'closed';
  /* v142: کسی که فقط وبینار ثبت‌نام کرده هنوز متقاضی نیست */
  if (!tgSchStageAtLeast_(tgSchStageNorm_(lead['مرحلهٔ قیف']).st, 'apply')) return 'none';
  var id = tgCpS_(lead['شناسهٔ درخواست']);
  var pre = tgCpPayOf_(id, 'pre');
  if (camp.prepay > 0) {
    if (!pre || tgCpS_(pre['وضعیت']) === TG_CP_PAY.no) return 'pay_pre';
    if (tgCpS_(pre['وضعیت']) === TG_CP_PAY.wait) return 'wait_pre';
  }
  var slot = tgCpSlotOfLead_(id);
  var res = tgCpS_(lead['نتیجهٔ مصاحبه']);
  if (!slot || tgCpS_(slot['وضعیت']) === 'غیبت') return res && res !== 'غیبت' ? 'result' : 'book';
  if (!res) return 'itv';
  if (res === TG_CP_IV_RES.no) return 'closed';
  var rest = tgCpPayOf_(id, 'rest');
  if (!rest || tgCpS_(rest['وضعیت']) === TG_CP_PAY.no) return 'pay_rest';
  if (tgCpS_(rest['وضعیت']) === TG_CP_PAY.wait) return 'wait_rest';
  return 'done';
}

function tgCpLockedAmount_(camp, lead) {
  var n = tgCpNum_(String(tgCpS_(lead && lead['پلهٔ قیمت'])).split('·').pop());
  return n > 0 ? n : tgCpTier_(camp).amount;
}

function tgCpRest_(camp, lead) { return Math.max(0, tgCpLockedAmount_(camp, lead) - camp.prepay); }

/* همهٔ نوشتن روی لید از tgSlSet_ می‌گذرد تا دفتر رویداد لید پر شود */
function tgCpLeadSet_(row, changes, actor) {
  if (TG_DRY) {
    var arr = TG_MEM['cp:' + TG_SCH_T_REQ] || [], o = arr[row - 2];
    if (o) for (var k in changes) o[k] = changes[k];
  }
  var r = tgSlSet_(row, changes, actor);
  tgCpDrop_();
  return r;
}

/* ---------- کارت دوره برای دانشجو ---------- */

function tgCpCardText_(camp, chat) {
  var now = tgCpNow_(), t = [];
  t.push('🎓 <b>' + tgEsc_(camp.course) + (camp.circle ? ' · حلقهٔ ' + tgEsc_(tgFa_(camp.circle)) : '') + '</b>');
  t.push(tgCpStateLine_(camp));
  var w = tgCpWebinar_(camp, now);
  if (w) t.push('\n🎟 <b>وبینار رایگان</b>\n' + tgEsc_(w.title) + '\n' + tgCpWhen_(w.at, true) + ' به وقت تهران، لایو تلگرام');
  if (camp.state !== 'بسته') {
    var tr = tgCpTier_(camp, now);
    if (tr.amount) {
      var line = '\n💳 <b>شهریهٔ ماهانه در ' + tgEsc_(tr.label) + ':</b> ' + tgCpMoney_(tr.amount) + ' در ماه';
      if (tr.until) line += '\nتا پایان ' + tgJDate_(tr.until, TG_TZ);
      if (tr.next) line += ' · بعد از آن ' + tgCpMoney_(tr.next.amount);
      t.push(line);
      if (camp.prepay) t.push('پیش‌پرداخت ' + tgCpMoney_(camp.prepay) + ' بخشی از شهریهٔ ماه اول است و پلهٔ شهریه را برایتان نگه می‌دارد. اگر در مصاحبه پذیرفته نشوید، کامل برمی‌گردد.');
      t.push('\n🎓 ' + TG_CP_PERK);
    }
  }
  var st = tgCpAt_(camp.start, '', false), dl = tgCpAt_(camp.deadline, '', true);
  var dates = [];
  if (st) dates.push('شروع دوره: ' + tgJDate_(st, TG_TZ));
  if (dl && camp.state !== 'بسته') dates.push('مهلت ثبت‌نام: ' + tgJDate_(dl, TG_TZ));
  if (dates.length) t.push('\n🗓 ' + dates.join(' · '));
  if (chat) {
    var lead = tgCpLead_(chat, camp.code);
    var nx = tgCpNextText_(camp, lead);
    if (nx) t.push('\n🧭 <b>مسیر شما</b>\n' + nx);
    else if (tgCpWebReg_(camp.code, chat) && w) t.push('\n✅ برای وبینار ثبت‌نام کرده‌اید. لینک ورود ده دقیقه قبل از شروع همین‌جا می‌آید.');
  }
  return t.join('\n');
}

function tgCpNextText_(camp, lead) {
  var s = tgCpStep_(camp, lead);
  if (s === 'none') return '';
  if (s === 'prereg') return 'در فهرست پیش‌ثبت‌نام هستید. هر وقت ثبت‌نام باز شد اول از همه خبرتان می‌کنیم.';
  if (s === 'pay_pre') return 'درخواستتان ثبت شد. قدم بعد پیش‌پرداخت ' + tgCpMoney_(camp.prepay) + ' است تا وقت مصاحبه را انتخاب کنید.';
  if (s === 'wait_pre') return 'پرداختتان رسید و در حال تأیید است. بعد از تأیید، وقت مصاحبه را همین‌جا انتخاب می‌کنید.';
  if (s === 'book') return 'پیش‌پرداخت تأیید شد. وقت مصاحبه را انتخاب کنید.';
  if (s === 'itv') {
    var sl = tgCpSlotOfLead_(tgCpS_(lead['شناسهٔ درخواست']));
    return 'مصاحبهٔ شما: ' + (sl && sl.at ? tgCpWhen_(sl.at, true) : '') + '. لینک جلسه را همین‌جا فرستاده‌ایم.';
  }
  if (s === 'pay_rest') return 'در مصاحبه پذیرفته شدید. برای قطعی شدن جا، ماندهٔ شهریهٔ ماه اول (' + tgCpMoney_(tgCpRest_(camp, lead)) + ') را بپردازید.';
  if (s === 'wait_rest') return 'پرداخت ماندهٔ ماه اول رسید و در حال تأیید است.';
  if (s === 'done') return 'ثبت‌نامتان کامل است. خوش آمدید.';
  if (s === 'cond') return 'پذیرش شما مشروط است. مسئول مدرسه برای قدم بعد با شما هماهنگ می‌کند.';
  if (s === 'result') return 'نتیجهٔ مصاحبه ثبت شده است.';
  return 'پرونده‌تان بسته شده است. اگر سؤالی دارید به @Tajrobeh_school پیام بدهید.';
}

function tgCpCardKb_(camp, chat) {
  var kb = [], c = camp.code, now = tgCpNow_();
  var lead = chat ? tgCpLead_(chat, c) : null;
  var step = tgCpStep_(camp, lead);
  var w = tgCpWebinar_(camp, now);
  if (w && !(chat && tgCpWebReg_(c, chat))) kb.push([{ text: '🎟 ثبت‌نام در وبینار رایگان', callback_data: 'cp:w:' + c }]);
  if (w && chat && tgCpWebReg_(c, chat) && camp.group) kb.push([{ text: '📺 لینک جلسه', url: camp.group }]);
  if (tgCpCanApply_(camp) && (step === 'none' || step === 'prereg')) kb.push([{ text: '📝 درخواست ثبت‌نام دوره', callback_data: 'cp:a:' + c }]);
  if (step === 'pay_pre' || step === 'pay_rest') kb.push([{ text: '💳 پرداخت', callback_data: 'cp:p:' + c }]);
  if (step === 'book') kb.push([{ text: '🗓 انتخاب وقت مصاحبه', callback_data: 'cp:b:' + c }]);
  if (!tgCpCanApply_(camp) && step === 'none') kb.push([{ text: '🔔 خبرم کن وقتی ثبت‌نام باز شد', callback_data: 'cp:z:' + c }]);
  var url = tgCpPageUrl_(camp);
  var last = [];
  if (url) last.push({ text: '🌐 صفحهٔ دوره', url: url });
  last.push({ text: '💌 کامیونیتی رایگان', callback_data: 'cp:c' });
  kb.push(last);
  return { inline_keyboard: kb };
}

function tgCpShow_(chat, camp) { return tgSend_(chat, tgCpCardText_(camp, chat), tgCpCardKb_(camp, chat)); }

/* فهرست دوره‌هایی که الان کمپین دارند */
function tgCpList_(chat) {
  var cs = tgCpCamps_().filter(function (c) { return c.state !== 'بسته'; });
  if (!cs.length) return tgSend_(chat, 'الان دوره‌ای در حال ثبت‌نام نیست. با عضویت در کامیونیتی از دورهٔ بعد زودتر باخبر می‌شوید.',
                                 { inline_keyboard: [[{ text: '💌 کامیونیتی رایگان', callback_data: 'cp:c' }]] });
  if (cs.length === 1) return tgCpShow_(chat, cs[0]);
  var kb = cs.map(function (c) { return [{ text: c.course + ' · ' + c.state, callback_data: 'cp:v:' + c.code }]; });
  return tgSend_(chat, '🎯 دوره‌هایی که الان ثبت‌نام یا وبینار دارند:', { inline_keyboard: kb });
}

/* ---------- ورود از لینک ---------- */

function tgCpStart_(chat, arg, uname) {
  var a = tgCpS_(arg), m, camp = null, act = '';
  if ((m = a.match(/^(cp|web|app|pre)[_-]([A-Za-z]+-?\d+)(?:[_-](.*))?$/i))) {
    camp = tgCpFind_(m[2].toUpperCase().replace(/^([A-Z]+)(\d)/, '$1-$2'));
    act = m[1].toLowerCase();
    if (m[3] && !TG_DRY) tgSetVal_('esrc', chat, m[3]);
  } else {
    camp = tgCpFind_(a);
  }
  if (!camp) return false;
  try { tgLogStart_(a, chat); } catch (e) {}
  if (!TG_DRY) tgSetVal_('cpsrc' + camp.code, chat, a);
  if (act === 'web' && tgCpWebinar_(camp)) return tgCpAsk_(chat, camp, 'w', uname), true;
  if (act === 'app' && tgCpCanApply_(camp)) return tgCpAsk_(chat, camp, 'a', uname), true;
  if (act === 'pre') return tgCpAsk_(chat, camp, 'z', uname), true;
  tgCpShow_(chat, camp);
  return true;
}

/* ---------- گرفتن نام و شماره، فقط اگر نداریم ---------- */

function tgCpKnown_(chat) {
  var o = { name: '', phone: '', user: '' };
  try {
    var p = tgWhoPerson_(chat, '');
    if (p) { o.name = p.name || ''; o.phone = p.phone || ''; o.user = p.user ? '@' + p.user : ''; }
  } catch (e) {}
  var rows = tgCpRead_(TG_SCH_T_REQ);
  for (var i = rows.length - 1; i >= 0 && (!o.name || !o.phone); i--) {
    if (tgCpS_(rows[i]['chat_id']) !== String(chat)) continue;
    if (!o.name) o.name = tgCpS_(rows[i]['نام کامل']);
    if (!o.phone) o.phone = tgCpS_(rows[i]['شمارهٔ تماس']);
  }
  var ev = tgCpRead_(TG_EVR_TAB);
  for (var j = ev.length - 1; j >= 0 && (!o.name || !o.phone); j--) {
    if (tgCpS_(ev[j]['chat_id']) !== String(chat)) continue;
    if (!o.name) o.name = tgCpS_(ev[j]['نام']);
    if (!o.phone) o.phone = tgCpS_(ev[j]['شماره']);
  }
  return o;
}

function tgCpAsk_(chat, camp, act, uname) {
  var k = tgCpKnown_(chat);
  var d = { code: camp.code, act: act, name: k.name, phone: k.phone, user: uname || k.user || '' };
  if (d.name && d.phone) return tgCpDo_(chat, d);
  d.step = d.name ? 'phone' : 'name';
  tgSetVal_('cpn', chat, JSON.stringify(d));
  if (d.step === 'name') {
    var why = act === 'w' ? 'برای ثبت‌نام وبینار' : (act === 'z' ? 'برای پیش‌ثبت‌نام' : 'برای درخواست ثبت‌نام');
    return tgSend_(chat, why + ' نام و نام خانوادگی‌تان را کامل بنویسید.', { keyboard: [['↩️ بازگشت']], resize_keyboard: true });
  }
  return tgCpAskPhone_(chat);
}

function tgCpAskPhone_(chat) {
  return tgSend_(chat, 'شمارهٔ تماستان را بفرستید. دکمهٔ زیر همین کار را می‌کند.',
    { keyboard: [[{ text: '📱 فرستادن شماره', request_contact: true }], ['↩️ بازگشت']], resize_keyboard: true, one_time_keyboard: true });
}

function tgCpNameText_(chat, text) {
  var raw = tgGetVal_('cpn', chat);
  if (!raw) return false;
  var d; try { d = JSON.parse(raw); } catch (e) { tgDel_('cpn', chat); return false; }
  var t = tgCpS_(text);
  if (!t) return false;
  if (t === '↩️ بازگشت' || t === 'انصراف' || t.indexOf('/') === 0 || tgIsBtnLike_(t)) { tgDel_('cpn', chat); return false; }   /* v166.24: دکمهٔ منو نام نیست */
  if (d.step === 'name') {
    if (t.length < 5 || t.split(/\s+/).length < 2) { tgSend_(chat, 'کمی کامل‌تر بنویسید، نام و نام خانوادگی.'); return true; }
    d.name = t; d.step = 'phone';
    tgSetVal_('cpn', chat, JSON.stringify(d));
    tgCpAskPhone_(chat);
    return true;
  }
  if (d.step === 'phone') {
    if (!tgLooksLikePhone_(t)) { tgSend_(chat, 'این شماره درست به نظر نمی‌رسد. یک بار دیگر بنویسید یا دکمه را بزنید.'); return true; }
    d.phone = tgLatinDigits_(t);
    tgDel_('cpn', chat);
    tgCpDo_(chat, d);
    return true;
  }
  return false;
}

/* کانتکت وسط همین مسیر: نباید لید کلینیک بسازد (دام ۱۲) */
function tgCpContact_(chat, contact) {
  var raw = tgGetVal_('cpn', chat);
  if (!raw) return false;
  var d; try { d = JSON.parse(raw); } catch (e) { return false; }
  if (contact.user_id && String(contact.user_id) !== String(chat)) { tgSend_(chat, 'شمارهٔ خودتان را بفرستید، نه کس دیگری را.'); return true; }
  d.phone = String(contact.phone_number || '');
  if (!d.name) d.name = [contact.first_name, contact.last_name].filter(String).join(' ');
  tgDel_('cpn', chat);
  tgCpDo_(chat, d);
  return true;
}

function tgCpDo_(chat, d) {
  var camp = tgCpFind_(d.code);
  if (!camp) return tgSend_(chat, 'این دوره پیدا نشد.', tgMenu_());
  tgSend_(chat, 'ممنون، ثبت شد.', { remove_keyboard: true });
  if (d.act === 'w') return tgCpWebJoin_(chat, camp, d);
  if (d.act === 'a') return tgCpApply_(chat, camp, d);
  if (d.act === 'z') return tgCpPre_(chat, camp, d);
  return tgCpShow_(chat, camp);
}

/* ---------- وبینار ---------- */

function tgCpWebJoin_(chat, camp, d) {
  var w = tgCpWebinar_(camp);
  if (!w) return tgSend_(chat, 'الان وبیناری برای این دوره در برنامه نیست.', tgCpCardKb_(camp, chat));
  var evc = camp.code + '/' + w.id;
  var srcW = TG_DRY ? '' : (tgGetVal_('cpsrc' + camp.code, chat) || tgGetVal_('esrc', chat) || '');
  if (!tgCpWebReg_(camp.code, chat)) {
    tgCpAdd_(TG_EVR_TAB, { 'تاریخ ثبت': tgJDateFull_(new Date(), TG_TZ), 'کد رویداد': evc, 'عنوان رویداد': w.title,
      'نام': d.name, 'شماره': d.phone, 'نقش': 'دانشجو', 'کد منبع': srcW,
      'کانال': 'بات', 'chat_id': String(chat), 'وضعیت': 'ثبت شد' });
  }
  /* v142: ثبت‌نام وبینار یک لید مدرسه است، همان لحظه در تب اصلی */
  try { tgSchLeadEnsure_({ chat: chat, name: d.name, phone: d.phone, user: d.user, camp: camp.code, course: camp.course, circle: camp.circle,
                           stage: TG_SCH_STAGES[TG_SCH_SG.web], web: 'ثبت‌نام', src: srcW || 'بات', memo: 'از بات · وبینار ' + camp.code, reopen: false }); } catch (eL) { tgErr_('web ensure: ' + eL); }
  var cal = tgCpCalUrl_(w.title, w.at, TG_CP_WEB_MIN, 'لایو تلگرام · لینک ورود ده دقیقه قبل از شروع در بات تجربه می‌آید: https://t.me/tajrobehlife_bot');
  var kb = [];
  if (camp.group) kb.push([{ text: '👥 عضویت در گروه وبینار', url: camp.group }]);
  if (cal) kb.push([{ text: '📅 افزودن به تقویم', url: cal }]);
  if (tgCpCanApply_(camp)) kb.push([{ text: '📝 همین حالا درخواست ثبت‌نام دوره', callback_data: 'cp:a:' + camp.code }]);
  return tgSend_(chat, '✅ <b>برای وبینار ثبت‌نام شدید</b>\n\n' + tgEsc_(w.title) + '\n' + tgCpWhen_(w.at, true) +
    ' به وقت تهران\n\nوبینار به‌صورت لایو در گروه تلگرام برگزار می‌شود. یک روز قبل، دو ساعت قبل و ده دقیقه قبل همین‌جا یادآوری می‌کنیم.',
    { inline_keyboard: kb });
}

/* دکمهٔ «ورود به وبینار»: حضور ثبت می‌شود و لینک گروه می‌آید */
function tgCpWebEnter_(chat, camp, from) {
  var r = tgCpWebReg_(camp.code, chat);
  var w = tgCpWebinar_(camp) || tgCpLastWebinar_(camp);
  if (!r) {
    var k = tgCpKnown_(chat);
    var nm = k.name || [from && from.first_name, from && from.last_name].filter(String).join(' ');
    tgCpAdd_(TG_EVR_TAB, { 'تاریخ ثبت': tgJDateFull_(new Date(), TG_TZ), 'کد رویداد': camp.code + '/' + (w ? w.id : ''),
      'عنوان رویداد': w ? w.title : '', 'نام': nm, 'شماره': k.phone, 'نقش': 'دانشجو', 'کد منبع': 'ورود مستقیم',
      'کانال': 'بات', 'chat_id': String(chat), 'وضعیت': 'حاضر' });
  } else if (tgCpS_(r['وضعیت']) !== 'حاضر') {
    tgCpSet_(TG_EVR_TAB, r._row, { 'وضعیت': 'حاضر' });
  }
  /* v142: حضور در وبینار مرحلهٔ سطر اصلی را جلو می‌برد */
  try {
    var k2 = tgCpKnown_(chat);
    tgSchLeadEnsure_({ chat: chat, name: k2.name || (from ? [from.first_name, from.last_name].filter(String).join(' ') : ''), phone: k2.phone,
                       camp: camp.code, course: camp.course, circle: camp.circle, stage: TG_SCH_STAGES[TG_SCH_SG.came], web: 'حاضر',
                       src: 'ورود مستقیم', reopen: false });
    var lead = tgCpLead_(chat, camp.code);
    if (lead && !tgCpS_(lead['تاریخ روز باز'])) tgCpLeadSet_(lead._row, { 'تاریخ روز باز': tgSchToday_() }, 'بات');
  } catch (e) { tgErr_('enter ensure: ' + e); }
  if (!camp.group) return tgSend_(chat, 'حضورتان ثبت شد. لینک گروه هنوز در هاب نیامده؛ همین حالا به مدرسه خبر دادیم.'),
                        tgCpTell_('⚠️ لینک گروه وبینار ' + camp.code + ' در تب کمپین‌ها خالی است.');
  return tgSend_(chat, '📺 خوش آمدید. با دکمهٔ زیر وارد جلسه شوید.',
                 { inline_keyboard: [[{ text: '📺 ورود به لایو', url: camp.group }]] });
}

/* ---------- درخواست ثبت‌نام و پیش‌ثبت‌نام ---------- */

/* v142: همهٔ سطرسازی‌های کمپین از tgSchLeadEnsure_ می‌گذرد (یک نفر × یک کمپین = یک سطر) */
function tgCpNewLead_(chat, camp, d, status, note, stage) {
  var src = TG_DRY ? '' : (tgGetVal_('cpsrc' + camp.code, chat) || tgGetVal_('esrc', chat) || 'بات');
  var campCode = status === TG_SCH_ST_PRE && camp.state === 'بسته' ? camp.ccode + '-بعدی' : camp.code;
  var r = tgSchLeadEnsure_({ chat: chat, name: d.name || '', user: d.user || '', phone: d.phone || '', camp: campCode,
    course: camp.course, circle: camp.circle, status: status, stage: stage || TG_SCH_STAGES[TG_SCH_SG.lead],
    note: note || '', memo: 'از بات · کمپین ' + camp.code, owner: camp.follow, src: src });
  tgCpDrop_();
  return r;
}

function tgCpApply_(chat, camp, d) {
  if (!tgCpCanApply_(camp)) return tgCpShow_(chat, camp);
  var lead = tgCpLead_(chat, camp.code);
  var step = tgCpStep_(camp, lead);
  if (lead && step !== 'none' && step !== 'prereg') return tgCpShow_(chat, camp);
  var r = tgCpNewLead_(chat, camp, d, TG_SCH_ST_OPEN, 'درخواست ثبت‌نام ' + camp.code, TG_SCH_STAGES[TG_SCH_SG.apply]);
  try {
    tgCpTell_('🎯 متقاضی تازهٔ ' + tgEsc_(camp.code) + ': <b>' + tgEsc_(d.name || '') + '</b>');
    if (!TG_DRY) tgCpOwners_().forEach(function (c) { tgSlCardSend_(c, r.row); });
  } catch (e) { tgErr_('tgCpApply_: ' + e); }
  var tr = tgCpTier_(camp);
  var txt = '✅ <b>درخواستتان برای ' + tgEsc_(camp.course) + ' ثبت شد</b>\n\n';
  if (camp.prepay) {
    txt += 'قدم بعد پیش‌پرداخت است: ' + tgCpMoney_(camp.prepay) + '.\n' +
      'این مبلغ بخشی از شهریهٔ ماه اول است و شهریهٔ ماهانهٔ ' + tgEsc_(tr.label) + ' (' + tgCpMoney_(tr.amount) + ' در ماه) را برایتان نگه می‌دارد. ' +
      'اگر در مصاحبه پذیرفته نشوید، کامل برمی‌گردد.\n\nبعد از تأیید پرداخت، وقت مصاحبه را همین‌جا انتخاب می‌کنید.';
    return tgSend_(chat, txt, tgCpPayKb_(camp, 'pre'));
  }
  txt += 'قدم بعد انتخاب وقت مصاحبه است.';
  return tgSend_(chat, txt, { inline_keyboard: [[{ text: '🗓 انتخاب وقت مصاحبه', callback_data: 'cp:b:' + camp.code }]] });
}

function tgCpPre_(chat, camp, d) {
  var lead = tgCpLead_(chat, camp.code);
  if (!lead) tgCpNewLead_(chat, camp, d, TG_SCH_ST_PRE, 'پیش‌ثبت‌نام ' + camp.code, TG_SCH_STAGES[TG_SCH_SG.lead]);
  return tgSend_(chat, '🔔 ثبت شد. هر وقت ثبت‌نام ' + tgEsc_(camp.course) + ' باز شد، اول از همه همین‌جا خبرتان می‌کنیم.\n\n' +
    'تا آن وقت، کامیونیتی تجربه رایگان است و رویدادها و ضبط‌ها را زودتر از همه می‌گیرید.',
    { inline_keyboard: [[{ text: '💌 کامیونیتی رایگان', callback_data: 'cp:c' }]] });
}

/* ---------- پرداخت با تأیید یاسر ---------- */

function tgCpPayKb_(camp, kind) {
  var kb = [];
  if (camp.payurl) kb.push([{ text: '💳 رفتن به صفحهٔ پرداخت', url: camp.payurl }]);
  kb.push([{ text: '✅ پرداخت کردم', callback_data: 'cp:pd:' + camp.code + ':' + kind }]);
  return { inline_keyboard: kb };
}

function tgCpPayShow_(chat, camp) {
  var lead = tgCpLead_(chat, camp.code);
  var step = tgCpStep_(camp, lead);
  if (step === 'pay_pre') {
    return tgSend_(chat, '💳 <b>پیش‌پرداخت ' + tgEsc_(camp.course) + '</b>\n\nمبلغ: ' + tgCpMoney_(camp.prepay) +
      '\nروی «رفتن به صفحهٔ پرداخت» بزنید، همین مبلغ را بپردازید و بعد «پرداخت کردم» را بزنید.', tgCpPayKb_(camp, 'pre'));
  }
  if (step === 'pay_rest') {
    return tgSend_(chat, '💳 <b>ماندهٔ شهریهٔ ماه اول ' + tgEsc_(camp.course) + '</b>\n\nمبلغ: ' + tgCpMoney_(tgCpRest_(camp, lead)) +
      '\nروی «رفتن به صفحهٔ پرداخت» بزنید، همین مبلغ را بپردازید و بعد «پرداخت کردم» را بزنید.', tgCpPayKb_(camp, 'rest'));
  }
  return tgCpShow_(chat, camp);
}

function tgCpPaidAsk_(chat, camp, kind) {
  tgSetVal_('cpp', chat, JSON.stringify({ code: camp.code, kind: kind }));
  return tgSend_(chat, 'کد پیگیری پرداخت را بنویسید، یا عکس رسید را بفرستید.\nاگر کد ندارید، ساعت پرداخت و چهار رقم آخر کارت کافی است.',
                 { keyboard: [['↩️ بازگشت']], resize_keyboard: true });
}

/* متن یا عکس رسید ← سطر پرداخت «منتظر تأیید یاسر» و کارت برای یاسر */
function tgCpPaidIn_(chat, m) {
  var raw = tgGetVal_('cpp', chat);
  if (!raw) return false;
  var d; try { d = JSON.parse(raw); } catch (e) { tgDel_('cpp', chat); return false; }
  var t = tgCpS_(m.text || m.caption);
  if (!m.photo && !m.document && (t === '↩️ بازگشت' || t === 'انصراف' || t.indexOf('/') === 0)) { tgDel_('cpp', chat); return false; }
  if (!m.photo && !m.document && t.length < 3) { tgSend_(chat, 'کد پیگیری یا عکس رسید را بفرستید.'); return true; }
  tgDel_('cpp', chat);
  var camp = tgCpFind_(d.code);
  var lead = tgCpLead_(chat, d.code);
  if (!camp || !lead) { tgSend_(chat, 'درخواستتان پیدا نشد. به @Tajrobeh_school پیام بدهید.', tgMenu_()); return true; }
  var old = tgCpPayOf_(tgCpS_(lead['شناسهٔ درخواست']), d.kind);
  if (old && tgCpS_(old['وضعیت']) !== TG_CP_PAY.no) { tgSend_(chat, 'این پرداخت قبلاً ثبت شده و ' + tgCpS_(old['وضعیت']) + ' است.', { remove_keyboard: true }); return true; }
  var tr = tgCpTier_(camp);
  var amount = d.kind === 'pre' ? camp.prepay : tgCpRest_(camp, lead);
  var tierTxt = d.kind === 'pre' ? (tr.label + ' · ' + tr.amount) : tgCpS_(lead['پلهٔ قیمت']);
  var pid = tgCpNext_(TG_CPP_TAB, 'کد پرداخت', 'PAY', 3);
  var desc = t || (m.photo ? 'عکس رسید' : 'فایل رسید');
  tgCpAdd_(TG_CPP_TAB, { 'کد پرداخت': pid, 'زمان ثبت': tgJDateFull_(new Date(), TG_TZ) + ' ' + Utilities.formatDate(new Date(), TG_TZ, 'HH:mm'),
    'کد درخواست': tgCpS_(lead['شناسهٔ درخواست']), 'نام': tgCpS_(lead['نام کامل']), 'chat_id': String(chat), 'کد کمپین': camp.code,
    'نوع': TG_CP_KIND[d.kind], 'پلهٔ قیمت': tierTxt, 'مبلغ (تومان)': amount, 'توضیح پرداخت‌کننده': desc, 'وضعیت': TG_CP_PAY.wait });
  var ch = { 'وضعیت پرداخت': TG_CP_KIND[d.kind] + ' منتظر تأیید' };
  if (d.kind === 'pre') ch['پلهٔ قیمت'] = tierTxt;
  tgCpLeadSet_(lead._row, ch, 'بات');
  var card = '💳 <b>پرداخت تازه · ' + pid + '</b>\n' + tgEsc_(tgCpS_(lead['نام کامل'])) + ' · ' + camp.code + ' · ' + TG_CP_KIND[d.kind] +
    '\nمبلغ: ' + tgCpMoney_(amount) + (d.kind === 'pre' ? '\nپله: ' + tgEsc_(tr.label) + ' (' + tgCpMoney_(tr.amount) + ')' : '') +
    '\nتوضیح پرداخت‌کننده: ' + tgEsc_(desc) + '\n\nدر پنل پیکان ببینید و اینجا تأیید یا رد کنید.';
  tgSend_(TG_CP_YASER, card, { inline_keyboard: [[{ text: '✅ تأیید', callback_data: 'cp:y:' + pid + ':ok' },
                                                   { text: '❌ رد', callback_data: 'cp:y:' + pid + ':no' }]] });
  if (m.photo && !TG_DRY) {
    try { tgApi_('copyMessage', { chat_id: TG_CP_YASER, from_chat_id: chat, message_id: m.message_id, caption: 'رسید ' + pid }); } catch (e2) {}
  }
  tgSend_(chat, '🙏 رسید. بعد از تأیید پرداخت همین‌جا خبرتان می‌کنیم؛ معمولاً همان روز.', { remove_keyboard: true });
  return true;
}

function tgCpPayRow_(pid) {
  var ps = tgCpRead_(TG_CPP_TAB);
  for (var i = 0; i < ps.length; i++) if (tgCpS_(ps[i]['کد پرداخت']) === pid) return ps[i];
  return null;
}

function tgCpPayDecide_(chat, pid, ok, msgId) {
  if (String(chat) !== TG_CP_YASER && !(TG_DRY && TG_MEM['cp:yaserok'])) return tgSend_(chat, 'تأیید پرداخت فقط با یاسر است.');
  var p = tgCpPayRow_(pid);
  if (!p) return tgSend_(chat, 'این پرداخت پیدا نشد: ' + pid);
  if (tgCpS_(p['وضعیت']) !== TG_CP_PAY.wait) return tgSend_(chat, pid + ' قبلاً ' + tgCpS_(p['وضعیت']) + '.');
  var now = tgJDateFull_(new Date(), TG_TZ) + ' ' + Utilities.formatDate(new Date(), TG_TZ, 'HH:mm');
  tgCpSet_(TG_CPP_TAB, p._row, { 'وضعیت': ok ? TG_CP_PAY.ok : TG_CP_PAY.no, 'تأییدکننده': 'یاسر', 'زمان تأیید': now });
  if (typeof opsAdaptDone_ === 'function') opsAdaptDone_(pid, !ok);
  var camp = tgCpFind_(tgCpS_(p['کد کمپین']));
  var lead = tgCpLeadById_(tgCpS_(p['کد درخواست']));
  var kind = tgCpS_(p['نوع']) === TG_CP_KIND.pre ? 'pre' : 'rest';
  var stu = tgCpS_(p['chat_id']);
  if (msgId && !TG_DRY) {
    try { tgApi_('editMessageReplyMarkup', { chat_id: chat, message_id: msgId, reply_markup: { inline_keyboard: [[{ text: ok ? '✅ تأیید شد' : '❌ رد شد', callback_data: 'cp:nop' }]] } }); } catch (e) {}
  }
  if (!ok) {
    if (lead) tgCpLeadSet_(lead._row, { 'وضعیت پرداخت': TG_CP_KIND[kind] + ' تأیید نشد' }, 'یاسر');
    tgSend_(stu, 'پرداختتان هنوز در سامانه دیده نشده است. مسئول مدرسه همین امروز با شما هماهنگ می‌کند. اگر رسید دیگری دارید همین‌جا بفرستید.',
            camp ? tgCpPayKb_(camp, kind) : null);
    tgCpTell_('❌ پرداخت ' + pid + ' (' + tgEsc_(tgCpS_(p['نام'])) + ') تأیید نشد. لطفاً با متقاضی تماس بگیرید.');
    return tgSend_(chat, pid + ' رد شد و به متقاضی و مدرسه خبر دادیم.');
  }
  if (kind === 'pre') {
    if (lead) tgCpLeadSet_(lead._row, { 'وضعیت پرداخت': 'پیش‌پرداخت تأیید شد', 'مرحلهٔ قیف': TG_SCH_STAGES[TG_SCH_SG.pre] }, 'یاسر');
    tgSend_(stu, '✅ <b>پیش‌پرداختتان تأیید شد.</b>\n\nحالا وقت مصاحبه را انتخاب کنید. مصاحبه گفت‌وگویی کوتاه و آنلاین با یکی از استادهای دوره است.',
            { inline_keyboard: [[{ text: '🗓 انتخاب وقت مصاحبه', callback_data: 'cp:b:' + tgCpS_(p['کد کمپین']) }]] });
  } else {
    if (lead) {
      tgCpLeadSet_(lead._row, { 'وضعیت پرداخت': 'پرداخت کامل', 'وضعیت': TG_SCH_ST_DONE, 'مرحلهٔ قیف': TG_SCH_STAGES[TG_SCH_SG.done] }, 'یاسر');
      if (camp) tgCpEnroll_(camp, lead);
    }
    tgSend_(stu, '🎉 <b>ثبت‌نامتان کامل شد.</b>\n\nخوش آمدید. برنامهٔ جلسه‌ها و لینک کلاس را پیش از شروع دوره همین‌جا می‌فرستیم. ' +
                 'از «تغییر نقش» یا /start می‌توانید وارد بخش دانشجو شوید.');
  }
  tgCpTell_('✅ پرداخت ' + pid + ' تأیید شد · ' + tgEsc_(tgCpS_(p['نام'])) + ' · ' + tgCpS_(p['نوع']));
  return tgSend_(chat, pid + ' تأیید شد.');
}

/* عضویت دانشجو + نقش دانشجو در «افراد» */
function tgCpEnroll_(camp, lead) {
  var chat = tgCpS_(lead['chat_id']);
  var label = camp.ccode + '-' + tgFa_(camp.circle);
  try {
    if (!tgSchHasMember_(chat, camp.course, camp.circle)) {
      tgSchAddMember_({ name: tgCpS_(lead['نام کامل']), user: tgCpS_(lead['یوزرنیم تلگرام']), chat: chat, course: camp.course,
        circle: camp.circle, ccode: label, role: 'دانشجو', phone: tgCpS_(lead['شمارهٔ تماس']), src: 'کمپین ' + camp.code });
    }
    var p = TG_DRY ? null : tgWhoPerson_(chat, '');
    if (p) { p.chatNew = chat; tgSchGrantRole_(p, 'دانشجو', label); }
    else tgSchNewPerson_({ name: tgCpS_(lead['نام کامل']), user: tgCpS_(lead['یوزرنیم تلگرام']), chat: chat, role: 'دانشجو',
                           circle: label, phone: tgCpS_(lead['شمارهٔ تماس']), note: 'کمپین ' + camp.code });
  } catch (e) { tgErr_('tgCpEnroll_: ' + e); }
  try { tgCpWelcome_(camp, lead, chat); } catch (e2) { tgErr_('tgCpWelcome_: ' + e2); }
}

/* ---------- مصاحبه: رزرو دانشجو ---------- */

function tgCpFree_(camp) {
  var now = tgCpNow_();
  return tgCpSlots_(camp.code).filter(function (s) {
    return tgCpS_(s['وضعیت']) === 'آزاد' && s.at && s.at.getTime() > now.getTime() + 2 * 3600000;
  }).sort(function (a, b) { return a.at - b.at; });
}

function tgCpBookList_(chat, camp) {
  var lead = tgCpLead_(chat, camp.code);
  var step = tgCpStep_(camp, lead);
  if (step !== 'book') return tgCpShow_(chat, camp);
  var free = tgCpFree_(camp);
  if (!free.length) {
    tgCpTell_('⏳ ' + tgEsc_(tgCpS_(lead['نام کامل'])) + ' (' + camp.code + ') منتظر وقت مصاحبه است و وقت آزادی نداریم. از مصاحبه‌گرها بخواهید وقت اعلام کنند.');
    return tgSend_(chat, 'همین حالا وقت آزادی برای مصاحبه نمانده است. تا یک روز کاری وقت تازه اضافه می‌شود و همین‌جا خبرتان می‌کنیم.');
  }
  var kb = [];
  for (var i = 0; i < free.length && i < 10; i++) {
    kb.push([{ text: tgCpWhen_(free[i].at, true), callback_data: 'cp:k:' + tgCpS_(free[i]['کد']) }]);
  }
  return tgSend_(chat, '🗓 <b>وقت مصاحبه</b>\n\nمصاحبه آنلاین و حدود ' + tgFa_(TG_CP_IV_MIN) + ' دقیقه است. یکی را انتخاب کنید:', { inline_keyboard: kb });
}

function tgCpSlotRow_(code) {
  var all = tgCpRead_(TG_CPI_TAB);
  for (var i = 0; i < all.length; i++) if (tgCpS_(all[i]['کد']) === code) { all[i].at = tgCpAt_(all[i]['تاریخ'], all[i]['ساعت'], false); return all[i]; }
  return null;
}

function tgCpBook_(chat, slotCode) {
  var s = tgCpSlotRow_(slotCode);
  if (!s) return tgSend_(chat, 'این وقت پیدا نشد.');
  var camp = tgCpFind_(tgCpS_(s['کد کمپین']));
  var lead = camp ? tgCpLead_(chat, camp.code) : null;
  if (!camp || !lead || tgCpStep_(camp, lead) !== 'book') return camp ? tgCpShow_(chat, camp) : null;
  var lock = null;
  if (!TG_DRY) { lock = LockService.getScriptLock(); try { lock.waitLock(8000); } catch (e) {} tgCpDrop_(); s = tgCpSlotRow_(slotCode); }
  if (!s || tgCpS_(s['وضعیت']) !== 'آزاد') {
    if (lock) lock.releaseLock();
    tgSend_(chat, 'این وقت همین الان پر شد. یکی دیگر را انتخاب کنید.');
    return tgCpBookList_(chat, camp);
  }
  var id = tgCpS_(lead['شناسهٔ درخواست']);
  tgCpSet_(TG_CPI_TAB, s._row, { 'وضعیت': 'رزرو شد', 'کد درخواست': id, 'نام متقاضی': tgCpS_(lead['نام کامل']),
    'chat_id متقاضی': String(chat), 'زمان رزرو': tgJDateFull_(new Date(), TG_TZ) });
  if (lock) { SpreadsheetApp.flush(); lock.releaseLock(); }
  tgCpLeadSet_(lead._row, { 'تاریخ مصاحبه': tgCpJText_(tgJalali_(s.at, TG_TZ)) + ' ' + tgFa_(tgCpHM_(s['ساعت'])),
                        'مرحلهٔ قیف': TG_SCH_STAGES[TG_SCH_SG.itv] }, 'بات');
  var iv = tgCpS_(s['مصاحبه‌گر']);
  var link = tgCpS_(s['لینک جلسه']) || tgCpIvLink_(iv);
  var cal = tgCpCalUrl_('مصاحبهٔ پذیرش ' + camp.course, s.at, TG_CP_IV_MIN, link ? 'لینک جلسه: ' + link : '');
  var kb = [];
  if (link) kb.push([{ text: '🎥 لینک جلسه', url: link }]);
  if (cal) kb.push([{ text: '📅 افزودن به تقویم', url: cal }]);
  tgSend_(chat, '✅ <b>وقت مصاحبه‌تان ثبت شد</b>\n\n' + tgCpWhen_(s.at, true) + ' به وقت تهران\nمصاحبه‌گر: ' + tgEsc_(iv) +
    (link ? '' : '\nلینک جلسه را پیش از مصاحبه همین‌جا می‌فرستیم.') + '\n\nدو ساعت قبل یادآوری می‌کنیم.', kb.length ? { inline_keyboard: kb } : null);
  var ivc = tgCpIvChat_(iv);
  var card = '🎤 <b>مصاحبهٔ تازه · ' + tgCpS_(s['کد']) + '</b>\n' + tgEsc_(tgCpS_(lead['نام کامل'])) + ' · ' + camp.code +
    '\n' + tgCpWhen_(s.at, true) + (tgCpS_(lead['رشته و دانشگاه']) ? '\nرشته: ' + tgEsc_(tgCpS_(lead['رشته و دانشگاه'])) : '') +
    (tgCpS_(lead['توضیح متقاضی']) ? '\nتوضیح: ' + tgEsc_(tgCpS_(lead['توضیح متقاضی'])) : '');
  if (ivc) {
    var rkb = tgCpResKb_(tgCpS_(s['کد']));
    if (id) rkb.inline_keyboard.unshift([{ text: '📄 فرم کامل متقاضی', callback_data: 'cp:eft:' + id }]);
    tgSend_(ivc, card + '\n\nبعد از مصاحبه نتیجه را با یکی از دکمه‌ها ثبت کنید.', rkb);
  }
  else tgCpTell_('⚠️ مصاحبه‌گر «' + tgEsc_(iv) + '» به بات وصل نیست. ' + card.replace('🎤 ', ''));
  tgCpTell_('🗓 مصاحبه رزرو شد · ' + tgEsc_(tgCpS_(lead['نام کامل'])) + ' · ' + tgCpWhen_(s.at, true) + ' · ' + tgEsc_(iv));
  return true;
}

function tgCpResKb_(slot) {
  return { inline_keyboard: [
    [{ text: '✅ پذیرش کامل', callback_data: 'cp:r:' + slot + ':full' }, { text: '🟡 پذیرش مشروط', callback_data: 'cp:r:' + slot + ':cond' }],
    [{ text: '⛔ عدم پذیرش', callback_data: 'cp:r:' + slot + ':no' }, { text: '🚫 نیامد', callback_data: 'cp:r:' + slot + ':absent' }]
  ] };
}

/* نتیجهٔ مصاحبه، فقط از مصاحبه‌گر همان وقت یا مسئولان مدرسه */
function tgCpResult_(chat, uname, slotCode, res) {
  var s = tgCpSlotRow_(slotCode);
  if (!s) return tgSend_(chat, 'این مصاحبه پیدا نشد.');
  var who = tgCpIvWho_(chat, uname);
  var mine = who && tgNorm_(who.name) === tgNorm_(tgCpS_(s['مصاحبه‌گر']));
  if (!mine && !tgCpIsOwner_(chat)) return tgSend_(chat, 'ثبت نتیجه با مصاحبه‌گر همین جلسه است.');
  var label = TG_CP_IV_RES[res];
  if (!label) return null;
  var camp = tgCpFind_(tgCpS_(s['کد کمپین']));
  var lead = tgCpLeadById_(tgCpS_(s['کد درخواست']));
  if (!camp || !lead) return tgSend_(chat, 'متقاضی این وقت پیدا نشد.');
  var me = who ? who.name : 'مدرسه';
  tgCpSet_(TG_CPI_TAB, s._row, { 'وضعیت': res === 'absent' ? 'غیبت' : 'برگزار شد', 'نتیجه': label,
    'ثبت نتیجه توسط': me, 'زمان ثبت نتیجه': tgJDateFull_(new Date(), TG_TZ) });
  var stu = tgCpS_(lead['chat_id']);
  if (res === 'absent') {
    tgCpLeadSet_(lead._row, { 'نتیجهٔ مصاحبه': 'غیبت' }, me);
    tgSend_(stu, 'جای شما در مصاحبه خالی بود. اگر مشکلی پیش آمده، یک وقت دیگر انتخاب کنید.',
            { inline_keyboard: [[{ text: '🗓 انتخاب وقت تازه', callback_data: 'cp:b:' + camp.code }]] });
  } else if (res === 'no') {
    tgCpLeadSet_(lead._row, { 'نتیجهٔ مصاحبه': label, 'وضعیت': 'عدم پذیرش' }, me);
    tgSend_(stu, 'ممنون از وقتی که برای مصاحبه گذاشتید. این بار ورود به ' + tgEsc_(camp.course) + ' جلو نرفت.\n\n' +
      (camp.prepay ? 'پیش‌پرداختتان کامل برمی‌گردد و مسئول مدرسه برای بازگرداندنش با شما هماهنگ می‌کند.\n\n' : '') +
      'کامیونیتی تجربه برایتان باز است و از دوره‌ها و رویدادهای بعدی زودتر باخبر می‌شوید.',
      { inline_keyboard: [[{ text: '💌 کامیونیتی رایگان', callback_data: 'cp:c' }]] });
    if (camp.prepay) tgCpTell_('↩️ بازگرداندن پیش‌پرداخت: ' + tgEsc_(tgCpS_(lead['نام کامل'])) + ' · ' + camp.code + ' · ' + tgCpMoney_(camp.prepay));
  } else if (res === 'cond') {
    tgCpLeadSet_(lead._row, { 'نتیجهٔ مصاحبه': label, 'وضعیت': TG_SCH_ST_COND, 'مرحلهٔ قیف': TG_SCH_STAGES[TG_SCH_SG.acc] }, me);
    tgSend_(stu, '🟡 <b>پذیرش شما مشروط است.</b>\n\nپیشنهاد مصاحبه‌گر این است که اول تراپی فردی را شروع کنید و بعد وارد دوره شوید. ' +
      'مسئول مدرسه برای قدم بعد و تکلیف پیش‌پرداخت همین هفته با شما هماهنگ می‌کند.');
    tgCpTell_('🟡 پذیرش مشروط · ' + tgEsc_(tgCpS_(lead['نام کامل'])) + ' · ' + camp.code + '. هماهنگی تراپی فردی و تکلیف پیش‌پرداخت با مدرسه.');
  } else {
    tgCpLeadSet_(lead._row, { 'نتیجهٔ مصاحبه': label, 'مرحلهٔ قیف': TG_SCH_STAGES[TG_SCH_SG.acc] }, me);
    var rest = tgCpRest_(camp, lead);
    tgSend_(stu, '🎉 <b>در مصاحبه پذیرفته شدید.</b>\n\nبرای قطعی شدن جایتان در ' + tgEsc_(camp.course) + '، ماندهٔ شهریهٔ ماه اول را بپردازید: ' +
      tgCpMoney_(rest) + '.\nشهریهٔ ماهانهٔ شما همان پله‌ای است که با پیش‌پرداخت قفل شد؛ ماه‌های بعد را مسئول مالی مدرسه هماهنگ می‌کند.\n\n🎓 ' + TG_CP_PERK, tgCpPayKb_(camp, 'rest'));
  }
  tgCpTell_('🎤 نتیجهٔ مصاحبهٔ ' + tgEsc_(tgCpS_(lead['نام کامل'])) + ': ' + label + ' (ثبت: ' + tgEsc_(me) + ')');
  return tgSend_(chat, '✅ نتیجه ثبت شد: ' + label);
}

/* ---------- میز مصاحبه‌گر ---------- */

function tgCpIvCamps_(name) {
  var n = tgNorm_(name);
  return tgCpCamps_().filter(function (c) { return c.state !== 'بسته' && (!n || tgNorm_(c.ivers).indexOf(n) > -1 || !c.ivers); });
}

function tgCpIvDesk_(chat, arg, uname) {
  var who = tgCpIvWho_(chat, uname);
  if (!who && !tgCpIsOwner_(chat)) return tgSend_(chat, 'این بخش برای مصاحبه‌گرهای مدرسه است.');
  var name = who ? who.name : '';
  var mine = [];
  tgCpRead_(TG_CPI_TAB).forEach(function (s) {
    if (name && tgNorm_(tgCpS_(s['مصاحبه‌گر'])) !== tgNorm_(name)) return;
    var at = tgCpAt_(s['تاریخ'], s['ساعت'], false);
    if (!at || at.getTime() < tgCpNow_().getTime() - 7 * 86400000) return;
    if (tgCpS_(s['وضعیت']) === 'لغو') return;
    s.at = at; mine.push(s);
  });
  mine.sort(function (a, b) { return a.at - b.at; });
  var lines = mine.slice(0, 12).map(function (s) {
    var st = tgCpS_(s['وضعیت']);
    return '• ' + tgCpWhen_(s.at, true) + ' · ' + (st === 'آزاد' ? 'آزاد' : tgEsc_(tgCpS_(s['نام متقاضی'])) + ' · ' + st +
           (tgCpS_(s['نتیجه']) ? ' · ' + tgCpS_(s['نتیجه']) : ''));
  });
  var kb = [[{ text: '➕ اعلام وقت مصاحبه', callback_data: 'cp:ia' }]];
  mine.forEach(function (s) {
    if (tgCpS_(s['وضعیت']) === 'رزرو شد' && s.at.getTime() < tgCpNow_().getTime() + 3600000) {
      kb.push([{ text: '📝 نتیجهٔ ' + tgCpS_(s['نام متقاضی']), callback_data: 'cp:rq:' + tgCpS_(s['کد']) }]);
    }
    if (tgCpS_(s['وضعیت']) === 'آزاد' && kb.length < 10) kb.push([{ text: '🗑 حذف ' + tgCpWhen_(s.at, true), callback_data: 'cp:ix:' + tgCpS_(s['کد']) }]);
  });
  kb.push([{ text: '🔗 لینک جلسهٔ من', callback_data: 'cp:il' }]);
  var link = name ? tgCpIvLink_(name) : '';
  return tgSend_(chat, '🎤 <b>مصاحبه‌های پذیرش</b>\n\n' + (lines.length ? lines.join('\n') : 'هنوز وقتی اعلام نکرده‌اید.') +
    '\n\nلینک ثابت جلسهٔ شما: ' + (link ? tgEsc_(link) : 'هنوز ثبت نشده') +
    '\n\nهر وقت آزادی که اعلام کنید، متقاضی‌ها بعد از پیش‌پرداخت همان را در بات رزرو می‌کنند و کارتش برای شما می‌آید.', { inline_keyboard: kb });
}

function tgCpIvAddDay_(chat, code) {
  var now = tgCpNow_(), kb = [], line = [];
  for (var i = 0; i < 14; i++) {
    var d = new Date(now.getTime() + i * 86400000);
    var j = tgJalali_(d, TG_TZ);
    var key = String(j.y) + (j.m < 10 ? '0' : '') + j.m + (j.d < 10 ? '0' : '') + j.d;
    line.push({ text: tgCpDay_(d) + ' ' + tgJDate_(d, TG_TZ), callback_data: 'cp:id:' + code + ':' + key });
    if (line.length === 2) { kb.push(line); line = []; }
  }
  if (line.length) kb.push(line);
  return tgSend_(chat, 'کدام روز برای مصاحبه وقت دارید؟ (' + code + ')', { inline_keyboard: kb });
}

function tgCpIvAddHour_(chat, code, key) {
  var kb = [], line = [];
  TG_CP_IV_HOURS.forEach(function (h) {
    line.push({ text: tgFa_(h), callback_data: 'cp:ih:' + code + ':' + key + ':' + h.replace(':', '') });
    if (line.length === 4) { kb.push(line); line = []; }
  });
  if (line.length) kb.push(line);
  return tgSend_(chat, 'چه ساعتی؟ (به وقت تهران، هر وقت ' + tgFa_(TG_CP_IV_MIN) + ' دقیقه)', { inline_keyboard: kb });
}

function tgCpIvAdd_(chat, uname, code, key, hhmm) {
  var who = tgCpIvWho_(chat, uname);
  if (!who) return tgSend_(chat, 'اعلام وقت فقط برای مصاحبه‌گرهاست. اگر مصاحبه‌گرید، از مسئول مدرسه بخواهید نقش «مصاحبه‌گر» را برایتان بزند.');
  var j = { y: Number(key.slice(0, 4)), m: Number(key.slice(4, 6)), d: Number(key.slice(6, 8)) };
  var hm = hhmm.slice(0, 2) + ':' + hhmm.slice(2);
  var sid = tgCpNext_(TG_CPI_TAB, 'کد', 'I', 3);
  tgCpAdd_(TG_CPI_TAB, { 'کد': sid, 'کد کمپین': code, 'مصاحبه‌گر': who.name, 'تاریخ': tgCpJText_(j), 'ساعت': tgFa_(hm),
    'مدت (دقیقه)': TG_CP_IV_MIN, 'لینک جلسه': tgCpIvLink_(who.name), 'وضعیت': 'آزاد' });
  var at = tgCpAt_(tgCpJText_(j), hm, false);
  var kb = [[{ text: '➕ وقت دیگر همین روز', callback_data: 'cp:id:' + code + ':' + key }], [{ text: '📋 همهٔ وقت‌هایم', callback_data: 'cp:iv' }]];
  var extra = tgCpIvLink_(who.name) ? '' : '\n\nلینک ثابت گوگل‌میت خودتان را هم یک بار ثبت کنید تا برای متقاضی برود.';
  if (!tgCpIvLink_(who.name)) kb.push([{ text: '🔗 ثبت لینک جلسه', callback_data: 'cp:il' }]);
  return tgSend_(chat, '✅ ثبت شد: <b>' + tgCpWhen_(at, true) + '</b> · ' + sid + extra, { inline_keyboard: kb });
}

/* ---------- میز کمپین برای مدیر مدرسه، مسئول مدرسه و یاسر ---------- */

function tgCpStats_(camp) {
  var regs = tgCpWebRegs_(camp.code);
  var leads = tgCpRead_(TG_SCH_T_REQ).filter(function (l) { return tgCpS_(l['کد کمپین']) === camp.code; });
  var pays = tgCpRead_(TG_CPP_TAB).filter(function (p) { return tgCpS_(p['کد کمپین']) === camp.code; });
  var slots = tgCpSlots_(camp.code);
  var okPay = function (k) { return pays.filter(function (p) { return tgCpS_(p['نوع']) === TG_CP_KIND[k] && tgCpS_(p['وضعیت']) === TG_CP_PAY.ok; }).length; };
  return {
    web: regs.length,
    came: regs.filter(function (r) { return tgCpS_(r['وضعیت']) === 'حاضر'; }).length,
    apply: leads.filter(function (l) { return tgSchStNorm_(l['وضعیت']).st !== TG_SCH_ST_PRE && tgSchStageAtLeast_(tgSchStageNorm_(l['مرحلهٔ قیف']).st, 'apply'); }).length,
    pre: okPay('pre'),
    waitPay: pays.filter(function (p) { return tgCpS_(p['وضعیت']) === TG_CP_PAY.wait; }).length,
    booked: slots.filter(function (s) { var x = tgCpS_(s['وضعیت']); return x === 'رزرو شد' || x === 'برگزار شد'; }).length,
    held: slots.filter(function (s) { return tgCpS_(s['وضعیت']) === 'برگزار شد'; }).length,
    accepted: slots.filter(function (s) { return tgCpS_(s['نتیجه']) === TG_CP_IV_RES.full; }).length,
    paid: okPay('rest'),
    free: tgCpFree_(camp).length,
    prereg: leads.filter(function (l) { return tgSchStNorm_(l['وضعیت']).st === TG_SCH_ST_PRE; }).length
  };
}

function tgCpDashText_(camp) {
  var s = tgCpStats_(camp), tr = tgCpTier_(camp), w = tgCpWebinar_(camp);
  var t = ['🎯 <b>' + tgEsc_(camp.code) + ' · ' + tgEsc_(camp.course) + '</b>', 'وضعیت: <b>' + tgEsc_(camp.state) + '</b>'];
  if (w) t.push('وبینار: ' + tgCpWhen_(w.at, true));
  t.push('پله: ' + tgEsc_(tr.label) + ' · ' + tgCpMoney_(tr.amount) + (tr.until ? ' تا ' + tgJDate_(tr.until, TG_TZ) : ''));
  t.push('\n<b>قیف</b>');
  t.push('ثبت‌نام وبینار ' + tgFa_(s.web) + ' · حاضر ' + tgFa_(s.came));
  t.push('درخواست دوره ' + tgFa_(s.apply) + ' · پیش‌ثبت‌نام ' + tgFa_(s.prereg));
  t.push('پیش‌پرداخت تأییدشده ' + tgFa_(s.pre) + (s.waitPay ? ' · منتظر تأیید ' + tgFa_(s.waitPay) : ''));
  t.push('مصاحبه رزرو ' + tgFa_(s.booked) + ' · برگزار ' + tgFa_(s.held) + ' · پذیرش کامل ' + tgFa_(s.accepted));
  t.push('ثبت‌نام قطعی ' + tgFa_(s.paid) + (camp.target ? ' از هدف ' + tgFa_(camp.target) : ''));
  t.push('وقت آزاد مصاحبه ' + tgFa_(s.free));
  var nx = tgCpEvents_(camp.code).filter(function (e) { return e.at && e.at > tgCpNow_() && e.status !== 'لغو' && e.type !== 'پلهٔ قیمت'; })[0];
  if (nx) t.push('\nرویداد بعدی: ' + tgEsc_(nx.id) + ' · ' + tgEsc_(nx.title) + ' · ' + tgCpWhen_(nx.at, !!tgCpHM_(nx.time)));
  return t.join('\n');
}

function tgCpDashKb_(camp) {
  var c = camp.code;
  return { inline_keyboard: [
    [{ text: '🔄 وضعیت', callback_data: 'cp:s:' + c }, { text: '🗓 خط زمانی', callback_data: 'cp:t:' + c }],
    [{ text: '➕ رویداد تازه', callback_data: 'cp:n:' + c }, { text: '💳 پرداخت‌های منتظر', callback_data: 'cp:pp:' + c }],
    [{ text: '👀 کارت دانشجو را ببین', callback_data: 'cp:v:' + c }, { text: '🔗 لینک‌ها', callback_data: 'cp:lk:' + c }],
      [{ text: '👥 ثبت‌نام‌کنندگان', callback_data: 'cp:who:' + c }, { text: '✍️ بازخورد وبینار', callback_data: 'cp:wfr:' + c }]
  ] };
}

function tgCpOwnerList_(chat) {
  if (!tgCpIsOwner_(chat)) return tgCpList_(chat);
  var cs = tgCpCamps_();
  if (!cs.length) return tgSend_(chat, 'هنوز کمپینی در تب «کمپین‌ها»ی هاب مدرسه نیست.');
  var open = cs.filter(function (c) { return c.state !== 'بسته'; });
  if (open.length === 1) return tgSend_(chat, tgCpDashText_(open[0]), tgCpDashKb_(open[0]));
  return tgSend_(chat, '🎯 کمپین‌ها:', { inline_keyboard: cs.map(function (c) { return [{ text: c.code + ' · ' + c.state, callback_data: 'cp:o:' + c.code }]; }) });
}

function tgCpSetState_(chat, camp, st, who) {
  if (TG_CP_STATES.indexOf(st) < 0) return;
  tgCpSet_(TG_CP_TAB, camp.row, { 'وضعیت': st });
  tgCpTell_('🔄 وضعیت ' + camp.code + ' شد «' + st + '»' + (who ? ' (' + tgEsc_(who) + ')' : ''));
  camp.state = st;
  tgCpPush_('وضعیت');
  if (chat) tgSend_(chat, tgCpDashText_(camp), tgCpDashKb_(camp));
}

function tgCpEvLine_(e) {
  var dot = e.status === 'انجام شد' ? '✔️' : (e.status === 'لغو' ? '✖️' : (e.status === 'فعال' ? '🟢' : '▫️'));
  var when = e.at ? tgJDate_(e.at, TG_TZ) + (tgCpHM_(e.time) ? ' ' + tgFa_(tgCpHM_(e.time)) : '') : 'بی‌تاریخ';
  if (e.type === 'پلهٔ قیمت' && e.until) when += ' تا ' + tgJDate_(e.until, TG_TZ);
  return dot + ' ' + e.id + ' · ' + when + ' · ' + e.title;
}

function tgCpTimeline_(chat, camp) {
  var ev = tgCpEvents_(camp.code);
  var kb = ev.slice(0, 30).map(function (e) { return [{ text: tgCpEvLine_(e).slice(0, 60), callback_data: 'cp:e:' + camp.code + ':' + e.id }]; });
  kb.push([{ text: '➕ رویداد تازه', callback_data: 'cp:n:' + camp.code }, { text: '↩️ داشبورد', callback_data: 'cp:o:' + camp.code }]);
  return tgSend_(chat, '🗓 <b>خط زمانی ' + tgEsc_(camp.code) + '</b>\nروی هر رویداد بزنید تا تاریخ، ساعت، متن یا وضعیتش را عوض کنید.', { inline_keyboard: kb });
}

function tgCpEvFind_(code, id) {
  var ev = tgCpEvents_(code);
  for (var i = 0; i < ev.length; i++) if (ev[i].id === id) return ev[i];
  return null;
}

function tgCpEvCard_(chat, code, id) {
  var e = tgCpEvFind_(code, id);
  if (!e) return tgSend_(chat, 'این رویداد پیدا نشد.');
  var t = ['<b>' + tgEsc_(e.id) + ' · ' + tgEsc_(e.type) + '</b>', tgEsc_(e.title),
           'زمان: ' + (e.at ? tgCpWhen_(e.at, !!tgCpHM_(e.time)) : 'ندارد') + (tgCpS_(e.to) ? ' تا ' + tgJDate_(e.until, TG_TZ) : ''),
           'وضعیت: ' + tgEsc_(e.status || '')];
  if (e.amount) t.push('مبلغ: ' + tgCpMoney_(e.amount));
  if (e.aud) t.push('مخاطب: ' + tgEsc_(e.aud));
  if (e.owner) t.push('مسئول: ' + tgEsc_(e.owner));
  if (e.msg) t.push('\nپیام بات:\n' + tgEsc_(e.msg));
  if (e.done) t.push('\nاجرا شد: ' + tgEsc_(e.done));
  var b = 'cp:';
  var kb = [
    [{ text: '📅 تاریخ', callback_data: b + 'ef:' + code + ':' + id + ':d' }, { text: '⏰ ساعت', callback_data: b + 'ef:' + code + ':' + id + ':h' },
     { text: '📅 تا تاریخ', callback_data: b + 'ef:' + code + ':' + id + ':u' }],
    [{ text: '✏️ عنوان', callback_data: b + 'ef:' + code + ':' + id + ':t' }, { text: '💬 متن پیام', callback_data: b + 'ef:' + code + ':' + id + ':m' }]
  ];
  if (e.type === 'پلهٔ قیمت') kb.push([{ text: '💰 مبلغ', callback_data: b + 'ef:' + code + ':' + id + ':a' }]);
  kb.push([{ text: '👥 مخاطب', callback_data: b + 'ea:' + code + ':' + id }, { text: '🔘 وضعیت', callback_data: b + 'es:' + code + ':' + id }]);
  if (TG_CP_RUN_TYPES.indexOf(e.type) > -1 && e.status !== 'انجام شد') kb.push([{ text: '📤 همین حالا اجرا کن', callback_data: b + 'ex:' + code + ':' + id }]);
  kb.push([{ text: '↩️ خط زمانی', callback_data: b + 't:' + code }]);
  return tgSend_(chat, t.join('\n'), { inline_keyboard: kb });
}

var TG_CP_FIELDS = { d: 'از تاریخ', h: 'ساعت', u: 'تا تاریخ', t: 'عنوان', m: 'پیام بات', a: 'مبلغ (تومان)' };
var TG_CP_FIELD_ASK = {
  d: 'تاریخ تازه را بنویسید، مثلاً «۶ مهر ۱۴۰۵».', h: 'ساعت تازه را به وقت تهران بنویسید، مثلاً «۲۰:۳۰».',
  u: 'تاریخ پایان را بنویسید، مثلاً «۱۰ مهر ۱۴۰۵». برای پاک‌کردن بنویسید «هیچ».', t: 'عنوان تازه را بنویسید.',
  m: 'متن تازهٔ پیام بات را بنویسید. همان را عیناً برای مخاطب می‌فرستیم؛ خط تیره وسط جمله نگذارید.', a: 'مبلغ را به تومان بنویسید، مثلاً ۳۵۰۰۰۰۰.'
};

/* مقدار تازه‌ای که مدیر مدرسه تایپ کرد */
function tgCpValText_(chat, text) {
  var raw = tgGetVal_('cpv', chat);
  if (!raw) return false;
  var d; try { d = JSON.parse(raw); } catch (e) { tgDel_('cpv', chat); return false; }
  var t = tgCpS_(text);
  if (!t) return false;
  if (t === '↩️ بازگشت' || t === 'انصراف' || t.indexOf('/') === 0) { tgDel_('cpv', chat); tgSend_(chat, 'باشد، عوض نشد.', { remove_keyboard: true }); return true; }
  if (d.mode === 'new') return tgCpNewEvText_(chat, d, t);
  var e = tgCpEvFind_(d.code, d.id);
  if (!e) { tgDel_('cpv', chat); tgSend_(chat, 'این رویداد پیدا نشد.'); return true; }
  var col = TG_CP_FIELDS[d.f], val = t;
  if (d.f === 'd' || (d.f === 'u' && t !== 'هیچ')) {
    var j = tgCpJ_(t);
    if (!j) { tgSend_(chat, 'این تاریخ را نفهمیدم. به شکل «۶ مهر ۱۴۰۵» بنویسید.'); return true; }
    val = tgCpJText_(j);
  }
  if (d.f === 'u' && t === 'هیچ') val = '';
  if (d.f === 'h') { var hm = tgCpHM_(t); if (!hm) { tgSend_(chat, 'ساعت را به شکل «۲۰:۳۰» بنویسید.'); return true; } val = tgFa_(hm); }
  if (d.f === 'a') { var n = tgCpNum_(t); if (!n) { tgSend_(chat, 'فقط عدد به تومان بنویسید.'); return true; } val = n; }
  if (d.f === 'm' && /[—–]/.test(val)) { tgSend_(chat, 'متن خط تیره دارد. بدون خط تیره دوباره بنویسید.'); return true; }
  tgDel_('cpv', chat);
  var ch = {}; ch[col] = val;
  if ((d.f === 'd' || d.f === 'h') && e.done) { ch['اجرا شد'] = ''; if (e.status === 'انجام شد') ch['وضعیت'] = 'برنامه‌ریزی شد'; }
  tgCpSet_(TG_CPT_TAB, e.row, ch);
  tgCpPush_('خط زمانی');
  tgSend_(chat, '✅ «' + col + '» عوض شد.', { remove_keyboard: true });
  tgCpTell_('🗓 ' + d.code + ' · ' + e.id + ': «' + col + '» شد «' + tgEsc_(String(val)) + '»');
  tgCpEvCard_(chat, d.code, d.id);
  return true;
}

function tgCpNewEvText_(chat, d, t) {
  if (d.step === 'title') {
    d.title = t; d.step = 'date';
    tgSetVal_('cpv', chat, JSON.stringify(d));
    tgSend_(chat, 'تاریخ؟ مثلاً «۶ مهر ۱۴۰۵».');
    return true;
  }
  if (d.step === 'date') {
    var j = tgCpJ_(t);
    if (!j) { tgSend_(chat, 'این تاریخ را نفهمیدم. به شکل «۶ مهر ۱۴۰۵» بنویسید.'); return true; }
    d.date = tgCpJText_(j); d.step = 'time';
    tgSetVal_('cpv', chat, JSON.stringify(d));
    tgSend_(chat, 'ساعت؟ مثلاً «۲۰:۰۰». اگر ساعت ندارد بنویسید «هیچ».');
    return true;
  }
  if (d.step === 'time') {
    var hm = t === 'هیچ' ? '' : tgCpHM_(t);
    if (t !== 'هیچ' && !hm) { tgSend_(chat, 'ساعت را به شکل «۲۰:۰۰» بنویسید.'); return true; }
    tgDel_('cpv', chat);
    var id = tgCpNextEvId_(d.code);
    var aud = { 'یادآوری': 'ثبت‌نام وبینار', 'پیگیری': 'حاضران وبینار', 'دعوت کامیونیتی': 'لیدهای بی‌ثبت‌نام', 'شروع دوره': 'پذیرفته‌شدگان' }[d.type] || '';
    var p = TG_DRY ? null : tgWhoPerson_(chat, '');
    tgCpAdd_(TG_CPT_TAB, { 'کد': id, 'کد کمپین': d.code, 'نوع': d.type, 'عنوان': d.title, 'از تاریخ': d.date,
      'ساعت': hm ? tgFa_(hm) : '', 'مسئول': p ? p.name : '', 'کانال‌ها': 'بات', 'مخاطب': aud, 'وضعیت': 'برنامه‌ریزی شد' });
    tgCpPush_('رویداد تازه');
    tgSend_(chat, '✅ رویداد ' + id + ' ساخته شد.', { remove_keyboard: true });
    tgCpTell_('➕ رویداد تازه در ' + d.code + ': ' + id + ' · ' + tgEsc_(d.title));
    tgCpEvCard_(chat, d.code, id);
    return true;
  }
  tgDel_('cpv', chat);
  return false;
}

function tgCpNextEvId_(code) {
  var ev = tgCpRead_(TG_CPT_TAB).filter(function (o) { return tgCpS_(o['کد کمپین']) === code; }), max = 0;
  ev.forEach(function (o) { var m = tgCpS_(o['کد']).match(/^T-(\d+)$/); if (m && Number(m[1]) > max) max = Number(m[1]); });
  return 'T-' + (max < 9 ? '0' : '') + (max + 1);
}

function tgCpPending_(chat, code) {
  var ps = tgCpRead_(TG_CPP_TAB).filter(function (p) { return tgCpS_(p['کد کمپین']) === code && tgCpS_(p['وضعیت']) === TG_CP_PAY.wait; });
  if (!ps.length) return tgSend_(chat, 'پرداخت منتظر تأییدی در ' + code + ' نداریم.');
  ps.forEach(function (p) {
    var kb = String(chat) === TG_CP_YASER ? { inline_keyboard: [[{ text: '✅ تأیید', callback_data: 'cp:y:' + tgCpS_(p['کد پرداخت']) + ':ok' },
                                                                  { text: '❌ رد', callback_data: 'cp:y:' + tgCpS_(p['کد پرداخت']) + ':no' }]] } : null;
    tgSend_(chat, '💳 ' + tgCpS_(p['کد پرداخت']) + ' · ' + tgEsc_(tgCpS_(p['نام'])) + ' · ' + tgCpS_(p['نوع']) + ' · ' +
                  tgCpMoney_(tgCpNum_(p['مبلغ (تومان)'])) + '\n' + tgEsc_(tgCpS_(p['توضیح پرداخت‌کننده'])), kb);
  });
  return true;
}

function tgCpLinks_(chat, camp) {

  try { var st = tgSS_().getSheetByName(TG_THER); scan(st, TG_C_CHAT, 1, 'درمانگران'); } catch (e) {}
  try { scan(tgPeopleSheet_(), 3, 1, 'افراد'); } catch (e) {}

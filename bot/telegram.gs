      const row = tgFindLead_(chat);
      if (row > 0) tgLeadNote_(row, 'یادداشت مراجع: ' + clean, 'مراجع');
    } catch (e) { tgErr_('tgSaveNote_: ' + e); }
  } else {
    TG_OUTBOX.push({ kind: 'note', text: clean });
  }
  tgSend_(chat, T_NOTE_SAVED, tgMenu_());
}

// روزی یک بار از tgWatchdog: لیدهای باز بات که ۳۰ یا ۶۰ روز از ثبتشان گذشته یک پیام کوتاه با سه دکمه می‌گیرند
function tgFollowTick_() {
  if (TG_DRY) return;
  const props = PropertiesService.getScriptProperties();
  const today = Utilities.formatDate(new Date(), TG_TZ, 'yyyy-MM-dd');
  if (props.getProperty('TG_FOLLOW_DAY') === today) return;
  props.setProperty('TG_FOLLOW_DAY', today);
  const sh = tgSS_().getSheetByName(TG_LEADS);
  const cols = tgScaleCols_(sh);
  const fc = cols['پیگیری خودکار'];
  const last = sh.getLastRow();
  if (last < 2 || !fc) return;
  const vals = sh.getRange(2, 1, last - 1, fc).getValues();
  const now = Date.now();
  var sent = 0;
  const kb = { inline_keyboard: [
    [{ text: '🍓 ادامه می‌دهم، تماس بگیرید', callback_data: 'fu:go' }],
    [{ text: '⏸ فعلاً متوقف', callback_data: 'fu:pause' }, { text: '✖️ دیگر نمی‌خواهم', callback_data: 'fu:stop' }]
  ] };
  for (var i = 0; i < vals.length && sent < TG_FOLLOW_BATCH; i++) {
    const v = vals[i];
    if (String(v[2]).indexOf('Telegram') < 0) continue;
    if (TG_FOLLOW_OPEN.indexOf(tgStOf_(v[8]) || 'جدید') < 0) continue;
    const mm = String(v[12]).match(/chat_id: (\d+)/);
    if (!mm) continue;
    const d = (v[0] instanceof Date) ? v[0] : new Date(String(v[0]).slice(0, 10));
    if (isNaN(d.getTime())) continue;
    const days = (now - d.getTime()) / 86400000;
    if (days > TG_FOLLOW_MAX_DAYS) continue;
    const mark = String(v[fc - 1] || '');
    var stage = 0;
    if (days >= 60 && mark.indexOf('۶۰') < 0) stage = 60;
    else if (days >= 30 && mark.indexOf('۳۰') < 0 && mark.indexOf('۶۰') < 0) stage = 30;
    if (!stage) continue;
    const res = tgSend_(mm[1], stage === 30 ? T_FOLLOW_30 : T_FOLLOW_60, kb);
    if (res && res.getResponseCode() !== 200) continue;
    sh.getRange(i + 2, fc).setValue((mark ? mark + ' · ' : '') + 'پیام ' + (stage === 30 ? '۳۰' : '۶۰') + ' روز ' + today);
    sent++;
  }
}

function tgOnFollow_(chat, k) {
  const label = k === 'go' ? 'ادامه می‌دهد، تماس بگیرید' : (k === 'pause' ? 'توقف موقت به خواست مراجع' : 'منتفی (خود مراجع)');
  const text = k === 'go' ? T_FOLLOW_GO : (k === 'pause' ? T_FOLLOW_PAUSE : T_FOLLOW_STOP);
  try {
    const row = TG_DRY ? (TG_DRY_LEAD ? TG_DRY_LEAD.row : -1) : tgFindLead_(chat);
    if (row > 0) {
      const today = Utilities.formatDate(new Date(), TG_TZ, 'yyyy-MM-dd');
      const lf = tgLeadRead_(row);
      var ch;
      if (k === 'go') ch = { 'وضعیت': (lf && lf.touched) ? TG_ST.FOLLOW : TG_ST.NEW, 'دلیل بستن': '', 'اقدام بعدی': 'تماس (مراجع خواست ادامه دهد)', 'تاریخ اقدام بعدی': today };
      else if (k === 'pause') ch = { 'وضعیت': TG_ST.FOLLOW, 'اقدام بعدی': 'توقف موقت به خواست مراجع', 'تاریخ اقدام بعدی': tgLeadDayAdd_(30) };
      else ch = { 'وضعیت': TG_ST.CLOSED, 'دلیل بستن': 'منتفی (خود مراجع)', 'اقدام بعدی': '', 'تاریخ اقدام بعدی': '' };
      tgLeadSet_(row, ch, 'مراجع', 'بات', 'پاسخ پیگیری خودکار');
      tgLeadNote_(row, 'پاسخ پیگیری خودکار: ' + label + ' ' + today, 'بات');
      if (lf) tgLeadOwnerSay_(lf, '🍓 پاسخ پیگیری خودکار از ' + tgEsc_(lf.name || '') + ' (' + tgEsc_(lf.code || '') + '): ' + tgEsc_(label), k === 'go');
    }
  } catch (e) { tgErr_('tgOnFollow_: ' + e); }
  tgSend_(chat, text, tgMenu_());
}

/* ---------- سؤالات متداول ---------- */

function tgFaq_() {
  const c = TG_DRY ? null : CacheService.getScriptCache();
  if (c) { const hit = tgCacheGet_('faq'); if (hit) { try { return JSON.parse(hit); } catch (e) {} } }
  const sh = tgSS_().getSheetByName(TG_FAQ);
  if (!sh || sh.getLastRow() < 4) return [];
  const v = sh.getRange(4, 1, sh.getLastRow() - 3, 3).getValues();
  const out = [];
  for (var i = 0; i < v.length; i++) {
    const q = String(v[i][0]).trim(), a = String(v[i][1]).trim();
    if (!q || !a) continue;
    if (String(v[i][2]).trim() === 'خیر') continue;
    out.push({ row: i + 4, q: q, a: a });
    if (out.length >= 20) break;
  }
  if (c) c.put('faq', JSON.stringify(out), 3600);
  return out;
}

function tgFeedToday_() {
  const sh = tgFeedItemsSheet_();
  if (!sh || sh.getLastRow() < 2) return null;
  const v = sh.getRange(2, 1, sh.getLastRow() - 1, TG_FEED_ITEM_HEAD.length).getValues();
  const now = new Date();
  let best = null;
  for (var i = 0; i < v.length; i++) {
    const on = String(v[i][5] || '').trim();
    if (on && on !== 'بله' && on !== 'TRUE' && on !== 'true') continue;
    if (!String(v[i][1] || '').trim()) continue;
    let d = v[i][0] instanceof Date ? v[i][0] : new Date(String(v[i][0] || '').replace(/\//g, '-'));
    if (isNaN(d.getTime())) d = now;
    if ((now - d) / 86400000 > 14) continue;
    if (!best || d >= best.d) {
      best = { d: d, row: i + 2, title: String(v[i][1] || '').trim(), note: String(v[i][2] || '').trim(),
               link: String(v[i][3] || '').trim(), topic: String(v[i][4] || '').trim() };
    }
  }
  return best;
}

function tgFeedCard_(it) {
  return '📌 <b>' + tgEsc_(it.title) + '</b>' +
         (it.note ? '\n\n' + tgEsc_(it.note) : '') +
         (it.topic ? '\n\n🏷 ' + tgEsc_(it.topic) : '') +
         (it.link ? '\n' + tgEsc_(it.link) : '');
}

// هیچ‌وقت بدون اجازه چیزی فرستاده نمی‌شود. هر وقت خودش آمد، مطلب تازه را می‌بیند
function tgFeedMenu_(chat, name, uname) {
  const me = tgFeedFind_(chat);
  const on = !!(me && me.status === 'فعال');
  const it = tgFeedToday_();
  let t = '📚 <b>محتوای تجربه</b>';
  t += it ? '\n\n' + tgFeedCard_(it) : '\n\nتازه‌ترین مطلب همین‌جا برایتان می‌آید. فعلاً چیزی برای این هفته ثبت نشده.';
  t += on
    ? '\n\n🔔 مطلب تازه در موضوع‌های ' + tgEsc_(tgFeedLabels_(me.topics).join('، ') || 'انتخابی شما') + ' برایتان فرستاده می‌شود.'
    : '\n\nاگر بخواهید می‌توانیم مطلب تازه را در موضوع‌هایی که خودتان انتخاب می‌کنید برایتان بفرستیم. تا وقتی خودتان نگویید، چیزی فرستاده نمی‌شود.';
  const kb = on
    ? [[{ text: '🏷 عوض‌کردن موضوع‌ها', callback_data: 'fd:pick' }], [{ text: '🔕 دیگر نفرستید', callback_data: 'fd:off' }]]
    : [[{ text: '🔔 بله، برایم بفرستید', callback_data: 'fd:pick' }], [{ text: '🙂 فعلاً نه', callback_data: 'fd:no' }]];
  if (it && it.link) kb.unshift([{ text: '📖 خواندن این مطلب', url: it.link }]);
  tgSend_(chat, t, { inline_keyboard: kb });
}

function tgFeedAsk_(chat) {
  const me = tgFeedFind_(chat);
  tgSetVal_('ct', chat, me ? me.topics.join(',') : '');
  tgSend_(chat, 'کدام موضوع‌ها برایتان جالب است؟ هر چندتا که هست را بزنید و در آخر «همین‌ها».',
    tgPickKb_(TG_FEED_TOPICS, 'ct:', me ? me.topics : []));
}

function tgFeedSave_(chat, name, uname) {
  const sel = tgSelList_('ct', chat);
  if (!sel.length) return tgFeedOff_(chat, true);
  const sh = tgFeedSheet_();
  const me = tgFeedFind_(chat);
  const stamp = new Date();
  if (sh) {
    if (me) {
      sh.getRange(me.row, 4, 1, 2).setValues([[sel.join(','), 'فعال']]);
    } else {
      sh.appendRow([String(chat), name || '', uname || '', sel.join(','), 'فعال', stamp, '']);
    }
  }
  tgSend_(chat, '✅ ثبت شد: ' + tgEsc_(tgFeedLabels_(sel).join('، ')) +
    '\n\nهر وقت مطلب تازه‌ای در این موضوع‌ها منتشر شود یک پیام کوتاه می‌فرستیم؛ نه بیشتر. هر لحظه هم می‌توانید از همین بخش جلویش را بگیرید.', tgMenu_());
}

function tgFeedOff_(chat, quiet) {
  const sh = tgFeedSheet_();
  const me = tgFeedFind_(chat);
  if (sh && me) sh.getRange(me.row, 5).setValue('توقف');
  tgSend_(chat, quiet
    ? 'باشد، چیزی نمی‌فرستیم. هر وقت خودتان سر زدید، تازه‌ترین مطلب را همین‌جا می‌بینید.'
    : '🔕 دیگر چیزی فرستاده نمی‌شود. هر وقت خواستید از «📚 محتوای تجربه» دوباره روشنش کنید.', tgMenu_());
}

function tgOnFeed_(chat, msgId, key, name, uname) {
  if (key === 'pick') return tgFeedAsk_(chat);
  if (key === 'off')  return tgFeedOff_(chat, false);
  if (key === 'no')   return tgFeedOff_(chat, true);
  if (key === 'ok')   return tgFeedSave_(chat, name, uname);
  if (key === 'none') { tgSetVal_('ct', chat, ''); return tgFeedOff_(chat, true); }
  const sel = tgToggle_('ct', chat, key);
  if (msgId) tgApi_('editMessageReplyMarkup', { chat_id: chat, message_id: msgId, reply_markup: tgPickKb_(TG_FEED_TOPICS, 'ct:', sel) });
}

// روزی یک بار، و فقط وقتی آدمی سطر تازه‌ای در تب «محتوای تجربه» گذاشته باشد
function tgFeedTick_() {
  if (TG_DRY) return;
  const props = PropertiesService.getScriptProperties();
  const today = Utilities.formatDate(new Date(), TG_TZ, 'yyyy-MM-dd');
  if (props.getProperty('TG_FEED_DAY') === today) return;
  props.setProperty('TG_FEED_DAY', today);
  tgFeedPush();
}

function tgFeedPush() {
  const items = tgFeedItemsSheet_();
  const subs = tgFeedSheet_();
  if (!items || !subs || items.getLastRow() < 2 || subs.getLastRow() < 2) return 'چیزی برای فرستادن نیست';
  const iv = items.getRange(2, 1, items.getLastRow() - 1, TG_FEED_ITEM_HEAD.length).getValues();
  const sv = subs.getRange(2, 1, subs.getLastRow() - 1, TG_FEED_HEAD.length).getValues();
  let sent = 0, done = 0;
  for (var i = 0; i < iv.length; i++) {
    const on = String(iv[i][5] || '').trim();
    if (on && on !== 'بله' && on !== 'TRUE' && on !== 'true') continue;
    if (String(iv[i][6] || '').trim()) continue;
    if (!String(iv[i][1] || '').trim()) continue;
    const it = { title: String(iv[i][1]).trim(), note: String(iv[i][2] || '').trim(),
                 link: String(iv[i][3] || '').trim(), topic: String(iv[i][4] || '').trim() };
    const key = (TG_FEED_TOPICS.filter(function (t) { return it.topic.indexOf(t.label) > -1 || it.topic === t.k; })[0] || {}).k || '';
    for (var j = 0; j < sv.length && sent < TG_FEED_MAX; j++) {
      if (String(sv[j][4] || '').trim() !== 'فعال') continue;
      const tp = String(sv[j][3] || '').split(',').filter(String);
      if (key && tp.length && tp.indexOf(key) < 0) continue;
      tgSend_(String(sv[j][0]).trim(), tgFeedCard_(it), { inline_keyboard: [
        [{ text: '🔕 دیگر نفرستید', callback_data: 'fd:off' }]
      ] });
      subs.getRange(j + 2, 7).setValue(new Date());
      sent++;
    }
    items.getRange(i + 2, 7).setValue('بله · ' + Utilities.formatDate(new Date(), TG_TZ, 'yyyy-MM-dd HH:mm'));
    done++;
    if (sent >= TG_FEED_MAX) break;
  }
  return 'مطلب: ' + done + ' · پیام: ' + sent;
}

function tgFaqMenu_(chat) {
  const list = tgFaq_();
  if (!list.length) return tgSend_(chat, T_FAQ_EMPTY, tgMenu_());
  const rows = list.map(function (f) { return [{ text: f.q, callback_data: 'f:' + f.row }]; });
  rows.push([{ text: '📞 صحبت با همکار', callback_data: 'hm' }]);
  tgSend_(chat, T_FAQ_MENU, { inline_keyboard: rows });
}

function tgFaqAnswer_(chat, row) {
  const list = tgFaq_();
  for (var i = 0; i < list.length; i++) {
    if (list[i].row === row) {
      return tgSend_(chat, '❓ <b>' + tgEsc_(list[i].q) + '</b>\n\n' + tgEsc_(list[i].a), {
        inline_keyboard: [
          [{ text: '↩️ سؤال‌های دیگر', callback_data: 'f:0' }],
          [{ text: '🍓 شروع درمان', callback_data: 'go' }]
        ]
      });
    }
  }
  tgFaqMenu_(chat);
}

/* ---------- درمانگر ---------- */

function tgTherapistRows_() {
  const c = TG_DRY ? null : CacheService.getScriptCache();
  if (c) { const hit = tgCacheGet_('trows'); if (hit) { try { return JSON.parse(hit); } catch (e) {} } }
  const sh = tgSS_().getSheetByName(TG_THER);
  const out = [];
  if (sh && sh.getLastRow() >= 4) {
    /* v84: ستون‌های کار (ایمیل، ساعت، نرخ، بازهٔ آزاد) با نام هدر پیدا می‌شوند، نه با شماره */
    const lc = Math.max(sh.getLastColumn(), TG_C_MEET);
    const hd = sh.getRange(3, 1, 1, lc).getValues()[0].map(function (h) { return String(h).trim(); });
    const ix = function (name) { return hd.indexOf(name); };
    const cEm = ix('ایمیل'), cTz = ix('منطقهٔ زمانی'), cCt = ix('شهر'), cAb = ix('خارج از ایران می‌بیند؟'),
          cSl = ix('طول جلسهٔ درمان (دقیقه)'), cRt = ix('نرخ جلسه (تومان)'), cSo = ix('نرخ حمایتی می‌پذیرد؟'),
          cSr = ix('نرخ حمایتی (تومان)'), cSc = ix('ظرفیت حمایتی'), cFw = ix('بازهٔ آزاد جلسهٔ اول');
    const g = function (r, c) { return c > -1 ? String(r[c] || '').trim() : ''; };
    const v = sh.getRange(4, 1, sh.getLastRow() - 3, lc).getValues();
    for (var i = 0; i < v.length; i++) {
      const n = String(v[i][TG_C_NAME - 1]).trim();
      if (!n) continue;
      out.push({
        name: n, row: i + 4,
        email: g(v[i], cEm), tz: g(v[i], cTz), city: g(v[i], cCt), abroad: g(v[i], cAb),
        slen: g(v[i], cSl), rate: g(v[i], cRt), supok: g(v[i], cSo), suprate: g(v[i], cSr),
        supcap: g(v[i], cSc), firstwin: g(v[i], cFw),
        pool:  String(v[i][TG_C_POOL - 1]  || '').trim(),
        code:  String(v[i][TG_C_CODE - 1]  || '').trim(),
        chat:  String(v[i][TG_C_CHAT - 1]  || '').trim(),
        about:  String(v[i][TG_C_ABOUT - 1]  || '').trim(),
        meet:   String(v[i][TG_C_MEET - 1]   || '').trim(),
        status: String(v[i][TG_C_STATUS - 1] || '').trim(),
        gender: String(v[i][TG_C_GENDER - 1] || '').trim(),
        mode:   String(v[i][TG_C_MODE - 1]   || '').trim(),
        tier:   tgTier_(v[i][TG_C_TIER - 1])
      });
    }
  }
  if (c) c.put('trows', JSON.stringify(out), 900);
  return out;
}

// ردهٔ ارجاع را به عدد تبدیل می‌کند. «داده کم» وسط صف می‌ایستد تا شانس تست داشته باشد.
function tgFa_(n) {
  return String(n).replace(/[0-9]/g, function (d) { return '۰۱۲۳۴۵۶۷۸۹'.charAt(Number(d)); });
}

function tgTier_(cell) {
  const t = tgLatinDigits_(cell).match(/[1-4]/);
  return t ? Number(t[0]) : 2.5;
}

function tgTherapistInfo_() {
  const rows = tgTherapistRows_(), map = {};
  for (var i = 0; i < rows.length; i++) map[rows[i].name] = rows[i];
  return map;
}

var TG_DRY_THER = null;
function tgWhoTherapist_(chat) {
  if (TG_DRY) return TG_DRY_THER ? TG_DRY_THER : null;
  const c = String(chat).trim();
  if (!c) return null;
  const list = tgTherapistRows_();
  for (var i = 0; i < list.length; i++) {
    const ids = String(list[i].chat || '').split(/[,،;\s]+/);
    for (var j = 0; j < ids.length; j++) if (ids[j].trim() && ids[j].trim() === c) return list[i];
  }
  // v81: از روی تب «افراد» پل می‌زند تا درمانگری که با لینک اختصاصی وارد نشده هم شناخته شود
  if (typeof tgTherLinkFromPeople_ === 'function' && !tgFlag_('nobrg', c)) {

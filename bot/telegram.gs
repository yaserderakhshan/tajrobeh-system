function tgSend_(chat, text, markup, replyTo) {
  markup = tgCbFix_(markup);
  if (TG_DRY) tgBtnCheck_('send', markup);   /* زنده از راه tgApi_ سنجیده می‌شود */
  if (TG_API_CHAT && String(chat) === String(TG_API_CHAT)) {
    TG_API_OUT.push({ text: String(text), kb: markup || null });
    if (TG_DRY) TG_OUTBOX.push({ kind: 'msg', chat: String(chat), text: String(text), markup: markup || null });
    return null;
  }
  if (TG_DRY) {
    TG_OUTBOX.push({ kind: 'msg', chat: String(chat), text: String(text), markup: markup || null });
    return null;
  }
  /* v166.23 (E-1001): خانه‌ای با چند شناسه به همه می‌رود؛ شناسهٔ ادغام‌شده (عدد بیش از ۱۵ رقم) اصلاً فرستاده نمی‌شود */
  if (typeof chat === 'number' || /[,،;\s]/.test(String(chat).trim())) {
    var ids = tgChatIds_(chat);
    if (!ids.length) { tgErr_('tgSend_', 'chat_id نامعتبر یا ادغام‌شده در شیت؛ با tgChatCellAudit پیدا و درست شود', 'chat ' + String(chat).slice(0, 24)); return null; }
    if (ids.length > 1 || ids[0] !== String(chat)) { var r0 = null; ids.forEach(function (c) { r0 = tgSend_(c, text, markup, replyTo) || r0; }); return r0; }
  }
  const body = { chat_id: chat, text: text, parse_mode: 'HTML', disable_web_page_preview: true };
  if (markup)  body.reply_markup = markup;
  if (replyTo) { body.reply_to_message_id = replyTo; body.allow_sending_without_reply = true; }
  const res = tgApi_('sendMessage', body);
  var sentOk = !!(res && res.getResponseCode() === 200);
  if (res && res.getResponseCode() !== 200) {
    delete body.parse_mode;
    body.text = String(text).replace(/<[^>]+>/g, '');
    var res2 = tgApi_('sendMessage', body);
    sentOk = !!(res2 && res2.getResponseCode() === 200);
    if (sentOk) res = res2;   /* v166.27 (گزارش ۳.۶): پاسخ موفقِ دوم برمی‌گردد؛ پیش از این ارسال موفق «خطا» ثبت می‌شد */
  }
  try { tgOutLog_(chat, text, sentOk); } catch (eOut) {}
  return res;
}


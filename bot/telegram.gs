  if (tk) live = tgPoolFilter_(live, 0, { topic: tk, abroad: sc.abroad });
  if (!TG_DRY) live = tgCapFilter_(live);
  var by = {}, order = [];
  for (var i = 0; i < live.length; i++) {
    var n = live[i].therapist;

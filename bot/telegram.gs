/* کارت درمانگر برای مراجع، از دکمهٔ «دربارهٔ او» زیر فهرست وقت‌ها */
function tgTherCardShow_(chat, i) {
  var list = [];
  try { list = JSON.parse(tgGetVal_('off', chat) || '[]'); } catch (e) {}
  const s = list[i];
  if (!s) return tgSend_(chat, 'این فهرست منقضی شده. دوباره وقت‌ها را بگیرید.');
  const p = tgTherProfile_(s.therapist);
  if (!p) return tgSend_(chat, 'اطلاعات این درمانگر هنوز کامل نیست.');
  var pub = null;
  try { pub = tgThPubMap_()[tgNorm_(s.therapist)] || null; } catch (e0) {}
  const txt = tgTherCardText2_(p, pub);
  const kb = (pub && pub.pg) ? { inline_keyboard: [[{ text: '🌐 صفحهٔ کامل در سایت', url: pub.pg }]] } : null;
  if (p.photo) {
    try {
      var body = { chat_id: chat, photo: p.photo, parse_mode: 'HTML' };
      if (txt.length <= 1000) { body.caption = txt; if (kb) body.reply_markup = kb; }
      var res = tgApi_('sendPhoto', body);
      if (txt.length <= 1000 && (TG_DRY || (res && res.getResponseCode && res.getResponseCode() === 200))) return;
    } catch (e) {}
  }
  tgSend_(chat, txt, kb);
}

/* کارت درمانگر برای مینی‌اپ و بیرون آن: ?api=ther&name=... */
function tgApiTher_(p) {
  const name = String(p.name || '').trim();
  /* v170.9 (امنیت): فقط درمانگرهایی که روی سایت منتشر شده‌اند (پیش از این همهٔ درمانگرهای غیرپایان‌یافته، با معرفی و جنسیت) */
  var pub = {}; try { tgThPubList_().forEach(function (x) { if (x && x.name) pub[tgNorm_(x.name)] = 1; }); } catch (eP) {}
  if (!name) return { ok: true, names: Object.keys(pub).length ? tgThPubList_().map(function (x) { return x.name; }) : [] };
  if (!pub[tgNorm_(name)]) return { ok: false, error: 'notfound' };
  const pr = tgTherProfile_(name);
  if (!pr) return { ok: false, error: 'notfound' };
  return {
    ok: true,
    therapist: pr.name,
    approach: pr.approach,
    family: tgApproachFamily_(pr.approach),
    topics: pr.topics ? pr.topics.split(/[،,]+/).map(function (x) { return x.trim(); }).filter(String) : [],
    style: pr.style, tone: pr.tone, gender: pr.gender,
    mode: pr.mode, ages: pr.ages, couple: pr.couple,
    about: pr.about,
    hasPhoto: !!pr.photo
  };
}


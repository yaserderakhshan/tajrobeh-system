    ok('غیرمسئول به میز نمی‌رسد', (TG_OUTBOX = [], tgOnCp_({ message: { message_id: 1 } }, 'o:' + E, '500', 'x', ''), TG_OUTBOX.some(function (x) { return x.text.indexOf('مسئولان مدرسه') > -1; })));

    /* API */
    var api = tgCpApi_({ code: 'eftx' });
    ok('API وضعیت و پله و وبینار می‌دهد', api.ok && api.tier.amount === 3500000 && api.webinar && api.links.web.indexOf('web_' + E) > -1);
    ok('API کمپین ناشناس', tgCpApi_({ code: 'nope' }).ok === false);
    ok('متن‌ها خط تیره ندارند', !/[—–]/.test([T_ROLE_PICK].join('') + tgCpStateLine_(camp) + tgCpNextText_(camp, tgCpLead_('500', E))));
    ok('نقش مصاحبه‌گر در فهرست نقش‌ها', TG_ROLES.indexOf(TG_CP_ROLE) > -1);
    ok('ستون‌های کمپین در هدر درخواست', TG_SCH_REQ_HEAD.indexOf('کد کمپین') > -1 && TG_SCH_REQ_HEAD.indexOf('وضعیت پرداخت') > -1);
  } catch (e) {
    fail++; out.push('❌ خطا: ' + e + ' ' + (e && e.stack ? String(e.stack).split('\n').slice(0, 3).join(' | ') : ''));
  }
  TG_DRY = oldDry; TG_MEM = oldMem; TG_OUTBOX = oldOut;
  return { pass: pass, fail: fail, text: 'کمپین ثبت‌نام · ' + pass + ' قبول · ' + fail + ' مردود\n' + out.join('\n') };
}

/* ==================== بازخورد وبینار (سبک و بی‌نام) ==================== */
/* چهار ضربه و یک جملهٔ اختیاری. هیچ نام و شماره و chat_id در تب ذخیره نمی‌شود.
   تکراری‌نشدن با فلگ کش انجام می‌شود، نه با ذخیرهٔ هویت. */
var TG_WF_TAB = 'بازخورد وبینار';
var TG_WF_HEAD = ['تاریخ ثبت', 'کد کمپین', 'محتوا (۱ تا ۵)', 'طول جلسه', 'ساعت برگزاری', 'مسیر ثبت‌نام', 'یک جمله'];
var TG_WF_Q = [
  { k: 'q1', t: 'محتوای وبینار چطور بود؟', o: [['۵ عالی', '5'], ['۴ خوب', '4'], ['۳ متوسط', '3'], ['۲ ضعیف', '2'], ['۱ بد', '1']] },
  { k: 'q2', t: 'طول جلسه چطور بود؟', o: [['کوتاه بود', 'کوتاه'], ['مناسب بود', 'مناسب'], ['طولانی بود', 'طولانی']] },
  { k: 'q3', t: 'ساعت برگزاری برای شما مناسب بود؟', o: [['بله', 'مناسب'], ['زودتر بهتر بود', 'زودتر'], ['دیرتر بهتر بود', 'دیرتر']] },
  { k: 'q4', t: 'مسیر ثبت‌نام دوره برایتان روشن بود؟', o: [['بله', 'روشن'], ['تا حدی', 'تا حدی'], ['نه', 'روشن نبود']] }
];
var T_WF_INTRO = '✍️ <b>بازخورد کوتاه</b>' + '\n' + '\n' +
  'چهار پرسش کوتاه، اختیاری، و بی‌نام. جواب‌ها بدون نام و شماره ذخیره می‌شود و فقط برای بهتر برگزار کردن وبینارهای بعدی نگاه می‌شود.';
var T_WF_LAST = 'اگر یک جمله دربارهٔ وبینار یا مسیر ثبت‌نام دارید بنویسید. اختیاری است.';
var T_WF_DONE = 'ثبت شد. ممنون که وقت گذاشتید 🌿';
var T_WF_DUP = 'بازخوردتان قبلاً ثبت شده. ممنون 🌿';

function tgWfGet_(chat) {
  try { return JSON.parse(tgGetVal_('wfw', chat) || 'null'); } catch (e) { return null; }
}
function tgWfPut_(chat, d) { tgSetVal_('wfw', chat, JSON.stringify(d)); }
function tgWfEnd_(chat) { tgDel_('wfw', chat); }

function tgWfStart_(chat, code) {
  if (tgFlag_('wfdone' + code, chat)) return tgSend_(chat, T_WF_DUP);
  tgWfPut_(chat, { code: code, qi: 0, v: {} });
  tgSend_(chat, T_WF_INTRO);
  return tgWfAsk_(chat, tgWfGet_(chat));
}

function tgWfAsk_(chat, d) {
  if (!d) return null;
  if (d.qi >= TG_WF_Q.length) {
    tgSetFlag_('wftxt', chat, 1800);
    tgWfPut_(chat, d);
    return tgSend_(chat, T_WF_LAST, { inline_keyboard: [[{ text: '⏭ رد کردن', callback_data: 'cp:wx:' + d.code }]] });
  }
  var q = TG_WF_Q[d.qi], rows = [], i;
  for (i = 0; i < q.o.length; i += 3) {
    rows.push(q.o.slice(i, i + 3).map(function (x) {
      return { text: x[0], callback_data: 'cp:wq:' + d.code + ':' + d.qi + ':' + x[1] };
    }));
  }
  tgWfPut_(chat, d);
  return tgSend_(chat, q.t, { inline_keyboard: rows });
}

function tgWfAnswer_(chat, code, qi, val) {
  var d = tgWfGet_(chat);
  if (!d) { d = { code: code, qi: 0, v: {} }; }
  var n = Number(qi);
  if (isNaN(n) || n < 0 || n >= TG_WF_Q.length) return null;
  d.v[TG_WF_Q[n].k] = String(val || '');
  d.qi = n + 1;
  return tgWfAsk_(chat, d);
}

function tgWfText_(chat, text) {
  var d = tgWfGet_(chat);
  if (!d) { tgDel_('wftxt', chat); return null; }
  d.v.note = String(text || '').slice(0, 300);
  tgWfPut_(chat, d);
  return tgWfSave_(chat);
}

function tgWfSave_(chat) {
  var d = tgWfGet_(chat);
  if (!d) return null;
  var row = [tgJDateFull_(new Date(), TG_TZ), d.code, d.v.q1 || '', d.v.q2 || '',
    d.v.q3 || '', d.v.q4 || '', d.v.note || ''];
  if (TG_DRY) {
    TG_OUTBOX.push({ kind: 'wf', row: row });
  } else {
    try { tgSchSheet_(TG_WF_TAB, TG_WF_HEAD).appendRow(row); } catch (e) { tgErr_('tgWfSave_: ' + e); }
  }
  tgSetFlag_('wfdone' + d.code, chat, 60 * 60 * 24 * 60);
  tgDel_('wftxt', chat);
  tgWfEnd_(chat);
  return tgSend_(chat, T_WF_DONE);
}

function tgWfReport_(code) {
  code = code || 'EFT-1';
  var rows = [];
  if (TG_DRY) {
    rows = (TG_MEM['wfrows'] || []);
  } else {
    var sh = tgSchSS_().getSheetByName(TG_WF_TAB);
    if (!sh || sh.getLastRow() < 2) return 'هنوز بازخوردی ثبت نشده.';
    var v = sh.getRange(2, 1, sh.getLastRow() - 1, TG_WF_HEAD.length).getDisplayValues();
    for (var i = 0; i < v.length; i++) if (String(v[i][1]).trim() === code) rows.push(v[i]);
  }
  if (!rows.length) return 'برای ' + code + ' هنوز بازخوردی ثبت نشده.';
  var n = rows.length, sum = 0, cnt = 0, c2 = {}, c3 = {}, c4 = {}, notes = [];
  for (var j = 0; j < rows.length; j++) {
    var s = Number(rows[j][2]);
    if (!isNaN(s) && s > 0) { sum += s; cnt++; }
    c2[rows[j][3]] = (c2[rows[j][3]] || 0) + 1;
    c3[rows[j][4]] = (c3[rows[j][4]] || 0) + 1;
    c4[rows[j][5]] = (c4[rows[j][5]] || 0) + 1;
    if (String(rows[j][6]).trim()) notes.push(String(rows[j][6]).trim());
  }
  var avg = cnt ? Math.round((sum / cnt) * 10) / 10 : 0;
  var top = function (o) {
    var bk = '', bv = -1;
    for (var k in o) if (k && o[k] > bv) { bv = o[k]; bk = k; }
    return { k: bk, v: bv };
  };
  var t2 = top(c2), t3 = top(c3), t4 = top(c4);
  var pct = function (x) { return tgFa_(Math.round((x / n) * 100)) + '٪'; };
  var out = '✍️ <b>بازخورد وبینار ' + tgEsc_(code) + '</b>' + '\n' +
    'تعداد بازخورد: ' + tgFa_(n) + '\n' +
    'میانگین محتوا: ' + tgFa_(avg) + ' از ۵' + '\n' +
    'طول جلسه: ' + tgEsc_(t2.k) + ' (' + pct(t2.v) + ')' + '\n' +
    'ساعت برگزاری: ' + tgEsc_(t3.k) + ' (' + pct(t3.v) + ')' + '\n' +
    'مسیر ثبت‌نام: ' + tgEsc_(t4.k) + ' (' + pct(t4.v) + ')';
  var tips = [];
  if (avg && avg < 4) tips.push('میانگین محتوا زیر ۴ است. برای دفعهٔ بعد یک نمونهٔ بالینی واقعی و پرسش و پاسخ بیشتر بگذارید.');
  if (t2.k === 'طولانی' && t2.v / n >= 0.3) tips.push('نزدیک یک‌سوم گفته‌اند طولانی بود. جلسهٔ بعد را کوتاه‌تر ببندید.');
  if (t2.k === 'کوتاه' && t2.v / n >= 0.3) tips.push('نزدیک یک‌سوم گفته‌اند کوتاه بود. وقت پرسش و پاسخ را بیشتر کنید.');
  if ((c3['زودتر'] || 0) / n >= 0.3) tips.push('بخش زیادی ساعت زودتر را ترجیح می‌دهند. وبینار بعدی را ساعت ۱۸ یا ۱۹ بگذارید.');
  if ((c3['دیرتر'] || 0) / n >= 0.3) tips.push('بخش زیادی ساعت دیرتر را ترجیح می‌دهند. وبینار بعدی را ۲۱ بگذارید.');
  if (((c4['تا حدی'] || 0) + (c4['روشن نبود'] || 0)) / n >= 0.25)
    tips.push('مسیر ثبت‌نام برای یک‌چهارم روشن نبوده. در خود جلسه یک اسلاید «از اینجا ثبت‌نام کنید» و بلافاصله بعد از وبینار پیام با دکمه بفرستید.');
  if (!tips.length) tips.push('اعداد سالم است. همین قالب را برای دورهٔ بعد تکرار کنید.');
  out += '\n' + '\n' + '<b>برای وبینار بعدی</b>' + '\n';
  for (var t = 0; t < tips.length; t++) out += '• ' + tips[t] + '\n';
  if (notes.length) {
    out += '\n' + '<b>چند جملهٔ مراجعان</b>' + '\n';
    for (var q = 0; q < Math.min(notes.length, 5); q++) out += '• ' + tgEsc_(notes[q]) + '\n';
    if (notes.length > 5) out += '… و ' + tgFa_(notes.length - 5) + ' جملهٔ دیگر در تب «' + TG_WF_TAB + '»';
  }
  return out;
}

/* ==================== خوشامد عضویت مدرسه و کامیونیتی ==================== */
function tgCpWelcome_(camp, lead, chat) {
  if (!chat) return null;
  var name = tgCpS_(lead['نام کامل']);
  var txt = '🎓 <b>خوش آمدید به مدرسهٔ تجربه</b>' + '\n' + '\n' +
    (name ? (tgEsc_(name) + ' عزیز، ') : '') + 'ثبت‌نام شما در «' + tgEsc_(camp.course) + '» قطعی شد.' + '\n' + '\n' +
    'از امروز عضو مدرسهٔ تجربه‌اید: برنامهٔ حلقه، سوپرویژن و مسیر کارورزی بالینی از همین‌جا به شما می‌رسد.' + '\n' + '\n' +
    'عضویت شما در کامیونیتی تجربه هم همین حالا فعال شد؛ ژورنال کلاب و برنامه‌های عمومی مدرسه را اول از همه خبر می‌دهیم.';
  tgSend_(chat, txt);
  try { tgCpCommAuto_(lead, chat, camp); } catch (e) { tgErr_('tgCpCommAuto_: ' + e); }
  return tgSend_(chat, 'کدام برنامه‌ها برایتان جالب‌تر است؟ یکی را بزنید، بعداً هم می‌شود عوض کرد.', {
    inline_keyboard: [
      [{ text: '📚 ژورنال کلاب', callback_data: 'cp:ci:jc' }, { text: '🛠 کارگاه', callback_data: 'cp:ci:ws' }],
      [{ text: '🎙 نشست و گفت‌وگو', callback_data: 'cp:ci:tk' }, { text: '🤷 فرقی ندارد', callback_data: 'cp:ci:any' }]
    ]
  });
}

function tgCpCommAuto_(lead, chat, camp) {
  if (TG_DRY) { TG_OUTBOX.push({ kind: 'comm', chat: String(chat) }); return; }
  if (tgCommHas_(chat)) return;
  tgSchSheet_(TG_SCH_T_COMM, TG_SCH_COMM_HEAD).appendRow([
    tgJDateFull_(new Date(), TG_TZ), tgCpS_(lead['نام کامل']), tgCpS_(lead['یوزرنیم تلگرام']),
    String(chat), '', tgCpS_(lead['شمارهٔ تماس']), '', '', 'عضویت دوره ' + camp.code, 'فعال',
    'خودکار بعد از ثبت‌نام قطعی'
  ]);
}

var TG_CP_CI = { jc: 'ژورنال کلاب', ws: 'کارگاه', tk: 'نشست و گفت‌وگو', any: 'فرقی ندارد' };

function tgCpCommInterest_(chat, key) {
  var lbl = TG_CP_CI[key] || '';
  if (!lbl) return null;
  if (!TG_DRY) {
    try {
      var sh = tgSchSS_().getSheetByName(TG_SCH_T_COMM);
      if (sh && sh.getLastRow() > 1) {
        var v = sh.getRange(2, 1, sh.getLastRow() - 1, TG_SCH_COMM_HEAD.length).getDisplayValues();
        for (var i = v.length - 1; i >= 0; i--) {
          if (String(v[i][3]).trim() === String(chat)) {
            sh.getRange(i + 2, 8).setValue(lbl);
            break;
          }
        }
      }
    } catch (e) { tgErr_('tgCpCommInterest_: ' + e); }
  }
  return tgSend_(chat, 'ثبت شد: ' + lbl + '. هر وقت برنامه‌ای داشتیم خبرتان می‌کنیم 🌿');
}

/* ==================== میز ثبت‌نام‌کنندگان برای مدرسه ==================== */
function tgCpWho_(chat, code) {
  var st = tgCpReconStats(code);
  if (!st) return tgSend_(chat, 'برای ' + tgEsc_(code) + ' هنوز لیدی در «درخواست عضویت» نیست.');
  var line = function (o) { var a = []; for (var k in o) if (o[k]) a.push(tgEsc_(k) + ': ' + tgFa_(o[k])); return a.join('\n'); };
  var txt = '👥 <b>لیدهای ' + tgEsc_(code) + '</b>' + '\n' +
    'جمع: ' + tgFa_(st.all) + ' نفر' + '\n' + '\n' +
    '<b>مرحله</b>' + '\n' + line(st.stage) + '\n' + '\n' +
    '<b>وضعیت</b>' + '\n' + line(st.status) + '\n' + '\n' +
    '<b>دسترسی</b>' + '\n' + line(st.access) + '\n' + '\n' +
    'همه در تب «درخواست عضویت» هاب مدرسه‌اند؛ ستون «کد کمپین» را فیلتر کنید.';
  return tgSend_(chat, txt, {
    inline_keyboard: [
      [{ text: '📵 خارج از بات', callback_data: 'cp:wo:' + code }],
      [{ text: '🔄 به‌روزرسانی', callback_data: 'cp:wr:' + code }]
    ]
  });
}

/* v142: کسانی که chat_id ندارند، از تب اصلی */
function tgCpWhoOut_(chat, code) {
  var rows = tgCpRead_(TG_SCH_T_REQ).filter(function (l) {
    return tgCpS_(l['کد کمپین']) === code && !tgCpS_(l['chat_id']) && !tgSchClosed_(tgSchStNorm_(l['وضعیت']).st);
  });
  if (!rows.length) return tgSend_(chat, 'کسی خارج از بات نمانده 🌿');
  var txt = '📵 <b>خارج از بات، پیگیری دستی</b> (' + tgFa_(rows.length) + ' نفر)' + '\n' +
    'پیام بات به این‌ها نمی‌رسد. با تماس یا پیامک پیگیری شوند.' + '\n' + '\n';
  for (var j = 0; j < Math.min(rows.length, 25); j++) {
    txt += '• ' + tgEsc_(tgCpS_(rows[j]['نام کامل'])) + ' · ' + tgEsc_(tgCpS_(rows[j]['شمارهٔ تماس'])) +
      ' · ' + tgEsc_(tgCpS_(rows[j]['مرحلهٔ قیف'])) + '\n';
  }
  if (rows.length > 25) txt += '\n' + '… و ' + tgFa_(rows.length - 25) + ' نفر دیگر در تب «درخواست عضویت».';
  return tgSend_(chat, txt);
}

function tgCpReconTick_(now) { return; /* v142: تب پیگیری بایگانی شد */ }

function tgWfTests() {
  var out = [], pass = 0, fail = 0;
  var ok = function (t, c) { if (c) { pass++; } else { fail++; out.push('❌ ' + t); } };
  var old = TG_DRY; TG_DRY = true;
  TG_OUTBOX = []; TG_MEM = {};
  tgWfStart_(1, 'EFT-1');
  ok('پرسش اول آمد', JSON.stringify(TG_OUTBOX).indexOf('محتوای وبینار') > -1);
  tgWfAnswer_(1, 'EFT-1', 0, '5');
  tgWfAnswer_(1, 'EFT-1', 1, 'مناسب');
  tgWfAnswer_(1, 'EFT-1', 2, 'زودتر');
  TG_OUTBOX = [];
  tgWfAnswer_(1, 'EFT-1', 3, 'روشن');
  ok('جملهٔ اختیاری پرسیده شد', JSON.stringify(TG_OUTBOX).indexOf('یک جمله') > -1);
  TG_OUTBOX = [];
  tgWfText_(1, 'خیلی خوب بود');
  var s = JSON.stringify(TG_OUTBOX);
  ok('ردیف بی‌نام ثبت شد', s.indexOf('"kind":"wf"') > -1 && s.indexOf('خیلی خوب بود') > -1);
  var wfo = TG_OUTBOX.filter(function (x) { return x.kind === 'wf'; })[0];
  ok('هویت در ردیف نیست', !!wfo && JSON.stringify(wfo).indexOf('chat') < 0 && wfo.row.length === TG_WF_HEAD.length);
  ok('پیام تشکر رفت', s.indexOf('ثبت شد') > -1);
  TG_OUTBOX = [];
  tgWfStart_(1, 'EFT-1');
  ok('بازخورد دوم رد شد', JSON.stringify(TG_OUTBOX).indexOf('قبلاً ثبت شده') > -1);
  TG_MEM['wfrows'] = [
    ['', 'EFT-1', '3', 'طولانی', 'زودتر', 'تا حدی', 'یک'],
    ['', 'EFT-1', '3', 'طولانی', 'زودتر', 'روشن نبود', ''],
    ['', 'EFT-1', '4', 'مناسب', 'مناسب', 'روشن', '']
  ];
  var rep = tgWfReport_('EFT-1');
  ok('گزارش میانگین دارد', rep.indexOf('میانگین محتوا') > -1);
  ok('گزارش رهنمود دارد', rep.indexOf('برای وبینار بعدی') > -1);
  ok('رهنمود ساعت آمد', rep.indexOf('ساعت ۱۸ یا ۱۹') > -1);
  ok('رهنمود مسیر ثبت‌نام آمد', rep.indexOf('اسلاید') > -1);
  TG_DRY = old;
  Logger.log('بازخورد وبینار: ' + pass + ' قبول · ' + fail + ' مردود' + (fail ? '\n' + out.join('\n') : ''));
  return { pass: pass, fail: fail, text: out.join('\n') };
}


/* ---------- فرم کامل ثبت‌نام دورهٔ EFT: ذخیرهٔ منظم و نمایش به مصاحبه‌گر (v128) ---------- */
/* فرم ۱۶ پرسشی سایت (فرم ۱۵) علاوه بر «درخواست عضویت»، کامل و ستون‌به‌ستون در تب
   «فرم ثبت‌نام EFT» هاب مدرسه می‌نشیند تا مصاحبه‌گر و پذیرش همان چیزی را ببینند
   که متقاضی نوشته است. */

var TG_EFT_TAB  = 'فرم ثبت‌نام EFT';
var TG_EFT_HEAD = ['تاریخ ثبت', 'کد درخواست', 'نام و نام خانوادگی', 'شمارهٔ تماس', 'ایمیل', 'سن', 'شهر',
  'جنسیت', 'شغل فعلی', 'آخرین مدرک تحصیلی', 'دانشگاه', 'تجربهٔ درمان شخصی', 'سابقهٔ کار بالینی',
  'سوپرویژن', 'آموزش‌های قبلی', 'هدف از دوره', 'آشنایی با دوره', 'آیدی تلگرام', 'دوره', 'کد کمپین'];

var TG_EFT_MAP = [
  ['names', 'نام و نام خانوادگی'], ['mobile', 'شمارهٔ تماس'], ['email', 'ایمیل'], ['age', 'سن'],
  ['city', 'شهر'], ['gender', 'جنسیت'], ['job', 'شغل فعلی'], ['edu', 'آخرین مدرک تحصیلی'],
  ['university', 'دانشگاه'], ['own_therapy', 'تجربهٔ درمان شخصی'], ['practice', 'سابقهٔ کار بالینی'],
  ['supervisor', 'سوپرویژن'], ['training', 'آموزش‌های قبلی'], ['goal', 'هدف از دوره'],
  ['source', 'آشنایی با دوره'], ['tg_id', 'آیدی تلگرام'], ['course', 'دوره'], ['camp', 'کد کمپین']
];

var TG_EFT_SHOW = ['سن', 'شهر', 'جنسیت', 'شغل فعلی', 'آخرین مدرک تحصیلی', 'دانشگاه',
  'تجربهٔ درمان شخصی', 'سابقهٔ کار بالینی', 'سوپرویژن', 'آموزش‌های قبلی', 'هدف از دوره', 'آشنایی با دوره'];

function tgEftIs_(flat, src) {
  var f = String((flat && flat.form_id) || '').trim();
  if (f === '15') return true;
  var s = String(src || '') + ' ' + String((flat && flat.source) || '');
  return s.indexOf('ثبت‌نام دورهٔ EFT') > -1;
}

function tgEftVal_(flat, key) {
  if (!flat) return '';
  var v = flat[key];
  if (v === undefined || v === null) return '';
  if (Object.prototype.toString.call(v) === '[object Array]') return v.join(' · ');
  return String(v).trim();
}

function tgEftSheet_() {
  var ss = tgSchSS_();
  var sh = ss.getSheetByName(TG_EFT_TAB);
  if (!sh) sh = ss.insertSheet(TG_EFT_TAB);
  if (sh.getLastRow() === 0) {
    sh.appendRow(TG_EFT_HEAD);
    sh.setFrozenRows(1);
    sh.getRange(1, 1, 1, TG_EFT_HEAD.length).setFontWeight('bold');
  }
  return sh;
}

/* شمارهٔ متقاضی را به «درخواست عضویت» وصل می‌کنیم تا کد درخواست همان باشد */
function tgEftReqId_(phone) {
  var want = tgRcPhone_(phone);
  if (!want) return '';
  try {
    var sh = tgSchSS_().getSheetByName(TG_SCH_T_REQ);
    if (!sh || sh.getLastRow() < 2) return '';
    var vals = sh.getDataRange().getValues();
    var head = vals[0];
    var ci = head.indexOf('شمارهٔ تماس'), ii = head.indexOf('شناسهٔ درخواست');
    if (ci < 0 || ii < 0) return '';
    for (var r = vals.length - 1; r > 0; r--) {
      if (tgRcPhone_(vals[r][ci]) === want) return String(vals[r][ii] || '').trim();
    }
  } catch (e) { tgErr_('tgEftReqId_: ' + e); }
  return '';
}

function tgEftSave_(flat, src) {
  if (!tgEftIs_(flat, src)) return '';
  var o = {};
  for (var i = 0; i < TG_EFT_MAP.length; i++) o[TG_EFT_MAP[i][1]] = tgEftVal_(flat, TG_EFT_MAP[i][0]);
  o['تاریخ ثبت'] = tgJDateFull_(new Date(), TG_TZ);
  if (!o['کد کمپین']) o['کد کمپین'] = 'EFT-1';
  /* v142: فرم کامل یعنی «درخواست دوره»؛ سطر اصلی همان لحظه ساخته یا جلو برده می‌شود */
  o['کد درخواست'] = '';
  if (!TG_DRY) {
    try {
      var madeE = tgSchLeadEnsure_({ name: o['نام و نام خانوادگی'], phone: o['شمارهٔ تماس'], email: o['ایمیل'], camp: o['کد کمپین'],
        course: o['دوره'], uni: o['دانشگاه'], stage: TG_SCH_STAGES[TG_SCH_SG.apply], src: src || 'سایت › فرم ثبت‌نام',
        memo: 'فرم کامل ثبت‌نام از سایت', actor: 'سایت', channel: 'سایت' });
      o['کد درخواست'] = madeE.id || tgEftReqId_(o['شمارهٔ تماس']);
    } catch (eE) { tgErr_('tgEftSave_ ensure: ' + eE); o['کد درخواست'] = tgEftReqId_(o['شمارهٔ تماس']); }
  }
  var row = [];
  for (var j = 0; j < TG_EFT_HEAD.length; j++) {
    var cell = o[TG_EFT_HEAD[j]] || '';
    if (TG_EFT_HEAD[j] === 'شمارهٔ تماس' && cell) cell = "'" + cell;
    row.push(cell);
  }
  if (TG_DRY) { TG_MEM['eftrows'] = (TG_MEM['eftrows'] || []).concat([row]); return 'dry'; }
  tgEftSheet_().appendRow(row);
  try {
    tgSchoolNotify_('📄 فرم کامل ثبت‌نام EFT رسید: <b>' + tgEsc_(o['نام و نام خانوادگی']) + '</b>' +
      (o['کد درخواست'] ? ' · ' + tgEsc_(o['کد درخواست']) : '') +
      '\nهمهٔ پاسخ‌ها در تب «فرم ثبت‌نام EFT» هاب مدرسه است.');
  } catch (e) { tgErr_('tgEftSave_: ' + e); }
  return o['کد درخواست'] || 'ok';
}

function tgEftRow_(key) {
  var k = String(key || '').trim();
  if (!k) return null;
  var want = tgRcPhone_(k);
  try {
    var sh = tgSchSS_().getSheetByName(TG_EFT_TAB);
    if (!sh || sh.getLastRow() < 2) return null;
    var vals = sh.getDataRange().getValues();
    var head = vals[0];
    for (var r = vals.length - 1; r > 0; r--) {
      var o = {};
      for (var c = 0; c < head.length; c++) o[String(head[c])] = vals[r][c];
      if (String(o['کد درخواست'] || '').trim() === k) return o;
      var p = tgRcPhone_(o['شمارهٔ تماس']);
      if (want && p && p === want) return o;
    }
  } catch (e) { tgErr_('tgEftRow_: ' + e); }
  return null;
}

function tgEftCut_(v, n) {
  var s = String(v === null || v === undefined ? '' : v).trim();
  return s.length > n ? s.slice(0, n) + '…' : s;
}

function tgEftCard_(key) {
  var o = tgEftRow_(key);
  if (!o) return '';
  var t = '📄 <b>فرم ثبت‌نام دورهٔ EFT</b>\n' + tgEsc_(tgEftCut_(o['نام و نام خانوادگی'], 60));
  if (String(o['کد درخواست'] || '').trim()) t += ' · ' + tgEsc_(String(o['کد درخواست']).trim());
  t += '\n\n';
  for (var i = 0; i < TG_EFT_SHOW.length; i++) {
    var v = tgEftCut_(o[TG_EFT_SHOW[i]], 320);
    if (v) t += '<b>' + TG_EFT_SHOW[i] + ':</b> ' + tgEsc_(v) + '\n';
  }
  var tg = tgEftCut_(o['آیدی تلگرام'], 40), ph = tgEftCut_(o['شمارهٔ تماس'], 20);
  if (tg || ph) t += '\n' + (tg ? 'تلگرام: ' + tgEsc_(tg) : '') + (tg && ph ? ' · ' : '') + (ph ? 'شماره: ' + tgEsc_(ph) : '');
  t += '\n\nاین اطلاعات فقط برای مصاحبه و پذیرش است.';
  return t.length > 3800 ? t.slice(0, 3800) + '…' : t;
}

function tgEftShow_(chat, key, uname) {
  var may = false;
  try { may = tgCpIsOwner_(chat) || !!tgCpIvWho_(chat, uname); } catch (e) {}
  if (!may) return null;
  var t = tgEftCard_(key);
  if (!t) return tgSend_(chat, 'فرم کامل این متقاضی هنوز ثبت نشده است. اگر از فرم سایت ثبت‌نام کرده باشد، همین‌جا می‌آید.');
  return tgSend_(chat, t);
}

function tgEftTests() {
  var out = [], pass = 0, fail = 0;
  var ok = function (t, c) { if (c) { pass++; } else { fail++; out.push('❌ ' + t); } };
  var old = TG_DRY; TG_DRY = true;
  TG_OUTBOX = []; TG_MEM = {};
  ok('تب و ستون‌ها تعریف شده‌اند', TG_EFT_TAB === 'فرم ثبت‌نام EFT' && TG_EFT_HEAD.length === 20);
  var allCols = true;
  for (var i = 0; i < TG_EFT_MAP.length; i++) { if (TG_EFT_HEAD.indexOf(TG_EFT_MAP[i][1]) < 0) allCols = false; }
  ok('هر کلید فرم یک ستون دارد', allCols);
  ok('فرم ۱۵ شناخته می‌شود', tgEftIs_({ form_id: 15 }, '') === true);
  ok('منبع مدرسه هم شناخته می‌شود', tgEftIs_({}, 'سایت › مدرسه › ثبت‌نام دورهٔ EFT') === true);
  ok('فرم دیگر رد می‌شود', tgEftIs_({ form_id: 6 }, 'سایت › مدرسه › پیش‌ثبت‌نام دوره') === false);
  ok('مقدار آرایه‌ای تمیز می‌شود', tgEftVal_({ x: ['الف', 'ب'] }, 'x') === 'الف · ب');
  ok('مقدار نبوده خالی است', tgEftVal_({}, 'y') === '');
  ok('متن بلند کوتاه می‌شود', tgEftCut_('12345', 3) === '123…');
  TG_MEM['eftrows'] = [];
  var r = tgEftSave_({ form_id: 15, names: 'سارا نمونه', mobile: '09121112233', age: '۳۴', city: 'تهران', goal: 'کار بالینی' }, '');
  var rows = TG_MEM['eftrows'] || [];
  ok('سطر در حالت آزمایشی ساخته شد', r === 'dry' && rows.length === 1 && rows[0].length === TG_EFT_HEAD.length);
  ok('نام در ستون درست نشست', rows.length === 1 && rows[0][TG_EFT_HEAD.indexOf('نام و نام خانوادگی')] === 'سارا نمونه');
  ok('کد کمپین پیش‌فرض خورد', rows.length === 1 && rows[0][TG_EFT_HEAD.indexOf('کد کمپین')] === 'EFT-1');
  ok('فرم نامربوط سطر نمی‌سازد', tgEftSave_({ form_id: 7, names: 'الف' }, '') === '');
  ok('شماره یکدست می‌شود', tgRcPhone_('0098 912 111 2233') === tgRcPhone_('09121112233'));
  ok('متن‌ها خط تیرهٔ وسط جمله ندارند', TG_EFT_SHOW.join(' ').indexOf('—') < 0 && TG_EFT_HEAD.join(' ').indexOf('—') < 0);
  TG_DRY = old; TG_MEM['eftrows'] = null;
  Logger.log('فرم EFT: ' + pass + ' قبول · ' + fail + ' مردود' + (fail ? '\n' + out.join('\n') : ''));
  return { pass: pass, fail: fail, text: out.join('\n') };
}



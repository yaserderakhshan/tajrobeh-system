/* v86: رزرو جلسهٔ درمان و تکرار هفتگی */
function tgSessTests() {
  var out = [], pass = 0, fail = 0;
  function ok(n, c) { c ? pass++ : fail++; out.push((c ? '✅ ' : '❌ ') + n); }
  var wasDry = TG_DRY;
  TG_DRY = true;
  function said() { return TG_OUTBOX.filter(function (x) { return x.kind === 'msg'; }).map(function (x) { return x.text + ' ' + JSON.stringify(x.markup || ''); }).join('\n'); }
  function kinds(k) { return TG_OUTBOX.filter(function (x) { return x.kind === k; }); }
  function rule() { return [{ name: 'درمانگر تست', iso: 3, hhmm: '17:00', pool: 'هر دو', kind: TG_KIND_SESS, row: 5 }]; }
  function nextWed() {
    for (var k = 1; k < 21; k++) {
      var dd = new Date(Date.now() + k * 86400000);
      if (Number(Utilities.formatDate(dd, TG_TZ, 'u')) === 3) return Utilities.formatDate(dd, TG_TZ, 'yyyy-MM-dd');
    }
    return '';
  }
  try {
    TG_OUTBOX = []; TG_MEM = {};
    tgSessStart_(910);
    ok('بدون درمانگر، راهنمایی می‌شود', said().indexOf('شروع درمان') > -1);

    TG_OUTBOX = []; TG_MEM = {};
    TG_MEM['mythera'] = 'درمانگر تست'; TG_MEM['weekrules'] = []; TG_MEM['sessrows'] = [];
    tgSessStart_(910);
    ok('بدون وقت درمان، پیام روشن می‌دهد', said().indexOf('وقت آزادی') > -1);

    TG_OUTBOX = []; TG_MEM = {};
    TG_MEM['mythera'] = 'درمانگر تست'; TG_MEM['weekrules'] = rule(); TG_MEM['sessrows'] = [];
    tgSessStart_(910);
    ok('وقت‌های درمان پیشنهاد می‌شود', said().indexOf('جلسهٔ درمان با') > -1 && said().indexOf('ss:0') > -1);
    ok('طول جلسه گفته می‌شود', said().indexOf('۵۰ دقیقه') > -1);

    /* وقت پرشده دیگر پیشنهاد نمی‌شود */
    TG_OUTBOX = []; TG_MEM = {};
    TG_MEM['mythera'] = 'درمانگر تست'; TG_MEM['weekrules'] = rule();
    TG_MEM['sessrows'] = [{ row: 2, name: 'درمانگر تست', dateIso: nextWed(), hhmm: '17:00', status: 'رزرو شده', weekly: '' }];
    ok('وقت رزروشده از فهرست حذف می‌شود', tgSessFree_('درمانگر تست').filter(function (s) { return s.dateIso === nextWed(); }).length === 0);

    /* قفل هفتگی همان روز و ساعت را برای همیشه می‌بندد */
    TG_MEM['sessrows'] = [{ row: 2, name: 'درمانگر تست', dateIso: nextWed(), hhmm: '17:00', status: 'رزرو شده', weekly: 'بله' }];
    ok('تکرار هفتگی ظرفیت آن اسلات را قفل می‌کند', tgSessFree_('درمانگر تست').length === 0);

    /* رزرو کامل */
    TG_OUTBOX = []; TG_MEM = {};
    TG_MEM['mythera'] = 'درمانگر تست'; TG_MEM['weekrules'] = rule(); TG_MEM['sessrows'] = [];
    tgSessStart_(910);
    TG_OUTBOX = [];
    tgOnSessBook_(910, 0);
    ok('رزرو در تب جلسه‌های درمان ثبت می‌شود', kinds('sess').length === 1 && kinds('sess')[0].len === 50);
    ok('رویداد تک‌جلسه ساخته می‌شود', kinds('cal').length === 1 && !kinds('cal')[0].weekly);
    ok('پیشنهاد تکرار هفتگی با لحن غیرالزامی می‌آید', said().indexOf('هفتگی برای خودتان نگه دارید') > -1 && said().indexOf('الزامی نیست') > -1);
    ok('دو دکمهٔ بله و نه دارد', said().indexOf('sw:y') > -1 && said().indexOf('sw:n') > -1);

    TG_OUTBOX = [];
    tgOnSessWeekly_(910, true);
    ok('تکرار هفتگی رویداد تکرارشونده می‌سازد', kinds('cal').length === 1 && kinds('cal')[0].weekly === true);
    ok('رویداد تک‌جلسه برداشته می‌شود', kinds('caldrop').length === 1);
    ok('ستون تکرار هفتگی پر می‌شود', kinds('sessset').filter(function (x) { return x.head === 'تکرار هفتگی؟' && x.val === 'بله'; }).length === 1);

    TG_OUTBOX = []; TG_MEM = {};
    TG_MEM['mythera'] = 'درمانگر تست'; TG_MEM['weekrules'] = rule(); TG_MEM['sessrows'] = [];
    tgSessStart_(910); TG_OUTBOX = []; tgOnSessBook_(910, 0); TG_OUTBOX = [];
    tgOnSessWeekly_(910, false);
    ok('«فعلاً همین یک جلسه» چیزی قفل نمی‌کند', kinds('cal').length === 0 && kinds('sessset').length === 0 && said().indexOf('همین یک جلسه') > -1);
  } catch (e) { ok('اجرای تست بدون خطا · ' + e, false); }
  TG_DRY = wasDry;
  return { pass: pass, fail: fail, text: out.join('\n') };
}


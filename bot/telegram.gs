    tgWaMsg_({ id: 'wamid.T1', from: '905355136950', type: 'text', text: { body: 'سلام' }, timestamp: '1789413018' }, 'مراجع', '+90 535 513 69 50');
    ok('پیام ورودی رویداد واتس‌اپ می‌سازد',
       TG_OUTBOX.filter(function (o) { return o.kind === 'leadev' && o.o && o.o.what === 'پیام واتس‌اپ'; }).length === 1);

    ok('war در کلیدهای کش هر پیام هست', TG_MEMO_KEYS.indexOf('war') > -1);
    ok('کد دکمه زیر ۶۴ بایت است', ('wa:r:L-1042').length <= 64);
    ok('تنظیمات خوانده می‌شود بدون استثنا', typeof tgWaReady_() === 'boolean');
  } catch (e) {
    fail++; out.push('❌ استثنا: ' + e);
  }
  TG_DRY = wasDry; TG_DRY_LEAD = wasLead; TG_OUTBOX = wasOut; TG_DRY_LEADROW = wasRow;
  return { pass: pass, fail: fail, text: out.join('\n') };
}

/* ============================================================
   وقت‌ها و پیگیری جلسه (v94)
   ۱) ساعت شروع آزاد است، نه فقط ساعت کامل
   ۲) هر درمانگر طول جلسه و فاصلهٔ استراحت خودش را دارد
   ۳) بعد از هر معارفه، بات می‌پرسد برگزار شد یا نه و رها نمی‌کند
   ============================================================ */

const TG_GAP_DEF    = 10;    // فاصلهٔ استراحت پیش‌فرض، دقیقه
const TG_GAP_MAX    = 60;
const TG_SESS_CAP   = 40;    // سقف وقت هفتگی درمان. عملاً بی‌حد
const TG_CHAIN_MAX  = 6;     // چند جلسهٔ پشت سر هم در یک بار اعلام
const TG_HELD_AFTER = 120;   // دقیقه بعد از پایان جلسه که می‌پرسیم
const TG_HELD_RETRY = 1440;  // اگر جواب نداد، یک بار دیگر بعد از یک روز
const TG_START_DAYS = 3;     // چند روز بعد از معارفه «شروع درمان؟» را بپرسیم
const TG_MT_MAX     = 6;     // بیشترین پرسش در هر نوبت تیک

const TG_H_HELD  = 'برگزار شد؟';
const TG_H_HANS  = 'تاریخ پاسخ';
const TG_H_HWHO  = 'پاسخ‌دهنده';
const TG_H_NEXT  = 'پیگیری بعدی';
const TG_H_START = 'شروع درمان؟';
const TG_HEAD_LEN = 'طول جلسهٔ درمان (دقیقه)';
const TG_HEAD_GAP = 'فاصلهٔ استراحت (دقیقه)';

/* ---------- طول جلسه و فاصلهٔ استراحت ---------- */

// یک ستون تب درمانگران را با نام هدرش پیدا می‌کند و اگر نبود می‌سازد
function tgScTherCol_(head) {
  if (TG_DRY) return 0;
  const sh = tgSS_().getSheetByName(TG_THER);
  if (!sh) return 0;
  const lc = Math.max(sh.getLastColumn(), 1);
  const hd = sh.getRange(3, 1, 1, lc).getValues()[0];
  for (var i = 0; i < lc; i++) if (String(hd[i]).trim() === head) return i + 1;
  const c = lc + 1;
  sh.getRange(3, c).setValue(head).setFontWeight('bold');
  return c;
}

function tgScTherNum_(name, head) {
  if (TG_DRY) return Number(TG_MEM['schnum:' + name + ':' + head] || 0);
  try {
    const sh = tgSS_().getSheetByName(TG_THER);
    const col = tgScTherCol_(head);
    if (!sh || !col || sh.getLastRow() < 4) return 0;
    const key = tgNorm_(name);
    const v = sh.getRange(4, 1, sh.getLastRow() - 3, 1).getValues();
    for (var i = 0; i < v.length; i++) {
      if (tgNorm_(String(v[i][0])) !== key) continue;
      return Number(String(tgLatinDigits_(sh.getRange(i + 4, col).getValue())).replace(/[^0-9]/g, '')) || 0;
    }
  } catch (e) { try { tgErr_('tgScTherNum_: ' + e); } catch (e2) {} }
  return 0;
}

function tgScTherSet_(name, head, val) {
  if (TG_DRY) { TG_MEM['schnum:' + name + ':' + head] = val; return true; }
  try {
    const sh = tgSS_().getSheetByName(TG_THER);
    const col = tgScTherCol_(head);
    if (!sh || !col || sh.getLastRow() < 4) return false;
    const key = tgNorm_(name);
    const v = sh.getRange(4, 1, sh.getLastRow() - 3, 1).getValues();
    for (var i = 0; i < v.length; i++) {
      if (tgNorm_(String(v[i][0])) !== key) continue;
      sh.getRange(i + 4, col).setValue(val);
      try { CacheService.getScriptCache().remove('trows'); } catch (e) {}
      return true;
    }
  } catch (e) { try { tgErr_('tgScTherSet_: ' + e); } catch (e2) {} }
  return false;
}

// فاصلهٔ استراحت این درمانگر
function tgScGap_(name) {
  const own = tgScTherNum_(name, TG_HEAD_GAP);
  if (own > 0) return Math.min(own, TG_GAP_MAX);
  if (TG_DRY) return TG_GAP_DEF;
  var pol = 0;
  try { pol = Number(tgPol_('فاصلهٔ استراحت', TG_GAP_DEF)) || TG_GAP_DEF; } catch (e) { pol = TG_GAP_DEF; }
  return Math.max(0, Math.min(pol, TG_GAP_MAX));
}

// طول خود جلسه، بدون استراحت
function tgScLen_(name, kind) {
  if (kind !== TG_KIND_SESS) return TG_SLOT_MIN;
  const own = tgScTherNum_(name, TG_HEAD_LEN);
  if (own >= 20 && own <= 120) return own;
  return tgTherSlen_(name);
}

// فاصلهٔ شروع تا شروع وقت بعدی
function tgScStep_(name, kind) {
  return tgScLen_(name, kind) + tgScGap_(name);
}

/* ---------- ساعت آزاد ---------- */

// هر شکل معقولی از ساعت را به HH:MM تبدیل می‌کند، وگرنه رشتهٔ خالی
function tgScTime_(text) {
  var t = tgLatinDigits_(String(text || '')).trim();
  t = t.replace(/[.٫،]/g, ':').replace(/\s+/g, '');
  var m = t.match(/^(\d{1,2}):(\d{1,2})$/);
  var h, mi;
  if (m) { h = Number(m[1]); mi = Number(m[2]); }
  else {
    var m2 = t.match(/^(\d{1,2})$/);
    if (m2) { h = Number(m2[1]); mi = 0; }
    else {
      var m3 = t.match(/^(\d{2})(\d{2})$/);
      if (!m3) return '';
      h = Number(m3[1]); mi = Number(m3[2]);
    }
  }
  if (!(h >= 0 && h <= 23) || !(mi >= 0 && mi <= 59)) return '';
  mi = Math.round(mi / 5) * 5;
  if (mi === 60) { mi = 0; h = (h + 1) % 24; }
  return ('0' + h).slice(-2) + ':' + ('0' + mi).slice(-2);
}

function tgScAddMin_(hhmm, min) {
  const t = Number(hhmm.split(':')[0]) * 60 + Number(hhmm.split(':')[1]) + min;
  const d = ((t % 1440) + 1440) % 1440;
  return ('0' + Math.floor(d / 60)).slice(-2) + ':' + ('0' + (d % 60)).slice(-2);
}

function tgScMin_(hhmm) {
  return Number(hhmm.split(':')[0]) * 60 + Number(hhmm.split(':')[1]);
}

// ساعت دلخواهی که درمانگر تایپ می‌کند
function tgScHourText_(chat, who, text) {
  if (!who) return false;
  if (!tgGetVal_('sfh', chat)) return false;
  const t = String(text || '').trim();
  if (!t) return false;
  if (t === 'انصراف' || t === '↩️ بازگشت' || t.indexOf('/') === 0 || tgIsBtnLike_(t)) {
    tgDel_('sfh', chat);
    return false;
  }
  const hhmm = tgScTime_(t);
  if (!hhmm) {
    tgSend_(chat, 'ساعت را این‌طور بنویسید: ۱۰:۱۵ یا ۱۰.۱۵\nیا یکی از دکمه‌های بالا را بزنید.');
    return true;
  }
  tgDel_('sfh', chat);
  tgAskCount_(chat, hhmm);
  return true;
}

/* ---------- تداخل ---------- */

// آیا این ساعت با وقت‌های همان روز همین درمانگر تداخل دارد
function tgScClash_(name, day, hhmm, kind) {
  const step = tgScStep_(name, kind);
  const newS = tgScMin_(hhmm), newE = newS + step;
  var rows = [];
  try { rows = tgMyWeekly_(name, TG_KIND_MEET).concat(tgMyWeekly_(name, TG_KIND_SESS)); } catch (e) { return ''; }
  for (var i = 0; i < rows.length; i++) {
    if (String(rows[i].day).trim() !== String(day).trim()) continue;
    const oS = tgScMin_(rows[i].hhmm);
    const oE = oS + tgScStep_(name, rows[i].kind || TG_KIND_MEET);
    if (newS < oE && oS < newE) return rows[i].hhmm;
  }
  return '';
}

/* ---------- تنظیم طول و استراحت توسط خود درمانگر ---------- */

function tgScSetStart_(chat, who) {
  if (!who) return null;
  tgSetVal_('scg', chat, 'len');
  const len = tgScLen_(who.name, TG_KIND_SESS), gap = tgScGap_(who.name);
  return tgSend_(chat,
    '⏱ <b>طول جلسه و استراحت</b>\n\n' +
    'الان: هر جلسهٔ درمان ' + tgFa_(len) + ' دقیقه، با ' + tgFa_(gap) + ' دقیقه استراحت بعدش.\n\n' +
    'طول جلسهٔ درمان را به دقیقه بنویسید، بین ۲۰ تا ۱۲۰.\nبرای بی‌خیال شدن «انصراف» بفرستید.');
}

function tgScSetText_(chat, who, text) {
  if (!who) return false;
  const st = tgGetVal_('scg', chat);
  if (!st) return false;
  const t = String(text || '').trim();
  if (!t) return false;
  if (t === 'انصراف' || t === '↩️ بازگشت' || t.indexOf('/') === 0 || tgIsBtnLike_(t)) {
    tgDel_('scg', chat);
    return false;
  }
  const n = Number(tgLatinDigits_(t).replace(/[^0-9]/g, ''));
  if (st === 'len') {
    if (!(n >= 20 && n <= 120)) { tgSend_(chat, 'یک عدد بین ۲۰ تا ۱۲۰ بنویسید.'); return true; }
    tgScTherSet_(who.name, TG_HEAD_LEN, n);
    tgSetVal_('scg', chat, 'gap');
    tgSend_(chat, '✅ طول جلسه ' + tgFa_(n) + ' دقیقه شد.\n\nحالا فاصلهٔ استراحت بین دو جلسه را بنویسید، بین ۰ تا ۶۰ دقیقه.');
    return true;
  }
  if (st === 'gap') {
    if (!(n >= 0 && n <= TG_GAP_MAX)) { tgSend_(chat, 'یک عدد بین ۰ تا ۶۰ بنویسید.'); return true; }
    tgDel_('scg', chat);
    tgScTherSet_(who.name, TG_HEAD_GAP, n);
    const len = tgScLen_(who.name, TG_KIND_SESS);
    tgSend_(chat,
      '✅ ثبت شد.\n\nجلسهٔ درمان ' + tgFa_(len) + ' دقیقه، استراحت ' + tgFa_(n) + ' دقیقه.\n' +
      'از این به بعد وقت‌های پشت سر هم با همین فاصله ساخته می‌شوند و وقت تازه‌ای که با وقت قبلی تداخل داشته باشد ثبت نمی‌شود.',
      tgTherMenu_());
    return true;
  }
  tgDel_('scg', chat);
  return false;
}

/* ---------- پیگیری برگزاری جلسه ---------- */

function tgMtHeadMap_() {
  const sh = tgSS_().getSheetByName(TG_SLOTS);
  const lc = sh.getLastColumn();
  const hd = sh.getRange(3, 1, 1, lc).getValues()[0];
  const map = {};
  for (var i = 0; i < lc; i++) map[String(hd[i]).trim()] = i;
  return map;
}

function tgMtTgId_(s) {
  const m = String(s || '').match(/tg:(\d+)/);
  return m ? m[1] : '';
}

function tgMtCheck() {
  const sh = tgSS_().getSheetByName(TG_SLOTS);
  const last = sh.getLastRow();
  const vals = sh.getRange(4, 1, last - 3, 10).getValues();
  var okn = 0, bad = [];
  for (var i = 0; i < vals.length; i++) {
    var st = String(vals[i][5] || '').trim();
    var lead = String(vals[i][7] || '').trim();
    if (st !== 'رزرو شده' || !lead) continue;
    var r = tgMtLeadOf_(lead);
    if (r >= 2) okn++; else bad.push(lead.split('·')[0].trim() + ' | ' + lead.replace(/\D/g, '').slice(-9));
  }
  Logger.log('اسلات رزروشده با لید پیداشده: ' + okn + ' | پیدا نشد: ' + bad.length);
  if (bad.length) Logger.log(bad.join('\n'));
  return okn;
}

function tgMtLeadOf_(s) {
  const m = String(s || '').match(/L-\d+/);
  if (m) {
    try { const r = tgLeadByCode_(m[0]); if (r >= 2) return r; } catch (e) {}
  }
  return tgMtLeadRow_(tgMtTgId_(s));
}

function tgMtLeadRow_(tgid) {
  if (!tgid) return -1;
  if (TG_DRY) return TG_DRY_LEADROW || -1;
  try {
    const byNote = tgFindLead_(tgid);
    if (byNote >= 2) return byNote;
  } catch (e) {}
  try {
    const sh = tgSS_().getSheetByName(TG_LEADS);
    const last = sh.getLastRow();
    if (last < 2) return -1;
    const v = sh.getRange(2, 6, last - 1, 1).getValues();
    for (var i = v.length - 1; i >= 0; i--) {
      if (String(v[i][0]).indexOf(tgid) > -1) return i + 2;
    }
  } catch (e) {}
  return -1;
}

// یک سطر اسلات را می‌خواند
function tgMtRead_(row, pre, preMap) {
  if (TG_DRY) return TG_MEM['mtrow'] || null;
  var v, map;
  if (pre && preMap) {
    v = pre; map = preMap;
  } else {
    var sh = tgSS_().getSheetByName(TG_SLOTS);
    if (!sh || row < 4 || row > sh.getLastRow()) return null;
    map = tgMtHeadMap_();
    v = sh.getRange(row, 1, 1, sh.getLastColumn()).getValues()[0];
  }
  var get = function (h) { return (map[h] === undefined) ? '' : v[map[h]]; };
  var dRaw = get('تاریخ اسلات');
  var iso = (dRaw instanceof Date) ? Utilities.formatDate(dRaw, TG_TZ, 'yyyy-MM-dd') : String(dRaw).trim();
  return {
    row: row,
    ther: String(get('نام درمانگر')).trim(),
    iso: iso,
    hhmm: tgHHMM_(get('ساعت دقیق (تهران)')),
    state: String(get('وضعیت')).trim(),
    lead: String(get('لید مرتبط')).trim(),
    held: String(get(TG_H_HELD)).trim(),
    next: String(get(TG_H_NEXT)).trim(),
    start: String(get(TG_H_START)).trim(),
    /* v168 فاز ۴ */
    ask: typeof V168_H_ASK === 'undefined' ? '' : String(get(V168_H_ASK)).trim(),
    mstate: typeof V168_H_STATE === 'undefined' ? '' : String(get(V168_H_STATE)).trim()
  };
}

function tgMtEnd_(r) {
  if (!r.iso || !r.hhmm) return null;
  try {
    const d = Utilities.parseDate(r.iso + ' ' + r.hhmm, TG_TZ, 'yyyy-MM-dd HH:mm');
    return new Date(d.getTime() + tgScLen_(r.ther, TG_KIND_MEET) * 60000);
  } catch (e) { return null; }
}

function tgMtAsk_(r) {
  const who = tgMtTgId_(r.lead);
  const nm = String(r.lead).split('·')[0].trim() || 'مراجع';
  const t = '🗓 <b>جلسهٔ معارفه</b>\n\n' + tgEsc_(nm) +
            '\nروز ' + tgEsc_(r.iso) + ' ساعت ' + tgEsc_(r.hhmm) +
            '\n\nبرگزار شد؟';
  const kb = { inline_keyboard: [
    [{ text: '✅ بله، برگزار شد', callback_data: 'mt:y:' + r.row }],
    [{ text: '🙋 مراجع نیامد', callback_data: 'mt:n:' + r.row }],
    [{ text: '↩️ لغو شده بود', callback_data: 'mt:c:' + r.row }]
  ] };
  const th = tgTherChatByName_(r.ther);
  if (th) { tgSend_(th, t, kb); return 'ther'; }
  tgDeskSay_('🗓 ' + tgEsc_(r.ther) + ' به بات وصل نیست. معارفهٔ ' + tgEsc_(nm) + ' روز ' + tgEsc_(r.iso) + ' ساعت ' + tgEsc_(r.hhmm) + ' برگزار شد؟ لطفاً خودتان بپرسید و در تب اسلات معارفه ثبت کنید.');
  return 'desk';
}

function tgMtAskStart_(r) {
  const nm = String(r.lead).split('·')[0].trim() || 'مراجع';
  const t = '🌱 ' + tgEsc_(nm) + ' بعد از معارفه درمان را شروع کرد؟';
  const kb = { inline_keyboard: [
    [{ text: '✅ بله', callback_data: 'mt:s1:' + r.row }],
    [{ text: '⏳ هنوز معلوم نیست', callback_data: 'mt:s2:' + r.row }],
    [{ text: '🚫 نه', callback_data: 'mt:s0:' + r.row }]
  ] };
  const th = tgTherChatByName_(r.ther);
  if (th) { tgSend_(th, t, kb); return 'ther'; }
  return 'none';
}

// تیک زمان‌دار
function tgMeetTick(e) {
  if (ciPaused_(e, 'tgMeetTick', 'skip')) return;
  var rs0 = Date.now(); try {   /* v166.18: سنجش زمان اجرا (بدنه بی‌تغییر) */
  if (TG_DRY) return 0;
  var asked = 0, t0 = Date.now();
  try {
    var sh = tgSS_().getSheetByName(TG_SLOTS);
    if (!sh || sh.getLastRow() < 4) return 0;
    var last = sh.getLastRow(), lc = sh.getLastColumn();
    var all = sh.getRange(4, 1, last - 3, lc).getValues();
    var map = tgMtHeadMap_();
    var now = new Date();
    for (var i = all.length - 1; i >= 0 && asked < TG_MT_MAX; i--) {
      if (Date.now() - t0 > 200000) { Logger.log('tgMeetTick: بودجهٔ زمانی تمام شد، ادامه در دور بعد'); break; }
      var row = i + 4;
      var r = tgMtRead_(row, all[i], map);
      if (!r || !r.ther || !r.iso) continue;
      if (r.state !== 'رزرو شده') continue;
      var end = tgMtEnd_(r);
      if (!end) continue;
      if (end.getTime() > now.getTime()) continue;
      if (now.getTime() - end.getTime() > 21 * 86400000) continue;

      if (!r.held && typeof v168MeetStep_ === 'function') {   /* v168 فاز ۴: درمانگر ← پذیرش ← مسئول پذیرش، هیچ معارفه‌ای بی‌نتیجه نمی‌ماند */
        if (v168MeetStep_(r, row, end, now)) asked++;
        continue;
      }
      if (!r.held) {
        if (now.getTime() < end.getTime() + TG_HELD_AFTER * 60000) continue;
        if (r.next && new Date(r.next).getTime() > now.getTime()) continue;
        tgMtAsk_(r);
        tgSlotSet_(row, TG_H_NEXT, Utilities.formatDate(new Date(now.getTime() + TG_HELD_RETRY * 60000), TG_TZ, 'yyyy-MM-dd HH:mm'));
        asked++;
        continue;
      }
      if (r.held === 'بله' && !r.start) {
        if (now.getTime() < end.getTime() + TG_START_DAYS * 86400000) continue;
        if (r.next && new Date(r.next).getTime() > now.getTime()) continue;
        tgMtAskStart_(r);
        tgSlotSet_(row, TG_H_NEXT, Utilities.formatDate(new Date(now.getTime() + 3 * 86400000), TG_TZ, 'yyyy-MM-dd HH:mm'));
        asked++;
      }
    }
  } catch (e) { try { tgErr_('tgMeetTick: ' + e); } catch (e2) {} }
  return asked;
  } finally { tgRunStat_('tgMeetTick', rs0); }
}

function tgOnMeet_(cq, rest) {
  const chat = cq.message.chat.id;
  const p = String(rest || '').split(':');
  const act = p[0] || '';
  const row = Number(p[1] || 0);
  if (!row) return null;
  const r = tgMtRead_(row);
  if (!r) return tgSend_(chat, 'این وقت پیدا نشد.');
  const me = (typeof v168MeetActor_ === 'function') ? v168MeetActor_(chat, cq, r).name : ((typeof tgTherByChat_ === 'function' && tgTherByChat_(chat)) ? tgTherByChat_(chat).name : r.ther);
  const today = Utilities.formatDate(new Date(), TG_TZ, 'yyyy-MM-dd');
  const nm = String(r.lead).split('·')[0].trim() || 'مراجع';
  const lrow = tgMtLeadOf_(r.lead);
  const code = lrow >= 2 ? tgLeadCode_(lrow) : '';
  if (typeof v168OnMeet_ === 'function' && v168OnMeet_(cq, chat, act, row, p.slice(2), r, lrow, code)) return null;   /* v168: دلیل‌ها و «درمانگر نیامد» */

  function ev(what, to) {
    try { tgLeadEv_({ code: code, row: lrow, actor: me, channel: 'تلگرام', what: what, to: to, note: r.ther + ' · ' + r.iso + ' ' + r.hhmm }); } catch (e) {}
  }

  if (act === 'y' || act === 'n' || act === 'c') {
    const val = act === 'y' ? 'بله' : (act === 'n' ? 'مراجع نیامد' : 'لغو شده بود');
    tgSlotSet_(row, TG_H_HELD, val);
    tgSlotSet_(row, TG_H_HANS, today);
    tgSlotSet_(row, TG_H_HWHO, me);
    tgSlotSet_(row, TG_H_NEXT, '');
    ev('برگزاری معارفه', val);
    if (lrow >= 2) {
      try {
        const lm = tgLeadRead_(lrow);
        const openL = lm && !lm.closed;
        if (act === 'y') { const chY = { 'نتیجه': 'معارفه برگزار شد', 'آخرین تماس': today, 'اقدام بعدی': 'پرسیدن شروع درمان', 'تاریخ اقدام بعدی': tgLeadDayAdd_(TG_START_DAYS) }; if (openL) chY['وضعیت'] = TG_ST.HELD; tgLeadSet_(lrow, chY, me, 'تلگرام', 'پاسخ درمانگر'); }
        if (act === 'n') { const chN = { 'نتیجه': 'در معارفه حاضر نشد', 'آخرین تماس': today, 'اقدام بعدی': 'تماس بعد از غیبت در معارفه', 'تاریخ اقدام بعدی': today }; if (openL) chN['وضعیت'] = TG_ST.FOLLOW; tgLeadSet_(lrow, chN, me, 'تلگرام', 'پاسخ درمانگر'); }
        if (act === 'c') { const chC = { 'نتیجه': 'معارفه لغو شد', 'اقدام بعدی': 'وقت تازهٔ معارفه', 'تاریخ اقدام بعدی': today }; if (openL) chC['وضعیت'] = TG_ST.FOLLOW; tgLeadSet_(lrow, chC, me, 'تلگرام', 'پاسخ درمانگر'); }
      } catch (e) {}
    }
    if (act === 'y') {
      tgSlotSet_(row, TG_H_NEXT, Utilities.formatDate(new Date(Date.now() + TG_START_DAYS * 86400000), TG_TZ, 'yyyy-MM-dd HH:mm'));
      tgSend_(chat, 'ممنون. ثبت شد.\nچند روز دیگر می‌پرسم درمان شروع شد یا نه.');
    } else {
      /* v168: «مراجع نیامد» کارت سه‌دکمه‌ای خودش را به پذیرش می‌فرستد */
      if (!(act === 'n' && typeof v168AfterMeet_ === 'function')) tgDeskSay_('🗓 معارفهٔ ' + tgEsc_(nm) + ' با ' + tgEsc_(r.ther) + ': ' + tgEsc_(val) + (code ? ' · ' + tgEsc_(code) : ''));
      tgSend_(chat, 'ممنون. ثبت شد و به پذیرش خبر دادم.');
    }
    if (typeof v168AfterMeet_ === 'function') v168AfterMeet_(chat, act, row, r, lrow, code);
    return null;
  }

  if (act === 's1' || act === 's2' || act === 's0') {
    const val = act === 's1' ? 'بله' : (act === 's2' ? 'هنوز معلوم نیست' : 'نه');
    tgSlotSet_(row, TG_H_START, val);
    tgSlotSet_(row, TG_H_HANS, today);
    tgSlotSet_(row, TG_H_HWHO, me);
    ev('شروع درمان', val);
    if (act === 's2') {
      tgSlotSet_(row, TG_H_START, '');
      tgSlotSet_(row, TG_H_NEXT, Utilities.formatDate(new Date(Date.now() + 5 * 86400000), TG_TZ, 'yyyy-MM-dd HH:mm'));
      return tgSend_(chat, 'باشد. پنج روز دیگر دوباره می‌پرسم.');
    }
    tgSlotSet_(row, TG_H_NEXT, '');
    if (lrow >= 2) {
      try {
        if (act === 's1') tgLeadSet_(lrow, { 'شروع درمان؟': 'بله', 'وضعیت': 'شروع درمان' }, me, 'تلگرام', 'پاسخ درمانگر');
        else tgLeadSet_(lrow, { 'نتیجه': 'بعد از معارفه ادامه نداد' }, me, 'تلگرام', 'پاسخ درمانگر');
      } catch (e) {}
    }
    tgDeskSay_('🌱 ' + tgEsc_(nm) + ' با ' + tgEsc_(r.ther) + ' · شروع درمان: ' + tgEsc_(val) + (code ? ' · ' + tgEsc_(code) : ''));
    tgSend_(chat, 'ممنون. ثبت شد.');
    if (act === 's0' && typeof v168AfterMeet_ === 'function') v168AfterMeet_(chat, act, row, r, lrow, code);
    return null;
  }
  return null;
}

/* یادآوری پیش از معارفه: ۲۴ ساعت و ۲ ساعت قبل، به مراجع (اگر در بات است) و درمانگر؛ نشانه در ستون «یادآوری» اسلات */
const TG_H_REMIND = 'یادآوری';
function tgMeetRemindTick_() {
  if (TG_DRY) return 0;
  var sent = 0;
  try {
    const sh = tgSS_().getSheetByName(TG_SLOTS);
    if (!sh || sh.getLastRow() < 4) return 0;
    const map = tgMtHeadMap_();
    const lc = sh.getLastColumn();
    const all = sh.getRange(4, 1, sh.getLastRow() - 3, lc).getValues();
    const now = Date.now();
    const cR = map[TG_H_REMIND];
    const info = tgTherapistInfo_();
    for (var i = 0; i < all.length && sent < 20; i++) {
      const v = all[i];
      if (String(v[5] || '').trim() !== 'رزرو شده') continue;
      if (!(v[1] instanceof Date)) continue;
      const hhmm = tgHHMM_(v[3]);
      if (!hhmm) continue;
      const iso = Utilities.formatDate(v[1], TG_TZ, 'yyyy-MM-dd');
      const start = tgSlotUtc_({ dateIso: iso, hhmm: hhmm }).getTime();
      const left = start - now;
      if (left <= 0 || left > 24 * 3600000) continue;
      const flag = cR === undefined ? '' : String(v[cR] || '');
      var kind = '';
      if (left <= 2 * 3600000 && flag.indexOf('۲س') < 0) kind = '۲س';
      else if (left > 2 * 3600000 && flag.indexOf('۲۴') < 0) kind = '۲۴';
      if (!kind) continue;
      const ther = String(v[0] || '').trim();
      const tag = String(v[7] || '');
      const nm = tag.split('·')[0].trim() || 'مراجع';
      const cid = tgMtTgId_(tag);
      const tInfo = info[ther] || {};
      const when = tgDay_(Utilities.formatDate(new Date(start), TG_TZ, 'EEE')) + ' ' + tgJDate_(new Date(start), TG_TZ) + ' ساعت ' + tgFa_(hhmm) + ' به وقت تهران';
      const soon = tgSoonWord_(start, kind);
      if (cid) {
        try {
          tgSend_(cid, '🔔 یادآوری معارفه: ' + soon + '، ' + when + ' با <b>' + tgEsc_(ther) + '</b>.' +
            (tInfo.meet ? '\n🔗 لینک جلسه:\n' + tgEsc_(tInfo.meet) : '\nلینک جلسه را پذیرش برایتان می‌فرستد.') +
            '\n\nاگر نمی‌توانید بیایید، از «🗓 وقت معارفهٔ من» لغو کنید تا وقت آزاد شود.');
        } catch (eC) {}
      }
      if (tInfo.chat) {
        try { tgSend_(tInfo.chat, '🔔 یادآوری: معارفه با ' + tgEsc_(nm) + ' ' + soon + '، ' + when + '.'); } catch (eT) {}
      }
      tgSlotSet_(i + 4, TG_H_REMIND, (flag ? flag + ' · ' : '') + kind + ' ' + Utilities.formatDate(new Date(), TG_TZ, 'MM-dd HH:mm'));
      sent++;
    }
  } catch (e) { try { tgErr_('tgMeetRemindTick_: ' + e); } catch (e2) {} }
  return sent;
}

function tgMeetSetup() {
  const all = ScriptApp.getProjectTriggers();
  for (var i = 0; i < all.length; i++) {
    if (all[i].getHandlerFunction() === 'tgMeetTick') ScriptApp.deleteTrigger(all[i]);
  }
  ScriptApp.newTrigger('tgMeetTick').timeBased().everyMinutes(30).create();
  return 'tgMeetTick هر ۳۰ دقیقه';
}

/* ---------- تست خشک ---------- */

function tgScTests() {
  var out = [], pass = 0, fail = 0;
  function ok(n, c) { c ? pass++ : fail++; out.push((c ? '✅ ' : '❌ ') + n); }
  const wasDry = TG_DRY, wasOut = TG_OUTBOX;
  const memKeys = ['schnum:کسی:' + TG_HEAD_LEN, 'schnum:کسی:' + TG_HEAD_GAP];
  TG_DRY = true;
  try {
    ok('ساعت کامل خوانده می‌شود', tgScTime_('10') === '10:00');
    ok('ساعت با دو نقطه', tgScTime_('10:15') === '10:15');
    ok('ساعت با نقطه', tgScTime_('10.15') === '10:15');
    ok('ساعت فارسی', tgScTime_('۱۰:۱۵') === '10:15');
    ok('چهار رقمی', tgScTime_('1015') === '10:15');
    ok('دقیقه به پنج گرد می‌شود', tgScTime_('10:17') === '10:15' || tgScTime_('10:17') === '10:20');
    ok('ساعت بی‌معنا رد می‌شود', tgScTime_('۲۹:۸۰') === '' && tgScTime_('سلام') === '');
    ok('نیم‌شب درست است', tgScTime_('0:05') === '00:05');

    ok('افزودن دقیقه', tgScAddMin_('10:15', 50) === '11:05');
    ok('عبور از نیم‌شب', tgScAddMin_('23:50', 20) === '00:10');
    ok('دقیقه از ساعت', tgScMin_('10:15') === 615);

    memKeys.forEach(function (k) { delete TG_MEM[k]; });
    ok('فاصلهٔ پیش‌فرض وقتی چیزی ثبت نشده', tgScGap_('کسی') === TG_GAP_DEF);
    tgScTherSet_('کسی', TG_HEAD_GAP, 20);
    ok('فاصلهٔ اختصاصی خوانده می‌شود', tgScGap_('کسی') === 20);
    tgScTherSet_('کسی', TG_HEAD_GAP, 999);
    ok('فاصلهٔ خیلی بزرگ سقف می‌خورد', tgScGap_('کسی') === TG_GAP_MAX);
    tgScTherSet_('کسی', TG_HEAD_GAP, 0);

    tgScTherSet_('کسی', TG_HEAD_LEN, 60);
    ok('طول جلسهٔ درمان اختصاصی', tgScLen_('کسی', TG_KIND_SESS) === 60);
    ok('طول معارفه ثابت است', tgScLen_('کسی', TG_KIND_MEET) === TG_SLOT_MIN);
    tgScTherSet_('کسی', TG_HEAD_GAP, 15);
    ok('گام برابر طول به‌علاوهٔ استراحت', tgScStep_('کسی', TG_KIND_SESS) === 75);
    ok('گام معارفه هم استراحت دارد', tgScStep_('کسی', TG_KIND_MEET) === TG_SLOT_MIN + 15);

    ok('شناسهٔ تلگرام از لید مرتبط درمی‌آید', tgMtTgId_('Owner  · tg:70000017') === '70000017');
    ok('لید مرتبط بی‌شناسه', tgMtTgId_('بدون') === '');

    TG_OUTBOX = [];
    tgDel_('sfh', 77);
    ok('بدون فلگ، ساعت تایپ‌شده بلعیده نمی‌شود', tgScHourText_(77, { name: 'کسی' }, '10:15') === false);
    tgSetVal_('sfh', 77, '1');
    TG_OUTBOX = [];
    ok('ساعت غلط پیام راهنما می‌دهد', tgScHourText_(77, { name: 'کسی' }, 'سلام') === true && TG_OUTBOX.length === 1);
    ok('فلگ بعد از ساعت غلط می‌ماند', !!tgGetVal_('sfh', 77));
    TG_OUTBOX = [];
    tgSetVal_('sfh', 77, '1');
    var r = tgScHourText_(77, { name: 'کسی' }, '۱۰:۱۵');
    ok('ساعت درست پذیرفته می‌شود و فلگ پاک می‌شود', r === true && !tgGetVal_('sfh', 77));
    tgSetVal_('sfh', 77, '1');
    ok('انصراف فلگ ساعت را می‌بندد', tgScHourText_(77, { name: 'کسی' }, 'انصراف') === false && !tgGetVal_('sfh', 77));

    TG_OUTBOX = [];
    tgDel_('scg', 77);
    ok('بدون فلگ، عدد طول جلسه بلعیده نمی‌شود', tgScSetText_(77, { name: 'کسی' }, '۵۰') === false);
    tgScSetStart_(77, { name: 'کسی' });
    ok('شروع تنظیم، فلگ می‌گذارد', tgGetVal_('scg', 77) === 'len');
    TG_OUTBOX = [];
    tgScSetText_(77, { name: 'کسی' }, '۱۰');
    ok('طول خارج از بازه رد می‌شود', tgGetVal_('scg', 77) === 'len');
    tgScSetText_(77, { name: 'کسی' }, '۴۵');
    ok('طول درست ثبت می‌شود و می‌رود سراغ استراحت', tgGetVal_('scg', 77) === 'gap' && tgScLen_('کسی', TG_KIND_SESS) === 45);
    tgScSetText_(77, { name: 'کسی' }, '۱۲');
    ok('استراحت ثبت می‌شود و فلگ پاک می‌شود', !tgGetVal_('scg', 77) && tgScGap_('کسی') === 12);

    ok('کد دکمه زیر ۶۴ بایت است', ('mt:s1:1234').length <= 64);
    ok('sfh و scg در کلیدهای کش هر پیام هستند', TG_MEMO_KEYS.indexOf('sfh') > -1 && TG_MEMO_KEYS.indexOf('scg') > -1);
    ok('سقف زنجیره بیشتر از سه شد', TG_CHAIN_MAX >= 6);
    ok('سقف وقت درمان عملاً باز است', TG_SESS_CAP >= 40);
  } catch (e) {
    fail++; out.push('❌ استثنا: ' + e);
  }
  TG_DRY = wasDry; TG_OUTBOX = wasOut;
  memKeys.forEach(function (k) { delete TG_MEM[k]; });
  return { pass: pass, fail: fail, text: out.join('\n') };
}



  sh.getRange('A4').setValue('بازهٔ قبل از');
  sh.getRange('B4').setFormula('=IF(B2="همه",DATE(2020,1,1),B3-(TODAY()-B3))').setNumberFormat('yyyy-mm-dd');
  var C = function (extra) { return 'COUNTIFS(' + D + 'B:B,">="&$B$3' + (extra || '') + ')'; };
  var P = function (extra) { return 'COUNTIFS(' + D + 'B:B,">="&$B$4,' + D + 'B:B,"<"&$B$3' + (extra || '') + ')'; };
  var kpi = [
    ['شاخص', 'این بازه', 'بازهٔ قبل', 'تغییر'],
    ['لید تازه', '=' + C(), '=' + P(), ''],
    ['تماس اول گرفته شد', '=' + C(',' + D + 'M:M,1'), '=' + P(',' + D + 'M:M,1'), ''],
    ['معارفه رزرو شد', '=' + C(',' + D + 'N:N,1'), '=' + P(',' + D + 'N:N,1'), ''],
    ['شروع درمان', '=' + C(',' + D + 'O:O,1'), '=' + P(',' + D + 'O:O,1'), ''],
    ['بسته بی شروع درمان', '=' + C(',' + D + 'P:P,1,' + D + 'O:O,0'), '=' + P(',' + D + 'P:P,1,' + D + 'O:O,0'), ''],
    ['نرخ تماس اول', '=IFERROR(B8/B7,0)', '=IFERROR(C8/C7,0)', ''],
    ['نرخ معارفه (از لید)', '=IFERROR(B9/B7,0)', '=IFERROR(C9/C7,0)', ''],
    ['نرخ شروع درمان (از لید)', '=IFERROR(B10/B7,0)', '=IFERROR(C10/C7,0)', ''],
    ['میانهٔ ساعت تا تماس اول', '=IFERROR(ROUND(MEDIAN(FILTER(' + D + 'L2:L,' + D + 'B2:B>=$B$3,ISNUMBER(' + D + 'L2:L)))/60,1),"ندارد")',
      '=IFERROR(ROUND(MEDIAN(FILTER(' + D + 'L2:L,' + D + 'B2:B>=$B$4,' + D + 'B2:B<$B$3,ISNUMBER(' + D + 'L2:L)))/60,1),"ندارد")', '']
  ];
  sh.getRange(6, 1, kpi.length, 4).setValues(kpi);
  for (var r = 7; r <= 15; r++) sh.getRange(r, 4).setFormula('=IFERROR(IF(C' + r + '=0,"",(B' + r + '-C' + r + ')/C' + r + '),"")');
  sh.getRange('B12:C14').setNumberFormat('0%');
  sh.getRange('D7:D15').setNumberFormat('+0%;-0%');
  sh.getRange(6, 1, 1, 4).setFontWeight('bold').setBackground('#222222').setFontColor('#fefefe');
  sh.getRange('B7:C11').setFontSize(13);
  /* قیف */
  sh.getRange('F6').setValue('قیف این بازه').setFontWeight('bold');
  sh.getRange('F7:G10').setFormulas([['="لید"', '=B7'], ['="تماس اول"', '=B8'], ['="معارفه"', '=B9'], ['="شروع درمان"', '=B10']]);
  /* تیم */
  sh.getRange('A18').setValue('عملکرد تیم در این بازه').setFontWeight('bold').setFontSize(13);
  sh.getRange('A19:F19').setValues([['مسئول', 'لید', 'تماس اول', 'نرخ تماس', 'معارفه', 'میانهٔ ساعت تا تماس']]).setFontWeight('bold').setBackground('#f9f2f2');
  sh.getRange('A20').setFormula('=IFERROR(SORT(UNIQUE(FILTER(' + D + 'I2:I,' + D + 'B2:B>=$B$3))),"")');
  for (var t = 20; t < 32; t++) {
    sh.getRange(t, 2).setFormula('=IF(A' + t + '="","",COUNTIFS(' + D + 'I:I,A' + t + ',' + D + 'B:B,">="&$B$3))');
    sh.getRange(t, 3).setFormula('=IF(A' + t + '="","",COUNTIFS(' + D + 'I:I,A' + t + ',' + D + 'B:B,">="&$B$3,' + D + 'M:M,1))');
    sh.getRange(t, 4).setFormula('=IF(A' + t + '="","",IFERROR(C' + t + '/B' + t + ',0))');
    sh.getRange(t, 5).setFormula('=IF(A' + t + '="","",COUNTIFS(' + D + 'I:I,A' + t + ',' + D + 'B:B,">="&$B$3,' + D + 'N:N,1))');
    sh.getRange(t, 6).setFormula('=IF(A' + t + '="","",IFERROR(ROUND(MEDIAN(FILTER(' + D + 'L2:L,' + D + 'I2:I=A' + t + ',' + D + 'B2:B>=$B$3,ISNUMBER(' + D + 'L2:L)))/60,1),"ندارد"))');
  }
  sh.getRange('D20:D31').setNumberFormat('0%');
  /* کانال */
  sh.getRange('H18').setValue('از کجا آمدند').setFontWeight('bold').setFontSize(13);
  sh.getRange('H19').setFormula('=IFERROR(QUERY(' + D + 'A:P,"select F, count(A), sum(M), sum(N), sum(O) where B >= date \'"&TEXT($B$3,"yyyy-mm-dd")&"\' group by F order by count(A) desc label count(A) \'لید\', sum(M) \'تماس اول\', sum(N) \'معارفه\', sum(O) \'شروع درمان\', F \'کانال\'",1),"")');
  /* روند هفتگی ۱۲ هفتهٔ اخیر */
  sh.getRange('A34').setValue('روند هفتگی').setFontWeight('bold').setFontSize(13);
  sh.getRange('A35:D35').setValues([['هفته', 'لید', 'معارفه', 'شروع درمان']]).setFontWeight('bold').setBackground('#f9f2f2');
  for (var w = 0; w < 12; w++) {
    var rr = 36 + w;
    sh.getRange(rr, 1).setFormula('=TODAY()-WEEKDAY(TODAY(),16)+1-7*' + (11 - w)).setNumberFormat('mm-dd');
    sh.getRange(rr, 2).setFormula('=COUNTIFS(' + D + 'C:C,TEXT(A' + rr + ',"yyyymmdd")*1)');
    sh.getRange(rr, 3).setFormula('=COUNTIFS(' + D + 'C:C,TEXT(A' + rr + ',"yyyymmdd")*1,' + D + 'N:N,1)');
    sh.getRange(rr, 4).setFormula('=COUNTIFS(' + D + 'C:C,TEXT(A' + rr + ',"yyyymmdd")*1,' + D + 'O:O,1)');
  }
  /* لیدهای باز الان (مستقل از بازه) */
  sh.getRange('H34').setValue('لیدهای باز الان').setFontWeight('bold').setFontSize(13);
  /* v168: «باز» همان tgOpenLeads_ است (ستون S)، تا عدد گزارش با کارتابل و دایجست یکی باشد */
  sh.getRange('H35').setFormula('=IFERROR(QUERY(' + D + 'A:S,"select K, count(A) where S = 1 group by K label K \'مرحله\', count(A) \'تعداد\'",1),"")');
  sh.getRange('K35').setFormula('=IFERROR(QUERY(' + D + 'A:S,"select I, count(A) where S = 1 group by I order by count(A) desc label I \'مسئول\', count(A) \'باز\'",1),"")');
  sh.setColumnWidth(1, 190); sh.setColumnWidths(2, 5, 110); sh.setColumnWidth(8, 120);
  /* نمودارها */
  sh.insertChart(sh.newChart().asBarChart().addRange(sh.getRange('F7:G10')).setPosition(6, 9, 0, 0)
    .setOption('title', 'قیف این بازه').setOption('legend', { position: 'none' }).setOption('colors', ['#c83f49']).setOption('width', 420).setOption('height', 260).build());
  sh.insertChart(sh.newChart().asColumnChart().addRange(sh.getRange('A35:D47')).setPosition(49, 1, 0, 0)
    .setOption('title', 'روند هفتگی').setOption('colors', ['#222222', '#e89aa0', '#c83f49']).setOption('width', 640).setOption('height', 300).build());
  sh.setFrozenRows(4);
  return 'گزارش ساخته شد';
}
function tgCrmTick_() {
  var P = PropertiesService.getScriptProperties();

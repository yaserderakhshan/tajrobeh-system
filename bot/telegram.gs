  tgSetVal_('qm', chat, key);
  if (typeof v1689Ask_ === 'function' && v1689Ask_(chat)) return;   /* v168.9: کشور و آشنایی پیش از شماره */
  tgAskPhone_(chat);
}

function tgPickWant_(list, k) {
  for (var i = 0; i < list.length; i++) if (list[i].k === k) return list[i].want;
  return '';
}

// نمره‌گذاری: S علامت ۰ تا ۶، I بینش ۰ تا ۳، M خوشهٔ خلقی ۰ تا ۴، A خوشهٔ اضطرابی ۰ تا ۲
function tgScales_(chat) {
  const nd = tgSelList_('nd', chat), pf = tgSelList_('pf', chat);
  var S = 0, I = 0, M = 0, A = 0;
  const needs = [], prefs = [];
  TG_NEEDS.forEach(function (n) {
    if (nd.indexOf(n.k) < 0) return;
    needs.push(n.label);
    if (n.f === 's') S++; else I++;
    if (n.m) M++;
    if (n.a) A++;
  });
  TG_PREFS.forEach(function (p) { if (pf.indexOf(p.k) > -1) prefs.push(p.label); });
  const has = function (k) { return pf.indexOf(k) > -1 ? 1 : 0; };
  const D = has('p2') + has('p5') - has('p4');
  const W = has('p1') - has('p3');
  var profile = '';
  if (pf.length) {
    if (W === 1 && D <= 0) profile = 'کاوشگر';
    else if (W === 1 && D >= 1) profile = 'تحلیل‌گر فعال';
    else if (W <= 0 && D >= 1) profile = 'حل‌مسئله';
    else profile = 'ترکیبی';
  }
  return {
    S: S, I: I, M: M, A: A, D: D, W: W, profile: profile, needs: needs, prefs: prefs,
    answered: nd.length > 0 || pf.length > 0,
    gender: tgGenderWant_(chat),
    age: tgPickWant_(TG_AGES, tgGetVal_('qa', chat)),
    mode: tgPickWant_(TG_MODES, tgGetVal_('qm', chat)) + tgInpWant_(chat)
  };
}

// قاعدهٔ مچ‌میکینگ بدون AI. خروجی متن خوانا برای ستون «استخر پیشنهادی»
function tgPoolHint_(sc, topicKey, region) {
  const parts = [];
  if (topicKey === 'psy') parts.push('روان‌پزشکی');
  else if (topicKey === 'rel') parts.push('زوج و رابطه');
  else if (topicKey === 'kid') parts.push('کودک و نوجوان');
  else if (topicKey === 'fam') parts.push('خانواده و والدگری');
  else if (!sc.answered) parts.push('فردی عمومی');
  else if (sc.I >= 2) parts.push(sc.A === 2 ? 'تحلیلی، ترجیحاً متخصص اضطراب و وسواس فکری' : 'تحلیلی');
  else if (sc.I <= 1 && sc.S >= 3) parts.push('شناختی رفتاری یا طرحواره');
  else parts.push('فردی عمومی');
  if (topicKey !== 'psy' && sc.M === 4) parts.push('پرچم روان‌پزشکی');
  if (sc.profile === 'تحلیل‌گر فعال' || sc.profile === 'حل‌مسئله') parts.push('درمانگر فعال و مسیرده');
  if (region === 'خارج از ایران') parts.push('ارزی');
  if (sc.mode && sc.mode.indexOf('حضوری') === 0) parts.push('حضوری');
  return parts.join(' · ');
}

function tgLeadExtras_(sc, topicKey, region) {
  const o = {};
  o['نمرهٔ علامت'] = sc.answered ? sc.S : '';
  o['نمرهٔ بینش'] = sc.answered ? sc.I : '';
  o['پروفایل درمانی'] = sc.profile;
  o['نیازها'] = sc.needs.join('، ');
  o['ترجیحات'] = sc.prefs.join('، ');
  o['ترجیح جنسیت'] = sc.gender;
  o['ترجیح سن'] = sc.age;
  o['حالت جلسه'] = sc.mode;
  o['استخر پیشنهادی'] = tgPoolHint_(sc, topicKey, region);
  return o;
}

function tgTopicOf_(k) {
  for (var i = 0; i < TG_TOPICS.length; i++) if (TG_TOPICS[i].k === k) return TG_TOPICS[i];
  return { topic: '', kind: '' };
}

function tgGenderWant_(chat) {
  const k = tgGetVal_('qg', chat);
  for (var i = 0; i < TG_GENDERS.length; i++) if (TG_GENDERS[i].k === k) return TG_GENDERS[i].want;
  return '';
}

function tgAskPhone_(chat) {
  tgSend_(chat, T_ASK_PHONE, {
    keyboard: [[{ text: '📞 فرستادن شمارهٔ من', request_contact: true }], [{ text: '↩️ بازگشت' }]],
    resize_keyboard: true, one_time_keyboard: true
  });
}

function tgOnPhone_(chat, name, uname, phone) {
  const p = tgLatinDigits_(phone).replace(/[^\d+]/g, '');
  const region = tgRegion_(p);
  /* v166.12: «seen» (۶ ساعت) دیگر شمارهٔ تازه را گم نمی‌کند. همان متن T_PHONE_AGAIN به مراجع می‌رود، ولی:
     شمارهٔ دیگر روی پروندهٔ همین مراجع یادداشت می‌شود، و اگر پرونده اصلاً ساخته نشده بود (نوشتن قبلی شکست خورد) ساخته می‌شود. */
  if (tgFlag_('seen', chat)) {
    var rowSeen = -1;
    try { rowSeen = tgFindLead_(chat); } catch (eS) {}
    if (rowSeen >= 2 || tgLeadByPhone_(p) >= 2) {
      if (rowSeen >= 2 && tgLeadByPhone_(p) < 2) { try { tgLeadNote_(rowSeen, 'شمارهٔ دیگری از همین مراجع: ' + p, 'مراجع'); } catch (eN) { tgErr_('tgOnPhone_ note', eN, 'chat:' + chat); } }
      return tgSend_(chat, T_PHONE_AGAIN, tgMenu_());
    }
  }

  const tk = tgGetVal_('qt', chat);
  const q = tgTopicOf_(tk);
  const want = tgGenderWant_(chat);
  const sc = tgScales_(chat);
  const extra = tgLeadExtras_(sc, tk, region);
  if (typeof v168ModeExtras_ === 'function') v168ModeExtras_(chat, extra);   /* v168 فاز ۶ */
  if (typeof v1689Extras_ === 'function') v1689Extras_(chat, extra);   /* v168.9: کشور و آشنایی */
  if (typeof v17013Extras_ === 'function') v17013Extras_(chat, extra);   /* v170.13: آفر کمپین */
  var known = tgLeadByPhone_(p);
  if (known < 2) { try { const byChat = tgFindLead_(chat); if (byChat >= 2) known = byChat; } catch (eK) {} }

  // منوی اصلی همین‌جا جای کیبورد شماره را می‌گیرد؛ پیام جدا برای remove_keyboard لازم نیست
  tgSend_(chat, known > 0 ? T_PHONE_KNOWN : (sc.answered ? T_AFTER_PHONE_Q : T_AFTER_PHONE), tgMenu_());
  tgSetFlag_('ft', chat, 3600);
  const nudgeKb = {
    inline_keyboard: [
      [{ text: '🗓 دیدن وقت‌های آزاد معارفه', web_app: { url: TG_APP_URL } }],
      [{ text: '🔐 ثبت‌نام در پلتفرم تجربه', url: TG_LINK_SIGNUP }]
    ]
  };

  var leadOk = true;
  if (known > 0) {
    tgUpdateLead_(known, extra, q, chat, uname, p);
  } else {
    leadOk = tgAppendLead_({
      source: 'Telegram bot', name: name, channel: 'تلگرام', phone: p, region: region,
      firstText: 'درخواست شروع درمان از بات' + (q.topic ? ' · موضوع: ' + q.topic : '') +
        (want ? ' · ترجیح درمانگر: ' + want : '') +
        (sc.answered ? ' · علامت ' + sc.S + ' از ۶ · بینش ' + sc.I + ' از ۳' + (sc.profile ? ' · ' + sc.profile : '') : ''),
      status: 'جدید', kind: q.kind, topic: q.topic,
      note: 'chat_id: ' + chat + (uname ? ' · ' + uname : '') + (want ? ' · ترجیح درمانگر: ' + want : ''),
      extra: extra
    }) !== false;
  }
  /* v166.12: «seen» فقط بعد از ثبت موفق؛ اگر نوشتن شکست خورد، لید در صف تکرار (TG_LEAD_RETRY) می‌ماند و مراجع هم می‌تواند دوباره بفرستد */
  if (leadOk) tgSetFlag_('seen', chat, 21600);
  try { if (typeof vxcAfterPhone_ === 'function') vxcAfterPhone_(chat); } catch (eVx) {}   /* v166: برداشت مچ‌میکینگ صوتی در یادداشت لید */

  if (region === 'خارج از ایران') {
    tgSend_(chat, T_SIGNUP_NUDGE, nudgeKb);
    tgSend_(chat, T_OUTSIDE);
    return tgAskZone_(chat);
  }

  tgSetVal_('tz', chat, 'ir');
  const mode = tgDayMode_();
  if (mode === 'full') {
    // یک پیام به‌جای سه پیام: ساعت کاری + پیشنهاد رزرو + ثبت‌نام
    return tgSend_(chat, T_HOURS_OPEN + '\n\nاگر نمی‌خواهید منتظر تماس بمانید، همین حالا خودتان وقت معارفه بردارید 👇\n\n' + T_SIGNUP_NUDGE, nudgeKb);
  }
  tgSend_(chat, T_SIGNUP_NUDGE, nudgeKb);
  if (mode === 'half') tgSend_(chat, T_HOURS_HALF);
  tgOfferSlots_(chat, TG_ZONE_IR, tgBandOf_('x'), 'داخل ایران',
                mode === 'half' ? T_SLOTS_HEAD : T_SLOTS_HEAD_IR);
}

function tgOnHuman_(chat, name, uname) {
  tgSend_(chat, T_HUMAN, {
    keyboard: [[{ text: '📞 فرستادن شمارهٔ من', request_contact: true }], [{ text: '↩️ بازگشت' }]],
    resize_keyboard: true, one_time_keyboard: true
  });
  if (tgCooldown_('hum' + chat, TG_COLL_COOL)) return;
  tgColleague_(chat, name, uname, 'درخواست صحبت با همکار');
}

// ── تماس همکاران ─────────────────────────────────────────────
// «درخواست صحبت با همکار» یک‌بارمصرف است: ثبت می‌شود، یک تماس می‌گیرند، تمام.
// وارد تب لیدها و چرخهٔ پیگیری نمی‌شود، چون لید مراجع نیست.
const TG_COLL_TAB  = 'تماس همکاران';
const TG_COLL_COOL = 604800;
const TG_COLL_HEAD = ['تاریخ', 'زمان', 'نام', 'یوزرنیم تلگرام', 'chat_id', 'نقش در تجربه', 'موضوع', 'وضعیت', 'پاسخ‌دهنده', 'تاریخ تماس', 'یادداشت'];

function tgCollSheet_() {
  if (TG_DRY) return null;
  const ss = tgSS_();
  let sh = ss.getSheetByName(TG_COLL_TAB);
  if (!sh) {
    sh = ss.insertSheet(TG_COLL_TAB);
    sh.getRange(1, 1, 1, TG_COLL_HEAD.length).setValues([TG_COLL_HEAD]);
    sh.setFrozenRows(1);
  }
  return sh;
}

function tgColleague_(chat, name, uname, topic) {
  const now = new Date();
  var role = '';
  try {
    const p = tgWhoPerson_(chat, String(uname || '').replace('@', ''));
    if (p && p.roles) role = String(p.roles);
  } catch (e) {}
  if (TG_DRY) { TG_OUTBOX.push({ kind: 'coll', name: name, topic: topic, role: role }); return; }
  try {
    tgCollSheet_().appendRow([
      Utilities.formatDate(now, TG_TZ, 'yyyy-MM-dd'),
      Utilities.formatDate(now, TG_TZ, 'HH:mm'),
      name || '', uname || '', String(chat), role,
      topic || 'درخواست صحبت با همکار', 'در انتظار تماس', '', '', ''
    ]);
  } catch (e) { tgErr_('tgColleague_: ' + e); }
  try {
    const team = tgDeskRows_().filter(function (p) { return p.chat; });
    if (team.length) tgSend_(team[0].chat,
      '👥 <b>درخواست صحبت با همکار</b>\n' + tgEsc_(name || 'بدون نام') +
      (uname ? ' · ' + tgEsc_(uname) : '') + (role ? '\n' + tgEsc_(role) : '') +
      '\n\nیک تماس کافی است. بعد از تماس، در تب «تماس همکاران» وضعیت را «انجام شد» کنید.');
  } catch (e) {}
}

function tgOnCrisis_(chat, name, uname, text) {
  tgSend_(chat, T_CRISIS, {
    keyboard: [[{ text: '📞 فرستادن شمارهٔ من', request_contact: true }]],
    resize_keyboard: true, one_time_keyboard: true
  });
  tgAppendLead_({
    source: 'Telegram bot', name: name, channel: 'تلگرام', phone: uname || String(chat), region: '',
    firstText: 'هشدار: کلمهٔ بحران در پیام کاربر', status: 'جدید',
    note: 'chat_id: ' + chat + (uname ? ' · ' + uname : '') + ' · متن: ' + text.slice(0, 200)
  });
}

function tgOnCallback_(cq) {
  if (cq.id && !cq._ans) { cq._ans = 1; tgApi_('answerCallbackQuery', { callback_query_id: cq.id }); }
  const chat  = cq.message.chat.id;
  const name  = [cq.from.first_name, cq.from.last_name].filter(String).join(' ').trim() || 'بدون نام';
  const uname = cq.from.username ? '@' + cq.from.username : '';
  const data  = tgCbResolve_(String(cq.data || ''));   /* v170.9.2: کد کوتاه «h:…» به دادهٔ کامل */
  cq.data = data;
  // هاب ساختمان ونک (building.gs)
  if (typeof VK_CUR !== 'undefined') VK_CUR = String(chat);

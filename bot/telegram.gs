function tnkDry_()  { return typeof TG_DRY !== 'undefined' && TG_DRY; }
function tnkFa_(n)  { return typeof tgFa_ === 'function' ? tgFa_(n) : String(n); }
function tnkEsc_(s) { return typeof tgEsc_ === 'function' ? tgEsc_(s) : String(s === null || s === undefined ? '' : s); }

function tnkNum_(n) {
  var v = Math.round(Number(String(n).replace(/[^0-9.-]/g, '')) || 0);
  return tnkFa_(String(v).replace(/\B(?=(\d{3})+(?!\d))/g, '٬'));
}

function tnkToman_(n) { return tnkNum_(n) + ' تومان'; }

function tnkAmt_(s) {
  var t = String(s === null || s === undefined ? '' : s);
  t = t.replace(/[۰-۹]/g, function (d) { return String('۰۱۲۳۴۵۶۷۸۹'.indexOf(d)); });
  t = t.replace(/[٬,،\s]/g, '');
  var m = t.match(/(\d+)/);
  if (!m) return 0;
  var v = Number(m[1]);
  if (/هزار/.test(String(s))) v = v * 1000;
  else if (/میلیون/.test(String(s))) v = v * 1000000;
  return v;
}

function tnkNow_() {
  var d = new Date();
  var j = { y: 0, m: 0, d: 0 };
  try { j = tgJalali_(d, TG_TZ); } catch (e) {}
  return { ym: j.y + '-' + (j.m < 10 ? '0' + j.m : String(j.m)),
           date: (typeof tgJDateFull_ === 'function') ? tgJDateFull_(d, TG_TZ) : String(d) };

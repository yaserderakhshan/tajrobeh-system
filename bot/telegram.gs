  if (found.length) tgSend_(TG_OWNER_CHAT, '🔧 <b>chat_id ادغام‌شده در شیت</b>\nشیت چند شناسه را با هم یک عدد کرده و هر دو از دست رفته‌اند. در این خانه‌ها شناسه‌ها را دوباره، جدا با ویرگول، بنویسید:\n' + found.map(tgEsc_).join('\n'));

  try { sh.hideColumns(14, 2); } catch (e1) {}
  sh.setFrozenRows(5);
  sh.setColumnWidth(1, 300); sh.setColumnWidth(2, 170); sh.setColumnWidth(3, 120); sh.setColumnWidth(4, 80);
  sh.setColumnWidth(5, 130); sh.setColumnWidth(6, 110); sh.setColumnWidth(7, 130); sh.setColumnWidth(8, 120);

var TG_SCH_STAGES = ['ثبت‌نام وبینار', 'حاضر در وبینار', 'لید مدرسه', 'تماس اول', 'درخواست دوره',
                     'پیش‌پرداخت', 'مصاحبه', 'پذیرش', 'ثبت‌نام قطعی'];
var TG_SCH_SG = { web: 0, came: 1, lead: 2, call: 3, apply: 4, pre: 5, itv: 6, acc: 7, done: 8 };
/* نام‌های قدیمی مرحله که هنوز ممکن است در شیت باشند */
var TG_SCH_STAGE_MAP = { 'رسیدن': 'لید مدرسه', 'اقدام': 'لید مدرسه', 'روز باز': 'حاضر در وبینار',
                         'مصاحبهٔ پذیرش': 'مصاحبه', 'پذیرش و ثبت عضویت': 'ثبت‌نام قطعی', 'ماندگاری': 'ثبت‌نام قطعی' };

var TG_SCH_ST_OPEN = 'باز';
var TG_SCH_ST_PRE  = 'پیش‌ثبت‌نام';
var TG_SCH_ST_COND = 'پذیرش مشروط';
var TG_SCH_ST_DONE = 'ثبت‌نام قطعی';
var TG_SCH_ST = ['باز', 'پیش‌ثبت‌نام', 'پذیرش مشروط', 'ثبت‌نام قطعی',
                 'عدم پذیرش', 'منصرف شد', 'پاسخ نداد (نهایی)', 'تکراری', 'دورهٔ بعد', 'بسته'];
var TG_SCH_CLOSE_REASONS = ['منصرف شد', 'پاسخ نداد (نهایی)', 'عدم پذیرش', 'تکراری', 'دورهٔ بعد', 'بسته'];
var TG_SCH_CLOSED = ['ثبت‌نام قطعی', 'عدم پذیرش', 'منصرف شد', 'پاسخ نداد (نهایی)', 'تکراری', 'دورهٔ بعد', 'بسته',
                     /* واژه‌های قدیمی */ 'پذیرش شد', 'رد شد', 'رد شده', 'بسته شد'];
var TG_SCH_ST_MAP = { 'در انتظار بررسی': 'باز', 'تأیید شده': 'باز', 'نیاز به اطلاعات بیشتر': 'باز', 'متقاضی دوره': 'باز',
                      'جدید': 'باز', 'در پیگیری': 'باز', 'پذیرش شد': 'ثبت‌نام قطعی', 'رد شد': 'عدم پذیرش', 'رد شده': 'عدم پذیرش',
                      'بسته شد': 'بسته', 'منتفی': 'منصرف شد', 'منتفی (خود مراجع)': 'منصرف شد', 'غیبت': 'باز' };

var TG_SCH_EV_TAB  = 'رویدادهای مدرسه';
var TG_SCH_EV_HEAD = ['زمان', 'کد لید', 'سطر', 'کی', 'کانال', 'چه شد', 'از', 'به', 'یادداشت'];
var TG_SCH_WEB_COL = 'وبینار';   /* ستون تازهٔ انتهای «درخواست عضویت»: خالی · ثبت‌نام · حاضر */

var TG_SCH_IDLE_DAYS = 3;
var TG_SCH_CARD_MAX  = 4;
var TG_SCH_SUM_MAX   = 5;

/* وضعیت را به یکی از ده واژه برمی‌گرداند. {st, known, changed} */
function tgSchStNorm_(s) {
  var v = String(s || '').trim();
  if (!v) return { st: TG_SCH_ST_OPEN, known: false, changed: true };
  if (TG_SCH_ST.indexOf(v) > -1) return { st: v, known: true, changed: false };
  if (TG_SCH_ST_MAP[v]) return { st: TG_SCH_ST_MAP[v], known: true, changed: true };
  var g = '';
  if (/مشروط/.test(v)) g = TG_SCH_ST_COND;
  else if (/پیش.?ثبت/.test(v)) g = TG_SCH_ST_PRE;
  else if (/قطعی|ثبت‌نام شد|پرداخت کامل|پذیرش شد|شروع دوره/.test(v)) g = TG_SCH_ST_DONE;
  else if (/منصرف|منتفی|لغو/.test(v)) g = 'منصرف شد';
  else if (/پاسخ نداد|بی‌پاسخ|جواب نداد/.test(v)) g = 'پاسخ نداد (نهایی)';
  else if (/عدم|رد شد|رد/.test(v)) g = 'عدم پذیرش';
  else if (/تکرار/.test(v)) g = 'تکراری';
  else if (/بعد/.test(v)) g = 'دورهٔ بعد';
  else if (/بست/.test(v)) g = 'بسته';
  if (g) return { st: g, known: true, changed: true };
  return { st: TG_SCH_ST_OPEN, known: false, changed: true };
}

function tgSchStageIdx_(s) { return TG_SCH_STAGES.indexOf(String(s || '').trim()); }

/* مرحله را به یکی از نُه نام برمی‌گرداند. {st, known, changed} */
function tgSchStageNorm_(s) {
  var v = String(s || '').trim();
  if (!v) return { st: TG_SCH_STAGES[TG_SCH_SG.lead], known: false, changed: true };
  if (tgSchStageIdx_(v) > -1) return { st: v, known: true, changed: false };
  if (TG_SCH_STAGE_MAP[v]) return { st: TG_SCH_STAGE_MAP[v], known: true, changed: true };
  var g = '';
  if (/قطعی|عضویت/.test(v)) g = TG_SCH_STAGES[TG_SCH_SG.done];
  else if (/پذیرش/.test(v)) g = TG_SCH_STAGES[TG_SCH_SG.acc];
  else if (/مصاحبه/.test(v)) g = TG_SCH_STAGES[TG_SCH_SG.itv];
  else if (/پرداخت/.test(v)) g = TG_SCH_STAGES[TG_SCH_SG.pre];
  else if (/درخواست|فرم|متقاضی/.test(v)) g = TG_SCH_STAGES[TG_SCH_SG.apply];
  else if (/تماس/.test(v)) g = TG_SCH_STAGES[TG_SCH_SG.call];
  else if (/حاضر|شرکت کرد|روز باز/.test(v)) g = TG_SCH_STAGES[TG_SCH_SG.came];
  else if (/وبینار/.test(v)) g = TG_SCH_STAGES[TG_SCH_SG.web];
  if (g) return { st: g, known: true, changed: true };
  return { st: TG_SCH_STAGES[TG_SCH_SG.lead], known: false, changed: true };
}

/* مرحله فقط جلو می‌رود: از دو نام، جلوتر را برمی‌گرداند */
function tgSchStageMax_(cur, want) {
  var a = tgSchStageIdx_(tgSchStageNorm_(cur).st), b = tgSchStageIdx_(tgSchStageNorm_(want).st);
  if (!String(cur || '').trim()) a = -1;
  return TG_SCH_STAGES[Math.max(a, b, 0)];
}

function tgSchStageAtLeast_(stage, key) { return tgSchStageIdx_(stage) >= TG_SCH_SG[key]; }

/* ---------- دفتر رویدادهای مدرسه ---------- */
function tgSchEvSheet_() {
  if (TG_DRY) return null;
  var sh = tgSchSheet_(TG_SCH_EV_TAB, TG_SCH_EV_HEAD);
  try { if (sh && !sh.isSheetHidden() && sh.getLastRow() <= 1) sh.hideSheet(); } catch (e) {}
  return sh;
}

function tgSchEv_(o) {
  if (TG_DRY) { TG_OUTBOX.push({ kind: 'schev', o: o }); return; }
  try {
    var sh = tgSchEvSheet_();
    if (!sh) return;
    sh.appendRow([new Date(), o.code || '', o.row || '', o.actor || 'بات', o.channel || 'بات مدرسه', o.what || '',
                  o.from === undefined || o.from === null ? '' : String(o.from),
                  o.to === undefined || o.to === null ? '' : String(o.to), o.note || '']);
  } catch (e) { try { tgErr_('tgSchEv_: ' + e); } catch (e2) {} }
}

var TG_AP_RESULTS = ['عدم پذیرش', 'شرکت در دوره الزامی است', 'شرکت در سوپرویژن الزامی است',
                     'هر دو الزامی است', 'پذیرش کامل'];
var TG_AP_STAGES  = ['اطلاعات تکمیل شد', 'مصاحبهٔ اول', 'ارجاع به سوپروایزر',
                     'مصاحبهٔ دوم', 'ثبت نتیجه', 'همکاری آغاز شد', 'بسته'];

var TG_SV_DAYS = ['شنبه', 'یکشنبه', 'دوشنبه', 'سه‌شنبه', 'چهارشنبه', 'پنج‌شنبه', 'جمعه'];
var TG_SV_MINS = [45, 60, 90, 120];
var TG_SV_CAPS = [2, 3, 4, 5, 6, 8];

/* دکمه‌ها */
var TG_SL_BTN   = '📥 کارهای مدرسه';
var TG_SV_MY    = '🗓 وقت‌های سوپرویژن من';
var TG_SV_FREE  = '🔎 وقت سوپرویژن';
var TG_AL_BTN   = '🎓 دانش‌آموختهٔ مدرسه‌ام';
var TG_AP_BTN   = '🧑‍🏫 اپلای تراپیست کلینیک';
var TG_PZ_BTN   = '📝 پیش‌ثبت‌نام دوره';
var TG_PATH_BTN = '📈 مسیر من';   /* v166.25؛ برچسب قبلی «🧭 مسیر من» هم کار می‌کند */
var TG_TEA_PAGE = '🪪 صفحهٔ من در سایت مدرسه';
var TG_TEA_CAL  = '📅 تقویم جلسه‌های من';

/* ---------- کمک‌کار عمومی ---------- */

function tgSchToday_() { return Utilities.formatDate(new Date(), TG_TZ, 'yyyy-MM-dd'); }

function tgSchClosed_(v) {
  var s = String(v || '').trim();
  if (!s) return false;
  for (var i = 0; i < TG_SCH_CLOSED.length; i++) if (TG_SCH_CLOSED[i] === s) return true;
  return false;
}

/* شمارش روزهای گذشته از یک تاریخ yyyy-MM-dd یا Date */
function tgSchDays_(v) {
  if (!v) return -1;
  var d = null;
  if (v instanceof Date) d = v;
  else {
    var m = String(v).match(/(\d{4})-(\d{2})-(\d{2})/);
    if (m) d = new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3]));
  }
  if (!d || isNaN(d.getTime())) return -1;
  return Math.floor((new Date().getTime() - d.getTime()) / 86400000);
}

/* فهرست کوتاه با جمع‌بندی «و N مورد دیگر»، عیناً قاعدهٔ جمع‌بندی‌های فعلی بات */
function tgSchCap_(lines, cap) {
  var n = cap || TG_SCH_SUM_MAX;
  if (lines.length <= n) return lines.join('\n');
  return lines.slice(0, n).join('\n') + '\nو ' + (lines.length - n) + ' مورد دیگر';
}

function tgSchOwnerOf_(chat, uname) {
  if (TG_DRY) return TG_MEM['schowner'] || null;
  try { var o = tgSjIsOwner_(chat); if (o) return o; } catch (e) {}
  /* ناظر (مالک) هم همهٔ صف‌های مدرسه را می‌بیند */
  try { var wp = tgWhoWatch_(chat, uname); if (wp) return { name: wp.name || 'ناظر', chat: String(chat), watch: true }; } catch (e2) {}
  return null;
}

/* مسئول ارشد مدرسه. v170.9: یوزرنیم در کد نیست؛ از Script Property «SCHOOL_CHIEF_USER»، وگرنه کسی که در «تیم پذیرش» نقش «مسئول سازمانی» دارد */
function tgSchChiefUser_() {
  var u = String(cfg_('SCHOOL_CHIEF_USER', '') || '').replace(/^@/, '').toLowerCase().trim();
  if (u) return u;
  try { var d = tgDeskRows_().filter(function (r) { return r.role.indexOf('مسئول سازمانی') > -1 && r.user; })[0]; return d ? d.user : ''; } catch (e) { return ''; }
}
function tgSchChief_() {
  if (TG_DRY) return TG_MEM['schchief'] || null;
  try {
    var cu = tgSchChiefUser_(); if (!cu) return null;
    var list = tgPeopleList_();
    for (var i = 0; i < list.length; i++) {
      if (String(list[i].user || '').toLowerCase() === cu && list[i].chat) return list[i];
    }
  } catch (e) {}
  return null;
}

/* ---------- تب‌های تازهٔ هاب مدرسه ---------- */

function tgSchSlotSheet_() { return tgSchSheet_(TG_SCH_T_SLOT, TG_SCH_SLOT_HEAD); }
function tgSchGrpSheet_()  { return tgSchSheet_(TG_SCH_T_GRP, TG_SCH_GRP_HEAD); }
function tgSchAlumSheet_() { return tgSchSheet_(TG_SCH_T_ALUM, TG_SCH_ALUM_HEAD); }

/* ==================================================================
   ۱) کارت لید مدرسه — کد S-
   ================================================================== */

function tgSlCol_(name) {
  for (var i = 0; i < TG_SCH_REQ_HEAD.length; i++) if (TG_SCH_REQ_HEAD[i] === name) return i + 1;
  return 0;
}

function tgSlWidth_() { return TG_SCH_REQ_HEAD.length; }

/* کد پایدار S-1001 به بالا */
function tgSlCode_(row) {
  if (TG_DRY) return (TG_MEM['slcode'] && TG_MEM['slcode'][row]) || 'S-1001';
  var sh = tgSchSheet_(TG_SCH_T_REQ, TG_SCH_REQ_HEAD);
  if (!sh || row < 2) return '';
  var col = tgSlCol_('کد لید مدرسه');
  var cur = String(sh.getRange(row, col).getValue() || '').trim();
  if (cur) return cur;
  var lock = LockService.getScriptLock();
  if (!TG_DRY) { try { lock.waitLock(8000); } catch (e) {} }   /* v166.24 */
  try {
    cur = String(sh.getRange(row, col).getValue() || '').trim();
    if (cur) return cur;
    var max = 1000;
    var last = sh.getLastRow();
    if (last > 1) {
      var v = sh.getRange(2, col, last - 1, 1).getValues();
      for (var i = 0; i < v.length; i++) {
        var m = String(v[i][0] || '').match(/^S-(\d+)$/);
        if (m && Number(m[1]) > max) max = Number(m[1]);
      }
    }
    var code = 'S-' + (max + 1);
    sh.getRange(row, col).setValue(code);
    return code;
  } finally { try { lock.releaseLock(); } catch (e2) {} }
}

function tgSlByCode_(code) {
  var c = String(code || '').trim();
  if (!c) return 0;
  if (TG_DRY) return (TG_DRY_SLROW || 0);
  var sh = tgSchSheet_(TG_SCH_T_REQ, TG_SCH_REQ_HEAD);
  if (!sh || sh.getLastRow() < 2) return 0;
  var col = tgSlCol_('کد لید مدرسه');
  var v = sh.getRange(2, col, sh.getLastRow() - 1, 1).getValues();
  for (var i = 0; i < v.length; i++) if (String(v[i][0] || '').trim() === c) return i + 2;
  return 0;
}

function tgSlRead_(row) {
  if (TG_DRY) return TG_DRY_SLEAD || null;
  var sh = tgSchSheet_(TG_SCH_T_REQ, TG_SCH_REQ_HEAD);
  if (!sh || row < 2) return null;
  var v = sh.getRange(row, 1, 1, tgSlWidth_()).getValues()[0];
  var o = {
    row: row, id: String(v[0] || '').trim(), date: v[1], name: String(v[2] || '').trim(),
    user: String(v[3] || '').trim(), chat: String(v[4] || '').trim(),
    role: String(v[5] || '').trim(), course: String(v[6] || '').trim(),
    circle: String(v[7] || '').trim(), uni: String(v[10] || '').trim(),
    note: String(v[11] || '').trim(), status: String(v[12] || '').trim(),
    code: String(v[16] || '').trim(), stage: String(v[17] || '').trim(),
    owner: String(v[18] || '').trim(), touched: String(v[19] || '').trim(),
    result: String(v[20] || '').trim(), openday: String(v[21] || '').trim(),
    itv: String(v[22] || '').trim(), itvres: String(v[23] || '').trim(),
    /* v142 */
    phone: String(v[8] || '').trim(), email: String(v[9] || '').trim(),
    camp: String(v[25] || '').trim(), src: String(v[26] || '').trim(),
    tier: String(v[27] || '').trim(), pay: String(v[28] || '').trim(), web: String(v[29] || '').trim()
  };
  o.statusRaw = o.status;
  o.stageIdx = tgSchStageIdx_(o.stage);
  o.closed = tgSchClosed_(o.status);
  o.age = tgSchDays_(o.date);
  o.idle = tgSchDays_(o.touched);
  o.bucket = o.touched ? (o.idle >= TG_SCH_IDLE_DAYS ? 'stale' : 'live') : 'first';
  return o;
}

/* تنها نویسندهٔ ستون‌های لید مدرسه.
   v142: «وضعیت» و «مرحلهٔ قیف» پیش از نوشتن به واژگان واحد برمی‌گردند؛ مرحله فقط جلو می‌رود
   مگر opts.stageBack؛ هر تغییر یک سطر در «رویدادهای مدرسه» می‌گذارد و نشانهٔ ضدحلقه برای تریگر شیت. */
function tgSlSet_(row, changes, actor, opts) {
  if (!row || row < 2 || !changes) return '';
  opts = opts || {};
  var ch = {};
  for (var k0 in changes) if (Object.prototype.hasOwnProperty.call(changes, k0)) ch[k0] = changes[k0];
  if (ch['وضعیت'] !== undefined && ch['وضعیت'] !== null && String(ch['وضعیت']).trim()) ch['وضعیت'] = tgSchStNorm_(ch['وضعیت']).st;
  if (ch['مرحلهٔ قیف'] !== undefined && ch['مرحلهٔ قیف'] !== null && String(ch['مرحلهٔ قیف']).trim()) ch['مرحلهٔ قیف'] = tgSchStageNorm_(ch['مرحلهٔ قیف']).st;
  if (TG_DRY) {
    var curD = (TG_DRY_SLEAD && TG_DRY_SLEAD.row === row) ? TG_DRY_SLEAD : null;
    if (ch['مرحلهٔ قیف'] !== undefined && curD && !opts.stageBack) ch['مرحلهٔ قیف'] = tgSchStageMax_(curD.stage, ch['مرحلهٔ قیف']);
    TG_OUTBOX.push({ kind: 'schset', row: row, changes: ch, actor: actor || 'بات' });
    var arrD = TG_MEM['cp:' + TG_SCH_T_REQ] || [], oD = arrD[row - 2];
    if (oD) for (var kD in ch) oD[kD] = ch[kD];
    if (curD) {
      if (ch['وضعیت'] !== undefined) { curD.status = ch['وضعیت']; curD.statusRaw = ch['وضعیت']; curD.closed = tgSchClosed_(ch['وضعیت']); }
      if (ch['مسئول پیگیری'] !== undefined) curD.owner = ch['مسئول پیگیری'];
      if (ch['نتیجهٔ آخرین تماس'] !== undefined) curD.result = ch['نتیجهٔ آخرین تماس'];
      if (ch['مرحلهٔ قیف'] !== undefined) { curD.stage = ch['مرحلهٔ قیف']; curD.stageIdx = tgSchStageIdx_(curD.stage); }
      if (ch['آخرین تماس'] !== undefined) { curD.touched = ch['آخرین تماس']; curD.idle = 0; curD.bucket = 'live'; }
      if (ch['تاریخ روز باز'] !== undefined) curD.openday = ch['تاریخ روز باز'];
      if (ch['تاریخ مصاحبه'] !== undefined) curD.itv = ch['تاریخ مصاحبه'];
      if (ch['کد کمپین'] !== undefined) curD.camp = ch['کد کمپین'];
      if (ch['وضعیت پرداخت'] !== undefined) curD.pay = ch['وضعیت پرداخت'];
      if (ch[TG_SCH_WEB_COL] !== undefined) curD.web = ch[TG_SCH_WEB_COL];
    }
    return curD ? curD.code : 'S-9999';
  }
  var sh = tgSchSheet_(TG_SCH_T_REQ, TG_SCH_REQ_HEAD);
  if (!sh) return '';
  var code = tgSlCode_(row);
  if (ch['مرحلهٔ قیف'] !== undefined && !opts.stageBack) {
    var curStage = String(sh.getRange(row, tgSlCol_('مرحلهٔ قیف')).getValue() || '').trim();
    ch['مرحلهٔ قیف'] = tgSchStageMax_(curStage, ch['مرحلهٔ قیف']);
  }
  var any = false;
  for (var k in ch) {
    if (!Object.prototype.hasOwnProperty.call(ch, k)) continue;
    var col = tgSlCol_(k);
    if (!col) { tgErr_('tgSlSet_ ستون ناشناس: ' + k); continue; }
    var old = String(sh.getRange(row, col).getValue() || '').trim();
    var neu = String(ch[k] === undefined || ch[k] === null ? '' : ch[k]).trim();
    if (old === neu) continue;
    if (!any) { tgSlMark_(row); any = true; }
    sh.getRange(row, col).setValue(ch[k]);
    tgSchEv_({ code: code, row: row, actor: actor || 'بات', channel: opts.channel || 'بات مدرسه', what: k, from: old, to: neu, note: opts.why || '' });
  }
  return code;
}

function tgSlNote_(row, text, actor) {
  var t = String(text || '').trim();
  if (!t) return;
  if (TG_DRY) { TG_OUTBOX.push({ kind: 'schnote', row: row, text: t, actor: actor || 'بات' }); return; }
  var sh = tgSchSheet_(TG_SCH_T_REQ, TG_SCH_REQ_HEAD);
  if (!sh) return;
  var col = tgSlCol_('یادداشت مدرسه');
  var cur = String(sh.getRange(row, col).getValue() || '').trim();
  var line = tgJDateFull_(new Date(), TG_TZ) + ' · ' + (actor || 'بات') + ': ' + t;
  tgSlMark_(row);
  sh.getRange(row, col).setValue(cur ? (cur + '\n' + line) : line);
  tgSchEv_({ code: tgSlCode_(row), row: row, actor: actor || 'بات', channel: 'بات مدرسه', what: 'یادداشت', from: '', to: t });
}

/* همهٔ لیدهای باز مدرسه */
function tgSlOpen_() {
  var out = [];
  var v = tgSchRows_(TG_SCH_T_REQ, TG_SCH_REQ_HEAD, tgSlWidth_());
  for (var i = 0; i < v.length; i++) {
    var id = String(v[i][0] || '').trim();
    if (!id) continue;
    var st = String(v[i][12] || '').trim();
    if (tgSchClosed_(st)) continue;
    var touched = String(v[i][19] || '').trim();
    var o = {
      row: i + 2, id: id, name: String(v[i][2] || '').trim(), role: String(v[i][5] || '').trim(),
      course: String(v[i][6] || '').trim(), status: st, code: String(v[i][16] || '').trim(),
      stage: String(v[i][17] || '').trim(), owner: String(v[i][18] || '').trim(),
      touched: touched, age: tgSchDays_(v[i][1]), idle: tgSchDays_(touched),
      phone: String(v[i][8] || '').trim(), chat: String(v[i][4] || '').trim(),
      camp: String(v[i][25] || '').trim(), pay: String(v[i][28] || '').trim()
    };
    o.stageIdx = tgSchStageIdx_(o.stage);
    o.bucket = touched ? (o.idle >= TG_SCH_IDLE_DAYS ? 'stale' : 'live') : 'first';
    out.push(o);
  }
  return out;
}

function tgSlBuckets_(list) {
  var b = { first: [], stale: [], live: [] };
  for (var i = 0; i < list.length; i++) b[list[i].bucket].push(list[i]);
  return b;
}

function tgSlLine_(l) {
  var t = '• ' + (l.name || 'بدون نام');
  if (l.code) t += ' · ' + l.code;
  if (l.course) t += ' · ' + l.course;
  if (l.owner) t += ' · ' + l.owner;
  return t;
}

function tgSlCardText_(l) {
  var tag = l.closed ? '✅ ' : (l.bucket === 'first' ? '☎ ' : (l.bucket === 'stale' ? '↻ ' : '⏳ '));
  var t = '<b>' + tag + tgEsc_(l.name || 'بدون نام') + '</b>';
  if (l.code) t += ' · <code>' + tgEsc_(l.code) + '</code>';
  t += '\n🎓 ' + tgEsc_(l.role || 'دانشجو');
  if (l.course) t += ' · ' + tgEsc_(l.course);
  if (l.circle) t += ' · ' + tgEsc_(l.circle);
  t += '\n' + (l.bucket === 'first'
    ? 'ثبت ' + (l.age >= 0 ? l.age : 0) + ' روز پیش، هنوز تماس اول نگرفته'
    : 'آخرین تماس ' + (l.idle >= 0 ? l.idle : 0) + ' روز پیش');
  t += '\nمرحله: <b>' + tgEsc_(l.stage || TG_SCH_STAGES[TG_SCH_SG.lead]) + '</b>';
  t += ' · ' + tgEsc_(l.status || TG_SCH_ST_OPEN);
  t += ' · ' + (l.owner ? tgEsc_(l.owner) : 'بدون مسئول');
  if (l.camp) t += '\nکمپین: ' + tgEsc_(l.camp) + (l.src ? ' · ' + tgEsc_(String(l.src).slice(0, 40)) : '');
  if (l.phone) t += '\n📞 ' + tgEsc_(l.phone) + (l.chat ? ' · در بات' : ' · خارج از بات');
  if (l.pay) t += '\n💳 ' + tgEsc_(l.pay);
  if (l.result) t += '\nنتیجهٔ آخرین تماس: ' + tgEsc_(l.result);
  if (l.web) t += '\nوبینار: ' + tgEsc_(l.web) + (l.openday ? ' · ' + tgEsc_(l.openday) : '');
  if (l.itv) t += '\nمصاحبه: ' + tgEsc_(l.itv) + (l.itvres ? ' · ' + tgEsc_(l.itvres) : '');
  if (l.note) t += '\n\n<i>' + tgEsc_(String(l.note).slice(0, 180)) + '</i>';
  return t;
}

function tgSlKb_(l) {
  if (l.closed) {
    return { inline_keyboard: [[{ text: '↺ باز کردن دوباره', callback_data: 'sl:open:' + l.code }]] };
  }
  /* v142: دکمه‌ها همان نُه مرحلهٔ قیف‌اند؛ هر دکمه مرحله را جلو می‌برد و همان لحظه در شیت هم دیده می‌شود */
  /* v166.24: ردیف اول و دوم یک‌ضرب‌اند: آخرین تماس و نتیجه‌اش ثبت می‌شود و کارت لید بعدی می‌آید */
  var rows = [
    [{ text: '☎ تماس گرفتم', callback_data: 'sl:call:' + l.code },
     { text: '🔕 جواب نداد', callback_data: 'sl:noans:' + l.code }],
    [{ text: '🗓 مصاحبه گذاشتیم', callback_data: 'sl:ivok:' + l.code },
     { text: '🚫 منصرف شد', callback_data: 'sl:quit:' + l.code }],
    [{ text: '📝 یادداشت', callback_data: 'sl:note:' + l.code },
     { text: '👥 واگذاری', callback_data: 'sl:asg:' + l.code }],
    [{ text: '📺 حاضر در وبینار', callback_data: 'sl:came:' + l.code },
     { text: '📄 درخواست دوره', callback_data: 'sl:app:' + l.code }],
    [{ text: '💳 پیش‌پرداخت رسید', callback_data: 'sl:pre:' + l.code },
     { text: '🗓 تاریخ مصاحبه', callback_data: 'sl:itv:' + l.code }],
    [{ text: '✅ پذیرش', callback_data: 'sl:acc:' + l.code },
     { text: '🎓 ثبت‌نام قطعی', callback_data: 'sl:done:' + l.code }],
    [{ text: '⛔ بستن', callback_data: 'sl:close:' + l.code }]
  ];
  return { inline_keyboard: rows };
}

function tgSlCardSend_(chat, row) {
  var l = tgSlRead_(row);
  if (!l) return null;
  if (!l.code) l.code = tgSlCode_(row);
  return tgSend_(chat, tgSlCardText_(l), tgSlKb_(l));
}

function tgSlCardEdit_(cq, l) {
  if (!l) return null;
  if (TG_DRY) {
    TG_OUTBOX.push({ kind: 'msg', chat: String(cq.message.chat.id), text: tgSlCardText_(l), markup: tgSlKb_(l) });
    return null;
  }
  return tgApi_('editMessageText', {
    chat_id: cq.message.chat.id,
    message_id: cq.message.message_id,
    text: tgSlCardText_(l),
    parse_mode: 'HTML',
    disable_web_page_preview: true,
    reply_markup: tgSlKb_(l)
  });
}

/* v166.24: بعد از هر دکمهٔ یک‌ضرب، کارت لید بعدی که امروز سراغش نرفته‌ایم (اول تماس‌نگرفته‌ها، بعد بی‌پیگیری‌ها) */
function tgSlNext_(chat, doneRow) {
  var b = tgSlBuckets_(tgSlOpen_()), today = tgSchToday_();
  var list = [].concat(b.first).concat(b.stale).filter(function (l) { return l.row !== doneRow && l.touched !== today; });
  if (!list.length) return tgSend_(chat, '👏 لید باز دیگری برای امروز نمانده.');
  tgSend_(chat, '⏭ لید بعدی · ' + tgFa_(String(list.length)) + ' لید مانده');
  return tgSlCardSend_(chat, list[0].row);
}

/* خلاصه و کارت‌ها برای مسئول مدرسه */
function tgSlDesk_(chat) {
  var b = tgSlBuckets_(tgSlOpen_());
  var total = b.first.length + b.stale.length + b.live.length;
  var t = '📥 <b>کارهای مدرسه</b>\n\n' +
          'لید باز: ' + total + '\n' +
          '☎ منتظر تماس اول: ' + b.first.length + '\n' +
          '↻ بیش از ' + TG_SCH_IDLE_DAYS + ' روز بی‌پیگیری: ' + b.stale.length + '\n' +
          '⏳ در جریان: ' + b.live.length;
  tgSend_(chat, t);
  var pick = [].concat(b.first.slice(0, TG_SCH_CARD_MAX)).concat(b.stale.slice(0, TG_SCH_CARD_MAX));
  var seen = {}, n = 0;
  for (var i = 0; i < pick.length && n < TG_SCH_CARD_MAX; i++) {
    if (seen[pick[i].row]) continue;
    seen[pick[i].row] = 1;
    if (tgSlCardSend_(chat, pick[i].row)) n++;
  }
  if (!total) tgSend_(chat, 'الان لید بازی نداریم.');
  return true;
}

function tgOnSl_(cq, rest) {
  var chat = cq.message.chat.id;
  var uname = cq.from && cq.from.username ? '@' + cq.from.username : '';
  var who = tgSchOwnerOf_(chat, uname);
  if (!who) return tgSend_(chat, 'این دکمه‌ها برای مسئول مدرسه است.');
  var me = who.name || 'مدرسه';
  var p = String(rest || '').split(':');
  var act = p[0] || '';
  var code = p[1] || '';
  var arg = p.slice(2).join(':');
  var row = tgSlByCode_(code);
  if (row < 2) return tgSend_(chat, 'این لید پیدا نشد. شاید سطرش در شیت جابه‌جا شده باشد.');
  var today = tgSchToday_();

  if (act === 'call') {
    var l0 = tgSlRead_(row);
    var ch = { 'آخرین تماس': today, 'نتیجهٔ آخرین تماس': 'صحبت شد', 'مرحلهٔ قیف': TG_SCH_STAGES[TG_SCH_SG.call] };
    if (!l0 || !l0.owner) ch['مسئول پیگیری'] = me;
    tgSlSet_(row, ch, me);
    tgSlCardEdit_(cq, tgSlRead_(row));
    return tgSlNext_(chat, row);
  }

  if (act === 'noans') {
    tgSlSet_(row, { 'آخرین تماس': today, 'نتیجهٔ آخرین تماس': 'پاسخ نداد',
                    'مرحلهٔ قیف': TG_SCH_STAGES[TG_SCH_SG.call] }, me);
    tgSlCardEdit_(cq, tgSlRead_(row));
    return tgSlNext_(chat, row);
  }

  if (act === 'ivok') {   /* v166.24: مصاحبه گذاشتیم، یک‌ضرب */
    var lI = tgSlRead_(row);
    var chI = { 'آخرین تماس': today, 'نتیجهٔ آخرین تماس': 'مصاحبه گذاشتیم', 'مرحلهٔ قیف': TG_SCH_STAGES[TG_SCH_SG.itv] };
    if (!lI || !lI.owner) chI['مسئول پیگیری'] = me;
    tgSlSet_(row, chI, me);
    tgSlCardEdit_(cq, tgSlRead_(row));
    return tgSlNext_(chat, row);
  }

  if (act === 'quit') {   /* v166.24: منصرف شد، یک‌ضرب */
    tgSlSet_(row, { 'وضعیت': TG_SCH_CLOSE_REASONS[0], 'آخرین تماس': today, 'نتیجهٔ آخرین تماس': 'منصرف شد' }, me);
    tgSend_(chat, '✅ لید ' + tgEsc_(code) + ' بسته شد: منصرف شد');
    return tgSlNext_(chat, row);
  }

  if (act === 'came' || act === 'oday') {
    var chW = { 'تاریخ روز باز': today, 'مرحلهٔ قیف': TG_SCH_STAGES[TG_SCH_SG.came] };
    chW[TG_SCH_WEB_COL] = 'حاضر';
    tgSlSet_(row, chW, me);
    return tgSlCardEdit_(cq, tgSlRead_(row));
  }

  if (act === 'app') {
    tgSlSet_(row, { 'مرحلهٔ قیف': TG_SCH_STAGES[TG_SCH_SG.apply], 'وضعیت': TG_SCH_ST_OPEN }, me);
    return tgSlCardEdit_(cq, tgSlRead_(row));
  }

  if (act === 'pre') {
    var rp = tgSchPreManual_(row, me);
    if (rp !== 'ok') return tgSend_(chat, tgEsc_(rp));
    tgSend_(chat, '💳 پیش‌پرداخت ثبت شد و برای تأیید به یاسر رفت. بعد از تأیید، مرحله خودکار «پیش‌پرداخت» می‌شود.');
    return tgSlCardEdit_(cq, tgSlRead_(row));
  }

  if (act === 'done') {
    tgSchEnroll_(row, me);
    tgSend_(chat, '🎓 ثبت‌نام قطعی شد' + (TG_DRY ? '' : ' و سطر «عضویت دانشجو» ساخته شد') + '.');
    return tgSlCardEdit_(cq, tgSlRead_(row));
  }

  if (act === 'note') {
    tgSetVal_('sln', chat, code);
    return tgSend_(chat, '📝 یادداشت این لید را بنویسید. برای بی‌خیال شدن «انصراف» را بفرستید.');
  }

  if (act === 'asg') {
    var own = TG_DRY ? (TG_MEM['schowners'] || []) : tgSchoolOwners_();
    var rows = [];
    for (var i = 0; i < own.length; i++) {
      rows.push([{ text: own[i].name, callback_data: 'sl:as:' + code + ':' + own[i].name }]);
    }
    rows.push([{ text: '↩️ بی‌خیال', callback_data: 'sl:back:' + code }]);
    return tgSend_(chat, 'این لید به چه کسی برسد؟', { inline_keyboard: rows });
  }

  if (act === 'as') {
    if (!arg) return tgSend_(chat, 'اسم مسئول خوانده نشد.');
    tgSlSet_(row, { 'مسئول پیگیری': arg }, me);
    var own2 = TG_DRY ? (TG_MEM['schowners'] || []) : tgSchoolOwners_();
    for (var j = 0; j < own2.length; j++) {
      if (own2[j].name === arg && own2[j].chat && String(own2[j].chat) !== String(chat)) {
        tgSend_(own2[j].chat, '👥 یک لید مدرسه به شما واگذار شد.');
        tgSlCardSend_(own2[j].chat, row);
      }
    }
    return tgSend_(chat, '✅ واگذار شد به ' + tgEsc_(arg) + '.');
  }

  if (act === 'itv') {
    tgSetVal_('sli', chat, code);
    return tgSend_(chat, '🗓 تاریخ مصاحبه را بنویسید، مثل ۱۴۰۵/۰۷/۰۲ یا «امروز». برای بی‌خیال شدن «انصراف» را بفرستید.');
  }

  if (act === 'acc') {
    /* v142: پذیرش یعنی نتیجهٔ مصاحبه مثبت بود؛ ثبت‌نام قطعی جداست و مسئول مدرسه می‌زند */
    var l2 = tgSlRead_(row);
    var chA = { 'مرحلهٔ قیف': TG_SCH_STAGES[TG_SCH_SG.acc] };
    if (l2 && !l2.itvres) chA['نتیجهٔ مصاحبه'] = TG_CP_IV_RES.full;
    if (l2 && l2.status === TG_SCH_ST_COND) chA['وضعیت'] = TG_SCH_ST_OPEN;
    tgSlSet_(row, chA, me);
    return tgSlCardEdit_(cq, tgSlRead_(row));
  }

  if (act === 'close') {
    var rows2 = [];
    for (var k = 0; k < TG_SCH_CLOSE_REASONS.length; k++) {
      rows2.push([{ text: TG_SCH_CLOSE_REASONS[k], callback_data: 'sl:cl:' + code + ':' + k }]);
    }
    rows2.push([{ text: '↩️ بی‌خیال', callback_data: 'sl:back:' + code }]);
    return tgSend_(chat, 'به چه دلیل بسته می‌شود؟', { inline_keyboard: rows2 });
  }

  if (act === 'cl') {
    var label = TG_SCH_CLOSE_REASONS[Number(arg)];
    if (!label) return tgSend_(chat, 'این دلیل پیدا نشد.');
    var chC = { 'وضعیت': label, 'آخرین تماس': today };
    if (label === TG_SCH_CLOSE_REASONS[0]) chC['نتیجهٔ آخرین تماس'] = label;
    tgSlSet_(row, chC, me);
    tgSend_(chat, '✅ لید ' + tgEsc_(code) + ' بسته شد: ' + tgEsc_(label));
    return tgSlNext_(chat, row);
  }

  if (act === 'open') {
    tgSlSet_(row, { 'وضعیت': TG_SCH_ST_OPEN }, me);
    return tgSlCardEdit_(cq, tgSlRead_(row));
  }

  if (act === 'back') return tgSlCardSend_(chat, row);
  return null;
}

/* متن آزاد: یادداشت و تاریخ مصاحبه */
function tgSlText_(chat, name, uname, text) {
  var t = String(text || '').trim();
  if (!t) return false;
  var esc = (t === 'انصراف' || t === '↩️ بازگشت' || t.indexOf('/') === 0 || tgIsBtnLike_(t));

  var codeN = tgGetVal_('sln', chat);
  if (codeN) {
    tgDel_('sln', chat);
    if (esc) return false;
    var rowN = tgSlByCode_(codeN);
    if (rowN < 2) { tgSend_(chat, 'این لید پیدا نشد.'); return true; }
    var whoN = tgSchOwnerOf_(chat, uname);
    tgSlNote_(rowN, t, whoN && whoN.name ? whoN.name : 'مدرسه');
    tgSend_(chat, '✅ یادداشت روی ' + tgEsc_(codeN) + ' ثبت شد.');
    tgSlCardSend_(chat, rowN);
    return true;
  }

  var codeI = tgGetVal_('sli', chat);
  if (codeI) {
    tgDel_('sli', chat);
    if (esc) return false;
    var rowI = tgSlByCode_(codeI);
    if (rowI < 2) { tgSend_(chat, 'این لید پیدا نشد.'); return true; }
    var whoI = tgSchOwnerOf_(chat, uname);
    var val = (t === 'امروز') ? tgJDateFull_(new Date(), TG_TZ) : t;
    tgSlSet_(rowI, { 'تاریخ مصاحبه': val, 'مرحلهٔ قیف': TG_SCH_STAGES[TG_SCH_SG.itv] },
             whoI && whoI.name ? whoI.name : 'مدرسه');
    tgSend_(chat, '✅ مصاحبه ثبت شد: ' + tgEsc_(val));
    tgSlCardSend_(chat, rowI);
    return true;
  }
  return false;
}

/* ==================================================================
   v142 · یک نفر × یک کمپین = یک سطر در «درخواست عضویت»
   هر کانالی (وبینار بات، درخواست، پیش‌ثبت‌نام، فرم سایت، ثبت دستی)
   فقط از همین تابع سطر می‌سازد یا مرحله را جلو می‌برد.
   ================================================================== */

/* v166.24: یک شکل برای ذخیره: موبایل ایران ۰۹xxxxxxxxx، بقیه +کد کشور و شماره (فقط رقم لاتین) */
function tgSchPhoneStore_(p) {
  var raw = tgLatinDigits_(String(p == null ? '' : p)).trim();
  if (!raw) return '';
  var d = raw.replace(/[^0-9]/g, '');
  if (!d) return raw;
  if (d.indexOf('00') === 0) d = d.slice(2);
  if (/^98?9\d{9}$/.test(d) && d.length === 12) return '0' + d.slice(2);
  if (/^9\d{9}$/.test(d)) return '0' + d;
  if (/^09\d{9}$/.test(d)) return d;
  return '+' + d;
}
function tgSchKeyPhone_(p) { return typeof tgRcPhone_ === 'function' ? tgRcPhone_(p) : String(p || '').replace(/\D/g, '').slice(-10); }

/* کمپین را از متن منبع یا نام دوره حدس می‌زند (فقط کمپین‌های باز) */
function tgSchCampFromSrc_(src, course) {
  var s = String(src || '') + ' ' + String(course || '');
  if (!s.trim()) return '';
  var camps = [];
  try { camps = TG_DRY ? (TG_MEM['cp:' + TG_CP_TAB] || []).map(function (o) { return tgCpCamp_(o); }) : tgCpCamps_(); } catch (e) { camps = []; }
  var m = s.match(/([A-Za-z]{2,8})[-_ ]?(\d{1,2})/);
  for (var i = 0; i < camps.length; i++) {
    var c = camps[i];
    if (!c || !c.code) continue;
    if (s.indexOf(c.code) > -1) return c.code;
    if (m && (m[1].toUpperCase() + '-' + m[2]) === c.code) return c.code;
    if (c.state !== 'بسته' && c.course && s.indexOf(c.course) > -1) return c.code;
    if (c.state !== 'بسته' && c.ccode && new RegExp('\\b' + c.ccode + '\\b', 'i').test(s)) return c.code;
  }
  return '';
}

/* سطر یک نفر در یک کمپین را پیدا می‌کند: chat_id، بعد ده رقم شماره، بعد ایمیل.
   سطری که کد کمپین ندارد هم برای همان نفر پذیرفته می‌شود (و کد کمپین می‌گیرد). */
function tgSchLeadFind_(o) {
  var camp = String(o.camp || '').trim();
  var chat = String(o.chat || '').trim(), ph = tgSchKeyPhone_(o.phone), em = String(o.email || '').trim().toLowerCase();
  if (!chat && !(ph && ph.length >= 10) && !em) return 0;
  var rows;
  if (TG_DRY) {
    rows = (TG_MEM['cp:' + TG_SCH_T_REQ] || []).map(function (r, i) {
      return { row: i + 2, chat: String(r['chat_id'] || ''), phone: r['شمارهٔ تماس'], email: r['ایمیل'], camp: String(r['کد کمپین'] || '') };
    });
  } else {
    var sh = tgSchSheet_(TG_SCH_T_REQ, TG_SCH_REQ_HEAD);
    if (!sh || sh.getLastRow() < 2) return 0;
    var v = sh.getRange(2, 1, sh.getLastRow() - 1, 26).getValues();
    rows = [];
    for (var i = 0; i < v.length; i++) {
      if (!String(v[i][0] || '').trim()) continue;
      rows.push({ row: i + 2, chat: String(v[i][4] || '').trim(), phone: v[i][8], email: v[i][9], camp: String(v[i][25] || '').trim() });
    }
  }
  var same = 0, blank = 0;
  for (var j = rows.length - 1; j >= 0; j--) {
    var r = rows[j];
    var hit = (chat && r.chat === chat) || (ph && ph.length >= 10 && tgSchKeyPhone_(r.phone) === ph) ||
              (em && String(r.email || '').trim().toLowerCase() === em);
    if (!hit) continue;
    if (r.camp === camp) { same = r.row; break; }
    if (!r.camp && !blank) blank = r.row;
  }
  return same || blank;
}

/* o = { chat, name, user, phone, email, camp, course, circle, stage, status, src, note, role, uni, actor }
   برمی‌گرداند { row, id, code, created } */
function tgSchLeadEnsure_(o) {
  o = o || {};
  var actor = o.actor || 'بات';
  var stage = o.stage ? tgSchStageNorm_(o.stage).st : TG_SCH_STAGES[TG_SCH_SG.lead];
  var status = o.status ? tgSchStNorm_(o.status).st : TG_SCH_ST_OPEN;
  var camp = String(o.camp || '').trim();
  var row = tgSchLeadFind_(o);
  var ch = {};
  if (o.phone) o.phone = tgSchPhoneStore_(o.phone);
  if (o.name && tgIsBtnLike_(String(o.name).trim())) o.name = '';   /* v166.24: متن دکمه هرگز نام نیست */
  if (row) {
    var cur = tgSlRead_(row) || {};
    if (camp && !cur.camp) ch['کد کمپین'] = camp;
    if (o.chat && !cur.chat) ch['chat_id'] = String(o.chat);
    if (o.user && !cur.user) ch['یوزرنیم تلگرام'] = o.user;
    if (o.phone && !cur.phone) ch['شمارهٔ تماس'] = o.phone;
    if (o.email && !cur.email) ch['ایمیل'] = o.email;
    if (o.name && (!cur.name || tgIsBtnLike_(cur.name))) ch['نام کامل'] = o.name;
    if (o.course && !cur.course) ch['دوره'] = o.course;
    if (o.src && !cur.src) ch['منبع'] = o.src;
    if (o.stage) ch['مرحلهٔ قیف'] = tgSchStageMax_(cur.stage, stage);
    if (o.status && status !== TG_SCH_ST_OPEN) ch['وضعیت'] = status;
    else if (cur.closed && o.reopen !== false) ch['وضعیت'] = TG_SCH_ST_OPEN;
    else if (o.status && cur.status === TG_SCH_ST_PRE && status === TG_SCH_ST_OPEN) ch['وضعیت'] = TG_SCH_ST_OPEN;
    if (o.web) ch[TG_SCH_WEB_COL] = (o.web === 'حاضر' || cur.web === 'حاضر') ? 'حاضر' : 'ثبت‌نام';
    var code = tgSlSet_(row, ch, actor);
    if (o.note) tgSlNote_(row, o.note, actor);
    return { row: row, id: cur.id || '', code: code || cur.code || '', created: false };
  }
  var follow = o.owner || '';
  if (!follow && camp) { try { var cp = tgCpFind_(camp); if (cp) follow = cp.follow || ''; } catch (e) {} }
  var id = TG_DRY ? ('د-' + (100 + (TG_MEM['cp:' + TG_SCH_T_REQ] || []).length)) : tgSchNextId_(TG_SCH_T_REQ, TG_SCH_REQ_HEAD, 'د');
  var obj = {
    'شناسهٔ درخواست': id, 'تاریخ درخواست': o.date || tgJDateFull_(new Date(), TG_TZ), 'نام کامل': o.name || '',
    'یوزرنیم تلگرام': o.user || '', 'chat_id': o.chat ? String(o.chat) : '', 'نقش درخواستی': o.role || 'دانشجو',
    'دوره': o.course || '', 'حلقه': o.circle || '', 'شمارهٔ تماس': o.phone || '', 'ایمیل': o.email || '',
    'رشته و دانشگاه': o.uni || '', 'توضیح متقاضی': o.note || '', 'وضعیت': status,
    'یادداشت مدرسه': o.memo || '', 'مرحلهٔ قیف': stage, 'مسئول پیگیری': follow,
    'کد کمپین': camp, 'منبع': o.src || ''
  };
  if (o.web) obj[TG_SCH_WEB_COL] = o.web === 'حاضر' ? 'حاضر' : 'ثبت‌نام';
  var newRow = tgCpAdd_(TG_SCH_T_REQ, obj);
  var newCode = '';
  try { newCode = tgSlCode_(newRow); } catch (e2) {}
  tgSchEv_({ code: newCode, row: newRow, actor: actor, channel: o.channel || 'بات مدرسه', what: 'لید تازه', from: '', to: stage,
             note: (camp ? camp + ' · ' : '') + (o.src || '') });
  if (!TG_DRY) tgSchDropCache_();
  return { row: newRow, id: id, code: newCode, created: true };
}

/* ثبت‌نام قطعی: وضعیت و مرحله، سطر «عضویت دانشجو»، نقش دانشجو، خوش‌آمد. مسئول مدرسه خودش می‌زند. */
function tgSchEnroll_(row, actor) {
  var l = tgSlRead_(row);
  if (!l) return null;
  tgSlSet_(row, { 'وضعیت': TG_SCH_ST_DONE, 'مرحلهٔ قیف': TG_SCH_STAGES[TG_SCH_SG.done] }, actor || 'مدرسه');
  if (TG_DRY) return l;
  try {
    var camp = l.camp ? tgCpFind_(l.camp) : null;
    if (camp) {
      var lead = tgCpLeadById_(l.id);
      if (lead) tgCpEnroll_(camp, lead);
    } else {
      var label = l.circle || l.course || '';
      if (!tgSchHasMember_(l.chat, l.course, l.circle)) {
        tgSchAddMember_({ name: l.name, user: l.user, chat: l.chat, course: l.course, circle: l.circle, ccode: label,
                          role: 'دانشجو', status: 'فعال', phone: l.phone, uni: l.uni, src: 'ثبت‌نام قطعی ' + l.id, note: '' });
      }
      var p = l.chat ? tgWhoPerson_(l.chat, '') : null;
      if (p) { p.chatNew = l.chat; tgSchGrantRole_(p, 'دانشجو', label); }
      else if (l.chat || l.phone) tgSchNewPerson_({ name: l.name, user: l.user, chat: l.chat, role: 'دانشجو', circle: label, phone: l.phone, uni: l.uni, note: 'ثبت‌نام قطعی ' + l.id });
      if (l.chat) tgSend_(l.chat, '🎉 ثبت‌نامتان در ' + tgEsc_(l.course || 'مدرسهٔ تجربه') + ' قطعی شد. خوش آمدید. برنامهٔ جلسه‌ها را همین‌جا می‌فرستیم.');
    }
  } catch (e) { tgErr_('tgSchEnroll_: ' + e); }
  try {
    var chief = tgSchChief_();
    if (chief && chief.chat) tgSend_(chief.chat, '🎓 ثبت‌نام قطعی: <b>' + tgEsc_(l.name) + '</b>' + (l.camp ? ' · ' + tgEsc_(l.camp) : '') + ' · ' + tgEsc_(actor || 'مدرسه'));
  } catch (e2) {}
  return tgSlRead_(row);
}

/* پیش‌پرداختی که خارج از بات رسیده و مسئول مدرسه ثبت می‌کند؛ باز هم فقط با تأیید یاسر رسمی می‌شود */
function tgSchPreManual_(row, actor) {
  var l = tgSlRead_(row);
  if (!l) return 'لید پیدا نشد.';
  if (!l.camp) return 'این لید کد کمپین ندارد؛ اول کد کمپین را در شیت بنویسید.';
  var camp = TG_DRY ? null : tgCpFind_(l.camp);
  if (!TG_DRY && !camp) return 'کمپین ' + l.camp + ' پیدا نشد.';
  if (TG_DRY) { TG_OUTBOX.push({ kind: 'schpre', row: row }); return 'ok'; }
  var old = tgCpPayOf_(l.id, 'pre');
  if (old && tgCpS_(old['وضعیت']) !== TG_CP_PAY.no) return 'پیش‌پرداخت این نفر قبلاً ثبت شده و ' + tgCpS_(old['وضعیت']) + ' است.';
  var tr = tgCpTier_(camp);
  var pid = tgCpNext_(TG_CPP_TAB, 'کد پرداخت', 'PAY', 3);
  tgCpAdd_(TG_CPP_TAB, { 'کد پرداخت': pid, 'زمان ثبت': tgJDateFull_(new Date(), TG_TZ) + ' ' + Utilities.formatDate(new Date(), TG_TZ, 'HH:mm'),
    'کد درخواست': l.id, 'نام': l.name, 'chat_id': l.chat, 'کد کمپین': camp.code, 'نوع': TG_CP_KIND.pre,
    'پلهٔ قیمت': tr.label + ' · ' + tr.amount, 'مبلغ (تومان)': camp.prepay, 'توضیح پرداخت‌کننده': 'ثبت دستی ' + (actor || 'مدرسه'),
    'وضعیت': TG_CP_PAY.wait });
  tgSlSet_(row, { 'وضعیت پرداخت': TG_CP_KIND.pre + ' منتظر تأیید', 'پلهٔ قیمت': tr.label + ' · ' + tr.amount }, actor || 'مدرسه');
  tgSend_(TG_CP_YASER, '💳 <b>پرداخت تازه · ' + pid + '</b>\n' + tgEsc_(l.name) + ' · ' + camp.code + ' · ' + TG_CP_KIND.pre +
    '\nمبلغ: ' + tgCpMoney_(camp.prepay) + '\nثبت دستی توسط ' + tgEsc_(actor || 'مدرسه') + ' (خارج از بات)\n\nدر پنل پیکان ببینید و اینجا تأیید یا رد کنید.',
    { inline_keyboard: [[{ text: '✅ تأیید', callback_data: 'cp:y:' + pid + ':ok' }, { text: '❌ رد', callback_data: 'cp:y:' + pid + ':no' }]] });
  return 'ok';
}

/* ==================================================================
   v142 · تریگر onEdit هاب مدرسه (شیت ← بات)
   ================================================================== */
var TG_SCH_WATCH = { 13: 'وضعیت', 18: 'مرحلهٔ قیف', 19: 'مسئول پیگیری', 20: 'آخرین تماس',
                     21: 'نتیجهٔ آخرین تماس', 22: 'تاریخ روز باز', 23: 'تاریخ مصاحبه', 24: 'نتیجهٔ مصاحبه' };  /* v145 */
var TG_SCH_DATE_COLS = { 20: 1, 22: 1, 23: 1 };
var TG_SCH_TODAY = 'امروز';

function tgSlMark_(row) { if (!TG_DRY) { try { CacheService.getScriptCache().put('sledit' + row, '1', 90); } catch (e) {} } }
function tgSlMine_(row) { if (TG_DRY) return false; try { return !!CacheService.getScriptCache().get('sledit' + row); } catch (e) { return false; } }

function tgSchOnEdit_(e) {
  var rs0 = Date.now(); try {   /* v166.18: سنجش زمان اجرا (بدنه بی‌تغییر) */
  try {
    if (TG_DRY || !e || !e.range) return;
    /* v166.23 (E-1009): اگر تبِ ویرایش‌شده دیگر نیست (Sheet not found)، تب با اسم پیدا می‌شود، نه با شناسه */
    var sh = null, shName = '';
    try { sh = e.range.getSheet(); shName = sh.getName(); } catch (eSh) {
      try { sh = e.source && e.source.getActiveSheet(); shName = sh ? sh.getName() : ''; } catch (eSh2) { sh = null; }
    }
    if (!sh || !shName) return;
    if (shName === TG_SCH_T_REQ) { try { e.range = sh.getRange(e.range.getRow(), e.range.getColumn(), e.range.getNumRows(), e.range.getNumColumns()); } catch (eR) {} }
    if (shName !== TG_SCH_T_REQ) {
      /* v146: در بقیهٔ تب‌های هاب، «امروز» در ستون تاریخ به تاریخ شمسی امروز تبدیل می‌شود */
      try {
        if (e.range.getNumRows() === 1 && e.range.getNumColumns() === 1 && e.range.getRow() > 1) {
          var valT = String(e.value || e.range.getValue() || '').trim();
          if (/^(امروز|today|\.|1)$/i.test(valT)) {
            var hT = String(sh.getRange(1, e.range.getColumn()).getValue() || '');
            if (/تاریخ|زمان/.test(hT)) e.range.setValue(tgJDateFull_(new Date(), TG_TZ));
          }
        }
      } catch (eT) {}
      return;
    }
    var row = e.range.getRow(), nRows = e.range.getNumRows();
    if (row < 2 || nRows > 20) return;
    var c1 = e.range.getColumn(), c2 = c1 + e.range.getNumColumns() - 1, any = false;
    for (var c = c1; c <= c2; c++) if (TG_SCH_WATCH[c]) { any = true; break; }
    if (!any) return;
    var single = (nRows === 1 && c1 === c2);
    var actor = (e.user && String(e.user)) || 'شیت';
    for (var r = row; r < row + nRows; r++) {   /* v166.27 (گزارش ۳.۵): ویرایش دستی دیگر نادیده گرفته نمی‌شود؛ نوشتن اسکریپت onEdit را صدا نمی‌زند */
      tgSchEdited_(r, c1, c2, actor, single ? e.oldValue : undefined);
    }
  } catch (err) { try { tgErr_('tgSchOnEdit_: ' + err); } catch (e2) {} }
  } finally { tgRunStat_('tgSchOnEdit_', rs0); }
}

function tgSchEdited_(row, c1, c2, actor, oldValue) {
  var l = tgSlRead_(row);
  if (!l || (!l.name && !l.phone && !l.chat)) return;
  var code = l.code || tgSlCode_(row);
  var sh = tgSchSheet_(TG_SCH_T_REQ, TG_SCH_REQ_HEAD);
  var owners = tgSchoolOwners_();
  var tell = function (msg) { for (var i = 0; i < owners.length; i++) tgSend_(owners[i].chat, msg); };
  var today = tgJDateFull_(new Date(), TG_TZ);
  for (var c = c1; c <= c2; c++) {
    var field = TG_SCH_WATCH[c];
    if (!field) continue;
    var now = String(sh.getRange(row, c).getValue() || '').trim();
    /* v145: در ستون‌های تاریخ، «امروز» (یا هر چیزی مثل today/.) تاریخ شمسی امروز می‌شود */
    if (TG_SCH_DATE_COLS[c] && now && /^(امروز|today|\.|1)$/i.test(now)) {
      var chD = {}; chD[field] = today; tgSlSet_(row, chD, actor, { channel: 'شیت' });
      now = today;
      continue;
    }
    tgSchEv_({ code: code, row: row, actor: actor, channel: 'شیت', what: field, from: oldValue === undefined ? '' : oldValue, to: now });

    if (field === 'نتیجهٔ آخرین تماس' && now) {
      /* v145: نتیجهٔ تماس نوشته شد یعنی تماسی بوده: تاریخ امروز، مرحله دست‌کم «تماس اول»، مسئول اگر خالی بود */
      var chR = {};
      if (!l.touched) chR['آخرین تماس'] = today;
      if (!tgSchStageAtLeast_(l.stage, 'call') && l.camp) chR['مرحلهٔ قیف'] = TG_SCH_STAGES[TG_SCH_SG.call];
      if (!l.owner) { for (var oi = 0; oi < owners.length; oi++) if (tgNorm_(owners[oi].name) === tgNorm_(actor)) chR['مسئول پیگیری'] = owners[oi].name; }
      if (Object.keys(chR).length) tgSlSet_(row, chR, actor, { channel: 'شیت' });
    }

    if (field === 'تاریخ مصاحبه' && now) {
      if (!tgSchStageAtLeast_(l.stage, 'itv')) tgSlSet_(row, { 'مرحلهٔ قیف': TG_SCH_STAGES[TG_SCH_SG.itv] }, actor, { channel: 'شیت' });
    }

    if (field === 'نتیجهٔ مصاحبه' && now) {
      var chI = {};
      if (now === TG_CP_IV_RES.full) { chI['مرحلهٔ قیف'] = TG_SCH_STAGES[TG_SCH_SG.acc]; if (l.status === TG_SCH_ST_COND) chI['وضعیت'] = TG_SCH_ST_OPEN; }
      else if (now === TG_CP_IV_RES.cond) { chI['مرحلهٔ قیف'] = TG_SCH_STAGES[TG_SCH_SG.itv]; chI['وضعیت'] = TG_SCH_ST_COND; }
      else if (now === TG_CP_IV_RES.no) { chI['وضعیت'] = 'عدم پذیرش'; }
      else if (!tgSchStageAtLeast_(l.stage, 'itv')) chI['مرحلهٔ قیف'] = TG_SCH_STAGES[TG_SCH_SG.itv];
      if (Object.keys(chI).length) tgSlSet_(row, chI, actor, { channel: 'شیت' });
    }

    if (field === 'مسئول پیگیری' && now) {
      for (var j = 0; j < owners.length; j++) {
        if (tgNorm_(owners[j].name) === tgNorm_(now) && owners[j].chat) {
          tgSend_(owners[j].chat, '👥 لید مدرسه ' + tgEsc_(code) + ' در شیت به شما واگذار شد.');
          tgSlCardSend_(owners[j].chat, row);
        }
      }
    }

    if (field === 'وضعیت') {
      var nz = tgSchStNorm_(now);
      if (nz.changed) {
        tgSlSet_(row, { 'وضعیت': nz.st }, 'بات');
        tell((nz.known ? 'ℹ️' : '⚠️') + ' وضعیت لید ' + tgEsc_(code) + ' در شیت «' + tgEsc_(now) + '» نوشته شد که در فهرست نیست؛ به «' + tgEsc_(nz.st) + '» برگرداندم.\nوضعیت‌ها: ' + TG_SCH_ST.join(' · '));
      }
      if (nz.st === TG_SCH_ST_DONE) { try { tgSchEnroll_(row, actor); } catch (eE) { tgErr_('tgSchEnroll_ از شیت: ' + eE); } }
      else if (tgSchClosed_(nz.st)) tell('✅ لید مدرسه ' + tgEsc_(code) + ' (' + tgEsc_(l.name) + ') در شیت بسته شد: ' + tgEsc_(nz.st));
    }

    if (field === 'مرحلهٔ قیف') {
      var sz = tgSchStageNorm_(now);
      if (sz.changed) {
        tgSlSet_(row, { 'مرحلهٔ قیف': sz.st }, 'بات', { stageBack: true });
        tell((sz.known ? 'ℹ️' : '⚠️') + ' مرحلهٔ لید ' + tgEsc_(code) + ' «' + tgEsc_(now) + '» در فهرست نیست؛ به «' + tgEsc_(sz.st) + '» برگرداندم.\nمرحله‌ها: ' + TG_SCH_STAGES.join(' ← '));
      }
      if (sz.st === TG_SCH_STAGES[TG_SCH_SG.done] && l.status !== TG_SCH_ST_DONE) { try { tgSchEnroll_(row, actor); } catch (eE2) { tgErr_('tgSchEnroll_ از مرحله: ' + eE2); } }
    }
  }
}

/* یک بار اجرا: تریگر onEdit هاب مدرسه + فهرست کشویی وضعیت و مرحله + تب رویداد (تکرارش بی‌ضرر) */
function tgSchEditSetup() {
  var all = ScriptApp.getProjectTriggers();
  for (var i = 0; i < all.length; i++) if (all[i].getHandlerFunction() === 'tgSchOnEdit_') ScriptApp.deleteTrigger(all[i]);
  ScriptApp.newTrigger('tgSchOnEdit_').forSpreadsheet(TG_SCHOOL_SHEET_ID).onEdit().create();
  tgSchEvSheet_();
  var sh = tgSchSheet_(TG_SCH_T_REQ, TG_SCH_REQ_HEAD);
  tgSchHeadFix_(TG_SCH_T_REQ, TG_SCH_REQ_HEAD);
  tgSchCodesRebuild();
  tgSchValidations_();
  Logger.log('تریگر onEdit هاب مدرسه نصب شد · فهرست‌های کشویی از تب کدها · تب رویدادهای مدرسه آماده است.');
  return 'ok';
}

/* ==================================================================
   v143 · تب «لیدهای مدرسه» (نام تازهٔ «درخواست عضویت»)، نمای مسئول مدرسه، کارتابل مدرسه
   ================================================================== */
/* یک بار: تب قدیمی را به نام تازه برمی‌گرداند. اگر نام تازه هست، دست نمی‌زند. */
function tgSchRenameReq_() {
  if (TG_DRY) return 'dry';
  var ss = tgSchSS_();
  if (ss.getSheetByName(TG_SCH_T_REQ)) return 'هست';
  var old = ss.getSheetByName(TG_SCH_T_REQ_OLD);
  if (!old) return 'تب قدیمی پیدا نشد';
  old.setName(TG_SCH_T_REQ);
  tgSchDropCache_();
  return 'تغییر نام: ' + TG_SCH_T_REQ_OLD + ' ← ' + TG_SCH_T_REQ;
}

/* ستون‌های فنی که مسئول مدرسه لازم ندارد (با شماره؛ بات همچنان با ایندکس می‌خواند) */
var TG_SCH_VIEW_HIDE = [4, 5, 6, 8, 11, 14, 15, 25, 28];
var TG_SCH_VIEW_WORK = [13, 18, 19, 20, 21];
var TG_SCH_VIEW_NOTE = {
  13: 'وضعیت پرونده. از فهرست انتخاب کنید. «ثبت‌نام قطعی» سطر عضویت دانشجو را خودکار می‌سازد.',
  18: 'کجای مسیر است. فقط جلو می‌رود؛ از فهرست انتخاب کنید.',
  19: 'چه کسی پیگیری می‌کند. اسم کامل بنویسید تا کارت در بات به او برسد.',
  20: 'تاریخ آخرین تماس (شمسی، مثل ۵ مهر ۱۴۰۵).',
  21: 'چه شد: صحبت شد · پاسخ نداد · شمارهٔ اشتباه · تماس دوباره …'
};
function tgSchLeadView_() {
  if (TG_DRY) return 'dry';
  var sh = tgSchSheet_(TG_SCH_T_REQ, TG_SCH_REQ_HEAD);
  var n = Math.max(sh.getMaxRows() - 1, 1), i;
  sh.setRightToLeft(true);
  for (i = 0; i < TG_SCH_VIEW_HIDE.length; i++) { try { sh.hideColumns(TG_SCH_VIEW_HIDE[i]); } catch (e) {} }
  for (i = 0; i < TG_SCH_VIEW_WORK.length; i++) {
    var c = TG_SCH_VIEW_WORK[i];
    sh.getRange(1, c).setBackground('#d7334b').setFontColor('#ffffff').setFontWeight('bold');
    sh.getRange(2, c, n, 1).setBackground('#fff4f5');
    if (TG_SCH_VIEW_NOTE[c]) { try { sh.getRange(1, c).setNote(TG_SCH_VIEW_NOTE[c]); } catch (e2) {} }
    sh.setColumnWidth(c, c === 21 ? 160 : 140);
  }
  sh.setColumnWidth(3, 170); sh.setColumnWidth(9, 120); sh.setColumnWidth(12, 220); sh.setColumnWidth(16, 220);
  try { sh.getRange(2, 12, n, 1).setWrapStrategy(SpreadsheetApp.WrapStrategy.CLIP); } catch (e3) {}
  try { sh.getRange(2, 16, n, 1).setWrapStrategy(SpreadsheetApp.WrapStrategy.CLIP); } catch (e4) {}
  sh.setFrozenRows(1);
  try { sh.setFrozenColumns(3); } catch (e5) {}
  return 'نمای ' + tgNm_('school') + ' روی «' + TG_SCH_T_REQ + '»: ' + TG_SCH_VIEW_HIDE.length + ' ستون فنی مخفی، ' + TG_SCH_VIEW_WORK.length + ' ستون کار رنگی';
}

/* کارتابل مدرسه: فقط فرمول روی تب اصلی. مثل «کارتابل پیگیری» هاب پذیرش. */
var TG_SCH_DESK_TAB = 'کارتابل مدرسه';
var TG_SCH_DESK_ACT = [
  ['ثبت‌نام وبینار', '☎ تماس اول: معرفی دوره و دعوت به درخواست'],
  ['حاضر در وبینار', '☎ تماس اول: نظرش دربارهٔ وبینار، دعوت به درخواست دوره'],
  ['لید مدرسه', '☎ تماس اول'],
  ['تماس اول', '↻ پیگیری تا به «درخواست دوره» برسد'],
  ['درخواست دوره', '💳 پیگیری پیش‌پرداخت (لینک پرداخت)'],
  ['پیش‌پرداخت', '🗓 هماهنگی وقت مصاحبه'],
  ['مصاحبه', '⏳ منتظر نتیجهٔ مصاحبه؛ اگر شد، مرحله «پذیرش»'],
  ['پذیرش', '🎓 ماندهٔ شهریه، بعد «ثبت‌نام قطعی»']
];
function tgSchDeskRebuild() {
  if (TG_DRY) return 'dry';
  var ss = tgSchSS_();
  var sh = ss.getSheetByName(TG_SCH_DESK_TAB);
  if (!sh) { sh = ss.insertSheet(TG_SCH_DESK_TAB, 1); }
  sh.setRightToLeft(true);
  sh.clear();

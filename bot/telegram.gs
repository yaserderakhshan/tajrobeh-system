function tgThYears_(since) {
  var y = Number(tgLatinDigits_(String(since || '')).replace(/[^0-9]/g, '').slice(0, 4));
  if (!y) return 0;
  if (y > 1900) y -= 621;
  var now = 1405;
  try { now = tgJalali_(new Date(), TG_TZ).y; } catch (e) {}
  var d = now - y;
  return d >= 1 && d < 60 ? d : 0;
}
function tgThPqMap_() {

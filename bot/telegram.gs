function tgLogStart_(code, chat) {
  if (!code || TG_DRY) return;
  try {
    var sh = tgSS_().getSheetByName('کلیک‌های تماس');
    if (!sh) return;
    var now = new Date();
    sh.appendRow([Utilities.formatDate(now, TG_TZ, 'yyyy-MM-dd'),
      Utilities.formatDate(now, TG_TZ, 'HH:mm'), 'بات تلگرام',
      (code.indexOf('ig_') === 0 ? 'اینستاگرام › بات › ' : 'سایت › بات › ') + tgStartLabel_(code), tgStartLabel_(code), '', code]);
  } catch (e) { tgErr_('tgLogStart_: ' + e); }
  try { if (typeof v1689StartUtm_ === 'function') v1689StartUtm_(code); } catch (eU) { tgErr_('v1689StartUtm_', eU); }   /* v168.9 */
}

function tgSchoolStart_(chat, arg, uname) {
  if (!arg) return false;
  // v122: کمپین ثبت‌نام (cp_/web_/app_/pre_ و کلید دوره مثل eft)
  if (typeof tgCpStart_ === 'function') { try { if (tgCpStart_(chat, String(arg), uname)) return true; } catch (eCp) { tgErr_('tgCpStart_: ' + eCp); } }
  // v95: کد دعوت اختصاصی استاد و سوپروایزر، پیش از هر تشخیص دیگری
  if (String(arg).indexOf('tea-') === 0 && typeof tgTeaConnect_ === 'function') {
    try { tgLogStart_(arg, chat); } catch (eT0) {}
    if (tgTeaConnect_(chat, String(arg).slice(4), '')) return true;
    return false;
  }
  if (arg === 'alum' && typeof tgAlStart_ === 'function') { tgAlStart_(chat, ''); return true; }
  if (arg === 'apply' && typeof tgApStart_ === 'function') { tgApStart_(chat, uname || ''); return true; }
  if (String(arg).indexOf('sv-') === 0 && typeof tgApSvOpen_ === 'function') { return tgApSvOpen_(chat, String(arg).slice(3), uname || ''); }
  if (arg === 'partner' && typeof tgPnStart_ === 'function') { tgPnStart_(chat, uname || ''); return true; }
  if (arg === 'onboard' && typeof tgObStart_ === 'function') { tgObStart_(chat, '', null); return true; }
  if (arg === 'ivslots' && typeof tgApIvEntry_ === 'function') { return tgApIvEntry_(chat, uname || ''); }
  if (arg === 'prereg' && typeof tgPzStart_ === 'function') { tgPzStart_(chat, ''); return true; }
  tgLogStart_(arg, chat);
  tgSetVal_('esrc', chat, arg);
  if (arg === 'edu' || arg === 'edu_s' || arg === 'edu_t') { tgEduSignup_(chat); return true; }
  if (arg === 'join' || arg === 'sch_join') { tgSjStart_(chat, ''); return true; }
  if (arg === 'comm' || arg === 'community') { tgCommStart_(chat, ''); return true; }
  if (arg === 'page') { tgPqEntry_(chat, 'W'); return true; }
  if (arg === 'work') { tgPqEntry_(chat, 'K'); return true; }
  if (arg === 'uni') { tgPqEntry_(chat, 'D'); return true; }
  if (arg === 'ev' || arg.indexOf('ev_') === 0) { tgEvList_(chat, ''); return true; }
  if (arg.indexOf('pt_') === 0 && typeof tgPtStart_ === 'function') {
    try { if (tgPtStart_(chat, String(arg))) return true; } catch (ePt) { tgErr_('tgPtStart_: ' + ePt); }
  }
  if (arg.indexOf('tm-') === 0 && typeof tgTeamStart_ === 'function') { try { tgTeamStart_(chat, arg.slice(3)); } catch (eTm) { tgErr_('tm: ' + eTm); } }
  return false;
}

function tgSchoolRoute_(chat, role, text, m) {
  if (TG_SCH_ROLES.indexOf(role) < 0) return false;
  var s = String(text || '').trim();
  if (tgFlag_('ecircle', chat) && tgSetCircle_(chat, s)) return true;
  if (tgFlag_('eev', chat) && tgEvPick_(chat, s)) return true;
  if (tgFlag_('esup', chat) && tgSupPick_(chat, s)) return true;
  if (!s || s === '↩️ بازگشت' || s === 'بازگشت') {
    tgDel_('eev', chat); tgDel_('esup', chat);
    tgSend_(chat, 'منوی ' + role, tgSchoolMenu_(role));
    return true;
  }
  if (s === TG_PQ_BTN || s === '/page') { tgPqEntry_(chat, 'W'); return true; }
  if (s === TG_PQK_BTN || s === '/work') { tgPqEntry_(chat, 'K'); return true; }
  if (s === TG_PQ_UBTN || s === '/uni') { tgPqEntry_(chat, 'D'); return true; }
  if (s.indexOf('برنامهٔ حلقهٔ من') > -1 || s.indexOf('برنامهٔ من') > -1) { tgMyCal_(chat, role); return true; }
  if (s.indexOf('برنامه‌های عمومی') > -1) { tgPublicCal_(chat, role); return true; }
  if (s.indexOf('رویدادها') > -1) { tgEvList_(chat, role); return true; }
  if (s.indexOf('پذیرش سوپرویژن') > -1) { tgSupToggle_(chat); return true; }
  if (s.indexOf('سوپرویژن') > -1) { tgSupAsk_(chat); return true; }
  if (s.indexOf('پیام به مدرسه') > -1) {
    tgSend_(chat, 'پیامتان را به @Tajrobeh_school بدهید، همان‌جا پیگیری می‌شود.', tgSchoolMenu_(role));
    return true;
  }
  tgSend_(chat, 'از منوی پایین یکی را بزنید.', tgSchoolMenu_(role));
  return true;
}

function tgSchoolTests() {
  var out = [], pass = 0, fail = 0;
  function ok(n, c) { c ? pass++ : fail++; out.push((c ? '✅ ' : '❌ ') + n); }
  ok('حلقهٔ ۱۵/۱', tgCircleKey_('۱۵/۱') === '15/1');
  ok('حلقهٔ ۱۳', tgCircleKey_('۱۳') === '13');
  ok('حلقهٔ نامشخص', tgCircleKey_('۷ تا ۱۲ (نامشخص)') === '');
  ok('حلقهٔ خالی', tgCircleKey_('') === '');
  ok('هر حلقه کلندر دارد', TG_CIRCLES.every(function (c) { return !!TG_CIRCLE_CAL[tgCircleKey_(c)]; }));
  ok('نقش‌های مدرسه در TG_ROLES', TG_SCH_ROLES.every(function (r) { return TG_ROLES.indexOf(r) > -1; }));
  ok('هر نقش دکمهٔ رویداد دارد', TG_SCH_ROLES.every(function (r) {
    return JSON.stringify(tgSchoolMenu_(r)).indexOf('رویدادها') > -1; }));
  ok('سوپروایزر دکمهٔ پذیرش دارد', JSON.stringify(tgSchoolMenu_('سوپروایزر')).indexOf('پذیرش سوپرویژن') > -1);
  ok('دانشجو دکمهٔ پذیرش ندارد', JSON.stringify(tgSchoolMenu_('دانشجو')).indexOf('پذیرش سوپرویژن') < 0);
  ok('نگاشت کد شروع', tgStartLabel_('pt_de').indexOf('آلمان') > -1 && tgStartLabel_('mag_x').indexOf('مجله') > -1);
  ok('کد کشور خارج', typeof tgPtStart_ === 'function' && TG_PT_NAME.pt_de === 'آلمان' && tgStartLabel_('pt_ca').indexOf('کانادا') > -1);
  ok('نقش بی‌ربط رد می‌شود', tgSchoolRoute_(1, 'پذیرش', 'هرچیزی', null) === false);
  ok('متن‌ها خط تیره ندارند', [T_EDU_ASK, T_EDU_NONE, T_CIRCLE_OK, T_SUP_NONE, T_EV_OK].every(function (t) {
    return t.indexOf('—') < 0; }));
  ok('تب رویدادها هست', !!tgSchSS_().getSheetByName(TG_EV_TAB));
  ok('رویداد ناموجود از فرم رد می‌شود', tgEvFromForm_({ event: 'یک چیز بی‌معنی ۹۹۹' }).ok === false);
  ok('ستون رویکرد در هدر افراد', TG_PEOPLE_HEAD.indexOf('رویکرد') > -1);
  Logger.log(out.join('\n'));
  Logger.log('نتیجه: ' + pass + ' قبول · ' + fail + ' مردود');
  return { pass: pass, fail: fail, text: out.filter(function (l) { return l.indexOf('❌') === 0; }).join('\n') };
}


/* v170.9.2: دادهٔ دکمه با بایت سنجیده می‌شود، نه نویسه (هر حرف فارسی در UTF-8 دو بایت است). دادهٔ بلندتر از ۶۴ بایت
   (مثلاً «rf:p:L-1234:» با نام کامل فارسی درمانگر) یک کد کوتاه لاتین «h:…» می‌گیرد و متن کامل در Script Property «CBH_<کد>»
   می‌ماند؛ tgOnCallback_ و tgApiC_ پیش از هر کار کد را به همان دادهٔ کامل برمی‌گردانند. همان داده همیشه همان کد را می‌گیرد. */
var TG_CB_MEM = {};
function tgCbBytes_(s) { return Utilities.newBlob(String(s == null ? '' : s)).getBytes().length; }
function tgCbShort_(d) {
  d = String(d == null ? '' : d);
  var n = tgCbBytes_(d);
  if (n >= 1 && n <= 64) return d;
  if (!n) return d;   /* خالی: tgBtnCheck_ گزارش می‌دهد */
  var dg = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, d, Utilities.Charset.UTF_8), h = '';
  for (var i = 0; i < 9; i++) h += ('0' + ((dg[i] + 256) % 256).toString(16)).slice(-2);
  var k = 'h:' + h;
  if (TG_DRY) { TG_CB_MEM[k] = d; return k; }
  try {
    var P = PropertiesService.getScriptProperties();
    if (P.getProperty('CBH_' + h) === null) {
      P.setProperty('CBH_' + h, JSON.stringify({ d: d, t: Date.now() }));
      if (Math.random() < 0.02) tgCbPrune_(P);

  if (roles.length > 1) {
    if (text.indexOf('تغییر نقش') > -1 || tgCmd_(text) === '/role') {
      tgDel_('role', chat); tgDel_('esign', chat); tgDel_('ecircle', chat);
      tgDel_('eev', chat); tgDel_('esup', chat);
      return tgRolePick_(chat, roles);
    }
    let act = tgGetVal_('role', chat);
    if (roles.indexOf(act) < 0) act = '';
    if (!act) {
      const pick = tgRoleByLabel_(text, roles);
      if (pick) { tgSetVal_('role', chat, pick); act = pick; }
      else {
        // فقط یک نقش کاری دارد: همان پیش‌فرض است و سؤالی پرسیده نمی‌شود
        const work = roles.filter(function (r) { return r !== 'مراجع'; });
        if (work.length === 1) { act = work[0]; tgSetVal_('role', chat, act); }
        else return tgRolePick_(chat, roles);
      }
      if (act !== 'مراجع') return tgRoleRoute_(chat, act, pick ? '' : text, m);
    }
    if (act !== 'مراجع') return tgRoleRoute_(chat, act, text, m);
    asClient = true;
  }

  if (!asClient && typeof tgSchoolRoute_ === 'function' &&
      tgSchoolRoute_(chat, roles[0], text.indexOf('/start') === 0 ? '' : text, m)) return;

  const watch = (!asClient && roles.indexOf('ناظر') > -1) ? tgWhoWatch_(chat, uname0) : null;
  if (watch) return tgWatchRoute_(chat, watch, text);

  const desk = (!asClient && roles.indexOf('پذیرش') > -1) ? tgWhoDesk_(chat, uname0) : null;
  if (desk) return tgDeskRoute_(chat, desk, text.indexOf('/start') === 0 ? '' : text);

  if (!asClient && text.indexOf('/start') !== 0) {
    const who = tgWhoTherapist_(chat);
    if (who) return tgTherRoute_(chat, who, text, m);
  }

  if (tgIsCrisis_(text)) return tgOnCrisis_(chat, name, uname, text);

  if (text === T_NOT_THER) { tgDel_('sign', chat); tgDel_('tsg', chat); return tgWelcome_(chat); }

  // v164: منتظر شمارهٔ درمانگر برای تأیید اتصال
  if (tgGetVal_('tsg', chat) && text.indexOf('/') !== 0) {
    if (text === '↩️ بازگشت') { tgDel_('tsg', chat); return tgWelcome_(chat); }
    return tgSend_(chat, T_SIGN_PHONE_AGAIN, tgSignPhoneKb_());
  }

  // اسمش را نوشته بدون اینکه از لینک کانال آمده باشد
  if (!tgGetVal_('sign', chat) && text.indexOf('/') !== 0 &&
      text.length >= 5 && text.length <= 40 && !/[0-9\u06F0-\u06F9]/.test(text)) {
    const hit = tgTherFind_(text, true);
    if (hit.length) {
      tgSetFlag_('sign', chat, 1800);
      const rows = [];
      for (var z0 = 0; z0 < Math.min(hit.length, 8); z0++) rows.push([hit[z0].name]);
      rows.push([T_NOT_THER]);
      return tgSend_(chat, T_SIGN_CONFIRM, { keyboard: rows, resize_keyboard: true });
    }
  }

  // ثبت‌نام خودسرویس درمانگر
  if (tgGetVal_('sign', chat) && text.indexOf('/') !== 0 &&
      text !== T_NOT_THER && !tgIsBtnLike_(text)) return tgTherSignupName_(chat, text);

  const cmd = tgCmd_(text);

  if (cmd === '/start') {
    const arg = text.replace(/^\/start(@\w+)?/, '').trim();
    if (arg === 'ther' || arg === 'therapist') return tgTherSignup_(chat);
    if (arg === 'style' || arg === 'test') return tgStyleStart_(chat);
    if (arg === 'content' || arg === 'feed') return tgFeedMenu_(chat, name, uname);
    if (typeof tgMigStartArg_ === 'function' && tgMigStartArg_(chat, arg)) return;   /* v166.28: تست مهاجرت */
    if (typeof tgArtStart_ === 'function' && tgArtStart_(chat, arg, name, uname)) return;
    if (typeof tgGtStart_ === 'function' && tgGtStart_(chat, arg, name, uname)) return;
    if (arg && arg !== 'group') return tgLinkTherapist_(chat, arg);
    const meT = tgWhoTherapist_(chat);
    if (meT) { tgSend_(chat, T_THER_MENU, tgTherMenu_()); if (typeof migTherNudge_ === 'function') migTherNudge_(chat); return; }
    return tgWelcome_(chat);
  }

  if (cmd === '/cancel' || text === '↩️ بازگشت' || text === 'بازگشت' || text === 'شروع')
    return tgSend_(chat, 'برگشتیم به منوی اصلی.', tgMenu_());

  // یادداشت اختیاری بعد از ثبت شماره. قبل از چک‌های کلیدواژه‌ای تا جمله‌ای با «همکار» یا «مدرسه» از مسیر پرت نشود
  if (tgFlag_('wftxt', chat) && !tgIsBtnLike_(text)) return tgWfText_(chat, text);
  if (tgFlag_('emask', chat) && !tgIsBtnLike_(text)) return tgSaveEmail_(chat, text);
  if (tgFlag_('ft', chat) && !tgIsBtnLike_(text) && !tgLooksLikePhone_(text)) return tgSaveNote_(chat, text);

  if (cmd === '/style'    || text.indexOf('سبک درمانی') > -1)    return tgStyleStart_(chat);
  if (typeof tgMigStart_ === 'function' && (cmd === '/migration' || text === TG_MIG_BTN)) return tgMigStart_(chat, 'بات');   /* v166.28 */
  if (typeof tgMigTests_ === 'function' && (cmd === '/tests' || text === 'تست‌ها')) return tgMigTests_(chat);
  if (cmd === '/content'  || text.indexOf('محتوای تجربه') > -1)  return tgFeedMenu_(chat, name, uname);
  if (cmd === '/first' || text.indexOf('رزرو جلسهٔ درمان') > -1 || text.indexOf('رزرو جلسه درمان') > -1) return tgSessStart_(chat);
  if (cmd === '/therapy'  || text.indexOf('شروع درمان') > -1)   return tgQuizTopic_(chat);
  if (cmd === '/faq'      || text.indexOf('متداول') > -1)        return tgFaqMenu_(chat);
  if (cmd === '/services' || text.indexOf('خدمات') > -1)         return tgSend_(chat, T_SERVICES, tgMenu_());
  if (cmd === '/outside'  || text.indexOf('خارج از ایران') > -1) return tgOutside_(chat);
  if (cmd === '/mymeet'   || text.indexOf('وقت معارفهٔ من') > -1 || text.indexOf('وقت معارفه من') > -1)
    return tgMyMeeting_(chat);
  if (cmd === '/about'    || text.indexOf('دربارهٔ تجربه') > -1 || text.indexOf('درباره تجربه') > -1)
    return tgSend_(chat, T_ABOUT, tgMenu_());
  if (cmd === '/school'   || text.indexOf('مدرسه') > -1)
    return tgSend_(chat, T_SCHOOL, tgSchoolPubKb_());
  if (cmd === '/human'    || text.indexOf('همکار') > -1)         return tgOnHuman_(chat, name, uname);

  if (tgFlag_('await', chat)) return tgSaveAvail_(chat, text);

  if (tgLooksLikePhone_(text)) return tgOnPhone_(chat, name, uname, text);

  if (tgHasAbroad_(text)) return tgOutside_(chat);

  const hit = tgFaqMatch_(text, 0.34);
  if (hit) {
    return tgSend_(chat, '❓ <b>' + tgEsc_(hit.q) + '</b>\n\n' + tgEsc_(hit.a), {
      inline_keyboard: [
        [{ text: '❓ سؤال‌های دیگر', callback_data: 'f:0' }],
        [{ text: '📞 صحبت با همکار', callback_data: 'hm' }]
      ]
    });
  }
  tgSend_(chat, T_FALLBACK, tgMenu_());
}

function tgLooksLikePhone_(text) {
  const t = tgLatinDigits_(text).trim();
  if (/[\u0600-\u06FF]{3,}/.test(t.replace(/\s/g, ''))) return false;
  const d = t.replace(/\D/g, '');
  return d.length >= 10 && d.length <= 15 && /^[\s+\-()\d]+$/.test(t);
}

/* ---------- گروه ---------- */

function tgGroup_(m) {
  const chat = m.chat.id;
  if (m.from && m.from.is_bot) return;              // به بات‌های دیگر جواب نده
  const text = (m.text || m.caption || '').trim();
  if (!text) return;

  const me = tgBotName_();
  const mentioned = !!(me && text.toLowerCase().indexOf('@' + me.toLowerCase()) > -1);
  const replied = !!(m.reply_to_message && m.reply_to_message.from && m.reply_to_message.from.is_bot &&
                     me && m.reply_to_message.from.username &&
                     m.reply_to_message.from.username.toLowerCase() === me.toLowerCase());

  if (tgCrisisStrong_(text)) {
    if (!tgCooldown_('crisis' + chat, 600)) tgSend_(chat, T_CRISIS_GROUP, null, m.message_id);
    return;
  }

  const clean = tgNorm_(me ? text.replace(new RegExp('@' + me, 'ig'), ' ') : text);
  const isQuestion = /[؟?]/.test(text) || /(چطور|چگونه|چقدر|ایا|چه|کجا|میشه|می شه|می‌شه)/.test(clean);

  if (mentioned || replied) {
    const hit = tgFaqMatch_(clean, 0.28);
    if (hit) {
      return tgSend_(chat, '❓ <b>' + tgEsc_(hit.q) + '</b>\n\n' + tgEsc_(hit.a) + T_GROUP_TAIL,
                     tgPrivateBtn_(), m.message_id);
    }
    return tgSend_(chat, T_GROUP_PRIVATE, tgPrivateBtn_(), m.message_id);
  }

  if (!isQuestion) return;
  if (text.length > 400) return;                 // متن بلند درددل است نه سؤال
  if (!tgHasStrongTopic_(clean)) return;
  const strong = tgFaqMatch_(clean, 0.5);
  if (!strong) return;
  if (tgCooldown_('grp' + chat, 900)) return;

  tgSend_(chat, '❓ <b>' + tgEsc_(strong.q) + '</b>\n\n' + tgEsc_(strong.a) + T_GROUP_TAIL,
          tgPrivateBtn_(), m.message_id);
}

function tgPrivateBtn_() {
  const me = tgBotName_() || 'tajrobehlife_bot';
  return { inline_keyboard: [[{ text: '💬 گفت‌وگوی خصوصی با بات', url: 'https://t.me/' + me + '?start=group' }]] };
}

function tgHasAbroad_(text) {
  const t = tgNorm_(text);
  for (var i = 0; i < TG_ABROAD_WORDS.length; i++) {
    if (t.indexOf(tgNorm_(TG_ABROAD_WORDS[i])) > -1) return true;
  }
  return false;
}


/* ---------- ثبت‌نام خودسرویس درمانگر (بدون ارسال لینک تکی از پذیرش) ---------- */


// با ثبت لینک جلسه، درمانگر عملاً اعلام آمادگی کرده — واردش کن به استخر خودرزرو
function tgPoolIn_(who) {
  try {
    if (TG_DRY || String(who.pool || '').trim()) return;
    tgSS_().getSheetByName(TG_THER).getRange(who.row, TG_C_POOL).setValue('بله');
    CacheService.getScriptCache().removeAll(['tmap', 'tinfo']);
  } catch (e) { tgErr_('tgPoolIn_: ' + e); }
}

function tgTherSignup_(chat) {
  if (tgWhoTherapist_(chat)) { tgSend_(chat, T_THER_MENU, tgTherMenu_()); return; }
  tgSetVal_('sign', chat, '1');
  tgSend_(chat, T_SIGN_ASK, { keyboard: [['↩️ بازگشت']], resize_keyboard: true });
}

function tgTherSignupName_(chat, text) {
  const q = tgNorm_(text);
  if (!q || q.length < 3) return tgSend_(chat, T_SIGN_SHORT);

  const list = tgTherapistRows_();
  const exact = [], part = [], word = [];
  const w = q.split(' ').filter(function (x) { return x.length > 2; });

  for (var i = 0; i < list.length; i++) {
    const n = tgNorm_(list[i].name);
    if (!n) continue;
    if (n === q) { exact.push(list[i]); continue; }
    if (n.indexOf(q) > -1 || q.indexOf(n) > -1) { part.push(list[i]); continue; }
    if (w.length > 1) {
      var all = true;
      for (var k = 0; k < w.length; k++) if (n.indexOf(w[k]) < 0) { all = false; break; }
      if (all) word.push(list[i]);
    }
  }

  const hits = exact.length ? exact : (part.length ? part : word);
  if (!hits.length) return tgSend_(chat, T_SIGN_NONE);

  if (hits.length > 1) {
    const rows = [];
    for (var z = 0; z < Math.min(hits.length, 8); z++) rows.push([hits[z].name]);
    rows.push(['↩️ بازگشت']);
    return tgSend_(chat, T_SIGN_PICK, { keyboard: rows, resize_keyboard: true });
  }
  return tgTherConnect_(chat, hits[0]);
}

/* v164: پیش از وصل‌کردن، هویت با شمارهٔ خودِ حساب تلگرام تأیید می‌شود.
   ریشهٔ خطای اتصال یک درمانگر به پروندهٔ همکار هم‌نام (مهر ۱۴۰۵): اتصال فقط با انتخاب اسم از فهرست بود
   و هیچ نشانهٔ دیگری (شماره، نام تلگرام) چک نمی‌شد؛ یک لمس اشتباه روی اسم همکار هم‌نام کافی بود. */
function tgTherConnect_(chat, row) {
  if (tgChatIn_(row.chat, chat)) return tgTherConnectNow_(chat, row, '', 'اتصال دوباره');
  tgDel_('sign', chat);
  tgSetVal_('tsg', chat, row.name);
  return tgSend_(chat, T_SIGN_PHONE.replace('{name}', tgEsc_(row.name)), tgSignPhoneKb_());
}

function tgSignPhoneKb_() {
  return { keyboard: [[{ text: '📱 فرستادن شمارهٔ همین حساب', request_contact: true }], ['↩️ بازگشت']], resize_keyboard: true, one_time_keyboard: true };
}

/* شماره‌هایی که برای این نام در پرونده داریم (ستون شمارهٔ کاری درمانگران + تب افراد) */
function tgTherPhones_(name) {
  if (TG_DRY) return ((TG_MEM['tphones'] || {})[name] || []).map(tgPhoneKey_).filter(String);
  var out = [];
  try {
    var r = tgTherRow_(name);
    if (r) { var k0 = tgPhoneKey_(tgSS_().getSheetByName(TG_THER).getRange(r, TG_C_WPHONE).getValue()); if (k0) out.push(k0); }
  } catch (e) {}
  try {
    tgPeopleList_().forEach(function (p) {
      if (!tgSameName_(p.name, name)) return;
      var k = tgPhoneKey_(p.phone);
      if (k && out.indexOf(k) < 0) out.push(k);
    });
  } catch (e) {}
  return out;
}

/* این شماره در پرونده مال کدام درمانگر است؟ */
function tgTherByPhone_(pk) {
  if (!pk) return null;
  var list = tgTherapistRows_();
  for (var i = 0; i < list.length; i++) {
    if (tgTherPhones_(list[i].name).indexOf(pk) > -1) return list[i];
  }
  return null;
}

function tgTherSignPhone_(chat, m, name, uname) {
  var ct = m.contact || {};
  if (ct.user_id && m.from && String(ct.user_id) !== String(m.from.id)) return tgSend_(chat, T_SIGN_OWN, tgSignPhoneKb_());
  var want = String(tgGetVal_('tsg', chat) || '');
  tgDel_('tsg', chat);
  var pk = tgPhoneKey_(ct.phone_number);
  var list = tgTherapistRows_(), row = null;
  for (var i = 0; i < list.length; i++) if (list[i].name === want) { row = list[i]; break; }
  if (!row || !pk) return tgSend_(chat, T_SIGN_NONE, tgMenu_());
  var who = name + (uname ? ' ' + uname : '');
  var exp = tgTherPhones_(want);
  /* v166.21 (بند ۲.۵): هیچ حسابی با نام و شماره خودکار وصل نمی‌شود؛ فقط درخواست اتصال ساخته می‌شود و
     پذیرش یا یاسر با یک لمس تأیید یا رد می‌کنند. تا تأیید، chat_id در پرونده نمی‌نشیند و هیچ دادهٔ مراجعی به این حساب نمی‌رود. */
  if (exp.indexOf(pk) > -1) return tgTqRequest_(chat, { k: 't', name: want, who: who, chk: 'ok' });
  var other = tgTherByPhone_(pk);
  if (other && other.name !== want) return tgTqRequest_(chat, { k: 't', name: other.name, want: want, who: who, chk: 'other' });
  if (exp.length) return tgTqRequest_(chat, { k: 't', name: want, who: who, chk: 'bad' });
  return tgTqRequest_(chat, { k: 't', name: want, who: who, chk: 'none', ph: '+' + String(ct.phone_number).replace(/^\+/, '') });
}

function tgTherConnectNow_(chat, row, who, how) {
  const cur = String(row.chat || '').trim();
  const ids = cur ? cur.split(/[,،;\s]+/).filter(String) : [];
  const me = String(chat);
  const already = ids.indexOf(me) > -1;
  if (!already && ids.length >= 3) return tgSend_(chat, T_SIGN_TAKEN, tgMenu_());
  const others = ids.filter(function (x) { return x !== me; });
  const val = already ? cur : ids.concat([me]).join(',');

  if (!TG_DRY) {
  const sh = tgSS_().getSheetByName(TG_THER);
  tgChatCellSet_(sh.getRange(row.row, TG_C_CHAT), val);
  sh.getRange(row.row, 25).setValue('وصل شد ✅ ' + Utilities.formatDate(new Date(), TG_TZ, 'yyyy-MM-dd HH:mm'));
  try { CacheService.getScriptCache().removeAll(['tmap', 'tinfo']); } catch (e) {}
  }
  tgDel_('sign', chat);
  if (who) { try { tgDeskSay_('🔗 ' + tgEsc_(row.name) + ' به بات وصل شد · حساب تلگرام: ' + tgEsc_(who) + (how ? ' · ' + tgEsc_(how) : '')); } catch (e) {} }

  tgSend_(chat, T_SIGN_OK.replace('{name}', tgEsc_(row.name)), tgTherMenu_());
  if (!String(row.meet || '').trim()) tgSend_(chat, T_THER_ASK_MEET);
  for (var q = 0; q < others.length; q++) {
    try { tgSend_(others[q], T_SIGN_SECOND); } catch (e) {}
  }
}



/* ---------- v166.21: درخواست اتصال حساب، فقط با تأیید پذیرش یا یاسر (بند ۲.۵) ----------
   دو راه که با تایپ نام حسابی را به پرونده وصل می‌کرد حالا فقط درخواست می‌سازند:
   ۱) اتصال درمانگر (/start ther ← نام ← شماره) ← k: 't'
   ۲) «🪪 نقش دیگری دارم» در تب «افراد» (نقش‌های تیمی هم از همین‌جا می‌آمد) ← k: 'p'
   درخواست در Script Properties (TG_TQ) می‌ماند تا تأیید یا رد شود؛ بعد از TG_TQ_DAYS روز باطل می‌شود.
   کارت به یاسر و مسئول پذیرش (اگر نبود، همهٔ تیم پذیرش) می‌رود؛ هر عضو تیم پذیرش یا یاسر می‌تواند تصمیم بگیرد.
   راه‌هایی که بی‌تغییر ماندند: اتصال دوبارهٔ همان حساب، لینک اختصاصی با کد پیوند، و پل از «افراد» برای
   حسابی که chat_id آن را تیم یا همین تأیید ثبت کرده. */
const T_SIGN_WAIT   = 'سلام، درخواست شما ثبت شد. بعد از تأیید پذیرش، حسابتان وصل می‌شود.';
const T_SIGN_REJECT = 'هویت شما تأیید نشد. اگر از همکاران مرکز تجربه زندگی هستید، با پذیرش تماس بگیرید یا در تلگرام پیام بدهید.';
var TG_TQ_KEY = 'TG_TQ';
var TG_TQ_DAYS = 7;

function tgTqAll_() {
  var m;
  if (TG_DRY) m = TG_MEM['tq'] || {};
  else { try { m = JSON.parse(PropertiesService.getScriptProperties().getProperty(TG_TQ_KEY) || '{}'); } catch (e) { m = {}; } }
  var cut = Date.now() - TG_TQ_DAYS * 86400000, out = {};
  Object.keys(m).forEach(function (k) { if (m[k] && m[k].at > cut) out[k] = m[k]; });
  return out;
}
function tgTqSave_(m) {
  if (TG_DRY) { TG_MEM['tq'] = m; return; }
  var p = PropertiesService.getScriptProperties();
  if (Object.keys(m).length) p.setProperty(TG_TQ_KEY, JSON.stringify(m)); else p.deleteProperty(TG_TQ_KEY);
}
/* fn(m) زیر قفل اسکریپت؛ اگر صدازننده قفل را دارد (TG_LOCK_HELD) دوباره نمی‌گیرد */
function tgTqEdit_(fn) {
  if (TG_DRY || TG_LOCK_HELD) { var m0 = tgTqAll_(); var r0 = fn(m0); tgTqSave_(m0); return r0; }
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(10000)) throw new Error('tgTqEdit_: قفل');
  try { var m = tgTqAll_(); var r = fn(m); tgTqSave_(m); return r; } finally { lock.releaseLock(); }
}

/* یاسر + مسئول پذیرش؛ اگر مسئولی نبود، همهٔ تیم پذیرش */
function tgTqReviewers_() {
  var out = [String(TG_OWNER_CHAT)];
  var desk = [];
  try { desk = TG_DRY ? (TG_MEM['desk'] || []) : tgDeskRows_(); } catch (e) {}
  var lead = desk.filter(function (r) { return r.chat && String(r.role || '').indexOf('مسئول پذیرش') > -1; });
  (lead.length ? lead : desk.filter(function (r) { return r.chat; })).forEach(function (r) {
    var c = String(r.chat).split(/[,،;\s]+/)[0];
    if (c && out.indexOf(c) < 0) out.push(c);
  });
  return out;
}
function tgTqCanDecide_(chat, uname) {
  if (String(chat) === String(TG_OWNER_CHAT)) return true;
  if (TG_DRY) return (TG_MEM['desk'] || []).some(function (r) { return tgChatIn_(r.chat, chat); });
  try { return !!tgWhoDesk_(chat, uname); } catch (e) { return false; }
}

/* راه تماس با پذیرش از همان جایی که بات می‌شناسد: یوزرنیم مسئول پذیرش در «تیم پذیرش» و شماره‌اش در «افراد» */
function tgTqDeskContact_() {
  var desk = [];
  try { desk = TG_DRY ? (TG_MEM['desk'] || []) : tgDeskRows_(); } catch (e) {}
  var r = desk.filter(function (x) { return String(x.role || '').indexOf('مسئول پذیرش') > -1; })[0] || desk[0];
  if (!r) return '';
  var L = [];
  if (r.user) L.push('تلگرام پذیرش: @' + String(r.user).replace(/^@/, ''));
  try {
    var ppl = TG_DRY ? (TG_MEM['people'] || []) : tgPeopleList_();
    for (var i = 0; i < ppl.length; i++) if (tgSameName_(ppl[i].name, r.name) && String(ppl[i].phone || '').trim()) { L.push('شمارهٔ پذیرش: ' + String(ppl[i].phone).trim()); break; }
  } catch (e) {}
  return L.length ? '\n\n' + L.join('\n') : '';
}

var TG_TQ_CHK = { ok: '✅ شماره با پرونده یکی است', bad: '⚠️ شماره با پرونده نمی‌خورد', none: '؟ برای این نام شماره‌ای در پرونده نیست', other: '⚠️ شماره در پرونده مال همین نام است، ولی نام دیگری انتخاب شده بود' };

function tgTqCardText_(chat, q) {
  var L = ['🔐 <b>درخواست اتصال حساب</b>', ''];
  L.push((q.k === 't' ? 'درمانگر: ' : 'نقش‌های ثبت‌شده برای: ') + '<b>' + tgEsc_(q.name) + '</b>');
  if (q.want) L.push('نامی که انتخاب کرد: ' + tgEsc_(q.want));
  L.push('حساب تلگرام: ' + tgEsc_(q.who || '') + ' · <code>' + tgEsc_(String(chat)) + '</code>');
  if (q.chk) L.push(TG_TQ_CHK[q.chk] || q.chk);
  if (q.k === 't') {
    try {
      var rows = tgTherapistRows_();
      for (var i = 0; i < rows.length; i++) if (rows[i].name === q.name) {
        var n = String(rows[i].chat || '').split(/[,،;\s]+/).filter(String).length;
        if (n) L.push('این نام از قبل ' + tgFa_(String(n)) + ' حساب وصل دارد؛ این حساب دوم است.');
        break;
      }
    } catch (e) {}
  }
  L.push('', 'تا تأیید نشود هیچ اطلاعاتی به این حساب نمی‌رود.');
  return L.join('\n');
}

function tgTqRequest_(chat, q) {
  q.at = Date.now();
  var fresh = tgTqEdit_(function (m) {
    var old = m[String(chat)];
    m[String(chat)] = q;
    return !(old && old.k === q.k && old.name === q.name);
  });
  tgDel_('sign', chat); tgDel_('rclaim', chat);
  tgSend_(chat, T_SIGN_WAIT, tgMenu_());
  if (!fresh) return;   /* همان درخواست دوباره: کارت تکراری نمی‌رود */
  var kb = { inline_keyboard: [[{ text: '✅ تأیید', callback_data: 'tq:ok:' + chat }, { text: '✖️ رد', callback_data: 'tq:no:' + chat }]] };
  var txt = tgTqCardText_(chat, q);
  tgTqReviewers_().forEach(function (c) { try { tgSend_(c, txt, kb); } catch (e) { tgErr_('tgTqRequest_: ' + e); } });
}

function tgOnTq_(cq, rest, me, name, uname) {
  if (!tgTqCanDecide_(me, uname)) return tgSend_(me, 'این دکمه فقط برای تیم پذیرش است.');
  var parts = String(rest).split(':'), op = parts[0], target = parts[1];
  if (!target || (op !== 'ok' && op !== 'no')) return;
  var q = tgTqEdit_(function (m) { var x = m[target] || null; delete m[target]; return x; });
  if (!q) return tgSend_(me, 'این درخواست قبلاً بررسی شده یا باطل شده است.');
  var by = name + (uname ? ' ' + uname : '');
  var res;
  if (op === 'no') {
    tgSend_(target, T_SIGN_REJECT + tgTqDeskContact_(), tgMenu_());
    res = '✖️ رد شد';
  } else if (q.k === 't') {
    var row = null, list = tgTherapistRows_();
    for (var i = 0; i < list.length; i++) if (list[i].name === q.name) { row = list[i]; break; }
    if (!row) return tgSend_(me, 'این نام دیگر در فهرست درمانگران نیست؛ وصل نشد.');
    var ids0 = String(row.chat || '').split(/[,،;\s]+/).filter(String);
    if (ids0.length >= 3 && ids0.indexOf(String(target)) < 0) { tgSend_(target, T_SIGN_TAKEN, tgMenu_()); return tgSend_(me, 'این نام سه حساب وصل دارد؛ وصل نشد.'); }
    if (q.chk === 'none' && q.ph && !TG_DRY) {
      try {
        var pl = tgPeopleList_();
        for (var j = 0; j < pl.length; j++) if (tgSameName_(pl[j].name, q.name) && !tgPhoneKey_(pl[j].phone)) { tgPersonSet_(pl[j].row, { 'شمارهٔ تماس': q.ph }, 'بات', { why: 'اتصال درمانگر با تأیید' }); break; }
      } catch (e) { tgErr_('tgOnTq_: ' + e); }
    }
    tgTherConnectNow_(target, row, q.who, (TG_TQ_CHK[q.chk] || '') + ' · تأیید: ' + by);
    res = '✅ وصل شد';
  } else {
    var p = null, ppl = tgPeopleList_();
    for (var k = 0; k < ppl.length; k++) if (ppl[k].name === q.name) { p = ppl[k]; break; }
    if (!p) return tgSend_(me, 'این نام دیگر در «افراد» نیست؛ وصل نشد.');
    if (p.chat && !tgChatIn_(p.chat, target)) { tgSend_(target, tgRoleClaimText_(T_ROLE_CLAIM_TAKEN), tgMenu_()); return tgSend_(me, 'این نام از قبل به حساب دیگری وصل است؛ وصل نشد.'); }
    tgRoleClaimDone_(target, p);
    res = '✅ وصل شد';
  }
  var note = res + ' · ' + tgEsc_(q.name) + ' · ' + tgEsc_(q.who || '') + ' · توسط ' + tgEsc_(by);
  tgTqReviewers_().forEach(function (c) { try { tgSend_(c, note); } catch (e) {} });
}

/* در tgDaily: درخواست‌هایی که بیش از یک روز بی‌جواب مانده‌اند یادآوری می‌شوند (بعد از ۷ روز خودبه‌خود باطل) */
function tgTqRemind_() {
  var m = tgTqAll_(), old = [], day = Date.now() - 86400000;
  Object.keys(m).forEach(function (c) { if (m[c].at < day) old.push('• ' + tgEsc_(m[c].name) + ' · ' + tgEsc_(m[c].who || '')); });
  if (!old.length) return 0;
  var txt = '⏳ <b>درخواست اتصال بی‌جواب</b>\n' + old.join('\n') + '\n\nکارت تأیید هر کدام بالاتر در همین گفت‌وگو است.';
  tgTqReviewers_().forEach(function (c) { try { tgSend_(c, txt); } catch (e) {} });
  return old.length;
}

/* ---------- پروندهٔ کامل درمانگران (فایل جدا) ---------- */

// نام ستون را در سطر سرآیند پیدا می‌کند
function tgColIdx_(head, words) {
  for (var i = 0; i < head.length; i++) {
    const h = tgNorm_(head[i]);
    for (var j = 0; j < words.length; j++) if (h.indexOf(tgNorm_(words[j])) > -1) return i;
  }
  return -1;
}

// نقشهٔ نام → پروندهٔ حرفه‌ای. کد ملی و اطلاعات هویتی عمداً خوانده نمی‌شود.
function tgProfiles_() {
  const out = { rows: {}, ended: {} };
  let ss;
  try { ss = SpreadsheetApp.openById(TG_PROFILE_SS); } catch (e) { return out; }
  const sheets = ss.getSheets();

  for (var s = 0; s < sheets.length; s++) {
    const sh = sheets[s];
    if (sh.getLastRow() < 2 || sh.getLastColumn() < 5) continue;
    const head = sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0];
    const cName = tgColIdx_(head, ['نام درمانگران', 'نام درمانگر']);
    if (cName < 0) continue;
    const cSrv = tgColIdx_(head, ['انواع خدمات']);
    const isEnded = tgNorm_(sh.getName()).indexOf('قطع') > -1;
    if (cSrv < 0 && !isEnded) continue;

    const cGen = tgColIdx_(head, ['جنسیت']);
    const cApp = tgColIdx_(head, ['رویکرد درمانی']);
    const cFee = tgColIdx_(head, ['حداقل ویزیت']);
    const cCity = tgColIdx_(head, ['محل سکونت']);
    const cMode = tgColIdx_(head, ['نوع پذیرش']);
    const cLgbt = tgColIdx_(head, ['غیر دگر']);
    const cTg = tgColIdx_(head, ['اکانت تلگرام']);

    const v = sh.getRange(2, 1, sh.getLastRow() - 1, sh.getLastColumn()).getValues();
    for (var i = 0; i < v.length; i++) {
      const nm = tgNorm_(String(v[i][cName] || ''));
      if (!nm || nm.length < 4) continue;
      if (isEnded) { out.ended[nm] = true; continue; }
      out.rows[nm] = {
        name: String(v[i][cName]).trim(),
        gender: cGen > -1 ? String(v[i][cGen]).trim() : '',
        services: cSrv > -1 ? String(v[i][cSrv]).trim() : '',
        approach: cApp > -1 ? String(v[i][cApp]).trim() : '',
        fee: cFee > -1 ? String(v[i][cFee]).trim() : '',
        city: cCity > -1 ? String(v[i][cCity]).trim() : '',
        mode: cMode > -1 ? String(v[i][cMode]).trim() : '',
        lgbt: cLgbt > -1 ? String(v[i][cLgbt]).trim().toUpperCase() === 'TRUE' : false,
        tg: cTg > -1 ? String(v[i][cTg]).trim() : ''
      };
    }
  }
  return out;
}

// «انواع خدمات» را به استخرها ترجمه می‌کند
function tgSrvPools_(services) {
  const s = tgNorm_(services);
  const p = {};
  if (!s) return p;
  if (s.indexOf('فردی') > -1) p.ind = true;
  if (s.indexOf('بزرگسال') > -1) p.ind = true;
  if (s.indexOf('کودک') > -1) p.kid = true;
  if (s.indexOf('نوجوان') > -1) p.kid = true;
  if (s.indexOf('زوج') > -1 || s.indexOf('پیش از ازدواج') > -1) p.rel = true;
  if (s.indexOf('خانواده') > -1) p.fam = true;
  return p;
}

function tgIsAbroadCity_(city) {
  const c = tgNorm_(city);
  if (!c) return false;
  for (var i = 0; i < TG_ABROAD_CITY.length; i++) if (c.indexOf(tgNorm_(TG_ABROAD_CITY[i])) > -1) return true;
  return false;
}


/* ---------- تاریخ شمسی در شیت ---------- */
// تب‌هایی که ستون «تاریخ شمسی» می‌گیرند: [نام تب, سطر سرآیند, ستون تاریخ میلادی]
const TG_JAL_TABS = [
  { tab: 'لیدها', head: 1, cols: [{ src: 1, name: 'تاریخ شمسی' }, { src: 21, name: 'تاریخ معارفه (شمسی)' }] },
  { tab: 'اسلات معارفه', head: 3, cols: [{ srcName: 'تاریخ اسلات', src: 2, name: 'تاریخ شمسی' },
                                          { srcName: 'تاریخ اعلام', src: 9, name: 'تاریخ اعلام (شمسی)' }] },
  { tab: 'وقت‌های هفتگی', head: 3, cols: [{ srcName: 'تاریخ اعلام', src: 6, name: 'تاریخ اعلام (شمسی)' },
                                            { srcName: 'وقت بعدی', src: 8, name: 'وقت بعدی (شمسی)' }] },
  { tab: 'کارتابل پیگیری', head: 6, cols: [{ srcName: 'تاریخ اقدام بعدی', src: 5, name: 'تاریخ شمسی' }] }
];

// تاریخ را به «شنبه ۲۱ شهریور ۱۴۰۵» تبدیل می‌کند؛ اگر تاریخ نبود رشتهٔ خالی
function tgJalCell_(x) {
  let d = null;
  if (x instanceof Date) d = x.getFullYear() < 1700 ? tgJ2G_(x.getFullYear(), x.getMonth() + 1, x.getDate()) : x;   /* v170.2: شمسی که شیت تاریخ میلادی سال ۱۴۰۵ خوانده */
  else {
    const s = String(x || '').trim();
    if (!s) return '';
    /* v170.2: تاریخی که خودش شمسی است (۱۴۰۵-۰۶-۱۷ یا 1405/06/17) پیش از این میلادی خوانده می‌شد و «-۶۳۶ فروردین ۷۴۹» می‌شد */
    const sl = tgLatinDigits_(s).replace(/[\/.]/g, '-');
    const jm = sl.match(/^(1[2-4]\d\d)-(\d{1,2})-(\d{1,2})/);
    if (jm) d = tgJ2G_(Number(jm[1]), Number(jm[2]), Number(jm[3]));
    else if (/^\d{4}-\d{2}-\d{2}/.test(sl)) d = new Date(sl.slice(0, 10) + 'T12:00:00');
    else { const p = new Date(s); if (!isNaN(p.getTime())) d = p; }
  }
  if (!d || isNaN(d.getTime())) return '';
  try { return tgJDateFull_(d, TG_TZ); } catch (e) {}
  try { return tgJDate_(d, TG_TZ); } catch (e) {}
  return '';
}

function tgJalBroken_(v) {
  const s = tgLatinDigits_(String(v || '')).trim();
  if (!s) return false;
  if (/^-/.test(s)) return true;
  const y = s.match(/(\d{3,4})\s*$/);
  return !!(y && Number(y[1]) < 1300);
}
// ستون تاریخ شمسی را می‌سازد و خانه‌های خالی را پر می‌کند. هیچ ستون موجودی جابه‌جا نمی‌شود.
function tgFillJalali_(force) {
  const ss = tgSS_();
  let filled = 0, made = 0;
  for (var i = 0; i < TG_JAL_TABS.length; i++) {
    const cfg = TG_JAL_TABS[i];
    const sh = ss.getSheetByName(cfg.tab);
    if (!sh) continue;
    const last = sh.getLastRow();
    if (last <= cfg.head) continue;

    for (var q = 0; q < cfg.cols.length; q++) {
      const spec = cfg.cols[q];
      const lc = sh.getLastColumn();
      const head = sh.getRange(cfg.head, 1, 1, lc).getValues()[0];
      let col = -1;
      for (var c = 0; c < lc; c++) if (String(head[c]).trim() === spec.name) { col = c + 1; break; }
      if (col < 0) {
        col = lc + 1;
        sh.getRange(cfg.head, col).setValue(spec.name).setFontWeight('bold');
        made++;
      }

      const n = last - cfg.head;
      let srcCol = spec.src;
      if (spec.srcName) {
        for (var c3 = 0; c3 < lc; c3++) if (String(head[c3]).trim() === spec.srcName) { srcCol = c3 + 1; break; }
      }
      const src = sh.getRange(cfg.head + 1, srcCol, n, 1).getValues();
      const cur = sh.getRange(cfg.head + 1, col, n, 1).getValues();
      const out = [];
      let touched = false;
      for (var r = 0; r < n; r++) {
        const has = String(cur[r][0]).trim();
        /* v170.2: خانهٔ خراب (سال کمتر از ۱۳۰۰ یا منفی، مثل «-۶۳۶ فروردین ۷۴۹») دوباره ساخته می‌شود */
        if (has && !force && !tgJalBroken_(has)) { out.push([cur[r][0]]); continue; }
        const j = tgJalCell_(src[r][0]);
        out.push([j]);
        if (j) { touched = true; filled++; }
      }
      if (touched) sh.getRange(cfg.head + 1, col, n, 1).setValues(out);
    }
  }
  return { filled: filled, made: made };
}

function tgJalaliColumns() {
  const r = tgFillJalali_(false);
  Logger.log('ستون تاریخ شمسی: ' + r.made + ' ستون تازه ساخته شد · ' + r.filled + ' خانه پر شد');
}

function tgJalaliRebuild() {
  const r = tgFillJalali_(true);
  Logger.log('بازسازی کامل تاریخ شمسی: ' + r.filled + ' خانه');
}



/* ---------- موتور SLA اعلان پذیرش ---------- */

// ستون «اعلان بات» در Sheet1؛ اگر نبود ساخته می‌شود
function tgFlagCol_() {
  const sh = tgSS_().getSheetByName(TG_LEADS);
  const lc = sh.getLastColumn();
  const head = sh.getRange(1, 1, 1, lc).getValues()[0];
  for (var c = 0; c < lc; c++) if (String(head[c]).trim() === 'اعلان بات') return c + 1;
  sh.getRange(1, lc + 1).setValue('اعلان بات').setFontWeight('bold');
  return lc + 1;
}

// الان ساعت کاری پذیرش است؟ (برای یک عضو مشخص)
function tgDeskOnDuty_(p, now) {
  const d = Number(Utilities.formatDate(now, TG_TZ, 'u'));   // ۱ دوشنبه … ۷ یکشنبه
  const h = Number(Utilities.formatDate(now, TG_TZ, 'H'));
  const isFri = (d === 5);
  const isThu = (d === 4);
  if (isFri) return false;                                    // جمعه فقط بحران و جمع‌بندی عصر
  if (isThu && p.days === TG_DESK_DAYS[1]) return false;       // شنبه تا چهارشنبه
  return h >= p.start && h < p.end;
}

// لیدهای باز را با سن و درجهٔ فوریت برمی‌گرداند
// گزارش فقط-خواندنی: سه سطل لید را می‌شمارد بدون اینکه پیامی برود
function tgLeadAudit() {
  const b = tgLeadBuckets_(tgOpenLeads_());
  const s = 'باز: ' + b.all.length + ' · تماس اول: ' + b.first.length +
            ' · نیاز به پیگیری: ' + b.stale.length + ' · در جریان: ' + b.live.length +
            '\n' + b.all.slice(0, 5).map(function (l) {
              return l.row + ' | ' + l.stage + ' | ' + (l.status || 'خالی') + ' | idle ' + l.idle;
            }).join('\n');
  Logger.log(s);
  return s;
}

// «بسته» و «بسته شد» و «بسته شده» باید یکی حساب شوند، وگرنه لید بسته در کارتابل می‌ماند
function tgNormSt_(s) {
  return String(s || '')
    .replace(/ي/g, 'ی').replace(/ك/g, 'ک')
    .replace(/[‌‎‏]/g, ' ')
    .replace(/\s+/g, ' ').trim()
    .replace(/\s*(شده|شد)$/, '');
}

function tgClosedSet_() {
  const out = {};
  TG_LEAD_CLOSED.forEach(function (s) { out[tgNormSt_(s)] = 1; });
  /* v140: مقدارهای قدیمی که به «بسته» یا «شروع درمان» نگاشت می‌شوند هم بسته حساب می‌شوند */
  try { for (var mk in TG_ST_MAP) if (TG_ST_MAP[mk] === TG_ST.CLOSED || TG_ST_MAP[mk] === TG_ST.START) out[tgNormSt_(mk)] = 1; } catch (eM) {}
  if (TG_DRY) return out;
  try {
    var raw = CacheService.getScriptCache().get('closedset');
    if (raw === null) {
      const sh = tgSS_().getSheetByName('تنظیمات تیم');
      const list = [];
      if (sh) {
        const v = sh.getRange(1, 1, Math.min(sh.getLastRow(), 40), 1).getValues();
        var on = false;
        for (var i = 0; i < v.length; i++) {
          const s = String(v[i][0] || '').trim();
          if (!on) { if (s.indexOf('لید بسته شده') > -1) on = true; continue; }
          if (!s) break;
          list.push(s);
        }
      }
      raw = list.join('|');
      CacheService.getScriptCache().put('closedset', raw, 21600);
    }
    String(raw || '').split('|').filter(String).forEach(function (s) { out[tgNormSt_(s)] = 1; });
  } catch (e) {}
  return out;
}

// وضعیت لید سه حالت دارد: تماس اول نگرفته (first)، پیگیری‌شده و تازه (live)، پیگیری‌شده و بی‌حرکت (stale)
/* v168 فاز ۳: تنها منبع شمار «لید باز» (کارتابل، دایجست، کارهای روی زمین، داشبورد و گزارش) */
function tgOpenLeads_() {
  if (TG_DRY && TG_MEM && TG_MEM['openrows']) return tgOpenLeadsOf_(TG_MEM['openrows'].v, TG_MEM['openrows'].hm, new Date(TG_MEM['openrows'].now || Date.now()));
  const sh = tgSS_().getSheetByName(TG_LEADS);
  const last = sh.getLastRow();
  if (last < 2) return [];
  const lc = sh.getLastColumn();
  return tgOpenLeadsOf_(sh.getRange(2, 1, last - 1, lc).getValues(), tgLeadHeadMap_(sh), new Date());
}
function tgOpenLeadsOf_(v, hm, now) {
  const today = Utilities.formatDate(now, TG_TZ, 'yyyy-MM-dd');
  const out = [];
  for (var i = 0; i < v.length; i++) {
    const name = String(v[i][3] || '').trim();
    const statusRaw = String(v[i][8] || '').trim();
    const status = tgStOf_(statusRaw) || statusRaw;
    if (!name && !String(v[i][5] || '').trim()) continue;
    if (statusRaw && tgStClosed_(statusRaw)) continue;
    /* لید مدرسه در کارتابل پذیرش نمی‌آید؛ جایش هاب مدرسه است */
    if (tgSection_(String(v[i][2] || ''), '') === 'مدرسه') continue;
    let when = v[i][0];
    let d = (when instanceof Date) ? new Date(when) : new Date(String(when) + 'T00:00:00');
    const hhmm = String(v[i][1] || '').trim();
    if (/^\d{1,2}:\d{2}$/.test(tgLatinDigits_(hhmm))) {
      const p = tgLatinDigits_(hhmm).split(':');
      d.setHours(Number(p[0]), Number(p[1]), 0, 0);
    }
    const age = isNaN(d.getTime()) ? 0 : Math.round((now - d) / 60000);
    let ld = tgContactDate_(v[i][10], now);
    const touched = !!ld;
    const idle = touched ? Math.max(0, Math.round((now - ld) / 60000)) : age;
    const abroad = String(v[i][6] || '').indexOf('خارج') > -1;
    const booked = String(v[i][19] || '').trim() === 'بله';
    const crisis = /بحران|هشدار/.test(String(v[i][7] || ''));
    const nextIso = tgLeadIso_(tgLeadHv_(v[i], hm, 'تاریخ اقدام بعدی'));
    out.push({
      row: i + 2, name: name, phone: String(v[i][5] || '').trim(),
      src: String(v[i][2] || '').trim(), note: String(v[i][7] || '').trim().slice(0, 70),
      owner: String(v[i][9] || '').trim(), age: age,
      status: status, touched: touched, idle: idle,
      result: String(v[i][11] || '').trim(),
      next: String(tgLeadHv_(v[i], hm, 'اقدام بعدی') || '').trim(), nextDate: nextIso,
      code: String(tgLeadHv_(v[i], hm, 'کد لید') || '').trim(),
      stage: tgLeadStage_(touched, idle, nextIso, today),
      urgent: abroad || booked || crisis, abroad: abroad, booked: booked, crisis: crisis,
      /* v170.2 مدل لید */
      type: String(tgLeadHv_(v[i], hm, 'نوع لید') || '').trim() || 'مراجع', mode: String(tgLeadHv_(v[i], hm, 'حالت') || '').trim(),
      out: String(tgLeadHv_(v[i], hm, 'پیامد') || '').trim(), stageOwner: String(tgLeadHv_(v[i], hm, 'مسئول مرحله') || '').trim(),
      stageDue: (function (x) { return x instanceof Date ? Utilities.formatDate(x, TG_TZ, 'yyyy-MM-dd HH:mm') : String(x || '').trim(); })(tgLeadHv_(v[i], hm, 'مهلت مرحله'))
    });
  }
  return out;
}

// ستون «آخرین تماس» گاهی دستی و شمسی پر می‌شود («۱۴۰۵-۰۶-۱۶»). آن را می‌فهمد و تاریخ بی‌معنی را دور می‌ریزد
function tgContactDate_(raw, now) {
  if (raw instanceof Date) return isNaN(raw.getTime()) ? null : raw;
  const s = tgLatinDigits_(String(raw || '')).trim().replace(/[\/.]/g, '-');
  if (!s) return null;
  const m = s.match(/^(\d{4})-(\d{1,2})-(\d{1,2})$/);
  if (m && Number(m[1]) < 1900) return tgJ2G_(Number(m[1]), Number(m[2]), Number(m[3]));
  const d = new Date(s.length <= 10 ? s + 'T00:00:00' : s);
  if (isNaN(d.getTime())) return null;
  const yr = d.getFullYear();
  const ny = (now || new Date()).getFullYear();
  if (yr < 1990 || yr > ny + 1) return null;
  return d;
}

// شمسی به میلادی
function tgJ2G_(jy, jm, jd) {
  var jy1 = jy - 979, jm1 = jm - 1, jd1 = jd - 1;
  var jdn = 365 * jy1 + Math.floor(jy1 / 33) * 8 + Math.floor(((jy1 % 33) + 3) / 4);
  for (var i = 0; i < jm1; i++) jdn += (i < 6 ? 31 : 30);
  jdn += jd1 + 79;
  var gy = 1600 + 400 * Math.floor(jdn / 146097);
  jdn %= 146097;
  var leap = true;
  if (jdn >= 36525) { jdn--; gy += 100 * Math.floor(jdn / 36524); jdn %= 36524; if (jdn >= 365) jdn++; else leap = false; }
  gy += 4 * Math.floor(jdn / 1461); jdn %= 1461;
  if (jdn >= 366) { leap = false; jdn--; gy += Math.floor(jdn / 365); jdn %= 365; }
  var gd = jdn + 1;
  var sal = [0, 31, (leap ? 29 : 28), 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
  var gm = 0;
  for (gm = 1; gm <= 12 && gd > sal[gm]; gm++) gd -= sal[gm];
  return new Date(gy, gm - 1, gd);
}

// فهرست کوتاه با دم «و N مورد دیگر» تا پیام اسپم نشود
function tgLeadList_(arr, cap) {
  const n = cap || 5;
  let s = arr.slice(0, n).map(tgLeadLine_).join('\n');
  if (arr.length > n) s += '\n   … و ' + tgFa_(arr.length - n) + ' مورد دیگر — در کارتابل پیگیری ببینید';
  return s;
}

function tgLeadDur_(min) {
  if (!(min > 0)) return 'کمتر از یک دقیقه';
  if (min > 5256000) return 'نامعلوم (تاریخ اشتباه)';
  if (min >= 1440) return tgFa_(Math.floor(min / 1440)) + ' روز';
  if (min >= 60) return tgFa_(Math.floor(min / 60)) + ' ساعت';
  return tgFa_(min) + ' دقیقه';
}

function tgLeadLine_(l) {
  const tag = l.booked ? '📅 ' : (l.abroad ? '🌍 ' : (l.stage === 'first' ? '☎ ' : '↻ '));
  const when = (l.stage === 'first')
    ? 'ثبت ' + tgLeadDur_(l.age) + ' پیش · هنوز تماس اول نگرفته'
    : 'آخرین تماس ' + tgLeadDur_(l.idle) + ' پیش';
  return tag + (l.name || 'بدون نام') + ' · ' + (l.src || 'نامعلوم') + ' · ' + when +
         '\n   سطر ' + tgFa_(l.row) + ' · ' + (l.owner ? tgEsc_(l.owner) : 'بدون مسئول') +
         (l.status && l.status !== 'جدید' ? ' · ' + tgEsc_(l.status) : '') +
         (l.next ? '\n   📌 ' + tgEsc_(l.next) + (l.nextDate ? ' · ' + tgEsc_(tgLeadJ_(l.nextDate)) : '') : '') +
         (l.note ? '\n   ' + tgEsc_(l.note) : '');
}

/* v168 فاز ۳: سطل‌ها از همان «کار امروز» (tgTodayList_) می‌آیند؛ کارتابل، دایجست و کارهای روی زمین یکی‌اند */
function tgLeadBuckets_(list) {
  const today = Utilities.formatDate(new Date(), TG_TZ, 'yyyy-MM-dd');
  const due = tgTodayList_('', today, list), seen = {};
  due.forEach(function (l) { seen[l.row] = 1; });
  return {
    all: list, today: due,
    first: due.filter(function (l) { return !l.touched; }),
    stale: due.filter(function (l) { return l.touched; }),
    live:  list.filter(function (l) { return !seen[l.row]; })
  };
}

function tgLeadCounts_(b) {
  return '📊 لید باز: ' + tgFa_(b.all.length) +
         '\n☎ منتظر تماس اول: ' + tgFa_(b.first.length) +
         '\n↻ نیاز به پیگیری (موعد اقدام امروز یا گذشته): ' + tgFa_(b.stale.length) +
         '\n⏳ در جریان: ' + tgFa_(b.live.length);
}

function tgDeskOpen_(chat) {
  const list = tgOpenLeads_();
  if (!list.length) return tgSend_(chat, '📥 چیزی روی زمین نمانده. دستتان درد نکند 🌿', tgDeskMenu_());
  const b = tgLeadBuckets_(list);
  let t = '<b>📥 کارهای روی زمین</b>\n\n' + tgLeadCounts_(b);
  if (b.first.length) t += '\n\n<b>☎ منتظر تماس اول</b>\n' + tgLeadList_(b.first, 5);
  if (b.stale.length) t += '\n\n<b>↻ نیاز به پیگیری</b>\n' + tgLeadList_(b.stale, 5);
  if (!b.first.length && !b.stale.length) t += '\n\nهمهٔ لیدهای باز تازه پیگیری شده‌اند 🌿';
  tgSend_(chat, t, tgDeskMenu_());
  if (typeof tgLeadCards_ === 'function') tgLeadCards_(chat, b);
}

function tgDeskToday_(chat) {
  const sh = tgSS_().getSheetByName(TG_LEADS);
  const last = sh.getLastRow();
  const today = Utilities.formatDate(new Date(), TG_TZ, 'yyyy-MM-dd');
  let n = 0, booked = 0;
  if (last >= 2) {
    const v = sh.getRange(2, 1, last - 1, 21).getValues();
    for (var i = 0; i < v.length; i++) {
      const d = v[i][0] instanceof Date ? Utilities.formatDate(v[i][0], TG_TZ, 'yyyy-MM-dd') : String(v[i][0]).slice(0, 10);
      if (d !== today) continue;
      n++;
      if (String(v[i][19] || '').trim() === 'بله') booked++;
    }
  }
  const b = tgLeadBuckets_(tgOpenLeads_());
  tgSend_(chat, '📊 <b>امروز</b>  ·  ' + tgJDateFull_(new Date(), TG_TZ) + '\n\n' +
    '• لید تازهٔ امروز: ' + tgFa_(n) + '\n' +
    '• معارفهٔ هماهنگ‌شدهٔ امروز: ' + tgFa_(booked) + '\n\n' +
    '<b>روی زمین</b>\n' + tgLeadCounts_(b), tgDeskMenu_());
}

// هستهٔ SLA: از واچ‌داگ صدا زده می‌شود
function tgSlaTick_() {
  const team = tgDeskRows_().filter(function (p) { return p.chat; });
  if (!team.length) return;
  const sh = tgSS_().getSheetByName(TG_LEADS);
  const fc = tgFlagCol_();
  const now = new Date();
  const stamp = Utilities.formatDate(now, TG_TZ, 'MM-dd HH:mm');
  const today = Utilities.formatDate(now, TG_TZ, 'MM-dd');
  const leads = tgOpenLeads_();
  const boss = team[0];
  var idleSent = 0;   // یادآوری پیگیری در هر نوبت سقف دارد تا اسپم نشود

  for (var i = 0; i < leads.length; i++) {
    const l = leads[i];
    const flag = String(sh.getRange(l.row, fc).getValue() || '');

    // مسئول سطر اگر در تیم باشد، وگرنه مسئول پذیرش
    let to = boss;
    for (var k = 0; k < team.length; k++) if (l.owner && team[k].name === l.owner) to = team[k];

    // لیدی که تماس اول گرفته شده دیگر «باز» نیست؛ فقط اگر بی‌حرکت بماند یادآوری می‌شود، روزی یک بار
    if (l.stage !== 'first') {
      if (l.stage !== 'stale') continue;
      if (flag.indexOf('پیگیری ' + today) > -1) continue;
      if (idleSent >= TG_SLA_IDLE_MAX) continue;
      if (!tgDeskOnDuty_(to, now) || to.style === TG_DESK_STYLES[3]) continue;
      idleSent++;
      const lr = tgLeadRead_(l.row);
      const headI = l.nextDate ? '📌 <b>موعد اقدام بعدی رسیده</b>' : '↻ <b>بیش از ' + tgFa_(TG_SLA_IDLE_DAYS) + ' روز از آخرین تماس گذشته</b>';
      if (lr) { if (!lr.code) lr.code = tgLeadCode_(l.row); tgNotify_(to.chat, TG_NK.task, headI + '\n\n' + tgLeadCardText_(lr), { ref: lr.code, markup: tgLeadKb_(lr) }); }
      else tgNotify_(to.chat, TG_NK.task, headI + '\n\n' + tgLeadLine_(l) + (l.phone ? '\n   ' + tgEsc_(l.phone) : ''), { ref: 'لید سطر ' + l.row });
      sh.getRange(l.row, fc).setValue((flag ? flag + ' · ' : '') + 'پیگیری ' + today);
      continue;
    }

    const stage = tgSlaStage_(flag);
    if (stage >= 2) continue;
    /* v166.9: تا پیش از این، هر «2» در ساعتِ برچسب مرحلهٔ ۱ (مثل 12:40) مرحلهٔ ۲ خوانده می‌شد و پیگیری دوساعته نمی‌رفت.
       لیدهایی که بیش از TG_SLA_BACKLOG_MIN پیش مرحلهٔ ۱ گرفتند و به همین دلیل گیر ماندند، یک‌جا هشدار نمی‌گیرند (دایجست دارند). */
    if (stage === 1 && l.age > TG_SLA_BACKLOG_MIN) continue;

    const wantStage = l.urgent ? 1 : (l.age >= TG_SLA_SECOND ? 2 : (l.age >= TG_SLA_FIRST ? 1 : 0));
    if (!wantStage || wantStage <= stage) continue;
    if (wantStage === 2) to = boss;

    const duty = tgDeskOnDuty_(to, now);
    const styleOk = l.urgent ? (to.style !== '') : (to.style === TG_DESK_STYLES[0]);
    if (!duty || !styleOk) continue;   // بیرون از ساعت یا سبک جمع‌بندی: می‌ماند برای دایجست

    const head = l.urgent
      ? (l.crisis ? '🆘 <b>پیام با کلمهٔ بحران</b>' : (l.booked ? '📅 <b>یک معارفه رزرو شد</b>' : '🌍 <b>مراجع خارج از ایران</b>'))
      : (wantStage === 2 ? '⏰ <b>دو ساعت است تماس اول گرفته نشده</b>' : '⏳ <b>نیم ساعت است تماس اول گرفته نشده</b>');
    const lr2 = tgLeadRead_(l.row);
    const kind2 = l.urgent ? TG_NK.urgent : TG_NK.task;
    if (lr2) { if (!lr2.code) lr2.code = tgLeadCode_(l.row); tgNotify_(to.chat, kind2, head + '\n\n' + tgLeadCardText_(lr2), { ref: lr2.code, markup: tgLeadKb_(lr2) }); }
    else tgNotify_(to.chat, kind2, head + '\n\n' + tgLeadLine_(l) + (l.phone ? '\n   ' + tgEsc_(l.phone) : ''), { ref: 'لید سطر ' + l.row });
    if (wantStage === 2) { try { tgTaskFor_({ title: 'تماس اول لید ' + ((lr2 && lr2.code) || l.row), body: 'دو ساعت بی‌تماس مانده', team: 'پذیرش', who: to.name, chat: to.chat, dueDays: 0, link: (lr2 && lr2.code) || ('لید سطر ' + l.row), by: 'SLA' }); } catch (eT) { tgErr_('tgSlaTick_ task', eT); } }
    sh.getRange(l.row, fc).setValue((stage ? flag + ' · ' : '') + 'مرحلهٔ ' + tgFa_(wantStage) + ' ' + stamp);
  }
}

/* مرحلهٔ اعلان از ستون «اعلان بات»: فقط «مرحلهٔ N»، نه هر رقمی (برچسب زمان هم رقم دارد) */
var TG_SLA_BACKLOG_MIN = 48 * 60;
function tgSlaStage_(flag) {
  var m = String(flag || '').match(/مرحلهٔ\s*[۱۲12]/g) || [], st = 0;
  for (var i = 0; i < m.length; i++) { var d = m[i].slice(-1); var n = (d === '۲' || d === '2') ? 2 : 1; if (n > st) st = n; }
  return st;
}

// جمع‌بندی صبح و عصر
function tgDeskDigest_(kind) {
  const team = tgDeskRows_().filter(function (p) { return p.chat; });
  if (!team.length) return;
  const leads = tgOpenLeads_();
  const b = tgLeadBuckets_(leads);
  const now = new Date();
  const d = Number(Utilities.formatDate(now, TG_TZ, 'u'));
  const isFri = (d === 5);

  const title = kind === 'eve' ? '🌆 جمع‌بندی عصر' : '🌅 جمع‌بندی صبح';
  let body;
  if (!leads.length) {
    body = 'چیزی روی زمین نمانده 🌿';
  } else {
    body = tgLeadCounts_(b);
    if (b.first.length) body += '\n\n<b>☎ منتظر تماس اول</b>\n' + tgLeadList_(b.first, 5);
    if (b.stale.length) body += '\n\n<b>↻ نیاز به پیگیری</b>\n' + tgLeadList_(b.stale, 5);
    if (!b.first.length && !b.stale.length) body += '\n\nهمهٔ لیدهای باز تازه پیگیری شده‌اند 🌿';
  }

  for (var i = 0; i < team.length; i++) {
    const p = team[i];
    if (p.style === TG_DESK_STYLES[3]) continue;                       // فقط فوری‌ها
    if (kind === 'eve' && p.style === TG_DESK_STYLES[2]) continue;      // فقط صبح
    if (isFri && kind !== 'eve') continue;                              // جمعه فقط عصر
    if (!leads.length && kind === 'eve') continue;
    tgSend_(p.chat, '<b>' + title + '</b>\n\n' + body);
  }
}

function tgDigestMorning(e) { if (ciPaused_(e, 'tgDigestMorning', 'defer')) return; var rs0 = Date.now(); try { tgDeskDigest_('morn'); } finally { tgRunStat_('tgDigestMorning', rs0); } }
function tgDigestEvening(e) { if (ciPaused_(e, 'tgDigestEvening', 'defer')) return; var rs0 = Date.now(); try { tgDeskDigest_('eve'); try { if (typeof rvEvening_ === 'function') rvEvening_(); } catch (eRv) { tgErr_('rvEvening_', eRv); } try { if (typeof opsEvening_ === 'function') opsEvening_(); } catch (eOp) { tgErr_('opsEvening_', eOp); } } finally { tgRunStat_('tgDigestEvening', rs0); } }

// تریگرهای جمع‌بندی را یک بار می‌سازد
function tgDeskSetup() {
  tgDeskSheet_();
  const all = ScriptApp.getProjectTriggers();
  for (var i = 0; i < all.length; i++) {
    const f = all[i].getHandlerFunction();
    if (f === 'tgDigestMorning' || f === 'tgDigestEvening') ScriptApp.deleteTrigger(all[i]);
  }
  ScriptApp.newTrigger('tgDigestMorning').timeBased().atHour(9).nearMinute(30).everyDays(1).inTimezone(TG_TZ).create();
  ScriptApp.newTrigger('tgDigestEvening').timeBased().atHour(18).nearMinute(0).everyDays(1).inTimezone(TG_TZ).create();
  Logger.log('تیم پذیرش آماده است. جمع‌بندی صبح ۹:۳۰ و عصر ۱۸:۰۰ تنظیم شد.');
}

/* ---------- تیم پذیرش: تب، اتصال، تنظیمات ---------- */

function tgDeskSheet_() {
  const ss = tgSS_();
  let sh = ss.getSheetByName(TG_DESK_TAB);
  if (!sh) {
    sh = ss.insertSheet(TG_DESK_TAB);
    sh.setRightToLeft(true);
    sh.getRange(1, 1, 1, 9).setValues([['نام', 'یوزرنیم تلگرام', 'نقش', 'chat_id', 'شروع اعلان', 'پایان اعلان', 'روزهای کاری', 'سبک اعلان', 'آخرین اعلان']])
      .setFontWeight('bold').setBackground('#f3efec');
    sh.setFrozenRows(1);
    const rows = [];
    for (var i = 0; i < TG_DESK_SEED.length; i++) {
      rows.push([TG_DESK_SEED[i][0], TG_DESK_SEED[i][1], TG_DESK_SEED[i][2], '', 9, 18, TG_DESK_DAYS[0], TG_DESK_STYLES[0], '']);
    }
    sh.getRange(2, 1, rows.length, 9).setValues(rows);
    sh.setColumnWidth(1, 110); sh.setColumnWidth(2, 140); sh.setColumnWidth(3, 160);
  }
  return sh;
}

// کش ۵ دقیقه‌ای: هر پیام مراجع از این تابع رد می‌شود و بدون کش هر بار شیت باز می‌شد
function tgDeskCacheClear_() { try { CacheService.getScriptCache().remove('drows'); } catch (e) {} }
function tgDeskRows_() {
  const c = TG_DRY ? null : CacheService.getScriptCache();
  if (c) { const hit = tgCacheGet_('drows'); if (hit) { try { return JSON.parse(hit); } catch (e) {} } }
  const sh = tgDeskSheet_();
  const last = sh.getLastRow();
  if (last < 2) return [];
  const v = sh.getRange(2, 1, last - 1, 9).getValues();
  const out = [];
  for (var i = 0; i < v.length; i++) {
    const name = String(v[i][0]).trim();
    if (!name) continue;
    out.push({
      row: i + 2, name: name,
      user: String(v[i][1]).trim().replace(/^@/, '').toLowerCase(),
      role: String(v[i][2]).trim(),
      chat: String(v[i][3]).trim(),
      start: Number(tgLatinDigits_(String(v[i][4]))) || 9,
      end: Number(tgLatinDigits_(String(v[i][5]))) || 18,
      days: String(v[i][6]).trim() || TG_DESK_DAYS[0],
      style: String(v[i][7]).trim() || TG_DESK_STYLES[0]
    });
  }
  if (c) c.put('drows', JSON.stringify(out), 1800);
  return out;
}

// آیا این گفت‌وگو متعلق به یکی از بچه‌های پذیرش است؟
function tgWhoDesk_(chat, username) {
  if (TG_DRY) return TG_MEM['deskwho'] || null;
  const u = String(username || '').replace(/^@/, '').toLowerCase();
  const list = tgDeskRows_();
  const m = tgIdMatch_(list, chat, u, function (a, b) { return String(a) === String(b); });
  if (!m) return null;
  if (m.bind) {
    try {
      tgDeskSheet_().getRange(m.row.row, 4).setValue(String(chat));
      tgDeskCacheClear_();
      m.row.chat = String(chat);
    } catch (e) {}
  }
  return m.row;
}
/* v170.9 (امنیت): پیدا کردن ردیف یک نفر. chat واقعی (از آپدیت معتبر تلگرام یا initData امضاشده) اول؛ یوزرنیم فقط برای ردیفی که
   هنوز chat ندارد (bind=true یعنی همین حالا وصل شود). یوزرنیم قابل بازیافت است و ردیف وصل‌شده را نمی‌دزدد. */
function tgIdMatch_(list, chat, u, same) {
  for (var i = 0; i < list.length; i++) if (list[i].chat && same(list[i].chat, chat)) return { row: list[i], bind: false };
  if (u) for (var j = 0; j < list.length; j++) if (list[j].user && list[j].user === u && !String(list[j].chat || '').trim()) return { row: list[j], bind: true };
  return null;
}

function tgDeskMenu_() {
  return {
    keyboard: [
      ['📥 کارهای روی زمین', TG_DUTY_BTN],
      [TG_PAY_BTN],
      ['✉️ پیام‌های درمانگران'],
      ['⚙️ اعلان‌های من', '📊 خلاصهٔ امروز'],
      [TG_COLLQ_BTN, TG_INPQ_BTN],
      ['📈 نظارت', '📣 اطلاعیه‌ها'],
      ['❓ راهنما', '↩️ بازگشت'],
      [TG_DASH_BTN, TG_TSK_BTN],
      [TG_BOX_BTN]
    ].concat(typeof opsDeskRow_ === 'function' ? opsDeskRow_() : []).concat(tgDeskLeadRow_()).concat(tgRoleRow_()),
    resize_keyboard: true
  };
}
/* v162: صف جذب تراپیست فقط در منوی مسئول پذیرش */
function tgDeskLeadRow_() {
  try { if (!TG_CUR) return []; var d = TG_DRY ? (TG_MEM['deskwho'] || null) : tgWhoDesk_(TG_CUR, ''); return (d && tgApIsLead_(d)) ? [[TG_APQ_BTN]] : []; } catch (e) { return []; }
}

function tgDeskSetMenu_() {
  return {
    keyboard: [
      ['🕘 ساعت شروع', '🕕 ساعت پایان'],
      ['🔔 سبک اعلان', '📅 روزهای کاری'],
      ['↩️ بازگشت']
    ],
    resize_keyboard: true
  };
}

function tgDeskRoute_(chat, who, text) {
  const st = tgGetVal_('dsk', chat) || '';

  if (st === 'start' || st === 'end') {
    const n = Number(tgLatinDigits_(text).replace(/[^0-9]/g, ''));
    if (!(n >= 0 && n <= 23)) return tgSend_(chat, 'یک عدد بین ۰ تا ۲۳ بنویسید.', tgDeskSetMenu_());
    tgDeskSheet_().getRange(who.row, st === 'start' ? 5 : 6).setValue(n); tgDeskCacheClear_();
    tgDel_('dsk', chat);
    return tgSend_(chat, T_DESK_SAVED, tgDeskSetMenu_());
  }
  if (st === 'style') {
    if (TG_DESK_STYLES.indexOf(text) < 0) return tgSend_(chat, T_DESK_ASK_STYLE, tgDeskStyleKb_());
    tgDeskSheet_().getRange(who.row, 8).setValue(text); tgDeskCacheClear_();
    tgDel_('dsk', chat);
    return tgSend_(chat, T_DESK_SAVED, tgDeskSetMenu_());
  }
  if (st === 'days') {
    if (TG_DESK_DAYS.indexOf(text) < 0) return tgSend_(chat, T_DESK_ASK_DAYS, tgDeskDaysKb_());
    tgDeskSheet_().getRange(who.row, 7).setValue(text); tgDeskCacheClear_();
    tgDel_('dsk', chat);
    return tgSend_(chat, T_DESK_SAVED, tgDeskSetMenu_());
  }

  if (tgAssignCmd_(chat, who, text) === true) return;
  // کارت لید با کد: «L-1042» یا «لید 0912…» یا «لید مسئول پذیرش»
  if (/^L-?\d{3,6}$/i.test(tgLatinDigits_(text))) { tgLeadFindSend_(chat, text); return; }
  if (/^لید\s+\S/.test(text)) { tgLeadFindSend_(chat, text.replace(/^لید\s+/, '')); return; }
  if (tgFinSch_(chat, who.name, text, tgDeskMenu_) === true) return;
  if (tgDeskTk_(chat, who, text) === true) return;
  if (text.indexOf('اطلاعیه') > -1) return tgAnnShow_(chat, tgDeskMenu_());
  if (text.indexOf('نظارت') > -1) return tgSend_(chat, tgMonNow(), tgDeskMenu_());
  if (text.indexOf('راهنما') > -1 || tgCmd_(text) === '/help') return tgSend_(chat, T_HELP_DESK, tgDeskMenu_());

  if (text.indexOf('اعلان‌های من') > -1) {
    const msg = T_DESK_SET.replace('{a}', tgFa_(who.start)).replace('{b}', tgFa_(who.end))
                          .replace('{d}', who.days).replace('{s}', who.style);
    return tgSend_(chat, msg, tgDeskSetMenu_());
  }
  if (text.indexOf('ساعت شروع') > -1) { tgSetVal_('dsk', chat, 'start'); return tgSend_(chat, T_DESK_ASK_START); }
  if (text.indexOf('ساعت پایان') > -1) { tgSetVal_('dsk', chat, 'end'); return tgSend_(chat, T_DESK_ASK_END); }
  if (text.indexOf('سبک اعلان') > -1) { tgSetVal_('dsk', chat, 'style'); return tgSend_(chat, T_DESK_ASK_STYLE, tgDeskStyleKb_()); }
  if (text.indexOf('روزهای کاری') > -1) { tgSetVal_('dsk', chat, 'days'); return tgSend_(chat, T_DESK_ASK_DAYS, tgDeskDaysKb_()); }
  if (text === TG_DUTY_BTN) return tgDutyShow_(chat, who);
  if (text === TG_COLLQ_BTN) return tgCollQueue_(chat);
  if (text === TG_INPQ_BTN) return tgInpQueue_(chat);
  if (text.indexOf('کارهای روی زمین') > -1) return tgDeskOpen_(chat);
  if (text.indexOf('خلاصهٔ امروز') > -1 || text.indexOf('خلاصه امروز') > -1) return tgDeskToday_(chat);

  return tgSend_(chat, T_DESK_MENU, tgDeskMenu_());
}

function tgDeskStyleKb_() {
  const rows = TG_DESK_STYLES.map(function (s) { return [s]; });
  rows.push(['↩️ بازگشت']);
  return { keyboard: rows, resize_keyboard: true };
}

function tgDeskDaysKb_() {
  const rows = TG_DESK_DAYS.map(function (s) { return [s]; });
  rows.push(['↩️ بازگشت']);
  return { keyboard: rows, resize_keyboard: true };
}

/* ---------- استخرها: ساخت و خواندن تب ---------- */

// عدد اولویت را از متن سلول درمی‌آورد: «۲ – معمول» → 2 · خالی → 0
function tgPoolPri_(cell) {
  const d = tgLatinDigits_(String(cell || '')).match(/[1-3]/);
  return d ? Number(d[0]) : 0;
}

// نقشهٔ نام درمانگر → عضویت در استخرها (با کش ده‌دقیقه‌ای)
/* v87: نوع تراپی شرط قطعی است، نه ترجیح. درمانگری که زوج یا خانواده یا کودک یا روان‌پزشکی
   کار نمی‌کند، هیچ‌وقت برای آن پیشنهاد نمی‌شود، حتی اگر فهرست خالی بماند. */
var TG_POOL_HARD = { rel: 'زوج و رابطه', fam: 'خانواده و والدگری', kid: 'کودک و نوجوان', psy: 'روان‌پزشکی' };

function tgPoolMap_() {
  if (TG_DRY) return TG_MEM['poolmap'] || {};
  const c = CacheService.getScriptCache();
  const hit = c.get('pools');
  if (hit) { try { return JSON.parse(hit); } catch (e) {} }

  const sh = tgSS_().getSheetByName(TG_POOLS_TAB);
  const out = {};
  if (!sh || sh.getLastRow() < 4) { c.put('pools', '{}', 120); return out; }

  const v = sh.getRange(4, 1, sh.getLastRow() - 3, TG_POOL_LAST).getValues();
  for (var i = 0; i < v.length; i++) {
    const name = String(v[i][0]).trim();
    if (!name) continue;
    const rec = { abroad: /بله/.test(String(v[i][TG_POOL_ABROAD - 1])),
                  inperson: /بله/.test(String(v[i][TG_POOL_INPERSON - 1])) };
    for (var j = 0; j < TG_POOL_DEFS.length; j++) {
      const p = tgPoolPri_(v[i][TG_POOL_DEFS[j].col - 1]);
      if (p) rec[TG_POOL_DEFS[j].key] = p;
    }
    out[tgNorm_(name)] = rec;
  }
  c.put('pools', JSON.stringify(out), 600);
  return out;
}

// اولویت پیش‌فرض «فردی بزرگسال» از ردهٔ ارجاع فعلی شیت درمانگران
function tgPoolSeed_(tierText, status) {
  if (String(status).trim() !== 'فعال') return '';
  const n = tgPoolPri_(tgLatinDigits_(String(tierText)).replace(/[^0-9]/g, ' '));
  const t = tgLatinDigits_(String(tierText));
  if (t.indexOf('1') > -1) return TG_POOL_PRI[0];
  if (t.indexOf('2') > -1) return TG_POOL_PRI[1];
  if (t.indexOf('3') > -1) return TG_POOL_PRI[2];
  if (t.indexOf('4') > -1) return TG_POOL_PRI[1];   // هنوز معارفه نداشته: فرصت بده
  return TG_POOL_PRI[2];                            // دادهٔ کم
}

// تب «استخرها» را می‌سازد یا تازه می‌کند؛ انتخاب‌های مسئول پذیرش دست‌نخورده می‌ماند
function tgBuildPools() {
  const ss = tgSS_();
  const src = ss.getSheetByName(TG_THER);
  const last = src.getLastRow();
  const rows = src.getRange(4, 1, last - 3, 27).getValues();
  const prof = tgProfiles_();

  let sh = ss.getSheetByName(TG_POOLS_TAB);
  const fresh = !sh;
  if (fresh) sh = ss.insertSheet(TG_POOLS_TAB);

  // انتخاب‌های قبلی مسئول پذیرش را نگه دار
  const keep = {};
  if (!fresh && sh.getLastRow() >= 4) {
    const old = sh.getRange(4, 1, sh.getLastRow() - 3, sh.getLastColumn()).getValues();
    for (var i = 0; i < old.length; i++) {
      const nm = tgNorm_(String(old[i][0]));
      if (nm) keep[nm] = old[i];
    }
  }

  sh.clear();
  try { sh.getRange(1, 1, sh.getMaxRows(), sh.getMaxColumns()).clearDataValidations(); } catch (e) {}
  sh.setRightToLeft(true);
  sh.getRange(1, 1).setValue('استخرهای ارجاع — این تب را ' + tgNm_('reception') + ' ویرایش می‌کند');
  sh.getRange(2, 1).setValue('ستون‌های خاکستری خودکارند و از پروندهٔ درمانگران پر می‌شوند. در ستون‌های رنگی اولویت را انتخاب کنید: ۱ اول صف، ۲ معمول، ۳ ذخیره. خالی یعنی این درمانگر در آن استخر نیست.');
  sh.getRange(1, 1, 1, TG_POOL_LAST).merge().setFontSize(13).setFontWeight('bold');
  sh.getRange(2, 1, 1, TG_POOL_LAST).merge().setFontSize(10).setFontColor('#6b6b73').setWrap(true);

  const head = ['نام درمانگر', 'وضعیت همکاری', 'جنسیت', 'رویکرد', 'حداقل ویزیت', 'محل سکونت', 'وصل به بات', 'لینک جلسه'];
  for (var j = 0; j < TG_POOL_DEFS.length; j++) head.push(TG_POOL_DEFS[j].name);
  head.push('خارج از ایران', 'جلسهٔ حضوری', 'پذیرش همهٔ هویت‌ها', 'یادداشت');
  sh.getRange(3, 1, 1, head.length).setValues([head]).setFontWeight('bold').setBackground('#f3efec').setWrap(true);
  sh.setFrozenRows(3);

  const body = [];
  let matched = 0, auto = 0;
  for (var r = 0; r < rows.length; r++) {
    const name = String(rows[r][0]).trim();
    if (!name) continue;
    const nm = tgNorm_(name);
    const p = prof.rows[nm] || null;
    if (p) matched++;

    let status = String(rows[r][1]).trim();
    if (prof.ended[nm]) status = 'پایان همکاری';

    const line = [
      name,
      status,
      (p && p.gender) || String(rows[r][2]).trim(),
      (p && p.approach ? p.approach : String(rows[r][4]).trim()).slice(0, 60),
      (p && p.fee) || '',
      (p && p.city) || '',
      String(rows[r][22]).trim() ? 'بله' : 'خیر',
      String(rows[r][26]).trim() ? 'بله' : 'خیر'
    ];

    const prev = keep[nm];
    const sp = p ? tgSrvPools_(p.services) : {};
    const active = status === 'فعال' || (p && !prof.ended[nm]);

    for (var d2 = 0; d2 < TG_POOL_DEFS.length; d2++) {
      const key = TG_POOL_DEFS[d2].key;
      const old = prev ? String(prev[TG_POOL_DEFS[d2].col - 1] || '').trim() : '';
      if (old) { line.push(old); continue; }
      if (key === 'psy') { line.push(''); continue; }
      if (active && sp[key]) { line.push(key === 'ind' ? tgPoolSeed_(rows[r][12], 'فعال') || TG_POOL_PRI[1] : TG_POOL_PRI[1]); auto++; }
      else if (key === 'ind' && active && !p) line.push(tgPoolSeed_(rows[r][12], String(rows[r][1]).trim()));
      else line.push('');
    }

    const oldAb = prev ? String(prev[TG_POOL_ABROAD - 1] || '').trim() : '';
    line.push(oldAb || ((p && tgIsAbroadCity_(p.city)) || String(rows[r][19]).trim() ? 'بله' : ''));
    const oldIn = prev ? String(prev[TG_POOL_INPERSON - 1] || '').trim() : '';
    line.push(oldIn || (((p && p.mode.indexOf('هر دو') > -1) || String(rows[r][3]).indexOf('هر دو') > -1) ? 'بله' : ''));
    const oldLg = prev ? String(prev[TG_POOL_LGBT - 1] || '').trim() : '';
    line.push(oldLg || (p && p.lgbt ? 'بله' : ''));
    line.push(prev ? String(prev[TG_POOL_LAST - 1] || '') : '');

    body.push(line);
  }

  sh.getRange(4, 1, body.length, head.length).setValues(body);

  const pri = SpreadsheetApp.newDataValidation().requireValueInList(TG_POOL_PRI, true).setAllowInvalid(false).build();
  const yes = SpreadsheetApp.newDataValidation().requireValueInList(['بله'], true).setAllowInvalid(false).build();
  for (var d3 = 0; d3 < TG_POOL_DEFS.length; d3++) sh.getRange(4, TG_POOL_DEFS[d3].col, body.length, 1).setDataValidation(pri);
  sh.getRange(4, TG_POOL_ABROAD, body.length, 3).setDataValidation(yes);

  sh.getRange(3, 1, body.length + 1, 8).setBackground('#f7f7f8').setFontColor('#5a5a63');
  sh.getRange(3, 1, 1, 8).setFontColor('#3a3a40');
  sh.getRange(3, TG_POOL_FIRST, 1, 5).setBackground('#fbe9ea');
  sh.getRange(3, TG_POOL_ABROAD, 1, 3).setBackground('#eaf2fb');
  sh.setColumnWidth(1, 170);
  sh.setColumnWidth(4, 200);
  for (var w = TG_POOL_FIRST; w <= TG_POOL_LAST; w++) sh.setColumnWidth(w, 105);

  CacheService.getScriptCache().remove('pools');
  Logger.log('تب «' + TG_POOLS_TAB + '»: ' + body.length + ' سطر · ' + matched +
             ' نفر در پروندهٔ کامل پیدا شدند · ' + auto + ' خانهٔ استخر خودکار پر شد · ' +
             Object.keys(prof.rows).length + ' پروفایل خوانده شد · ' + Object.keys(prof.ended).length + ' قطع همکاری');
}

/* ---------- استخرها: انتخاب درمانگر ---------- */

// از وقت‌های آزاد فقط آن‌هایی را نگه می‌دارد که به استخر این مراجع می‌خورند
function tgPoolFilter_(slots, chat, over) {
  if (!slots || !slots.length || (!chat && !over)) return slots;
  let map;
  try { map = tgPoolMap_(); } catch (e) { return slots; }
  const names = Object.keys(map);
  if (!names.length) return slots;

  const topic = over ? String(over.topic || '') : String(tgGetVal_('qt', chat) || '');
  const pool = TG_TOPIC_POOL[topic] || '';
  const abroad = over ? !!over.abroad : String(tgGetVal_('tz', chat) || '') !== 'ir' && String(tgGetVal_('tz', chat) || '') !== '';

  function distinct(list) {
    const s = {}; let n = 0;
    for (var i = 0; i < list.length; i++) if (!s[list[i].therapist]) { s[list[i].therapist] = 1; n++; }
    return n;
  }
  function rec(s) { return map[tgNorm_(s.therapist)] || null; }

  let cand = slots;
  const hard = !!TG_POOL_HARD[pool];

  // ۱) عضویت در استخر موضوع
  if (pool) {
    const inPool = slots.filter(function (s) { const r = rec(s); return r && r[pool]; });
    if (hard) cand = inPool;                       /* شرط قطعی، حتی اگر یک نفر یا هیچ‌کس بماند */
    else if (distinct(inPool) >= 2) cand = inPool; /* فردی: اگر کم بود، آبشاری به بقیه */
  }

  // ۲) اگر مراجع خارج از ایران است، درمانگرانی که این را پذیرفته‌اند
  if (abroad) {
    const ok = cand.filter(function (s) { const r = rec(s); return r && r.abroad; });
    if (distinct(ok) >= 2) cand = ok;
  }

  // ۳) اولویت مسئول پذیرش: اول صف اول، و اگر کم بود ردهٔ بعدی هم اضافه شود
  if (pool) {
    for (var p = 1; p <= 3; p++) {
      const tier = cand.filter(function (s) { const r = rec(s); return r && r[pool] && r[pool] <= p; });
      if (distinct(tier) >= 2) { cand = tier; break; }
    }
  }

  return cand.length ? cand : (hard ? [] : slots);
}

function tgHasStrongTopic_(clean) {
  for (var i = 0; i < TG_TOPIC_STRONG.length; i++) {
    if (clean.indexOf(tgNorm_(TG_TOPIC_STRONG[i])) > -1) return true;
  }
  return false;
}

function tgCrisisStrong_(text) {
  const t = tgNorm_(text);
  for (var i = 0; i < TG_CRISIS_STRONG.length; i++) {
    if (t.indexOf(tgNorm_(TG_CRISIS_STRONG[i])) > -1) return true;
  }
  return false;
}

function tgHasTopic_(clean) {
  for (var i = 0; i < TG_TOPIC_WORDS.length; i++) {
    if (clean.indexOf(tgNorm_(TG_TOPIC_WORDS[i])) > -1) return true;
  }
  return false;
}

/* ---------- تطبیق با سؤالات متداول ---------- */

function tgLatinDigits_(s) {
  return String(s == null ? '' : s)
    .replace(/[\u06F0-\u06F9]/g, function (d) { return String(d.charCodeAt(0) - 1776); })
    .replace(/[\u0660-\u0669]/g, function (d) { return String(d.charCodeAt(0) - 1632); });
}

function tgNorm_(s) {
  return tgLatinDigits_(s)
    .replace(/[\u064A\u06CC]/g, '\u06CC').replace(/[\u0643\u06A9]/g, '\u06A9')
    .replace(/[\u200B-\u200F\uFEFF]/g, ' ')
    .replace(/[\u064B-\u0652\u0640]/g, '')
    .replace(/[^\u0600-\u06FF\w\s]/g, ' ')
    .replace(/\s+/g, ' ')
    .toLowerCase().trim();
}

function tgTokens_(s) {
  const out = [], parts = tgNorm_(s).split(' ');
  for (var i = 0; i < parts.length; i++) {
    const w = parts[i];
    if (w.length < 3 || TG_STOPWORDS[w]) continue;
    out.push(w);
  }
  return out;
}

function tgFaqMatch_(text, threshold) {
  const list = tgFaq_();
  if (!list.length) return null;
  const words = tgTokens_(text);
  if (!words.length) return null;
  const msg = ' ' + tgNorm_(text) + ' ';

  let best = null, bestScore = 0;
  for (var i = 0; i < list.length; i++) {
    const qTok = tgTokens_(list[i].q);
    if (!qTok.length) continue;
    let hit = 0;
    for (var j = 0; j < qTok.length; j++) {
      const t = qTok[j];
      if (msg.indexOf(t) > -1) { hit += 1; continue; }
      if (t.length > 4 && msg.indexOf(t.slice(0, t.length - 1)) > -1) hit += 0.7;
    }
    let score = hit / qTok.length;
    const aTok = tgTokens_(list[i].a);
    let ah = 0;
    for (var k = 0; k < words.length; k++) if (aTok.indexOf(words[k]) > -1) ah++;
    score += Math.min(ah, 3) * 0.05;
    if (score > bestScore) { bestScore = score; best = list[i]; }
  }
  return bestScore >= threshold ? best : null;
}


  'پذیرش': tgNm_('reception')
};

const TG_SECTION_WORDS = [
  ['مدرسه', ['مدرسه', 'دوره', 'کلاس', 'آموزش', 'ثبت‌نام', 'ثبت نام', 'سوپرویژن', 'شهریه']],
  ['روان‌پزشکی', ['روانپزشک', 'روان‌پزشک', 'دارو', 'سایکیاتر']],
  ['سازمانی', ['سازمان', 'شرکت', 'کارکنان', 'منابع انسانی']]
];

/* بخش را اول از الگوی «سایت › بخش › …» می‌گیرد، وگرنه از کلیدواژه حدس می‌زند */
function tgSection_(src, note) {
  const s = String(src || '');
  const parts = s.split('›');
  /* v170.16: «کمپین › C-004 › <نوع>» لید مراجع است و کشیک پذیرش باید خبر بگیرد (tgDutyClinic_) */
  if (parts.length > 1 && String(parts[0]).trim() === 'کمپین') return 'پذیرش';
  if (parts.length > 1) {
    const sec = String(parts[1]).trim();
    if (sec) return sec;
  }
  const hay = s + ' ' + String(note || '');
  for (var i = 0; i < TG_SECTION_WORDS.length; i++) {
    const ws = TG_SECTION_WORDS[i][1];
    for (var j = 0; j < ws.length; j++) if (hay.indexOf(ws[j]) > -1) return TG_SECTION_WORDS[i][0];
  }
  return 'پذیرش';
}

function tgOwnerFor_(section) {
  const s = String(section || '').trim();
  if (TG_SECTION_OWNER[s]) return TG_SECTION_OWNER[s];
  const keys = Object.keys(TG_SECTION_OWNER);
  for (var i = 0; i < keys.length; i++) if (s.indexOf(keys[i]) > -1) return TG_SECTION_OWNER[keys[i]];
  return tgNm_('reception');
}

/* هر لید باز بدون مسئول را به مسئول بخشش می‌دهد. SLA خودش از همین ستون گیرنده را پیدا می‌کند. */
function tgAssignTick_() {
  const sh = tgSS_().getSheetByName(TG_LEADS);
  const leads = tgOpenLeads_();
  let n = 0;
  for (var i = 0; i < leads.length; i++) {
    const l = leads[i];
    if (l.owner) continue;
    tgLeadSet_(l.row, { 'مسئول': tgOwnerFor_(tgSection_(l.src, l.note)) }, 'بات', 'بات', 'واگذاری خودکار');
    n++;
  }
  return n;
}

function tgAssignCmd_(chat, who, text) {
  const mm = String(text).match(/واگذار\s+([۰-۹0-9]+)\s+به\s+(\S+)/);
  if (!mm) return false;
  const row = Number(tgLatinDigits_(mm[1]));
  const name = mm[2].trim().replace(/[.،,]$/, '');
  const team = tgDeskRows_();
  let to = null;
  for (var i = 0; i < team.length; i++) if (team[i].name === name) to = team[i];
  if (!to) {
    tgSend_(chat, 'کسی به اسم ' + tgEsc_(name) + ' در تیم نیست. اسم‌ها: '
      + team.map(function (p) { return p.name; }).join('، '), tgDeskMenu_());
    return true;
  }
  const sh = tgSS_().getSheetByName(TG_LEADS);
  const cur = String(sh.getRange(row, 4).getValue() || '').trim();
  if (!cur) { tgSend_(chat, 'سطر ' + tgFa_(row) + ' لیدی ندارد.', tgDeskMenu_()); return true; }
  tgLeadSet_(row, { 'مسئول': name }, who.name, 'تلگرام', 'واگذاری با دستور');
  if (to.chat && String(to.chat) !== String(chat)) {
    tgSend_(to.chat, ['📌 <b>یک لید به شما واگذار شد</b>',
      'سطر ' + tgFa_(row) + ' · ' + tgEsc_(cur),
      'واگذارکننده: ' + tgEsc_(who.name)].join('\n'));
  }
  tgSend_(chat, '✅ سطر ' + tgFa_(row) + ' به ' + tgEsc_(name) + ' واگذار شد.', tgDeskMenu_());
  return true;
}


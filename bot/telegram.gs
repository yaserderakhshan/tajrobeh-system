function tgTkNew_(chat, name, topic, owner, urgent, body) {
  const now = new Date();
  const id = 'P-' + tgTkNext_();
  const tk = { id: id, topic: topic, owner: owner, urgent: urgent, body: body, ther: name, chat: String(chat) };
  if (TG_DRY) return tk;
  tgTkSheet_().appendRow([id, tgJDateFull_(now, TG_TZ), Utilities.formatDate(now, TG_TZ, 'HH:mm'),
    name, String(chat), topic, body, owner, 'باز', '', '', '', '', now]);
  return tk;
}

function tgFinSch_(chat, name, text, menuFn) {
  const st = tgGetVal_('fs', chat) || '';

  if (st === 'fin' || st === 'sch') {
    const list = st === 'fin' ? TG_FIN_TOPICS : TG_SCH_TOPICS;
    if (text.indexOf('بازگشت') > -1) { tgDel_('fs', chat); tgSend_(chat, 'برگشتیم.', menuFn()); return true; }
    const ix = tgTopicIn_(list, text);
    if (ix < 0) { tgSend_(chat, st === 'fin' ? T_FIN_PICK : T_SCH_PICK, tgKbFrom_(list)); return true; }
    tgSetVal_('fs', chat, (st === 'fin' ? 'wF' : 'wS') + ix);
    tgSend_(chat, T_TK_WRITE.replace('{t}', list[ix][0]), { remove_keyboard: true });
    return true;
  }

  if (st.indexOf('wF') === 0 || st.indexOf('wS') === 0) {
    const isFin = st.indexOf('wF') === 0;
    const list = isFin ? TG_FIN_TOPICS : TG_SCH_TOPICS;
    if (text.indexOf('بازگشت') > -1) { tgDel_('fs', chat); tgSend_(chat, 'برگشتیم.', menuFn()); return true; }
    if (tgIsBtnLike_(text)) { tgDel_('fs', chat); return false; }
    if (String(text).trim().length < 4) { tgSend_(chat, T_TK_SHORT); return true; }
    tgDel_('fs', chat);
    const t = list[Number(st.slice(2))];
    const tk = tgTkNew_(chat, name, t[0], t[1], t[2], String(text).trim());
    tgTkNotify_(tk);
    const contact = isFin ? TG_FIN_CONTACT : TG_SCH_CONTACT;
    tgSend_(chat, tgTkAck_(tk) + '\nاگر فایل یا رسیدی دارید، به ' + contact + ' بفرستید و همین شماره را کنارش بنویسید.', menuFn());
    return true;
  }

  const cmd = tgCmd_(text);
  if (text === '💳 مالی' || cmd === '/mali') {
    tgSetVal_('fs', chat, 'fin'); tgSend_(chat, T_FIN_PICK, tgKbFrom_(TG_FIN_TOPICS)); return true;
  }
  if (text === '🎓 مدرسه' || cmd === '/madrese') {
    tgSetVal_('fs', chat, 'sch'); tgSend_(chat, T_SCH_PICK, tgKbFrom_(TG_SCH_TOPICS)); return true;
  }
  return false;
}

function tgDeskAddSchool() {
  const sh = tgDeskSheet_();

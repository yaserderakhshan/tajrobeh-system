}
function tgInpPart_(a) { for (var i = 0; i < TG_INP_PARTS.length; i++) if (a >= TG_INP_PARTS[i][1] && a < TG_INP_PARTS[i][2]) return TG_INP_PARTS[i][0]; return a < 9 ? 'صبح' : 'عصر و شب'; }
/* اتاقی که آن روز در آن بازه خالی است (ردیف خودِ درخواست‌دهنده را در نظر نمی‌گیرد) */

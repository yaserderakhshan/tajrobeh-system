  if (s.length <= n) return s;
  var t = s.slice(0, n), k = Math.max(t.lastIndexOf('.'), t.lastIndexOf('؛'), t.lastIndexOf('،'));
  return (k > n * 0.6 ? t.slice(0, k + 1) : t) + '…';

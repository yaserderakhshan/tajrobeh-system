}

/* «افراد» ◂ «درمانگران»: این چت در افراد شناخته شده، همان نام در تب درمانگران
   بدون chat_id نشسته. وصلش می‌کند و پیوند را دائمی می‌نویسد. */
function tgTherLinkFromPeople_(chat) {
  if (TG_DRY) return null;
  var c = String(chat).trim();
  var p = tgPersonByChat_(c);
  if (!p) return null;
  var list = tgTherapistRows_(), hit = null;
  for (var i = 0; i < list.length; i++) {
    if (!tgSameName_(list[i].name, p.name)) continue;
    hit = list[i];
    break;
  }
  if (!hit) return null;
  if (hit.chat) return tgChatIn_(hit.chat, c) ? hit : null;
  try {
    var sh = tgSS_().getSheetByName(TG_THER);
    var pk = tgPhoneKey_(p.phone), wp = tgPhoneKey_(sh.getRange(hit.row, TG_C_WPHONE).getValue());
    if (pk && wp && pk !== wp) {
      tgErr_('tgTherLinkFromPeople_: نام یکی، شماره فرق دارد: ' + p.name);
      return null;
    }
    sh.getRange(hit.row, TG_C_CHAT).setValue(String(c));
    sh.getRange(hit.row, TG_C_CONN).setValue('وصل شد · از تب افراد');
    tgIdCacheDrop_();
    hit.chat = String(c);
  } catch (e) { tgErr_('tgTherLinkFromPeople_: ' + e); return null; }
  return hit;
}

/* «درمانگران» ◂ «افراد»: درمانگری که به بات وصل است ولی در رجیستری افراد نیست

function tgPaRTab_() { return tgInpTab_(TG_PA_RTAB, TG_PA_RHEAD); }

function tgPaObj_(head, row, i) {
  var o = { _row: i + 2 };
  for (var c = 0; c < head.length; c++) o[head[c]] = String(row[c] === undefined || row[c] === null ? '' : row[c]).trim();
  return o;
}

function tgPaRows_()    { return tgPaTab_().rows().map(function (r, i) { return tgPaObj_(TG_PN_HEAD, r, i); }); }
function tgPaReqRows_() { return tgPaRTab_().rows().map(function (r, i) { return tgPaObj_(TG_PA_RHEAD, r, i); }); }

function tgPaSet_(row, col, val) {
  tgPnHeadMem_();
  var i = TG_PN_HEAD.indexOf(col);
  if (i > -1) tgPaTab_().set(row, i + 1, val);
}

function tgPaRSet_(row, col, val) {
  var i = TG_PA_RHEAD.indexOf(col);
  if (i > -1) tgPaRTab_().set(row, i + 1, val);
}

function tgPaOf_(chat) {
  var want = String(chat || ''), rows = tgPaRows_();
  for (var i = 0; i < rows.length; i++) if (rows[i]['chat_id مسئول'] === want) return rows[i];
  return null;
}

function tgPaByCode_(code) {
  var k = String(code || '').trim();
  if (!k) return null;
  var rows = tgPaRows_();
  for (var i = 0; i < rows.length; i++) if (rows[i]['شناسه مکان'] === k) return rows[i];
  return null;
}

function tgPaPct_(o) {
  if (typeof ptPct_ === 'function') return ptPct_(o);
  var have = 0;
  for (var i = 0; i < TG_PA_FIELDS.length; i++) if (String(o[TG_PA_FIELDS[i].col] || '').trim()) have++;
  return Math.round(have * 100 / TG_PA_FIELDS.length);
}

function tgPaMissing_(o) {
  var F = (typeof ptFieldsFor_ === 'function') ? ptFieldsFor_(o) : TG_PA_FIELDS;
  return F.filter(function (f) { return !String(o[f.col] || '').trim(); });
}

function tgPaOpenReqs_(code) {
  return tgPaReqRows_().filter(function (r) {
    return r['شناسه مکان'] === code && (r['وضعیت'] === TG_PA_RST.wait || r['وضعیت'] === TG_PA_RST.call);
  });
}


/* امتیاز یک درمانگر برای یک درخواست؛ تابع خالص تا تست‌پذیر باشد */
function tgMatchScore_(t, q) {
  var s = 0, why = [];
  var pool = TG_TOPIC_POOL[q.topic] || '';
  if (pool === 'rel') why.push('زوج‌درمانی کار می‌کند');
  else if (pool === 'kid') why.push('با کودک و نوجوان کار می‌کند');
  else if (pool === 'fam') why.push('با خانواده و والدگری کار می‌کند');
  else if (pool === 'psy') why.push('ارزیابی روان‌پزشکی');
  if (q.want) {
    if (t.g === (q.want === 'زن' ? 'f' : 'm')) { s += 3; why.push(q.want === 'زن' ? 'خانم، همان‌طور که خواستید' : 'آقا، همان‌طور که خواستید'); }
    else s -= 5;
  }
  if (q.abroad) { if (t.ab) { s += 2; why.push('با فارسی‌زبانان خارج از ایران کار می‌کند'); } }
  var st = String(t.st || ''), sp = String(t.sp || '');
  if (q.style === 'active') {
    if (/فعال|مسیرده/.test(st)) { s += 3; why.push('در جلسه فعال است و مسیر می‌دهد'); }
    else if (/بسته به/.test(st)) s += 1;
    else if (/شنونده/.test(st)) s -= 1;
    if (/شناختی|طرحواره|هیجان/.test(sp)) s += 1;
  } else if (q.style === 'deep') {
    if (/شنونده/.test(st)) { s += 2; why.push('بیشتر شنونده است و با حوصله همراهی می‌کند'); }
    else if (/بسته به/.test(st)) s += 1;
    if (/روانکاوی|تحلیلی|روابط ابژه|لکان|فروید/.test(sp)) { s += 2; why.push('رویکرد تحلیلی، مناسب ریشه‌یابی'); }
  }
  var word = TG_TOPIC_WORD[q.topic] || '';
  if (word && pool !== 'rel' && pool !== 'kid' && String(t.fc || '').indexOf(word) > -1) { s += 2; why.push('روی ' + word + ' تمرکز دارد'); }
  s += (3 - (t.tr || 2.5));
  if (t.pg) s += 0.5;
  if (q.soon) { s += 1; why.push('وقت نزدیک دارد'); }
  try { var ib = tgInpMatchBoost_(t, q); s += ib.s; if (ib.why) why.unshift(ib.why); } catch (eIb) {}
  return { s: s, why: why.slice(0, 3) };
}
function tgApiMatch_(p) {

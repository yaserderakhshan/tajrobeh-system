/* ---------- ابزارهای مشترک ---------- */

function tgApTok_(id, sup) {
  var s = String(id) + '|' + String(sup || '') + '|tjsv';
  try {
    var b = Utilities.computeDigest(Utilities.DigestAlgorithm.MD5, s, Utilities.Charset.UTF_8);
    var out = '';
    for (var i = 0; i < 3; i++) { var v = (b[i] + 256) % 256; out += ('0' + v.toString(16)).slice(-2); }
    return out;
  } catch (e) {
    var h = 0;
    for (var j = 0; j < s.length; j++) { h = (h * 31 + s.charCodeAt(j)) % 16777216; }
    return ('00000' + h.toString(16)).slice(-6);
  }
}

function tgApSvUrl_(id, sup) { return TG_BOT_URL + '?start=sv-' + id + '-' + tgApTok_(id, sup); }

function tgApWho_(chat, uname) {
  var own = null, desk = null, watch = false;
  try { own = tgSchOwnerOf_(chat, uname); } catch (e) {}
  try { desk = TG_DRY ? (TG_MEM['whodesk'] || null) : tgWhoDesk_(chat, uname); } catch (e) {}
  try {
    var ids = TG_DRY ? (TG_MEM['watchids'] || []) : tgWatchIds_();
    for (var i = 0; i < ids.length; i++) if (String(ids[i]) === String(chat)) watch = true;
  } catch (e) {}
  var wname = '';
  if (watch) { try { var wp = TG_DRY ? null : tgWhoWatch_(chat, uname); wname = wp && wp.name ? wp.name : ''; } catch (e) {} }
  var me = watch ? (wname || 'ناظر') : (own ? own.name : (desk && desk.name ? desk.name : ''));
  return { own: own, desk: desk, watch: watch, lead: tgApIsLead_(desk), me: me || 'پذیرش', ok: !!(own || desk || watch) };
}

function tgApTeaRows_() {
  if (TG_DRY) return TG_MEM['tearows'] || [];
  var v = tgSchRows_(TG_SCH_T_TEA, TG_SCH_TEA_HEAD, 10), out = [];
  for (var i = 0; i < v.length; i++) {
    var n = String(v[i][0] || '').trim();
    if (!n) continue;
    out.push({
      row: i + 2, name: n,
      user: String(v[i][1] || '').trim().replace(/^@/, '').toLowerCase(),
      chat: String(v[i][2] || '').trim(), role: String(v[i][3] || '').trim(),
      area: String(v[i][4] || '').trim(), approach: String(v[i][5] || '').trim(),
      supOk: String(v[i][6] || '').trim(), status: String(v[i][7] || '').trim()
    });
  }
  return out;
}

function tgApSupList_(approach) {
  var all = [];
  try { all = tgApTeaRows_(); } catch (e) { all = []; }
  var a = String(approach || '').trim();
  var fam = '';
  try { fam = tgApproachFamily_(tgApproachNorm_(a)) || ''; } catch (e2) {}
  var hit = [], rest = [];
  for (var i = 0; i < all.length; i++) {
    var t = all[i];
    if (t.supOk !== 'بله') continue;
    if (t.role.indexOf('سوپروایزر') < 0) continue;
    var ex = false;
    if (a && t.approach) {
      var A = String(tgNorm_(a)).toLowerCase(), B = String(tgNorm_(t.approach)).toLowerCase();
      if (A && B && (A.indexOf(B) > -1 || B.indexOf(A) > -1)) ex = true;
    }
    if (!ex && fam) {
      var fb = '';
      try { fb = tgApproachFamily_(tgApproachNorm_(t.approach)) || ''; } catch (e3) {}
      if (fb && fb === fam) ex = true;
    }
    (ex ? hit : rest).push({ name: t.name, approach: t.approach, chat: t.chat, row: t.row, exact: ex });
  }
  return hit.concat(rest);
}

function tgApSupBy_(name) {
  var all = [];
  try { all = tgApTeaRows_(); } catch (e) { return null; }
  var q = tgNorm_(name), hit = null;
  for (var i = 0; i < all.length; i++) if (all[i].name === String(name).trim() || tgNorm_(all[i].name) === q) { hit = all[i]; break; }
  if (hit && !hit.chat) { var f = tgApSupChat_(name); if (f) { hit.chat = f.chat; if (!hit.user && f.user) hit.user = String(f.user).replace(/^@/, '').toLowerCase(); } }   /* v159 */
  if (!hit) { var f2 = tgApSupChat_(name); if (f2) hit = { name: String(name).trim(), user: String(f2.user || '').replace(/^@/, '').toLowerCase(), chat: f2.chat, role: 'سوپروایزر', approach: '', supOk: '', status: '' }; }
  return hit;
}


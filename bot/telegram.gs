function tgPaDeskText_(o) {
  var t = '🏢 <b>میز پارتنر تجربه</b>\n' + tgEsc_(o['نام نمایشی'] || o['شهر']) + ' · ' + tgEsc_(o['شهر']) + '\n\n';
  t += 'وضعیت: ' + tgEsc_(o['وضعیت'] || 'در انتظار تأیید') + '\n';
  t += 'تکمیل اطلاعات فضا: ' + tgFa_(tgPaPct_(o)) + ' درصد\n';
  t += 'قواعد همکاری: ' + (o['قواعد را پذیرفت'] === 'بله' ? 'پذیرفته‌اید' : 'هنوز تأیید نشده') + '\n';
  t += 'درخواست درمانگر در انتظار شما: ' + tgFa_(tgPaOpenReqs_(o['شناسه مکان']).length) + '\n';
  if (String(o['وضعیت متن محلی'] || '') === TG_PA_LST.ask) t += '\n✍️ متن معرفی شهر شما را منتظریم.';
  var miss = tgPaMissing_(o);
  if (miss.length) t += '\n\nهنوز مانده: ' + miss.map(function (f) { return f.col; }).join('، ');
  return t;
}

function tgPaDeskKb_(o) {
  var kb = [];
  if (o['قواعد را پذیرفت'] !== 'بله') kb.push([{ text: '📋 قواعد همکاری', callback_data: 'pa:ru' }]);
  kb.push([{ text: '🏠 اطلاعات فضا', callback_data: 'pa:fl' }]);
  kb.push([{ text: '🗓 اتاق‌ها و ساعت‌های فضای من', callback_data: 'pa:sp' }]);
  kb.push([{ text: '🤝 درخواست درمانگرها', callback_data: 'pa:rq' }]);
  if (String(o['وضعیت متن محلی'] || '') === TG_PA_LST.ask) kb.push([{ text: '✍️ متن معرفی شهر', callback_data: 'pa:lo' }]);
  if (o['قواعد را پذیرفت'] === 'بله') kb.push([{ text: '📋 قواعد همکاری', callback_data: 'pa:ru' }]);
  kb.push([{ text: '💬 پیام به تجربه', callback_data: 'pa:sy' }]);
  return { inline_keyboard: kb };
}

function tgPaDesk_(chat) {
  var o = tgPaOf_(chat);
  if (!o) return tgSend_(chat, 'این میز برای پارتنرهای حضوری تجربه است. اگر فضای شما پارتنر تجربه است و اینجا شناخته نشده‌اید، به پذیرش بگویید.');
  return tgSend_(chat, tgPaDeskText_(o), tgPaDeskKb_(o));
}

/* ---------- قواعد ---------- */

function tgPaRulesText_(o) {
  var t = '📋 <b>قواعد همکاری تجربه پارتنرز</b>\n\n';
  for (var i = 0; i < TG_PA_RULES.length; i++) t += tgFa_(i + 1) + '. ' + tgEsc_(TG_PA_RULES[i]) + '\n\n';
  t += 'نشانی ثابت همین قواعد روی سایت: ' + TG_PA_RULES_URL + '\n';
  t += 'سند کامل و برند گاید پارتنرز را پذیرش برایتان می‌فرستد. اگر جایی سؤال دارید همین‌جا بنویسید.';
  if (o && o['قواعد را پذیرفت'] === 'بله') t += '\n\n✅ شما این قواعد را در ' + tgEsc_(o['تاریخ پذیرش قواعد']) + ' تأیید کرده‌اید.';
  return t;
}

function tgPaRules_(chat) {
  var o = tgPaOf_(chat);
  if (!o) return null;
  var kb = o['قواعد را پذیرفت'] === 'بله' ? { inline_keyboard: [[{ text: '↩️ بازگشت به میز', callback_data: 'pa:dk' }]] }
    : { inline_keyboard: [[{ text: '✅ می‌پذیرم', callback_data: 'pa:ra' }], [{ text: '↩️ بازگشت', callback_data: 'pa:dk' }]] };
  return tgSend_(chat, tgPaRulesText_(o), kb);
}

function tgPaAccept_(chat) {
  var o = tgPaOf_(chat);
  if (!o) return null;
  tgPaSet_(o._row, 'قواعد را پذیرفت', 'بله');
  tgPaSet_(o._row, 'تاریخ پذیرش قواعد', tgJDateFull_(new Date(), TG_TZ));
  tgSend_(chat, '✅ ثبت شد. ممنون.\n\nحالا اطلاعات فضا را کامل کنیم تا مراجع‌ها بتوانند شما را روی سایت ببینند.');
  try { tgInpDeskSay_('📋 پارتنر ' + tgEsc_(o['نام نمایشی'] || o['شهر']) + ' قواعد همکاری را تأیید کرد.'); } catch (e) {}
  return tgPaDesk_(chat);
}

/* ---------- تکمیل اطلاعات فضا ---------- */

function tgPaFillKb_(o) {
  var kb = [], row = [];
  for (var i = 0; i < TG_PA_FIELDS.length; i++) {
    var f = TG_PA_FIELDS[i];
    row.push({ text: (String(o[f.col] || '').trim() ? '✅ ' : '▫️ ') + f.col, callback_data: 'pa:fq:' + f.k });
    if (row.length === 2) { kb.push(row); row = []; }
  }
  if (row.length) kb.push(row);
  kb.push([{ text: '↩️ بازگشت به میز', callback_data: 'pa:dk' }]);
  return { inline_keyboard: kb };
}

function tgPaFill_(chat) {
  var o = tgPaOf_(chat);
  if (!o) return null;
  return tgSend_(chat, '🏠 <b>اطلاعات فضا</b>\nهر مورد را که می‌زنید، جوابش را همین‌جا بنویسید. هر وقت خواستید می‌توانید ادامه بدهید.\n\nتکمیل‌شده: ' + tgFa_(tgPaPct_(o)) + ' درصد', tgPaFillKb_(o));
}

function tgPaField_(k) {
  for (var i = 0; i < TG_PA_FIELDS.length; i++) if (TG_PA_FIELDS[i].k === k) return TG_PA_FIELDS[i];
  return null;
}

function tgPaAskField_(chat, k) {
  var f = tgPaField_(k), o = tgPaOf_(chat);
  if (!f || !o) return null;
  tgSetVal_('paf', chat, k);
  var now = String(o[f.col] || '').trim();
  return tgSend_(chat, '✍️ ' + tgEsc_(f.q) + (now ? '\n\nالان ثبت شده: ' + tgEsc_(now) : ''),
    { inline_keyboard: [[{ text: '↩️ بازگشت', callback_data: 'pa:fl' }]] });
}

function tgPaSaveField_(chat, text) {
  var k = tgGetVal_('paf', chat), f = tgPaField_(k), o = tgPaOf_(chat);
  tgDel_('paf', chat);
  if (!f || !o) return null;
  tgPaSet_(o._row, f.col, String(text || '').trim());
  var o2 = tgPaOf_(chat), pct = tgPaPct_(o2);
  tgPaSet_(o2._row, 'درصد تکمیل', tgFa_(pct) + '٪');
  if (pct === 100) {
    try { tgInpDeskSay_('🏢 پارتنر ' + tgEsc_(o2['نام نمایشی'] || o2['شهر']) + ' اطلاعات فضا را کامل کرد. آمادهٔ بررسی و انتشار صفحه است.'); } catch (e) {}
  }
  tgSend_(chat, '✅ ثبت شد.');
  return tgPaFill_(chat);
}

/* ---------- درخواست درمانگرها ---------- */

function tgPaReqCard_(r) {
  var t = '🤝 <b>درخواست فضای حضوری · ' + tgEsc_(r['کد']) + '</b>\n' +
    tgEsc_(r['نام درمانگر']) + ' · ' + tgEsc_(r['شهر']) + '\n';
  if (r['رویکرد']) t += 'رویکرد: ' + tgEsc_(r['رویکرد']) + '\n';
  if (r['روزهای پیشنهادی']) t += 'روزهای پیشنهادی: ' + tgEsc_(r['روزهای پیشنهادی']) + '\n';
  if (r['توضیح درمانگر']) t += '\n' + tgEsc_(r['توضیح درمانگر']) + '\n';
  if (r['صفحهٔ درمانگر']) t += '\nرزومه و صفحهٔ درمانگر: ' + tgEsc_(r['صفحهٔ درمانگر']) + '\n';
  t += '\nوضعیت: ' + tgEsc_(r['وضعیت']);
  return t;
}

function tgPaReqKb_(code) {
  return { inline_keyboard: [
    [{ text: '✅ تأیید می‌کنم', callback_data: 'pa:dc:' + code + ':ok' }],
    [{ text: '📞 اول تماس تلفنی', callback_data: 'pa:dc:' + code + ':call' },
     { text: '⛔ رد', callback_data: 'pa:dc:' + code + ':no' }],
    [{ text: '↩️ بازگشت به میز', callback_data: 'pa:dk' }]
  ] };
}

function tgPaReqs_(chat) {
  var o = tgPaOf_(chat);
  if (!o) return null;
  var list = tgPaOpenReqs_(o['شناسه مکان']);
  if (!list.length) return tgSend_(chat, 'الان درخواست تازه‌ای ندارید.', { inline_keyboard: [[{ text: '↩️ بازگشت به میز', callback_data: 'pa:dk' }]] });
  for (var i = 0; i < list.length && i < 6; i++) tgSend_(chat, tgPaReqCard_(list[i]), tgPaReqKb_(list[i]['کد']));
  return null;
}

function tgPaReqByCode_(code) {
  var k = String(code || '').trim(), rows = tgPaReqRows_();
  for (var i = 0; i < rows.length; i++) if (rows[i]['کد'] === k) return rows[i];
  return null;
}

function tgPaDecide_(chat, code, what) {
  var r = tgPaReqByCode_(code), o = tgPaOf_(chat);
  if (!r || !o || r['شناسه مکان'] !== o['شناسه مکان']) return null;
  var st = what === 'ok' ? TG_PA_RST.ok : (what === 'call' ? TG_PA_RST.call : TG_PA_RST.no);
  tgPaRSet_(r._row, 'وضعیت', st);
  tgPaRSet_(r._row, 'پاسخ پارتنر', st);
  tgPaRSet_(r._row, 'زمان پاسخ', tgJDateFull_(new Date(), TG_TZ));
  var who = tgEsc_(r['نام درمانگر']), place = tgEsc_(o['نام نمایشی'] || o['شهر']);
  if (what === 'ok') {
    tgSend_(chat, '✅ تأیید شما ثبت شد. پذیرش هماهنگی روز و ساعت را با ' + who + ' پیش می‌برد.');
    if (r['chat_id']) tgSend_(Number(r['chat_id']), '✅ <b>پارتنر ' + place + ' با همکاری حضوری شما موافقت کرد.</b>\n\nپذیرش تجربه برای هماهنگی روز و ساعت و شروع کار با شما تماس می‌گیرد.');
  } else if (what === 'call') {
    tgSend_(chat, '📞 ثبت شد. پذیرش یک تماس تلفنی بین شما و ' + who + ' هماهنگ می‌کند.');
    if (r['chat_id']) tgSend_(Number(r['chat_id']), '📞 پارتنر ' + place + ' پیش از تصمیم می‌خواهد یک تماس کوتاه داشته باشید. پذیرش تجربه هماهنگ می‌کند.');
  } else {
    tgSend_(chat, 'ثبت شد. به پذیرش خبر می‌دهیم.');
    if (r['chat_id']) tgSend_(Number(r['chat_id']), 'دربارهٔ فضای حضوری ' + tgEsc_(o['شهر']) + ' فعلاً امکان همکاری فراهم نشد. پذیرش تجربه گزینه‌های دیگر را با شما مرور می‌کند.');
  }
  try { tgInpDeskSay_('🤝 پاسخ پارتنر ' + place + ' به درخواست ' + tgEsc_(r['کد']) + ' (' + who + '): <b>' + tgEsc_(st) + '</b>'); } catch (e) {}
  return null;
}

/* ---------- درمانگر درخواست می‌دهد ---------- */

function tgPaCityKb_() {
  var kb = [];
  var list = tgPaRows_().filter(function (o) {
    var st = o['وضعیت'] || '';
    return st === 'فعال' || st === 'آمادهٔ انتشار' || st === 'در انتظار تأیید';
  });
  for (var i = 0; i < list.length; i++) {
    kb.push([{ text: list[i]['شهر'] + (list[i]['نام نمایشی'] ? ' · ' + list[i]['نام نمایشی'] : ''), callback_data: 'pa:jp:' + list[i]['شناسه مکان'] }]);
  }
  return kb;
}

function tgPaJoin_(chat) {
  var kb = tgPaCityKb_();
  if (!kb.length) return tgSend_(chat, 'الان فضای پارتنر فعالی برای درخواست نداریم. به‌زودی خبر می‌دهیم.');
  return tgSend_(chat, '🏢 <b>فضای حضوری پارتنر تجربه</b>\n\nدر این شهرها فضای حضوری داریم. اگر ساکن یکی از این‌ها هستید می‌توانید درخواست بدهید و بعضی جلسه‌ها را حضوری ببرید. پذیرش و پرداخت مثل همیشه در تجربه می‌ماند.\n\nکدام شهر؟', { inline_keyboard: kb });
}

function tgPaNextCode_() {
  var rows = tgPaReqRows_(), n = 0;
  for (var i = 0; i < rows.length; i++) {
    var m = String(rows[i]['کد'] || '').match(/(\d+)/);
    if (m && Number(m[1]) > n) n = Number(m[1]);
  }
  var s = String(n + 1);
  while (s.length < 3) s = '0' + s;
  return 'ح-' + s;
}

function tgPaTherInfo_(chat, name, uname) {
  var out = { approach: '', city: '', page: '', name: String(name || '').trim() };
  try {
    var who = tgWhoPerson_(chat, uname || '');
    if (who) {
      if (!out.name && who.name) out.name = who.name;
      if (who.approach) out.approach = String(who.approach);
    }
  } catch (e) {}
  try {
    if (typeof tgPrAll_ === 'function') {
      var all = tgPrAll_();
      for (var i = 0; i < all.length; i++) {
        var v = all[i].v || {};
        var same = (String(v.chat || '') && String(v.chat) === String(chat)) ||
                   (out.name && String(v.name || '').trim() === out.name);
        if (!same) continue;
        if (!out.approach) out.approach = String(v.approach || '');
        out.city = String(v.city || '');
        var sl = String(v.site_slug || '').trim();
        if (sl) out.page = 'tajrobeh.life/team/' + sl + '/';
        break;
      }
    }
  } catch (e2) {}
  return out;
}

function tgPaJoinPick_(chat, code) {
  var p = tgPaByCode_(code);
  if (!p) return null;
  tgSetVal_('paj', chat, code);
  return tgSend_(chat, 'برای ' + tgEsc_(p['شهر']) + ' ثبت می‌کنیم.\n\nدر یک پیام بنویسید: کدام روزها و ساعت‌ها می‌توانید حضوری باشید، و اگر نکته‌ای هست که پارتنر باید بداند. رزومه و رویکرد شما از پروفایل خودتان برداشته می‌شود.',
    { inline_keyboard: [[{ text: '↩️ انصراف', callback_data: 'pa:jx' }]] });
}

function tgPaJoinSave_(chat, text, name, uname) {
  var code = tgGetVal_('paj', chat);
  tgDel_('paj', chat);
  var p = tgPaByCode_(code);
  if (!p) return null;
  var info = tgPaTherInfo_(chat, name, uname);
  var id = tgPaNextCode_();
  tgPaRTab_().append([id, tgJDateFull_(new Date(), TG_TZ), info.name || name || '', String(chat),
    uname ? '@' + String(uname).replace(/^@/, '') : '', p['شهر'], p['شناسه مکان'],
    info.approach, info.page, '', String(text || '').trim(), TG_PA_RST.wait, '', '', '', '']);
  tgSend_(chat, '✅ درخواست شما ثبت شد.\n\nپارتنر ' + tgEsc_(p['نام نمایشی'] || p['شهر']) + ' آن را می‌بیند و تأیید می‌کند یا اول یک تماس کوتاه می‌خواهد. نتیجه را همین‌جا به شما می‌گوییم.');
  var r = tgPaReqByCode_(id);
  if (p['chat_id مسئول'] && r) tgSend_(Number(p['chat_id مسئول']), tgPaReqCard_(r), tgPaReqKb_(id));
  try { tgInpDeskSay_('🤝 درخواست تازهٔ فضای حضوری ' + tgEsc_(id) + ' برای ' + tgEsc_(p['شهر']) + ' از ' + tgEsc_(info.name || name || '') + '.'); } catch (e) {}
  return null;
}

/* ---------- متن محلی صفحهٔ شهر ---------- */

function tgPaLocalAsk(code) {
  var p = tgPaByCode_(code);
  if (!p) return 'پارتنر پیدا نشد';
  tgPaSet_(p._row, 'وضعیت متن محلی', TG_PA_LST.ask);
  if (p['chat_id مسئول']) tgSend_(Number(p['chat_id مسئول']), '✍️ <b>یک متن کوتاه از شما می‌خواهیم</b>\n\nبرای صفحهٔ ' + tgEsc_(p['شهر']) + ' روی سایت تجربه، چند خط از زبان خودتان لازم داریم: فضا چه شکلی است، مراجع وقتی می‌آید چه می‌بیند، دسترسی چطور است، و اگر نکتهٔ محلی مهمی هست.\n\nلازم نیست تمیز باشد؛ ما بازبینی و ویرایش می‌کنیم و پیش از انتشار به شما نشان می‌دهیم.', { inline_keyboard: [[{ text: '✍️ می‌نویسم', callback_data: 'pa:lo' }]] });
  return 'ok';
}

function tgPaLocal_(chat) {
  var o = tgPaOf_(chat);
  if (!o) return null;
  tgSetVal_('pal', chat, '1');
  return tgSend_(chat, '✍️ متن معرفی ' + tgEsc_(o['شهر']) + ' را در یک پیام بنویسید. هر چقدر که راحتید؛ ما ویرایش می‌کنیم.',
    { inline_keyboard: [[{ text: '↩️ بازگشت', callback_data: 'pa:dk' }]] });
}

function tgPaLocalSave_(chat, text) {
  tgDel_('pal', chat);
  var o = tgPaOf_(chat);
  if (!o) return null;
  tgPaSet_(o._row, 'متن محلی صفحه', String(text || '').trim());
  tgPaSet_(o._row, 'وضعیت متن محلی', TG_PA_LST.got);
  tgSend_(chat, '✅ رسید. ممنون. بازبینی می‌کنیم و پیش از انتشار روی سایت به شما نشان می‌دهیم.');
  try { tgInpDeskSay_('✍️ متن محلی صفحهٔ ' + tgEsc_(o['شهر']) + ' از پارتنر رسید. در تب «صفحهٔ پارتنر» ستون «متن محلی صفحه» است و باید بازبینی شود.'); } catch (e) {}
  return tgPaDesk_(chat);
}

/* ---------- پیام پارتنر به تجربه ---------- */

function tgPaSayAsk_(chat) {
  tgSetVal_('pas', chat, '1');
  return tgSend_(chat, '💬 پیامتان را بنویسید. به پذیرش تجربه می‌رسد.', { inline_keyboard: [[{ text: '↩️ بازگشت', callback_data: 'pa:dk' }]] });
}

function tgPaSaySave_(chat, text) {
  tgDel_('pas', chat);
  var o = tgPaOf_(chat);
  if (!o) return null;
  try { tgInpDeskSay_('💬 پیام از پارتنر ' + tgEsc_(o['نام نمایشی'] || o['شهر']) + ':\n' + tgEsc_(String(text || '').slice(0, 900))); } catch (e) {}
  tgSend_(chat, '✅ رسید. پذیرش جواب می‌دهد.');
  return tgPaDesk_(chat);
}

/* ---------- دید پذیرش و ناظر ---------- */

function tgPaHubText_() {
  var rows = tgPaRows_();
  var t = '🏢 <b>تجربه پارتنرز</b>\n\n';
  if (!rows.length) return t + 'هنوز پارتنری ثبت نشده است.';
  for (var i = 0; i < rows.length; i++) {
    var o = rows[i], open = tgPaOpenReqs_(o['شناسه مکان']).length;
    t += '· <b>' + tgEsc_(o['شهر']) + '</b> ' + tgEsc_(o['نام نمایشی'] || '') + '\n';
    t += '  ' + tgEsc_(o['وضعیت'] || 'در انتظار تأیید') + ' · تکمیل ' + tgFa_(tgPaPct_(o)) + '٪' +
      (o['قواعد را پذیرفت'] === 'بله' ? ' · قواعد ✅' : ' · قواعد ⏳') +
      (o['chat_id مسئول'] ? '' : ' · به بات وصل نیست') + '\n';
    var sp = tgPaSpaceSum_(o['شناسه مکان']);
    if (sp.rooms || sp.hours) t += '  🗓 ' + tgFa_(sp.rooms) + ' اتاق · ' + tgFa_(sp.hours) + ' ساعت درمانگر · ' + tgFa_(sp.therapists) + ' درمانگر\n';
    if (open) t += '  🤝 ' + tgFa_(open) + ' درخواست درمانگر در انتظار\n';
    if (o['وضعیت متن محلی'] === TG_PA_LST.got) t += '  ✍️ متن محلی رسیده و بازبینی نشده\n';
  }
  return t;
}

function tgPaHub_(chat) { return tgSend_(chat, tgPaHubText_(), tgPaSpaceKb_()); }

/* ---------- کال‌بک و متن آزاد ---------- */

function tgPaOn_(cq, rest, chat, name, uname) {
  if (typeof ptPaOverride_ === 'function') { var ov = ptPaOverride_(cq, rest, chat, name, uname); if (ov !== undefined) return ov; }
  var p = String(rest || '').split(':'), a = p[0];
  if (a === 'dk') return tgPaDesk_(chat);
  if (a === 'ru') return tgPaRules_(chat);
  if (a === 'ra') return tgPaAccept_(chat);
  if (a === 'fl') return tgPaFill_(chat);
  if (a === 'sp') return p[1] ? tgPaSpaceOne_(chat, p[1]) : tgPaSpace_(chat);
  if (a === 'fq') return tgPaAskField_(chat, p[1]);
  if (a === 'rq') return tgPaReqs_(chat);
  if (a === 'dc') return tgPaDecide_(chat, p[1], p[2]);
  if (a === 'jn') return tgPaJoin_(chat);
  if (a === 'jp') return tgPaJoinPick_(chat, p[1]);
  if (a === 'jx') { tgDel_('paj', chat); return tgSend_(chat, 'باشد. هر وقت خواستید دوباره بزنید.'); }
  if (a === 'lo') return tgPaLocal_(chat);
  if (a === 'sy') return tgPaSayAsk_(chat);
  if (a === 'hb') return tgPaHub_(chat);
  return null;
}

function tgPaText_(chat, text, name, uname) {
  if (tgGetVal_('paf', chat)) return tgPaSaveField_(chat, text);
  if (tgGetVal_('pal', chat)) return tgPaLocalSave_(chat, text);
  if (tgGetVal_('pas', chat)) return tgPaSaySave_(chat, text);
  if (tgGetVal_('paj', chat)) return tgPaJoinSave_(chat, text, name, uname);
  return null;
}

function tgPaWaiting_(chat) {
  return !!(tgGetVal_('paf', chat) || tgGetVal_('pal', chat) || tgGetVal_('pas', chat) || tgGetVal_('paj', chat));
}


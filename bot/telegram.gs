function tgSchHeadFix_(tab, head) {
  var ss = tgSchSS_();
  var sh = ss.getSheetByName(tab);
  if (!sh) { sh = tgSchSheet_(tab, head); return 'ساخته شد: ' + tab; }
  var need = head.length;
  if (sh.getMaxColumns() < need) sh.insertColumnsAfter(sh.getMaxColumns(), need - sh.getMaxColumns());
  var cur = sh.getRange(1, 1, 1, need).getValues()[0];
  var changed = 0;
  for (var i = 0; i < need; i++) {
    if (String(cur[i] || '').trim() !== head[i]) {
      sh.getRange(1, i + 1).setValue(head[i]);
      changed++;
    }
  }
  sh.getRange(1, 1, 1, need).setFontWeight('bold').setBackground('#f9f2f2');
  return tab + ': ' + changed + ' ستون تنظیم شد';
}

function tgSchSetup2() {

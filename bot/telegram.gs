        res = tgFetchRetry_('https://api.telegram.org/bot' + token + '/sendPhoto', { method: 'post', muteHttpExceptions: true,
          payload: { chat_id: list[i].chat, photo: blob, caption: cap, parse_mode: 'HTML', reply_markup: JSON.stringify(kb) } });
        var j = JSON.parse(res.getContentText());
        if (j.ok) { var ph = j.result.photo; fid = ph[ph.length - 1].file_id; P.setProperty('TG_RMANN_FID', fid); }
      } else {
        res = tgPhoto_(list[i].chat, fid, cap, kb);
      }
      if (res && res.getResponseCode() === 200) { ok++; sentMine.push(list[i].chat); }
      else bad.push(list[i].name);
    } catch (e) { bad.push(list[i].name); }
    Utilities.sleep(120);
  }
  P.setProperty('TG_RMANN_' + who, JSON.stringify(sentMine));
  var rep = 'اطلاعیهٔ کاناپه · ' + (who === 'ther' ? 'درمانگرها' : 'دانشجوها') + ': ' + ok + ' رسید' + (bad.length ? ' · نرسید: ' + bad.join('، ') : '');
  try { tgWatchIds_().forEach(function (w) { tgSend_(w, '📣 ' + tgEsc_(rep)); }); } catch (e2) {}
  return rep;
}
function tgRmAnnTher() { return tgRmAnnounce('ther', true); }
function tgRmAnnSch() { return tgRmAnnounce('sch', true); }

/* ─────────── v117 · CRM لیدها در هاب پذیرش + گزارش زنده در هاب آمار ─────────── */
var TG_CRM_TAB = '🧭 CRM لیدها';
var TG_RPT_DATA = 'لیدها · داده';
var TG_RPT_TAB = '📊 گزارش پذیرش';
var TG_CRM_ST = ['تازه، بی تماس', 'در پیگیری', 'معارفه رزرو شد', 'شروع درمان', 'بسته'];
var TG_RPT_HEAD = ['کد', 'تاریخ ثبت', 'هفته', 'ماه', 'منبع', 'کانال', 'بخش', 'منطقه', 'مسئول', 'وضعیت', 'مرحله',
  'دقیقه تا تماس اول', 'تماس گرفته شد', 'معارفه', 'شروع درمان', 'بسته', 'سن (روز)', 'ردیف در لیدها', /* v168 */ 'باز'];

function tgCrmWeek_(d) {
  var s = Utilities.formatDate(d, TG_TZ, 'yyyy-MM-dd'), u = Number(Utilities.formatDate(d, TG_TZ, 'u'));
  var x = new Date(new Date(s + 'T12:00:00Z').getTime() - ((u + 1) % 7) * 86400000);
  return Number(Utilities.formatDate(x, 'UTC', 'yyyyMMdd'));
}
/* همهٔ لیدها، تمیز و یکدست؛ بدون نام مراجع */
function tgCrmRows_() {
  var sh = tgSS_().getSheetByName(TG_LEADS);
  var last = sh.getLastRow();
  if (last < 2) return [];
  var lc = sh.getLastColumn(), codeCol = tgLeadCodeCol_();
  var v = sh.getRange(2, 1, last - 1, lc).getValues();
  var closed = tgClosedSet_(), now = new Date();
  var first = {};
  try {
    var es = tgLeadEvSheet_();
    if (es && es.getLastRow() > 1) {
      var ev = es.getRange(2, 1, es.getLastRow() - 1, 4).getValues();
      for (var k = 0; k < ev.length; k++) {
        var code0 = String(ev[k][1] || '').trim(), actor = String(ev[k][3] || '').trim();
        if (!code0 || !actor || actor === 'بات' || !(ev[k][0] instanceof Date)) continue;
        if (!first[code0] || ev[k][0] < first[code0]) first[code0] = ev[k][0];
      }
    }
  } catch (e) {}
  var out = [];
  for (var i = 0; i < v.length; i++) {
    var name = String(v[i][3] || '').trim(), phone = String(v[i][5] || '').trim();
    if (!name && !phone) continue;
    var d = (v[i][0] instanceof Date) ? new Date(v[i][0]) : tgContactDate_(v[i][0], now);
    if (!d) continue;
    var hhmm = tgLatinDigits_(String(v[i][1] || '').trim());
    if (/^\d{1,2}:\d{2}$/.test(hhmm)) { var p = hhmm.split(':'); d.setHours(Number(p[0]), Number(p[1]), 0, 0); }
    var status = String(v[i][8] || '').trim(), src = String(v[i][2] || '').trim(), memo = String(v[i][12] || '').trim();
    var touched = !!tgContactDate_(v[i][10], now);
    var booked = String(v[i][19] || '').trim() === 'بله';
    var started = status.indexOf('شروع درمان') > -1;
    var isClosed = !!(status && closed[tgNormSt_(status)]);
    var stage = started ? TG_CRM_ST[3] : isClosed ? TG_CRM_ST[4] : booked ? TG_CRM_ST[2] : touched ? TG_CRM_ST[1] : TG_CRM_ST[0];
    var code = String(v[i][codeCol - 1] || '').trim();
    var fm = '';
    if (code && first[code]) { var m = Math.round((first[code] - d) / 60000); if (m >= 0 && m < 60 * 24 * 60) fm = m; }
    var sec = '';
    try { sec = tgSection_(src, memo); } catch (e2) {}
    var chan = /سایت/.test(src) ? 'سایت' : /واتس/.test(src) ? 'واتس‌اپ' : /تلفن|تماس/.test(src) ? 'تلفن' : /مینی/.test(src) ? 'مینی‌اپ' : 'بات';
    out.push({ row: i + 2, code: code, d: d, week: tgCrmWeek_(d), month: Number(Utilities.formatDate(d, TG_TZ, 'yyyyMM')),
      src: src.slice(0, 80), chan: chan, sec: sec, region: String(v[i][6] || '').indexOf('خارج') > -1 ? 'خارج از ایران' : 'ایران',
      owner: String(v[i][9] || '').trim().replace(/\s+[—–-]\s+/g, ' · ') || 'بی‌مسئول', status: status || '(خالی)', stage: stage, fm: fm,
      touched: touched || booked || started ? 1 : 0, booked: booked ? 1 : 0, started: started ? 1 : 0, closed: isClosed ? 1 : 0,
      age: Math.max(0, Math.round((now - d) / 86400000)), idle: touched ? Math.round((now - tgContactDate_(v[i][10], now)) / 86400000) : null });
  }
  return out;
}

/* تصمیمی که هر لید باز همین حالا لازم دارد */
function tgCrmDecide_(r) {
  if (r.stage === TG_CRM_ST[0]) return r.age >= 1 ? 'تماس اول عقب افتاده؛ همین امروز تماس یا بستن' : 'تماس اول';
  if (r.stage === TG_CRM_ST[1]) return r.idle !== null && r.idle >= 3 ? 'بی‌حرکت؛ تکلیف روشن شود: ارجاع، معارفه یا بستن' : (r.sec === 'پذیرش' ? 'ارجاع و وقت معارفه' : 'پیگیری');
  if (r.stage === TG_CRM_ST[2]) return 'بعد از معارفه: جلسهٔ اول و پرداخت';
  return '';
}

function tgCrmBuild() {
  var rows = tgCrmRows_();
  /* v168 فاز ۳: تب «🧭 CRM لیدها» بسته شد؛ جایش «کارتابل پیگیری» از tgTodayList_ است */
  var open = tgOpenLeads_(), openSet = {};
  open.forEach(function (l) { openSet[l.row] = 1; });
  if (typeof v168QueueWrite_ === 'function') { try { v168QueueWrite_(open); } catch (eQ) { tgErr_('v168QueueWrite_', eQ); } }
  tgRptData_(rows, openSet);
  return rows.length;
}

function tgCrmBoard_(rows) {
  var ss = tgSS_(), sh = ss.getSheetByName(TG_CRM_TAB);
  if (!sh) { sh = ss.insertSheet(TG_CRM_TAB, 0); sh.setRightToLeft(true); }
  var leadsGid = ss.getSheetByName(TG_LEADS).getSheetId();
  var open = rows.filter(function (r) { return !r.closed && !r.started; });
  var month = new Date(Date.now() - 30 * 86400000);
  var cols = TG_CRM_ST.map(function (st) {
    var l = rows.filter(function (r) { return r.stage === st && (st === TG_CRM_ST[3] || st === TG_CRM_ST[4] ? r.d >= month : true); });
    l.sort(function (a, b) { return b.age - a.age; });
    return l;
  });
  sh.clear();
  var now = Utilities.formatDate(new Date(), TG_TZ, 'HH:mm');
  sh.getRange(1, 1).setValue('🧭 لیدها کجای قیف هستند · به‌روز شده ' + tgFa_(now) + ' (هر ساعت خودکار)');
  sh.getRange(2, 1).setValue('باز: ' + tgFa_(open.length) + ' · بی تماس اول: ' + tgFa_(cols[0].length) + ' · در پیگیری: ' + tgFa_(cols[1].length) +
    ' · معارفه رزرو شد: ' + tgFa_(cols[2].length) + ' · شروع درمان در ۳۰ روز: ' + tgFa_(cols[3].length) + ' · بسته در ۳۰ روز: ' + tgFa_(cols[4].length));
  var head = TG_CRM_ST.map(function (st, j) { return st + ' (' + tgFa_(cols[j].length) + ')'; });
  sh.getRange(4, 1, 1, head.length).setValues([head]).setFontWeight('bold').setBackground('#f9f2f2');
  var max = Math.min(80, Math.max.apply(null, cols.map(function (c) { return c.length; }).concat([1])));
  var grid = [];
  for (var i = 0; i < max; i++) {
    grid.push(cols.map(function (c) {
      var r = c[i];
      if (!r) return '';
      var lbl = (r.code || ('ردیف ' + r.row)) + ' · ' + r.owner + ' · ' + tgFa_(r.age) + ' روز';
      return '=HYPERLINK("#gid=' + leadsGid + '&range=A' + r.row + '","' + lbl.replace(/"/g, '') + '")';
    }));
  }
  if (grid.length) sh.getRange(5, 1, grid.length, head.length).setFormulas(grid);
  sh.setColumnWidths(1, head.length, 230);
  var colors = ['#fdecec', '#fff6e0', '#eaf4ff', '#e9f7ef', '#f2f2f2'];
  for (var j = 0; j < head.length; j++) sh.getRange(4, j + 1).setBackground(colors[j]);
  /* تصمیم‌های لازم */
  var dec = open.map(function (r) { return { r: r, t: tgCrmDecide_(r) }; }).filter(function (x) { return x.t; });
  dec.sort(function (a, b) { return b.r.age - a.r.age; });
  var c0 = head.length + 2;
  sh.getRange(4, c0, 1, 4).setValues([['تصمیم لازم', 'لید', 'مسئول', 'از ثبت']]).setFontWeight('bold').setBackground('#222222').setFontColor('#fefefe');
  var dv = dec.slice(0, 80).map(function (x) {
    return [x.t, '=HYPERLINK("#gid=' + leadsGid + '&range=A' + x.r.row + '","' + (x.r.code || ('ردیف ' + x.r.row)) + '")', x.r.owner, tgFa_(x.r.age) + ' روز'];
  });
  if (dv.length) sh.getRange(5, c0, dv.length, 4).setValues(dv);
  sh.setColumnWidth(c0, 330);
  sh.setFrozenRows(4);
  sh.getRange(1, 1).setFontSize(14).setFontWeight('bold');
}

function tgRptData_(rows, openSet) {
  var ss = tgStatSS_(), sh = ss.getSheetByName(TG_RPT_DATA);
  if (!sh) { sh = ss.insertSheet(TG_RPT_DATA); sh.setRightToLeft(true); sh.hideSheet(); }
  sh.clearContents();
  var v = [TG_RPT_HEAD].concat(rows.map(function (r) {
    return [r.code, r.d, r.week, r.month, r.src, r.chan, r.sec, r.region, r.owner, r.status, r.stage,
      r.fm === '' ? '' : r.fm, r.touched, r.booked, r.started, r.closed, r.age, r.row, (openSet && openSet[r.row]) ? 1 : 0];
  }));
  sh.getRange(1, 1, v.length, TG_RPT_HEAD.length).setValues(v);
  sh.getRange(2, 2, Math.max(1, v.length - 1), 1).setNumberFormat('yyyy-mm-dd hh:mm');
  sh.setFrozenRows(1);
}

/* یک بار: برگهٔ گزارش با انتخاب بازه، شاخص‌ها و نمودارها (فرمول زنده روی داده) */
function tgRptSetup() {
  var ss = tgStatSS_();
  var sh = ss.getSheetByName(TG_RPT_TAB);
  if (sh) ss.deleteSheet(sh);
  sh = ss.insertSheet(TG_RPT_TAB, 0);
  sh.setRightToLeft(true);
  var D = "'" + TG_RPT_DATA + "'!";

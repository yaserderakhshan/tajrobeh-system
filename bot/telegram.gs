}

/* ---------- تست‌های آمار روزانه ---------- */

function tgStatTests() {
  var old = TG_DRY;
  TG_DRY = true;
  var pass = 0, fail = 0, log = [];
  function ok(t, cond) { if (cond) pass++; else { fail++; log.push('❌ ' + t); } }

  try {
    TG_OUTBOX = []; TG_MEM = {};

    var uniq = {}, dup = 0;
    for (var i = 0; i < TG_STAT_HEAD.length; i++) {
      if (uniq[TG_STAT_HEAD[i]]) dup++;
      uniq[TG_STAT_HEAD[i]] = 1;
    }
    ok('سرستون‌های آمار تکراری ندارند', dup === 0);
    ok('سرستون آمار بیست‌وشش ستون است', TG_STAT_HEAD.length === 26);

    var s = tgStatToday_();
    ok('تاریخ شمسی در عددهای امروز هست', !!s.jal && String(s.jal).length > 4);
    ok('تاریخ میلادی یک Date است', s.day instanceof Date);
    var row = tgStatRow_(s);
    ok('ردیف و سرستون هم‌اندازه‌اند', row.length === TG_STAT_HEAD.length);

    var neg = 0;
    for (var j = 2; j < row.length; j++) if (typeof row[j] === 'number' && row[j] < 0) neg++;
    ok('هیچ عدد منفی در ردیف نیست', neg === 0);

    TG_OUTBOX = [];
    tgStatWrite_();
    var ev = TG_OUTBOX.filter(function (x) { return x.kind === 'stat'; });
    ok('نوشتن در حالت خشک فقط رویداد می‌گذارد', ev.length === 1 && ev[0].row.length === TG_STAT_HEAD.length);

    var txt = tgStatText_(s);
    ok('متن آمار عنوان دارد', txt.indexOf('آمار امروز') > -1);
    ok('متن آمار بخش روی زمین مانده دارد', txt.indexOf('روی زمین مانده') > -1);
    ok('متن آمار کاربران بات را می‌گوید', txt.indexOf('کاربران بات') > -1);
    ok('متن آمار خط تیرهٔ وسط جمله ندارد', txt.indexOf('—') < 0 && txt.indexOf('–') < 0);

    TG_OUTBOX = [];
    tgStatTick_();
    ok('تیک شبانه در حالت خشک ساکت است', TG_OUTBOX.length === 0);
  ok('نوشتن شبانهٔ آمار روشن است', TG_STAT_ON === true);

    var kb = tgWatchMenu_();
    var flat = JSON.stringify(kb.keyboard);
    ok('دکمهٔ آمار امروز در منوی ناظر هست', flat.indexOf('آمار امروز') > -1);
    ok('دکمهٔ گزارش امروز هنوز سر جایش است', flat.indexOf('گزارش امروز') > -1);

    TG_OUTBOX = [];
    tgWatchRoute_('70000017', null, TG_STAT_BTN);
    var said = TG_OUTBOX.filter(function (x) { return x.kind === 'msg'; })
                        .map(function (x) { return x.text; }).join('\n');
    ok('دکمهٔ آمار متن آمار را می‌فرستد', said.indexOf('آمار امروز') > -1);

    TG_OUTBOX = [];
    tgUserTouch_('12345', 'کسی', 'someone', 'msg');
    ok('ثبت کاربر در حالت خشک رویداد می‌گذارد',
       TG_OUTBOX.filter(function (x) { return x.kind === 'user'; }).length === 1);

    TG_OUTBOX = [];
    tgUserTouch_('-100123', '', '', 'msg');
    ok('گروه و کانال کاربر حساب نمی‌شود',
       TG_OUTBOX.filter(function (x) { return x.kind === 'user'; }).length === 0);

    ok('تاریخ میلادی شناخته می‌شود', tgStatIsDay_('1405-06-24', '1405-06-24', 'الف') === true);
    ok('تاریخ شمسی شناخته می‌شود', tgStatIsDay_('۲۴ شهریور ۱۴۰۵', '2026-09-15', '۲۴ شهریور ۱۴۰۵') === true);
    ok('تاریخ نامربوط رد می‌شود', tgStatIsDay_('چیز دیگری', '2026-09-15', 'ب') === false);
    ok('سلول خالی رد می‌شود', tgStatIsDay_('', '2026-09-15', 'ب') === false);

    var q = tgStatQ_('C'), sm = tgStatSum_('D', 7);
    ok('فرمول آخرین مقدار نام تب را دارد', q.indexOf(TG_STAT_TAB) > -1 && q.indexOf('INDEX') > -1);
    ok('فرمول سطر آخر به ستون تاریخ نگاه می‌کند', tgStatLastRow_().indexOf('MATCH') > -1);
    ok('فرمول جمع هفت روز درست است', sm.indexOf('SUMIFS') > -1 && sm.indexOf('TODAY()-6') > -1);
    ok('فرمول جمع سی روز درست است', tgStatSum_('D', 30).indexOf('TODAY()-29') > -1);

    ok('تب سری زمانی و داشبورد یکی نیستند', TG_STAT_TAB !== TG_STAT_DASH);
    ok('هاب آمار درست است', TG_STAT_SHEET_ID !== TG_SHEET_ID && TG_STAT_SHEET_ID !== TG_SCHOOL_SHEET_ID);
  } catch (e) {
    fail++;
    log.push('❌ خطا: ' + e);
  }

  TG_DRY = old;
  return { pass: pass, fail: fail, text: log.join('\n') };
}

/* ===================== لایهٔ سرور مینی‌اپ · v97 =====================
   قاعدهٔ قطعی این بخش: هیچ منطق موازی. هر اندپوینت مینی‌اپ همان تابع
   موجود بات را صدا می‌زند. برای اینکه لازم نباشد صدها تابعِ گره‌خورده به
   پیام تلگرام دوتکه شود، یک «پل ضبط» ساخته شده: هنگام یک درخواست مینی‌اپ،
   TG_API_CHAT روی chat_id همان کاربر می‌نشیند و هر پیامی که بات به همان
   کاربر می‌فرستد به‌جای تلگرام در TG_API_OUT می‌نشیند و در پاسخ JSON
   برمی‌گردد. پیام به بقیهٔ آدم‌ها (درمانگر، پذیرش، مسئول مدرسه) مثل قبل
   واقعاً فرستاده می‌شود. پس مسیر بات و مسیر مینی‌اپ یک کد واحدند.
   ===================================================================== */

var TG_API_CHAT = 0;   // وقتی غیرصفر است، پیام‌های همین chat ضبط می‌شود
var TG_API_OUT = [];   // خروجی ضبط‌شدهٔ همین درخواست

/* دکمه‌های تازهٔ خود بات (v97): کارتابل‌هایی که تا امروز فقط به شکل کارتِ
   push وجود داشتند و فهرست نداشتند. چون مینی‌اپ باید فهرست بدهد، همین
   فهرست‌ها به خود بات هم اضافه شد تا دو طرف برابر بمانند. */
var TG_COLLQ_BTN = '👥 تماس همکاران';
var TG_INPQ_BTN = '🏢 درخواست‌های حضوری';
var TG_ALQ_BTN = '🎓 صف دانش‌آموختگان';
var TG_APQ_BTN = '🧑‍🏫 صف اپلای تراپیست';

/* ---------- پل ضبط ---------- */

function tgApiWho_(p) {
  if (TG_DRY && TG_MEM['apiwho']) return TG_MEM['apiwho'];
  var u = tgVerifyInitData_(p && p.initData);
  if (!u || !u.id) return null;
  return {
    chat: u.id,
    uname: u.username || '',
    first: u.first_name || '',
    last: u.last_name || '',
    name: [u.first_name, u.last_name].filter(String).join(' ').trim() || 'بدون نام'
  };
}

/* ============ v98 · سرعت مینی‌اپ ============
   سه کار: (۱) کش نقش‌ها و me در CacheService تا هر بار چهار هاب باز نشود،
   (۲) اندپوینت boot که me و رجیستری را در یک رفت‌وبرگشت می‌دهد،
   (۳) نسخهٔ لایهٔ API تا کلاینت بفهمد با چه سروری حرف می‌زند. */

var TG_API_VER = 'v100';
var TG_API_TTL = 180;      // کش نقش‌ها
var TG_API_ME_TTL = 90;    // کش me

function tgApiCacheGet_(k) {
  try { var v = CacheService.getScriptCache().get(k); return v ? JSON.parse(v) : null; } catch (e) { return null; }
}
function tgApiCachePut_(k, v, t) {
  try { CacheService.getScriptCache().put(k, JSON.stringify(v), t || TG_API_TTL); } catch (e) {}
}
function tgApiCacheDrop_(chat) {
  try { CacheService.getScriptCache().removeAll(['tjrl:' + chat, 'tjme:' + chat]); } catch (e) {}
}

/* رجیستری قابلیت‌ها برای کلاینت. با نقش فیلتر می‌شود تا خانهٔ مینی‌اپ
   فقط کارهای همین آدم را نشان دهد. */
function tgApiCapList_(roles) {
  var out = [];
  for (var i = 0; i < TG_CAP.length; i++) {
    var c = TG_CAP[i];
    if (!c.app || !c.api) continue;
    if (roles && c.roles && c.roles.length) {
      var hit = false;
      for (var j = 0; j < c.roles.length; j++) if (roles.indexOf(c.roles[j]) > -1) { hit = true; break; }
      if (!hit) continue;
    }
    out.push({ key: c.key, label: c.label, roles: c.roles || [], api: c.api, page: c.page || '' });
  }
  return out;
}

/* boot: یک رفت‌وبرگشت به‌جای سه‌تا. کندی مینی‌اپ بیشتر از تعداد
   درخواست‌ها می‌آمد، نه از حجم داده. */
function tgApiBoot_(p) {
  var me = tgApiMe_(p);
  if (!me || !me.ok) return me || { ok: false, error: 'auth' };
  return { ok: true, ver: TG_API_VER, me: me, cap: tgApiCapList_(me.roles), vk: (typeof vkApiFlag_ === 'function') ? vkApiFlag_(p) : 0, t: Date.now() };
}

function tgApiRoles_(w) {
  if (TG_DRY) return tgApiRolesRaw_(w);
  var k = 'tjrl:' + w.chat;
  var hit = tgApiCacheGet_(k);
  if (hit && hit.roles) return hit;
  var val = tgApiRolesRaw_(w);
  tgApiCachePut_(k, val, TG_API_TTL);
  return val;
}

function tgApiRolesRaw_(w) {
  var info = { roles: [], name: w.name, ther: null, desk: null, person: null };
  try { info = tgRolesOf_(w.chat, w.uname) || info; } catch (e) {}
  var list = (info.roles || []).slice();
  try {
    var my = tgMyRoles_(w.chat, w.uname) || [];
    for (var i = 0; i < my.length; i++) if (list.indexOf(my[i]) < 0) list.push(my[i]);
  } catch (e2) {}
  if (list.indexOf('مراجع') < 0) list.push('مراجع');
  return { roles: list, info: info };
}

/* گیت مشترک همهٔ اندپوینت‌های نقش‌محور.
   null یعنی اجازه هست؛ هر مقدار دیگری همان پاسخ خطاست. */
function tgApiGuard_(p, roleNeeded) {
  var w = tgApiWho_(p);
  if (!w) return { ok: false, error: 'auth' };
  if (!roleNeeded) return null;
  var g = tgApiRoles_(w);
  if (g.roles.indexOf(roleNeeded) > -1) return null;
  if (roleNeeded === 'مدرسه') { try { if (tgSjIsOwner_(w.chat) || tgWhoWatch_(w.chat, w.uname)) return null; } catch (e) {} }
  if (roleNeeded === 'سردبیر') { try { if (tgMagIsEditor_(w.chat)) return null; } catch (e2) {} }
  if (roleNeeded === 'درمانگر') { try { if (tgWhoTherapist_(w.chat)) return null; } catch (e3) {} }
  if (roleNeeded === 'پذیرش') { try { if (tgWhoDesk_(w.chat, w.uname)) return null; } catch (e4) {} }
  if (roleNeeded === 'ناظر') { try { if (tgWhoWatch_(w.chat, w.uname)) return null; } catch (e5) {} }
  if ((roleNeeded === 'تنخواه' || roleNeeded === 'راهبر') && (g.roles.indexOf('ناظر') > -1 || g.roles.indexOf('راهبر') > -1)) return null;
  if (roleNeeded === 'پارتنر') { try { if (typeof ptApiOk_ === 'function' && ptApiOk_(w.chat, w.uname)) return null; } catch (e7) {} }
  if (roleNeeded === 'استاد' || roleNeeded === 'سوپروایزر') {
    try {
      var te = tgTeaWho_(w.chat, w.uname);
      if (te && (roleNeeded === 'استاد' || String(te.role || '').indexOf('سوپروایزر') > -1)) return null;
    } catch (e6) {}
  }
  return { ok: false, error: 'role', need: roleNeeded, roles: g.roles };
}

function tgApiMsg_(w, text) {
  return {
    message_id: 0,
    chat: { id: w.chat, type: 'private' },
    from: { id: w.chat, first_name: w.first, last_name: w.last, username: w.uname },
    text: String(text == null ? '' : text)
  };
}

function tgApiCq_(w, data) {
  return {
    id: '',
    data: String(data || ''),
    from: { id: w.chat, first_name: w.first, last_name: w.last, username: w.uname },
    message: { message_id: 0, chat: { id: w.chat, type: 'private' }, text: '' }
  };
}

function tgApiClean_(list) {
  var out = [];
  for (var i = 0; i < list.length; i++) {
    var x = list[i] || {};
    var kb = x.kb || null;
    out.push({
      text: String(x.text || ''),
      inline: (kb && kb.inline_keyboard) ? kb.inline_keyboard : null,
      keys: (kb && kb.keyboard) ? kb.keyboard : null,
      photo: x.photo || '',
      edit: !!x.edit
    });
  }
  return out;
}

/* هستهٔ پل: همان تابع بات را اجرا می‌کند و چیزی را که بات به همین کاربر
   می‌گفت برمی‌گرداند. act یکی از سه شکل: {text} یا {cb} یا {fn}. */
function tgApiCapture_(w, act) {
  var keepChat = TG_API_CHAT, keepOut = TG_API_OUT;
  TG_API_CHAT = w.chat;
  TG_API_OUT = [];
  var err = '';
  try {
    if (act.cb) tgOnCallback_(tgApiCq_(w, act.cb));
    else if (act.fn) act.fn(w);
    else tgPrivate_(tgApiMsg_(w, act.text));
  } catch (e) {
    err = String(e);
    tgErr_('tgApiCapture_: ' + e);
  }
  var got = TG_API_OUT;
  TG_API_CHAT = keepChat;
  TG_API_OUT = keepOut;
  if (err) return { ok: false, error: 'run', detail: err };
  return { ok: true, out: tgApiClean_(got) };
}

/* سهمیهٔ ساده در هر دقیقه برای هر chat؛ خطای کش را نادیده می‌گیرد */
function tgApiQuota_(key, max) {
  if (TG_DRY) return true;
  try {
    var c = CacheService.getScriptCache();
    var k = key + ':' + Utilities.formatDate(new Date(), 'UTC', 'yyyyMMddHHmm');
    var n = Number(c.get(k) || 0) + 1;
    c.put(k, String(n), 120);
    return n <= max;
  } catch (e) { return true; }
}

function tgApiDo_(p, act) {
  try { if (!TG_DRY) CacheService.getScriptCache().remove('tjme:' + (tgApiWho_(p) || {}).chat); } catch (ed) {}
  var w = tgApiWho_(p);
  if (!w) return { ok: false, error: 'auth' };
  if (!tgApiQuota_('apiq' + w.chat, 120)) return { ok: false, error: 'rate' };
  if (act.role) { try { tgSetVal_('role', w.chat, act.role); } catch (e) {} }
  return tgApiCapture_(w, act);
}

/* اندپوینت متنی: همان دکمهٔ بات را می‌زند */
function tgApiT_(p, role, text) { return tgApiDo_(p, { role: role, text: text }); }

/* اندپوینت دکمه‌ای: همان callback_data بات را می‌زند، با فهرست پیشوند مجاز */
function tgApiC_(p, role, allow) {
  var cb = tgCbResolve_(String((p && p.cb) || ''));   /* v170.9.2: کد کوتاه دکمه پیش از فهرست مجاز */
  if (!cb) return { ok: false, error: 'bad' };
  var okPre = false;
  for (var i = 0; i < allow.length; i++) {
    if (allow[i].indexOf(':') < 0) { if (cb === allow[i]) okPre = true; }
    else if (cb.indexOf(allow[i]) === 0) okPre = true;
  }
  if (!okPre) return { ok: false, error: 'cb' };
  return tgApiDo_(p, { role: role, cb: cb });
}

/* کارت لید پذیرش با کد لید */
function tgApiLeadCard_(p) {
  var w = tgApiWho_(p);
  if (!w) return { ok: false, error: 'auth' };
  var row = tgLeadByCode_(String((p && p.code) || ''));
  if (!row || row < 2) return { ok: false, error: 'notfound' };
  return tgApiCapture_(w, { fn: function (ww) { tgLeadCardSend_(ww.chat, row); } });
}

/* کارت لید مدرسه با کد لید مدرسه */
function tgApiSchCard_(p) {
  var w = tgApiWho_(p);
  if (!w) return { ok: false, error: 'auth' };
  var row = tgSlByCode_(String((p && p.code) || ''));
  if (!row || row < 2) return { ok: false, error: 'notfound' };
  return tgApiCapture_(w, { fn: function (ww) { tgSlCardSend_(ww.chat, row); } });
}

/* ---------- کارتابل‌های تازهٔ بات (فهرست، نه منطق تازه) ----------
   این چهار تابع فقط سطرهای باز را از همان تب‌های موجود می‌خوانند و همان
   کیبورد و همان کال‌بک‌های موجود را نشان می‌دهند. هیچ تصمیمی اینجا گرفته
   نمی‌شود؛ تصمیم‌ها همان tgOnAl_ و tgOnAp_ و tgInpVCb_ قبلی است. */

function tgCollQueue_(chat) {
  var rows = [];
  try {
    var sh = tgCollSheet_();
    var last = sh.getLastRow();
    if (last > 1) rows = sh.getRange(2, 1, last - 1, TG_COLL_HEAD.length).getDisplayValues();
  } catch (e) { tgErr_('tgCollQueue_: ' + e); }
  var open = [];
  for (var i = 0; i < rows.length; i++) {
    if (String(rows[i][7] || '').indexOf('انتظار') < 0) continue;
    open.push(rows[i]);
  }
  if (!open.length) return tgSend_(chat, 'درخواست تماس همکار بازی نداریم.', tgDeskMenu_());
  var lines = [];
  for (var j = Math.max(0, open.length - 15); j < open.length; j++) {
    lines.push('• ' + tgEsc_(open[j][2]) + (open[j][5] ? ' · ' + tgEsc_(open[j][5]) : '') +
      '\n  ' + tgEsc_(open[j][6]) + ' · ' + tgEsc_(open[j][0]));
  }
  return tgSend_(chat, '👥 <b>تماس همکاران</b>\nباز: ' + tgFa_(open.length) +
    '\n\n' + lines.join('\n') +
    '\n\nبعد از تماس، وضعیت را در تب «' + TG_COLL_TAB + '» «انجام شد» کنید.', tgDeskMenu_());
}

function tgInpQueue_(chat) {
  var rows = [];
  try { rows = tgInpTab_(TG_INP_REQ, TG_INP_QHEAD).rows(); } catch (e) { tgErr_('tgInpQueue_: ' + e); }
  var n = 0;
  for (var i = 0; i < rows.length; i++) {
    if (String(rows[i][13] || '').trim() !== 'منتظر پذیرش') continue;
    n++;
    tgSend_(chat, '🏢 <b>درخواست حضوری · ' + tgEsc_(rows[i][5]) + '</b>\n' +
      tgEsc_(rows[i][2]) + '\n' + tgEsc_(rows[i][12]),
      { inline_keyboard: [[{ text: '✅ تأیید', callback_data: 'iv:y:' + rows[i][0] },
        { text: '❌ رد', callback_data: 'iv:n:' + rows[i][0] }]] });
    if (n >= 10) break;
  }
  if (!n) tgSend_(chat, 'درخواست حضوری منتظری نیست.', tgDeskMenu_());
  tgSend_(chat, 'ثبت مستقیم ساعت حضوری یک درمانگر (هر هفته، یک هفته در میان، هر سه هفته یا ماهی یک بار):', { inline_keyboard: [[{ text: '➕ ثبت ساعت حضوری برای درمانگر', callback_data: 'ih:new' }]] });
  return true;
}

function tgAlQueue_(chat) {
  var rows = [];
  try {
    var sh = tgSchAlumSheet_();
    var last = sh.getLastRow();
    if (last > 1) rows = sh.getRange(2, 1, last - 1, TG_SCH_ALUM_HEAD.length).getDisplayValues();
  } catch (e) { tgErr_('tgAlQueue_: ' + e); }
  var n = 0;
  for (var i = 0; i < rows.length; i++) {
    var st = String(rows[i][11] || '').trim();
    if (st !== TG_AL_ST_WAIT) continue;
    n++;
    tgSend_(chat, '🎓 <b>' + tgEsc_(rows[i][1]) + '</b> · ' + tgEsc_(rows[i][0]) +
      '\n' + tgEsc_(rows[i][6]) + ' ' + tgEsc_(rows[i][7]) +
      (rows[i][9] ? ' · پایان ' + tgEsc_(rows[i][9]) : '') +
      (rows[i][10] ? ' · ' + tgEsc_(rows[i][10]) + ' ساعت' : ''),
      tgAlKb_(String(rows[i][0]).trim()));
    if (n >= 10) break;
  }
  if (!n) tgSend_(chat, 'صف دانش‌آموختگان خالی است.');
  return true;
}

function tgApQueue_(chat) {
  var rows = [];
  try {
    var sh = tgSchApSheet_();
    var last = sh.getLastRow();
    if (last > 1) rows = sh.getRange(2, 1, last - 1, 21).getDisplayValues();
  } catch (e) { tgErr_('tgApQueue_: ' + e); }
  var open = [], closed = 0, by = {};
  for (var i = 0; i < rows.length; i++) {
    var id = String(rows[i][0] || '').trim(); if (!id) continue;
    var stage = String(rows[i][11] || '').trim() || TG_AP_STAGES[0];
    if (stage === 'بسته' || stage === 'همکاری آغاز شد') { closed++; continue; }
    var ord = TG_AP_STAGES.indexOf(stage);
    open.push({ id: id, ord: ord < 0 ? 0 : ord }); by[stage] = (by[stage] || 0) + 1;
  }
  if (!open.length) { tgSend_(chat, 'صف اپلای تراپیست خالی است.'); return true; }
  tgSend_(chat, '🧑‍🏫 <b>جذب تراپیست</b>\nپروندهٔ باز: ' + tgFa_(open.length) + (closed ? ' · بسته یا شروع‌شده: ' + tgFa_(closed) : '') + '\n' +
    TG_AP_STAGES.filter(function (s) { return by[s]; }).map(function (s) { return '• ' + s + ': ' + tgFa_(by[s]); }).join('\n') +
    '\n\nتب «جذب تراپیست» هاب پذیرش همین پرونده‌ها را با شماره، ایمیل، تلگرام و لینک رزومه دارد و مرحله را همان‌جا هم می‌شود عوض کرد.');
  open.sort(function (a, b) { return a.ord - b.ord; });
  var n = 0;
  for (var k = 0; k < open.length && n < 10; k++) {
    var r = tgApRow_(open[k].id);
    if (!r) continue;
    n++;
    tgSend_(chat, tgApCard_(r), tgApKb_(r));
  }
  return true;
}

/* ============ رجیستری قابلیت‌ها · قفل همگامی بات و مینی‌اپ ============
   قاعده: هر قابلیتی که در بات هست باید در مینی‌اپ هم باشد. هر کس کاری به
   بات اضافه می‌کند موظف است همان‌جا یک ردیف اینجا بنویسد و اندپوینتش را
   بسازد. اگر ننویسد یا اندپوینت نسازد، tgParityTests قرمز می‌شود و
   tgRun() اجازهٔ دیپلوی نمی‌دهد. این تنها چیزی است که جلوی عقب‌ماندن
   مینی‌اپ از بات را می‌گیرد؛ یادداشت در اسکیل فراموش می‌شود، تست نه.

   فیلدها:
     key   شناسهٔ کوتاه و یکتا
     label اسم فارسی قابلیت
     roles نقش‌هایی که این کار را می‌کنند. خالی یعنی برای همه
     bot   در خود بات هست
     api   نام اندپوینت مینی‌اپ در tgApiRoute_، یا خالی
     app   از مینی‌اپ در دسترس است (اندپوینت دارد و گیتش درست است)
     page  نام صفحهٔ کلاینت در برگهٔ ۵۰۳۸۸۶. لایهٔ کلاینت این را پر می‌کند
     appNa اگر این قابلیت ذاتاً در مینی‌اپ معنی ندارد، دلیلش. فقط جایی که
           واقعاً معنی ندارد؛ بهانه نیست
   ===================================================================== */


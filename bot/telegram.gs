function tgApFa_(n) {
  return String(n).replace(/[0-9]/g, function (c) { return '۰۱۲۳۴۵۶۷۸۹'.charAt(Number(c)); });
}

function tgApKbFor_(q) {
  var rows = [];
  (q.opts || []).forEach(function (o) { rows.push([o]); });
  if (q.multi) rows.push([TG_AP_MULTI_DONE]);
  if (!q.req) rows.push([TG_SJ_SKIP]);
  rows.push([TG_SJ_BACK]);
  return { keyboard: rows, resize_keyboard: true };
}

function tgApStart_(chat, uname) {
  var mine = tgApMine_(chat);
  if (mine) {
    if (mine.stage !== 'بسته') return tgApStatus_(chat, mine);
  }
  tgApPut_(chat, { qi: 0, user: uname || '' });
  tgSend_(chat, T_AP_INTRO);
  return tgApAsk_(chat, tgApGet_(chat));
}

function tgApAsk_(chat, d) {
  var i = d.qi || 0;
  if (i >= TG_AP_Q.length) return tgApSave_(chat, d);
  tgApPut_(chat, d);
  var q = TG_AP_Q[i];
  var head = '<b>' + tgApFa_(i + 1) + ' از ' + tgApFa_(TG_AP_Q.length) + '</b> · ';
  return tgSend_(chat, head + q.t, tgApKbFor_(q));
}

function tgApStep_(chat, m) {
  var d = tgApGet_(chat);
  if (!d) return false;
  var i = d.qi || 0;
  var q = TG_AP_Q[i];
  if (!q) { tgApEnd_(chat); return false; }
  if (q.k === 'resume') {
    if (m) {
      if (m.document) {
        d.resume = 'tg:doc:' + m.document.file_id + ' · ' + (m.document.file_name || '');
        d.qi = i + 1;
        tgApAsk_(chat, d);
        return true;
      }
      if (m.photo && m.photo.length) {
        d.resume = 'tg:photo:' + m.photo[m.photo.length - 1].file_id;
        d.qi = i + 1;
        tgApAsk_(chat, d);
        return true;
      }
    }
  }
  var text = String((m ? m.text : '') || '').trim();
  if (!text) return false;
  if (text === TG_SJ_BACK || text === 'انصراف') { tgApEnd_(chat); tgSend_(chat, 'باشد، بی‌خیال شدیم. هر وقت خواستید دوباره «' + TG_AP_BTN + '» را بزنید.'); return true; }
  if (text.indexOf('/') === 0) { tgApEnd_(chat); return false; }
  if (text === TG_SJ_SKIP) {
    if (q.req) { tgSend_(chat, 'این یکی را لازم داریم. لطفاً بنویسید.', tgApKbFor_(q)); return true; }
    d.qi = i + 1;
    tgApAsk_(chat, d);
    return true;
  }
  if (q.k === 'phone') {
    if (!tgLooksLikePhone_(text)) { tgSend_(chat, 'این شماره درست به نظر نمی‌رسد. یک بار دیگر بنویسید.'); return true; }
  }
  if (q.multi) {
    var picked = d['_' + q.k] || [];
    if (text === TG_AP_MULTI_DONE) {
      d[q.k] = picked.join('، ');
      delete d['_' + q.k];
      d.qi = i + 1;
      tgApAsk_(chat, d);
      return true;
    }
    var at = picked.indexOf(text);
    if (at > -1) picked.splice(at, 1); else picked.push(text);
    d['_' + q.k] = picked;
    tgApPut_(chat, d);
    tgSend_(chat, (picked.length ? 'تا این‌جا: ' + picked.join('، ') : 'هیچ گزینه‌ای انتخاب نشده.') +
      '\nگزینهٔ دیگری هم هست؟ اگر نه «' + TG_AP_MULTI_DONE + '» را بزنید.', tgApKbFor_(q));
    return true;
  }
  d[q.k] = text;
  d.qi = i + 1;
  tgApAsk_(chat, d);
  return true;
}

function tgApSave_(chat, d) {
  var id = TG_DRY ? 'A-001' : tgSchNextId_(TG_SCH_T_APPLY, TG_SCH_APPLY_HEAD, 'A');
  var vals = [id, tgJDateFull_(new Date(), TG_TZ), d.name || '', d.user || '', String(chat),
              d.phone || '', d.city || '', d.approach || '', d.years || '', d.resume || '',
              d.note || '', TG_AP_STAGES[0], '', '', '', '', '', '', '', '', ''];
  TG_AP_EXTRA.forEach(function (e) { vals.push(d[e[0]] || ''); });
  if (typeof TG_AP_XHEAD !== 'undefined') TG_AP_XHEAD.forEach(function () { vals.push(''); });
  if (TG_DRY) {
    (TG_MEM['apply'] = TG_MEM['apply'] || []).push(vals);
    TG_OUTBOX.push({ kind: 'apply', id: id, stage: TG_AP_STAGES[0] });
  } else {
    var sh = tgSchApSheet_();
    if (sh.getMaxColumns() < TG_SCH_APPLY_HEAD.length ||
        String(sh.getRange(1, TG_SCH_APPLY_HEAD.length).getValue()).trim() !== TG_SCH_APPLY_HEAD[TG_SCH_APPLY_HEAD.length - 1]) {
      tgSchHeadFix_(TG_SCH_T_APPLY, TG_SCH_APPLY_HEAD);
    }
    sh.appendRow(vals);
    tgSchDropCache_();
  }
  tgApEnd_(chat);
  tgSend_(chat, '✅ پرونده‌تان ثبت شد. کد درخواست: <b>' + id + '</b>\n\n' +
    'از این‌جا به بعد: پرونده‌تان را مسئول مرکز می‌بیند و یک تماس کوتاه می‌گیرد، بعد به سوپروایزری سپرده می‌شود ' +
    'که رویکردش با شما می‌خواند و زمان مصاحبه را همین‌جا به شما می‌گوییم.\n\n' +
    'هر وقت خواستید «' + TG_AP_ME + '» را بزنید.',
    { keyboard: [[TG_AP_ME]], resize_keyboard: true });
  tgApNotify_(id, d);
  try { if (typeof tgApResumeToDrive_ === 'function') tgApResumeToDrive_(id); } catch (eRd) { tgErr_('tgApResumeToDrive_: ' + eRd); }
  return true;
}

function tgApMine_(chat) {
  if (TG_DRY) return TG_MEM['apmine'] || null;
  var sh = tgSchApSheet_();
  if (!sh || sh.getLastRow() < 2) return null;
  var v = sh.getRange(2, 1, sh.getLastRow() - 1, 18).getValues();
  for (var i = v.length - 1; i >= 0; i--) {
    if (String(v[i][4]).trim() !== String(chat)) continue;
    return { id: String(v[i][0]).trim(), name: String(v[i][2]).trim(), stage: String(v[i][11]).trim(),
             sup: String(v[i][13]).trim(), when: String(v[i][15]).trim(),
             result: String(v[i][16]).trim(), ok: String(v[i][17]).trim() };
  }
  return null;
}

function tgApStatusText_(r) {
  var at = 0;
  for (var i = 0; i < TG_AP_VIEW.length; i++) { if (TG_AP_VIEW[i].st === r.stage) at = i; }
  var closed = (r.stage === 'بسته');
  var s = '📍 <b>درخواست همکاری شما</b> · کد ' + tgEsc_(r.id || '') + '\n\n';
  TG_AP_VIEW.forEach(function (v, k) {
    var mark = closed ? '▫️' : (k < at ? '✅' : (k === at ? '👉' : '▫️'));
    s += mark + ' ' + (k === at ? '<b>' + v.t + '</b>' : v.t) + '\n';
  });
  s += '\n';
  if (closed) {
    s += 'این درخواست بسته شده است.';
    if (r.result) s += '\nنتیجه: ' + tgEsc_(r.result);
    s += '\nاگر شرایطتان تغییر کرده، می‌توانید دوباره «' + TG_AP_BTN + '» را بزنید.';
    return s;
  }
  s += '<b>قدم بعدی:</b> ' + TG_AP_VIEW[at].next;
  if (r.when) s += '\n🗓 زمان مصاحبه: ' + tgEsc_(r.when);
  if (r.result) { if (at >= 4) s += '\nنتیجهٔ مصاحبه: ' + tgEsc_(r.result); }
  s += '\n\nپرسشی دارید؟ «' + TG_AP_MSG + '» را بزنید و همین‌جا بنویسید.';
  return s;
}

function tgApStatus_(chat, r) {
  if (!r) r = tgApMine_(chat);
  if (!r) {
    tgSend_(chat, 'هنوز درخواست همکاری‌ای از این حساب ثبت نشده. برای شروع «' + TG_AP_BTN + '» را بزنید.',
      { keyboard: [[TG_AP_BTN]], resize_keyboard: true });
    return true;
  }
  tgSend_(chat, tgApStatusText_(r), { keyboard: [[TG_AP_ME], [TG_AP_MSG]], resize_keyboard: true });
  return true;
}

/* متقاضی می‌خواهد دربارهٔ درخواستش پیام بدهد: متن بعدی به ناظر می‌رسد */
function tgApMsgStart_(chat) {
  var r = tgApMine_(chat);
  if (!r) { tgSend_(chat, 'هنوز درخواست همکاری‌ای از این حساب ثبت نشده.'); return true; }
  tgSetVal_('apreply', chat, r.id);
  tgSend_(chat, 'بنویسید؛ همین پیام مستقیم به مسئول مرکز می‌رسد. برای انصراف «انصراف» بفرستید.', { remove_keyboard: true });
  return true;
}

function tgApFormTests() {
  var out = [], pass = 0, fail = 0;
  function ok(n, c) { if (c) { pass++; } else { fail++; } out.push((c ? '✅ ' : '❌ ') + n); }
  var wasDry = TG_DRY, wasOut = TG_OUTBOX;
  TG_DRY = true;
  try {
    var C = 93001;
    TG_MEM['apmine'] = null;
    TG_MEM['apply'] = [];
    tgApEnd_(C);
    TG_OUTBOX = [];
    tgApStart_(C, 'tester');
    ok('شروع: معرفی و پرسش اول', TG_OUTBOX.length === 2 && String(TG_OUTBOX[1].text).indexOf('۱ از ') > -1);
    TG_OUTBOX = [];
    tgApStep_(C, { text: TG_SJ_SKIP });
    ok('نام اجباری است و رد نمی‌شود', (tgApGet_(C) || {}).qi === 0);
    tgApStep_(C, { text: 'متقاضی نمونه' });
    tgApStep_(C, { text: 'سلام' });
    ok('شمارهٔ نادرست پذیرفته نمی‌شود', (tgApGet_(C) || {}).qi === 1);
    tgApStep_(C, { text: '09120000000' });
    tgApStep_(C, { text: TG_SJ_SKIP });
    tgApStep_(C, { text: 'زن' });
    tgApStep_(C, { text: '۳۰ تا ۴۰ سال' });
    tgApStep_(C, { text: 'تهران' });
    var d = tgApGet_(C) || {};
    ok('پرسش چندگزینه‌ای محل کار رسید', TG_AP_Q[d.qi].k === 'where');
    tgApStep_(C, { text: 'آنلاین، مراجع داخل ایران' });
    tgApStep_(C, { text: 'آنلاین، مراجع خارج از ایران' });
    tgApStep_(C, { text: 'آنلاین، مراجع داخل ایران' });
    tgApStep_(C, { text: TG_AP_MULTI_DONE });
    d = tgApGet_(C) || {};
    ok('چندانتخابی جمع و حذف را درست نگه می‌دارد', d.where === 'آنلاین، مراجع خارج از ایران');
    var guard = 0;
    while ((tgApGet_(C) || null) && guard < 60) {
      var q = TG_AP_Q[(tgApGet_(C) || {}).qi];
      if (!q) break;
      if (q.req) tgApStep_(C, { text: q.opts ? q.opts[0] : 'پاسخ ' + q.k });
      else if (q.k === 'resume') tgApStep_(C, { document: { file_id: 'F1', file_name: 'cv.pdf' } });
      else if (q.multi) { tgApStep_(C, { text: q.opts[0] }); tgApStep_(C, { text: TG_AP_MULTI_DONE }); }
      else tgApStep_(C, { text: TG_SJ_SKIP });
      guard++;
    }
    var row = (TG_MEM['apply'] || [])[0] || [];
    ok('پرونده ثبت شد', TG_MEM['apply'].length === 1);
    ok('طول سطر با سرستون‌ها یکی است', row.length === TG_SCH_APPLY_HEAD.length);
    ok('رزومهٔ فایل ذخیره شد', String(row[9]).indexOf('tg:doc:F1') === 0);
    ok('ستون محل کار پر شد', row[TG_SCH_APPLY_HEAD.indexOf('محل کار')] === 'آنلاین، مراجع خارج از ایران');
    ok('ستون بخش‌های همکاری پر شد', row[TG_SCH_APPLY_HEAD.indexOf('بخش‌های همکاری')] === TG_AP_Q.filter(function (x) { return x.k === 'services'; })[0].opts[0]);
    ok('پیام پایان کد درخواست دارد', TG_OUTBOX.some(function (o) { return String(o.text).indexOf('A-001') > -1; }));
    ok('هر پرسش خط تیره ندارد', TG_AP_Q.every(function (x) { return (x.t + (x.opts || []).join('')).search(/[—–]/) < 0; }));
    ok('معرفی خط تیره ندارد', T_AP_INTRO.search(/[—–]/) < 0);
    TG_MEM['apmine'] = { id: 'A-007', stage: 'مصاحبهٔ دوم', when: '۱۴۰۵/۰۷/۰۳ ساعت ۱۸', result: '', ok: '' };
    TG_OUTBOX = [];
    tgApStart_(C, 'tester');
    var st = TG_OUTBOX.length ? String(TG_OUTBOX[0].text) : '';
    ok('متقاضی باز دوباره فرم نمی‌گیرد و وضعیت می‌بیند', st.indexOf('A-007') > -1 && !tgApGet_(C));
    ok('مرحلهٔ فعلی علامت دارد', st.indexOf('👉 <b>مصاحبهٔ علمی و بالینی</b>') > -1);
    ok('مرحله‌های قبل تیک دارند', (st.match(/✅/g) || []).length === 3);
    ok('زمان مصاحبه نشان داده می‌شود', st.indexOf('۱۴۰۵/۰۷/۰۳') > -1);
    ok('متن وضعیت خط تیره ندارد', st.search(/[—–]/) < 0);
    TG_MEM['apmine'] = { id: 'A-008', stage: 'بسته', result: 'عدم پذیرش' };
    TG_OUTBOX = [];
    tgApStart_(C, 'tester');
    ok('درخواست بسته اجازهٔ اپلای دوباره می‌دهد', !!tgApGet_(C));
    tgApEnd_(C);
    TG_MEM['apmine'] = null;
    TG_OUTBOX = [];
    tgApStatus_(C);
    ok('بدون پرونده راه شروع را می‌گوید', TG_OUTBOX.length === 1 && String(TG_OUTBOX[0].text).indexOf(TG_AP_BTN) > -1);
  } catch (e) {
    ok('خطا: ' + e, false);
  } finally {
    TG_MEM['apmine'] = null;

}

function tgOnSessBook_(chat, idx) {
  var raw = tgGetVal_('soff', chat);
  var list = null;
  if (raw) { try { list = JSON.parse(raw); } catch (e) {} }
  var s = list ? list[idx] : null;
  if (!s) return tgSend_(chat, 'این فهرست منقضی شده. دوباره امتحان کنید.', tgMenu_());
  var lock = tgLock_();
  if (lock && !lock.tryLock(10000)) return tgSend_(chat, 'یک لحظه دوباره امتحان کنید.');
  try { if (lock) TG_LOCK_HELD = true;   /* v166.13: tgLeadCode_ و tgAppendLead_ قفل را رها نکنند */
    var b = tgSessBlocks_();
    if (b.taken[s.therapist + '|' + s.dateIso + '|' + s.hhmm]) { tgSend_(chat, 'این وقت همین الان پر شد.'); tgDel_('soff', chat); return tgSessStart_(chat); }
    var lead = tgLeadInfo_(chat);
    var len = tgTherSlen_(s.therapist);
    var info = tgTherapistInfo_()[s.therapist] || {};
    var utc = tgSlotUtc_(s);
    var z = tgZoneOf_(tgGetVal_('tz', chat) || 'ir');
    var row = 0;
    if (!TG_DRY) {
      var sh = tgSessSheet_();
      sh.appendRow([s.therapist, s.dateIso, s.hhmm, len, lead.name || '', String(chat), lead.phone || '',
                    'رزرو شده', '', '', Utilities.formatDate(new Date(), TG_TZ, 'yyyy-MM-dd'), 'خودرزرو از بات']);
      row = sh.getLastRow();
    } else {
      TG_OUTBOX.push({ kind: 'sess', name: s.therapist, d: s.dateIso, h: s.hhmm, len: len, client: lead.name || '' });
      row = 2;
    }
    tgDel_('soff', chat);

    var msg = ['رزرو شد ✅', '',
      '👤 ' + tgEsc_(s.therapist),
      '🗓 ' + tgDay_(Utilities.formatDate(utc, z.tz, 'EEE')) + ' ' + tgDateFor_(utc, z, true),
      '🕐 ساعت ' + tgFa_(Utilities.formatDate(utc, z.tz, 'HH:mm')) + ' به وقت شما' +
        (z.key === 'ir' ? '' : ' (' + tgFa_(Utilities.formatDate(utc, TG_TZ, 'HH:mm')) + ' به وقت تهران)'),
      '⏱ ' + tgFa_(len) + ' دقیقه'].join('\n') +
      (info.meet ? '\n\n🔗 لینک جلسه:\n' + tgEsc_(info.meet) : '\n\nلینک جلسه را پیش از موعد می‌فرستیم.');
    tgSend_(chat, msg);

    var evId = '';
    try {
      var ev = tgCalMake_({
        title: TG_CAL_SESS_T + ' · ' + s.therapist,
        start: utc, end: new Date(utc.getTime() + len * 60000),
        guests: [info.email || '', tgGetVal_('em', chat) || ''],
        location: info.meet || '',
        desc: ['مراجع: ' + (lead.name || 'نامشخص'), 'درمانگر: ' + s.therapist, 'این رویداد را بات تجربه ساخته است.'].join('\n')
      });
      if (ev && ev.id) { evId = ev.id; tgSessSet_(row, 'رویداد تقویم', evId); }
    } catch (eC) { tgErr_('sessCal: ' + eC); }
    tgSetVal_('sbook', chat, JSON.stringify({ row: row, ev: evId, t: s.therapist, d: s.dateIso, h: s.hhmm, len: len }));

    try { tgSessNotify_(s, lead.name || 'نامشخص', lead.phone, len); } catch (eN) {}
    try { tgPsyOnBook_(chat, s, lead, row); } catch (ePs) { tgErr_('tgPsyOnBook_', ePs); }
    try { tgCoupleOffer_(chat, s, row); } catch (eCp) { tgErr_('tgCoupleOffer_', eCp); }

    return tgSend_(chat, T_SESS_WEEKLY
        .replace('{d}', tgDay_(Utilities.formatDate(utc, TG_TZ, 'EEE')))
        .replace('{h}', tgFa_(Utilities.formatDate(utc, z.tz, 'HH:mm'))), {
      inline_keyboard: [
        [{ text: '✅ بله، هفتگی نگهش دار', callback_data: 'sw:y' }],
        [{ text: 'فعلاً همین یک جلسه', callback_data: 'sw:n' }]
      ]
    });
  } catch (err) {
    tgErr_('tgOnSessBook_: ' + err);
    return tgSend_(chat, 'در ثبت این وقت مشکلی پیش آمد. پذیرش پیگیری می‌کند.', tgMenu_());
  } finally { TG_LOCK_HELD = false; if (lock) lock.releaseLock(); }
}

function tgOnSessWeekly_(chat, yes) {
  var raw = tgGetVal_('sbook', chat);
  var b = null;
  if (raw) { try { b = JSON.parse(raw); } catch (e) {} }
  if (!b) return tgSend_(chat, 'باشد.', tgMenu_());
  tgDel_('sbook', chat);
  if (!yes) return tgSend_(chat, 'باشد، فعلاً همین یک جلسه. هر وقت خواستید از منو وقت تازه بگیرید.', tgMenu_());

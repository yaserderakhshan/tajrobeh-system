          tgCpSet_(TG_CPT_TAB, e.row, { 'وضعیت': 'لغو', 'اجرا شد': 'دیر شد و فرستاده نشد' });
          tgCpTell_('⚠️ ' + camp.code + ' · ' + e.id + ' بیش از ' + tgFa_(TG_CP_LATE_H) + ' ساعت عقب افتاد و فرستاده نشد: ' + tgEsc_(e.title));

/* ─────────── v116 · استاد هر کلاس مدرسه: از مسئول مدرسه می‌پرسیم، اگر ۲۴ ساعت ماند از مسئول ارشد ─────────── */
var TG_CLS_TAB = 'استاد کلاس‌ها';
var TG_CLS_HEAD = ['کلید', 'حلقه', 'تقویم', 'عنوان کلاس', 'نزدیک‌ترین جلسه', 'ایمیل مدعو', 'استاد', 'وضعیت',
  'پرسیده شد', 'از چه کسی', 'پاسخ‌دهنده', 'زمان پاسخ', 'دقیقه تا پاسخ', 'پیام به استاد'];
var TG_CLS_DAYS = 45, TG_CLS_ASK_MAX = 6, TG_CLS_ESC_H = 24;
var TG_CLS_WAIT = 'در انتظار', TG_CLS_OK = 'تأیید شد', TG_CLS_AUTO = 'خودکار از ایمیل', TG_CLS_SKIP = 'نادیده';

function tgClsTitle_(t) {
  return String(t || '').replace(/جلسه\S*\s*[0-9۰-۹]+/g, '').replace(/[0-9۰-۹]+\s*$/g, '')
    .replace(/[()\[\]]/g, ' ').replace(/\s+/g, ' ').trim();
}
function tgClsKey_(cal, title) { return String(cal).slice(0, 12) + '|' + tgNorm_(tgClsTitle_(title)); }

function tgClsCals_() {
  var out = [], seen = {};
  function add(id, label) {
    id = String(id || '').trim();
    if (!id) return;
    if (id.indexOf('@') < 0) id += '@group.calendar.google.com';
    if (seen[id]) { if (seen[id].circle.indexOf(label) < 0) seen[id].circle += '، ' + label; return; }
    seen[id] = { id: id, circle: label };
    out.push(seen[id]);
  }
  for (var k in TG_CIRCLE_CAL) add(TG_CIRCLE_CAL[k], tgFa_(k));
  try { tgSchCircles_().forEach(function (c) { if (c.cal) add(c.cal, tgFa_(c.code)); }); } catch (e) {}
  for (var i = 0; i < TG_CAL_PUBLIC.length; i++) add(TG_CAL_PUBLIC[i], 'عمومی مدرسه');
  return out;
}

/* همهٔ کلاس‌های پیش رو، یکی برای هر عنوان در هر تقویم */
function tgClsScan_(days) {
  if (TG_DRY) return TG_MEM['clsev'] || [];
  var from = new Date(), to = new Date(from.getTime() + (days || TG_CLS_DAYS) * 86400000);
  var groups = {}, list = [];
  var cals = tgClsCals_();
  for (var i = 0; i < cals.length; i++) {
    var cal = null;
    try { cal = CalendarApp.getCalendarById(cals[i].id); } catch (e) {}
    if (!cal) continue;
    var ev = [];
    try { ev = cal.getEvents(from, to); } catch (e2) { continue; }
    for (var j = 0; j < ev.length; j++) {
      if (ev[j].isAllDayEvent()) continue;
      var title = ev[j].getTitle();
      var key = tgClsKey_(cals[i].id, title);
      if (groups[key]) continue;
      var mails = [];
      try { mails = ev[j].getGuestList().map(function (g) { return String(g.getEmail()).toLowerCase(); }); } catch (e3) {}
      groups[key] = { key: key, cal: cals[i].id, circle: cals[i].circle, title: tgClsTitle_(title) || title,
        next: ev[j].getStartTime(), email: mails.filter(function (m) { return m.indexOf('group.calendar') < 0; }).join(', ') };
      list.push(groups[key]);
    }
  }
  return list;
}

/* استادها با ایمیل؛ ستون «ایمیل» اگر نبود ته جدول ساخته می‌شود */
function tgClsTeaCol_(sh, head) {
  var w = sh.getLastColumn();
  var h = sh.getRange(1, 1, 1, w).getValues()[0];
  for (var i = 0; i < h.length; i++) if (String(h[i]).trim() === head) return i + 1;
  sh.getRange(1, w + 1).setValue(head).setFontWeight('bold').setBackground('#f9f2f2');
  return w + 1;
}
function tgClsTeachers_() {
  if (TG_DRY) return TG_MEM['clstea'] || [];
  var hit = tgCacheGet_('clstea');
  if (hit) { try { return JSON.parse(hit); } catch (e) {} }
  var sh = tgSchSheet_(TG_SCH_T_TEA, TG_SCH_TEA_HEAD);
  var mc = tgClsTeaCol_(sh, 'ایمیل');
  var last = sh.getLastRow();
  if (last < 2) return [];
  var v = sh.getRange(2, 1, last - 1, Math.max(mc, 27)).getValues();
  var out = [];
  for (var i = 0; i < v.length; i++) {
    var nm = String(v[i][0] || '').trim();
    if (!nm) continue;
    var st = String(v[i][7] || '').trim();
    if (st.indexOf('غیرفعال') > -1 || st.indexOf('پایان') > -1) continue;
    out.push({ row: i + 2, name: nm, chat: String(v[i][2] || '').trim(), role: String(v[i][3] || '').trim(),
      title: String(v[i][12] || '').trim(), link: String(v[i][24] || '').trim(), code: String(v[i][26] || '').trim(),
      email: String(v[i][mc - 1] || '').trim().toLowerCase(), mailCol: mc });
  }
  CacheService.getScriptCache().put('clstea', JSON.stringify(out), 600);
  return out;
}
function tgClsTeaByRow_(row) {
  var l = tgClsTeachers_();
  for (var i = 0; i < l.length; i++) if (l[i].row === row) return l[i];
  return null;
}
function tgClsTeaByEmail_(mails) {
  var l = tgClsTeachers_(), ms = String(mails || '').split(/[,\s]+/).filter(String);
  for (var i = 0; i < l.length; i++) if (l[i].email && ms.indexOf(l[i].email) > -1) return l[i];
  return null;
}

function tgClsSheet_() { return tgSchSheet_(TG_CLS_TAB, TG_CLS_HEAD); }
function tgClsRows_() {
  if (TG_DRY) return TG_MEM['clsrows'] || [];
  var sh = tgClsSheet_();
  if (!sh || sh.getLastRow() < 2) return [];
  var v = sh.getRange(2, 1, sh.getLastRow() - 1, TG_CLS_HEAD.length).getValues();
  var out = [];
  for (var i = 0; i < v.length; i++) {
    if (!String(v[i][0]).trim()) continue;
    out.push({ row: i + 2, key: String(v[i][0]), circle: String(v[i][1]), cal: String(v[i][2]), title: String(v[i][3]),
      next: String(v[i][4]), email: String(v[i][5]), teacher: String(v[i][6]).trim(), status: String(v[i][7]).trim(),
      asked: v[i][8] instanceof Date ? v[i][8].getTime() : (Number(v[i][8]) || 0), who: String(v[i][9]).trim(),
      tell: String(v[i][13]).trim() });
  }
  return out;
}
function tgClsSet_(row, col, val) {
  if (TG_DRY) { (TG_MEM['clsset'] = TG_MEM['clsset'] || []).push([row, col, val]); return; }
  tgClsSheet_().getRange(row, col).setValue(val);
}

/* تقویم‌ها ← تب؛ کلاسی که ایمیل استادش در تقویم هست خودکار ثبت می‌شود */
function tgClsSync_() {
  var groups = tgClsScan_();
  var rows = tgClsRows_(), byKey = {}, add = [], auto = 0;
  rows.forEach(function (r) { byKey[r.key] = r; });
  for (var i = 0; i < groups.length; i++) {
    var g = groups[i], r = byKey[g.key];
    var when = tgJDateFull_(g.next, TG_TZ) + ' ' + Utilities.formatDate(g.next, TG_TZ, 'HH:mm');
    var t = g.email ? tgClsTeaByEmail_(g.email) : null;
    if (!r) {
      if (t) auto++;
      add.push([g.key, g.circle, g.cal, g.title, when, g.email, t ? t.name : '', t ? TG_CLS_AUTO : TG_CLS_WAIT,
        '', '', t ? 'تقویم' : '', '', '', '']);
      continue;
    }
    tgClsSet_(r.row, 5, when);
    if (g.email && !r.email) tgClsSet_(r.row, 6, g.email);
    if (t && !r.teacher && r.status === TG_CLS_WAIT) {
      tgClsSet_(r.row, 7, t.name); tgClsSet_(r.row, 8, TG_CLS_AUTO); auto++;
    }
  }
  if (add.length) {
    if (TG_DRY) TG_MEM['clsrows'] = (TG_MEM['clsrows'] || []).concat(add.map(function (a, k) {
      return { row: 100 + k, key: a[0], circle: a[1], cal: a[2], title: a[3], next: a[4], email: a[5], teacher: a[6], status: a[7], asked: 0, who: '', tell: '' };
    }));
    else tgClsSheet_().getRange(tgClsSheet_().getLastRow() + 1, 1, add.length, TG_CLS_HEAD.length).setValues(add);
  }
  return { found: groups.length, added: add.length, auto: auto };
}

function tgClsPeople_() {
  if (TG_DRY) return TG_MEM['clsppl'] || { sch: [], chief: [] };
  var sch = [], chief = [];
  try {
    var own = tgSchoolOwners_(), scN = tgNm_('school'), chN = tgNm_('chief'), chF = tgNm_('chief_full');
    for (var i = 0; i < own.length; i++) {
      if (scN && own[i].name.indexOf(scN) > -1) sch.push(own[i]);
      else if (chN && own[i].name.indexOf(chN) > -1) chief.push(own[i]);
    }
    if (!chief.length) {
      var all = tgPeopleRows_();
      for (var j = 0; j < all.length; j++) if (chF && all[j].name.indexOf(chF) > -1 && all[j].chat) chief.push(all[j]);
    }
  } catch (e) {}
  return { sch: sch, chief: chief };
}
function tgClsChat_(p) { return String(p.chat || '').split(/[,،;\s]+/).filter(String)[0] || ''; }

function tgClsCardText_(r, esc) {
  return (esc ? '⏳ <b>این کلاس ۲۴ ساعت بی‌پاسخ ماند</b>\n\n' : '') +
    '🎓 <b>استاد این کلاس کیست؟</b>\n\n' +
    '«' + tgEsc_(r.title) + '»\nحلقه: ' + tgEsc_(r.circle) + '\nنزدیک‌ترین جلسه: ' + tgEsc_(r.next) +
    (r.email ? '\nمدعو در تقویم: ' + tgEsc_(r.email) : '') +
    '\n\nاستاد را از فهرست بزنید تا تقویم خودش در بات درست شود.';
}
function tgClsCardKb_(r) {
  var l = tgClsTeachers_().slice().sort(function (a, b) { return a.name.localeCompare(b.name, 'fa'); });
  var rows = [], cur = [];
  for (var i = 0; i < l.length; i++) {
    cur.push({ text: l[i].name, callback_data: 'cls:p:' + r.row + ':' + l[i].row });
    if (cur.length === 2) { rows.push(cur); cur = []; }
  }
  if (cur.length) rows.push(cur);
  rows.push([{ text: '➕ استادش در فهرست نیست', callback_data: 'cls:n:' + r.row }]);
  rows.push([{ text: '🚫 کلاس نیست، نادیده بگیر', callback_data: 'cls:x:' + r.row }]);
  return { inline_keyboard: rows };
}

/* هر ساعت از نگهبان: روزی یک بار تقویم‌ها خوانده می‌شود، کارت‌ها در ساعت کاری می‌روند */
function tgClsTick_(force) {
  var now = new Date(), t = tgRmTehran_(now);
  var p = TG_DRY ? null : PropertiesService.getScriptProperties();
  var day = t.day;
  if (force || (p && p.getProperty('TG_CLS_DAY') !== day)) {
    try { tgClsSync_(); } catch (e) { tgErr_('tgClsSync_: ' + e); }
    if (p) p.setProperty('TG_CLS_DAY', day);
  }
  if (!force && (t.h < 9 || t.h >= 20 || t.dow === 5)) return 0;
  var who = tgClsPeople_();
  var sch = who.sch[0], chief = who.chief[0];
  var rows = tgClsRows_(), sent = 0, esc = [];
  for (var i = 0; i < rows.length && sent < TG_CLS_ASK_MAX; i++) {
    var r = rows[i];
    if (r.status !== TG_CLS_WAIT) continue;
    if (!r.asked) {
      var to = sch || chief;
      if (!to) break;
      if (p && !p.getProperty('TG_CLS_INTRO')) {
        p.setProperty('TG_CLS_INTRO', String(Date.now()));
        tgSend_(tgClsChat_(to), '🎓 <b>تقویم استادها در بات</b>\n\nکلاس‌های مدرسه زیاد شده و هر استاد باید برنامهٔ خودش را در بات ببیند. ' +
          'برای هر کلاسی که استادش در سیستم مشخص نیست یک کارت کوتاه می‌آید؛ فقط استاد را بزنید. ' +
          'اگر استاد هنوز به بات وصل نباشد، لینک اختصاصی خودش را همان‌جا می‌دهم تا برایشان بفرستید. ' +
          'کارتی که ۲۴ ساعت بی‌پاسخ بماند برای مسئول ارشد مدرسه هم می‌رود.');
      }
      tgSend_(tgClsChat_(to), tgClsCardText_(r, false), tgClsCardKb_(r));
      tgClsSet_(r.row, 9, now); tgClsSet_(r.row, 10, to === sch ? tgNm_('school') : tgNm_('chief'));
      sent++;
      continue;
    }
    if (r.who === tgNm_('school') && chief && now.getTime() - r.asked >= TG_CLS_ESC_H * 3600000) {
      tgSend_(tgClsChat_(chief), tgClsCardText_(r, true), tgClsCardKb_(r));
      tgClsSet_(r.row, 10, tgNm_('school') + '، ' + tgNm_('chief'));
      esc.push(r.title);
      sent++;
    }
  }
  if (esc.length && sch) {
    tgSend_(tgClsChat_(sch), 'ℹ️ ' + tgFa_(esc.length) + ' کلاس ۲۴ ساعت بی‌پاسخ ماند و برای مسئول ارشد مدرسه هم فرستاده شد:\n' +
      esc.map(function (x) { return '• ' + tgEsc_(x); }).join('\n') + '\n\nهر کدام از شما زودتر جواب بدهد ثبت می‌شود.');
  }
  return sent;
}

function tgClsCanAnswer_(chat) {
  if (TG_DRY) return true;
  try { if (tgSjIsOwner_(chat)) return true; } catch (e) {}
  try { if (tgWatchIds_().indexOf(String(chat)) > -1) return true; } catch (e2) {}
  return false;
}

function tgClsInvite_(t) {
  var code = t.code;
  if (!code) {
    var seen = {};
    tgClsTeachers_().forEach(function (x) { if (x.code) seen[x.code] = 1; });
    code = tgTeaNewCode_(seen);
    if (!TG_DRY) {
      var sh = tgSchSheet_(TG_SCH_T_TEA, TG_SCH_TEA_HEAD);
      sh.getRange(t.row, 27).setValue(code);
      sh.getRange(t.row, 25).setValue(tgTeaLink_(code));
      tgSchDropCache_();
      CacheService.getScriptCache().remove('clstea');
    }
  }
  return tgTeaLink_(code);
}

/* بعد از انتخاب: یا به خود استاد خبر می‌دهیم، یا لینک دعوتش را به پاسخ‌دهنده */
function tgClsAfter_(chat, r, t) {
  if (t.chat) {
    var fk = 'clsn' + t.row;
    if (!tgGetVal_(fk, 'x')) {
      tgSetVal_(fk, 'x', '1');
      tgSend_(tgClsChat_(t), '📅 کلاس «' + tgEsc_(r.title) + '» در تقویم شما در بات ثبت شد.\n' +
        'برنامهٔ همهٔ کلاس‌هایتان در «' + TG_TEA_CAL + '» است و با یک ضربه به تقویم گوشی هم می‌رود.');
    }
    tgClsSet_(r.row, 14, 'به استاد خبر داده شد');
    return;
  }
  var link = tgClsInvite_(t);
  tgSend_(chat, '👤 <b>' + tgEsc_(t.name) + '</b> هنوز به بات وصل نیست.\n' +
    'پیام زیر را برایشان بفرستید. با یک ضربه وصل می‌شوند و بات می‌داند چه کسی هستند.');
  tgSend_(chat, 'سلام و وقت بخیر.\n' +
    'برنامهٔ کلاس‌های شما در مدرسهٔ تجربه حالا در بات تلگرام مرکز است: تاریخ و ساعت هر جلسه، یادآوری، و افزودن به تقویم گوشی.\n' +
    'برای اتصال فقط کافی است این لینک را باز کنید:\n' + link + '\n\nبا سپاس از همراهی‌تان 🌱');
  tgClsSet_(r.row, 14, 'لینک دعوت داده شد');
}

function tgOnCls_(cq, rest) {
  var chat = cq.message.chat.id, mid = cq.message.message_id;
  var a = rest.split(':');

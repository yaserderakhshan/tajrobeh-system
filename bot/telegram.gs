var T_PQ_MODECHK = '💻 <b>یک سؤال کوچک دربارهٔ شکل جلسه</b>\n\nبرای شکل جلسه فقط «حضوری» ثبت شده. جلسهٔ آنلاین هم می‌گیرید؟\n\n' +

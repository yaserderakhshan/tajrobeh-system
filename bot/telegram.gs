/* هاب پذیرش خلوت: فقط تب‌های کار روزانه دیده می‌شوند */
var TG_HUB_KEEP = ['کارتابل پیگیری', 'لیدها', 'نوبت پذیرش', 'تماس همکاران', 'پیام‌های درمانگران',
  'درخواست‌های حضوری', 'درمانگران', 'اسلات معارفه', 'وقت‌های هفتگی', 'استخرها', 'افراد'];
function tgHubTidy(apply) {
  var ss = tgSS_(), hid = [], shown = [];
  ss.getSheets().forEach(function (sh) {
    var n = sh.getName();
    if (TG_HUB_KEEP.indexOf(n) > -1) { shown.push(n); return; }
    if (!sh.isSheetHidden()) { hid.push(n); if (apply) sh.hideSheet(); }
  });
  return 'دیده می‌شوند: ' + shown.join('، ') + ' | ' + (apply ? 'پنهان شد: ' : 'پنهان می‌شود: ') + (hid.join('، ') || 'هیچ');
}

/* ─────────── v117 · هاب پیام یکپارچه و «برای نسخهٔ بعد» ─────────── */
var TG_MSG_BTN = '✉️ پیام‌ها';
var TG_MSG_LOG = 'پیام‌ها';
var TG_FB_LOG = 'بازخوردها';
var TG_MSG_HEAD = ['رشته', 'زمان', 'از', 'نقش فرستنده', 'به', 'گروه', 'متن', 'نوع', 'chat فرستنده', 'chat گیرنده', 'پاسخ به', 'دقیقه تا پاسخ'];
var TG_FB_HEAD = ['کد', 'زمان', 'نام', 'نقش', 'متن', 'نوع', 'تصمیم', 'تاریخ تصمیم', 'اجرا', 'خبر داده شد', 'chat'];
var TG_MSG_GROUPS = { desk: '📥 پذیرش', school: '🎓 مدرسه', fin: '💳 مالی', admin: '🧭 مدیر مرکز' };
var TG_MSG_TEAMR = ['پذیرش', 'مدرسه', 'مالی', 'سردبیر', 'سازمانی', 'ناظر'];

function tgMsgSS_() {
  if (TG_DRY) return null;
  if (TG_MSG_SS_MEM) return TG_MSG_SS_MEM;
  var P = PropertiesService.getScriptProperties(), id = tgCfg_('TG_MSG_SS') || P.getProperty('TG_MSG_SS');
  if (id) { try { TG_MSG_SS_MEM = SpreadsheetApp.openById(id); return TG_MSG_SS_MEM; } catch (e) {} }
  var ss = SpreadsheetApp.create('هاب پیام تجربه (خصوصی)');
  var a = ss.getSheets()[0]; a.setName(TG_MSG_LOG); a.setRightToLeft(true);
  a.getRange(1, 1, 1, TG_MSG_HEAD.length).setValues([TG_MSG_HEAD]).setFontWeight('bold').setBackground('#f9f2f2'); a.setFrozenRows(1);
  var b = ss.insertSheet(TG_FB_LOG); b.setRightToLeft(true);
  b.getRange(1, 1, 1, TG_FB_HEAD.length).setValues([TG_FB_HEAD]).setFontWeight('bold').setBackground('#f9f2f2'); b.setFrozenRows(1);
  P.setProperty('TG_MSG_SS', ss.getId());
  return ss;
}
function tgMsgAppend_(tab, row) {
  if (TG_DRY) { (TG_MEM['log' + tab] = TG_MEM['log' + tab] || []).push(row); return; }
  try { tgMsgSS_().getSheetByName(tab).appendRow(row); } catch (e) { tgErr_('tgMsgAppend_: ' + e); }
}
function tgMsgMe_(chat, uname) {
  if (TG_DRY) return TG_MEM['msgme'] || { name: 'تست', roles: ['مراجع'] };
  var ro = null;
  try { ro = tgRolesOf_(chat, uname); } catch (e) {}
  var roles = (ro && ro.roles) || [];
  return { name: (ro && ro.name) || '', roles: roles };
}
function tgMsgIsTeam_(roles) { return roles.some(function (r) { return TG_MSG_TEAMR.indexOf(r) > -1; }); }
function tgMsgRoleLbl_(roles) {
  var pri = ['ناظر', 'پذیرش', 'مدرسه', 'مالی', 'سردبیر', 'درمانگر', 'سوپروایزر', 'استاد', 'دانشجو'];
  for (var i = 0; i < pri.length; i++) if (roles.indexOf(pri[i]) > -1) return pri[i];
  return 'همراه';
}
function tgMsgFirst_(c) { return String(c || '').split(/[,،;\s]+/).filter(String)[0] || ''; }
/* گیرنده‌های هر گروه */
function tgMsgGroup_(g) {
  if (TG_DRY) return (TG_MEM['msggrp'] || {})[g] || [];
  var out = [];
  function add(p) { var c = tgMsgFirst_(p.chat); if (c && !out.some(function (x) { return x.chat === c; })) out.push({ chat: c, name: p.name }); }
  try {
    if (g === 'desk') { var w = tgDutyWho_(new Date()); if (w) add(w.p); else { var b = tgDutyBoss_(); if (b) add(b); } }
    else if (g === 'school') tgSchoolOwners_().forEach(add);
    else if (g === 'fin') tgPeopleRows_().forEach(function (p) { if (p.roles.indexOf('مالی') > -1) add(p); });
    else if (g === 'admin') tgWatchIds_().forEach(function (c) { add({ chat: c, name: 'مدیر مرکز' }); });
  } catch (e) {}
  return out;
}
/* فهرست افراد برای پیام تکی (فقط برای تیم) */
function tgMsgPeople_(k) {
  if (TG_DRY) return (TG_MEM['msgppl'] || {})[k] || [];
  var out = [], seen = {};
  function add(n, c) { c = tgMsgFirst_(c); if (!c || seen[c]) return; seen[c] = 1; out.push({ name: n, chat: c }); }
  if (k === 'team') {
    tgDeskRows_().forEach(function (p) { add(p.name, p.chat); });
    tgPeopleRows_().forEach(function (p) { if (tgMsgIsTeam_(p.roles)) add(p.name, p.chat); });
  } else if (k === 'ther') tgTherapistRows_().forEach(function (t) { if (String(t.status || '').indexOf('پایان') < 0) add(t.name, t.chat); });
  else if (k === 'tea') tgTeaRows_().forEach(function (t) { add(t.name, t.chat); });
  else if (k === 'stu') tgPeopleRows_().forEach(function (p) { if (p.roles.indexOf('دانشجو') > -1) add(p.name, p.chat); });
  return out;
}

function tgMsgStart_(chat, uname, pre) {
  var me = tgMsgMe_(chat, uname);
  if (pre) return tgMsgPickGroup_(chat, pre);
  var rows = [[{ text: TG_MSG_GROUPS.desk, callback_data: 'ms:g:desk' }, { text: TG_MSG_GROUPS.school, callback_data: 'ms:g:school' }],
    [{ text: TG_MSG_GROUPS.fin, callback_data: 'ms:g:fin' }, { text: TG_MSG_GROUPS.admin, callback_data: 'ms:g:admin' }]];
  if (tgMsgIsTeam_(me.roles)) rows.push([{ text: '👤 به یک نفر مشخص', callback_data: 'ms:c' }]);
  rows.push([{ text: '💡 برای نسخهٔ بعد چه می‌خواهید؟', callback_data: 'fb:go' }]);
  return tgSend_(chat, '✉️ <b>پیام‌ها</b>\nهمهٔ پیام‌های کاری از همین‌جا رد و بدل می‌شود و ثبت می‌ماند. به چه کسی؟', { inline_keyboard: rows });
}
function tgMsgPickGroup_(chat, g) {
  var to = tgMsgGroup_(g);
  if (!to.length) return tgSend_(chat, 'الان کسی در این بخش در دسترس بات نیست. لطفاً کمی بعد دوباره امتحان کنید.');
  tgSetVal_('msw', chat, JSON.stringify({ to: to.map(function (x) { return x.chat; }), label: TG_MSG_GROUPS[g] || g, g: g }));
  return tgSend_(chat, 'پیامتان به <b>' + tgEsc_(TG_MSG_GROUPS[g] || g) + '</b> را بنویسید یا ویس بفرستید.\nبرای انصراف /cancel');
}
function tgOnMsg_(cq, rest) {
  var chat = cq.message.chat.id, uname = cq.from && cq.from.username;
  var a = rest.split(':');
  if (a[0] === 'g') return tgMsgPickGroup_(chat, a[1]);
  var me = tgMsgMe_(chat, uname);
  if (a[0] === 'c') {
    if (!tgMsgIsTeam_(me.roles)) return tgSend_(chat, 'این بخش برای تیم مرکز است.');
    return tgSend_(chat, 'از کدام گروه؟', { inline_keyboard: [
      [{ text: 'همکار تیم', callback_data: 'ms:k:team' }, { text: 'درمانگر', callback_data: 'ms:k:ther' }],
      [{ text: 'استاد و سوپروایزر', callback_data: 'ms:k:tea' }, { text: 'دانشجو', callback_data: 'ms:k:stu' }]] });
  }
  if (a[0] === 'k') {
    if (!tgMsgIsTeam_(me.roles)) return null;
    tgSetVal_('msk', chat, a[1]);
    return tgSend_(chat, 'بخشی از نام را بنویسید (مثلاً نام خانوادگی).');
  }
  if (a[0] === 'p') {
    var list = [];
    try { list = JSON.parse(tgGetVal_('msl', chat) || '[]'); } catch (e) {}
    var p = list[Number(a[1])];
    if (!p) return tgSend_(chat, 'این انتخاب منقضی شده؛ دوباره از «' + TG_MSG_BTN + '» شروع کنید.');
    tgSetVal_('msw', chat, JSON.stringify({ to: [p.chat], label: p.name, g: 'one' }));
    return tgSend_(chat, 'پیامتان به <b>' + tgEsc_(p.name) + '</b> را بنویسید یا ویس بفرستید.\nبرای انصراف /cancel');
  }
  if (a[0] === 'r') {
    var th = tgMsgThread_(a[1]);
    if (!th) return tgSend_(chat, 'این گفت‌وگو پیدا نشد.');
    var other = String(th.a) === String(chat) ? th.b : [th.a];
    tgSetVal_('msw', chat, JSON.stringify({ to: other, label: String(th.a) === String(chat) ? th.label : th.an, g: th.g, th: a[1] }));
    return tgSend_(chat, 'پاسختان را بنویسید یا ویس بفرستید.');
  }
}
function tgMsgThread_(th) {
  var raw = TG_DRY ? TG_MEM['mth' + th] : CacheService.getScriptCache().get('mth' + th);
  if (raw) { try { return JSON.parse(raw); } catch (e) {} }
  if (TG_DRY) return null;
  try {
    var sh = tgMsgSS_().getSheetByName(TG_MSG_LOG), last = sh.getLastRow();
    if (last < 2) return null;
    var from = Math.max(2, last - 3000), v = sh.getRange(from, 1, last - from + 1, 10).getValues();
    for (var i = 0; i < v.length; i++) {
      if (String(v[i][0]) !== th) continue;
      return { a: String(v[i][8]), an: String(v[i][2]), b: String(v[i][9]).split(',').filter(String), label: String(v[i][4]), g: String(v[i][5]), at: v[i][1] instanceof Date ? v[i][1].getTime() : 0 };
    }
  } catch (e2) {}
  return null;
}
function tgMsgSaveTh_(th, o) {
  if (TG_DRY) { TG_MEM['mth' + th] = JSON.stringify(o); return; }
  CacheService.getScriptCache().put('mth' + th, JSON.stringify(o), 21600);
}
/* پیام یا ویس در حالت نوشتن */
function tgMsgMaybe_(chat, m, name, uname) {
  var text = m.text || '';
  if (tgCmd_(text) === '/cancel') { tgDel_('msw', chat); tgDel_('msk', chat); tgDelFlag_('fbw', chat); return false; }
  if (text === TG_MSG_BTN || tgCmd_(text) === '/msg') { tgDel_('msw', chat); return tgMsgStart_(chat, uname) || true; }
  if (text === '💬 پیام به مدرسه') { tgDel_('msw', chat); tgMsgPickGroup_(chat, 'school'); return true; }
  if (tgCmd_(text) === '/feedback') { tgFbStart_(chat); return true; }
  var k = tgGetVal_('msk', chat);
  if (k && text && text.indexOf('/') !== 0 && !tgIsBtnLike_(text)) {
    tgDel_('msk', chat);
    var q = tgNorm_(text), list = tgMsgPeople_(k).filter(function (p) { return tgNorm_(p.name).indexOf(q) > -1; }).slice(0, 8);
    if (!list.length) { tgSend_(chat, 'کسی با این نام پیدا نشد. دوباره از «' + TG_MSG_BTN + '» امتحان کنید.'); return true; }
    tgSetVal_('msl', chat, JSON.stringify(list));
    tgSend_(chat, 'کدام؟', { inline_keyboard: list.map(function (p, i) { return [{ text: p.name, callback_data: 'ms:p:' + i }]; }) });
    return true;
  }
  if (tgFlag_('fbw', chat) && (m.voice || (text && text.indexOf('/') !== 0 && !tgIsBtnLike_(text)))) { tgFbSave_(chat, m, name, uname); return true; }
  var w = tgGetVal_('msw', chat);
  if (!w) return false;
  if (!(m.voice || (text && text.indexOf('/') !== 0 && !tgIsBtnLike_(text)))) return false;
  tgDel_('msw', chat);
  var st = {};
  try { st = JSON.parse(w); } catch (e) { return false; }
  tgMsgDeliver_(chat, m, name, uname, st);
  return true;
}
function tgMsgDeliver_(chat, m, name, uname, st) {
  var me = tgMsgMe_(chat, uname), who = me.name || name, role = tgMsgRoleLbl_(me.roles);
  // v142: پارتنرها با نام فضایشان دیده شوند
  try { if (role === 'همراه' && typeof ptWho_ === 'function') { var pw0 = ptWho_(chat); if (pw0) { role = 'پارتنر · ' + ptName_(ptPlace_(pw0.code)); if (!who) who = pw0.role; } } } catch (ePw) {}
  var th = st.th || ('M-' + Date.now().toString(36).toUpperCase());
  var prev = st.th ? tgMsgThread_(st.th) : null;
  var kb = { inline_keyboard: [[{ text: '↩️ پاسخ', callback_data: 'ms:r:' + th }]] };
  var head = '✉️ <b>' + (st.th ? 'پاسخ از ' : 'پیام از ') + tgEsc_(who) + '</b> · ' + tgEsc_(role) + '\n\n';
  var body = m.text || '';
  var vt = (m.voice && typeof vxMsgText_ === 'function') ? vxMsgText_(chat, m) : '';   /* v166: متن ویس کنار خود ویس */
  (st.to || []).forEach(function (to) {
    if (m.voice) {
      tgSend_(to, head + '🎙 ویس:');
      if (!TG_DRY) tgApi_('copyMessage', { chat_id: to, from_chat_id: chat, message_id: m.message_id, reply_markup: kb });
      else TG_OUTBOX.push({ kind: 'copy', chat: String(to) });
      if (vt) tgSend_(to, '📝 <b>متن ویس</b> (خودکار):\n' + tgEsc_(vt.slice(0, 3500)), kb);
    } else tgSend_(to, head + tgEsc_(body), kb);
  });
  tgSend_(chat, '✓ رسید به ' + tgEsc_(st.label || '') + '. پاسخ همین‌جا می‌آید.' + (vt ? '\n\n📝 متنی که از ویستان درآمد و کنار ویس رفت:\n' + tgEsc_(vt.slice(0, 1500)) : ''));
  var now = Date.now();
  if (!st.th) tgMsgSaveTh_(th, { a: String(chat), an: who, b: st.to, label: st.label, g: st.g, at: now });
  else if (prev) { prev.at = now; tgMsgSaveTh_(th, prev); }
  var mins = prev && prev.at ? Math.round((now - prev.at) / 60000) : '';
  if (m.voice && !TG_DRY) {
    if (vt) body = '🎙 ' + vt;
    else { try { var tx = tgRmTranscribe_(tgTgFile_(m.voice.file_id).blob); body = '🎙 ' + (tx.text || '(ویس، متن گرفته نشد)'); } catch (e) { body = '🎙 ویس'; } }
  }
  tgMsgAppend_(TG_MSG_LOG, [th, new Date(now), who, role, st.label || '', st.g || '', String(body).slice(0, 4000), m.voice ? 'ویس' : 'متن',
    String(chat), (st.to || []).join(','), st.th ? 'بله' : '', mins]);
}

/* ---------- برای نسخهٔ بعد ---------- */
function tgFbStart_(chat) {
  tgSetFlag_('fbw', chat, 3600);
  return tgSend_(chat, '💡 <b>برای نسخهٔ بعد چه می‌خواهید؟</b>\nهر چه در بات یا مینی‌اپ کم است، کند است یا اذیت می‌کند. با متن یا ویس بگویید؛ همه خوانده می‌شود و نتیجه را به خودتان خبر می‌دهیم.');
}
function tgFbNext_() {
  if (TG_DRY) { TG_MEM['fbn'] = (TG_MEM['fbn'] || 100) + 1; return 'F-' + TG_MEM['fbn']; }
  var P = PropertiesService.getScriptProperties(), n = Number(P.getProperty('TG_FB_N') || 100) + 1;
  P.setProperty('TG_FB_N', String(n));
  return 'F-' + n;
}
function tgFbSave_(chat, m, name, uname) {
  tgDelFlag_('fbw', chat);
  var me = tgMsgMe_(chat, uname), code = tgFbNext_(), text = m.text || '';
  tgSend_(chat, '🙏 رسید (' + code + '). ممنون که گفتید؛ نتیجه را همین‌جا خبر می‌دهیم.');
  if (m.voice && !TG_DRY) {
    try { var tx = tgRmTranscribe_(tgTgFile_(m.voice.file_id).blob); text = tx.text || '(ویس، متن گرفته نشد)'; } catch (e) { text = '(ویس)'; }
  }
  var role = tgMsgRoleLbl_(me.roles);
  tgMsgAppend_(TG_FB_LOG, [code, new Date(), me.name || name, role, String(text).slice(0, 4000), m.voice ? 'ویس' : 'متن', '', '', '', '', String(chat)]);
  var ws = TG_DRY ? (TG_MEM['watch'] || []) : tgWatchIds_();
  ws.forEach(function (w) {
    if (m.voice && !TG_DRY) tgApi_('copyMessage', { chat_id: w, from_chat_id: chat, message_id: m.message_id });
    tgSend_(w, '💡 <b>' + code + ' · برای نسخهٔ بعد</b>\n' + tgEsc_(me.name || name) + ' · ' + tgEsc_(role) + '\n\n' + tgEsc_(String(text).slice(0, 1500)),
      { inline_keyboard: [[{ text: '✅ انجام می‌دهیم', callback_data: 'fb:y:' + code }, { text: '🕒 بعداً', callback_data: 'fb:l:' + code }, { text: '✖️ نه', callback_data: 'fb:n:' + code }]] });
  });
  return code;
}
function tgFbFind_(code) {
  if (TG_DRY) return (TG_MEM['fbrow'] || {})[code] || null;
  var sh = tgMsgSS_().getSheetByName(TG_FB_LOG), last = sh.getLastRow();
  if (last < 2) return null;
  var v = sh.getRange(2, 1, last - 1, TG_FB_HEAD.length).getValues();
  for (var i = v.length - 1; i >= 0; i--) if (String(v[i][0]) === code) return { row: i + 2, text: String(v[i][4]), chat: String(v[i][10]), name: String(v[i][2]) };
  return null;
}
function tgFbSet_(row, col, val) {
  if (TG_DRY) { (TG_MEM['fbset'] = TG_MEM['fbset'] || []).push([row, col, val]); return; }
  tgMsgSS_().getSheetByName(TG_FB_LOG).getRange(row, col).setValue(val);
}
function tgOnFb_(cq, rest) {
  var chat = cq.message.chat.id, mid = cq.message.message_id;
  var a = rest.split(':');
  if (a[0] === 'go') return tgFbStart_(chat);
  var isW = TG_DRY ? true : tgWatchIds_().indexOf(String(chat)) > -1;
  if (!isW) return null;
  var f = tgFbFind_(a[1]);
  if (!f) return tgSend_(chat, 'این مورد پیدا نشد.');
  var lbl = { y: '✅ انجام می‌دهیم', l: '🕒 بعداً', n: '✖️ فعلاً نه', d: '✅ انجام شد' }[a[0]];
  if (!lbl) return null;
  if (a[0] === 'd') {
    tgFbSet_(f.row, 9, 'انجام شد'); tgFbSet_(f.row, 10, new Date());
    if (f.chat) tgSend_(f.chat, '💡 پیشنهادی که برای نسخهٔ بعد داده بودید انجام شد:\n«' + tgEsc_(f.text.slice(0, 300)) + '»\n\nممنون که گفتید؛ ببینید و اگر هنوز چیزی کم است، باز بگویید 🌱');
  } else {
    tgFbSet_(f.row, 7, lbl); tgFbSet_(f.row, 8, new Date());
  }
  var kb = a[0] === 'y' ? { inline_keyboard: [[{ text: '✅ انجام شد، خبرش را بده', callback_data: 'fb:d:' + a[1] }]] } : null;
  var txt = '💡 <b>' + a[1] + '</b> · ' + lbl + '\n\n' + tgEsc_(f.text.slice(0, 1200));
  if (TG_DRY) { TG_OUTBOX.push({ kind: 'edit', chat: String(chat), text: txt, markup: kb }); return null; }
  var b = { chat_id: chat, message_id: mid, text: txt, parse_mode: 'HTML' };
  if (kb) b.reply_markup = kb;
  return tgApi_('editMessageText', b);
}
/* یک بار: از همهٔ نقش‌های تیم بپرس */
function tgFbKickoff() {
  var seen = {}, n = 0;
  var list = [];
  tgDeskRows_().forEach(function (p) { list.push({ name: p.name, chat: tgMsgFirst_(p.chat) }); });
  tgPeopleRows_().forEach(function (p) { if (tgMsgIsTeam_(p.roles) || p.roles.indexOf('راهبر') > -1) list.push({ name: p.name, chat: tgMsgFirst_(p.chat) }); });
  var ws = tgWatchIds_();
  list.forEach(function (p) {
    if (!p.chat || seen[p.chat] || ws.indexOf(p.chat) > -1) return;
    seen[p.chat] = 1;
    try {
      tgSend_(p.chat, '💡 <b>نسخهٔ بعد را با هم بسازیم</b>\n\nبات و مینی‌اپ برای کار روزانهٔ شماست. برای نسخهٔ بعد چه می‌خواهید؟ ' +
        'هر چه کم است، کند است یا اذیت می‌کند، با متن یا ویس بگویید. همه خوانده می‌شود و هر چه انجام شد به خودتان خبر می‌دهیم.\n\n' +
        'از این به بعد پیام‌های کاری هم از «' + TG_MSG_BTN + '» رد و بدل می‌شود تا چیزی گم نشود.',
        { inline_keyboard: [[{ text: '💡 می‌گویم', callback_data: 'fb:go' }]] });
      n++;
      Utilities.sleep(150);
    } catch (e) {}
  });
  return 'پرسش نسخهٔ بعد فرستاده شد: ' + n;
}
function tgMsgSetup() {
  var ss = tgMsgSS_();
  return ss ? ss.getUrl() : 'dry';
}

try { TG_SUITES.push(['پیام و بازخورد', 'tgV117MsgTests']); } catch (eSu) {}
function tgV117MsgTests() {
  var out = [], pass = 0, fail = 0;
  function ok(n, c) { c ? pass++ : fail++; out.push((c ? '✅ ' : '❌ ') + n); }
  var wasDry = TG_DRY, wasOut = TG_OUTBOX, wasMem = TG_MEM;
  TG_DRY = true;
  try {
    TG_OUTBOX = []; TG_MEM = {};
    TG_MEM['msgme'] = { name: 'درمانگر آزمایشی', roles: ['درمانگر', 'مراجع'] };
    TG_MEM['msggrp'] = { desk: [{ chat: '9101', name: 'پذیرش' }], school: [{ chat: '9102', name: 'مدرسه' }] };
    tgMsgStart_(9001, '');

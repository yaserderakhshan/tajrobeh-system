function tgPeopleRows_() {
  const sh = tgPeopleSheet_();
  const last = sh.getLastRow();
  if (last < 2) return [];
  const v = sh.getRange(2, 1, last - 1, TG_PEOPLE_HEAD.length).getValues();
  const out = [];
  for (var i = 0; i < v.length; i++) {
    const name = String(v[i][0]).trim();
    if (!name) continue;
    out.push({
      row: i + 2, name: name,
      user: String(v[i][1]).trim().replace(/^@/, '').toLowerCase(),
      chat: String(v[i][2]).trim(),
      roles: String(v[i][3]).split(/[,،;]+/).map(function (x) { return x.trim(); }).filter(Boolean),
      circle: String(v[i][4]).trim(),
      status: String(v[i][5]).trim() || 'فعال',
      scope: String(v[i][8] || '').trim(),
      phone: String(v[i][6] || '').trim(),
      id: String(v[i][13] || '').trim()
    });
  }
  return out;
}

function tgChatIn_(cell, chat) {
  const c = String(chat).trim();
  if (!c) return false;
  const ids = String(cell || '').split(/[,،;\s]+/);
  for (var j = 0; j < ids.length; j++) if (ids[j].trim() && ids[j].trim() === c) return true;
  return false;
}

/* همهٔ نقش‌های یک نفر را برمی‌گرداند، از هر سه منبع */
function tgRolesOf_(chat, username) {
  const u = String(username || '').replace(/^@/, '').toLowerCase();
  const res = { name: '', roles: [], ther: null, desk: null, person: null };

  const th = tgWhoTherapist_(chat);
  if (th) { res.ther = th; res.name = th.name; res.roles.push('درمانگر'); }

  const dk = tgWhoDesk_(chat, username);
  if (dk) { res.desk = dk; if (!res.name) res.name = dk.name; if (res.roles.indexOf('پذیرش') < 0 && String(dk.role || '').indexOf('پذیرش') > -1) res.roles.push('پذیرش'); }

  try {
    const pp = tgPeopleList_();
    for (var i = 0; i < pp.length; i++) {
      const p = pp[i];
      if (p.status.indexOf('غیرفعال') > -1) continue;
      const byChat = tgChatIn_(p.chat, chat);
      const byUser = u && p.user && p.user === u && !String(p.chat || '').trim();   /* v170.9 (امنیت): یوزرنیم فقط برای ردیف بی chat */
      if (!byChat && !byUser) continue;
      res.person = p;
      if (!res.name) res.name = p.name;
      for (var k = 0; k < p.roles.length; k++) if (res.roles.indexOf(p.roles[k]) < 0) res.roles.push(p.roles[k]);
    }
  } catch (e) {}
  return res;
}

function tgHasRole_(r, role) { return r && r.roles && r.roles.indexOf(role) > -1; }

function tgWhoAmI(chatId) {
  const r = tgRolesOf_(chatId, '');
  return r.name + ' → ' + (r.roles.length ? r.roles.join('، ') : 'بدون نقش');
}


/* ---------- مسیریابی ---------- */

function tnkMenuRow_() { return TNK_CUR ? [[{ text: TNK_BTN }]] : []; }

function tnkFileOf_(m) {
  if (m && m.photo && m.photo.length) return m.photo[m.photo.length - 1].file_id;
  if (m && m.document) return m.document.file_id;
  return null;
}

function tnkRoute_(m, chat, name, uname) {
  var text = String((m && m.text) || '').trim();
  if (text === TNK_BTN) { tnkHome_(chat); return true; }
  var st = tnkState_(chat);
  if (!st) return false;
  var f = tnkFileOf_(m);
  if (f && st.s === 'file') {
    if (st.f === 'sp') { tnkSpSave_(chat, f); return true; }
    if (st.f === 'ch') { tnkChSave_(chat, f); return true; }
  }
  if (!text) return false;
  if (st.f === 'sp' && st.s === 'amt') { tnkSpAmt_(chat, text); return true; }
  if (st.f === 'sp' && st.s === 'why') { tnkSpWhy_(chat, text); return true; }
  if (st.f === 'rq' && st.s === 'amt') { tnkRqAmt_(chat, text); return true; }
  if (st.f === 'rq' && st.s === 'why') { tnkRqSave_(chat, text); return true; }
  if (st.f === 'ch' && st.s === 'amt') { tnkChAmt_(chat, text); return true; }
  return false;
}

function tnkCb_(cq, rest, chat, name, uname) {
  var p = String(rest || '').split(':'), a = p[0];
  var arg = p.slice(1).join(':');
  if (a === 'h')   return tnkHome_(chat);
  if (a === 'sp')  return tnkSpStart_(chat);
  if (a === 'cat') return tnkSpCat_(chat, arg);
  if (a === 'nof') {
    var st = tnkState_(chat);
    if (st && st.f === 'sp') return tnkSpSave_(chat, null);
    if (st && st.f === 'ch') return tnkChSave_(chat, null);
    return null;
  }
  if (a === 'rq')  return tnkRqStart_(chat);
  if (a === 'my')  return tgSend_(chat, tnkMyText_(chat), tnkHomeKb_(chat));
  if (a === 'rp')  return tgSend_(chat, tnkReportText_(chat), tnkHomeKb_(chat));
  if (a === 'ch')  return tnkChStart_(chat, '', '');
  if (a === 'cw')  return tnkChStart_(chat, arg, '');
  if (a === 'cm')  return tnkChHow_(chat, arg);
  if (a === 'rl')  return tnkReqList_(chat);
  if (a === 'ra')  { var r = tnkReqByCode_(arg); return r ? tnkChStart_(chat, r['تنخواه‌گردان'], arg) : null; }
  if (a === 'rn')  return tnkReqNo_(chat, arg);
  if (a === 'x')   { tnkEnd_(chat); return tgSend_(chat, 'باشد، لغو شد.', tnkHomeKb_(chat)); }
  return null;
}


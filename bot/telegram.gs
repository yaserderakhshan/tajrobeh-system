var TG_API_CB_CLIENT = ['t:', 'g:', 'nd:', 'pf:', 'ag:', 'md:', 'z:', 'b:', 's:', 'ss:', 'sw:',
  'fu:', 'ct:', 'fd:', 'f:', 'ann:', 'tc:', 'ip:', 'iy:', 'it:', 'py:', 'sj:', 'mz:', 'pq:',
  'hm', 'go', 'edu', 'em:ask', 'cancelmeet', 'lc:', 'lh:'];
var TG_API_CB_THER = ['p:', 'd:', 'h:', 'n:', 'c:', 'rw:', 'iq:', 'ic:', 'ip:', 'iy:', 'it:', 'md:',
  'pq:', 'py:', 'rf:', 'mt:', 'z:', 'b:', 's:', 'cancelmeet'];

function tgApiCb1_(p, role, cb) { return tgApiDo_(p, { role: role, cb: tgCbResolve_(cb) }); }
function tgApiFn_(p, role, fn) { return tgApiDo_(p, { role: role, fn: fn }); }

/* ---------- me: کیستم، چه نقش‌هایی دارم، به کدام سطرها وصلم ---------- */

/* ---------- cap: رجیستری قابلیت‌ها برای همین کاربر ----------
   منوی مینی‌اپ از روی همین ساخته می‌شود، نه از حدس کلاینت. هر قابلیت تازهٔ بات
   که در TG_CAP ردیف بگیرد، بی‌هیچ تغییری در کلاینت در مینی‌اپ هم دیده می‌شود. */

function tgApiCap_(p) {
  var w = tgApiWho_(p);
  if (!w) return { ok: false, error: 'auth' };
  var g = tgApiRoles_(w);
  var mine = g.roles || [];
  var list = [];
  for (var i = 0; i < TG_CAP.length; i++) {
    var c = TG_CAP[i];
    if (!c.api) continue;
    if (!c.app) continue;
    if (!c.page) continue;
    var rr = c.roles || [];
    var okRole = rr.length === 0;
    for (var j = 0; j < rr.length; j++) if (mine.indexOf(rr[j]) > -1) okRole = true;
    if (!okRole) continue;
    var a = String(c.api);
    var tail = a.slice(-4);
    var plumb = (tail === '.act' || tail === '.say' || tail === 'card' || a === 'desk.refer') ? 1 : 0;
    list.push({ key: c.key, label: c.label, api: a, page: c.page, plumb: plumb });
  }
  return { ok: true, roles: mine, caps: list };
}

function tgApiMe_(p) {
  if (TG_DRY) return tgApiMeRaw_(p);
  var uu = null;
  try { uu = tgVerifyInitData_(p && p.initData); } catch (eu) { uu = null; }
  if (!uu || !uu.id) return { ok: false, error: 'auth' };
  var mk = 'tjme:' + uu.id;
  var mh = tgApiCacheGet_(mk);
  if (mh && mh.ok) return mh;
  var mv = tgApiMeRaw_(p);
  if (mv && mv.ok) tgApiCachePut_(mk, mv, TG_API_ME_TTL);
  return mv;
}

function tgApiMeRaw_(p) {
  var user = tgVerifyInitData_(p.initData);
  if (!user || !user.id) return { ok: false, error: 'auth' };
  var chat = user.id;
  var w = {
    chat: chat, uname: user.username || '', first: user.first_name || '', last: user.last_name || '',
    name: [user.first_name, user.last_name].filter(String).join(' ').trim() || 'بدون نام'
  };
  var raw = tgGetVal_('meet', chat);
  var meeting = null;
  if (raw) { try { meeting = JSON.parse(raw); } catch (e) {} }
  var info = meeting ? (tgTherapistInfo_()[meeting.t] || {}) : {};

  var g = tgApiRoles_(w);
  var r = g.info || {};
  var act = '';
  try { act = String(tgGetVal_('role', chat) || ''); } catch (e2) {}
  if (g.roles.indexOf(act) < 0) {
    var work = g.roles.filter(function (x) { return x !== 'مراجع'; });
    act = work.length === 1 ? work[0] : '';
  }

  var links = { therapist: '', desk: '', person: '', teacher: '', supervisor: '', student: [], alumni: '' };
  try { if (r.ther) links.therapist = r.ther.name || ''; } catch (e3) {}
  try { if (r.desk) links.desk = r.desk.name || ''; } catch (e4) {}
  try { if (r.person) links.person = r.person.name || ''; } catch (e5) {}
  try {
    var te = tgTeaWho_(chat, w.uname);
    if (te) {
      links.teacher = te.name || '';
      if (String(te.role || '').indexOf('سوپروایزر') > -1) links.supervisor = te.name || '';
    }
  } catch (e6) {}
  try {
    var mem = tgPathMemberships_(chat) || [];
    for (var i = 0; i < mem.length; i++) links.student.push(mem[i].course + ' · ' + mem[i].circle + ' · ' + mem[i].status);
  } catch (e7) {}
  try { links.alumni = tgPathAlum_(chat) || ''; } catch (e8) {}

  var display = links.therapist || links.teacher || links.person || links.desk || w.name;

  return {
    ok: true,
    chat: String(chat),
    name: w.name,
    display: display,
    username: w.uname,
    roles: g.roles,
    role: act,
    roleLabels: g.roles.map(function (x) { return TG_ROLE_BTN[x] || x; }),
    links: links,
    meeting: meeting ? { therapist: meeting.t, dateIso: meeting.d, hhmm: meeting.h, meet: info.meet || '' } : null
  };
}

/* ---------- تست همگامی بات و مینی‌اپ ---------- */

function tgParityTests() {
  var out = [], pass = 0, fail = 0;
  function ok(n, c) { if (c) { pass++; } else { fail++; } out.push((c ? '✅ ' : '❌ ') + n); }

  var src = '';
  try { src = String(tgApiRoute_); } catch (e) { src = ''; }
  ok('متن tgApiRoute_ خوانده شد', src.length > 500);
  var lines = src.split('\n');

  /* ۱. قابلیتی که در بات هست ولی در مینی‌اپ نیست */
  var miss = [];
  for (var i = 0; i < TG_CAP.length; i++) {
    var c = TG_CAP[i];
    if (!c.bot) continue;
    if (c.appNa) continue;
    if (c.api && c.app) continue;
    miss.push(c.label);
  }
  ok('همهٔ قابلیت‌های بات در مینی‌اپ هم هستند' +
    (miss.length ? ' · قابلیت «' + miss.join('» و «') + '» در بات هست ولی در مینی‌اپ نیست' : ''), miss.length === 0);

  /* ۵. app بدون اندپوینت یعنی ادعای بی‌پشتوانه */
  var lie = TG_CAP.filter(function (c) { return c.app && !c.api; }).map(function (c) { return c.key; });
  ok('هیچ ردیفی app دارد بی‌اندپوینت' + (lie.length ? ' · ' + lie.join(', ') : ''), lie.length === 0);

  /* شناسهٔ تکراری */
  var seenK = {}, dupK = [], seenA = {}, dupA = [];
  TG_CAP.forEach(function (c) {
    if (seenK[c.key]) dupK.push(c.key); seenK[c.key] = 1;
    if (c.api) { if (seenA[c.api]) dupA.push(c.api); seenA[c.api] = 1; }
  });
  ok('کلید تکراری در رجیستری نیست' + (dupK.length ? ' · ' + dupK.join(', ') : ''), dupK.length === 0);
  ok('اندپوینت تکراری در رجیستری نیست' + (dupA.length ? ' · ' + dupA.join(', ') : ''), dupA.length === 0);

  /* ۲. هر api نوشته‌شده واقعاً در tgApiRoute_ هست */
  var noRoute = [], noGuard = [];
  for (var j = 0; j < TG_CAP.length; j++) {
    var c2 = TG_CAP[j];
    if (!c2.api) continue;
    var needle = "api === '" + c2.api + "'";
    var line = '';
    for (var k = 0; k < lines.length; k++) if (lines[k].indexOf(needle) > -1) { line = lines[k]; break; }
    if (!line) { noRoute.push(c2.api); continue; }
    /* ۳. اندپوینت نقش‌محور باید از tgApiGuard_ بگذرد */
    if (c2.roles && c2.roles.length && line.indexOf('tgApiGuard_') < 0) noGuard.push(c2.api);
  }
  ok('هر اندپوینت رجیستری در tgApiRoute_ هست' + (noRoute.length ? ' · نبود: ' + noRoute.join(', ') : ''), noRoute.length === 0);
  ok('هر اندپوینت نقش‌محور از tgApiGuard_ می‌گذرد' + (noGuard.length ? ' · بی‌گیت: ' + noGuard.join(', ') : ''), noGuard.length === 0);

  /* ۴. اندپوینتی در مسیر که در رجیستری نیست */
  var found = {}, m, re = /api === '([^']+)'/g;
  while ((m = re.exec(src))) found[m[1]] = 1;
  var orphan = Object.keys(found).filter(function (a) { return !seenA[a]; });
  ok('اندپوینت بی‌ردیف در رجیستری نیست' + (orphan.length ? ' · ' + orphan.join(', ') : ''), orphan.length === 0);

  /* نقش‌های رجیستری باید از TG_ROLES باشند */
  var badRole = [];
  TG_CAP.forEach(function (c) {
    (c.roles || []).forEach(function (rr) { if (TG_ROLES.indexOf(rr) < 0 && badRole.indexOf(rr) < 0) badRole.push(rr); });
  });
  ok('نقش‌های رجیستری از TG_ROLES هستند' + (badRole.length ? ' · ' + badRole.join(', ') : ''), badRole.length === 0);

  /* پل ضبط باید در سه تابع پایه باشد */
  ok('tgSend_ پل ضبط دارد', String(tgSend_).indexOf('TG_API_CHAT') > -1);
  ok('tgPhoto_ پل ضبط دارد', String(tgPhoto_).indexOf('TG_API_CHAT') > -1);
  ok('tgApi_ پل ضبط دارد', String(tgApi_).indexOf('TG_API_CHAT') > -1);

  /* گیت واقعاً کار می‌کند */
  var wasDry = TG_DRY, wasMem = TG_MEM, wasBox = TG_OUTBOX;
  TG_DRY = true; TG_MEM = {}; TG_OUTBOX = [];
  try {
    TG_MEM['apiwho'] = { chat: 9001, uname: 'tester', first: 'تست', last: '', name: 'تست' };
    TG_MEM['roles'] = ['مراجع'];
    var g1 = tgApiGuard_({ initData: 'x' }, 'پذیرش');
    ok('بی‌نقش پذیرش، گیت رد می‌کند', !!g1 && g1.ok === false && g1.error === 'role');
    var g2 = tgApiGuard_({ initData: 'x' }, 'مراجع');
    ok('با نقش مراجع، گیت اجازه می‌دهد', g2 === null);
    TG_MEM['apiwho'] = null;
    var g3 = tgApiGuard_({ initData: '' }, 'پذیرش');
    ok('بدون initData خطای auth می‌دهد', !!g3 && g3.error === 'auth');
    TG_MEM['apiwho'] = { chat: 9001, uname: 'tester', first: 'تست', last: '', name: 'تست' };
    var bad = tgApiC_({ initData: 'x', cb: 'ld:close:L-1' }, '', ['sv:']);
    ok('کال‌بک خارج از فهرست مجاز رد می‌شود', !!bad && bad.error === 'cb');
    /* پل ضبط: پیام به خود کاربر ضبط می‌شود، پیام به دیگری نه */
    TG_OUTBOX = [];
    var cap = tgApiCapture_({ chat: 9001, uname: '', first: 'تست', last: '', name: 'تست' }, {
      fn: function (w2) { tgSend_(w2.chat, 'سلام مینی‌اپ'); tgSend_(9002, 'برای کس دیگر'); }
    });
    ok('پیام به خود کاربر ضبط می‌شود', cap.ok === true && cap.out.length === 1 && cap.out[0].text === 'سلام مینی‌اپ');
    ok('پیام به دیگران ضبط نمی‌شود و رد می‌شود', TG_OUTBOX.filter(function (x) { return x.chat === '9002'; }).length === 1);
    ok('بعد از ضبط، TG_API_CHAT صفر می‌شود', TG_API_CHAT === 0);
  } catch (e2) {
    ok('اجرای تست بدون خطا · ' + e2, false);
  }
  TG_DRY = wasDry; TG_MEM = wasMem; TG_OUTBOX = wasBox;

  /* لایهٔ کلاینت: هر اندپوینت مینی‌اپ باید صفحهٔ کلاینت داشته باشد */
  var noPage = TG_CAP.filter(function (c) { return c.api && !c.page; }).map(function (c) { return c.api; });
  ok('هر اندپوینت مینی‌اپ صفحهٔ کلاینت دارد' + (noPage.length ? ' · بی‌صفحه: ' + noPage.join(', ') : ''), noPage.length === 0);

  return { pass: pass, fail: fail, text: out.join('\n') };
}


/* ═══════ مجله نسخهٔ ۹۹ · لینک‌ساز UTM و اعلام موضوع‌ها (۲۵ شهریور ۱۴۰۵) ═══════ */

var TG_UTM_SS_ID = cfg_('TG_STAT_SHEET_ID', '');
var TG_UTM_TAB   = 'سئو · لینک‌های UTM';
var TG_UTM_BASE  = 'https://tajrobeh.life';
var TG_UTM_PAGES = { tl: 'tajrobeh.life', ts: 'tajrobeh_school' };
var TG_UTM_MEDS  = ['post', 'story', 'reel', 'bio'];
var TG_UTM_SS_   = null;

function tgUtmSheet_() {
  if (TG_DRY) return null;
  if (!TG_UTM_SS_) TG_UTM_SS_ = SpreadsheetApp.openById(TG_UTM_SS_ID);
  return TG_UTM_SS_.getSheetByName(TG_UTM_TAB);
}

function tgUtmPath_(s) {
  var t = String(s || '').trim();
  t = t.replace(/^https?:\/\/[^\/]*/i, '');
  t = t.split('?')[0].split('#')[0];
  if (!t) t = '/';
  if (t.charAt(0) !== '/') t = '/' + t;
  if (t.charAt(t.length - 1) !== '/' && t.indexOf('.') < 0) t += '/';
  return t;
}

function tgUtmClear_(chat) {
  tgDel_('utmp', chat); tgDel_('utmpath', chat); tgDel_('utmpg', chat);
}

function tgUtmStart_(chat) {
  tgUtmClear_(chat);
  tgSetFlag_('utmp', chat, 1800);
  return tgSend_(chat,
    '🔗 <b>لینک UTM برای سوشال</b>\n\nمسیر صفحه را بفرست. هم لینک کامل قبول است هم فقط مسیر.\n\nنمونه: <code>/guide/kostenerstattung/</code>',
    { inline_keyboard: [[{ text: '↩️ انصراف', callback_data: 'ut:x' }]] });
}

function tgUtmPathGot_(chat, text) {
  var p = tgUtmPath_(text);
  tgDel_('utmp', chat);
  tgSetVal_('utmpath', chat, p);
  return tgSend_(chat, '📄 مسیر: <code>' + tgEsc_(p) + '</code>\n\nاز کدام پیج منتشر می‌شود؟', {
    inline_keyboard: [
      [{ text: '🍓 tajrobeh.life', callback_data: 'ut:p:tl' }],
      [{ text: '🎓 tajrobeh_school', callback_data: 'ut:p:ts' }],
      [{ text: '↩️ انصراف', callback_data: 'ut:x' }]
    ] });
}

function tgUtmPage_(chat, key) {
  if (!TG_UTM_PAGES[key]) return tgUtmStart_(chat);
  tgSetVal_('utmpg', chat, key);
  return tgSend_(chat, '📣 پیج: <b>' + TG_UTM_PAGES[key] + '</b>\n\nقالب انتشار؟', {
    inline_keyboard: [
      [{ text: '🖼 پست', callback_data: 'ut:m:post' }, { text: '⏱ استوری', callback_data: 'ut:m:story' }],
      [{ text: '🎬 ریلز', callback_data: 'ut:m:reel' }, { text: '🔗 بایو', callback_data: 'ut:m:bio' }],
      [{ text: '↩️ انصراف', callback_data: 'ut:x' }]
    ] });
}

function tgUtmWho_(chat) {
  try {
    var list = tgPeopleList_();
    for (var i = 0; i < list.length; i++) if (String(list[i].chat) === String(chat)) return list[i].name || String(chat);
  } catch (e) {}
  return String(chat);
}

function tgUtmBuild_(path, pg, med, code, day) {
  return TG_UTM_BASE + path + '?utm_source=instagram&utm_medium=' + med +
         '&utm_campaign=' + pg + '_' + day + '&utm_content=' + code;
}

function tgUtmMake_(chat, med) {
  if (TG_UTM_MEDS.indexOf(med) < 0) return tgUtmStart_(chat);
  var path = tgGetVal_('utmpath', chat), pg = tgGetVal_('utmpg', chat) || 'tl';
  if (!path) return tgUtmStart_(chat);
  var sh = tgUtmSheet_();
  if (!sh) return tgSend_(chat, 'تب لینک‌های UTM در هاب آمار پیدا نشد.', tgMagEdMenu_());
  var last = sh.getLastRow(), max = 100;
  if (last > 2) {
    var codes = sh.getRange(3, 1, last - 2, 1).getValues();
    for (var i = 0; i < codes.length; i++) {
      var m = String(codes[i][0] || '').match(/^U-(\d+)$/);
      if (m && Number(m[1]) > max) max = Number(m[1]);
    }
  }
  var code = 'U-' + (max + 1);
  var day  = Utilities.formatDate(new Date(), TG_TZ, 'yyyyMMdd');
  var url  = tgUtmBuild_(path, pg, med, code, day);
  sh.appendRow([code, tgJDateFull_(new Date(), TG_TZ), tgUtmWho_(chat), TG_UTM_PAGES[pg], med, path, url, '']);
  tgUtmClear_(chat);
  return tgSend_(chat, '✅ لینک ساخته شد و در هاب آمار ثبت شد (<code>' + code + '</code>)\n\n<code>' +
                 tgEsc_(url) + '</code>\n\nهمین را در کپشن بگذار. دستی دستکاری‌اش نکن.', tgMagEdMenu_());
}


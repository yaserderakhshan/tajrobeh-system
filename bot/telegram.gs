function tgPrKb_(p) {
  var s = ':' + p.row + ':' + p.h, val = tgPrValid_(p);
  var first = p.blocked ? [{ text: '⛔ تصمیم تیم: روی سایت نمی‌رود', callback_data: 'pr:ed' + s }]

function tgApIvAskKb_() {
  return { inline_keyboard: [
    [{ text: '🗓 اعلام وقت مصاحبه', callback_data: 'siv:go' }],
    [{ text: '📋 وقت‌های مصاحبهٔ من', callback_data: 'siv:list' }]
  ] };
}

function tgApSupByChat_(chat, uname) {
  var all = [];
  try { all = tgApTeaRows_(); } catch (e) { return null; }
  var u = String(uname || '').replace(/^@/, '').toLowerCase();
  for (var i = 0; i < all.length; i++) {
    var ids = String(all[i].chat || '').split(/[,،;\s]+/).filter(String);
    for (var j = 0; j < ids.length; j++) if (ids[j] === String(chat)) return all[i];
    if (u && all[i].user && all[i].user === u) return all[i];
  }
  return null;
}

function tgApIvEntry_(chat, uname) {
  var who = tgApSupByChat_(chat, uname);
  if (!who) { tgSend_(chat, 'این بخش برای سوپروایزرهای تجربه است.'); return true; }
  tgSend_(chat, T_AP_IV_ASK, tgApIvAskKb_());
  return true;
}

function tgOnSiv_(cq, rest) {
  var chat = cq.message.chat.id;
  var uname = cq.from && cq.from.username ? '@' + cq.from.username : '';
  var p = String(rest || '').split(':');
  var act = p[0] || '';
  var who = tgApSupByChat_(chat, uname);
  if (!who) return tgSend_(chat, 'این دکمه‌ها برای سوپروایزرهای تجربه است.');

  if (act === 'go') {
    var rd = [];
    for (var k = 0; k < TG_SV_DAYS.length; k++) {
      rd.push([{ text: TG_SV_DAYS[k], callback_data: 'siv:d:' + k }]);
    }
    return tgSend_(chat, 'کدام روز برای مصاحبه وقت دارید؟', { inline_keyboard: rd });
  }

  if (act === 'd') {
    var di = Number(p[1]) || 0, rh = [], line = [];
    for (var h = 0; h < TG_AP_IV_HOURS.length; h++) {
      line.push({ text: TG_AP_IV_HOURS[h], callback_data: 'siv:h:' + di + ':' + TG_AP_IV_HOURS[h] });
      if (line.length === 3) { rh.push(line); line = []; }
    }
    if (line.length) rh.push(line);
    return tgSend_(chat, TG_SV_DAYS[di] + ' — چه ساعتی؟', { inline_keyboard: rh });
  }

  if (act === 'h') {
    var day = TG_SV_DAYS[Number(p[1]) || 0];
    var time = p.slice(2).join(':');
    var code = tgApIvAdd_(who.name, chat, day, time);
    return tgSend_(chat, '✅ ثبت شد: <b>' + tgEsc_(day) + ' ساعت ' + tgEsc_(time) + '</b>\n' +
      'کد این وقت ' + tgEsc_(code) + ' است. یکی دیگر هم اضافه می‌کنید؟',
      { inline_keyboard: [
        [{ text: '➕ وقت دیگر', callback_data: 'siv:go' }],
        [{ text: '📋 فهرست وقت‌هایم', callback_data: 'siv:list' }]
      ] });
  }

  if (act === 'list') {
    var mine = tgApIvSlots_(who.name);
    if (!mine.length) return tgSend_(chat, 'هنوز وقت مصاحبه‌ای اعلام نکرده‌اید.', tgApIvAskKb_());
    var rows = [];
    for (var i = 0; i < mine.length && i < 12; i++) {
      rows.push([{ text: '🗑 ' + mine[i].day + ' ساعت ' + mine[i].time,
                   callback_data: 'siv:x:' + mine[i].code }]);
    }
    rows.push([{ text: '➕ وقت تازه', callback_data: 'siv:go' }]);
    return tgSend_(chat, 'وقت‌های مصاحبهٔ باز شما. برای حذف روی هرکدام بزنید:', { inline_keyboard: rows });
  }

  if (act === 'x') {
    var code2 = p.slice(1).join(':');
    if (!TG_DRY) {
      try {
        var l = tgSvRows_();
        for (var z = 0; z < l.length; z++) {
          if (l[z].code !== code2) continue;
          tgSchSheet_(TG_SCH_T_SLOT, TG_SCH_SLOT_HEAD).getRange(l[z].row, 10).setValue('حذف شده');
          tgSchDropCache_();
          break;
        }
      } catch (e) {}
    }
    return tgSend_(chat, '🗑 آن وقت حذف شد.');
  }
  return null;
}

function tgApAskIv_(supName) {
  var s = tgApSupBy_(supName);
  if (!s) return 'پیدا نشد: ' + supName;
  if (!s.chat) return 'به بات وصل نیست: ' + supName;
  tgSend_(s.chat, T_AP_IV_ASK, tgApIvAskKb_());
  return 'درخواست وقت مصاحبه فرستاده شد به ' + supName;
}


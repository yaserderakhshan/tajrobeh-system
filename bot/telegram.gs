var TG_STAT_SS_CACHE_ = null;
function tgStatSS_() {
  if (!TG_STAT_SS_CACHE_) TG_STAT_SS_CACHE_ = SpreadsheetApp.openById(TG_STAT_SHEET_ID);
  return TG_STAT_SS_CACHE_;
}

/* ---------- دفتر کاربران بات ---------- */

function tgUserSheet_(make) {
  if (TG_DRY) return null;
  var ss = tgSS_(), sh = ss.getSheetByName(TG_USERS_TAB);
  if (!sh && make) {
    sh = ss.insertSheet(TG_USERS_TAB);
    sh.setRightToLeft(true);
    sh.getRange(1, 1, 1, TG_USERS_HEAD.length).setValues([TG_USERS_HEAD])
      .setFontWeight('bold').setBackground('#f3efec');
    sh.setFrozenRows(1);
    try { sh.hideSheet(); } catch (e) {}
  }
  return sh || null;
}

/* هر کاربر، روزی یک بار. نگهبان کش جلوی نوشتن دوباره را می‌گیرد. */
var TG_USER_NEW = false;
function tgUserTouch_(chat, name, uname, how) {
  var id = String(chat == null ? '' : chat).trim();
  if (!id || id.indexOf('-') === 0) return;
  if (TG_DRY) { TG_OUTBOX.push({ kind: 'user', chat: id, how: how || '' }); return; }
  try {
    var day = Utilities.formatDate(new Date(), TG_TZ, 'yyyy-MM-dd');
    var c = CacheService.getScriptCache();
    if (String(c.get('ut' + id) || '') === day) return;
    c.put('ut' + id, day, 21600);
    var sh = tgUserSheet_(true);
    if (!sh) return;
    var last = sh.getLastRow(), at = 0;
    if (last > 1) {
      var col = sh.getRange(2, 1, last - 1, 1).getValues();
      for (var i = 0; i < col.length; i++) {
        if (String(col[i][0]).trim() === id) { at = i + 2; break; }
      }
    }
    if (at) {
      var old = sh.getRange(at, 5, 1, 2).getValues()[0];
      var days = (String(old[0]).trim() === day) ? Number(old[1] || 1) : Number(old[1] || 0) + 1;
      sh.getRange(at, 5, 1, 3).setValues([[day, days, how || '']]);
      if (name)  sh.getRange(at, 2).setValue(name);
      if (uname) sh.getRange(at, 3).setValue(uname);
    } else {
      sh.appendRow([id, name || '', uname || '', day, day, 1, how || '']);
      TG_USER_NEW = true;   /* v166.27: کاربر تازه؛ tgAppNudge_ فقط همین بار */
    }
  } catch (e) { tgErr_('tgUserTouch_: ' + e); }
}

function tgUserStats_() {
  var out = { total: 0, fresh: 0, active: 0, ids: {} };
  if (TG_DRY) return TG_MEM['ustat'] || out;
  try {
    var sh = tgUserSheet_(false);
    if (!sh || sh.getLastRow() < 2) return out;
    var day = Utilities.formatDate(new Date(), TG_TZ, 'yyyy-MM-dd');
    var v = sh.getRange(2, 1, sh.getLastRow() - 1, 5).getValues();
    for (var i = 0; i < v.length; i++) {
      var id = String(v[i][0]).trim();
      if (!id) continue;
      out.total++;
      out.ids[id] = 1;
      if (tgStatSame_(v[i][3], day)) out.fresh++;
      if (tgStatSame_(v[i][4], day)) out.active++;
    }
  } catch (e) { tgErr_('tgUserStats_: ' + e); }
  return out;
}

/* ---------- کمک‌کارهای شمارش ---------- */

function tgStatSame_(cell, iso) {
  if (cell instanceof Date) return Utilities.formatDate(cell, TG_TZ, 'yyyy-MM-dd') === iso;
  return String(cell == null ? '' : cell).trim() === iso;
}

/* سلول تاریخ را با هر دو تقویم می‌سنجد؛ تب‌های مدرسه شمسی می‌نویسند و لیدها میلادی. */
function tgStatIsDay_(cell, iso, jal) {
  if (cell instanceof Date) return Utilities.formatDate(cell, TG_TZ, 'yyyy-MM-dd') === iso;
  var t = String(cell == null ? '' : cell).trim();
  if (!t) return false;
  return t === iso || t === jal;
}

function tgStatCount_(ss, tab, from, dateCol, test) {
  if (TG_DRY) return 0;
  try {
    if (!ss) return 0;
    var sh = ss.getSheetByName(tab);
    if (!sh || sh.getLastRow() < from) return 0;
    var wide = Math.max(dateCol, sh.getLastColumn());
    var v = sh.getRange(from, 1, sh.getLastRow() - from + 1, wide).getValues();
    var n = 0;
    for (var i = 0; i < v.length; i++) if (test(v[i])) n++;
    return n;
  } catch (e) { tgErr_('tgStatCount_ ' + tab + ': ' + e); return 0; }
}

function tgStatRoles_() {
  var r = { client: 0, ther: 0, stu: 0, tea: 0, sup: 0, desk: 0, staff: {} };
  if (TG_DRY) return TG_MEM['sroles'] || r;
  try {
    var list = tgPeopleList_() || [];
    var keys = [['درمانگر', 'ther'], ['دانشجو', 'stu'], ['استاد', 'tea'],
                ['سوپروایزر', 'sup'], ['پذیرش', 'desk']];
    for (var i = 0; i < list.length; i++) {
      var p = list[i];
      if (!p.chat) continue;
      if (String(p.status || '').trim() === 'غیرفعال') continue;
      var ro = String(p.roles || ''), hit = false;
      for (var k = 0; k < keys.length; k++) {
        if (ro.indexOf(keys[k][0]) > -1) { r[keys[k][1]]++; hit = true; }
      }
      if (hit) {
        var ids = String(p.chat).split(/[,،;\s]+/);
        for (var j = 0; j < ids.length; j++) if (ids[j]) r.staff[ids[j]] = 1;
      }
    }
  } catch (e) { tgErr_('tgStatRoles_: ' + e); }
  return r;
}

function tgStatAlum_() {
  if (TG_DRY) return Number(TG_MEM['alumn'] || 0);
  try {
    var sh = tgSchSS_().getSheetByName(TG_SCH_T_ALUM);
    if (!sh || sh.getLastRow() < 2) return 0;
    var v = sh.getRange(2, 12, sh.getLastRow() - 1, 1).getValues(), n = 0;
    for (var i = 0; i < v.length; i++) if (String(v[i][0]).trim() === TG_AL_ST_OK) n++;
    return n;
  } catch (e) { tgErr_('tgStatAlum_: ' + e); return 0; }
}

/* ---------- عددهای امروز ---------- */

function tgStatToday_() {
  var now = new Date();
  var iso = Utilities.formatDate(now, TG_TZ, 'yyyy-MM-dd');
  var jal = tgJDateFull_(now, TG_TZ);
  var p = iso.split('-');
  var s = {
    iso: iso, jal: jal, day: new Date(Number(p[0]), Number(p[1]) - 1, Number(p[2])),
    users: 0, fresh: 0, active: 0,
    client: 0, ther: 0, stu: 0, tea: 0, sup: 0, alum: 0, desk: 0,
    leadOpen: 0, leadNew: 0, schOpen: 0, schNew: 0,
    meet: 0, sess: 0, req: 0, apply: 0, svBook: 0, evReg: 0,
    leadFirst: 0, leadStale: 0, reqOpen: 0, applyOpen: 0
  };

  var u = tgUserStats_();
  s.users = u.total; s.fresh = u.fresh; s.active = u.active;

  var r = tgStatRoles_();
  s.ther = r.ther; s.stu = r.stu; s.tea = r.tea; s.sup = r.sup; s.desk = r.desk;
  s.alum = tgStatAlum_();
  var staffN = 0;
  for (var k in r.staff) if (u.ids[k]) staffN++;
  s.client = Math.max(0, s.users - staffN);

  try {
    var lb = tgLeadBuckets_(tgOpenLeads_());
    s.leadOpen = lb.all.length; s.leadFirst = lb.first.length; s.leadStale = lb.stale.length;
  } catch (e) { tgErr_('statLeads: ' + e); }

  try {
    var sb = tgSlBuckets_(tgSlOpen_());
    s.schOpen = sb.first.length + sb.stale.length + sb.live.length;
  } catch (e2) { tgErr_('statSch: ' + e2); }

  if (!TG_DRY) {
    var ss = tgSS_(), sc = tgSchSS_();

    s.leadNew = tgStatCount_(ss, TG_LEADS, 2, 1, function (row) {
      return tgStatIsDay_(row[0], iso, jal);
    });

    s.meet = tgStatCount_(ss, TG_SLOTS, 4, 2, function (row) {
      var st = String(row[5] || '').trim();
      return tgStatIsDay_(row[1], iso, jal) && st && st !== 'آزاد';
    });

    s.sess = tgStatCount_(ss, TG_SESS, 2, 2, function (row) {
      return tgStatIsDay_(row[1], iso, jal) && String(row[7] || '').indexOf('لغو') < 0;
    });

    s.schNew = tgStatCount_(sc, TG_SCH_T_REQ, 2, 2, function (row) {
      return tgStatIsDay_(row[1], iso, jal);
    });

    s.req = tgStatCount_(sc, TG_SCH_T_REQ, 2, 2, function (row) {
      return tgStatIsDay_(row[1], iso, jal) && String(row[4] || '').trim() !== '';
    });

    s.reqOpen = tgStatCount_(sc, TG_SCH_T_REQ, 2, 15, function (row) {
      var st = String(row[12] || '').trim();
      var done = String(row[14] || '').trim();
      return !done && TG_SCH_CLOSED.indexOf(st) < 0;
    });

    s.apply = tgStatCount_(sc, TG_SCH_T_APPLY, 2, 2, function (row) {
      return tgStatIsDay_(row[1], iso, jal);
    });

    s.applyOpen = tgStatCount_(sc, TG_SCH_T_APPLY, 2, 17, function (row) {
      return String(row[0] || '').trim() !== '' && String(row[16] || '').trim() === '';
    });

    s.svBook = tgStatCount_(sc, TG_SCH_T_GRP, 2, 10, function (row) {
      return tgStatIsDay_(row[9], iso, jal) && String(row[10] || '').indexOf('لغو') < 0;
    });

    s.evReg = tgStatCount_(sc, TG_EVR_TAB, 2, 1, function (row) {
      return tgStatIsDay_(row[0], iso, jal);
    });
  }

  return s;
}

function tgStatRow_(s) {
  return [s.jal, s.day, s.users, s.fresh, s.active,
          s.client, s.ther, s.stu, s.tea, s.sup, s.alum, s.desk,
          s.leadOpen, s.leadNew, s.schOpen, s.schNew,
          s.meet, s.sess, s.req, s.apply, s.svBook, s.evReg,
          s.leadFirst, s.leadStale, s.reqOpen, s.applyOpen];
}

/* ---------- نوشتن ردیف امروز ---------- */

function tgStatSheet_() {
  if (TG_DRY) return null;
  var ss = tgStatSS_(), sh = ss.getSheetByName(TG_STAT_TAB);
  if (!sh) {
    sh = ss.insertSheet(TG_STAT_TAB);
    sh.setRightToLeft(true);
    sh.getRange(1, 1, 1, TG_STAT_HEAD.length).setValues([TG_STAT_HEAD])
      .setFontWeight('bold').setBackground('#f3efec');
    sh.setFrozenRows(1);
    sh.getRange('B2:B').setNumberFormat('yyyy-mm-dd');
  }
  return sh;
}

/* سری زمانی است، نه بازنویسی؛ ولی یک روز دو ردیف نمی‌گیرد. */
function tgStatWrite_() {
  var s = tgStatToday_();
  if (TG_DRY) { TG_OUTBOX.push({ kind: 'stat', row: tgStatRow_(s) }); return s; }
  var sh = tgStatSheet_();
  var row = tgStatRow_(s);
  var at = 0, last = sh.getLastRow();
  if (last > 1) {
    var col = sh.getRange(2, 1, last - 1, 1).getValues();
    for (var i = 0; i < col.length; i++) if (String(col[i][0]).trim() === s.jal) { at = i + 2; break; }
  }
  if (at) sh.getRange(at, 1, 1, row.length).setValues([row]);
  else sh.appendRow(row);
  return s;
}

function tgStatText_(s) {
  if (!s) s = tgStatToday_();
  var L = [];
  L.push('📊 <b>آمار امروز</b> · ' + tgEsc_(s.jal));
  L.push('');
  L.push('👥 کاربران بات: ' + tgFa_(s.users) + ' · تازه: ' + tgFa_(s.fresh) + ' · فعال امروز: ' + tgFa_(s.active));
  L.push('مراجع ' + tgFa_(s.client) + ' · درمانگر ' + tgFa_(s.ther) + ' · دانشجو ' + tgFa_(s.stu));
  L.push('استاد ' + tgFa_(s.tea) + ' · سوپروایزر ' + tgFa_(s.sup) + ' · دانش‌آموخته ' + tgFa_(s.alum) + ' · پذیرش ' + tgFa_(s.desk));
  L.push('');
  L.push('📥 لید باز پذیرش: ' + tgFa_(s.leadOpen) + ' (تازهٔ امروز ' + tgFa_(s.leadNew) + ')');
  L.push('🎓 لید باز مدرسه: ' + tgFa_(s.schOpen) + ' (تازهٔ امروز ' + tgFa_(s.schNew) + ')');
  L.push('');
  L.push('🗓 معارفهٔ امروز: ' + tgFa_(s.meet) + ' · جلسهٔ امروز: ' + tgFa_(s.sess));
  L.push('📝 درخواست عضویت: ' + tgFa_(s.req) + ' · اپلای تراپیست: ' + tgFa_(s.apply));
  L.push('🧑‍🏫 رزرو سوپرویژن: ' + tgFa_(s.svBook) + ' · ثبت‌نام رویداد: ' + tgFa_(s.evReg));
  L.push('');
  L.push('<b>روی زمین مانده</b>');
  L.push('☎ لید بدون تماس اول: ' + tgFa_(s.leadFirst));
  L.push('↻ لید بیش از سه روز: ' + tgFa_(s.leadStale));
  L.push('📝 درخواست عضویت بدون تصمیم: ' + tgFa_(s.reqOpen));
  L.push('🧾 اپلای بدون نتیجه: ' + tgFa_(s.applyOpen));
  return L.join('\n');
}

/* دستی: هم می‌نویسد هم گزارش را برمی‌گرداند */
function tgStatDaily() {
  var s = tgStatWrite_();
  return tgStatText_(s);
}

/* روزی یک بار، داخل tgWatchdog. قفل روز مثل tgSchDailyTick_ */
function tgStatTick_() {
  if (TG_DRY || !TG_STAT_ON) return;
  try {
    var p = PropertiesService.getScriptProperties();
    var day = Utilities.formatDate(new Date(), TG_TZ, 'yyyy-MM-dd');
    if (String(p.getProperty('TG_STAT_DAY') || '') === day) return;
    var h = Number(Utilities.formatDate(new Date(), TG_TZ, 'H'));
    if (h < 22) return;
    p.setProperty('TG_STAT_DAY', day);
    tgStatWrite_();
  } catch (e) { tgErr_('tgStatTick_: ' + e); }
}

/* ---------- تب داشبورد، فقط فرمول ---------- */

function tgStatQ_(col) {
  var t = "'" + TG_STAT_TAB + "'!";
  return '=IFERROR(INDEX(' + t + col + ':' + col + ',$E$1),0)';
}

function tgStatLastRow_() {
  var t = "'" + TG_STAT_TAB + "'!";
  return '=IFERROR(MATCH(2,1/(' + t + 'A2:A' + TG_STAT_ROWS + '<>""))+1,' + (TG_STAT_ROWS + 1) + ')';
}

function tgStatSum_(col, days) {
  var t = "'" + TG_STAT_TAB + "'!";
  return '=IFERROR(SUMIFS(' + t + col + '2:' + col + TG_STAT_ROWS + ',' +
         t + '$B2:$B' + TG_STAT_ROWS + ',">="&TODAY()-' + (days - 1) + ',' +
         t + '$B2:$B' + TG_STAT_ROWS + ',"<="&TODAY()),0)';
}


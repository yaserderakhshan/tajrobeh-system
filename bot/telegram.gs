/* v166.29.1: رلهٔ کلادفلر به تلگرام همیشه فوری «ok» می‌دهد و بعد آپدیت را به Apps Script می‌فرستد؛ پس getWebhookInfo
   هرگز خطا یا صف نشان نمی‌دهد، حتی اگر رله به بات نرسد. هر ساعت یک پینگ از همان نشانی وبهوک فرستاده می‌شود و ساعت بعد
   سنجیده می‌شود که رسیده یا نه (doPost در Code.gs → TG_RELAY_PONG). نرسیدن = هشدار به یاسر، هر ۳ ساعت حداکثر یک بار. */
function tgRelayPing_(hookUrl) {
  if (TG_DRY || !hookUrl) return '';
  var P = PropertiesService.getScriptProperties();
  var ping = Number(P.getProperty('TG_RELAY_PING2') || 0), pong = Number(P.getProperty('TG_RELAY_PONG') || 0);
  var st = tgRelayState_(ping, pong, Date.now());
  if (st === 'lost') {
    var wc = CacheService.getScriptCache();
    if (!wc.get('relayalert')) {
      wc.put('relayalert', '1', 3 * 3600);
      tgSend_(TG_OWNER_CHAT, '⚠️ <b>رلهٔ کلادفلر به بات نمی‌رسد</b>\nپینگ سلامت ' + tgFa_(String(Math.round((Date.now() - ping) / 60000))) +
        ' دقیقه پیش از نشانی وبهوک فرستاده شد و به بات نرسید. تلگرام این را نمی‌بیند، چون رله همیشه «ok» جواب می‌دهد؛ پس پیام کاربران ممکن است گم شود. رلهٔ tajrobeh-relay را ببینید.');
    }
    tgErr_('tgRelayPing_', 'پینگ رله نرسید');
  }
  try {
    /* v166.29.2: وبهوک با secret_token ست شده (tgAllowAll)، پس رمز در سرآیند است نه در نشانی؛ بی آن رله ۴۰۳ می‌داد */
    var res = UrlFetchApp.fetch(hookUrl, { method: 'post', contentType: 'application/json', muteHttpExceptions: true,
      headers: { 'x-telegram-bot-api-secret-token': tgHookSecret_() },
      payload: JSON.stringify({ update_id: -1, tj_ping: Date.now() }) });
    var code = res.getResponseCode();
    P.setProperty('TG_RELAY_CODE', String(code));
    /* v166.29.3: کلید تازه؛ پینگ بی‌سرآیند نسخهٔ قبل (TG_RELAY_PING، که رله با ۴۰۳ رد کرده بود) هرگز «گم‌شده» شمرده نمی‌شود */
    if (code === 200) { P.setProperty('TG_RELAY_PING2', String(Date.now())); P.deleteProperty('TG_RELAY_PING'); }
    else { P.deleteProperty('TG_RELAY_PING2'); tgErr_('tgRelayPing_', 'رله پینگ را نپذیرفت: ' + code); }
  } catch (e) { tgErr_('tgRelayPing_', e); }
  return st;
}
/* ok: پینگ قبلی رسید یا هنوز زود است · lost: بیش از ۱۰ دقیقه گذشته و نرسیده · none: پینگی نبوده */
function tgRelayState_(ping, pong, now) {
  if (!ping) return 'none';
  if (pong >= ping) return 'ok';
  return now - ping > 10 * 60000 ? 'lost' : 'ok';
}


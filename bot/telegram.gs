  if (!w) return { ok: false, error: 'auth' };
  return tgApiCapture_(w, { fn: function (ww) { tgTskList_(ww.chat, ww.uname, tgV1Roles_(ww.chat, ww.uname)); } });
}

function tgApiBoxList_(p) {
  var w = tgApiWho_(p);
  if (!w) return { ok: false, error: 'auth' };
  return tgApiCapture_(w, { fn: function (ww) { tgBoxList_(ww.chat, tgV1IsTeam_(tgV1Roles_(ww.chat, ww.uname))); } });
}

function tgApiTaskNew_(p) {

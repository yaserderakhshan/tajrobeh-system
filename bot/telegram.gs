   ================================================================== */

function tgSchText_(chat, name, uname, text) {
  var t = String(text || '').trim();
  if (!t) return false;

  /* حالت‌های منتظر متن */
  if (typeof scText_ === 'function' && scText_(chat, t)) return true;   /* v166.25: منتورینگ، جلسهٔ بالینی */
  if (typeof tgSlText_ === 'function' && tgSlText_(chat, name, uname, t)) return true;
  if (tgSvTimeText_(chat, uname, t)) return true;
  if (tgPzText_(chat, uname, t)) return true;

  /* دکمه‌ها و دستورها */
  if (t === TG_SL_BTN || tgCmd_(t) === '/schooldesk') {
    if (!tgSchOwnerOf_(chat, uname)) return false;
    return tgSlDesk_(chat);
  }
  if (t === TG_ALQ_BTN) { if (!tgSchOwnerOf_(chat, uname)) return false; return tgAlQueue_(chat); }
  if (t === TG_APQ_BTN) { var wq = tgApWho_(chat, uname); if (!tgSchOwnerOf_(chat, uname) && !wq.lead && !wq.watch) return false; return tgApQueue_(chat); }
  if (t === '🎟 رویدادها' && tgSchOwnerOf_(chat, uname)) { tgEvList_(chat, 'مدرسه'); return true; }
  if (t === TG_SV_MY || tgCmd_(t) === '/supslots') { tgSvMy_(chat, uname); return true; }
  if (t === TG_SV_FREE) { tgSvFree_(chat); return true; }
  if (t === TG_AL_BTN || tgCmd_(t) === '/alumni') { tgAlStart_(chat, uname); return true; }
  if (t === TG_AP_ME || tgCmd_(t) === '/mystatus') { tgApStatus_(chat); return true; }
  if (t === TG_AP_MSG) { tgApMsgStart_(chat); return true; }
  if (t === TG_AP_BTN || tgCmd_(t) === '/apply') { tgApStart_(chat, uname); return true; }
  if (t === TG_PZ_BTN || tgCmd_(t) === '/prereg') { tgPzStart_(chat, uname); return true; }
  if (t === TG_PATH_BTN || t === '🧭 مسیر من' || tgCmd_(t) === '/mypath') { tgPathShow_(chat); return true; }
  if (t === TG_TEA_CAL) {
    var te = tgTeaWho_(chat, uname);
    if (!te) return false;
    tgTeaCal_(chat, te);
    return true;
  }
  if (t === TG_TEA_PAGE) {
    var te2 = tgTeaWho_(chat, uname);
    if (!te2) return false;
    tgTeaPage_(chat, te2);
    return true;
  }
  return false;
}


function tgPzText_(chat, uname, text) {
  var d = tgPzGet_(chat);
  if (!d) return false;
  var t = String(text || '').trim();
  if (!t) return false;
  if (t === TG_SJ_BACK || t === 'انصراف' || t.indexOf('/') === 0 || tgIsBtnLike_(t)) {   /* v166.24: دکمهٔ منو نام نیست */
    tgPzEnd_(chat);
    return false;
  }
  if (d.step === 'name') {
    if (t.length < 5) { tgSend_(chat, 'کمی کامل‌تر بنویسید، نام و نام خانوادگی.'); return true; }
    d.name = t;
    tgPzAskPhone_(chat, d);
    return true;
  }
  if (d.step === 'phone') {
    if (!tgLooksLikePhone_(t)) { tgSend_(chat, 'این شماره درست به نظر نمی‌رسد. یک بار دیگر بنویسید.'); return true; }
    d.phone = t;
    tgPzSave_(chat, d);
    return true;
  }
  return false;
}


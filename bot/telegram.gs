    TG_OUTBOX = []; TG_MEM = { roles: ['مراجع'] };
    vkOnCb_(null, 'exl', stranger, 'x', '');
    ok('هزینه‌های ساختمان برای غیرعضو باز نمی‌شود', TG_OUTBOX.length === 1 && String(TG_OUTBOX[0].text).indexOf('تأیید عضویت') > -1);
    TG_OUTBOX = [];

  d = String(d == null ? '' : d);
  if (d.indexOf('h:') !== 0 || !/^h:[0-9a-f]{18}$/.test(d)) return d;
  if (TG_DRY) return TG_CB_MEM[d] || '';
  try { var v = PropertiesService.getScriptProperties().getProperty('CBH_' + d.slice(2)); return v ? String(JSON.parse(v).d || '') : ''; } catch (e) { return ''; }
}
/* بیش از ۴۰۰ کد: قدیمی‌ترها (بیش از ۶۰ روز) پاک می‌شوند */
function tgCbPrune_(P) {
  var all = P.getProperties(), keys = Object.keys(all).filter(function (x) { return x.indexOf('CBH_') === 0; });
  if (keys.length <= 400) return;
  var old = Date.now() - 60 * 86400000;
  keys.forEach(function (x) { try { if (JSON.parse(all[x]).t < old) P.deleteProperty(x); } catch (e) {} });

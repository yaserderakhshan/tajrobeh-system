/* رزومهٔ ذخیره‌شده به شکل «tg:doc:<file_id> · نام» یا «tg:photo:<file_id>» */
function tgApResumeId_(resume) {
  var m = String(resume || '').match(/^tg:(doc|photo):([^\s·]+)/);
  return m ? { kind: m[1], id: m[2] } : null;
}

function tgApSendResume_(chat, r) {
  var f = tgApResumeId_(r.resume);
  if (!f) return tgSend_(chat, r.resume ? ('📄 رزومه به‌صورت لینک یا متن: ' + tgEsc_(r.resume)) : 'برای این پرونده رزومه‌ای ثبت نشده.');
  if (TG_DRY) { TG_OUTBOX.push({ kind: 'apcv', chat: String(chat), id: r.id, file: f.kind }); return true; }
  var body = { chat_id: chat, caption: '📄 رزومهٔ ' + (r.name || '') + ' · ' + r.id };
  if (f.kind === 'photo') { body.photo = f.id; return tgApi_('sendPhoto', body); }
  body.document = f.id;
  return tgApi_('sendDocument', body);
}

/* پروندهٔ کامل: همهٔ ستون‌های پرشدهٔ سطر، شامل بیست پرسش تکمیلی */
function tgApFullText_(r) {
  var s = '🗂 <b>پروندهٔ کامل ' + tgEsc_(r.id) + '</b> · ' + tgEsc_(r.name || '') + '\n';
  if (TG_DRY) return s + '(حالت آزمایشی)';
  try {
    var sh = r.sh || tgSchApSheet_();
    var lc = sh.getLastColumn();
    var hd = sh.getRange(1, 1, 1, lc).getDisplayValues()[0];
    var v = sh.getRange(r.row, 1, 1, lc).getDisplayValues()[0];
    for (var i = 0; i < lc; i++) {
      var h = String(hd[i] || '').trim(), x = String(v[i] || '').trim();
      if (!h || !x) continue;
      if (h === 'chat_id' || h === 'کد اپلای' || h === 'نام کامل') continue;
      if (h === 'رزومه' && tgApResumeId_(x)) x = 'فایل پیوست';
      s += '\n<b>' + tgEsc_(h) + ':</b> ' + tgEsc_(x.slice(0, 400));
    }
  } catch (e) { s += '\nخواندن پرونده خطا داد: ' + tgEsc_(String(e)); }
  return s;
}

/* پیام ناظر به متقاضی و پاسخ متقاضی به ناظر، هر دو از داخل بات */
function tgApMsgText_(chat, m) {
  var id = tgGetVal_('apmsg', chat);
  if (!id) return false;
  var t = String((m && m.text) || '').trim();
  if (!t) return false;
  tgDel_('apmsg', chat);
  if (t === 'انصراف' || t.indexOf('/') === 0 || tgIsBtnLike_(t)) { tgSend_(chat, 'باشد، پیامی فرستاده نشد.'); return true; }
  var r = tgApRow_(id);
  if (!r || !r.chat) { tgSend_(chat, 'متقاضی این پرونده در بات نیست.'); return true; }
  tgSend_(r.chat, '✉️ <b>پیام از مرکز تجربه دربارهٔ درخواست همکاری ' + tgEsc_(r.id) + '</b>\n\n' + tgEsc_(t) +
    '\n\nاگر پاسخی دارید، «' + TG_AP_MSG + '» را بزنید و بنویسید.',
    { keyboard: [[TG_AP_ME], [TG_AP_MSG]], resize_keyboard: true });
  try { tgApSet_(r, 21, (r.note ? r.note + '\n' : '') + tgJDateFull_(new Date(), TG_TZ) + ' · ناظر ← متقاضی: ' + t.slice(0, 300)); } catch (e) {}
  tgSend_(chat, '✅ برای ' + tgEsc_(r.name || '') + ' فرستاده شد.');
  return true;
}

function tgApReplyText_(chat, m) {

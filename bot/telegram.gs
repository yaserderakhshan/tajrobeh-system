}

/* ───── کمک‌ها ───── */
function tgInpIsMe_(w, name) { var a = tgInpNameKey_(w), b = tgInpNameKey_(name); return !!(a && b && (a.indexOf(b) > -1 || b.indexOf(a) > -1)); }
function tgInpRowKey_(h) { return [h.p, tgInpNameKey_(h.who), h.day, tgInpH_(h.from), tgInpH_(h.to), tgInpRoomKey_(h.room)].join('|'); }
function tgInpMineRows_(name, d) { return (d || tgInpData_()).hours.filter(function (h) { return tgInpIsMe_(h.who, name); })
  .sort(function (a, b) { return (TG_INP_DAYS.indexOf(a.day) - TG_INP_DAYS.indexOf(b.day)) || ((tgInpH_(a.from) || 0) - (tgInpH_(b.from) || 0)); }); }
function tgInpPlaceName_(pid, d) { var p = null; (d || tgInpData_()).places.forEach(function (x) { if (x.id === pid) p = x; }); return p ? (p.id === 'gandhi' ? 'گاندی' : p.city) + (p.area && p.id !== 'gandhi' ? ' · ' + p.area : '') : pid; }
function tgInpRowText_(h) { return tgInpPlaceName_(h.p) + '، ' + (h.day || 'با هماهنگی') + (h.room ? '، اتاق ' + tgFa_(tgInpRoomKey_(h.room)) : '') + (h.from ? '، ' + tgInpHs_(tgInpH_(h.from)) + ' تا ' + tgInpHs_(tgInpH_(h.to)) : '') + (h.rc && tgRecurLabel_(h.rc) ? '، ' + tgRecurLabel_(h.rc) : ''); }
function tgInpParseHours_(t) {
  var s = String(tgLatinDigits_(t || '')).replace(/[٫]/g, ':');
  var m = s.match(/(\d{1,2}(?::\d{2})?)\s*(?:تا|-|–|الی|to)\s*(\d{1,2}(?::\d{2})?)/);
  if (!m) return null;
  var a = tgInpH_(m[1]), b = tgInpH_(m[2]);
  return (a != null && b != null && b > a && a >= 6 && b <= 24) ? [a, b] : null;
}
function tgInpParseDay_(t) {

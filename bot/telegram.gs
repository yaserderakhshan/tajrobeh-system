function tgSchGuideRebuild() {
  var ss = tgSchSS_();
  var sh = ss.getSheetByName('راهنما');
  if (!sh) { sh = ss.insertSheet('راهنما', 0); }
  sh.setRightToLeft(true);
  sh.clear();
  try { sh.getRange(1, 1, sh.getMaxRows(), sh.getMaxColumns()).clearDataValidations(); } catch (e0) {}
  sh.getRange(1, 1, TG_SCH_GUIDE_ROWS.length, 3).setValues(TG_SCH_GUIDE_ROWS);
  sh.getRange(1, 1).setFontSize(14).setFontWeight('bold');
  var hdr = 0;
  for (var i = 0; i < TG_SCH_GUIDE_ROWS.length; i++) {
    var g = TG_SCH_GUIDE_ROWS[i];
    if (g[0] === 'تب' && g[1] === 'چیست') { hdr = i; sh.getRange(i + 1, 1, 1, 3).setFontWeight('bold').setBackground('#f9f2f2'); }
    if (g[0] === '👩‍💼 ' + tgNm_('school') + ' روزانه چه می‌کند') sh.getRange(i + 1, 1, 1, 3).setFontWeight('bold').setBackground('#fbe9eb');
    if (/^[۰-۹]$/.test(g[0])) sh.getRange(i + 1, 1, 1, 3).setBackground('#fff7f7');
    if (g[0] && !g[1] && hdr && i > hdr) sh.getRange(i + 1, 1).setFontWeight('bold');
  }
  sh.setColumnWidth(1, 260); sh.setColumnWidth(2, 640); sh.setColumnWidth(3, 260);
  sh.getRange(1, 1, TG_SCH_GUIDE_ROWS.length, 3).setWrap(true).setVerticalAlignment('top');
  sh.setFrozenRows(0);
  return 'راهنمای هاب مدرسه از نو نوشته شد.';
}



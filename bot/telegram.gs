/* «آخرین فرصت» دو روز مانده به مهلت، و «بسته» بعد از مهلت اگر رویداد بستن نداشت */
function tgCpAutoState_(camp, now, log) {
  var dl = tgCpAt_(camp.deadline, '', true);
  if (!dl) return;
  var mark = 'cpauto:' + camp.code + ':';
  var once = function (k) {
    if (TG_DRY) { if (TG_MEM[mark + k]) return false; TG_MEM[mark + k] = 1; return true; }
    var pr = PropertiesService.getScriptProperties();
    if (pr.getProperty(mark + k)) return false;
    pr.setProperty(mark + k, '1');
    return true;
  };
  if (camp.state === 'ثبت‌نام باز' && now.getTime() >= dl.getTime() - 48 * 3600000 && now <= dl && once('last')) {
    tgCpSetState_(null, camp, 'آخرین فرصت', 'خودکار'); log.push(camp.code + ':آخرین فرصت');
  }
  var hasClose = tgCpEvents_(camp.code).some(function (e) { return e.type === 'بستن ثبت‌نام' && e.status !== 'لغو'; });
  if (!hasClose && TG_CP_OPEN_STATES.indexOf(camp.state) > -1 && now.getTime() > dl.getTime() + 3600000 && once('close')) {
    tgCpSetState_(null, camp, 'بسته', 'خودکار'); log.push(camp.code + ':بسته');
  }
}

function tgCpIvRemind_(camp, now, log) {
  tgCpSlots_(camp.code).forEach(function (s) {
    if (tgCpS_(s['وضعیت']) !== 'رزرو شد' || tgCpS_(s['یادآوری']) || !s.at) return;
    var mins = (s.at.getTime() - now.getTime()) / 60000;
    if (mins > 150 || mins < 0) return;
    var iv = tgCpS_(s['مصاحبه‌گر']), link = tgCpS_(s['لینک جلسه']) || tgCpIvLink_(iv);
    var kb = link ? { inline_keyboard: [[{ text: '🎥 لینک جلسه', url: link }]] } : null;
    tgSend_(tgCpS_(s['chat_id متقاضی']), '⏰ یادآوری: مصاحبهٔ پذیرش ' + tgEsc_(camp.course) + ' ' + tgCpWhen_(s.at, true) + '.' +
            (link ? '' : '\nلینک جلسه را مسئول مدرسه همین‌جا می‌فرستد.'), kb);
    var ivc = tgCpIvChat_(iv);
    if (ivc) tgSend_(ivc, '⏰ مصاحبهٔ ' + tgEsc_(tgCpS_(s['نام متقاضی'])) + ' ' + tgCpWhen_(s.at, true) + '. بعدش نتیجه را ثبت کنید.', tgCpResKb_(tgCpS_(s['کد'])));
    if (!link) tgCpTell_('⚠️ مصاحبهٔ ' + tgEsc_(tgCpS_(s['نام متقاضی'])) + ' لینک جلسه ندارد.');
    tgCpSet_(TG_CPI_TAB, s._row, { 'یادآوری': 'فرستاده شد' });
    log.push(tgCpS_(s['کد']) + ':یادآوری');
  });
}

/* گزارش صبح برای مسئولان، روزی یک بار بین ۹ و ۱۰ */
/* v166.24: یادآوری مهلت ثبت‌نام، سه روز و یک روز مانده به «آخرین روز ثبت‌نام» (برای مهلت ۱۵ مهر: ۱۲ و ۱۴ مهر)،
   ساعت ۱۰ تا ۲۰ تهران، فقط به لید گرم و باز همین کمپین که در بات است (حاضر در وبینار، درخواست دوره، پیش‌پرداخت)،
   بی کسانی که «دیگر پیام نده» زده‌اند. هر نفر یک بار در هر روز یادآوری؛ اگر زیاد بود در تیک‌های بعد ادامه پیدا می‌کند. */
var TG_CP_DL_DAYS = [3, 1];
function tgCpDaysLeft_(camp, now) {
  var dl = tgCpAt_(camp.deadline, '', true);
  if (!dl) return null;
  var a = Utilities.formatDate(now, TG_TZ, 'yyyy-MM-dd'), b = Utilities.formatDate(dl, TG_TZ, 'yyyy-MM-dd');
  return { n: Math.round((Date.parse(b + 'T00:00:00Z') - Date.parse(a + 'T00:00:00Z')) / 86400000), at: dl };
}
function tgCpWarmOpen_(camp) {
  var warm = [TG_SCH_SG.came, TG_SCH_SG.apply, TG_SCH_SG.pre];
  return tgCpRead_(TG_SCH_T_REQ).filter(function (l) {
    if (tgCpS_(l['کد کمپین']) !== camp.code) return false;
    if (tgSchClosed_(tgSchStNorm_(l['وضعیت']).st)) return false;
    return warm.indexOf(tgSchStageIdx_(tgSchStageNorm_(l['مرحلهٔ قیف']).st)) > -1;
  });
}
function tgCpDlKb_(camp) {
  return { inline_keyboard: [
    [{ text: '🗓 رزرو مصاحبه', callback_data: 'cp:b:' + camp.code }, { text: '💳 پرداخت پیش‌پرداخت', callback_data: 'cp:p:' + camp.code }],
    [{ text: '🔕 دیگر پیام نده', callback_data: 'cp:off:' + camp.code }]] };
}
function tgCpDlText_(camp, left) {
  return '⏳ <b>' + (left.n === 1 ? 'فردا آخرین روز' : tgFa_(String(left.n)) + ' روز تا پایان') + ' ثبت‌نام ' + tgEsc_(camp.course) + '</b>\n\n' +
    'آخرین روز: ' + tgEsc_(tgJDate_(left.at, TG_TZ)) + '\n' +
    'اگر می‌خواهید در این دوره باشید، مصاحبه را رزرو کنید یا پیش‌پرداخت را بپردازید.';
}
function tgCpDeadlineRemind_(camp, now, log) {
  if (TG_CP_OPEN_STATES.indexOf(camp.state) < 0) return;
  var left = tgCpDaysLeft_(camp, now);
  if (!left || TG_CP_DL_DAYS.indexOf(left.n) < 0) return;
  var h = Number(Utilities.formatDate(now, TG_TZ, 'H'));
  if (h < 10 || h >= 20) return;
  var key = 'cpdl:' + camp.code + ':' + Utilities.formatDate(now, TG_TZ, 'yyyy-MM-dd');
  var P = TG_DRY ? null : PropertiesService.getScriptProperties();
  var done = []; try { done = JSON.parse((TG_DRY ? TG_MEM[key] : P.getProperty(key)) || '[]'); } catch (e) {}
  if (!Array.isArray(done)) done = [];
  if (done[0] === 'fin') return;
  var off = tgCpOff_(camp.code), sent = 0, txt = tgCpDlText_(camp, left), kb = tgCpDlKb_(camp), left2 = 0;
  tgCpWarmOpen_(camp).forEach(function (l) {
    var c = tgCpS_(l['chat_id']);
    if (!c || !/^-?\d+$/.test(c) || off.indexOf(c) > -1 || done.indexOf(c) > -1) return;
    if (sent >= TG_CP_SEND_MAX) { left2++; return; }
    tgSend_(c, txt, kb); done.push(c); sent++;
  });
  var save = left2 ? done : ['fin'];
  if (TG_DRY) TG_MEM[key] = JSON.stringify(save); else P.setProperty(key, JSON.stringify(save));
  if (sent) { log.push('یادآوری مهلت ' + camp.code + ': ' + sent); tgCpTell_('⏳ یادآوری مهلت ' + camp.code + ' به ' + tgFa_(String(sent)) + ' لید گرم رفت.'); }
}


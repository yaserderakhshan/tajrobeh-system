function tgCalCheck() {
  var L = [], cal = null;
  try { cal = CalendarApp.getCalendarById(TG_CAL_ACCOUNT); } catch (e) { L.push('❌ باز نشد · ' + e); }
  if (!cal) {
    L.push('❌ تقویم ' + TG_CAL_ACCOUNT + ' برای این حساب در دسترس نیست.');
    L.push('راه‌حل: از همان حساب، تقویم را با دسترسی «ایجاد و ویرایش رویدادها» به این حساب به اشتراک بگذارید.');
    Logger.log(L.join('\n')); return L.join('\n');
  }
  L.push('✅ تقویم پیدا شد · ' + cal.getName() + ' · ' + cal.getId());
  try {
    var s = new Date(Date.now() + 86400000), e2 = new Date(s.getTime() + 600000);
    var ev = cal.createEvent('تست دسترسی تجربه (همین حالا پاک می‌شود)', s, e2, { description: 'tgCalCheck' });
    L.push('✅ رویداد ساخته شد · ' + ev.getId());
    ev.deleteEvent();
    L.push('✅ پاک هم شد. تقویم آمادهٔ کار است.');
  } catch (e3) { L.push('❌ اجازهٔ نوشتن روی این تقویم نیست · ' + e3); }
  Logger.log(L.join('\n'));
  return L.join('\n');
}

function tgCalText_(calId, days) {
  try {
    var cal = CalendarApp.getCalendarById(calId);
    if (!cal) return '';
    var from = new Date(), to = new Date(from.getTime() + (days || 14) * 86400000);
    var ev = cal.getEvents(from, to);
    if (!ev.length) return '';
    var out = [];
    for (var i = 0; i < Math.min(ev.length, 20); i++) {
      var d = ev[i].getStartTime();
      out.push('• ' + tgJDateFull_(d, TG_TZ) + ' ساعت ' +
               Utilities.formatDate(d, TG_TZ, 'HH:mm') + '\n  ' + ev[i].getTitle());
    }
    return out.join('\n');
  } catch (e) { tgErr_('tgCalText_: ' + e); return ''; }
}

function tgMyCal_(chat, role) {
  var p = tgWhoPerson_(chat, '');
  if (!p) return tgEduSignup_(chat);
  var key = tgCircleKey_(p.circle);
  if (!key || !TG_CIRCLE_CAL[key]) {
    if (role === 'دانشجو') return tgAskCircle_(chat);
    return tgPublicCal_(chat, role);
  }
  var t = tgCalText_(TG_CIRCLE_CAL[key], 14);
  return tgSend_(chat, t ? (T_CAL_HEAD + '\n\n' + t) : T_CAL_EMPTY, tgSchoolMenu_(role));
}

function tgPublicCal_(chat, role) {
  var parts = [];
  for (var i = 0; i < TG_CAL_PUBLIC.length; i++) {
    var t = tgCalText_(TG_CAL_PUBLIC[i], 21);
    if (t) parts.push(t);
  }
  return tgSend_(chat, parts.length ? (T_PUB_HEAD + '\n\n' + parts.join('\n')) : T_CAL_EMPTY,
                 tgSchoolMenu_(role || 'دانشجو'));
}

function tgEvRows_() {
  if (TG_DRY) return TG_MEM['events'] || [];
  var sh = tgSchSS_().getSheetByName(TG_EV_TAB);   // رویدادها از شهریور ۱۴۰۵ در هاب مدرسه است
  if (!sh || sh.getLastRow() < 2) return [];
  var v = sh.getRange(2, 1, sh.getLastRow() - 1, 9).getValues(), out = [];
  var today = new Date(); today.setHours(0, 0, 0, 0);
  for (var i = 0; i < v.length; i++) {
    if (!String(v[i][1] || '').trim()) continue;
    if (String(v[i][7] || '').trim() !== 'باز') continue;
    if (v[i][2] instanceof Date && v[i][2] < today) continue;
    if (String(v[i][4] || '').trim() === 'شب تجربه') continue;   /* v170.17: شب‌های کمپین C-004 رویداد مدرسه نیستند */
    out.push({
      id: String(v[i][0] || v[i][1]).trim(), title: String(v[i][1]).trim(), date: v[i][2],
      time: String(v[i][3] || ''), kind: String(v[i][4] || ''), cap: Number(v[i][5] || 0),
      link: String(v[i][6] || ''), desc: String(v[i][8] || '')
    });
  }
  return out;
}

function tgEvSheet_() {
  var ss = tgSchSS_(), sh = ss.getSheetByName(TG_EVR_TAB);
  if (!sh) {
    sh = ss.insertSheet(TG_EVR_TAB);
    sh.setRightToLeft(true);
    sh.appendRow(['تاریخ ثبت', 'کد رویداد', 'عنوان رویداد', 'نام', 'شماره',
                  'نقش', 'کد منبع', 'کانال', 'chat_id', 'وضعیت']);
  }
  return sh;
}

function tgEvCount_(id) {
  if (TG_DRY) return 0;
  var sh = tgEvSheet_();
  if (sh.getLastRow() < 2) return 0;
  var col = sh.getRange(2, 2, sh.getLastRow() - 1, 1).getValues(), n = 0;
  for (var i = 0; i < col.length; i++) if (String(col[i][0]).trim() === String(id)) n++;
  return n;
}

function tgEvHas_(id, phone, chat) {
  if (TG_DRY) return false;
  var sh = tgEvSheet_();
  if (sh.getLastRow() < 2) return false;
  var v = sh.getRange(2, 1, sh.getLastRow() - 1, 9).getValues();
  var ph = tgLatinDigits_(String(phone || '')).replace(/\D/g, '').slice(-10);
  for (var i = 0; i < v.length; i++) {
    if (String(v[i][1]).trim() !== String(id)) continue;
    if (ph && tgLatinDigits_(String(v[i][4])).replace(/\D/g, '').slice(-10) === ph) return true;
    if (chat && String(v[i][8]).trim() === String(chat)) return true;
  }
  return false;
}

function tgEvRegister_(ev, name, phone, role, code, chat, channel) {
  if (ev.cap && tgEvCount_(ev.id) >= ev.cap) return { ok: false, why: T_EV_FULL };
  if (tgEvHas_(ev.id, phone, chat)) return { ok: false, why: T_EV_DUP };
  if (!TG_DRY) {
    tgEvSheet_().appendRow([tgJDateFull_(new Date(), TG_TZ), ev.id, ev.title, name || '',
      String(phone || ''), role || '', code || '', channel || 'بات', String(chat || ''), 'ثبت شد']);
  }
  return { ok: true, link: ev.link };
}

function tgEvList_(chat, role) {
  var ev = tgEvRows_();
  if (!ev.length) return tgSend_(chat, T_EV_NONE, tgSchoolMenu_(role || 'دانشجو'));
  var body = [], kb = [];
  for (var i = 0; i < ev.length; i++) {
    var when = (ev[i].date instanceof Date) ? tgJDateFull_(ev[i].date, TG_TZ) : String(ev[i].date || '');
    body.push('• ' + ev[i].title + '\n  ' + when + (ev[i].time ? ' ساعت ' + ev[i].time : '') +
              (ev[i].desc ? '\n  ' + ev[i].desc : ''));
    kb.push([ev[i].title]);
  }
  tgSetFlag_('eev', chat, 900);
  return tgSend_(chat, T_EV_HEAD + '\n\n' + body.join('\n\n'),
                 { keyboard: kb.concat([['↩️ بازگشت']]), resize_keyboard: true });
}

function tgEvPick_(chat, text) {
  var ev = tgEvRows_(), hit = null;
  for (var i = 0; i < ev.length; i++) if (ev[i].title === String(text).trim()) hit = ev[i];
  if (!hit) return false;
  tgDel_('eev', chat);
  var p = tgWhoPerson_(chat, '');
  var r = tgEvRegister_(hit, p ? p.name : '', '', p ? p.roles.join('، ') : '',
                        tgGetVal_('esrc', chat), chat, 'بات');
  tgSend_(chat, r.ok ? (T_EV_OK + (r.link ? '\n' + r.link : '')) : r.why,
          tgSchoolMenu_(p && p.roles.length ? p.roles[0] : 'دانشجو'));
  return true;
}

function tgEvFromForm_(p) {
  var want = String((p && p.event) || '').trim();
  var ev = tgEvRows_(), hit = null;
  for (var i = 0; i < ev.length; i++) if (ev[i].title === want || ev[i].id === want) hit = ev[i];
  if (!hit) return { ok: false, why: 'رویداد پیدا نشد: ' + want };
  return tgEvRegister_(hit, p.name, p.phone, p.role, p.code, '', 'فرم سایت');
}


function tgSupAsk_(chat) {
  tgSetFlag_('esup', chat, 900);
  var kb = [];
  for (var i = 0; i < TG_APPROACH.length; i++) kb.push([TG_APPROACH[i]]);
  kb.push(['↩️ بازگشت']);
  return tgSend_(chat, T_SUP_ASK, { keyboard: kb, resize_keyboard: true });
}

function tgSupFind_(approach) {
  var list = tgPeopleList_(), out = [], a = String(approach).trim();
  for (var i = 0; i < list.length; i++) {
    if (list[i].roles.indexOf('سوپروایزر') < 0) continue;
    var ex = tgPersonExtra_(list[i].row);
    if (ex.supOk !== 'بله' || !ex.approach) continue;
    if (ex.approach.indexOf(a) > -1 || a.indexOf(ex.approach) > -1) {
      out.push({ name: list[i].name, approach: ex.approach });
    }
  }
  return out;
}

function tgSupSheet_() {
  var ss = tgSchSS_(), sh = ss.getSheetByName(TG_SUP_TAB);
  if (!sh) {
    sh = ss.insertSheet(TG_SUP_TAB);
    sh.setRightToLeft(true);
    sh.appendRow(['تاریخ', 'نام درخواست‌دهنده', 'نقش', 'رویکرد', 'سوپروایزرهای پیشنهادی', 'chat_id', 'وضعیت']);
  }
  return sh;
}

function tgSupPick_(chat, text) {
  var a = String(text).trim();
  if (TG_APPROACH.indexOf(a) < 0) return false;
  tgDel_('esup', chat);
  var p = tgWhoPerson_(chat, '');
  var who = p ? p.name : String(chat);
  var role = p ? p.roles.join('، ') : '';
  var found = tgSupFind_(a);
  var names = [];
  for (var i = 0; i < Math.min(found.length, 3); i++) names.push(found[i].name);
  if (!TG_DRY) {
    tgSupSheet_().appendRow([tgJDateFull_(new Date(), TG_TZ), who, role, a,
      names.join('، '), String(chat), found.length ? 'در انتظار هماهنگی' : 'سوپروایزر آزاد نداریم']);
  }
  tgSchoolNotify_('🧑‍🏫 درخواست سوپرویژن\n' + who + ' · رویکرد ' + a +
    (names.length ? '\nپیشنهاد: ' + names.join('، ') : '\nسوپروایزر آزاد نداریم'));
  if (!found.length) return tgSend_(chat, T_SUP_NONE, tgSchoolMenu_(p && p.roles[0]));
  var body = [];
  for (var k = 0; k < Math.min(found.length, 3); k++) body.push('• ' + found[k].name + '\n  ' + found[k].approach);
  return tgSend_(chat, T_SUP_HEAD + '\n\n' + body.join('\n') + '\n\n' + T_SUP_SENT,
                 tgSchoolMenu_(p && p.roles[0]));
}

function tgSupToggle_(chat) {
  var p = tgWhoPerson_(chat, '');
  if (!p) return tgEduSignup_(chat);
  var ex = tgPersonExtra_(p.row);
  var now = ex.supOk === 'بله' ? 'خیر' : 'بله';
  if (!TG_DRY) tgPersonSet_(p.row, { 'سوپرویژن می‌پذیرد؟': now }, 'خود فرد', { why: 'دکمهٔ سوپرویژن' });
  return tgSend_(chat, now === 'بله' ? T_SUP_ON : T_SUP_OFF, tgSchoolMenu_('سوپروایزر'));
}


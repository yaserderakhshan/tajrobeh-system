function tgEvFlush_() {
  if (TG_DRY) return 0;
  var c = CacheService.getScriptCache(), pr = PropertiesService.getScriptProperties();
  var nowMin = Math.floor(Date.now() / 60000);
  var last = Number(pr.getProperty('TG_EV_LAST') || 0);
  if (!last || nowMin - last > 170) last = nowMin - 170;
  var keys = [];
  for (var m = last + 1; m < nowMin; m++) keys.push('evb' + Utilities.formatDate(new Date(m * 60000), 'UTC', 'yyyyMMddHHmm'));
  if (!keys.length) return 0;
  var got = {};
  for (var i = 0; i < keys.length; i += 100) {
    var part = c.getAll(keys.slice(i, i + 100));
    for (var k in part) got[k] = part[k];
  }
  var rows = [];
  keys.forEach(function (k) {
    if (!got[k]) return;
    var arr = [];
    try { arr = JSON.parse(got[k]); } catch (e) { return; }
    arr.forEach(function (e) {
      var d = new Date(e[0]);
      rows.push([d, Utilities.formatDate(d, TG_TZ, 'yyyy-MM-dd'), e[1], e[2], e[3], e[4]]);
    });
  });
  if (rows.length) {
    var sh = tgAeSheet_();
    sh.getRange(sh.getLastRow() + 1, 1, rows.length, TG_EV_HEAD.length).setValues(rows);
  }
  for (var j = 0; j < keys.length; j += 100) c.removeAll(keys.slice(j, j + 100));
  pr.setProperty('TG_EV_LAST', String(nowMin - 1));
  return rows.length;
}

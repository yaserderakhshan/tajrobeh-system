  var names = (typeof TG_JMONTHS !== 'undefined') ? TG_JMONTHS : [];
  return (names[m - 1] || ym) + ' ' + tnkFa_(p[0]);
}

function tnkBook_() {
  if (tnkDry_()) return null;
  var pr = PropertiesService.getScriptProperties();
  var id = pr.getProperty(TNK_PROP);
  if (id) { try { return SpreadsheetApp.openById(id); } catch (e) {} }
  var ss = SpreadsheetApp.create(TNK_FILE);
  pr.setProperty(TNK_PROP, ss.getId());
  try {
    var f = DriveApp.getFileById(ss.getId());
    DriveApp.getFolderById(TNK_HOME).addFile(f);
    DriveApp.getRootFolder().removeFile(f);
  } catch (e2) {}
  return ss;
}

function tnkFolder_() {
  if (tnkDry_()) return null;
  var pr = PropertiesService.getScriptProperties();
  var id = pr.getProperty(TNK_FOLD);
  if (id) { try { return DriveApp.getFolderById(id); } catch (e) {} }
  var home = DriveApp.getFolderById(TNK_HOME);
  var it = home.getFoldersByName('فیش‌های تنخواه');
  var fo = it.hasNext() ? it.next() : home.createFolder('فیش‌های تنخواه');
  pr.setProperty(TNK_FOLD, fo.getId());
  return fo;
}

function tnkTab_(name, head) {
  if (tnkDry_()) {
    var k = 'tnk:' + name;
    TG_MEM[k] = TG_MEM[k] || [];
    var T = TG_MEM[k];
    return { rows: function () { return T.map(function (r) { return r.slice(); }); },
      append: function (r) { T.push(r.slice()); return T.length + 1; },
      set: function (row, col, val) { if (T[row - 2]) T[row - 2][col - 1] = val; } };
  }
  var ss = tnkBook_(), sh = ss.getSheetByName(name);
  if (!sh) {
    sh = ss.insertSheet(name);
    try { sh.setRightToLeft(true); } catch (e) {}
    sh.getRange(1, 1, 1, head.length).setValues([head]).setFontWeight('bold').setBackground('#f3efec');
    sh.setFrozenRows(1);
    try { var d = ss.getSheetByName('Sheet1'); if (d && d.getLastRow() === 0) ss.deleteSheet(d); } catch (e2) {}
  }
  return { rows: function () { var n = sh.getLastRow() - 1; return n > 0 ? sh.getRange(2, 1, n, head.length).getDisplayValues() : []; },
    append: function (r) { sh.appendRow(r); return sh.getLastRow(); },
    set: function (row, col, val) { sh.getRange(row, col).setValue(val); } };
}

function tnkObj_(head, row, i) {
  var o = { _row: i + 2 };
  for (var c = 0; c < head.length; c++) o[head[c]] = String(row[c] === undefined || row[c] === null ? '' : row[c]).trim();
  return o;
}

function tnkRows_(name, head) {
  return tnkTab_(name, head).rows().map(function (r, i) { return tnkObj_(head, r, i); });
}

function tnkNextCode_(name, head, pre) {
  var rows = tnkTab_(name, head).rows(), max = 0, re = new RegExp('^' + pre + '-(\\d+)$');
  for (var i = 0; i < rows.length; i++) {
    var m = String(rows[i][0]).match(re);
    if (m && Number(m[1]) > max) max = Number(m[1]);
  }
  var s = String(max + 1);
  while (s.length < 3) s = '0' + s;
  return pre + '-' + s;
}


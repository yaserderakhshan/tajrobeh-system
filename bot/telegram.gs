    else if (api === 'psy.report') out = tgApiGuard_(p, 'روان‌پزشکی') || tgApiT_(p, 'روان‌پزشکی', '📊 گزارش بخش من');
    else if (api === 'psy.ann') out = tgApiGuard_(p, 'روان‌پزشکی') || tgApiT_(p, 'روان‌پزشکی', '📣 اطلاعیه‌ها');
    else if (api === 'psy.act') out = tgApiGuard_(p, 'روان‌پزشکی') || tgApiC_(p, 'روان‌پزشکی', ['ann:', 'ld:', 'rf:']);
    else if (api === 'psy.say') out = tgApiGuard_(p, 'روان‌پزشکی') || tgApiT_(p, 'روان‌پزشکی', p.text);
    else if (api === 'org.report') out = tgApiGuard_(p, 'سازمانی') || tgApiT_(p, 'سازمانی', '📊 گزارش بخش من');
    else if (api === 'org.ann') out = tgApiGuard_(p, 'سازمانی') || tgApiT_(p, 'سازمانی', '📣 اطلاعیه‌ها');
    else if (api === 'org.act') out = tgApiGuard_(p, 'سازمانی') || tgApiC_(p, 'سازمانی', ['ann:', 'ld:']);
    else if (api === 'org.say') out = tgApiGuard_(p, 'سازمانی') || tgApiT_(p, 'سازمانی', p.text);
  } catch (e) {
    out = { ok: false, error: String(e) };
  }
  return ContentService.createTextOutput(JSON.stringify(out)).setMimeType(ContentService.MimeType.JSON);
}

// اعتبارسنجی initData تلگرام. بدون این، هر کسی می‌توانست به نام دیگری رزرو کند.
function tgVerifyInitData_(initData, tokenForTest) {
  try {
    const token = tokenForTest || PropertiesService.getScriptProperties().getProperty('TELEGRAM_TOKEN');   /* v170.9: دومی فقط برای تست امنیت */
    if (!token || !initData) return null;
    const parts = String(initData).split('&');
    const pairs = [];
    let hash = '';
    for (var i = 0; i < parts.length; i++) {
      const eq = parts[i].indexOf('=');
      if (eq < 0) continue;
      const k = parts[i].slice(0, eq);
      const v = parts[i].slice(eq + 1);
      if (k === 'hash') { hash = v; continue; }
      pairs.push(k + '=' + decodeURIComponent(v));
    }
    pairs.sort();
    // هر دو آرگومان باید بایت باشند؛ ترکیب رشته و بایت در Apps Script overload ندارد و همیشه خطا می‌داد (رزرو مینی‌اپ با «auth» می‌شکست)
    const secret = Utilities.computeHmacSha256Signature(Utilities.newBlob(token).getBytes(), Utilities.newBlob('WebAppData').getBytes());
    const sig = Utilities.computeHmacSha256Signature(Utilities.newBlob(pairs.join('\n')).getBytes(), secret);
    let hex = '';
    for (var j = 0; j < sig.length; j++) {
      const b = (sig[j] < 0 ? sig[j] + 256 : sig[j]).toString(16);
      hex += (b.length === 1 ? '0' : '') + b;
    }
    if (!tgSafeEq_(hex, hash)) return null;   /* v170.9: مقایسهٔ زمان‌ثابت */
    /* initData کهنه‌تر از ۲۴ ساعت پذیرفته نمی‌شود (جلوگیری از بازپخش). v170.9: بی auth_date هم پذیرفته نمی‌شود */
    var ad = 0;
    for (var a = 0; a < pairs.length; a++) if (pairs[a].indexOf('auth_date=') === 0) ad = Number(pairs[a].slice(10)) || 0;
    if (!ad || (Date.now() / 1000 - ad) > 86400 || ad - Date.now() / 1000 > 300) return null;
    for (var m = 0; m < pairs.length; m++) {
      if (pairs[m].indexOf('user=') === 0) { var us = JSON.parse(pairs[m].slice(5)); return us && us.id ? us : null; }
    }
    return null;   /* v170.9: بی کاربر، هویتی نیست */
  } catch (e) { tgErr_('initData: ' + e); return null; }
}

function tgWantOf_(k) {
  for (var i = 0; i < TG_GENDERS.length; i++) if (TG_GENDERS[i].k === k) return TG_GENDERS[i].want;
  return '';
}

function tgApiSlots_(p) {
  const scope = (String(p.scope || 'ir') === 'ir') ? 'داخل ایران' : 'خارج از ایران';
  const zone  = tgZoneOf_(String(p.zone || (scope === 'داخل ایران' ? 'ir' : 'de')));
  const want  = tgWantOf_(String(p.gender || 'x'));
  const info  = tgTherapistInfo_();
  const now   = new Date();

  const live = tgFreeSlots_(scope).filter(function (s) {
    const utc = tgSlotUtc_(s);
    if (utc.getTime() - now.getTime() < TG_MIN_LEAD_MS) return false;
    if (!tgSaneHour_(utc, zone)) return false;
    const th = info[s.therapist];
    return !(th && th.status && th.status.indexOf('پایان') > -1);
  });

  let matched = live.filter(function (s) {
    const th = info[s.therapist];
    if (!want || !th || !th.gender) return true;
    if (want === 'زن') return th.gender.indexOf('زن') > -1 || th.gender.indexOf('خانم') > -1;
    return th.gender.indexOf('مرد') > -1 || th.gender.indexOf('آقا') > -1;
  });
  let softened = false;
  if (!matched.length) { matched = live; softened = !!want; }

  matched.sort(function (a, b) {
    const ta = (info[a.therapist] || {}).tier || 2.5;
    const tb = (info[b.therapist] || {}).tier || 2.5;
    if (ta !== tb) return ta - tb;
    return (a.dateIso + a.hhmm) < (b.dateIso + b.hhmm) ? -1 : 1;
  });

  const seen = {}, out = [];
  for (var i = 0; i < matched.length && out.length < 12; i++) {
    const s = matched[i];
    seen[s.therapist] = (seen[s.therapist] || 0) + 1;
    if (seen[s.therapist] > 2) continue;
    const utc = tgSlotUtc_(s);
    const th = info[s.therapist] || {};
    out.push({
      therapist: s.therapist,
      about: tgAbout_(th),
      gender: th.gender || '',
      mode: th.mode || '',
      dateIso: s.dateIso,
      hhmm: s.hhmm,
      day: tgDay_(Utilities.formatDate(utc, zone.tz, 'EEE')),
      date: tgDateFor_(utc, zone),
      time: Utilities.formatDate(utc, zone.tz, 'HH:mm'),
      tehran: Utilities.formatDate(utc, TG_TZ, 'HH:mm')
    });
  }
  return { ok: true, softened: softened, zone: zone.key, count: out.length, slots: out };
}

// مینی‌اپ و بات یک حافظه دارند: هرچه اینجا ثبت شود، بات دیگر دوباره نمی‌پرسد

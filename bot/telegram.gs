function tgDutyTick(e) {
  if (ciPaused_(e, 'tgDutyTick', 'skip')) return;
  var rs0 = Date.now(); try {   /* v166.18: سنجش زمان اجرا (بدنه بی‌تغییر) */
  if (TG_DRY) return 'dry';
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(3000)) return 'busy';
  TG_LOCK_HELD = true;
  try { try { tgLeadRetry_(); } catch (eR) { tgErr_('tgLeadRetry_', eR); } return tgDutyRun_(new Date()); } finally { TG_LOCK_HELD = false; lock.releaseLock(); }
  } finally { tgRunStat_('tgDutyTick', rs0); }
}
/* v166.10: لیدها با «کد لید» دنبال می‌شوند، نه شمارهٔ سطر. پیش از این «آخرین سطر دیده‌شده» نگه داشته می‌شد و هر حذف
   سطر در تب لیدها (دستی یا tgCleanBlankLeads) باعث می‌شد لیدهای تازهٔ بعدی زیر آن عدد بیفتند و به کشیک خبر داده نشود،
   و فهرست منتظرها به سطرهای جابه‌جاشده (یعنی آدم‌های دیگر) اشاره کند.
   حالا: آخرین TG_DUTY_SCAN سطر خوانده می‌شود؛ هر لید کمتر از TG_DUTY_NEW_MIN دقیقه‌ای که هنوز در TG_DUTY_SEEN نیست تازه است،
   کد می‌گیرد و با همان کد پیگیری می‌شود. */
/* v166.10: صدازننده‌ای که قفل اسکریپت را دارد این را true می‌کند تا tgLeadCode_ قفل او را رها نکند */
var TG_LOCK_HELD = false;
var TG_DUTY_SCAN = 80;
var TG_DUTY_NEW_MIN = 24 * 60;
var TG_DUTY_SEEN_MAX = 400;
function tgDutyAge_(d0, t0, now) {
  var d = (d0 instanceof Date) ? new Date(d0) : new Date(String(d0) + 'T00:00:00');
  var hhmm = tgLatinDigits_(String(t0 || '').trim());
  if (/^\d{1,2}:\d{2}$/.test(hhmm) && !isNaN(d.getTime())) { var q = hhmm.split(':'); d.setHours(Number(q[0]), Number(q[1]), 0, 0); }
  return isNaN(d.getTime()) ? 0 : Math.round((now - d) / 60000);
}
/* اثر ثابت یک سطر لید برای وقتی هنوز کد ندارد: تاریخ، ساعت، شماره، نام */
function tgDutyFp_(v) {
  var d = v[0] instanceof Date ? Utilities.formatDate(v[0], TG_TZ, 'yyyy-MM-dd') : String(v[0] || '').trim();
  return 'f:' + tgHash_(d + '|' + String(v[1] || '').trim() + '|' + String(v[5] || '').trim() + '|' + String(v[3] || '').trim());
}
function tgDutyRun_(now) {
  if (TG_DRY) return 'dry';
  var P = PropertiesService.getScriptProperties();
  var sh = tgSS_().getSheetByName(TG_LEADS), last = sh.getLastRow();
  var codeCol = tgLeadCodeCol_(), fc = tgFlagCol_();
  var pend = [];
  try { pend = JSON.parse(P.getProperty('TG_DUTY_PEND') || '[]'); } catch (e) {}
  var seenRaw = P.getProperty('TG_DUTY_SEEN'), seenList = [];
  try { seenList = JSON.parse(seenRaw || '[]'); } catch (e) { seenList = []; }
  var seen = {};
  seenList.forEach(function (k) { seen[k] = 1; });
  /* جابه‌جایی یک‌باره از نسخهٔ سطرمحور: هر سطر تا TG_DUTY_LAST دیده شده، بعدش تازه است */
  var legacyLast = seenRaw === null ? Number(P.getProperty('TG_DUTY_LAST') || 0) : -1;
  pend = pend.map(function (x) {
    if (x.k || !x.r) return x;
    var l0 = tgLeadRead_(x.r); var k0 = l0 ? (l0.code || tgLeadCode_(x.r)) : '';
    if (k0) { x.k = k0; seen[k0] = 1; seenList.push(k0); }
    delete x.r; return x;
  }).filter(function (x) { return x.k; });

  /* لیدهای تازه */
  if (last >= 2) {
    var from = Math.max(2, last - TG_DUTY_SCAN + 1), w0 = Math.max(codeCol, 6);
    var block = sh.getRange(from, 1, last - from + 1, w0).getValues();
    for (var j = 0; j < block.length; j++) {
      var v = block[j], row = from + j;
      if (!(String(v[3] || '').trim() || String(v[5] || '').trim())) continue;
      var fp = tgDutyFp_(v), code = String(v[codeCol - 1] || '').trim();
      if ((code && seen[code]) || seen[fp]) continue;
      if (tgDutyAge_(v[0], v[1], now) > TG_DUTY_NEW_MIN) { seen[fp] = 1; seenList.push(fp); continue; }
      if (seenRaw === null && (legacyLast === 0 || row <= legacyLast)) { seen[fp] = 1; seenList.push(fp); if (code) { seen[code] = 1; seenList.push(code); } continue; }
      if (!code) code = tgLeadCode_(row);
      if (!code) continue;   /* کد ساخته نشد؛ نوبت بعد */
      seen[fp] = 1; seen[code] = 1; seenList.push(fp, code);
      pend.push({ k: code, n: 0 });
    }
  }

  var keep = [], sent = 0;
  var boss = tgDutyBoss_();
  for (var i = 0; i < pend.length; i++) {
    var x = pend[i], r = tgLeadByCode_(x.k);
    if (r < 2) continue;   /* لید حذف شد */
    var l = tgLeadRead_(r);
    if (!l || !(l.name || l.phone)) continue;
    if (!x.a) x.a = now.getTime() - (l.age || 0) * 60000;
    if (l.closed || l.touched) {
      if (x.n) tgDutyLog_(l, x, l.touched ? 'تماس اول گرفته شد' : 'بسته شد', x.t ? Math.round((now.getTime() - x.t) / 60000) : null);
      if (x.n && typeof opsAdaptLeadDone_ === 'function') opsAdaptLeadDone_(x.k);
      continue;
    }
    if (!tgDutyClinic_(l)) continue;
    if (x.n === 0) {
      var w = tgDutyWho_(now);
      if (!w) { keep.push(x); continue; }
      tgSend_(w.p.chat, '🔔 <b>لید تازه، نوبت شماست</b>' + (w.fallback ? ' (نوبت این ساعت خالی است)' : '') + '\n\n' +
        tgLeadCardText_(l), tgLeadKb_(l));
      var fl = String(sh.getRange(r, fc).getValue() || '');
      if (fl.indexOf('مرحلهٔ') < 0) sh.getRange(r, fc).setValue('مرحلهٔ ۱ ' + Utilities.formatDate(now, TG_TZ, 'MM-dd HH:mm') + ' · نوبت ' + w.p.name);
      if (!l.owner) tgLeadSet_(r, { 'مسئول': w.p.name }, 'بات', 'بات', 'نوبت پذیرش');
      x.n = 1; x.t = now.getTime(); x.to = w.p.name; x.c = w.p.chat;
      if (typeof opsAdaptLead_ === 'function') opsAdaptLead_(x.k, w.p.chat, w.p.name);
      sent++; keep.push(x); continue;
    }
    var waited = (now.getTime() - x.t) / 60000;
    if (x.n === 1 && waited >= TG_DUTY_WAIT) {
      tgSend_(x.c, '⏰ <b>' + tgFa_(TG_DUTY_WAIT) + ' دقیقه گذشت؛ این لید هنوز منتظر تماس اول است</b>\n\n' + tgLeadLine_(l) +
        (l.phone ? '\n ' + tgEsc_(l.phone) : ''), tgLeadKb_(l));
      if (boss && boss.name !== x.to) {
        tgSend_(boss.chat, 'ℹ️ لید ' + tgEsc_(l.code || '') + ' از ' + tgFa_(Math.round(waited)) + ' دقیقه پیش با ' + tgEsc_(x.to) +
          ' است و هنوز تماس اول ثبت نشده.\n\n' + tgLeadLine_(l));
        x.b = 1;
      }
      x.n = 2; keep.push(x); continue;
    }
    if (waited >= TG_DUTY_GIVEUP) { tgDutyLog_(l, x, 'بی‌پاسخ ماند', null); continue; }
    keep.push(x);
  }
  keep = keep.slice(-80);
  P.setProperty('TG_DUTY_SEEN', JSON.stringify(seenList.slice(-TG_DUTY_SEEN_MAX)));
  P.setProperty('TG_DUTY_PEND', JSON.stringify(keep));
  P.setProperty('TG_DUTY_LAST', String(last));   /* فقط برای برگشت به نسخهٔ قبل */
  return 'sent ' + sent + ' · pending ' + keep.length;
}


var T_MAG_INTRO = '✍️ <b>نوشتن برای مجلهٔ تجربه</b>\n\n' +
  'بخش بزرگی از مطالب مجله را دانشجوها و درمانگرهای همین مجموعه نوشته‌اند. ' +
  'اگر دوست دارید بنویسید، یکی از موضوع‌هایی را که الان در دست داریم انتخاب کنید یا موضوع خودتان را پیشنهاد بدهید.\n\n' +
  'سردبیر مجله درخواستتان را می‌خواند و نتیجه را همین‌جا خبر می‌دهیم.';
var T_MAG_NO_TOPICS = 'الان موضوع بازی در فهرست نیست، ولی می‌توانید موضوع خودتان را پیشنهاد بدهید.';
var T_MAG_ABOUT = 'در دو سه خط بنویسید چه کسی هستید و از چه زاویه‌ای می‌خواهید به این موضوع بپردازید. اگر قبلاً جایی نوشته‌اید، لینکش را هم بگذارید.';
var T_MAG_OWN = '💡 موضوعی را که دوست دارید درباره‌اش بنویسید در <b>خط اول</b> بنویسید.\n' +
  'در خط‌های بعد بگویید چه کسی هستید و از چه زاویه‌ای می‌نویسید. اگر قبلاً جایی نوشته‌اید، لینکش را هم بگذارید.';
var T_MAG_SHORT = 'کمی بیشتر بنویسید؛ دو سه خط کافی است.';
var T_MAG_TAKEN = 'این موضوع همین حالا به نفر دیگری سپرده شد. یکی دیگر را انتخاب کنید.';
var T_MAG_DELIVER_ASK = 'فایل متن یا لینک گوگل‌داک را همین‌جا بفرستید تا به دست سردبیر مجله برسد.';
var T_MAG_DELIVER_OK = 'رسید. به سردبیر مجله خبر دادیم. ممنون از وقتی که گذاشتید.';
var T_MAG_REJECT = 'این بار درخواستتان جلو نرفت. ممنون که خواستید برای مجله بنویسید. ' +
  'موضوع‌های تازه هر وقت اضافه شود در همین بخش دیده می‌شود و می‌توانید دوباره انتخاب کنید.';
var T_MAG_BYE = 'باشد. هر وقت خواستید از «' + TG_MAG_BTN + '» برگردید.';
var T_CIRCLE_789 = 'حلقه‌های ۷ و ۸ و ۹ از مهر ترم سه (رویا) را با هم دارند و برنامه‌شان روی یک تقویم است.';
var T_EDU_NOPHONE = 'این شماره در فهرست مدرسه نیست. اسم و فامیلتان را بنویسید تا با اسم پیدایتان کنم. به مدرسه هم خبر دادیم.';

/* ---------- شیت ---------- */

function tgMagSheet_(tab, head) {
  if (TG_DRY) return null;
  var ss = tgCSS_(), sh = ss.getSheetByName(tab);
  if (!sh) {
    sh = ss.insertSheet(tab);
    sh.setRightToLeft(true);
    sh.getRange(1, 1, 1, head.length).setValues([head]).setFontWeight('bold').setBackground('#f3efec');
    sh.setFrozenRows(1);
  }
  return sh;
}

function tgMagCode_(prefix, list, key) {
  var max = 100;
  for (var i = 0; i < list.length; i++) {
    var m = String(list[i][key] || '').match(new RegExp('^' + prefix + '-(\\d+)$'));
    if (m && Number(m[1]) > max) max = Number(m[1]);
  }
  return prefix + '-' + (max + 1);
}

var TG_MAG_COLS = 18;   // A تا R تب موضوعات مجله

function tgMagTopics_() {
  if (TG_DRY) return TG_MEM['magtopics'] || [];
  var mtHit = tgCacheGet_('magtopics');
  if (mtHit) { try { return JSON.parse(mtHit); } catch (e) {} }
  var sh = tgMagSheet_(TG_MAG_TOPICS_TAB, TG_MAG_TOPICS_HEAD);
  if (sh.getLastRow() < 2) return [];
  var v = sh.getRange(2, 1, sh.getLastRow() - 1, TG_MAG_COLS).getValues(), out = [];
  for (var i = 0; i < v.length; i++) {
    var title = String(v[i][1] || '').trim();
    if (!title) continue;
    out.push({ row: i + 2, code: String(v[i][0] || '').trim(), title: title,
               angle: String(v[i][2] || '').trim(), cat: String(v[i][3] || '').trim(),
               status: String(v[i][4] || '').trim() || TG_MAG_TOPIC_OPEN,
               wave: String(v[i][11] || '').trim(), prio: String(v[i][12] || '').trim(),
               kind: String(v[i][13] || '').trim(), link: String(v[i][17] || '').trim() });
  }
  // موضوعی که سردبیر بدون کد گذاشته، کد می‌گیرد تا دکمه‌اش پایدار بماند
  for (var k = 0; k < out.length; k++) {
    if (out[k].code) continue;
    out[k].code = tgMagCode_('M', out, 'code');
    sh.getRange(out[k].row, 1).setValue(out[k].code);
    if (!String(v[out[k].row - 2][4] || '').trim()) sh.getRange(out[k].row, 5).setValue(TG_MAG_TOPIC_OPEN);
  }
  try { CacheService.getScriptCache().put('magtopics', JSON.stringify(out), 60); } catch (e) {}
  return out;
}

function tgMagOpenTopics_() {
  return tgMagTopics_().filter(function (t) { return t.status === TG_MAG_TOPIC_OPEN; });
}

function tgMagTopicBy_(code) {
  var l = tgMagTopics_();
  for (var i = 0; i < l.length; i++) if (l[i].code === String(code)) return l[i];
  return null;
}

function tgMagTopicSet_(code, status, writer, pub) {
  var t = tgMagTopicBy_(code);
  if (!t) return;
  t.status = status;
  if (TG_DRY) return;
  var sh = tgMagSheet_(TG_MAG_TOPICS_TAB, TG_MAG_TOPICS_HEAD);
  sh.getRange(t.row, 5).setValue(status);
  if (writer !== undefined) sh.getRange(t.row, 6).setValue(writer);
  if (pub !== undefined) sh.getRange(t.row, 7).setValue(pub ? tgJDateFull_(pub, TG_TZ) : '');
  try { CacheService.getScriptCache().remove('magtopics'); } catch (e) {}
}

function tgMagDate_(x) {
  if (x instanceof Date && !isNaN(x.getTime())) return x;
  var s = tgLatinDigits_(String(x || '')).trim();
  if (/^\d{4}-\d{2}-\d{2}/.test(s)) {
    var d = new Date(s.slice(0, 10) + 'T12:00:00');
    return isNaN(d.getTime()) ? null : d;
  }
  return null;
}

function tgMagReqs_() {
  if (TG_DRY) { if (!TG_MEM['magreqs']) TG_MEM['magreqs'] = []; return TG_MEM['magreqs']; }
  var sh = tgMagSheet_(TG_MAG_TAB, tgMagHeadMem_());
  if (sh.getLastRow() < 2) return [];
  var v = sh.getRange(2, 1, sh.getLastRow() - 1, TG_MAG_HEAD.length).getValues(), out = [];
  for (var i = 0; i < v.length; i++) {
    if (!String(v[i][0] || '').trim()) continue;
    out.push({ row: i + 2, id: String(v[i][0]).trim(), name: String(v[i][2] || '').trim(),
      user: String(v[i][3] || '').trim(), chat: String(v[i][4] || '').trim(), role: String(v[i][5] || ''),
      code: String(v[i][6] || '').trim(), topic: String(v[i][7] || '').trim(), about: String(v[i][8] || ''),
      status: String(v[i][9] || '').trim(), due: tgMagDate_(v[i][10]), pub: tgMagDate_(v[i][11]),
      text: String(v[i][12] || ''), link: String(v[i][13] || ''), note: String(v[i][14] || ''),
      mark: String(v[i][15] || ''), doc: String(v[i][18] || '').trim(), folder: String(v[i][19] || ''), check: String(v[i][20] || ''), wdue: String(v[i][21] || '') });
  }
  return out;
}

function tgMagReqBy_(id) {
  var l = tgMagReqs_();
  for (var i = 0; i < l.length; i++) if (l[i].id === String(id)) return l[i];
  return null;
}

function tgMagSetReq_(r, o) {
  if (!TG_DRY) {
    var sh = tgMagSheet_(TG_MAG_TAB, TG_MAG_HEAD);
    if ('status' in o) sh.getRange(r.row, 10).setValue(o.status);
    if ('due' in o) sh.getRange(r.row, 11).setValue(o.due || '');
    if ('pub' in o) sh.getRange(r.row, 12).setValue(o.pub || '');
    if ('text' in o) sh.getRange(r.row, 13).setValue(o.text);
    if ('link' in o) sh.getRange(r.row, 14).setValue(o.link);
    if ('mark' in o) sh.getRange(r.row, 16).setValue(o.mark);
    if ('due' in o) sh.getRange(r.row, 17).setValue(o.due ? tgJDateFull_(o.due, TG_TZ) : '');
    if ('pub' in o) sh.getRange(r.row, 18).setValue(o.pub ? tgJDateFull_(o.pub, TG_TZ) : '');
  }
  for (var k in o) r[k] = o[k];
}

function tgMagMine_(chat) {
  var l = tgMagReqs_(), out = [];
  for (var i = 0; i < l.length; i++) {
    if (!tgChatIn_(l[i].chat, chat)) continue;
    if ([TG_MAG_ST.wait, TG_MAG_ST.write, TG_MAG_ST.done, TG_MAG_ST2.fix, TG_MAG_ST2.wait2].indexOf(l[i].status) > -1) out.push(l[i]);
  }
  return out;
}

function tgMagAddDays_(d, n) { return new Date(d.getTime() + n * 86400000); }

function tgMagDiff_(d) {
  var a = new Date(Utilities.formatDate(new Date(), TG_TZ, 'yyyy-MM-dd') + 'T00:00:00Z');
  var b = new Date(Utilities.formatDate(d, TG_TZ, 'yyyy-MM-dd') + 'T00:00:00Z');
  return Math.round((b - a) / 86400000);
}

function tgMagFirst_(cell) { return String(cell || '').split(/[,،;\s]+/).filter(String)[0] || ''; }

function tgMagClear_(chat) {
  tgDel_('mzf', chat);
  tgDel_('mzw', chat); tgDel_('mzt', chat); tgDel_('mzu', chat); tgDel_('mzl', chat); tgDel_('mzn', chat);
  tgDel_('utmp', chat); tgDel_('utmpath', chat); tgDel_('utmpg', chat);
}

/* ---------- سردبیر ---------- */

function tgMagEditors_() {
  if (TG_DRY) return TG_MEM['mageditors'] || [];
  var list = tgPeopleList_(), out = [];
  for (var i = 0; i < list.length; i++) {
    if (list[i].roles.indexOf(TG_MAG_EDITOR) > -1 && list[i].chat && list[i].status !== 'غیرفعال') out.push(list[i]);
  }
  return out;
}

function tgMagEditorContact_() {
  var e = tgMagEditors_();
  for (var i = 0; i < e.length; i++) if (e[i].user) return '@' + e[i].user;
  return '';
}

function tgMagIsEditor_(chat) {
  var e = tgMagEditors_();
  for (var i = 0; i < e.length; i++) if (tgChatIn_(e[i].chat, chat)) return true;
  return false;
}

function tgMagNotifyEditors_(text, markup) {
  var e = tgMagEditors_();
  if (!e.length && !TG_DRY) {
    // اگر هنوز سردبیری وصل نیست، ناظر خبردار می‌شود تا درخواست گم نشود
    var all = tgPeopleList_();
    for (var z = 0; z < all.length; z++) if (all[z].roles.indexOf('ناظر') > -1 && all[z].chat) e.push(all[z]);
  }
  for (var i = 0; i < e.length; i++) {
    var ids = String(e[i].chat).split(/[,،;\s]+/).filter(String);
    for (var j = 0; j < ids.length; j++) tgSend_(ids[j], text, markup);
  }
}

function tgMagEdMenu_() {
  var pb = typeof PB_BTNS !== 'undefined' ? [[PB_BTNS[0]], [PB_BTNS[1], PB_BTNS[2]]] : [];   /* v167 */
  return { keyboard: [[TG_MAG_DESK_BTNS[0]], [TG_MAG_DESK_BTNS[1], TG_MAG_DESK_BTNS[2]], [TG_MAG_DESK_BTNS[3], TG_MAG_DESK_BTNS[5]], [TG_MAG_DESK_BTNS[4], TG_EVN_BTN]].concat(pb)
             .concat(tgRoleRow_()), resize_keyboard: true };
}

function tgMagEdKb_(id, uname) {
  var kb = [[{ text: '✅ تأیید و تعیین تاریخ', callback_data: 'mz:ok:' + id },
             { text: '🙏 فعلاً نه', callback_data: 'mz:no:' + id }]];
  var u = String(uname || '').replace(/^@/, '');
  if (u) kb.push([{ text: '💬 پیام به نویسنده', url: 'https://t.me/' + u }]);
  return { inline_keyboard: kb };
}

function tgMagLine_(r) {
  return '• ' + tgEsc_(r.topic) + ' · ' + r.status +
         (r.pub ? ' · انتشار ' + tgJDateFull_(r.pub, TG_TZ) : '') +
         (r.status === TG_MAG_ST.write && r.due ? ' · تحویل ' + tgJDateFull_(r.due, TG_TZ) : '');
}

function tgMagDesk_(chat, text) {
  var s = String(text || '').trim();
  if (s.indexOf('لینک اینستاگرام') > -1)     return tgUtmStart_(chat);
  if (s.indexOf('اعلام موضوع‌های باز') > -1) return tgMagAnnounce_(chat);
  var reqs = tgMagReqs_();
  function by(st) { return reqs.filter(function (r) { return r.status === st; }); }
  if (s.indexOf('درخواست‌های تازه') > -1) {
    var w = by(TG_MAG_ST.wait);
    if (!w.length) return tgSend_(chat, 'درخواست تازه‌ای نیست.', tgMagEdMenu_());
    for (var i = 0; i < Math.min(w.length, 10); i++) {
      tgSend_(chat, '✍️ ' + w[i].id + ' · <b>' + tgEsc_(w[i].topic) + '</b>\n' + tgEsc_(w[i].name) +
              (w[i].user ? ' ' + tgEsc_(w[i].user) : '') + ' · ' + tgEsc_(w[i].role) + '\n\n' +
              tgEsc_(String(w[i].about).slice(0, 600)), tgMagEdKb_(w[i].id, w[i].user));
    }
    return tgSend_(chat, w.length > 10 ? 'ده تای اول را فرستادم؛ بقیه در تب «' + TG_MAG_TAB + '» هاب است.' : 'همین‌ها بود.', tgMagEdMenu_());
  }
  if (s.indexOf('تقویم انتشار') > -1) {
    var a = reqs.filter(function (r) { return r.status === TG_MAG_ST.write || r.status === TG_MAG_ST.done; })
                .sort(function (x, y) { return (x.pub ? x.pub.getTime() : 9e15) - (y.pub ? y.pub.getTime() : 9e15); });
    if (!a.length) return tgSend_(chat, 'فعلاً مطلبی در حال نوشتن نیست.', tgMagEdMenu_());
    var lines = a.map(function (r) {
      return '• ' + (r.pub ? tgJDateFull_(r.pub, TG_TZ) : 'بی‌تاریخ') + ' · <b>' + tgEsc_(r.topic) + '</b>\n  ' +
             tgEsc_(r.name) + ' · ' + r.status + (r.status === TG_MAG_ST.write && r.due ? ' · تحویل ' + tgJDateFull_(r.due, TG_TZ) : '');
    });
    return tgSend_(chat, '🗓 <b>تقویم انتشار</b>\n\n' + lines.join('\n'), tgMagEdMenu_());
  }
  if (s.indexOf('موضوع تازه') > -1) {
    tgSetFlag_('mzn', chat, 1800);
    return tgSend_(chat, 'موضوع را در خط اول بنویسید. اگر زاویه یا توضیحی دارد، در خط دوم.',
                   { inline_keyboard: [[{ text: '↩️ انصراف', callback_data: 'mz:x' }]] });
  }
  if (s.indexOf('موضوع‌ها') > -1) {
    var t = tgMagTopics_(), cnt = {};
    t.forEach(function (x) { cnt[x.status] = (cnt[x.status] || 0) + 1; });
    var open = t.filter(function (x) { return x.status === TG_MAG_TOPIC_OPEN; });
    return tgSend_(chat, '📚 <b>موضوع‌ها</b>\n' + Object.keys(cnt).map(function (k) { return k + ': ' + tgFa_(cnt[k]); }).join(' · ') +
      (open.length ? '\n\n<b>باز</b>\n' + open.map(function (x) { return '• ' + tgEsc_(x.title); }).join('\n') : '') +
      '\n\nموضوع تازه را با «➕ موضوع تازه» یا مستقیم در تب «' + TG_MAG_TOPICS_TAB + '» هاب اضافه کنید؛ همان لحظه برای همه دیده می‌شود.',
      tgMagEdMenu_());
  }
  var open2 = tgMagOpenTopics_().length;
  return tgSend_(chat, '✒️ <b>میز سردبیر مجله</b>\n\n' +
    'در انتظار شما: ' + tgFa_(by(TG_MAG_ST.wait).length) + '\n' +
    'در حال نوشتن: ' + tgFa_(by(TG_MAG_ST.write).length) + '\n' +
    'متن رسیده، منتظر انتشار: ' + tgFa_(by(TG_MAG_ST.done).length) + '\n' +
    'موضوع باز: ' + tgFa_(open2), tgMagEdMenu_());
}

function tgMagAddTopic_(chat, text) {
  var lines = String(text).split('\n').map(function (x) { return x.trim(); }).filter(String);
  if (!lines.length || lines[0].length < 4) { tgSend_(chat, 'موضوع را کامل‌تر بنویسید.'); return true; }
  tgDel_('mzn', chat);
  var list = tgMagTopics_();
  var code = tgMagCode_('M', list, 'code');
  if (TG_DRY) list.push({ row: list.length + 2, code: code, title: lines[0], angle: lines.slice(1).join(' '), cat: '', status: TG_MAG_TOPIC_OPEN });
  else tgMagSheet_(TG_MAG_TOPICS_TAB, TG_MAG_TOPICS_HEAD).appendRow([code, lines[0], lines.slice(1).join(' '), '', TG_MAG_TOPIC_OPEN, '', '', '']);
  tgSend_(chat, '✅ «' + tgEsc_(lines[0]) + '» به موضوع‌های باز اضافه شد (' + code + ').', tgMagEdMenu_());
  return true;
}

/* ---------- نویسنده ---------- */

function tgMagStart_(chat) {
  tgMagClear_(chat);
  var mine = tgMagMine_(chat);
  var open = tgMagOpenTopics_();
  var kb = [];
  for (var i = 0; i < Math.min(open.length, TG_MAG_MAX_OPEN); i++) {
    kb.push([{ text: '📝 ' + open[i].title.slice(0, 60), callback_data: 'mz:t:' + open[i].code }]);
  }
  kb.push([{ text: '💡 موضوع پیشنهادی خودم', callback_data: 'mz:own' }]);
  var body = T_MAG_INTRO;
  if (mine.length) body += '\n\n<b>درخواست‌های شما</b>\n' + mine.map(tgMagLine_).join('\n');
  body += '\n\n' + (open.length ? 'موضوع‌هایی که الان در دست داریم:' : T_MAG_NO_TOPICS);
  tgSend_(chat, body, { inline_keyboard: kb });
  for (var k = 0; k < mine.length; k++) {
    if (mine[k].status !== TG_MAG_ST.write) continue;
    tgSend_(chat, '📤 وقتی متن «' + tgEsc_(mine[k].topic) + '» آماده شد، این دکمه را بزنید.',
            { inline_keyboard: [[{ text: '📤 متن را تحویل می‌دهم', callback_data: 'mz:up:' + mine[k].id }]] });
  }
  return null;
}

function tgMagPick_(chat, code) {
  var cancel = { inline_keyboard: [[{ text: '↩️ انصراف', callback_data: 'mz:x' }]] };
  if (code === 'own') {
    tgSetVal_('mzt', chat, 'own');
    tgSetFlag_('mzw', chat, 3600);
    return tgSend_(chat, T_MAG_OWN, cancel);
  }
  var t = tgMagTopicBy_(code);
  if (!t || t.status !== TG_MAG_TOPIC_OPEN) { tgSend_(chat, T_MAG_TAKEN); return tgMagStart_(chat); }
  tgSetVal_('mzt', chat, t.code);
  tgSetFlag_('mzw', chat, 3600);
  return tgSend_(chat, '✅ موضوع انتخابی شما: <b>' + tgEsc_(t.title) + '</b>' +
                 (t.angle ? '\n' + tgEsc_(t.angle) : '') + '\n\n' + T_MAG_ABOUT, cancel);
}

function tgMagSubmit_(chat, name, uname, text) {
  var s = String(text || '').trim();
  if (s.length < 15) return tgSend_(chat, T_MAG_SHORT);
  var code = tgGetVal_('mzt', chat) || 'own';
  var t = code === 'own' ? null : tgMagTopicBy_(code);
  if (code !== 'own' && (!t || t.status !== TG_MAG_TOPIC_OPEN)) { tgMagClear_(chat); tgSend_(chat, T_MAG_TAKEN); return tgMagStart_(chat); }
  var lines = s.split('\n');
  var topic = t ? t.title : lines[0].trim().slice(0, 140);
  var about = t ? s : (lines.slice(1).join('\n').trim() || s);
  var p = null;
  try { p = tgWhoPerson_(chat, String(uname || '').replace(/^@/, '')); } catch (e) {}
  var who = p ? p.name : name;
  var role = p ? p.roles.join('، ') : (tgWhoTherapist_(chat) ? 'درمانگر' : 'مخاطب عمومی');
  var reqs = tgMagReqs_();
  var id = tgMagCode_('W', reqs, 'id');
  if (TG_DRY) {
    reqs.push({ row: reqs.length + 2, id: id, name: who, user: uname || '', chat: String(chat), role: role,
                code: t ? t.code : 'پیشنهاد خودش', topic: topic, about: about, status: TG_MAG_ST.wait,
                due: null, pub: null, text: '', link: '', note: '', mark: '' });
  } else {
    tgMagSheet_(TG_MAG_TAB, TG_MAG_HEAD).appendRow([id, new Date(), who, uname || '', String(chat), role,
      t ? t.code : 'پیشنهاد خودش', topic, about, TG_MAG_ST.wait, '', '', '', '', '', '', '', '']);
  }
  if (t) tgMagTopicSet_(t.code, 'درخواست شده', who);
  tgMagClear_(chat);
  var ed = tgMagEditorContact_();
  tgSend_(chat, '✅ درخواستتان ثبت شد.\n\nموضوع: <b>' + tgEsc_(topic) + '</b>\nشمارهٔ پیگیری: ' + id +
          '\n\nسردبیر مجله درخواست را می‌خواند و نتیجه را همین‌جا خبر می‌دهیم.' +
          (ed ? '\nاگر خواستید مستقیم پیام بدهید: ' + ed : ''));
  tgMagNotifyEditors_('✍️ <b>درخواست نویسندگی تازه</b> · ' + id + '\n\nموضوع: <b>' + tgEsc_(topic) + '</b>' +
    (t ? '' : ' (پیشنهاد خودش)') + '\nنویسنده: ' + tgEsc_(who) + (uname ? ' ' + tgEsc_(uname) : '') +
    '\nنقش: ' + tgEsc_(role) + '\n\n' + tgEsc_(about.slice(0, 700)), tgMagEdKb_(id, uname));
  return null;
}

function tgMagAskDate_(chat, r) {
  var kb = [], row = [];
  for (var i = 0; i < TG_MAG_OFFSETS.length; i++) {
    var d = tgMagAddDays_(new Date(), TG_MAG_OFFSETS[i]);
    row.push({ text: tgJDateFull_(d, TG_TZ), callback_data: 'mz:d:' + r.id + ':' + TG_MAG_OFFSETS[i] });
    if (row.length === 2) { kb.push(row); row = []; }
  }
  if (row.length) kb.push(row);
  kb.push([{ text: '✏️ تاریخ را بعداً در هاب می‌نویسم', callback_data: 'mz:d:' + r.id + ':0' }]);
  return tgSend_(chat, '🗓 تاریخ انتشار «' + tgEsc_(r.topic) + '» کِی باشد؟\n' +
                 'موعد تحویل متن خودکار ' + tgFa_(TG_MAG_LEAD_DAYS) + ' روز قبل از انتشار گذاشته می‌شود.', { inline_keyboard: kb });
}

function tgMagApprove_(chat, r, n) {
  var wasWait = r.status === TG_MAG_ST.wait;
  if (!wasWait && r.status !== TG_MAG_ST.write && r.status !== TG_MAG_ST.done) {
    return tgSend_(chat, 'وضعیت این درخواست «' + r.status + '» است و تاریخش عوض نمی‌شود.');
  }
  var pub = n ? tgMagAddDays_(new Date(), n) : null;
  var due = pub ? tgMagAddDays_(pub, -TG_MAG_LEAD_DAYS) : null;
  tgMagSetReq_(r, { status: r.status === TG_MAG_ST.done ? TG_MAG_ST.done : TG_MAG_ST.write, due: due, pub: pub, mark: '' });
  tgMagTopicSet_(r.code, 'در حال نوشتن', r.name, pub);
  var when = pub
    ? '\n🗓 تاریخ انتشار: <b>' + tgJDateFull_(pub, TG_TZ) + '</b>\n📤 موعد تحویل متن: <b>' + tgJDateFull_(due, TG_TZ) + '</b>'
    : '\nتاریخ انتشار را سردبیر مجله به‌زودی مشخص می‌کند.';
  tgSend_(chat, '✅ ثبت شد. ' + r.id + ' · ' + tgEsc_(r.topic) + when + '\nدر تب «' + TG_MAG_TAB + '» هاب هم نشست.');
  var to = tgMagFirst_(r.chat);
  if (!to) return null;
  if (!wasWait) return tgSend_(to, '🗓 <b>تاریخ انتشار مطلبتان عوض شد.</b>\n\nموضوع: <b>' + tgEsc_(r.topic) + '</b>' + when);
  tgSend_(to, '🎉 <b>سردبیر مجله درخواستتان را تأیید کرد.</b>\n\nموضوع: <b>' + tgEsc_(r.topic) + '</b>' + when);
  tgMagAfterApprove_(r);
  return null;
}

function tgMagReject_(chat, r) {
  if (r.status !== TG_MAG_ST.wait) return tgSend_(chat, 'این درخواست قبلاً بررسی شده: ' + r.status);
  tgMagSetReq_(r, { status: TG_MAG_ST.no });
  tgMagTopicSet_(r.code, TG_MAG_TOPIC_OPEN, '');
  tgSend_(chat, 'ثبت شد: ' + r.id + ' «فعلاً نه». اگر موضوع از فهرست بود، دوباره باز شد. پیام محترمانه‌ای برای نویسنده رفت.');
  var to = tgMagFirst_(r.chat);
  if (to) tgSend_(to, '✍️ دربارهٔ «' + tgEsc_(r.topic) + '»\n\n' + T_MAG_REJECT);
  return null;
}

function tgMagDeliverAsk_(chat, id) {
  var r = tgMagReqBy_(id);
  if (!r || !tgChatIn_(r.chat, chat)) return tgSend_(chat, 'این درخواست پیدا نشد.');
  if (r.status !== TG_MAG_ST.write) return tgSend_(chat, 'وضعیت «' + tgEsc_(r.topic) + '» الان «' + r.status + '» است.');
  tgMagClear_(chat);
  tgSetVal_('mzu', chat, r.id);
  return tgSend_(chat, '📤 ' + T_MAG_DELIVER_ASK, { inline_keyboard: [[{ text: '↩️ انصراف', callback_data: 'mz:x' }]] });
}

function tgMagDeliver_(chat, m) {
  var r = tgMagReqBy_(tgGetVal_('mzu', chat));
  if (!r) { tgDel_('mzu', chat); return false; }
  var text = String((m && (m.text || m.caption)) || '').trim();
  var file = m && m.document;
  var link = (text.match(/https?:\/\/\S+/) || [''])[0];
  if (!file && !link) {
    tgSend_(chat, 'فایل را بفرستید یا لینک گوگل‌داک را بگذارید. اگر منصرف شدید «↩️ انصراف» را بزنید.',
            { inline_keyboard: [[{ text: '↩️ انصراف', callback_data: 'mz:x' }]] });
    return true;
  }
  tgDel_('mzu', chat);
  tgMagSetReq_(r, { status: TG_MAG_ST.done, text: link || ('فایل در تلگرام: ' + (file.file_name || 'بی‌نام')) });
  var kb = { inline_keyboard: [[{ text: '✅ منتشر شد', callback_data: 'mz:pub:' + r.id },
                                { text: '🗓 تغییر تاریخ', callback_data: 'mz:mv:' + r.id }]] };
  tgMagNotifyEditors_('📥 <b>متن رسید</b> · ' + r.id + '\nموضوع: <b>' + tgEsc_(r.topic) + '</b>\nنویسنده: ' +
    tgEsc_(r.name) + (r.user ? ' ' + tgEsc_(r.user) : '') +
    (r.pub ? '\nتاریخ انتشار: ' + tgJDateFull_(r.pub, TG_TZ) : '') + (link ? '\n' + tgEsc_(link) : '\nفایل را پایین همین پیام می‌بینید.'), kb);
  if (file && !TG_DRY) {
    var e = tgMagEditors_();
    for (var i = 0; i < e.length; i++) {
      var to = tgMagFirst_(e[i].chat);
      if (to) tgApi_('copyMessage', { chat_id: to, from_chat_id: chat, message_id: m.message_id });
    }
  }
  tgSend_(chat, '✅ ' + T_MAG_DELIVER_OK);
  return true;
}

function tgMagPubLink_(chat, text) {
  var r = tgMagReqBy_(tgGetVal_('mzl', chat));
  if (!r) { tgDel_('mzl', chat); return false; }
  var link = (String(text).match(/https?:\/\/\S+/) || [''])[0];
  if (!link) { tgSend_(chat, 'لینکی پیدا نکردم. لینک کامل مطلب را بفرستید یا «↩️ انصراف» را بزنید.'); return true; }
  tgDel_('mzl', chat);
  var when = r.pub || new Date();
  tgMagSetReq_(r, { status: TG_MAG_ST.pub, link: link, pub: when });
  tgMagTopicSet_(r.code, 'منتشر شد', r.name, when);
  try { tgMagProfileLink_(r, link); } catch (ePl) {}
  tgSend_(chat, '✅ ' + r.id + ' منتشر شد و به نویسنده خبر دادیم.');
  var to = tgMagFirst_(r.chat);
  if (to) tgSend_(to, '🎉 <b>مطلبتان در مجلهٔ تجربه منتشر شد.</b>\n\n<b>' + tgEsc_(r.topic) + '</b>\n' + tgEsc_(link) +
                  '\n\nممنون که نوشتید. اگر موضوع دیگری در ذهن دارید، از «' + TG_MAG_BTN + '» پیشنهاد بدهید.');
  /* v165: اگر نویسنده صفحهٔ نویسنده ندارد، ساخت حسابش را خودش از همین‌جا کامل می‌کند */
  try { if (typeof tgAuAfterPub_ === 'function') tgAuAfterPub_(r, link); } catch (eAu) { tgErr_('tgAuAfterPub_: ' + eAu); }
  return true;
}

function tgOnMag_(cq, rest, name, uname) {
  var chat = cq.message.chat.id;
  var parts = String(rest).split(':'), act = parts[0], id = parts[1] || '', n = Number(parts[2] || 0);
  if (act === 'start') return tgMagStart_(chat);
  if (act === 'own') return tgMagPick_(chat, 'own');
  if (act === 't') return tgMagPick_(chat, id);
  if (act === 'x') { tgMagClear_(chat); return tgSend_(chat, T_MAG_BYE); }
  if (act === 'up') { var ru = tgMagReqBy_(id); return (ru && ru.doc) ? tgMagReadyReview_(chat, ru) : tgMagDeliverAsk_(chat, id); }
  if (act === 'wd') { var rw = tgMagReqBy_(id); return rw ? tgMagWriterDue_(chat, rw, n) : tgSend_(chat, 'این درخواست پیدا نشد.'); }
  var isOwner = String(chat) === String(TG_OWNER_CHAT);
  if (act === 'go') { var rg = tgMagReqBy_(id); return rg ? tgMagGo_(chat, rg) : tgSend_(chat, 'این درخواست پیدا نشد.'); }
  if (!tgMagIsEditor_(chat) && !(isOwner && act === 'fix')) return tgSend_(chat, 'این دکمه مخصوص سردبیر مجله است.');
  var r = tgMagReqBy_(id);
  if (!r) return tgSend_(chat, 'این درخواست پیدا نشد: ' + id);
  if (act === 'fix') return tgMagFixAsk_(chat, r);
  if (act === 'ck') return tgMagCheck_(chat, r, parts.length > 2 ? parts[2] : '');
  if (act === 'ok') {
    if (r.status !== TG_MAG_ST.wait) return tgSend_(chat, 'این درخواست قبلاً بررسی شده: ' + r.status);
    return tgMagAskDate_(chat, r);
  }
  if (act === 'mv') return tgMagAskDate_(chat, r);
  if (act === 'd') return tgMagApprove_(chat, r, n);
  if (act === 'no') return tgMagReject_(chat, r);
  if (act === 'pub') {
    tgMagClear_(chat);
    tgSetVal_('mzl', chat, r.id);
    return tgSend_(chat, 'لینک مطلب منتشرشدهٔ «' + tgEsc_(r.topic) + '» را بفرستید.',
                   { inline_keyboard: [[{ text: '↩️ انصراف', callback_data: 'mz:x' }]] });
  }
  return null;
}

function tgMagIsBtn_(s) { return tgIsBtnLike_(s); }

/* پیش از مسیریابی نقش صدا زده می‌شود: دکمه‌ها و حالت‌های انتظار متن آزاد (دام ۹) */
function tgMagText_(chat, name, uname, text) {
  var s = String(text || '').trim();
  var cmd = tgCmd_(s);
  if (cmd === '/write' || s === TG_MAG_BTN || /^\/start(@\w+)?\s+(write|mag)$/.test(s)) { tgMagStart_(chat); return true; }
  if (cmd === '/edu') { tgEduSignup_(chat); return true; }
  var busy = tgGetVal_('mzw', chat) || tgGetVal_('mzu', chat) || tgGetVal_('mzl', chat) || tgGetVal_('mzn', chat) || tgGetVal_('mzf', chat) || tgFlag_('utmp', chat);
  if (busy) {
    if (s.indexOf('/') === 0 || s === '↩️ بازگشت' || s === 'بازگشت' || s === 'انصراف' || tgMagIsBtn_(s)) {
      tgMagClear_(chat);
    } else {
      if (tgFlag_('utmp', chat)) { tgUtmPathGot_(chat, s); return true; }
      if (tgGetVal_('mzl', chat)) return tgMagPubLink_(chat, s);
      if (tgGetVal_('mzf', chat)) return tgMagFixNote_(chat, s);
      if (tgGetVal_('mzn', chat)) return tgMagAddTopic_(chat, s);
      if (tgGetVal_('mzu', chat)) return tgMagDeliver_(chat, { text: s });
      if (tgGetVal_('mzw', chat)) { tgMagSubmit_(chat, name, uname, s); return true; }
    }
  }
  if (TG_MAG_DESK_BTNS.indexOf(s) > -1 && tgMagIsEditor_(chat)) { tgMagDesk_(chat, s); return true; }
  if (typeof pbDesk_ === 'function' && pbDesk_(chat, s)) return true;   /* v167: انتشار، پیام هفتگی، آمار */
  return false;
}

/* هر روز یک بار در ساعت کاری: یادآوری موعد تحویل به نویسنده، دیرکرد و روز انتشار به سردبیر */
function tgMagTick_() {
  if (TG_DRY) return;
  var h = Number(Utilities.formatDate(new Date(), TG_TZ, 'H'));
  if (h < 9 || h > 18) return;
  var props = PropertiesService.getScriptProperties();
  var today = Utilities.formatDate(new Date(), TG_TZ, 'yyyy-MM-dd');
  if (props.getProperty('TG_MAG_DAY') === today) return;
  props.setProperty('TG_MAG_DAY', today);
  var reqs = tgMagReqs_(), ed = tgMagEditorContact_();
  for (var i = 0; i < reqs.length; i++) {
    var r = reqs[i], mark = r.mark;
    if (r.status !== TG_MAG_ST.write && r.status !== TG_MAG_ST.done) continue;
    var dDue = r.due ? tgMagDiff_(r.due) : null, dPub = r.pub ? tgMagDiff_(r.pub) : null;
    if (r.status === TG_MAG_ST.write && dDue === 2 && mark.indexOf('r2') < 0) {
      tgNotify_(tgMagFirst_(r.chat), TG_NK.remind, '✍️ یادآوری کوچک: موعد تحویل متن «' + tgEsc_(r.topic) + '» ' + tgJDateFull_(r.due, TG_TZ) +
        ' است.' + (ed ? '\nاگر به زمان بیشتری نیاز دارید، به سردبیر مجله بگویید: ' + ed : ''),
        { ref: r.id, markup: { inline_keyboard: [[{ text: '📤 آماده برای بازبینی', callback_data: 'mz:up:' + r.id }]] } });
      mark += ' r2';
    }
    if (r.status === TG_MAG_ST.write && dDue !== null && dDue < 0 && mark.indexOf('late') < 0) {
      tgMagNotifyEditors_('⏳ موعد تحویل ' + r.id + ' گذشت\n<b>' + tgEsc_(r.topic) + '</b> · ' + tgEsc_(r.name) +
        (r.user ? ' ' + tgEsc_(r.user) : ''), { inline_keyboard: [[{ text: '🗓 تغییر تاریخ', callback_data: 'mz:mv:' + r.id }]] });
      mark += ' late';
    }
    if (dPub === 0 && mark.indexOf('pub0') < 0) {
      tgMagNotifyEditors_('📰 امروز روز انتشار ' + r.id + ' است\n<b>' + tgEsc_(r.topic) + '</b> · ' + tgEsc_(r.name) +
        ' · ' + r.status, { inline_keyboard: [[{ text: '✅ منتشر شد', callback_data: 'mz:pub:' + r.id },
                                               { text: '🗓 تغییر تاریخ', callback_data: 'mz:mv:' + r.id }]] });
      mark += ' pub0';
    }
    var fix = {};
    if (mark !== r.mark) fix.mark = mark.trim();
    if (r.due || r.pub) { fix.due = r.due; fix.pub = r.pub; }   // ستون‌های شمسی با تاریخی که سردبیر در هاب عوض کرده هم‌خوان می‌شوند
    if (Object.keys(fix).length) tgMagSetReq_(r, fix);
  }
}

/* ---------- مینی‌اپ ---------- */

function tgApiMag_(p) {
  var user = tgVerifyInitData_(p.initData);
  if (!user || !user.id) return { ok: false, error: 'auth' };
  return { ok: true,
    topics: tgMagOpenTopics_().slice(0, 20).map(function (t) { return { code: t.code, title: t.title, angle: t.angle, cat: t.cat }; }),
    mine: tgMagMine_(user.id).map(function (r) {
      return { id: r.id, topic: r.topic, status: r.status,
               pub: r.pub ? tgJDateFull_(r.pub, TG_TZ) : '', due: r.due ? tgJDateFull_(r.due, TG_TZ) : '' };
    }),
    intro: T_MAG_INTRO.replace(/<[^>]+>/g, '') };
}

function tgApiMagReq_(p) {
  var user = tgVerifyInitData_(p.initData);
  if (!user || !user.id) return { ok: false, error: 'auth' };
  var chat = user.id;
  var name = [user.first_name, user.last_name].filter(String).join(' ').trim();
  var uname = user.username ? '@' + user.username : '';
  var code = String(p.code || 'own');
  var about = String(p.about || '').trim(), own = String(p.topic || '').trim().replace(/\n/g, ' ');
  if (code === 'own' && own.length < 4) return { ok: false, error: 'topic' };
  if (about.length < 15) return { ok: false, error: 'short' };
  if (code !== 'own') {
    var t = tgMagTopicBy_(code);
    if (!t || t.status !== TG_MAG_TOPIC_OPEN) return { ok: false, error: 'taken' };
  }
  tgSetVal_('mzt', chat, code);
  tgMagSubmit_(chat, name, uname, code === 'own' ? own + '\n' + about : about);
  return { ok: true };
}

/* ---------- مدرسه: پیدا کردن با شماره، اعلام جاافتاده‌ها ---------- */

function tgEduKb_() {
  return { keyboard: [[{ text: '📱 با شماره‌ام پیدا کن', request_contact: true }], ['↩️ بازگشت']], resize_keyboard: true };
}

function tgEduMiss_(chat, what) {
  if (tgFlag_('emiss', chat)) return;
  tgSetFlag_('emiss', chat, 43200);
  try {
    tgSchoolNotify_('🎓 کسی می‌خواهد به بخش مدرسهٔ بات وصل شود ولی در تب «افراد» پیدا نشد.\n' +
                    tgEsc_(what) + '\nchat_id: ' + chat + '\nاگر دانشجو یا استاد است، سطرش را در «افراد» اضافه یا اصلاح کنید.');
  } catch (e) { tgErr_('tgEduMiss_: ' + e); }
}

function tgEduByPhone_(chat, contact, fromId) {
  if (contact.user_id && fromId && Number(contact.user_id) !== Number(fromId)) {
    return tgSend_(chat, 'شمارهٔ خودتان را با همان دکمهٔ «📱 با شماره‌ام پیدا کن» بفرستید.', tgEduKb_());
  }
  var ph = tgLatinDigits_(String(contact.phone_number || '')).replace(/\D/g, '').slice(-10);
  var list = tgPeopleList_(), hit = null;
  for (var i = 0; i < list.length && ph; i++) {
    if (!tgIsSchoolRow_(list[i])) continue;
    var q = tgLatinDigits_(String(list[i].phone || '')).replace(/\D/g, '').slice(-10);
    if (q && q === ph) { hit = list[i]; break; }
  }
  if (!hit) { tgEduMiss_(chat, 'شماره: ' + ph); return tgSend_(chat, T_EDU_NOPHONE, tgEduKb_()); }
  return tgEduConnect_(chat, hit);
}

/* ───── تست نویسندگی مجله و اتصال مدرسه ───── */
function tgMagTests() {
  var out = [], pass = 0, fail = 0;
  function ok(n, c) { c ? pass++ : fail++; out.push((c ? '✅ ' : '❌ ') + n); }
  var wasDry = TG_DRY;
  TG_DRY = true;
  function msgs() { return TG_OUTBOX.filter(function (x) { return x.kind === 'msg'; }); }
  function said() { return msgs().map(function (x) { return x.text + ' ' + JSON.stringify(x.markup || ''); }).join('\n'); }
  function to(c, frag) { return msgs().some(function (x) { return x.chat === String(c) && (x.text + JSON.stringify(x.markup || '')).indexOf(frag) > -1; }); }
  function cq(c) { return { message: { chat: { id: c } } }; }
  function reset() {
    TG_OUTBOX = []; TG_MEM = {};
    TG_MEM['magtopics'] = [{ row: 2, code: 'M-101', title: 'رؤیا در نظریهٔ فروید', angle: 'برای خوانندهٔ تازه‌کار', cat: 'روان‌کاوی', status: 'باز' }];
    TG_MEM['mageditors'] = [{ name: 'سردبیر تست', user: 'editor_test', chat: '555', roles: ['سردبیر'], status: 'فعال' }];
    TG_MEM['people'] = [{ row: 5, name: 'دانشجوی تست', user: '', chat: '', roles: ['دانشجو'], circle: '', status: 'در انتظار اتصال', phone: '+989121234567' }];
  }
  try {
    reset(); tgMagStart_(777);
    ok('موضوع باز دکمه دارد', said().indexOf('mz:t:M-101') > -1);
    ok('موضوع پیشنهادی خودم هست', said().indexOf('mz:own') > -1);

    reset(); tgMagPick_(777, 'M-101');
    ok('انتخاب با جملهٔ کامل برمی‌گردد', said().indexOf('موضوع انتخابی شما') > -1 && said().indexOf('رؤیا در نظریهٔ فروید') > -1);
    ok('منتظر معرفی می‌ماند', tgFlag_('mzw', 777));
    TG_OUTBOX = []; tgMagText_(777, 'تست', '@w_test', 'کوتاه');
    ok('متن کوتاه رد می‌شود', said().indexOf('کمی بیشتر') > -1 && tgFlag_('mzw', 777));
    TG_OUTBOX = []; tgMagText_(777, 'تست', '@w_test', 'دانشجوی حلقهٔ ۱۴ هستم و دربارهٔ رؤیا زیاد خوانده‌ام.');
    ok('درخواست ثبت می‌شود', said().indexOf('درخواستتان ثبت شد') > -1 && said().indexOf('W-101') > -1);
    ok('سردبیر خبردار می‌شود', to(555, 'درخواست نویسندگی تازه') && to(555, 'mz:ok:W-101'));
    ok('راه تماس سردبیر به نویسنده داده می‌شود', to(777, '@editor_test'));
    ok('موضوع دیگر باز نیست', tgMagOpenTopics_().length === 0);

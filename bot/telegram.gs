    ok('پاسخ پذیرش به واتس‌اپ می‌رود', r3 === true && sent.length === 1 && sent[0].to === '09120000000');
    ok('پاسخ در دفتر رویداد ثبت می‌شود',
       TG_OUTBOX.filter(function (o) { return o.kind === 'leadev' && o.o && o.o.what === 'پاسخ واتس‌اپ'; }).length === 1);
    ok('فلگ پاسخ بعد از ارسال پاک می‌شود', !tgGetVal_('war', 55));


  ['هیجان‌مدار',              ['eft', 'هیجان']],
  // آخرین پناه: «روانکاوی» یا «روان‌پویشی» بدون مکتب، فعلاً کلاسیک تا خودش عوض کند
  ['تحلیلی — فرویدی کلاسیک', ['روانکاوی', 'روان‌پویشی', 'روان پویشی', 'تحلیلی']]
];

/* متن آزاد رویکرد را به یکی از نُه‌تا می‌رساند. اگر نرسید، رشتهٔ خالی. */
function tgApproachNorm_(raw) {
  const s = tgNorm_(String(raw || '')).toLowerCase();
  if (!s) return '';
  for (var i = 0; i < TG_APPROACH_MAP.length; i++) {
    const keys = TG_APPROACH_MAP[i][1];
    for (var j = 0; j < keys.length; j++) if (s.indexOf(keys[j]) > -1) return TG_APPROACH_MAP[i][0];
  }
  return '';
}

function tgApproachFamily_(a) { return TG_APPROACH_FAMILY[a] || ''; }

/* هاب را از «پروندهٔ کامل درمانگران» پر می‌کند. فقط خانه‌های خالی.
   هیچ‌وقت چیزی را که آدمی نوشته بازنویسی نمی‌کند. کد ملی هم نمی‌آید. */
function tgProfileFill() {
  const hub = tgSS_().getSheetByName(TG_THER);
  const last = hub.getLastRow();
  if (last < 4) return 'تب درمانگران خالی است.';

  // ستون بازبینی رویکرد خام، اگر نیست ساخته شود
  const RAWCOL = 'رویکرد اعلام‌شده (خام)';
  var lc = hub.getLastColumn();
  var head = hub.getRange(3, 1, 1, lc).getValues()[0];
  var rawCol = -1;
  for (var h = 0; h < lc; h++) if (String(head[h]).trim() === RAWCOL) { rawCol = h + 1; break; }
  if (rawCol < 0) { rawCol = lc + 1; hub.getRange(3, rawCol).setValue(RAWCOL).setFontWeight('bold'); }

  const src = SpreadsheetApp.openById(TG_PROFILE_SS).getSheetByName('پرونده درمانگران');
  const sv = src.getRange(2, 1, src.getLastRow() - 1, 24).getValues();
  const by = {};
  for (var i = 0; i < sv.length; i++) {
    const n = tgNorm_(sv[i][0]);
    if (n) by[n] = sv[i];
  }

  const n = last - 3;
  const cur = hub.getRange(4, 1, n, Math.max(rawCol, 26)).getValues();
  var filled = 0, matched = 0, unmapped = {};

  for (var r = 0; r < n; r++) {
    const name = String(cur[r][0]).trim();
    if (!name) continue;
    const s = by[tgNorm_(name)];
    if (!s) continue;
    matched++;

    const serv = String(s[11] || '');
    const app  = String(s[10] || '');
    const norm = tgApproachNorm_(app);
    if (!norm && app.trim()) unmapped[app.trim().split(/[\n,،]/)[0].trim()] = (unmapped[app.trim().split(/[\n,،]/)[0].trim()] || 0) + 1;

    function put(col, val) {
      if (!val) return;
      if (String(cur[r][col - 1] || '').trim()) return;
      hub.getRange(r + 4, col).setValue(val);
      filled++;
    }

    put(TG_C_GENDER, String(s[2] || '').trim());
    put(TG_C_MODE, String(s[15] || '').trim());
    put(5, norm);
    put(rawCol, app.trim());
    put(7, /کودک|نوجوان/.test(serv) ? 'کودک و نوجوان' : 'بزرگسال');
    put(8, /زوج|ازدواج/.test(serv) ? 'بله' : 'خیر');
    if (/فردی/.test(serv))            put(9, 'بله');
    if (/زوج|ازدواج/.test(serv))      put(10, 'بله');
    if (/خانواده/.test(serv))         put(11, 'بله');
    if (/کودک|نوجوان/.test(serv))     put(12, 'بله');
    if (s[17] === true || String(s[17]).toLowerCase() === 'true') put(TG_POOL_LGBT, 'بله');
  }

  try { CacheService.getScriptCache().remove('trows'); } catch (e) {}
  var out = 'سطر هاب: ' + n + ' · خورد به پرونده: ' + matched + ' · خانهٔ پرشده: ' + filled + '\n';
  const uk = Object.keys(unmapped).sort(function (a, b) { return unmapped[b] - unmapped[a]; });
  if (uk.length) {
    out += '\nرویکردهایی که به فهرست نُه‌تایی نخوردند و خام ماندند:\n';
    for (var k = 0; k < uk.length; k++) out += '  ' + unmapped[uk[k]] + '  ' + uk[k] + '\n';
  }
  Logger.log(out);
  return out;
}

/* املای قدیمی ستون «مکتب اصلی» را به فهرست نُه‌تایی می‌رساند.
   متن اصلی در ستون بازبینی می‌ماند، پس چیزی گم نمی‌شود.        */
function tgApproachTidy() {
  const hub = tgSS_().getSheetByName(TG_THER);
  const last = hub.getLastRow();
  if (last < 4) return 'خالی';
  const RAWCOL = 'رویکرد اعلام‌شده (خام)';
  var lc = hub.getLastColumn();
  const head = hub.getRange(3, 1, 1, lc).getValues()[0];
  var rawCol = -1;
  for (var h = 0; h < lc; h++) if (String(head[h]).trim() === RAWCOL) { rawCol = h + 1; break; }
  if (rawCol < 0) { rawCol = lc + 1; hub.getRange(3, rawCol).setValue(RAWCOL).setFontWeight('bold'); }

  const n = last - 3;
  const cur = hub.getRange(4, 1, n, Math.max(rawCol, 26)).getValues();
  var fixed = 0, kept = 0, stuck = {};
  for (var r = 0; r < n; r++) {
    if (!String(cur[r][0]).trim()) continue;
    const now = String(cur[r][4] || '').trim();
    if (!now) continue;
    if (TG_APPROACHES.indexOf(now) > -1) { kept++; continue; }
    const norm = tgApproachNorm_(now);
    if (!norm) { stuck[now] = (stuck[now] || 0) + 1; continue; }
    if (!String(cur[r][rawCol - 1] || '').trim()) hub.getRange(r + 4, rawCol).setValue(now);
    hub.getRange(r + 4, 5).setValue(norm);
    fixed++;
  }
  try { CacheService.getScriptCache().remove('trows'); } catch (e) {}
  var out = 'یکدست شد: ' + fixed + ' · از قبل درست: ' + kept + '\n';
  const sk = Object.keys(stuck);
  if (sk.length) { out += '\nنخورد و دست‌نخورده ماند:\n'; for (var k = 0; k < sk.length; k++) out += '  ' + stuck[sk[k]] + '  ' + sk[k] + '\n'; }
  Logger.log(out);
  return out;
}

/* ═══════════ پروفایل درمانگر: ذخیره و کارت معرفی ═══════════ */

// موضوع‌های تخصصی؛ همان نُه گویه‌ای که مراجع در فرم پذیرش انتخاب می‌کند
const TG_TOPICS_PRO = ['افسردگی', 'بی‌حوصلگی و بی‌انگیزگی', 'تعویق و اهمال',
  'اضطراب', 'وسواس فکری و نشخوار', 'خودشناسی', 'ریشه‌یابی مشکلات', 'مشکل در روابط'];

const TG_STYLES = ['فعال و مسیرده', 'بیشتر شنونده', 'بسته به مراجع'];
const TG_TONES  = ['رک و قاطع', 'ملایم و همدل', 'فرقی نمی‌کند'];
const TG_CLIN   = ['ساختارهای شخصیت', 'اختلال حاد', 'خودکشی و خودزنی', 'سوگ پیچیده'];

// ستون‌های تازهٔ پروفایل؛ با نام پیدا می‌شوند تا شماره‌ها جابه‌جا نشوند
const TG_PRO_COLS = ['سبک جلسه', 'لحن', 'چک‌لیست بالینی', 'عکس پروفایل',
                     'تاریخ تکمیل پروفایل', 'پیشنهاد این هفته'];

/* شمارهٔ ستون را با نام سرآیند می‌دهد؛ اگر نبود می‌سازد */
var TG_THER_HEAD_X = null;   /* v166.26: سرستون درمانگران یک بار در هر اجرا */
function tgTherCol_(name) {
  const sh = tgSS_().getSheetByName(TG_THER);
  if (!TG_THER_HEAD_X) TG_THER_HEAD_X = sh.getRange(3, 1, 1, Math.max(1, sh.getLastColumn())).getValues()[0];
  const head = TG_THER_HEAD_X, lc = head.length;
  for (var i = 0; i < lc; i++) if (String(head[i]).trim() === name) return i + 1;
  sh.getRange(3, lc + 1).setValue(name).setFontWeight('bold');
  TG_THER_HEAD_X = null;
  return lc + 1;
}

function tgTherRow_(name) {
  const rows = tgTherapistRows_();
  const q = tgNorm_(name);
  for (var i = 0; i < rows.length; i++) if (tgNorm_(rows[i].name) === q) return rows[i].row;
  return 0;
}

/* پروفایل را در هاب می‌نویسد. مستقیم منتشر می‌شود، ولی همه‌چیز در شیت پیداست. */
function tgProfileSave_(name, d) {
  const sh = tgSS_().getSheetByName(TG_THER);
  const row = tgTherRow_(name);
  if (!row) return false;
  if (d.app)    sh.getRange(row, 5).setValue(d.app);
  if (d.topics) sh.getRange(row, 6).setValue(d.topics);
  if (d.bio)    sh.getRange(row, TG_C_ABOUT).setValue(d.bio);
  if (d.style)  sh.getRange(row, tgTherCol_('سبک جلسه')).setValue(d.style);
  if (d.tone)   sh.getRange(row, tgTherCol_('لحن')).setValue(d.tone);
  if (d.clin)   sh.getRange(row, tgTherCol_('چک‌لیست بالینی')).setValue(d.clin);
  if (d.photo)  sh.getRange(row, tgTherCol_('عکس پروفایل')).setValue(d.photo);
  sh.getRange(row, tgTherCol_('تاریخ تکمیل پروفایل')).setValue(tgJDateFull_(new Date(), TG_TZ));
  try { CacheService.getScriptCache().remove('trows'); } catch (e) {}
  return true;
}

/* هرچه از یک درمانگر برای نشان‌دادن به مراجع داریم */
function tgTherProfile_(name) {
  const sh = tgSS_().getSheetByName(TG_THER);
  const row = tgTherRow_(name);
  if (!row) return null;
  const lc = sh.getLastColumn();
  const head = sh.getRange(3, 1, 1, lc).getValues()[0];
  const v = sh.getRange(row, 1, 1, lc).getValues()[0];
  function byName(n) { for (var i = 0; i < lc; i++) if (String(head[i]).trim() === n) return String(v[i] || '').trim(); return ''; }
  return {
    name: String(v[0] || '').trim(),
    gender: String(v[TG_C_GENDER - 1] || '').trim(),
    mode: String(v[TG_C_MODE - 1] || '').trim(),
    approach: String(v[4] || '').trim(),
    topics: String(v[5] || '').trim(),
    ages: String(v[6] || '').trim(),
    couple: String(v[7] || '').trim(),
    about: String(v[TG_C_ABOUT - 1] || '').trim(),
    style: byName('سبک جلسه'),
    tone: byName('لحن'),
    photo: byName('عکس پروفایل')
  };
}

/* متن کارت معرفی. اسم مراجع هیچ‌جا نمی‌آید، فقط دربارهٔ درمانگر. */
function tgTherCardText_(p) {
  if (!p) return '';
  const L = ['👤 <b>' + tgEsc_(p.name) + '</b>'];
  if (p.approach) L.push('رویکرد: ' + tgEsc_(p.approach));
  if (p.topics)   L.push('تمرکز روی: ' + tgEsc_(p.topics));
  if (p.style)    L.push('سبک جلسه: ' + tgEsc_(p.style));
  if (p.tone)     L.push('لحن: ' + tgEsc_(p.tone));
  const bits = [];
  if (p.gender) bits.push(p.gender);
  if (p.mode) bits.push(p.mode);
  if (p.ages) bits.push(p.ages);
  if (bits.length) L.push(bits.join(' · '));
  if (p.about) L.push('\n' + tgEsc_(p.about));
  return L.join('\n');
}

/* ═══════════ فرم تکمیل پروفایل ═══════════
   شش گام. هر گام فهرست بسته دارد جز بیو. حالت در کلید pro نگه داشته می‌شود. */

const T_PRO_DONE_BTN = '✅ تمام شد';
const T_PRO_SKIP     = 'فعلاً رد کن';

function tgProGet_(chat) {
  try { return JSON.parse(tgGetVal_('pro', chat) || '{}'); } catch (e) { return {}; }
}
function tgProSet_(chat, d) { tgSetVal_('pro', chat, JSON.stringify(d)); }

function tgProKb_(items, extra) {
  const kb = [];
  for (var i = 0; i < items.length; i += 2) {
    kb.push(i + 1 < items.length ? [items[i], items[i + 1]] : [items[i]]);
  }
  if (extra) for (var j = 0; j < extra.length; j++) kb.push([extra[j]]);
  return { keyboard: kb, resize_keyboard: true };
}

function tgProStart_(chat, who) {
  tgProSet_(chat, { step: 1, name: who.name, topics: [], clin: [] });
  tgSend_(chat,
    '👤 <b>تکمیل پروفایل</b>\n\n' +
    'این اطلاعات دو جا به کار می‌آید: مچ‌میکینگ دقیق‌تر می‌شود، و وقتی مراجع بخواهد ' +
    'بیشتر دربارهٔ شما بداند، کارت معرفی‌تان چیزی برای گفتن دارد.\n\n' +
    'شش پرسش کوتاه. هر جا خواستید می‌توانید رد کنید.\n\n' +
    '<b>۱ از ۶ — رویکرد اصلی شما کدام است؟</b>',
    tgProKb_(TG_APPROACHES, [T_PRO_SKIP]));
}

function tgProAsk_(chat, d) {
  if (d.step === 2) {
    const left = TG_TOPICS_PRO.filter(function (x) { return d.topics.indexOf(x) < 0; });
    const picked = d.topics.length ? '\n\nتا الان: ' + d.topics.join('، ') : '';
    return tgSend_(chat,
      '<b>۲ از ۶ — روی کدام موضوع‌ها تمرکز دارید؟</b>\n' +
      'هر بار یکی را بزنید. هرچند تا خواستید.' + picked,
      tgProKb_(left, [T_PRO_DONE_BTN]));
  }
  if (d.step === 3) return tgSend_(chat, '<b>۳ از ۶ — در جلسه بیشتر چه‌طور کار می‌کنید؟</b>', tgProKb_(TG_STYLES, [T_PRO_SKIP]));
  if (d.step === 4) return tgSend_(chat, '<b>۴ از ۶ — لحن شما به کدام نزدیک‌تر است؟</b>', tgProKb_(TG_TONES, [T_PRO_SKIP]));
  if (d.step === 5) {
    const left = TG_CLIN.filter(function (x) { return d.clin.indexOf(x) < 0; });
    const picked = d.clin.length ? '\n\nتا الان: ' + d.clin.join('، ') : '';
    return tgSend_(chat,
      '<b>۵ از ۶ — با کدام موارد کار می‌کنید؟</b>\n' +
      'این برای مسیریابی موارد سنگین است، نه ارزیابی شما.' + picked,
      tgProKb_(left, [T_PRO_DONE_BTN]));
  }
  if (d.step === 6) {
    return tgSend_(chat,
      '<b>۶ از ۶ — سه تا پنج جمله دربارهٔ خودتان بنویسید.</b>\n\n' +
      'همین متن را مراجع می‌بیند. ساده و بی‌تعارف بنویسید؛ اینکه چه‌طور کار می‌کنید ' +
      'به مراجع بیشتر کمک می‌کند تا فهرست مدرک‌ها.\n\n' +
      'اگر عکس هم می‌خواهید، بعد از متن یک عکس بفرستید.',
      { keyboard: [[T_PRO_SKIP]], resize_keyboard: true });
  }
  return tgProFinish_(chat, d);
}

function tgProFinish_(chat, d) {
  const save = {
    app: d.app || '', topics: (d.topics || []).join('، '),
    style: d.style || '', tone: d.tone || '',
    clin: (d.clin || []).join('، '), bio: d.bio || '', photo: d.photo || ''
  };
  const ok = tgProfileSave_(d.name, save);
  tgDel_('pro', chat);
  if (!ok) return tgSend_(chat, 'نشد پیدایتان کنم در فهرست درمانگران. به پذیرش بگویید.', tgTherMenu_());
  const p = tgTherProfile_(d.name);
  tgSend_(chat,
    '✅ ثبت شد. کارت شما الان این است:\n\n' + tgTherCardText_(p) + '\n\n' +
    'هر وقت خواستید عوضش کنید، دوباره «👤 پروفایل من» را بزنید.',
    tgTherMenu_());
  tgSend_(chat, 'حالا صفحهٔ سایت‌تان را هم کامل کنیم؟ عکس، روش درمان، آموزش‌ها و رزومه.',
    { inline_keyboard: [[{ text: '🪪 شروع می‌کنم', callback_data: 'pq:go' }]] });
}

/* گام‌به‌گام. اگر پاسخ به فهرست نخورد، همان گام دوباره پرسیده می‌شود. */
function tgProStep_(chat, text, m) {
  const d = tgProGet_(chat);
  if (!d.step) return false;
  const s = String(text || '').trim();

  /* v77: کاربر وسط پرسش‌ها دکمهٔ منو را زده. جواب حساب نمی‌شود و پیام به همان منو می‌رود */
  if (s && s !== T_PRO_SKIP && s !== T_PRO_DONE_BTN && tgIsBtnLike_(s) &&
      TG_APPROACHES.indexOf(s) < 0 && TG_TOPICS_PRO.indexOf(s) < 0 &&
      TG_STYLES.indexOf(s) < 0 && TG_TONES.indexOf(s) < 0 && TG_CLIN.indexOf(s) < 0) {
    tgDel_('pro', chat);
    return false;
  }

  if (m && m.photo && m.photo.length) {
    d.photo = m.photo[m.photo.length - 1].file_id;
    tgProSet_(chat, d);
    if (d.step === 6) { return tgProFinish_(chat, d), true; }
    tgSend_(chat, 'عکس گرفته شد.');
    return true;
  }

  if (s === T_PRO_SKIP) { d.step++; tgProSet_(chat, d); tgProAsk_(chat, d); return true; }

  if (d.step === 1) {
    if (TG_APPROACHES.indexOf(s) < 0) { tgProAsk_(chat, d); return true; }
    d.app = s; d.step = 2; tgProSet_(chat, d); tgProAsk_(chat, d); return true;
  }
  if (d.step === 2) {
    if (s === T_PRO_DONE_BTN) { d.step = 3; tgProSet_(chat, d); tgProAsk_(chat, d); return true; }
    if (TG_TOPICS_PRO.indexOf(s) > -1 && d.topics.indexOf(s) < 0) d.topics.push(s);
    tgProSet_(chat, d); tgProAsk_(chat, d); return true;
  }
  if (d.step === 3) {
    if (TG_STYLES.indexOf(s) < 0) { tgProAsk_(chat, d); return true; }
    d.style = s; d.step = 4; tgProSet_(chat, d); tgProAsk_(chat, d); return true;
  }
  if (d.step === 4) {
    if (TG_TONES.indexOf(s) < 0) { tgProAsk_(chat, d); return true; }
    d.tone = s; d.step = 5; tgProSet_(chat, d); tgProAsk_(chat, d); return true;
  }
  if (d.step === 5) {
    if (s === T_PRO_DONE_BTN) { d.step = 6; tgProSet_(chat, d); tgProAsk_(chat, d); return true; }
    if (TG_CLIN.indexOf(s) > -1 && d.clin.indexOf(s) < 0) d.clin.push(s);
    tgProSet_(chat, d); tgProAsk_(chat, d); return true;
  }
  if (d.step === 6) {
    if (s.length < 20) { tgSend_(chat, 'کمی بیشتر بنویسید، سه تا پنج جمله.'); return true; }
    d.bio = s; tgProSet_(chat, d);
    tgProFinish_(chat, d);
    return true;
  }
  return false;
}

/* ═══════════ گزارش هفتگی درمانگر ═══════════
   پنجشنبه، فقط عدد خودش. هیچ مقایسه‌ای با بقیه. */

/* هر بار که نام درمانگری در فهرست پیشنهاد به مراجع می‌آید، یک واحد */
function tgOfferBump_(names) {
  if (TG_DRY || !names || !names.length) return;
  try {
    const sh = tgSS_().getSheetByName(TG_THER);
    const col = tgTherCol_('پیشنهاد این هفته');
    const seen = {};
    var colVals = null;
    for (var i = 0; i < names.length; i++) {
      const n = names[i];
      if (!n || seen[n]) continue;
      seen[n] = 1;
      const row = tgTherRow_(n);
      if (!row) continue;
      if (!colVals) colVals = sh.getRange(1, col, sh.getLastRow(), 1).getValues();   /* v166.26: ستون یک بار */
      const cur = row <= colVals.length ? colVals[row - 1][0] : 0;
      sh.getRange(row, col).setValue(Number(cur || 0) + 1);
    }
  } catch (e) { tgErr_('tgOfferBump_: ' + e); }
}

function tgTherWeek_(name) {
  const d = { slots: 0, booked: 0, offered: 0, free: 0 };
  const q = tgNorm_(name);
  const now = new Date();
  const w7 = new Date(now.getTime() - 7 * 86400000);
  try {
    const sh = tgSS_().getSheetByName(TG_WEEKLY);
    if (sh && sh.getLastRow() > 3) {
      const v = sh.getRange(4, 1, sh.getLastRow() - 3, 9).getValues();
      for (var i = 0; i < v.length; i++) {
        if (tgNorm_(v[i][0]) !== q) continue;
        if (String(v[i][4] || '').trim() === 'بله') d.slots++;
      }
    }
  } catch (e) {}
  try {
    const sh = tgSS_().getSheetByName(TG_SLOTS);
    if (sh && sh.getLastRow() > 3) {
      const v = sh.getRange(4, 1, sh.getLastRow() - 3, 9).getValues();
      for (var j = 0; j < v.length; j++) {
        if (tgNorm_(v[j][0]) !== q) continue;
        const dt = v[j][1] instanceof Date ? v[j][1] : null;
        if (!dt || dt < w7) continue;
        if (String(v[j][5] || '').indexOf('رزرو') > -1) d.booked++;
      }
    }
  } catch (e) {}
  try {
    const sh = tgSS_().getSheetByName(TG_THER);
    const row = tgTherRow_(name);
    if (row) d.offered = Number(sh.getRange(row, tgTherCol_('پیشنهاد این هفته')).getValue() || 0);
  } catch (e) {}
  d.free = Math.max(0, d.slots - d.booked);
  return d;
}

function tgTherWeekText_(name) {
  const d = tgTherWeek_(name);
  const L = ['📊 <b>هفتهٔ شما</b>  ·  ' + tgJDateFull_(new Date(), TG_TZ), ''];
  L.push('وقت فعالی که اعلام کرده‌اید: ' + tgFa_(d.slots));
  L.push('به مراجع پیشنهاد شدید: ' + tgFa_(d.offered) + ' بار');
  L.push('معارفهٔ رزروشده: ' + tgFa_(d.booked));
  L.push('');
  if (!d.slots) {
    L.push('این هفته وقتی اعلام نکرده‌اید، پس اسمتان به کسی پیشنهاد نشد.');
  } else if (d.offered && !d.booked) {
    L.push('اسمتان دیده شد ولی کسی وقت نگرفت. گاهی به ساعت‌هاست، گاهی به این که ' +
           'کارت معرفی‌تان خالی است. با «👤 پروفایل من» می‌توانید کاملش کنید.');
  } else if (d.booked) {
    L.push('ممنون که وقت گذاشتید.');
  }
  return L.join('\n');
}


      tgApSet_(ap, TG_SCH_APPLY_HEAD.indexOf(dst) + 1, val);
      if (h === 'تاریخ اقدام بعدی' && val) { var days = Math.max(0, Math.round((Date.parse(String(val) + 'T12:00:00Z') - Date.now()) / 86400000)); try { tgApTaskLead_(ap, 'پیگیری متقاضی ' + id, days); } catch (eT) {} }
      if (h === 'مرحله' && TG_APM_COLORS[String(val)]) sh.getRange(r, 1, 1, TG_APM_HEAD.length).setBackground(TG_APM_COLORS[String(val)]);
    }

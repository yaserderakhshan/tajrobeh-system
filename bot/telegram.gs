  try { ppl = tgPeopleList_() || []; } catch (e) {}
  ppl.forEach(function (p) {
    if ((p.roles || []).indexOf('تنخواه') < 0 || String(p.status).trim() === 'غیرفعال') return;
    var t = byName[p.name] || {};
    out.push({ 'نام': p.name, 'نقش': t['نقش'] || '', 'chat_id': String(p.chat || t['chat_id'] || '').split(/[,،;\s]+/)[0], 'یوزرنیم': p.user || t['یوزرنیم'] || '',
      'وضعیت': t['وضعیت'] || 'فعال', 'سقف تنخواه (تومان)': t['سقف تنخواه (تومان)'] || '', 'یادداشت': t['یادداشت'] || '', _chats: String(p.chat || ''), _src: 'role' });
    seen[p.name] = 1;
  });
  tab.forEach(function (o) { if (!seen[String(o['نام']).trim()]) { o._src = 'tab'; out.push(o); } });
  return out;
}
/* ردیف‌های تب «تنخواه‌گردان‌ها» که در «افراد» نقش تنخواه ندارند (فقط نام، برای مالک) */
function tnkRoleAudit_() {
  return tnkPeople_().filter(function (o) { return o._src === 'tab' && o['وضعیت'] !== 'غیرفعال'; }).map(function (o) { return o['نام']; });
}
function tnkCharges_() { return tnkRows_(TNK_T_CHARGE, TNK_H_CHARGE); }
function tnkSpends_()  { return tnkRows_(TNK_T_SPEND,  TNK_H_SPEND); }
function tnkReqs_()    { return tnkRows_(TNK_T_REQ,    TNK_H_REQ); }

function tnkCats_() {
  var rows = tnkRows_(TNK_T_CAT, TNK_H_CAT).filter(function (o) { return o['وضعیت'] !== 'غیرفعال' && o['دسته']; });
  if (rows.length) return rows.map(function (o) { return o['دسته']; });
  return TNK_CATS.map(function (r) { return r[0]; });
}

function tnkOf_(chat) {
  var want = String(chat || ''), rows = tnkPeople_();
  for (var i = 0; i < rows.length; i++) {
    if (rows[i]['وضعیت'] === 'غیرفعال') continue;
    if (rows[i]['chat_id'] === want || (rows[i]._chats && tgChatIn_(rows[i]._chats, want))) return rows[i];
  }
  return null;
}

function tnkByName_(name) {
  var n = String(name || '').trim(), rows = tnkPeople_();
  for (var i = 0; i < rows.length; i++) if (rows[i]['نام'] === n) return rows[i];
  return null;
}

function tnkIsBoss_(chat) {
  if (tnkDry_()) return String(chat) === String(TG_MEM['tnkboss'] || '');
  try {
    var p = tgWhoPerson_(chat, '');
    if (!p) return false;
    var r = p.roles || [];
    return r.indexOf('ناظر') > -1 || r.indexOf('راهبر') > -1;
  } catch (e) { return false; }
}

function tnkBalance_(name) {
  var inn = 0, out = 0;
  tnkCharges_().forEach(function (o) { if (o['تنخواه‌گردان'] === name) inn += tnkAmt_(o['مبلغ (تومان)']); });
  tnkSpends_().forEach(function (o) { if (o['تنخواه‌گردان'] === name && o['وضعیت'] !== 'باطل') out += tnkAmt_(o['مبلغ (تومان)']); });
  return { inn: inn, out: out, bal: inn - out };
}

/* ---------- فیش ---------- */

function tnkSaveFile_(fid, label) {
  if (!fid) return '';
  if (tnkDry_()) return 'drive://' + label;
  try {
    var f = tgTgFile_(fid);
    var blob = f.blob;
    var ext = String(f.path || '').split('.').pop() || 'jpg';
    blob.setName(label + '.' + ext);
    var file = tnkFolder_().createFile(blob);
    try { file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW); } catch (e2) {}
    return file.getUrl();
  } catch (e) { tgErr_('tnkSaveFile_: ' + e); return ''; }
}

/* ---------- خانه ---------- */

function tnkHomeText_(chat) {
  var me = tnkOf_(chat), boss = tnkIsBoss_(chat);
  if (me && !boss) {
    var b = tnkBalance_(me['نام']);
    var t = '💵 <b>تنخواه ' + tnkEsc_(me['نام']) + '</b>\n\n';
    t += 'موجودی: <b>' + tnkToman_(b.bal) + '</b>\n';
    t += 'شارژ تا امروز: ' + tnkToman_(b.inn) + '\n';
    t += 'خرج‌شده: ' + tnkToman_(b.out);
    if (b.bal < 0) t += '\n\n⚠️ موجودی منفی است. درخواست شارژ بدهید.';
    return t;
  }
  var rows = tnkPeople_().filter(function (o) { return o['وضعیت'] !== 'غیرفعال'; });
  var wait = tnkReqs_().filter(function (o) { return o['وضعیت'] === TNK_RST.wait; });
  var s = '💵 <b>تنخواه تجربه</b>\n\n';
  if (!rows.length) s += 'هنوز تنخواه‌گردانی ثبت نشده است.\n';
  for (var i = 0; i < rows.length; i++) {
    var bb = tnkBalance_(rows[i]['نام']);
    s += '· <b>' + tnkEsc_(rows[i]['نام']) + '</b>' + (rows[i]['نقش'] ? ' (' + tnkEsc_(rows[i]['نقش']) + ')' : '') + '\n';
    s += '  موجودی ' + tnkToman_(bb.bal) + ' · شارژ ' + tnkToman_(bb.inn) + ' · خرج ' + tnkToman_(bb.out) + '\n';
  }
  if (wait.length) s += '\n📥 ' + tnkFa_(wait.length) + ' درخواست شارژ در انتظار شما.';
  /* v170.22: ردیف تب بی نقش «تنخواه» در «افراد» */
  var legacy = tnkRoleAudit_();
  if (legacy.length) s += '\n\n⚠️ نقش «تنخواه» را در تب «افراد» به این‌ها بدهید (فعلاً فقط از تب «تنخواه‌گردان‌ها» شناخته می‌شوند): ' + legacy.map(tnkEsc_).join('، ');
  return s;
}

function tnkHomeKb_(chat) {
  var me = tnkOf_(chat), boss = tnkIsBoss_(chat), kb = [];
  if (me) {
    kb.push([{ text: '💸 ثبت هزینه', callback_data: 'tnk:sp' }]);
    kb.push([{ text: '📥 درخواست شارژ', callback_data: 'tnk:rq' }, { text: '🧾 هزینه‌های من', callback_data: 'tnk:my' }]);
  }
  if (boss) {
    kb.push([{ text: '➕ شارژ تنخواه', callback_data: 'tnk:ch' }]);
    var wait = tnkReqs_().filter(function (o) { return o['وضعیت'] === TNK_RST.wait; });
    if (wait.length) kb.push([{ text: '📥 درخواست‌های شارژ (' + tnkFa_(wait.length) + ')', callback_data: 'tnk:rl' }]);
  }
  kb.push([{ text: '📊 گزارش ماه', callback_data: 'tnk:rp' }]);
  return { inline_keyboard: kb };
}

function tnkHome_(chat) {
  if (!tnkOf_(chat) && !tnkIsBoss_(chat)) return tgSend_(chat, 'تنخواه برای تنخواه‌گردان‌های تجربه است. اگر باید به شما تنخواه بدهیم، به یاسر بگویید.');
  return tgSend_(chat, tnkHomeText_(chat), tnkHomeKb_(chat));
}

/* ---------- حالت ---------- */

function tnkState_(chat) {
  try { return JSON.parse(tgGetVal_('tnk', chat) || 'null'); } catch (e) { return null; }
}
function tnkPut_(chat, d) { tgSetVal_('tnk', chat, JSON.stringify(d)); }
function tnkEnd_(chat)    { tgDel_('tnk', chat); }

/* ---------- ثبت هزینه ---------- */

function tnkSpStart_(chat) {
  var me = tnkOf_(chat);
  if (!me) return null;
  tnkPut_(chat, { f: 'sp', s: 'amt' });
  return tgSend_(chat, '💸 <b>ثبت هزینه</b>\n\nمبلغ را به تومان بنویسید. مثال: ۴۵۰۰۰۰ یا «۴۵۰ هزار».',
    { inline_keyboard: [[{ text: '↩️ انصراف', callback_data: 'tnk:x' }]] });
}

function tnkCatKb_() {
  var cats = tnkCats_(), kb = [], row = [];
  for (var i = 0; i < cats.length; i++) {
    row.push({ text: cats[i], callback_data: 'tnk:cat:' + i });
    if (row.length === 2) { kb.push(row); row = []; }
  }
  if (row.length) kb.push(row);
  kb.push([{ text: '↩️ انصراف', callback_data: 'tnk:x' }]);
  return { inline_keyboard: kb };
}

function tnkSpAmt_(chat, text) {
  var d = tnkState_(chat);
  var v = tnkAmt_(text);
  if (!v) return tgSend_(chat, 'عدد را نگرفتم. فقط مبلغ را به تومان بنویسید.');
  d.amt = v; d.s = 'cat'; tnkPut_(chat, d);
  return tgSend_(chat, 'مبلغ: <b>' + tnkToman_(v) + '</b>\n\nاین خرج در کدام دسته است؟', tnkCatKb_());
}

function tnkSpCat_(chat, idx) {
  var d = tnkState_(chat);
  if (!d) return null;
  var cats = tnkCats_();
  d.cat = cats[Number(idx)] || 'متفرقه'; d.s = 'why'; tnkPut_(chat, d);
  return tgSend_(chat, 'دسته: <b>' + tnkEsc_(d.cat) + '</b>\n\nبابت چی بود؟ در یک خط بنویسید تا بعداً با یک نگاه معلوم باشد.',
    { inline_keyboard: [[{ text: '↩️ انصراف', callback_data: 'tnk:x' }]] });
}

function tnkSpWhy_(chat, text) {
  var d = tnkState_(chat);
  d.why = String(text || '').trim(); d.s = 'file'; tnkPut_(chat, d);
  return tgSend_(chat, 'ثبت شد.\n\nاگر فیش یا فاکتور دارید همین‌جا عکسش را بفرستید. اگر ندارید دکمهٔ زیر را بزنید.',
    { inline_keyboard: [[{ text: '📄 فیش ندارم', callback_data: 'tnk:nof' }], [{ text: '↩️ انصراف', callback_data: 'tnk:x' }]] });
}

function tnkSpSave_(chat, fid) {
  var d = tnkState_(chat), me = tnkOf_(chat);
  if (!d || !me) return null;
  tnkEnd_(chat);
  var now = tnkNow_();
  var code = tnkNextCode_(TNK_T_SPEND, TNK_H_SPEND, 'خ');
  var link = fid ? tnkSaveFile_(fid, 'فیش ' + code) : '';
  tnkTab_(TNK_T_SPEND, TNK_H_SPEND).append([code, now.date, now.ym, me['نام'], d.cat, d.why,
    d.amt, link, 'ثبت شد', '']);
  var b = tnkBalance_(me['نام']);
  tgSend_(chat, '✅ <b>ثبت شد · ' + tnkEsc_(code) + '</b>\n' +
    tnkToman_(d.amt) + ' · ' + tnkEsc_(d.cat) + '\n' + tnkEsc_(d.why) +
    (link ? '\n📄 فیش ذخیره شد.' : '\n📄 بدون فیش') +
    '\n\nموجودی تنخواه شما: <b>' + tnkToman_(b.bal) + '</b>', tnkHomeKb_(chat));
  if (b.bal < 0) tgSend_(chat, '⚠️ موجودی تنخواه منفی شد. از «درخواست شارژ» به یاسر خبر بدهید.');
  return null;
}

/* ---------- درخواست شارژ ---------- */

function tnkRqStart_(chat) {
  var me = tnkOf_(chat);
  if (!me) return null;
  tnkPut_(chat, { f: 'rq', s: 'amt' });
  return tgSend_(chat, '📥 <b>درخواست شارژ تنخواه</b>\n\nچقدر لازم دارید؟ مبلغ را به تومان بنویسید.',
    { inline_keyboard: [[{ text: '↩️ انصراف', callback_data: 'tnk:x' }]] });
}

function tnkRqAmt_(chat, text) {
  var d = tnkState_(chat), v = tnkAmt_(text);
  if (!v) return tgSend_(chat, 'عدد را نگرفتم. فقط مبلغ را به تومان بنویسید.');
  d.amt = v; d.s = 'why'; tnkPut_(chat, d);
  return tgSend_(chat, 'مبلغ: <b>' + tnkToman_(v) + '</b>\n\nبابت چی لازم دارید؟ کوتاه بنویسید.',
    { inline_keyboard: [[{ text: '↩️ انصراف', callback_data: 'tnk:x' }]] });
}

function tnkBossChats_() {
  if (tnkDry_()) return [String(TG_MEM['tnkboss'] || '')].filter(String);
  var out = [];
  try {
    var list = tgPeopleList_();
    for (var i = 0; i < list.length; i++) {
      var r = String(list[i].roles || '');
      if ((r.indexOf('ناظر') > -1 || r.indexOf('راهبر') > -1) && list[i].chat) out.push(String(list[i].chat).split(/[,،;\s]+/)[0]);
    }
  } catch (e) {}
  return out;
}

function tnkTellBoss_(text, kb) {
  var list = tnkBossChats_();
  for (var i = 0; i < list.length; i++) { try { tgSend_(Number(list[i]), text, kb || null); } catch (e) {} }
  return list.length;
}

function tnkRqSave_(chat, text) {
  var d = tnkState_(chat), me = tnkOf_(chat);
  if (!d || !me) return null;
  tnkEnd_(chat);
  var now = tnkNow_();
  var code = tnkNextCode_(TNK_T_REQ, TNK_H_REQ, 'د');
  tnkTab_(TNK_T_REQ, TNK_H_REQ).append([code, now.date, me['نام'], String(chat), d.amt,
    String(text || '').trim(), TNK_RST.wait, '', '']);
  tgSend_(chat, '✅ درخواست شما ثبت شد و برای یاسر رفت. نتیجه را همین‌جا می‌گویم.', tnkHomeKb_(chat));
  var b = tnkBalance_(me['نام']);
  var card = '📥 <b>درخواست شارژ تنخواه · ' + tnkEsc_(code) + '</b>\n' +
    tnkEsc_(me['نام']) + ' · <b>' + tnkToman_(d.amt) + '</b>\n' +
    'بابت: ' + tnkEsc_(String(text || '')) + '\n\n' +
    'موجودی فعلی‌اش: ' + tnkToman_(b.bal);
  tnkTellBoss_(card, { inline_keyboard: [
    [{ text: '✅ شارژ می‌کنم', callback_data: 'tnk:ra:' + code }],
    [{ text: '⛔ فعلاً نه', callback_data: 'tnk:rn:' + code }]
  ] });
  return null;
}

function tnkReqByCode_(code) {
  var rows = tnkReqs_(), k = String(code || '').trim();
  for (var i = 0; i < rows.length; i++) if (rows[i]['کد'] === k) return rows[i];
  return null;
}

function tnkReqList_(chat) {
  if (!tnkIsBoss_(chat)) return null;
  var wait = tnkReqs_().filter(function (o) { return o['وضعیت'] === TNK_RST.wait; });
  if (!wait.length) return tgSend_(chat, 'درخواست شارژ بازی نیست.', tnkHomeKb_(chat));
  for (var i = 0; i < wait.length && i < 8; i++) {
    var r = wait[i];
    tgSend_(chat, '📥 <b>' + tnkEsc_(r['کد']) + '</b> · ' + tnkEsc_(r['تنخواه‌گردان']) + '\n' +
      '<b>' + tnkToman_(r['مبلغ درخواستی (تومان)']) + '</b>\nبابت: ' + tnkEsc_(r['بابت چی']) + '\n' + tnkEsc_(r['تاریخ']),
      { inline_keyboard: [[{ text: '✅ شارژ می‌کنم', callback_data: 'tnk:ra:' + r['کد'] }],
                          [{ text: '⛔ فعلاً نه', callback_data: 'tnk:rn:' + r['کد'] }]] });
  }
  return null;
}

function tnkReqNo_(chat, code) {
  if (!tnkIsBoss_(chat)) return null;
  var r = tnkReqByCode_(code);
  if (!r) return null;
  var now = tnkNow_();
  tnkTab_(TNK_T_REQ, TNK_H_REQ).set(r._row, TNK_H_REQ.indexOf('وضعیت') + 1, TNK_RST.no);
  tnkTab_(TNK_T_REQ, TNK_H_REQ).set(r._row, TNK_H_REQ.indexOf('تاریخ پاسخ') + 1, now.date);
  tgSend_(chat, 'ثبت شد.');
  if (r['chat_id']) tgSend_(Number(r['chat_id']), 'دربارهٔ درخواست شارژ ' + tnkEsc_(r['کد']) + ': فعلاً شارژ نمی‌شود. اگر فوری است با یاسر هماهنگ کنید.');
  return null;
}

/* ---------- شارژ ---------- */

function tnkChStart_(chat, who, reqCode) {
  if (!tnkIsBoss_(chat)) return null;
  var people = tnkPeople_().filter(function (o) { return o['وضعیت'] !== 'غیرفعال'; });
  if (!who) {
    if (!people.length) return tgSend_(chat, 'هنوز تنخواه‌گردانی ثبت نشده است. اول در شیت «تنخواه‌گردان‌ها» اضافه کنید.');
    var kb = people.map(function (o) { return [{ text: o['نام'], callback_data: 'tnk:cw:' + o['نام'] }]; });
    kb.push([{ text: '↩️ انصراف', callback_data: 'tnk:x' }]);
    return tgSend_(chat, '➕ <b>شارژ تنخواه</b>\n\nتنخواه کدام‌یک را شارژ می‌کنید؟', { inline_keyboard: kb });
  }
  tnkPut_(chat, { f: 'ch', s: 'amt', who: who, req: reqCode || '' });
  return tgSend_(chat, 'شارژ تنخواه <b>' + tnkEsc_(who) + '</b>\n\nمبلغ را به تومان بنویسید.',
    { inline_keyboard: [[{ text: '↩️ انصراف', callback_data: 'tnk:x' }]] });
}

function tnkChAmt_(chat, text) {
  var d = tnkState_(chat), v = tnkAmt_(text);
  if (!v) return tgSend_(chat, 'عدد را نگرفتم. فقط مبلغ را به تومان بنویسید.');
  d.amt = v; d.s = 'how'; tnkPut_(chat, d);
  return tgSend_(chat, 'مبلغ: <b>' + tnkToman_(v) + '</b>\n\nچطور پرداخت شد؟', { inline_keyboard: [
    [{ text: 'کارت به کارت', callback_data: 'tnk:cm:کارت به کارت' }, { text: 'نقدی', callback_data: 'tnk:cm:نقدی' }],
    [{ text: 'انتقال بانکی', callback_data: 'tnk:cm:انتقال بانکی' }, { text: 'روش دیگر', callback_data: 'tnk:cm:روش دیگر' }],
    [{ text: '↩️ انصراف', callback_data: 'tnk:x' }]
  ] });
}

function tnkChHow_(chat, how) {
  var d = tnkState_(chat);
  if (!d) return null;
  d.how = how; d.s = 'file'; tnkPut_(chat, d);
  return tgSend_(chat, 'حالا فیش شارژ را بفرستید تا در درایو بایگانی شود. اگر فیش ندارید دکمهٔ زیر را بزنید.',
    { inline_keyboard: [[{ text: '📄 بدون فیش ثبت کن', callback_data: 'tnk:nof' }], [{ text: '↩️ انصراف', callback_data: 'tnk:x' }]] });
}

function tnkChSave_(chat, fid) {
  var d = tnkState_(chat);
  if (!d) return null;
  tnkEnd_(chat);
  var now = tnkNow_();
  var code = tnkNextCode_(TNK_T_CHARGE, TNK_H_CHARGE, 'ش');
  var link = fid ? tnkSaveFile_(fid, 'فیش شارژ ' + code) : '';
  var by = '';
  try { var p = tgWhoPerson_(chat, ''); by = (p && p.name) || ''; } catch (e) {}
  tnkTab_(TNK_T_CHARGE, TNK_H_CHARGE).append([code, now.date, now.ym, d.who, d.amt, d.how || '', link, by || 'یاسر', '']);
  if (d.req) {
    var r = tnkReqByCode_(d.req);
    if (r) {
      tnkTab_(TNK_T_REQ, TNK_H_REQ).set(r._row, TNK_H_REQ.indexOf('وضعیت') + 1, TNK_RST.ok);
      tnkTab_(TNK_T_REQ, TNK_H_REQ).set(r._row, TNK_H_REQ.indexOf('پاسخ') + 1, code);
      tnkTab_(TNK_T_REQ, TNK_H_REQ).set(r._row, TNK_H_REQ.indexOf('تاریخ پاسخ') + 1, now.date);
    }
  }
  var b = tnkBalance_(d.who);
  tgSend_(chat, '✅ <b>شارژ ثبت شد · ' + tnkEsc_(code) + '</b>\n' + tnkEsc_(d.who) + ' · ' + tnkToman_(d.amt) +
    (link ? '\n📄 فیش در درایو بایگانی شد.' : '') + '\n\nموجودی تنخواه‌اش: <b>' + tnkToman_(b.bal) + '</b>', tnkHomeKb_(chat));
  var who = tnkByName_(d.who);
  if (who && who['chat_id']) tgSend_(Number(who['chat_id']),
    '💵 <b>تنخواه شما شارژ شد</b>\n' + tnkToman_(d.amt) + (d.how ? ' · ' + tnkEsc_(d.how) : '') +
    '\n\nموجودی تازه: <b>' + tnkToman_(b.bal) + '</b>');
  return null;
}

/* ---------- گزارش ---------- */

function tnkMyText_(chat) {
  var me = tnkOf_(chat);
  if (!me) return 'شما تنخواه‌گردان نیستید.';
  var list = tnkSpends_().filter(function (o) { return o['تنخواه‌گردان'] === me['نام']; }).slice(-10).reverse();
  if (!list.length) return 'هنوز هزینه‌ای ثبت نکرده‌اید.';
  var t = '🧾 <b>ده هزینهٔ آخر شما</b>\n\n';
  for (var i = 0; i < list.length; i++) {
    t += '· ' + tnkEsc_(list[i]['تاریخ']) + ' · ' + tnkToman_(list[i]['مبلغ (تومان)']) + '\n' +
      '  ' + tnkEsc_(list[i]['دسته']) + ': ' + tnkEsc_(list[i]['بابت چی']) + '\n';
  }
  return t;
}

function tnkReportText_(chat, ym) {
  var month = ym || tnkNow_().ym;
  var me = tnkOf_(chat), boss = tnkIsBoss_(chat);
  var names = (me && !boss) ? [me['نام']] : tnkPeople_().map(function (o) { return o['نام']; });
  var t = '📊 <b>تنخواه · ' + tnkYmLabel_(month) + '</b>\n\n';
  var any = false;
  for (var n = 0; n < names.length; n++) {
    var name = names[n];
    var sp = tnkSpends_().filter(function (o) { return o['تنخواه‌گردان'] === name && o['ماه'] === month && o['وضعیت'] !== 'باطل'; });
    var ch = tnkCharges_().filter(function (o) { return o['تنخواه‌گردان'] === name && o['ماه'] === month; });
    if (!sp.length && !ch.length) continue;
    any = true;
    var sumSp = 0, sumCh = 0, byCat = {};
    sp.forEach(function (o) { var v = tnkAmt_(o['مبلغ (تومان)']); sumSp += v; byCat[o['دسته']] = (byCat[o['دسته']] || 0) + v; });
    ch.forEach(function (o) { sumCh += tnkAmt_(o['مبلغ (تومان)']); });
    var bal = tnkBalance_(name);
    t += '<b>' + tnkEsc_(name) + '</b>\n';
    t += 'شارژ این ماه: ' + tnkToman_(sumCh) + '\n';
    t += 'خرج این ماه: ' + tnkToman_(sumSp) + ' در ' + tnkFa_(sp.length) + ' قلم\n';
    t += 'موجودی الان: ' + tnkToman_(bal.bal) + '\n';
    var cats = Object.keys(byCat).sort(function (a, b) { return byCat[b] - byCat[a]; });
    if (cats.length) {
      t += 'بابت چی:\n';
      for (var i = 0; i < cats.length && i < 6; i++) t += '  · ' + tnkEsc_(cats[i]) + ': ' + tnkToman_(byCat[cats[i]]) + '\n';
    }
    t += '\n';
  }
  if (!any) t += 'این ماه هنوز چیزی ثبت نشده است.';
  return t;
}

function tnkSumRefresh() {
  if (tnkDry_()) return 'dry';
  var t = tnkTab_(TNK_T_SUM, TNK_H_SUM);
  var have = {};
  t.rows().forEach(function (r, i) { have[String(r[0]) + '|' + String(r[1])] = i + 2; });
  var months = {}, names = {};
  var sps = tnkSpends_(), chs = tnkCharges_();
  sps.forEach(function (o) { if (o['ماه']) { months[o['ماه']] = 1; names[o['تنخواه‌گردان']] = 1; } });
  chs.forEach(function (o) { if (o['ماه']) { months[o['ماه']] = 1; names[o['تنخواه‌گردان']] = 1; } });
  var n = 0;
  Object.keys(months).sort().forEach(function (ym) {
    Object.keys(names).forEach(function (name) {
      var sp = sps.filter(function (o) { return o['تنخواه‌گردان'] === name && o['ماه'] === ym && o['وضعیت'] !== 'باطل'; });
      var ch = chs.filter(function (o) { return o['تنخواه‌گردان'] === name && o['ماه'] === ym; });
      if (!sp.length && !ch.length) return;
      var sumSp = 0, sumCh = 0, byCat = {};
      sp.forEach(function (o) { var v = tnkAmt_(o['مبلغ (تومان)']); sumSp += v; byCat[o['دسته']] = (byCat[o['دسته']] || 0) + v; });
      ch.forEach(function (o) { sumCh += tnkAmt_(o['مبلغ (تومان)']); });
      var top = Object.keys(byCat).sort(function (a, b) { return byCat[b] - byCat[a]; })[0] || '';
      var row = [ym, name, sumCh, sumSp, sumCh - sumSp, sp.length, top];
      var at = have[ym + '|' + name];
      if (at) { for (var c = 0; c < row.length; c++) t.set(at, c + 1, row[c]); }
      else t.append(row);
      n++;
    });
  });
  return 'خلاصهٔ ماهانه: ' + n + ' سطر';
}


    list: top.map(function (c) { return { t: c.t, why: c.why, slots: c.slots }; }),
    others: rest.map(function (c) { return { t: { n: c.t.n, d: c.t.d, sp: c.t.sp, sl: c.t.sl, g: c.t.g }, slots: c.slots.slice(0, 1) }; })
  };
}

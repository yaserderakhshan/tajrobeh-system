/* تب «کدهای مدرسه» (مخفی): منبع همهٔ فهرست‌های کشویی. هر بار از ثابت‌های کد و تب‌های کمپین، دوره و افراد ساخته می‌شود. */
function tgSchCodesRebuild() {
  if (TG_DRY) return 'dry';
  var ss = tgSchSS_();
  var sh = ss.getSheetByName(TG_SCH_CODES_TAB);
  if (!sh) sh = ss.insertSheet(TG_SCH_CODES_TAB);
  sh.setRightToLeft(true);
  sh.clear();
  var cols = tgSchCodeCols_(), h = 1;
  for (var i = 0; i < cols.length; i++) h = Math.max(h, cols[i][1].length);
  var grid = [];
  for (var r = 0; r <= h; r++) { var line = []; for (var c = 0; c < cols.length; c++) line.push(r === 0 ? cols[c][0] : (cols[c][1][r - 1] || '')); grid.push(line); }
  sh.getRange(1, 1, grid.length, cols.length).setValues(grid);
  sh.getRange(1, 1, 1, cols.length).setFontWeight('bold').setBackground('#f9f2f2');
  sh.getRange(grid.length + 2, 1).setValue('منبع فهرست‌های کشویی «لیدهای مدرسه». دستی عوض نکنید؛ tgSchCodesRebuild از کد و تب‌های کمپین، دوره و افراد می‌سازد.').setFontColor('#8a8d95');
  sh.setFrozenRows(1);
  try { sh.hideSheet(); } catch (e) {}
  return TG_SCH_CODES_TAB + ': ' + cols.length + ' فهرست';
}
/* فهرست کشویی روی هر ستون انتخابی «لیدهای مدرسه»، از تب کدها. مقدار خارج از فهرست رد نمی‌شود (بات گاهی چیز دیگری می‌نویسد) */
function tgSchValidations_() {
  if (TG_DRY) return 'dry';
  var ss = tgSchSS_();
  var sh = tgSchSheet_(TG_SCH_T_REQ, TG_SCH_REQ_HEAD);
  var codes = ss.getSheetByName(TG_SCH_CODES_TAB);
  if (!codes) return 'تب کدها نیست';
  var cols = tgSchCodeCols_(), n = Math.max(sh.getMaxRows() - 1, 1), done = 0;
  var dateIdx = -1;
  for (var i = 0; i < cols.length; i++) {
    if (cols[i][0] === 'تاریخ') { dateIdx = i; continue; }
    var col = cols[i][2];
    if (!col) continue;
    var rng = codes.getRange(2, i + 1, Math.max(cols[i][1].length, 1), 1);
    var rule = SpreadsheetApp.newDataValidation().requireValueInRange(rng, true).setAllowInvalid(true)
      .setHelpText('از فهرست انتخاب کنید').build();
    sh.getRange(2, col, n, 1).setDataValidation(rule);
    done++;
  }
  if (dateIdx > -1) {
    var rngD = codes.getRange(2, dateIdx + 1, 1, 1);
    var ruleD = SpreadsheetApp.newDataValidation().requireValueInRange(rngD, true).setAllowInvalid(true)
      .setHelpText('«امروز» را انتخاب کنید تا تاریخ شمسی امروز بنشیند، یا تاریخ را مثل «۵ مهر ۱۴۰۵» بنویسید').build();
    for (var dc in TG_SCH_DATE_COLS) { sh.getRange(2, Number(dc), n, 1).setDataValidation(ruleD); done++; }
  }
  return done + ' ستون فهرست کشویی';
}
/* رنگ سطرها مثل «لیدها»ی هاب پذیرش: بسته خاکستری، ثبت‌نام قطعی سبز، مشروط نارنجی، نزدیک ثبت‌نام کهربایی، منتظر تماس اول زرد */
function tgSchColorRules_() {
  if (TG_DRY) return 'dry';
  var sh = tgSchSheet_(TG_SCH_T_REQ, TG_SCH_REQ_HEAD);
  var n = Math.max(sh.getMaxRows() - 1, 1), W = TG_SCH_REQ_HEAD.length;
  var all = sh.getRange(2, 1, n, W);
  var q = function (arr) { return '{' + arr.map(function (s) { return '"' + s + '"'; }).join(';') + '}'; };
  var open = 'ISNUMBER(MATCH($M2,' + q([TG_SCH_ST_OPEN, TG_SCH_ST_PRE, TG_SCH_ST_COND]) + ',0))';
  var early = 'ISNUMBER(MATCH($R2,' + q(TG_SCH_STAGES.slice(0, TG_SCH_SG.call)) + ',0))';
  var late = 'ISNUMBER(MATCH($R2,' + q(TG_SCH_STAGES.slice(TG_SCH_SG.pre, TG_SCH_SG.done)) + ',0))';
  var B = SpreadsheetApp.newConditionalFormatRule;
  var rules = [
    B().whenFormulaSatisfied('=$M2="' + TG_SCH_ST_DONE + '"').setBackground('#e6f4ea').setRanges([all]).build(),
    B().whenFormulaSatisfied('=AND($A2<>"",NOT(' + open + '))').setBackground('#f1f3f4').setFontColor('#9aa0a6').setRanges([all]).build(),
    B().whenFormulaSatisfied('=$M2="' + TG_SCH_ST_COND + '"').setBackground('#fdebd0').setRanges([all]).build(),
    B().whenFormulaSatisfied('=AND(' + open + ',' + late + ')').setBackground('#fff3d6').setRanges([all]).build(),
    B().whenFormulaSatisfied('=AND($A2<>"",' + open + ',$Z2<>"",$T2="",' + early + ')').setBackground('#fffbe6').setRanges([all]).build()
  ];
  sh.setConditionalFormatRules(rules);
  return rules.length + ' قاعدهٔ رنگ';
}
/* محافظت هشداری روی ستون‌هایی که بات می‌نویسد (شناسه، کد لید، اعلان بات، کد کمپین را دست نزنند) */
var TG_SCH_PROTECT_COLS = [1, 17, 25];
function tgSchProtect_() {

    tgSend_(chat, act === 'no' ? '🚫 ثبت شد: ' + tgEsc_(v.name) + ' روی سایت نمی‌رود. اگر پاسخ تازه بدهد دوباره در صف می‌آید.' :
                                 '✅ بازبینی ' + tgEsc_(v.name) + ' ثبت شد.');
    return tgPrNext_(chat, r.row);
  }
  if (act === 'po') return tgPrPhotoOff_(chat, r);
  if (act === 'pm') return tgPrPhotoMsg_(chat, r);
  if (act === 'nx') return tgPrNext_(chat, r.row);
  if (act === 'pk') { tgPqPut_(v.id, { site_photo: v.site_photo === 'فعلی' ? '' : 'فعلی' }); return tgPrShow_(chat, r.row, msgId); }
  if (act === 'ph') return tgPrPhoto_(chat, r, 0, '');
  if (/^(cu|cd|cl|cr|zi|zo)$/.test(act)) return tgPrPhoto_(chat, r, msgId, act);
  if (act === 'en' || act === 'es' || act === 'ec' || act === 'eu' || act === 'eT' || act === 'msg') {
    var f = { en: 'site_name', es: 'site_sp', ec: 'site_city', eu: 'site_slug', eT: 'pub_title', msg: '_msg' }[act];
    tgSetVal_('pr', chat, JSON.stringify({ row: r.row, h: a[2], f: f }));
    var ask = {
      site_name: 'نام را همان‌طور که روی کارت بیاید بنویس (با نیم‌فاصلهٔ درست، مثل «مهدی‌زاده»).',
      site_sp: 'خط رویکرد زیر نام را بنویس؛ کوتاه، مثل «روانکاوی روابط ابژه» یا «طرحواره‌درمانی و CBT».',
      site_city: 'شهر یا کشور را بنویس.',
      pub_title: 'عنوان حرفه‌ای روی صفحه را بنویس؛ مثل «روان‌شناس بالینی · روانکاو». لینک و شماره پذیرفته نمی‌شود.',
      site_slug: 'آدرس انگلیسی صفحه را بنویس؛ فقط حروف کوچک انگلیسی و خط فاصله، مثل darya-navidi. آدرس قبلی خودش به آدرس تازه می‌رود.',
      _msg: 'پیامت را برای ' + tgEsc_(v.name) + ' بنویس. عیناً از طرف تیم تجربه می‌رود، با دکمه‌ای که پاسخ‌هایش را از اول مرور و اصلاح کند.'
    }[f];
    return tgSend_(chat, '✏️ ' + ask + '\nبرای انصراف: /cancel');
  }
  if (act === 'et' || act === 't') {
    var p = tgPrPlan_(r);
    var cur = String(p.tags || '').split(/\s+/).filter(String);
    if (act === 't') {
      var tg = TG_PR_TAGS[tagI];
      if (tg) { var at = cur.indexOf(tg[0]); if (at > -1) cur.splice(at, 1); else cur.push(tg[0]); }
      tgPqPut_(v.id, { site_tags: cur.join(' ') || ' ' });
    }
    var s = ':' + r.row + ':' + a[2], rows = [], row = [];
    TG_PR_TAGS.forEach(function (t, i) {
      row.push({ text: (cur.indexOf(t[0]) > -1 ? '✓ ' : '') + t[1], callback_data: 'pr:t:' + i + s });
      if (row.length === 3) { rows.push(row); row = []; }
    });
    if (row.length) rows.push(row);
    rows.push([{ text: '✅ همین‌ها', callback_data: 'pr:sh' + s }]);
    var kb = { inline_keyboard: rows };
    if (act === 't' && !TG_DRY) {
      var rr = tgApi_('editMessageReplyMarkup', { chat_id: chat, message_id: msgId, reply_markup: kb });
      if (rr && rr.getResponseCode() === 200) return rr;
    }
    return tgSend_(chat, '🏷 تگ‌های کارت ' + tgEsc_(p.name) + ' (فیلترهای صفحهٔ اصلی). هر کدام را بزن تا روشن یا خاموش شود:', kb);
  }
  return tgPrShow_(chat, r.row);
}

function tgPrNext_(chat, afterRow) {
  var q = tgPrQueue_().filter(function (x) { return x.row !== Number(afterRow); });
  if (!q.length) return tgSend_(chat, '✅ صف بازبینی خالی شد.');
  var nx = q.filter(function (x) { return x.row > Number(afterRow); })[0] || q[0];
  return tgPrShow_(chat, nx.row);
}

/* پیام متنی ناظر: دکمهٔ صف، /review، یا جوابِ یک ویرایش. true یعنی مصرف شد. */
function tgPrMaybe_(chat, m) {
  var text = String((m && m.text) || '').trim();
  var st = null;
  if (tgGetVal_('pr', chat)) { try { st = JSON.parse(tgGetVal_('pr', chat)); } catch (e) { st = null; } }
  if (!st && text !== TG_PR_BTN && text !== '/review') return false;
  if (!tgPrOk_(chat)) { if (st) tgDel_('pr', chat); return false; }
  if (!st) { tgPrList_(chat); return true; }
  if (!text) return false;
  tgDel_('pr', chat);
  if (text === '/cancel' || text === 'انصراف') { tgSend_(chat, 'باشد، چیزی عوض نشد.'); return true; }
  if (text.indexOf('/') === 0 || text === TG_PR_BTN) return false;
  var r = tgPrRow_(st.row);
  if (!r || tgPrH_(r.v.id) !== st.h) { tgSend_(chat, 'این کارت کهنه شده. «' + TG_PR_BTN + '» را دوباره بزن.'); return true; }
  if (st.f === '_msg') {
    var to = String(r.v.chat || '').split(/[,،;\s]+/)[0];
    if (!to) { tgSend_(chat, 'این نفر به بات وصل نیست؛ پیام نرفت.'); return true; }
    var res = tgSend_(to, '💬 <b>پیام تیم تجربه دربارهٔ صفحهٔ شما</b>\n\n' + tgEsc_(text),
                      { inline_keyboard: [[{ text: '✏️ مرور و اصلاح پاسخ‌ها', callback_data: 'pq:re' }], [{ text: '🪪 ادامهٔ پرسش‌ها', callback_data: 'pq:go' }]] });
    var okd = TG_DRY || (res && res.getResponseCode() === 200);
    tgSend_(chat, okd ? '✅ پیام برای ' + tgEsc_(r.v.name) + ' رفت.' : '❌ پیام نرسید (احتمالاً بات را بسته).');
    return true;
  }
  if (st.f === 'site_slug') {
    var sl = text.toLowerCase().trim().replace(/^https?:\/\/[^\/]+\/team\//, '').replace(/[\s_]+/g, '-').replace(/\/+$/, '');
    if (!/^[a-z0-9]+(-[a-z0-9]+)*$/.test(sl) || sl.length < 3 || sl.length > 60) {
      tgSetVal_('pr', chat, JSON.stringify(st));
      tgSend_(chat, 'فقط حروف کوچک انگلیسی، عدد و خط فاصله؛ مثل darya-navidi. دوباره بنویس یا /cancel.');
      return true;
    }
    tgPqPut_(r.v.id, { site_slug: sl });
    tgPrShow_(chat, r.row);
    return true;
  }
  var val = text.replace(/\s*[—–]\s*/g, ' · ').slice(0, 120);
  if (['site_name', 'site_sp', 'site_city', 'pub_title'].indexOf(st.f) > -1 && tgOkBad_(val)) {   /* v170.23.6 */
    tgSetVal_('pr', chat, JSON.stringify(st));
    tgSend_(chat, 'این ' + tgOkBad_(val) + '؛ اینجا فقط متن کوتاه. دوباره بنویس یا /cancel.');
    return true;
  }
  var o = {}; o[st.f] = val;
  tgPqPut_(r.v.id, o);
  tgPrShow_(chat, r.row);
  return true;
}


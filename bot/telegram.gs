/* ═══════════ تجربه پارتنرز: نمای اتاق‌ها و ساعت‌های فضا (v132) ═══════════
   پارتنر باید همان چیزی را ببیند که برای فضای خودش تعریف شده است:
   اتاق‌ها با روز و ساعت باز، و ساعت‌هایی که درمانگرها در آن فضا دارند.
   پذیرش همین نما را برای همهٔ فضاها دارد.
   هیچ نام مراجعی در این نما نمی‌آید؛ فقط اتاق، روز، ساعت و نام درمانگر. */

function tgPaSpTab_(which) {
  return (which === 'room')
    ? tgInpTab_(TG_INP_ROOMS, TG_INP_RHEAD)
    : tgInpTab_(TG_INP_HOURS, TG_INP_HHEAD);
}

function tgPaSpHead_(which) {
  return (which === 'room') ? TG_INP_RHEAD : TG_INP_HHEAD;
}

function tgPaSpRows_(which, code) {
  var head = tgPaSpHead_(which), rows = [];
  try { rows = tgPaSpTab_(which).rows() || []; } catch (e) { return []; }
  var out = [], c = String(code || '').trim();
  for (var i = 0; i < rows.length; i++) {
    var o = { _row: i + 2 };
    for (var j = 0; j < head.length; j++) {
      var v = rows[i][j];
      o[head[j]] = (v === undefined || v === null) ? '' : String(v).trim();
    }
    if (!o[head[0]]) continue;
    if (c && o[head[0]] !== c) continue;
    out.push(o);
  }
  return out;
}

function tgPaSpan_(o) {
  var a = String(o['از ساعت'] || '').trim(), b = String(o['تا ساعت'] || '').trim();
  if (!a && !b) return 'ساعت نامشخص';
  return tgFa_(a || '؟') + ' تا ' + tgFa_(b || '؟');
}

function tgPaRoomLine_(o) {
  var t = '· <b>اتاق ' + tgEsc_(o['اتاق'] || '') + '</b>';
  if (o['برای']) t += ' · ' + tgEsc_(o['برای']);
  t += '\n  ' + tgEsc_(o['روزهای باز'] || 'روزها ثبت نشده') + ' · ' + tgPaSpan_(o);
  if (o['وضعیت'] && o['وضعیت'] !== 'فعال') t += ' · ' + tgEsc_(o['وضعیت']);
  if (String(o['یادداشت'] || '').indexOf('نیاز به تأیید') > -1) t += '\n  ⏳ منتظر تأیید شماست';
  return t + '\n';
}

function tgPaDayNo_(d) {
  var days = (typeof TG_INP_DAYS !== 'undefined' && TG_INP_DAYS && TG_INP_DAYS.length)
    ? TG_INP_DAYS : ['شنبه', 'یکشنبه', 'دوشنبه', 'سه‌شنبه', 'چهارشنبه', 'پنجشنبه', 'جمعه'];
  var i = days.indexOf(String(d || '').trim());
  return i < 0 ? 99 : i;
}

function tgPaHourNo_(v) {
  var n = Number(String(v || '').replace(/[^0-9.]/g, ''));
  return isNaN(n) ? 99 : n;
}

function tgPaSpNote_() {
  return 'اگر چیزی از این فهرست درست نیست یا اتاق و ساعتی جا مانده، همین‌جا بنویسید تا پذیرش اصلاح کند.';
}

function tgPaSpaceText_(code, title) {
  var rooms = tgPaSpRows_('room', code), hours = tgPaSpRows_('hour', code);
  var t = '🏠 <b>' + tgEsc_(title || code) + '</b>\n\n';

  t += '<b>اتاق‌ها</b>\n';
  if (!rooms.length) t += 'هنوز اتاقی برای این فضا ثبت نشده است.\n';
  else for (var i = 0; i < rooms.length; i++) t += tgPaRoomLine_(rooms[i]);

  t += '\n<b>ساعت درمانگرها</b>\n';
  if (!hours.length) return t + 'هنوز ساعتی برای درمانگرها ثبت نشده است.\n\n' + tgPaSpNote_();

  hours.sort(function (a, b) {
    var d = tgPaDayNo_(a['روز']) - tgPaDayNo_(b['روز']);
    if (d) return d;
    return tgPaHourNo_(a['از ساعت']) - tgPaHourNo_(b['از ساعت']);
  });

  var last = '\u0000';
  for (var k = 0; k < hours.length; k++) {
    var h = hours[k], day = h['روز'] || 'روز نامشخص';
    if (day !== last) { t += '\n<u>' + tgEsc_(day) + '</u>\n'; last = day; }
    t += '· ' + tgEsc_(h['درمانگر'] || '') + ' · ' + tgPaSpan_(h);
    if (h['اتاق']) t += ' · اتاق ' + tgEsc_(h['اتاق']);
    var acc = String(h['مراجع تازه می‌پذیرد؟'] || '');
    if (acc && (acc.indexOf('ندارد') > -1 || acc.indexOf('نمی') > -1 || acc.indexOf('خیر') > -1)) t += ' · مراجع تازه نمی‌پذیرد';
    if (h['تأیید درمانگر']) t += ' ✅';
    t += '\n';
  }
  return t + '\n' + tgPaSpNote_();
}

function tgPaSpaceSum_(code) {
  var rooms = tgPaSpRows_('room', code), hours = tgPaSpRows_('hour', code);
  var ther = {}, n = 0;
  for (var i = 0; i < hours.length; i++) {
    var d = String(hours[i]['درمانگر'] || '').trim();
    if (d && !ther[d]) { ther[d] = 1; n++; }
  }
  return { rooms: rooms.length, hours: hours.length, therapists: n };
}

function tgPaSpace_(chat) {
  var o = tgPaOf_(chat);
  if (!o) return tgSend_(chat, 'این نما برای پارتنرهای حضوری تجربه است. اگر فضای شما پارتنر تجربه است و اینجا شناخته نشده‌اید، به پذیرش بگویید.');
  var code = String(o['شناسه مکان'] || '');
  return tgSend_(chat, tgPaSpaceText_(code, o['نام نمایشی'] || code), {
    inline_keyboard: [
      [{ text: '✍️ اصلاح اتاق‌ها و ساعت‌ها', callback_data: 'pa:sy' }],
      [{ text: '↩️ میز پارتنر', callback_data: 'pa:dk' }]
    ]
  });
}

function tgPaSpaceOne_(chat, code) {
  var o = tgPaByCode_(code);
  var title = o ? (o['نام نمایشی'] || code) : code;
  return tgSend_(chat, tgPaSpaceText_(code, title), {
    inline_keyboard: [[{ text: '↩️ تجربه پارتنرز', callback_data: 'pa:hb' }]]
  });
}

function tgPaSpaceKb_() {
  var rows = tgPaRows_(), kb = [];
  for (var i = 0; i < rows.length; i++) {
    var c = String(rows[i]['شناسه مکان'] || '').trim();
    if (!c) continue;
    var lbl = String(rows[i]['شهر'] || '').trim();
    var nm = String(rows[i]['نام نمایشی'] || '').trim();
    kb.push([{ text: '🏠 ' + (lbl ? lbl + ' · ' : '') + (nm || c), callback_data: 'pa:sp:' + c }]);
  }
  return { inline_keyboard: kb };
}


/* ═══════════ حضوری در مچ‌میکینگ و تگ درمانگر (v133) ═══════════
   درمانگری که در «ساعت‌های حضوری» ردیف دارد تگ حضوری می‌گیرد و در شهر خودش
   امتیاز مچ‌میکینگ بیشتری می‌گیرد. همین تگ به ما می‌گوید چه کسی را می‌شود
   به فضای پارتنر شهر محل زندگی‌اش دعوت کرد. */

var TG_INP_MAP_CACHE = null;

function tgInpMapReset_() { TG_INP_MAP_CACHE = null; return true; }

function tgInpTherMap_() {
  if (TG_INP_MAP_CACHE) return TG_INP_MAP_CACHE;
  var map = {};
  try {
    var hrs = tgInpTab_(TG_INP_HOURS, TG_INP_HHEAD).rows() || [];
    var plc = tgInpTab_(TG_INP_PLACES, TG_INP_PHEAD).rows() || [];
    var pinfo = {};
    for (var p = 0; p < plc.length; p++) {
      var code = String(plc[p][0] || '').trim();
      if (!code) continue;
      pinfo[code] = {
        city: String(plc[p][1] || '').trim(),
        place: String(plc[p][2] || '').trim(),
        kind: String(plc[p][3] || '').trim(),
        status: String(plc[p][6] || '').trim()
      };
    }
    for (var i = 0; i < hrs.length; i++) {
      var pc = String(hrs[i][0] || '').trim(), nm = String(hrs[i][1] || '').trim();
      if (!pc || !nm) continue;
      var inf = pinfo[pc] || { city: '', place: pc, kind: '', status: '' };
      if (inf.status && inf.status !== 'فعال') continue;
      var k = tgNorm_(nm);
      if (!map[k]) map[k] = [];
      var seen = false;
      for (var z = 0; z < map[k].length; z++) if (map[k][z].code === pc) seen = true;
      if (!seen) map[k].push({ code: pc, city: inf.city, place: inf.place, kind: inf.kind });
    }
  } catch (e) { }
  TG_INP_MAP_CACHE = map;
  return map;
}

function tgInpOfTher_(name) {
  var n = String(name || '').trim();
  if (!n) return [];
  return tgInpTherMap_()[tgNorm_(n)] || [];
}

function tgInpTag_(name) {
  var l = tgInpOfTher_(name);
  if (!l.length) return '';
  var t = ['inperson'], seen = {};
  for (var i = 0; i < l.length; i++) {
    if (l[i].kind === 'پارتنر' && t.indexOf('partner-space') < 0) t.push('partner-space');
    var c = l[i].code;
    if (c && !seen[c]) { seen[c] = 1; t.push('inperson-' + c); }
  }
  return t.join(' ');
}

function tgPrInpTag_(name, tags) {
  var add = tgInpTag_(name);
  if (!add) return String(tags || '');
  var cur = String(tags || '').trim();
  if (!cur) return add;
  var have = cur.split(/\s+/), out = have.slice();
  var want = add.split(' ');
  for (var i = 0; i < want.length; i++) if (have.indexOf(want[i]) < 0) out.push(want[i]);
  return out.join(' ');
}

function tgInpBadge_(name) {
  var l = tgInpOfTher_(name);
  if (!l.length) return '';
  var cities = [], seen = {};
  for (var i = 0; i < l.length; i++) {
    var c = l[i].city || l[i].place;
    if (c && !seen[c]) { seen[c] = 1; cities.push(c); }
  }
  if (!cities.length) return '';
  return '📍 حضوری هم می‌بیند در ' + cities.join(' و ');
}

function tgInpCityCodes_(city) {
  var out = [], c = String(city || '').trim();
  if (!c) return out;
  try {
    var plc = tgInpTab_(TG_INP_PLACES, TG_INP_PHEAD).rows() || [];
    for (var i = 0; i < plc.length; i++) {
      if (String(plc[i][1] || '').trim() !== c) continue;
      if (String(plc[i][6] || '').trim() && String(plc[i][6]).trim() !== 'فعال') continue;
      out.push(String(plc[i][0] || '').trim());
    }
  } catch (e) { }
  return out;
}

function tgInpMatchBoost_(t, q) {
  var name = String((t && (t.n || t.d)) || '');
  var pl = tgInpOfTher_(name);
  if (!q || !q.inp) return { s: pl.length ? 0.25 : 0, why: '' };
  if (!pl.length) return { s: -8, why: '' };
  var city = String(q.inpCity || '').trim(), code = String(q.inpCode || '').trim();
  for (var i = 0; i < pl.length; i++) {
    if (code && pl[i].code === code) return { s: 6, why: 'حضوری در ' + (pl[i].place || pl[i].city) };
    if (!code && (!city || pl[i].city === city)) return { s: 6, why: 'حضوری در ' + (pl[i].city || pl[i].place) };
  }
  return { s: -4, why: '' };
}


function tgInpTagTests() {
  var out = [], pass = 0, fail = 0;
  var ok = function (t, c) { if (c) { pass++; } else { fail++; out.push('❌ ' + t); } };
  var old = TG_DRY; TG_DRY = true;
  TG_OUTBOX = []; TG_MEM = {}; tgInpMapReset_();

  var P = tgInpTab_(TG_INP_PLACES, TG_INP_PHEAD);
  P.append(['t-karaj', 'کرج', 'فضای آزمایشی کرج', 'پارتنر', '', '', 'فعال', '1', '']);
  P.append(['t-tehran', 'تهران', 'کلینیک آزمایشی', 'کلینیک تجربه', '', '', 'فعال', '2', '']);
  P.append(['t-off', 'یزد', 'فضای غیرفعال', 'پارتنر', '', '', 'بررسی', '3', '']);
  var H = tgInpTab_(TG_INP_HOURS, TG_INP_HHEAD);
  H.append(['t-karaj', 'سارا آزمون', 'شنبه', '9', '13', '۱', 'دارد', '', '', '', '']);
  H.append(['t-karaj', 'سارا آزمون', 'یکشنبه', '9', '13', '۱', 'دارد', '', '', '', '']);
  H.append(['t-tehran', 'رضا آزمون', 'دوشنبه', '10', '14', '۲', 'دارد', '', '', '', '']);
  H.append(['t-off', 'نگار آزمون', 'سه‌شنبه', '10', '14', '۱', 'دارد', '', '', '', '']);
  tgInpMapReset_();

  ok('درمانگر حضوری پیدا می‌شود', tgInpOfTher_('سارا آزمون').length === 1);
  ok('ردیف تکراری دوبار شمرده نمی‌شود', tgInpOfTher_('سارا آزمون').length === 1);
  ok('درمانگر بدون ردیف حضوری خالی است', tgInpOfTher_('کسی که نیست').length === 0);
  ok('مکان غیرفعال شمرده نمی‌شود', tgInpOfTher_('نگار آزمون').length === 0);
  ok('تگ حضوری ساخته می‌شود', tgInpTag_('سارا آزمون').indexOf('inperson') > -1);
  ok('تگ فضای پارتنر می‌آید', tgInpTag_('سارا آزمون').indexOf('partner-space') > -1);
  ok('کلینیک خود تجربه تگ پارتنر نمی‌گیرد', tgInpTag_('رضا آزمون').indexOf('partner-space') < 0);
  ok('تگ کد مکان دارد', tgInpTag_('سارا آزمون').indexOf('inperson-t-karaj') > -1);
  ok('تگ برای غیرحضوری خالی است', tgInpTag_('کسی که نیست') === '');
  ok('تگ به تگ‌های قبلی اضافه می‌شود', tgPrInpTag_('سارا آزمون', 'eft cbt').indexOf('eft') === 0);
  ok('تگ تکراری دوباره اضافه نمی‌شود', tgPrInpTag_('سارا آزمون', 'inperson').split('inperson ').length <= 2);
  ok('نشان حضوری شهر را می‌گوید', tgInpBadge_('سارا آزمون').indexOf('کرج') > -1);
  ok('نشان خط تیرهٔ وسط جمله ندارد', tgInpBadge_('سارا آزمون').indexOf('—') < 0);
  ok('کدهای شهر پیدا می‌شود', tgInpCityCodes_('کرج').indexOf('t-karaj') > -1);
  ok('شهر بدون مکان خالی است', tgInpCityCodes_('جایی که نیست').length === 0);

  var q = { topic: '', inp: true, inpCity: 'کرج' };
  ok('حضوری همان شهر امتیاز می‌گیرد', tgInpMatchBoost_({ n: 'سارا آزمون' }, q).s === 6);
  ok('غیرحضوری وقتی حضوری خواسته‌اند جریمه می‌شود', tgInpMatchBoost_({ n: 'کسی که نیست' }, q).s < 0);
  ok('حضوری شهر دیگر امتیاز کامل نمی‌گیرد', tgInpMatchBoost_({ n: 'رضا آزمون' }, q).s < 6);
  ok('بدون درخواست حضوری جریمه‌ای نیست', tgInpMatchBoost_({ n: 'کسی که نیست' }, { topic: '' }).s === 0);
  ok('مچ‌میکینگ حضوری را می‌بیند', tgMatchScore_({ n: 'سارا آزمون', tr: 2 }, q).s > tgMatchScore_({ n: 'کسی که نیست', tr: 2 }, q).s);
  ok('دلیل حضوری در توضیح می‌آید', tgMatchScore_({ n: 'سارا آزمون', tr: 2 }, q).why.join(' ').indexOf('حضوری') > -1);

  TG_DRY = old; TG_MEM = {}; tgInpMapReset_();
  Logger.log('تگ حضوری: ' + pass + ' قبول · ' + fail + ' مردود' + (fail ? '\n' + out.join('\n') : ''));
  return { pass: pass, fail: fail, text: out.join('\n') };
}


/* ═══════════ پیام همگانی از طرف بات (v134) ═══════════
   یاسر (ناظر یا راهبر) می‌تواند از بات به یک گروه از آدم‌های تجربه پیام بفرستد:
   درمانگرها، تیم، دانشجوها، استادها، سوپروایزرها، پارتنرها یا همه.
   مرجع گیرنده‌ها تب «افراد» است. هیچ نام مراجعی اینجا نمی‌آید.
   هر ارسال پیش از رفتن پیش‌نمایش و تأیید دارد و در تب «پیام‌های همگانی» ثبت می‌شود. */

var TG_BC_BTN  = '📣 پیام همگانی';
var TG_BC_ON   = false;
var TG_BC_TAB  = 'پیام‌های همگانی';
var TG_BC_HEAD = ['کد', 'زمان', 'فرستنده', 'گیرندگان', 'تعداد', 'متن', 'رسید', 'نرسید', 'وضعیت'];
var TG_BC_MAX  = 400;
var TG_BC_FOOT = '\n\nاین پیام از طرف مرکز تجربه زندگی فرستاده شده است.';

var TG_BC_GROUPS = [
  { k: 'ther', t: '🧠 درمانگرها',    roles: ['درمانگر'] },
  { k: 'team', t: '🧑‍💼 تیم تجربه',  roles: ['پذیرش', 'مدرسه', 'مالی', 'سازمانی', 'سوشال', 'سردبیر', 'نویسنده', 'راهبر', 'ناظر', 'مصاحبه‌گر', 'تنخواه'] },
  { k: 'stud', t: '🎓 دانشجوها',      roles: ['دانشجو'] },
  { k: 'teac', t: '🧑‍🏫 استادها',    roles: ['استاد'] },
  { k: 'supv', t: '🧭 سوپروایزرها',   roles: ['سوپروایزر'] },
  { k: 'part', t: '🏢 پارتنرها',      roles: ['پارتنر'] },
  { k: 'psyc', t: '💊 روان‌پزشک‌ها',  roles: ['روان‌پزشکی'] },
  { k: 'all',  t: '👥 همهٔ افراد تجربه', roles: [] }
];

function tgBcGroup_(k) {
  for (var i = 0; i < TG_BC_GROUPS.length; i++) if (TG_BC_GROUPS[i].k === k) return TG_BC_GROUPS[i];
  return null;
}

function tgBcTab_() { return tgInpTab_(TG_BC_TAB, TG_BC_HEAD); }

function tgBcNextCode_() {
  var rows = [];
  try { rows = tgBcTab_().rows() || []; } catch (e) { }
  var n = 0;
  for (var i = 0; i < rows.length; i++) {
    var m = String(rows[i][0] || '').match(/(\d+)/);
    if (m && Number(m[1]) > n) n = Number(m[1]);
  }
  var s = String(n + 1);
  while (s.length < 3) s = '0' + s;
  return 'پ-' + s;
}

function tgBcTargets_(k) {
  var g = tgBcGroup_(k);
  if (!g) return [];
  var list = [];
  try { list = tgPeopleList_() || []; } catch (e) { return []; }
  var out = [], seen = {};
  for (var i = 0; i < list.length; i++) {
    var p = list[i];
    if (!p || String(p.status || '').trim() === 'غیرفعال') continue;
    var chat = String(p.chat || '').trim();
    if (!chat) continue;
    if (g.roles.length) {
      var hit = false;
      for (var j = 0; j < g.roles.length; j++) if ((p.roles || []).indexOf(g.roles[j]) > -1) hit = true;
      if (!hit) continue;
    }
    if (seen[chat]) continue;
    seen[chat] = 1;
    out.push({ chat: chat, name: String(p.name || '').trim() });
  }
  return out;
}

function tgBcCounts_() {
  var out = [];
  for (var i = 0; i < TG_BC_GROUPS.length; i++) {
    var g = TG_BC_GROUPS[i];
    out.push({ k: g.k, t: g.t, n: tgBcTargets_(g.k).length });
  }
  return out;
}

function tgBcKb_() {
  var kb = [], c = tgBcCounts_();
  for (var i = 0; i < c.length; i++) {
    kb.push([{ text: c[i].t + ' (' + tgFa_(c[i].n) + ')', callback_data: 'bc:g:' + c[i].k }]);
  }
  kb.push([{ text: '↩️ بستن', callback_data: 'bc:x' }]);
  return { inline_keyboard: kb };
}

function tgBcStart_(chat) {
  return tgSend_(chat,
    '📣 <b>پیام همگانی</b>\n\nگروه گیرنده را انتخاب کنید. بعد متن را می‌نویسید و پیش از ارسال یک بار می‌بینیدش.\n\n' +
    'مرجع گیرنده‌ها تب «افراد» است؛ هرکس وضعیتش فعال باشد و به بات وصل باشد پیام را می‌گیرد.',
    tgBcKb_());
}

function tgBcPick_(chat, k) {
  var g = tgBcGroup_(k);
  if (!g) return null;
  var n = tgBcTargets_(k).length;
  if (!n) return tgSend_(chat, 'در این گروه کسی که به بات وصل باشد پیدا نشد.', tgBcKb_());
  tgSetVal_('bcg', chat, k);
  tgDel_('bct', chat);
  return tgSend_(chat,
    'گروه: <b>' + tgEsc_(g.t) + '</b> · ' + tgFa_(n) + ' نفر\n\nحالا متن پیام را بنویسید. می‌توانید از <b>پررنگ</b> و <i>کج</i> استفاده کنید.',
    { inline_keyboard: [[{ text: '↩️ انصراف', callback_data: 'bc:x' }]] });
}

function tgBcWaiting_(chat) { return !!tgGetVal_('bcg', chat); }

function tgBcDraft_(chat, text) {
  var k = tgGetVal_('bcg', chat);
  if (!k) return null;
  var body = String(text || '').trim();
  if (body.length < 5) return tgSend_(chat, 'متن خیلی کوتاه است. کمی کامل‌ترش کنید.');
  tgSetVal_('bct', chat, body);
  var g = tgBcGroup_(k), n = tgBcTargets_(k).length;
  return tgSend_(chat,
    '👀 <b>پیش‌نمایش</b>\n\n' + body + TG_BC_FOOT +
    '\n\n<b>گیرنده:</b> ' + tgEsc_(g.t) + ' · ' + tgFa_(n) + ' نفر',
    { inline_keyboard: [
      [{ text: '✅ بفرست', callback_data: 'bc:go' }],
      [{ text: '🧪 اول برای خودم بفرست', callback_data: 'bc:me' }],
      [{ text: '✏️ متن را عوض کن', callback_data: 'bc:g:' + k }],
      [{ text: '↩️ انصراف', callback_data: 'bc:x' }]
    ] });
}

function tgBcMe_(chat) {
  var body = tgGetVal_('bct', chat);
  if (!body) return null;
  return tgSend_(chat, body + TG_BC_FOOT);
}

function tgBcCancel_(chat) {
  tgDel_('bcg', chat); tgDel_('bct', chat);
  return tgSend_(chat, 'باشد، چیزی فرستاده نشد.');
}

function tgBcSend_(chat, name) {
  var k = tgGetVal_('bcg', chat), body = tgGetVal_('bct', chat);
  if (!k || !body) return null;
  var g = tgBcGroup_(k), list = tgBcTargets_(k);
  if (list.length > TG_BC_MAX) list = list.slice(0, TG_BC_MAX);
  var ok = 0, bad = 0, badNames = [];
  var msg = body + TG_BC_FOOT;
  /* v166.27 (گزارش ۳.۳): پیش‌نویس پیش از ارسال پاک می‌شود تا لمس دوبارهٔ «بفرست» دوباره نفرستد؛
     «نرسید» از پاسخ واقعی تلگرام شمرده می‌شود (tgSend_ خطا پرتاب نمی‌کند) */
  tgDel_('bcg', chat); tgDel_('bct', chat);
  for (var i = 0; i < list.length; i++) {
    var res = null;
    try { res = tgSend_(list[i].chat, msg); } catch (e) {}
    if (TG_DRY || (res && res.getResponseCode && res.getResponseCode() === 200)) ok++;
    else { bad++; if (badNames.length < 12) badNames.push(list[i].name || list[i].chat); }
  }
  var code = tgBcNextCode_();
  var when = '';
  try { if (typeof tgJDateFull_ === 'function') when = tgJDateFull_(new Date()); } catch (eW) { when = ''; }
  try {
    tgBcTab_().append([code, when, String(name || chat),
      g.t, tgFa_(list.length), body.slice(0, 900), tgFa_(ok), tgFa_(bad),
      bad ? 'با خطا' : 'رفت']);
  } catch (e2) { }
  var rep = '✅ <b>فرستاده شد</b>\n\nکد: ' + code + '\nگروه: ' + tgEsc_(g.t) +
    '\nرسید: ' + tgFa_(ok) + ' نفر';
  if (bad) rep += '\nنرسید: ' + tgFa_(bad) + ' نفر (' + tgEsc_(badNames.join('، ')) + ')';
  return tgSend_(chat, rep);
}

/* v166.8: فقط ناظر و راهبر (همان قاعدهٔ منو و مینی‌اپ). پیش از این هر کسی با کال‌بک ساختگی bc:g و bc:go می‌توانست پیام همگانی بفرستد. */
function tgBcAllowed_(chat, uname) {
  if (TG_DRY) return !!TG_BC_ON;
  if (tnkIsBoss_(chat)) return true;
  try { var r = tgMyRoles_(chat, uname) || []; return r.indexOf('ناظر') > -1 || r.indexOf('راهبر') > -1; } catch (e) { return false; }
}

function tgBcCb_(cq, rest, chat, name, uname) {
  var p = String(rest || '').split(':'), a = p[0];
  if (a !== 'x' && !tgBcAllowed_(chat, uname)) return null;
  if (a === 'open') return tgBcStart_(chat);
  if (a === 'g') return tgBcPick_(chat, p[1]);
  if (a === 'go') return tgBcSend_(chat, name);
  if (a === 'me') return tgBcMe_(chat);
  if (a === 'x') return tgBcCancel_(chat);
  return null;
}

function tgBcRoute_(m, chat, name, uname) {
  var t = String((m && m.text) || '').trim();
  /* v166.27 (گزارش ۳.۳): این مسیر پیش از tgMyRoles_ اجرا می‌شود و TG_BC_ON هنوز تنظیم نشده بود؛ دکمه در بات کار نمی‌کرد */
  if (t === TG_BC_BTN) { if (!tgBcAllowed_(chat, uname)) return false; tgBcStart_(chat); return true; }
  if (tgBcWaiting_(chat) && t && t.charAt(0) !== '/') { tgBcDraft_(chat, t); return true; }
  return false;
}


    });
    try { tgCpReconTick_(now); } catch (eR) { tgErr_('tgCpReconTick_: ' + eR); }
  tgCpDigest_(now, log);
    if (log.length || Number(Utilities.formatDate(now, TG_TZ, 'm')) % 15 < 5) log.push('سایت: ' + tgCpPush_('تیک'));
    try { var thp = tgThPush_(); if (thp && thp !== 'بی‌تغییر') log.push('فهرست همکاران: ' + thp); } catch (eTh) { tgErr_('tgThPush_', eTh); }
  } catch (err) {
    tgErr_('tgCpTick: ' + err + '\n' + (err && err.stack));
    log.push('خطا: ' + err);
  } finally { if (lock) lock.releaseLock(); }
  return log.join(' · ');
  } finally { tgRunStat_('tgCpTick', rs0); }

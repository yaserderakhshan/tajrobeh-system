/* ============================================================
   نقش‌های چندگانه و شناختن اسم درمانگر
   ------------------------------------------------------------
   یک نفر می‌تواند هم درمانگر باشد هم پذیرش هم ناظر. تا پیش از این
   اولین نقشی که پیدا می‌شد بقیه را می‌بلعید. حالا خودش انتخاب می‌کند
   و هر وقت خواست با «تغییر نقش» عوض می‌کند.
   ============================================================ */

const T_NOT_THER     = 'من درمانگر نیستم';
const T_SIGN_CONFIRM = 'اگر شما همین همکار هستید، روی نامتان بزنید تا حسابتان وصل شود.';
const T_ROLE_PICK    = 'شما چند نقش دارید. الان با کدام کار می‌کنید؟\n\nهر وقت خواستید عوض کنید، دکمهٔ «🔁 تغییر نقش» پایین صفحه است.';

const T_ROLE_SWITCH = '🔁 تغییر نقش';
var TG_MULTI = false;   // در هر اجرا برای همان کاربر ست می‌شود

/* ردیف آخر کیبورد: اگر کاربر چند نقش دارد، دکمهٔ تغییر نقش */
function tgRoleRow_() {
  var rows = (TG_MULTI ? [[T_ROLE_SWITCH]] : []).concat(typeof vkMenuRow_ === 'function' ? vkMenuRow_() : []);
  if (typeof tnkMenuRow_ === 'function') rows = rows.concat(tnkMenuRow_());
  if (typeof tgBcMenuRow_ === 'function') rows = rows.concat(tgBcMenuRow_());
  if (typeof TG_PA_ON !== 'undefined' && TG_PA_ON) rows = rows.concat([[{ text: TG_PA_BTN }]]);
  if (typeof ptMenuRow_ === 'function' && typeof PT_CUR !== 'undefined' && PT_CUR && TG_PA_ON) rows = rows.concat(ptMenuRow_(PT_CUR));
  return rows;
}

const TG_ROLE_BTN = {
  'مراجع': '🙋 خودم، به‌عنوان مراجع',
  'مدرسه': '🎓 مدرسه', 'روان‌پزشکی': '💊 روان‌پزشکی',
  'سازمانی': '🏢 سازمانی', 'مالی': '💳 مالی', 'درمانگر': '🩺 درمانگر', 'پذیرش': '📥 پذیرش', 'ناظر': '📊 ناظر', 'سوشال': '📣 سوشال',
  'دانشجو': '🎓 دانشجو', 'استاد': '📚 استاد', 'سوپروایزر': '🧑‍🏫 سوپروایزر', 'سردبیر': '✒️ سردبیر مجله', 'راهبر': '🧭 راهبر رودمپ', 'مصاحبه‌گر': '🎤 مصاحبه‌گر',
  'منتور': '🌱 منتور', 'نمایندهٔ کلاس': '🗣 نمایندهٔ کلاس',
  /* v170.22: کسی که فقط نقش تنخواه دارد در حلقهٔ انتخاب نقش گیر می‌کرد (برچسب و شاخه نداشت) */
  'تنخواه': '💵 تنخواه‌گردان' };

/* نقش‌هایی که واقعاً مسیر کاری دارند. */
/* فهرست افراد با کش پنج‌دقیقه‌ای — تب «افراد» مرجع همهٔ نقش‌هاست جز درمانگر */
function tgPeopleList_() {
  if (TG_DRY) return TG_MEM['people'] || [];
  const hit = tgCacheGet_('plist');
  if (hit) { try { return JSON.parse(hit); } catch (e) {} }
  var out = [];
  try {
    out = tgPeopleRows_();
    CacheService.getScriptCache().put('plist', JSON.stringify(out), 900);
  } catch (e) { tgErr_('tgPeopleList_: ' + e); }
  return out;
}

/* این چت به کدام سطر تب «افراد» می‌خورد؟ اگر با یوزرنیم پیدا شد، chat_id را جا می‌اندازد */
function tgWhoPerson_(chat, username) {
  if (TG_DRY) return TG_MEM['person'] || null;
  try {
    const u = String(username || '').replace(/^@/, '').toLowerCase();
    const list = tgPeopleList_().filter(function (p) { return String(p.status).trim() !== 'غیرفعال'; });
    const m = tgIdMatch_(list, chat, u, tgChatIn_);   /* v170.9 (امنیت) */
    if (m) {
      if (m.bind) {
        try {
          tgPersonSet_(m.row.row, { addChat: String(chat) }, 'بات', { why: 'اتصال از یوزرنیم' });
          m.row.chat = String(chat);
          CacheService.getScriptCache().remove('plist');
          CacheService.getScriptCache().remove('wlist');
        } catch (e) {}
      }
      return m.row;
    }
  } catch (e) { tgErr_('tgWhoPerson_: ' + e); }
  // v81: درمانگرِ وصل‌به‌بات که هنوز سطری در «افراد» ندارد، همین‌جا ثبت و وصل می‌شود
  try {
    if (typeof tgPersonLinkFromTher_ === 'function' && !tgFlag_('nobrp', chat)) {
      var bp = tgPersonLinkFromTher_(chat);
      if (bp) return bp;
      tgSetFlag_('nobrp', chat, 3600);
    }
  } catch (e2) { tgErr_('tgWhoPerson_ bridge: ' + e2); }
  return null;
}

function tgMyRoles_(chat, uname) {
  if (TG_DRY) { const r = TG_MEM['roles'] || []; TG_MULTI = r.length > 1; return r; }
  const out = [];
  var known = null;
  try {
    known = tgWhoPerson_(chat, uname);
    if (known) for (var i = 0; i < known.roles.length; i++) {
      const r = known.roles[i];
      if (r && TG_ROLES.indexOf(r) > -1 && out.indexOf(r) < 0) out.push(r);
    }
  } catch (e) {}
  // تب «افراد» مرجع است؛ تب پذیرش فقط برای کسی که هنوز در افراد نیست
  try { if (!known) { var dk0 = tgWhoDesk_(chat, uname); if (dk0 && String(dk0.role || '').indexOf('پذیرش') > -1) out.push('پذیرش'); } } catch (e) {}
  try { if (out.indexOf('درمانگر') < 0 && tgWhoTherapist_(chat)) out.push('درمانگر'); } catch (e) {}
  // هر آدمی، هر نقشی هم که داشته باشد، خودش هم می‌تواند مراجع باشد
  if (out.indexOf('مراجع') < 0) out.push('مراجع');
  try { if (typeof TNK_CUR !== 'undefined') TNK_CUR = (out.indexOf('تنخواه') > -1 || out.indexOf('ناظر') > -1 || out.indexOf('راهبر') > -1) ? String(chat) : ''; } catch (eT) {}
  // v137: تیم فضا (مدیر، پذیرش) و درمانگر «فقط همین فضا» از partners.gs نقش «پارتنر» می‌گیرند
  try { if (typeof ptIsPartnerChat_ === 'function' && out.indexOf('پارتنر') < 0 && ptIsPartnerChat_(chat)) out.splice(out.length - 1, 0, 'پارتنر'); } catch (eP0) {}
  try { if (typeof PT_CUR !== 'undefined') PT_CUR = String(chat); } catch (eP1) {}
  try { if (typeof TG_PA_ON !== 'undefined') TG_PA_ON = out.indexOf('پارتنر') > -1 || out.indexOf('ناظر') > -1 || out.indexOf('راهبر') > -1 || out.indexOf('پذیرش') > -1; } catch (eP) {}  // v142: ناظر و پذیرش هم «🏢 میز پارتنر» (نمای همهٔ فضاها) دارند
  try { if (typeof TG_BC_ON !== 'undefined') TG_BC_ON = (out.indexOf('ناظر') > -1 || out.indexOf('راهبر') > -1); } catch (eB) {}
  TG_MULTI = out.length > 1;
  return out;
}

/* ---------- «نقشم را نمی‌بینم»: وصل‌کردن حساب از روی نام کامل ---------- */
const T_ROLE_CLAIM_BTN   = '🪪 نقش دیگری دارم';
const T_ROLE_CLAIM_ASK   = 'نام و نام خانوادگی‌تان را همان‌طور که در تجربه ثبت شده بنویسید.' + '\n' + '\n' + 'از روی همین نام شما را در فهرست تجربه پیدا می‌کنیم و همهٔ نقش‌هایتان را وصل می‌کنیم.';
const T_ROLE_CLAIM_SHORT = 'کمی کامل‌تر بنویسید، نام و نام خانوادگی.';
const T_ROLE_CLAIM_NONE  = 'با این نام چیزی در فهرست تجربه پیدا نکردم.' + '\n' + '\n' + 'اگر دانشجو، استاد یا سوپروایزر مدرسه‌اید، «📝 عضویت در مدرسه» را بزنید تا درخواستتان مستقیم برود روی میز مسئول مدرسه.' + '\n' + '\n' + 'اگر نقش دیگری دارید به پذیرش بگویید تا همان روز درستش کند: {R}';
const T_ROLE_CLAIM_TAKEN = 'این نام از قبل به حساب تلگرام دیگری وصل شده. اگر مطمئنید خودتان هستید به پذیرش بگویید: {R}';
const T_ROLE_CLAIM_OFF   = 'نام شما در فهرست هست ولی وضعیتش غیرفعال است. برای فعال‌شدن به پذیرش بگویید: {R}';
/* v170.9: یوزرنیم پذیرش در کد نیست؛ از Script Property «RECEPTION_USER» یا یوزرنیم «مسئول پذیرش» تب «تیم پذیرش» */
function tgReceptionAt_() {
  var u = String(cfg_('RECEPTION_USER', '') || '');
  if (!u) { try { var b = tgDutyBoss_(); u = b && b.user ? b.user : ''; } catch (e) {} }
  u = u.replace(/^@/, '').trim();
  return u ? '@' + u : '(پیام به همین بات)';
}
function tgRoleClaimText_(t) { return String(t).replace('{R}', tgReceptionAt_()); }

function tgRoleClaim_(chat) {
  tgSetFlag_('rclaim', chat, 1800);
  return tgSend_(chat, T_ROLE_CLAIM_ASK, { keyboard: [['↩️ بازگشت']], resize_keyboard: true });
}

function tgRoleClaimName_(chat, text, tname, tuser) {
  var q = tgNorm_(text);
  if (!q) { return tgSend_(chat, T_ROLE_CLAIM_SHORT); }
  if (q.length < 5) { return tgSend_(chat, T_ROLE_CLAIM_SHORT); }
  var list = tgPeopleList_(), exact = [], part = [];
  var w = q.split(' ').filter(function (x) { return x.length > 2; });
  for (var i = 0; i < list.length; i++) {
    var nm = tgNorm_(list[i].name);
    if (!nm) { continue; }
    if (nm === q) { exact.push(list[i]); continue; }
    if (w.length > 1) {
      var all = true;
      for (var k = 0; k < w.length; k++) { if (nm.indexOf(w[k]) < 0) { all = false; break; } }
      if (all) { part.push(list[i]); }
    }
  }
  var hits = exact.length ? exact : part;
  if (!hits.length) { tgDel_('rclaim', chat); return tgSend_(chat, tgRoleClaimText_(T_ROLE_CLAIM_NONE), tgMenu_()); }
  if (hits.length > 1) {
    var rows = [];
    for (var z = 0; z < Math.min(hits.length, 8); z++) { rows.push([hits[z].name]); }
    rows.push(['↩️ بازگشت']);
    return tgSend_(chat, 'کدامتان هستید؟ روی نام خودتان بزنید.', { keyboard: rows, resize_keyboard: true });
  }
  var p = hits[0];
  if (String(p.status).trim() === 'غیرفعال') { tgDel_('rclaim', chat); return tgSend_(chat, tgRoleClaimText_(T_ROLE_CLAIM_OFF), tgMenu_()); }
  if (p.chat) { if (!tgChatIn_(p.chat, chat)) { tgDel_('rclaim', chat); return tgSend_(chat, tgRoleClaimText_(T_ROLE_CLAIM_TAKEN), tgMenu_()); } }
  /* v166.21 (بند ۲.۵): حسابی که هنوز به این نام وصل نیست فقط درخواست می‌سازد؛ تأیید پذیرش یا یاسر وصلش می‌کند */
  if (!p.chat) return tgTqRequest_(chat, { k: 'p', name: p.name, who: String(tname || '') + (tuser ? ' ' + tuser : '') });
  return tgRoleClaimDone_(chat, p);
}

function tgRoleClaimDone_(chat, p) {
  if (!TG_DRY) {
    try {
      tgPersonSet_(p.row, { addChat: String(chat) }, 'بات', { why: 'ادعای نقش با نام' });
      CacheService.getScriptCache().remove('plist');
      CacheService.getScriptCache().remove('wlist');
      CacheService.getScriptCache().remove('trows');
    } catch (eC) { tgErr_('tgRoleClaimDone_: ' + eC); }
  }
  tgDel_('rclaim', chat);
  tgDel_('role', chat);
  var roles2 = tgMyRoles_(chat, '');
  var lbl = [];
  for (var y = 0; y < roles2.length; y++) { lbl.push(TG_ROLE_BTN[roles2[y]] || roles2[y]); }
  tgSend_(chat, '✅ پیدا شدید: <b>' + tgEsc_(p.name) + '</b>' + '\n' + '\n' + 'نقش‌هایی که برایتان ثبت است: ' + tgEsc_(lbl.join('، ')) + '\n' + '\n' + 'از این به بعد هر بار خودتان را همین‌جا می‌بینید.');
  return tgRolePick_(chat, roles2);
}

function tgRolePick_(chat, roles) {
  const kb = [];
  for (var i = 0; i < roles.length; i++) kb.push([TG_ROLE_BTN[roles[i]] || roles[i]]);
  kb.push([T_ROLE_CLAIM_BTN]);
  if (typeof TG_SJ_BTN !== 'undefined' && roles.length < 2) { kb.push([TG_SJ_BTN]); }
  if (typeof tgSchOwnerOf_ === 'function' && tgSchOwnerOf_(chat, '')) { kb.push([TG_SJ_DESK]); kb.push([TG_SL_BTN]); kb.push([TG_ALQ_BTN, TG_APQ_BTN]); kb.push([TG_EVN_BTN, TG_EV_BTN_LINK]); }
  if (typeof tgCpIsOwner_ === 'function' && tgCpIsOwner_(chat)) kb.push([TG_CP_BTN]);
  return tgSend_(chat, T_ROLE_PICK, { keyboard: kb, resize_keyboard: true });
}

function tgRoleByLabel_(text, roles) {
  const s = String(text || '');
  for (var i = 0; i < roles.length; i++) if (s === roles[i] || s === (TG_ROLE_BTN[roles[i]] || '')) return roles[i];
  /* متن آزاد بلند نقش را عوض نمی‌کند؛ فقط برچسب کوتاه */
  if (s.length > 24) return '';
  for (var k = 0; k < roles.length; k++) if (s.indexOf(roles[k]) > -1) return roles[k];
  return '';
}

/* منوی مسئول بخش. هرکس فقط بخش خودش را می‌بیند، نه یک عدد بیشتر. */
function tgOwnerMenu_() {
  return {
    keyboard: [['📊 گزارش بخش من'], ['📣 اطلاعیه‌ها', '❓ راهنما'], [TG_DASH_BTN, TG_TSK_BTN], [TG_BOX_BTN, TG_TSK_NEW]].concat(tgRoleRow_()),
    resize_keyboard: true
  };
}

function tgOwnerRoute_(chat, role, text, uname) {
  const sec = TG_SECTION_ROLE[role];
  const s = String(text || '');
  if (s.indexOf('اطلاعیه') > -1) return tgAnnShow_(chat, tgOwnerMenu_());
  if (s.indexOf('گزارش') > -1 || s.indexOf('/start') === 0 || !s) {
    const d = tgDayView_(tgDayWin_(), tgScope_(sec));
    return tgSend_(chat, tgDayReport_(d), tgOwnerMenu_());
  }
  return tgSend_(chat, 'اینجا گزارش بخش «' + sec + '» است.\n\n' +
    'با «📊 گزارش بخش من» عددهای ۲۴ ساعت گذشتهٔ همین بخش را می‌بینید. ' +
    'عدد بخش‌های دیگر را نمی‌بینید، چون به کار شما نمی‌آید.', tgOwnerMenu_());
}

function tgRoleRoute_(chat, role, text, m) {
  const u = m && m.from && m.from.username;
  const clean = String(text || '');
  const arg = clean.indexOf('/start') === 0 ? '' : clean;
  if (role === 'ناظر') {
    const w = tgWhoWatch_(chat, u);
    if (w) return tgWatchRoute_(chat, w, arg);
  }
  if (role === 'پذیرش') {
    const d = tgWhoDesk_(chat, u);
    if (d) return tgDeskRoute_(chat, d, arg);
  }
  if (role === 'درمانگر') {
    const th = tgWhoTherapist_(chat);
    if (th) return arg ? tgTherRoute_(chat, th, arg, m) : tgSend_(chat, T_THER_MENU, tgTherMenu_());
  }
  if (role === 'سوشال' && typeof soDesk_ === 'function') return soDesk_(chat, arg, u);
  if (role === 'پارتنر' && typeof ptEntry_ === 'function') return ptEntry_(chat, u);
  if (role === 'سردبیر' && typeof tgMagDesk_ === 'function') return tgMagDesk_(chat, arg);
  if (role === 'مصاحبه‌گر' && typeof tgCpIvDesk_ === 'function') return tgCpIvDesk_(chat, arg, u);
  /* v170.22: تنخواه، راهبر و مالی شاخهٔ خودشان را دارند (پیش از این تنخواه و راهبر به انتخاب نقش برمی‌گشتند) */
  if (role === 'تنخواه' && typeof tnkHome_ === 'function') return tnkHome_(chat);
  if (role === 'راهبر') {
    if (typeof tgRmIsGuide_ === 'function' && tgRmIsGuide_(chat, u)) return tgRmDesk_(chat, 'kanape');
    if (typeof tnkHome_ === 'function' && tnkIsBoss_(chat)) return tnkHome_(chat);
  }
  if (role === 'مالی') return tgOwnerRoute_(chat, role, arg, u);
  if (TG_SECTION_ROLE[role]) return tgOwnerRoute_(chat, role, arg, u);
  if (typeof tgSchoolRoute_ === 'function' && tgSchoolRoute_(chat, role, arg, m)) return;
  tgDel_('role', chat);
  return tgRolePick_(chat, tgMyRoles_(chat, u));
}

/* تطبیق اسم، بی‌صدا. strict برای وقتی است که کاربر از لینک کانال نیامده
   و فقط چیزی نوشته: آن‌جا نباید «سلام» با «اسلامی» یکی شود، پس تطبیقِ
   «اسم درمانگر شامل نوشتهٔ اوست» کنار می‌رود و دست‌کم دو کلمه لازم است. */
function tgTherFind_(text, strict) {
  const q = tgNorm_(text);
  if (!q || q.length < 3) return [];
  const w = q.split(' ').filter(function (x) { return x.length > 2; });
  if (strict && w.length < 2) return [];
  const list = tgTherapistRows_();
  const exact = [], part = [], word = [];
  for (var i = 0; i < list.length; i++) {
    const n = tgNorm_(list[i].name);
    if (!n) continue;
    if (n === q) { exact.push(list[i]); continue; }
    if (q.indexOf(n) > -1 || (!strict && n.indexOf(q) > -1)) { part.push(list[i]); continue; }
    if (w.length > 1) {
      // در حالت سخت‌گیر، هر کلمه باید با یک کلمهٔ کامل اسم بخورد،
      // وگرنه «سلام سلام» داخل «اسلامی» پیدا می‌شود.
      const nw = n.split(' ').filter(Boolean);
      var all = true;
      for (var k = 0; k < w.length; k++) {
        var found = false;
        for (var j = 0; j < nw.length; j++) {
          if (strict ? (nw[j] === w[k]) : (nw[j].indexOf(w[k]) > -1)) { found = true; break; }
        }
        if (!found) { all = false; break; }
      }
      if (all) word.push(list[i]);
    }
  }
  return exact.length ? exact : (part.length ? part : word);
}


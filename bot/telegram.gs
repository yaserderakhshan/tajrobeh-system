function tgTeaNewCode_(seen) {
  var abc = 'abcdefghjkmnpqrstuvwxyz23456789';
  for (var tries = 0; tries < 40; tries++) {
    var s = '';
    for (var i = 0; i < 6; i++) s += abc.charAt(Math.floor(Math.random() * abc.length));
    if (!seen || !seen[s]) return s;
  }
  return 'x' + String(new Date().getTime()).slice(-6);
}

function tgTeaLink_(code) {
  return 'https://t.me/' + String(tgBotName_()).replace(/^@/, '') + '?start=tea-' + code;
}


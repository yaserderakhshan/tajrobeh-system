      out.push('   تاریخ معتبر؟ ' + !isNaN(d.getTime()));
      out.push('   full: ' + tgJDateFull_(d));
    } catch (e) { out.push('   خطا: ' + e); }
  }
  out.push('lastRow Sheet1: ' + sh.getLastRow() + ' lastCol: ' + sh.getLastColumn());
  Logger.log(out.join('\n'));
}


function tgRefScan() {
  const ss = tgSS_();
  const sheets = ss.getSheets();
  const cols = {};
  const where = {};
  for (var s = 0; s < sheets.length; s++) {
    const sh = sheets[s];
    if (sh.getLastRow() < 1) continue;
    let f;
    try { f = sh.getRange(1, 1, Math.min(sh.getLastRow(), 200), sh.getLastColumn()).getFormulas(); } catch (e) { continue; }
    for (var i = 0; i < f.length; i++) for (var j = 0; j < f[i].length; j++) {
      const x = f[i][j];
      if (!x || x.indexOf('لیدها') < 0) continue;
      const m = x.match(/Sheet1!\$?([A-Z]{1,2})/g) || [];
      for (var k = 0; k < m.length; k++) {
        const c = m[k].replace(/Sheet1!\$?/, '');
        cols[c] = (cols[c] || 0) + 1;
        if (!where[c]) where[c] = sh.getName();
      }
    }
  }
  const list = Object.keys(cols).sort().map(function (c) { return c + ' (' + cols[c] + ' بار · ' + where[c] + ')'; });
  Logger.log('ستون‌های Sheet1 که در فرمول‌ها استفاده شده‌اند:\n' + (list.join('\n') || 'هیچ'));
}


function tgRelayCheck() {
  const url = PropertiesService.getScriptProperties().getProperty('TG_RELAY_URL') || '';
  if (!url) { Logger.log('TG_RELAY_URL تنظیم نشده'); return; }
  const out = ['آدرس رله: ' + url.replace(/\?.*$/, '')];
  let ok = 0, fail = 0, sum = 0, worst = 0;
  let hdr = '';
  for (var i = 0; i < 10; i++) {
    const t0 = Date.now();
    try {
      const r = UrlFetchApp.fetch(url, {
        method: 'post', contentType: 'application/json',
        payload: JSON.stringify({ ping: 1 }), muteHttpExceptions: true, followRedirects: true
      });
      const ms = Date.now() - t0;
      sum += ms; if (ms > worst) worst = ms;
      const code = r.getResponseCode();
      if (code === 200) ok++; else fail++;
      if (!hdr) {
        const h = r.getAllHeaders();
        const keys = ['Server', 'server', 'CF-Ray', 'cf-ray', 'cf-cache-status'];
        const parts = [];
        for (var k = 0; k < keys.length; k++) if (h[keys[k]]) parts.push(keys[k] + ': ' + h[keys[k]]);
        hdr = parts.join(' · ') || 'هدر شناسایی‌کننده‌ای نبود';
      }
      out.push((code === 200 ? '✅' : '❌') + ' ' + code + ' · ' + ms + 'ms');
    } catch (e) {
      fail++;
      out.push('❌ خطا بعد از ' + (Date.now() - t0) + 'ms · ' + String(e).slice(0, 70));
    }
    Utilities.sleep(300);
  }
  out.push('');
  out.push('نتیجه: ' + ok + ' موفق · ' + fail + ' ناموفق · میانگین ' + Math.round(sum / Math.max(ok, 1)) + 'ms · بدترین ' + worst + 'ms');
  out.push('هدرها: ' + hdr);
  Logger.log(out.join('\n'));
}


function tgTrigList() {
  const all = ScriptApp.getProjectTriggers();

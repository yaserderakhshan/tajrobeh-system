/* ---------- برپاسازی تب‌ها ----------
   یک بار دستی اجرا می‌شود؛ دوباره اجرا کردن بی‌خطر است. */
function tgV1Setup() {
  var out = [];
  try { tgTskSheet_(); out.push('✅ تب «' + TG_TSK_TAB + '» در هاب پذیرش آماده است'); }
  catch (e) { out.push('❌ کارها: ' + e); }
  try { tgBoxSheet_(); out.push('✅ تب «' + TG_BOX_TAB + '» در هاب پذیرش آماده است'); }
  catch (e2) { out.push('❌ صندوق پیام: ' + e2); }
  try { out.push(tgSeoSetup_()); } catch (e3) { out.push('❌ سئو: ' + e3); }
  Logger.log(out.join('\n'));
  return out.join('\n');
}

/* ---------- تست ---------- */
function tgV1Tests() {
  var out = [], pass = 0, fail = 0;
  function ok(n, c) { if (c) { pass++; } else { fail++; } out.push((c ? '✅ ' : '❌ ') + n); }

  ok('سرستون کارها ۱۸ ستون است', TG_TSK_HEAD.length === 18);
  ok('سرستون صندوق پیام ۱۲ ستون است', TG_BOX_HEAD.length === 12);
  var dupT = {}, dT = 0;
  TG_TSK_HEAD.forEach(function (h) { if (dupT[h]) dT++; dupT[h] = 1; });
  ok('سرستون کارها تکراری ندارد', dT === 0);
  var dupB = {}, dB = 0;
  TG_BOX_HEAD.forEach(function (h) { if (dupB[h]) dB++; dupB[h] = 1; });
  ok('سرستون صندوق تکراری ندارد', dB === 0);

  var miss = TG_TSK_TEAMS.filter(function (t) { return !TG_TSK_TEAM_ROLE[t]; });
  ok('هر تیم یک نقش بات دارد' + (miss.length ? ' · ' + miss.join(', ') : ''), miss.length === 0);
  var badRole = [];
  for (var k in TG_TSK_TEAM_ROLE) if (TG_ROLES.indexOf(TG_TSK_TEAM_ROLE[k]) < 0) badRole.push(k);
  ok('نقش‌های تیم از TG_ROLES هستند' + (badRole.length ? ' · ' + badRole.join(', ') : ''), badRole.length === 0);

  var t = { code: 'K-007', title: 'استادها را به بات بیاور', body: 'همهٔ ۱۹ نفر', team: 'مدرسه', pri: 'وقت‌دار', due: '1405-07-01', st: TG_TSK_ST.open, note: '' };
  var card = tgTskCard_(t);
  ok('کارت کار، عنوان را دارد', card.indexOf('استادها را به بات بیاور') > -1);
  ok('کارت کار، کد را دارد', card.indexOf('K-007') > -1);
  ok('کارت کار، مهلت را می‌گوید', card.indexOf('مهلت') > -1);
  ok('کار باز سه دکمه دارد', tgTskKb_(t).inline_keyboard.length === 3);
  t.st = TG_TSK_ST.doing;
  ok('کار در جریان دکمهٔ «در جریانم» ندارد', tgTskKb_(t).inline_keyboard.length === 2);

  ok('مهلت به شکل تاریخ درست ساخته می‌شود', /^\d{4}-\d{2}-\d{2}$/.test(tgV1Plus_(7)));
  ok('امروز هم همان شکل است', /^\d{4}-\d{2}-\d{2}$/.test(tgTskToday_()));

  ok('عدد نداشته «—» می‌شود', tgDashLine_('x', null).indexOf('—') > -1);
  ok('عدد صفر «—» نمی‌شود', tgDashLine_('x', 0).indexOf('—') < 0);

  var ct = tgBoxCardText_({ from: TG_BOX_FROM_THEM, name: 'مدرسه‌ای', at: '۱۴۰۵', last: 'سلام' });
  ok('پیام طرف با نام خودش نشان داده می‌شود', ct.indexOf('مدرسه‌ای') > -1);
  var cu = tgBoxCardText_({ from: TG_BOX_FROM_US, at: '۱۴۰۵', last: 'سلام' });
  ok('پیام ما با نام تجربه نشان داده می‌شود', cu.indexOf('تجربه') > -1);

  ok('منوی رئیس دکمهٔ کار تازه دارد', JSON.stringify(tgV1MenuRow_(true)).indexOf(TG_TSK_NEW) > -1);
  ok('منوی همکار دکمهٔ کار تازه ندارد', JSON.stringify(tgV1MenuRow_(false)).indexOf(TG_TSK_NEW) < 0);
  ok('منوی همکار داشبورد و کارها دارد', JSON.stringify(tgV1MenuRow_(false)).indexOf(TG_TSK_BTN) > -1);

  var teamRoles = tgV1IsTeam_(['پذیرش']);
  ok('پذیرش عضو تیم است', teamRoles === true);
  ok('مراجع عضو تیم نیست', tgV1IsTeam_(['مراجع']) === false);


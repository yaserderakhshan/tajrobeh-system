  ok('tgOnCallback_ از tgV1Cb_ رد می‌شود', String(tgOnCallback_).indexOf('tgV1Cb_') > -1);

  /* وضعیت‌ها نباید هم‌نام باشند */
  var sv = [];
  for (var s in TG_TSK_ST) { if (sv.indexOf(TG_TSK_ST[s]) > -1) fail++; sv.push(TG_TSK_ST[s]); }
  ok('وضعیت‌های کار یکتا هستند', sv.length === 5);

  /* v166.8: «پیام تازه» و «کار تازه» فقط برای تیم */
  var keepDry = TG_DRY, keepMem = TG_MEM, keepBox = TG_OUTBOX;
  TG_DRY = true; TG_MEM = { roles: ['مراجع'] }; TG_OUTBOX = [];

  bl.getRange('C2').setFormula("=MAP(A2:A,LAMBDA(t,IF(t=\"\",\"\",SUMPRODUCT(('تسویه با درمانگران'!B2:B=t)*VALUE(0&'تسویه با درمانگران'!C2:C)))))");
  bl.getRange('D2').setFormula("=ARRAYFORMULA(IF(A2:A=\"\",\"\",N(B2:B)-N(C2:C)))");
  var d0 = ss.getSheetByName('Sheet1') || ss.getSheetByName('برگه1'); if (d0 && ss.getSheets().length > 1) ss.deleteSheet(d0);
  /* فقط یاسر: هیچ اشتراکی اضافه نمی‌شود */
  var has = ScriptApp.getProjectTriggers().some(function (t) { return t.getHandlerFunction() === 'tgPayTick'; });
  if (!has) { ScriptApp.newTrigger('tgPayTick').timeBased().everyMinutes(1).create(); log.push('✅ بررسی هر دقیقه روشن شد'); }
  log.push('دفتر مالی: ' + ss.getUrl());
  Logger.log(log.join('\n'));
  return log;
}


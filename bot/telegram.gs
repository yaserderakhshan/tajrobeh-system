/* فهرست مقدارهای موجود در ستون‌های پروفایل درمانگر را درمی‌آورد.
   مبنای بستن فهرست رسمی رویکردها و موضوع‌های تخصصی است.        */
function tgProfileScan() {
  const sh = tgSS_().getSheetByName(TG_THER);
  const last = sh.getLastRow();
  if (last < 4) return 'تب درمانگران خالی است.';
  const v = sh.getRange(4, 1, last - 3, 8).getValues();
  const cols = [{ c: 4, name: 'مکتب اصلی' }, { c: 5, name: 'موضوع تخصصی' },
                { c: 6, name: 'ردهٔ سنی' }, { c: 7, name: 'زوج‌درمانی؟' }];
  var out = 'کل سطرها: ' + (last - 3) + '\n';
  for (var q = 0; q < cols.length; q++) {
    const tally = {};
    var empty = 0;
    for (var i = 0; i < v.length; i++) {
      if (!String(v[i][0]).trim()) continue;
      const raw = String(v[i][cols[q].c] || '').trim();
      if (!raw) { empty++; continue; }
      const parts = raw.split(/[,،;+/]+/);
      for (var j = 0; j < parts.length; j++) {
        const x = parts[j].trim();
        if (x) tally[x] = (tally[x] || 0) + 1;
      }
    }
    const keys = Object.keys(tally).sort(function (a, b) { return tally[b] - tally[a]; });
    out += '\n── ' + cols[q].name + ' ── (خالی: ' + empty + ')\n';
    for (var k = 0; k < keys.length; k++) out += '  ' + tally[keys[k]] + '  ' + keys[k] + '\n';
  }
  Logger.log(out);
  return out;
}


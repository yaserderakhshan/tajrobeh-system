  var fixName = M68.fix || {}, fixed = 0;
  for (var i = 0; i < n; i++) {
    if (fixName[String(v[i][1]).trim()]) { hs.getRange(i + 2, 2).setValue(fixName[String(v[i][1]).trim()]); fixed++; }
  }
  log.push('نام‌ها: ' + fixed);

  } else log.push('(فردی بی‌حساب در «افراد» نبود؛ ادعای نقش سنجیده نشد)');

  TG_DRY = keep;
  Logger.log(log.join('\n') + '\n\n' + (fail ? '❌ ' + fail + ' ایراد' : '✅ ثبت‌نام خودسرویس درست است'));

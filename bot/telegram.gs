    return tgFa_(i + 1) + '. ' + w + ': ' + by[w].map(function (h) {
      var t = h.from ? tgInpHs_(tgInpH_(h.from)) + ' تا ' + tgInpHs_(tgInpH_(h.to)) : 'ساعت در جدول نیست';
      if (!h.from && unknown.indexOf(tgFa_(i + 1)) < 0) unknown.push(tgFa_(i + 1));

  sh.clear();
  var w = 9;
  sh.getRange(1, 1, 1, w).setValues([['ظرفیت حضوری · خودکار از «اتاق‌های حضوری» و «ساعت‌های حضوری» · دستی ویرایش نکنید', '', '', '', '', '', '', '', '']]).setFontWeight('bold').setBackground('#f3efec');
  var body = rows.map(function (r) { var x = r.slice(0, w); while (x.length < w) x.push(''); return x; });
  sh.getRange(2, 1, body.length, w).setNumberFormat('@').setValues(body);

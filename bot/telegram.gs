/* ---------- مخاطب‌ها و اجرای رویداد ---------- */

function tgCpOff_(code, chat) {
  var key = 'CP_OFF', m = {};
  if (TG_DRY) m = TG_MEM[key] || {};
  else { try { m = JSON.parse(PropertiesService.getScriptProperties().getProperty(key) || '{}'); } catch (e) {} }
  if (chat === undefined) return m[code] || [];
  var l = m[code] || [];
  if (l.indexOf(String(chat)) < 0) l.push(String(chat));
  m[code] = l;
  if (TG_DRY) TG_MEM[key] = m; else PropertiesService.getScriptProperties().setProperty(key, JSON.stringify(m));
  return l;
}

/* فهرست chat_id مخاطب، بی‌تکرار و بدون کسانی که گفته‌اند یادآوری نفرستید */
function tgCpAudience_(camp, aud) {
  var out = [], add = function (c) { c = tgCpS_(c); if (c && /^-?\d+$/.test(c) && out.indexOf(c) < 0) out.push(c); };
  var regs = tgCpWebRegs_(camp.code);
  var leads = tgCpRead_(TG_SCH_T_REQ).filter(function (l) { return tgCpS_(l['کد کمپین']) === camp.code; });
  var won = function (l) { return tgSchStNorm_(l['وضعیت']).st === TG_SCH_ST_DONE; };
  var paidPre = function (l) { return !!tgCpS_(l['وضعیت پرداخت']); };
  var applied = function (l) { return tgSchStageAtLeast_(tgSchStageNorm_(l['مرحلهٔ قیف']).st, 'apply') && !tgSchClosed_(tgSchStNorm_(l['وضعیت']).st); };
  if (aud === 'ثبت‌نام وبینار') regs.forEach(function (r) { add(r['chat_id']); });
  else if (aud === 'حاضران وبینار') regs.forEach(function (r) { if (tgCpS_(r['وضعیت']) === 'حاضر') add(r['chat_id']); });
  else if (aud === 'غایبان وبینار') regs.forEach(function (r) { if (tgCpS_(r['وضعیت']) !== 'حاضر') add(r['chat_id']); });
  else if (aud === 'متقاضیان بی‌پرداخت') leads.forEach(function (l) { if (applied(l) && !paidPre(l)) add(l['chat_id']); });
  else if (aud === 'همهٔ لیدهای کمپین') {
    regs.forEach(function (r) { add(r['chat_id']); });
    leads.forEach(function (l) { if (!won(l) && !tgSchClosed_(tgSchStNorm_(l['وضعیت']).st)) add(l['chat_id']); });
    var skip = leads.filter(won).map(function (l) { return tgCpS_(l['chat_id']); });
    out = out.filter(function (c) { return skip.indexOf(c) < 0; });
  } else if (aud === 'لیدهای بی‌ثبت‌نام') {
    regs.forEach(function (r) { add(r['chat_id']); });
    leads.forEach(function (l) { add(l['chat_id']); });
    var ok = leads.filter(function (l) { return won(l) || tgSchStNorm_(l['وضعیت']).st === TG_SCH_ST_COND; }).map(function (l) { return tgCpS_(l['chat_id']); });
    out = out.filter(function (c) { return ok.indexOf(c) < 0; });
  } else if (aud === 'پذیرفته‌شدگان') leads.forEach(function (l) { if (won(l)) add(l['chat_id']); });
  else if (aud === 'مصاحبه‌گرها') camp.ivers.split(/[،,]/).forEach(function (n) { add(tgCpIvChat_(n)); });
  else if (aud === 'تیم') tgCpOwners_().forEach(add);
  if (aud !== 'تیم' && aud !== 'مصاحبه‌گرها') {
    var off = tgCpOff_(camp.code);
    out = out.filter(function (c) { return off.indexOf(c) < 0; });
  }
  return out;
}

function tgCpEvKb_(camp, e) {
  var c = camp.code, kb = [], w = tgCpWebinar_(camp);
  var minsTo = w ? (w.at.getTime() - tgCpNow_().getTime()) / 60000 : 9999;
  if (e.aud === 'ثبت‌نام وبینار' && minsTo <= 30 && minsTo > -120) kb.push([{ text: '📺 ورود به وبینار', callback_data: 'cp:in:' + c }]);
  else if (e.aud === 'ثبت‌نام وبینار' && camp.group) kb.push([{ text: '📺 لینک جلسه', url: camp.group }]);
  if (e.type === 'بازخورد') kb.push([{ text: '✍️ بازخورد کوتاه', callback_data: 'cp:wf:' + c }]);
  if (e.aud === 'غایبان وبینار' && camp.rec) kb.push([{ text: '▶️ ضبط وبینار', url: camp.rec }]);
  if (['حاضران وبینار', 'غایبان وبینار', 'متقاضیان بی‌پرداخت', 'همهٔ لیدهای کمپین'].indexOf(e.aud) > -1 && tgCpCanApply_(camp)) {
    kb.push([{ text: '📝 ادامهٔ ثبت‌نام', callback_data: 'cp:v:' + c }]);
  }
  if (e.aud === 'لیدهای بی‌ثبت‌نام') kb.push([{ text: '💌 کامیونیتی رایگان', callback_data: 'cp:c' }], [{ text: '🔔 پیش‌ثبت‌نام حلقهٔ بعد', callback_data: 'cp:z:' + c }]);
  if (['تیم', 'مصاحبه‌گرها', 'پذیرفته‌شدگان'].indexOf(e.aud) < 0) kb.push([{ text: '🔕 یادآوری نفرستید', callback_data: 'cp:off:' + c }]);
  return { inline_keyboard: kb };
}

/* یک رویداد را اجرا می‌کند و برمی‌گرداند چند نفر پیام گرفتند */
function tgCpRun_(camp, e, who) {
  var n = 0;
  if (e.type === 'بستن ثبت‌نام') {
    if (camp.state !== 'بسته') tgCpSetState_(null, camp, 'بسته', 'خودکار');
  } else if (e.msg && e.aud) {
    /* v166.27 (گزارش ۳.۳): ارسال تکه‌تکه با نشانه‌گذار؛ هر کس یک بار. پیش از این بعد از ۱۸۰ نفر قطع و «انجام شد» می‌خورد،
       و اگر اجرا وسط کار تمام می‌شد، تیک بعد دوباره برای همه می‌فرستاد. «رسید» فقط پاسخ موفق تلگرام است. */
    var key = 'cprun:' + camp.code + ':' + e.id, P = TG_DRY ? null : PropertiesService.getScriptProperties();
    var st0; try { st0 = JSON.parse((TG_DRY ? TG_MEM[key] : P.getProperty(key)) || '{"d":[],"ok":0,"no":0}'); } catch (x0) { st0 = { d: [], ok: 0, no: 0 }; }
    var all = tgCpAudience_(camp, e.aud).filter(function (c) { return st0.d.indexOf(c) < 0; });
    var batch = all.slice(0, TG_CP_SEND_MAX), rest = all.length - batch.length;
    var text = '🎓 <b>' + tgEsc_(camp.course) + '</b>\n\n' + tgEsc_(e.msg);
    var kb = tgCpEvKb_(camp, e);
    if (rest > 0) tgCpSet_(TG_CPT_TAB, e.row, { 'وضعیت': 'در حال ارسال' });
    var save = function () { var j = JSON.stringify(st0); if (TG_DRY) TG_MEM[key] = j; else P.setProperty(key, j); };
    batch.forEach(function (c, i) {
      st0.d.push(c); var r = null;
      try { r = tgSend_(c, text, kb.inline_keyboard.length ? kb : null); } catch (x) {}
      if (TG_DRY || (r && r.getResponseCode && r.getResponseCode() === 200)) st0.ok++; else st0.no++;
      if (i % 20 === 19) save();
      if (!TG_DRY && (i + 1) % 25 === 0) Utilities.sleep(1000);
    });
    save();
    n = st0.ok;
    if (rest > 0) return n;   /* تیک بعد بقیه را می‌فرستد */
    if (!TG_DRY) P.deleteProperty(key); else delete TG_MEM[key];
    if (st0.no) n = st0.ok + ' رسید، ' + st0.no + ' نرسید';
  }
  var stamp = tgJDateFull_(new Date(), TG_TZ) + ' ' + Utilities.formatDate(new Date(), TG_TZ, 'HH:mm') + ' · ' + tgFa_(String(n)) + ' نفر' + (who ? ' · ' + who : '');
  tgCpSet_(TG_CPT_TAB, e.row, { 'اجرا شد': stamp, 'وضعیت': 'انجام شد' });
  tgCpTell_('📤 ' + camp.code + ' · ' + e.id + ' اجرا شد: ' + tgEsc_(e.title) + ' · ' + tgFa_(n) + ' نفر');
  return n;
}

/* ---------- تیک پنج‌دقیقه‌ای ---------- */

function tgCpTick(e) {

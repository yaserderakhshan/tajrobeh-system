function tgEduSignup_(chat) {
  tgSetFlag_('esign', chat, 1800);
  return tgSend_(chat, T_EDU_ASK, tgEduKb_());
}

function tgEduSignupName_(chat, text) {
  var q = tgNorm_(text);
  if (!q || q.length < 3) return tgSend_(chat, T_EDU_SHORT);
  var list = tgPeopleList_(), exact = [], part = [];
  var w = q.split(' ').filter(function (x) { return x.length > 2; });
  for (var i = 0; i < list.length; i++) {
    var p = list[i];
    if (!tgIsSchoolRow_(p)) continue;
    var n = tgNorm_(p.name);
    if (!n) continue;
    if (n === q) { exact.push(p); continue; }
    if (w.length > 1) {
      var all = true;
      for (var k = 0; k < w.length; k++) if (n.indexOf(w[k]) < 0) { all = false; break; }
      if (all) part.push(p);
    }
  }
  var hits = exact.length ? exact : part;
  if (!hits.length) { tgEduMiss_(chat, 'اسم: ' + text); return tgSend_(chat, T_EDU_NONE, tgEduKb_()); }
  if (hits.length > 1) {
    // یک نفر دو بار در شیت آمده: فهرست انتخاب همان اسم را دوباره می‌آورد و حلقه می‌شد
    var n0 = tgNorm_(hits[0].name).replace(/\s/g, '');
    if (hits.every(function (h) { return tgNorm_(h.name).replace(/\s/g, '') === n0; })) return tgEduConnect_(chat, hits[0]);
    var rows = [];
    for (var z = 0; z < Math.min(hits.length, 8); z++) rows.push([hits[z].name]);
    rows.push(['↩️ بازگشت']);
    return tgSend_(chat, T_EDU_PICK, { keyboard: rows, resize_keyboard: true });
  }
  return tgEduConnect_(chat, hits[0]);
}

function tgEduConnect_(chat, p) {
  var cur = String(p.chat || '').trim();
  var ids = cur ? cur.split(/[,،;\s]+/).filter(String) : [];
  var me = String(chat);
  if (ids.indexOf(me) < 0) {
    if (ids.length && !TG_DRY) tgSchoolNotify_('🎓 حساب تلگرام دیگری هم به «' + tgEsc_(p.name) + '» وصل شد (chat_id ' + me + '). اگر خودش نیست، از تب «افراد» پاکش کنید.');
    ids.push(me);
  }
  if (!TG_DRY) {
    tgPersonSet_(p.row, { 'chat_id': ids.join(','), 'وضعیت': 'فعال' }, 'بات', { why: 'اتصال دانشجو' });
    CacheService.getScriptCache().remove('plist');
    try { if (typeof scMemActivate_ === 'function') scMemActivate_(chat, p); } catch (eSc) { tgErr_('scMemActivate_: ' + eSc); }   /* v166.25 */
  }
  tgDel_('esign', chat);
  var role = p.roles.indexOf('دانشجو') > -1 ? 'دانشجو' : p.roles[0];
  tgSetVal_('role', chat, role);
  tgSend_(chat, T_EDU_OK, tgSchoolMenu_(role));
  if (role === 'دانشجو' && !tgCircleKey_(p.circle)) return tgAskCircle_(chat);
  if (role === 'دانشجو' && typeof tgPqUniOffer_ === 'function') tgPqUniOffer_(chat);
  return null;
}


function tgAskCircle_(chat) {
  var rows = [], r = [];
  for (var i = 0; i < TG_CIRCLES.length; i++) {
    r.push(TG_CIRCLES[i]);
    if (r.length === 3 || i === TG_CIRCLES.length - 1) { rows.push(r); r = []; }
  }
  tgSetFlag_('ecircle', chat, 1800);
  return tgSend_(chat, T_CIRCLE_ASK, { keyboard: rows, resize_keyboard: true, one_time_keyboard: true });
}

function tgSetCircle_(chat, text) {
  var key = tgCircleKey_(text);
  if (!key || !TG_CIRCLE_CAL[key]) return false;
  var p = tgWhoPerson_(chat, '');
  if (!p) return false;
  if (!TG_DRY) {
    tgPersonSet_(p.row, { 'حلقه یا دوره': String(text).trim() }, 'خود فرد', { why: 'انتخاب حلقه' });
    CacheService.getScriptCache().remove('plist');
  }
  tgDel_('ecircle', chat);
  tgSend_(chat, T_CIRCLE_OK + (['7', '8', '9'].indexOf(key) > -1 ? '\n\n' + T_CIRCLE_789 : ''), tgSchoolMenu_('دانشجو'));
  if (typeof tgPqUniOffer_ === 'function') tgPqUniOffer_(chat);
  return true;
}


   رویداد زیر حساب TG_CAL_ACCOUNT ساخته می‌شود و هر دو طرف مهمان می‌شوند،
   تا هرکس ساعت را در منطقهٔ زمانی خودش ببیند. برای انتقال به آدرس دامنه فقط همین یک خط عوض می‌شود. */
/* تقویم «مرکز تجربه زندگی». برای انتقال به حساب یا دامنهٔ دیگر فقط همین یک خط عوض می‌شود. */
var TG_CAL_ACCOUNT = cfg_('TG_CAL_ACCOUNT', '');
var TG_CAL_MEET_T  = 'معارفهٔ تجربه';
var TG_CAL_SESS_T  = 'جلسهٔ تجربه';

/* v166.26: سرستون «لیدها» در هر اجرا یک بار خوانده می‌شود (پیش از این هر بار که ستونی لازم بود، یعنی ده‌ها بار در یک رزرو) */
var TG_LEAD_HEAD_X = null;
function tgLeadCol_(name) {
  if (TG_DRY) return 0;
  var sh = tgSS_().getSheetByName(TG_LEADS);
  if (!TG_LEAD_HEAD_X) TG_LEAD_HEAD_X = sh.getRange(1, 1, 1, Math.max(1, sh.getLastColumn())).getValues()[0];
  var head = TG_LEAD_HEAD_X, lc = head.length;
  for (var i = 0; i < lc; i++) if (String(head[i]).trim() === name) return i + 1;
  /* هدر یکی از ستون‌های ثابت عوض شده (مثل «مسئول» که «mehr» شده بود): همان ستون ثابت، بی ساختن ستون تازه */
  if (typeof TG_LEAD_FIXED !== 'undefined' && TG_LEAD_FIXED[name]) {
    try { tgErr_('tgLeadCol_: هدر ستون ' + TG_LEAD_FIXED[name] + ' باید «' + name + '» باشد، الان «' + String(head[TG_LEAD_FIXED[name] - 1]) + '» است'); } catch (e) {}
    return TG_LEAD_FIXED[name];
  }
  sh.getRange(1, lc + 1).setValue(name).setFontWeight('bold');
  TG_LEAD_HM_ = null; TG_LEAD_HEAD_X = null;
  return lc + 1;
}

function tgLeadEmailSet_(chat, email) {
  tgSetVal_('em', chat, email);
  if (TG_DRY) { TG_OUTBOX.push({ kind: 'leademail', email: email }); return; }
  try {
    var r = tgFindLead_(chat); if (r < 0) return;
    tgSS_().getSheetByName(TG_LEADS).getRange(r, tgLeadCol_('ایمیل')).setValue(email);
  } catch (e) { tgErr_('tgLeadEmailSet_: ' + e); }
}

/* سطر اسلات: نوشتن در ستونی که با نام هدر پیدا (یا ساخته) می‌شود */
function tgSlotSet_(row, head, val) {
  if (TG_DRY || !row) return;
  try {
    var sh = tgSS_().getSheetByName(TG_SLOTS), lc = sh.getLastColumn();
    var hd = sh.getRange(3, 1, 1, lc).getValues()[0], c = 0;
    for (var i = 0; i < lc; i++) if (String(hd[i]).trim() === head) { c = i + 1; break; }
    if (!c) { c = lc + 1; sh.getRange(3, c).setValue(head).setFontWeight('bold'); }
    sh.getRange(row, c).setValue(val);
  } catch (e) { tgErr_('tgSlotSet_: ' + e); }
}

function tgSaveEmail_(chat, text) {
  var em = String(tgLatinDigits_(text)).trim().replace(/\s+/g, '');
  if (!/^[^@\s]+@[^@\s.]+\.[^@\s]{2,}$/.test(em)) return tgSend_(chat, 'آدرس ایمیل را کامل بنویسید، مثلاً name@gmail.com');
  tgDelFlag_('emask', chat);
  tgLeadEmailSet_(chat, em);
  var added = false;
  try {
    var raw = tgGetVal_('meet', chat);
    if (raw) { var mt = JSON.parse(raw); if (mt && mt.ev) added = tgCalGuest_(mt.ev, em); }
  } catch (e) {}
  return tgSend_(chat, added
    ? 'ثبت شد ✅\nدعوت این جلسه به ' + tgEsc_(em) + ' رفت. ساعتش را به وقت خودتان می‌بینید.'
    : 'ثبت شد ✅\nدعوت جلسه‌ها به ' + tgEsc_(em) + ' فرستاده می‌شود.', tgMenu_());
}

function tgCalOf_() {
  /* عمداً به تقویم شخصی برنمی‌گردیم: دعوت باید از حساب تجربه برود، نه از آدرس شخصی.
     تا وقتی این تقویم به اشتراک گذاشته نشده، رویدادی ساخته نمی‌شود و رزرو مثل قبل کار می‌کند. */
  try { var c = CalendarApp.getCalendarById(TG_CAL_ACCOUNT); if (c) return c; } catch (e) {}
  tgErr_('tgCalOf_: تقویم ' + TG_CAL_ACCOUNT + ' در دسترس نیست؛ رویداد ساخته نشد. tgCalCheck را ببینید.');
  return null;
}

function tgCalFind_(cal, id) {
  var ev = null;
  try { ev = cal.getEventById(id); } catch (e) {}
  if (!ev) { try { ev = cal.getEventSeriesById(id); } catch (e2) {} }
  return ev;
}

/* o: {title, start, end, guests[], desc, location, weekly} */
function tgCalMake_(o) {
  if (TG_DRY) { TG_OUTBOX.push({ kind: 'cal', title: o.title, start: String(o.start), guests: (o.guests || []).filter(String).join(','), weekly: !!o.weekly }); return { id: 'dry-event' }; }
  try {
    var cal = tgCalOf_(); if (!cal) return null;
    var opt = { description: o.desc || '', location: o.location || '', sendInvites: true };
    var g = (o.guests || []).filter(String);
    if (g.length) opt.guests = g.join(',');
    var ev = o.weekly
      ? cal.createEventSeries(o.title, o.start, o.end, CalendarApp.newRecurrence().addWeeklyRule(), opt)
      : cal.createEvent(o.title, o.start, o.end, opt);
    return { id: ev.getId() };
  } catch (e) { tgErr_('tgCalMake_: ' + e); return null; }
}

function tgCalGuest_(id, email) {
  if (TG_DRY) { TG_OUTBOX.push({ kind: 'calguest', id: id, email: email }); return true; }
  if (!id || !email) return false;
  try {
    var cal = tgCalOf_(); if (!cal) return false;
    var ev = tgCalFind_(cal, id); if (!ev) return false;
    ev.addGuest(email);
    return true;
  } catch (e) { tgErr_('tgCalGuest_: ' + e); return false; }
}

function tgCalDrop_(id) {
  if (TG_DRY) { TG_OUTBOX.push({ kind: 'caldrop', id: id }); return true; }
  if (!id) return false;
  try {
    var cal = tgCalOf_(); if (!cal) return false;
    var ev = tgCalFind_(cal, id); if (!ev) return false;
    if (typeof ev.deleteEventSeries === 'function') ev.deleteEventSeries(); else ev.deleteEvent();
    return true;
  } catch (e) { tgErr_('tgCalDrop_: ' + e); return false; }
}

/* ═══════════ v86: جلسهٔ درمان — رزرو جلسهٔ اول و تکرار هفتگی ═══════════ */
var TG_SESS = 'جلسه‌های درمان';
var TG_SESS_HEAD = ['نام درمانگر', 'تاریخ', 'ساعت (تهران)', 'طول (دقیقه)', 'مراجع', 'chat مراجع',
                    'شمارهٔ تماس', 'وضعیت', 'تکرار هفتگی؟', 'رویداد تقویم', 'تاریخ رزرو', 'یادداشت'];
var TG_SESS_MAX_OFFER = 6;
var T_SESS_WEEKLY = 'این ساعت را می‌توانید هفتگی برای خودتان نگه دارید.\n' +
  'اگر بخواهید، هر {d} ساعت {h} همین وقت برای شما رزرو می‌شود.\n\nالزامی نیست و هر وقت خواستید برمی‌داریم.';

function tgSessSheet_() {
  if (TG_DRY) return null;
  var ss = tgSS_(), sh = ss.getSheetByName(TG_SESS);
  if (!sh) {
    sh = ss.insertSheet(TG_SESS);
    sh.setRightToLeft(true);
    sh.getRange(1, 1, 1, TG_SESS_HEAD.length).setValues([TG_SESS_HEAD]).setFontWeight('bold').setBackground('#f3efec');
    sh.setFrozenRows(1);
  }
  return sh;
}

function tgSessRows_() {
  if (TG_DRY) return TG_MEM['sessrows'] || [];
  var sh = tgSessSheet_();
  if (!sh || sh.getLastRow() < 2) return [];
  var v = sh.getRange(2, 1, sh.getLastRow() - 1, TG_SESS_HEAD.length).getValues(), out = [];
  for (var i = 0; i < v.length; i++) {
    var n = String(v[i][0]).trim();
    if (!n) continue;
    out.push({
      row: i + 2, name: n,
      dateIso: v[i][1] instanceof Date ? Utilities.formatDate(v[i][1], TG_TZ, 'yyyy-MM-dd') : String(v[i][1]).trim(),
      hhmm: tgHHMM_(v[i][2]) || String(v[i][2]).trim(),
      len: Number(v[i][3]) || 0, client: String(v[i][4]).trim(), chat: String(v[i][5]).trim(),
      status: String(v[i][7]).trim(), weekly: String(v[i][8]).trim(), ev: String(v[i][9]).trim()
    });
  }
  return out;
}

function tgSessSet_(row, head, val) {
  if (TG_DRY || !row) { if (TG_DRY) TG_OUTBOX.push({ kind: 'sessset', row: row, head: head, val: val }); return; }
  try {
    var sh = tgSessSheet_(), c = TG_SESS_HEAD.indexOf(head) + 1;
    if (c > 0) sh.getRange(row, c).setValue(val);
  } catch (e) { tgErr_('tgSessSet_: ' + e); }
}

function tgIsoWeekday_(iso) {
  try { return Number(Utilities.formatDate(Utilities.parseDate(iso, TG_TZ, 'yyyy-MM-dd'), TG_TZ, 'u')); } catch (e) { return 0; }
}

/* وقت‌های پرشده و وقت‌هایی که هفتگی قفل شده‌اند */
function tgSessBlocks_() {
  var rows = tgSessRows_(), taken = {}, locks = {};
  for (var i = 0; i < rows.length; i++) {
    var r = rows[i];
    if (r.status === 'لغو شده') continue;
    taken[r.name + '|' + r.dateIso + '|' + r.hhmm] = true;
    if (r.weekly === 'بله') {
      var wd = tgIsoWeekday_(r.dateIso);
      if (wd) locks[r.name + '|' + wd + '|' + r.hhmm] = r.dateIso;
    }
  }
  return { taken: taken, locks: locks };
}

function tgSessFree_(name) {
  var key = tgNorm_(name);
  var rules = tgWeeklyRules_('', TG_KIND_SESS).filter(function (r) { return tgNorm_(r.name) === key; });
  if (!rules.length) return [];
  var b = tgSessBlocks_(), out = [], now = new Date();
  var offHas = tgOffChecker_();
  for (var d = 0; d < TG_WEEKS_AHEAD * 7; d++) {
    var day = new Date(now.getTime() + d * 86400000);
    var iso = Utilities.formatDate(day, TG_TZ, 'yyyy-MM-dd');
    var wd = Number(Utilities.formatDate(day, TG_TZ, 'u'));
    for (var r = 0; r < rules.length; r++) {
      if (rules[r].iso !== wd) continue;
      if (!tgRecurOk_(rules[r].recur, rules[r].from, iso)) continue;
      if (b.locks[rules[r].name + '|' + wd + '|' + rules[r].hhmm]) continue;
      if (b.taken[rules[r].name + '|' + iso + '|' + rules[r].hhmm]) continue;
      if (offHas(rules[r].name, iso)) continue;
      var s = { therapist: rules[r].name, dateIso: iso, hhmm: rules[r].hhmm };
      if (tgSlotUtc_(s).getTime() - now.getTime() < TG_MIN_LEAD_MS) continue;
      out.push(s);
    }
  }
  out.sort(function (a, b2) { return (a.dateIso + a.hhmm) < (b2.dateIso + b2.hhmm) ? -1 : 1; });
  return out.slice(0, 30);
}

/* درمانگر این مراجع کیست: از وقت معارفه، وگرنه از ستون «درمانگر معارفه» در تب لیدها */
function tgMyTherapist_(chat) {

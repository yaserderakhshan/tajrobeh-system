function tgBugRows_() {
  const sh = tgBugSheet_();
  const last = sh.getLastRow();
  if (last < 2) return [];
  const v = sh.getRange(2, 1, last - 1, TG_BUG_HEAD.length).getValues();
  const out = [];
  for (var i = 0; i < v.length; i++) {
    const id = String(v[i][0]).trim();
    if (!id) continue;
    out.push({
      row: i + 2, id: id,
      num: Number(tgLatinDigits_(id).replace(/[^0-9]/g, '')) || 0,
      kind: String(v[i][2]).trim(), who: String(v[i][3]).trim(), chat: String(v[i][4]).trim(),
      body: String(v[i][5]).trim(), status: String(v[i][6]).trim() || 'تازه',
      note: String(v[i][7]).trim(), flag: String(v[i][9]).trim()
    });
  }
  return out;
}

function tgBugCreate_(chat, who, kind, body) {
  const r = tgBugRows_();
  let mx = 100;
  for (var i = 0; i < r.length; i++) if (r[i].num > mx) mx = r[i].num;
  const id = 'B-' + (mx + 1);
  if (!TG_DRY) {
    tgBugSheet_().appendRow([id, tgJDateFull_(new Date(), TG_TZ), kind, who.name, String(chat),
      body, 'تازه', '', '', '', new Date()]);
  }
  return { id: id, kind: kind };
}

function tgBugNotify_() {
  const rows = tgBugRows_();
  const sh = tgBugSheet_();
  for (var i = 0; i < rows.length; i++) {
    const b = rows[i];
    if (b.flag) continue;
    if (b.status !== 'درست شد' && b.status !== 'فعلاً نه') continue;
    if (!b.chat) { sh.getRange(b.row, 10).setValue('بدون چت'); continue; }
    const head = b.status === 'درست شد'
      ? 'چیزی که گفته بودید درست شد.'
      : 'چیزی که گفته بودید را بررسی کردیم.';
    const lines = ['🔧 <code>' + b.id + '</code> · ' + tgEsc_(b.kind), tgEsc_(b.body), head];
    if (b.note) lines.push(tgEsc_(b.note));
    lines.push('ممنون که وقت گذاشتید و نوشتید.');
    tgSend_(b.chat, lines.join('\n\n'));
    sh.getRange(b.row, 10).setValue(tgJDateFull_(new Date(), TG_TZ));
  }
}

function tgBugs() {
  const rows = tgBugRows_().filter(function (b) { return b.status === 'تازه' || b.status === 'در بررسی'; });
  if (!rows.length) return 'چیزی برای بررسی نمانده.';
  const out = [];
  for (var i = 0; i < rows.length; i++) {
    out.push(rows[i].id + ' · ' + rows[i].kind + ' · ' + rows[i].who + ' · ' + rows[i].status + '\n' + rows[i].body);
  }
  return out.join('\n\n');
}

